{
  "chapter": {
    "id": "e0221551-500f-41ce-ae30-cff7842b3ab0",
    "number": 1,
    "createdAt": "2025-09-03T01:07:52.151Z",
    "updatedAt": "2025-09-03T01:07:52.151Z",
    "bookId": "c6a7892d-e8bc-47a2-b35e-cf1443f27470"
  },
  "verses": [
    {
      "id": "1d081268-35be-4682-9c11-10753c131731",
      "text": "Điều vẫn có ngay từ lúc khởi đầu,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T04:02:01.257Z",
      "updatedAt": "2025-09-03T04:02:01.257Z",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "c3972082-1a7c-4d67-9d36-567f4863899e",
      "text": "điều chúng tôi đã nghe,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T04:02:01.328Z",
      "updatedAt": "2025-09-03T04:02:01.328Z",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "bf6a2b3a-3efb-4094-bb15-ba0f06583d4d",
      "text": "điều chúng tôi đã thấy tận mắt,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T04:02:01.340Z",
      "updatedAt": "2025-09-03T04:02:01.340Z",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "6c214f70-e75a-4360-94cc-3acaed86bbe8",
      "text": "điều chúng tôi đã chiêm ngưỡng,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 3,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T04:02:01.352Z",
      "updatedAt": "2025-09-03T04:02:01.352Z",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "86f24ea7-2563-4ca3-845b-1d7ef0d9a9e5",
      "text": "và tay chúng tôi đã chạm đến,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 4,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T04:02:01.364Z",
      "updatedAt": "2025-09-03T04:02:01.364Z",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "323b9114-5fe5-4da5-a4f7-de8226bf42cc",
      "text": "đó là Lời sự sống.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 5,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T04:02:01.387Z",
      "updatedAt": "2025-09-03T04:02:01.387Z",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "b8550afa-5ba5-496a-985e-f5de2a6f4c9c",
      "text": "Quả vậy, sự sống đã được tỏ bày,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T04:02:01.425Z",
      "updatedAt": "2025-09-03T04:02:01.425Z",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "2645b13d-2e77-4998-8dd8-742d4947ec4a",
      "text": "chúng tôi đã thấy và làm chứng,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T04:02:01.439Z",
      "updatedAt": "2025-09-03T04:02:01.439Z",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "2a67b3c5-6dd8-41cf-9df1-ef74287175c9",
      "text": "chúng tôi loan báo cho anh em sự sống đời đời :",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T04:02:01.452Z",
      "updatedAt": "2025-09-03T04:02:01.452Z",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "d7918489-e439-4346-9210-9403c9bedb9d",
      "text": "sự sống ấy vẫn hướng về Chúa Cha",
      "label": "2",
      "number": 2,
      "subVerseIndex": 3,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T04:02:01.478Z",
      "updatedAt": "2025-09-03T04:02:01.478Z",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "d5f4c5f6-875a-4e1c-bc76-760d90335627",
      "text": "và nay đã được tỏ bày cho chúng tôi.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 4,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T04:02:01.491Z",
      "updatedAt": "2025-09-03T04:02:01.491Z",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "e16e3635-fac3-45f5-8e2d-24f95b87e01b",
      "text": "Điều chúng tôi đã thấy và đã nghe,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T04:02:01.502Z",
      "updatedAt": "2025-09-03T04:02:01.502Z",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "648b9e67-0dd3-4953-b8e5-9e61ad167c21",
      "text": "chúng tôi loan báo cho cả anh em nữa,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T04:02:01.515Z",
      "updatedAt": "2025-09-03T04:02:01.515Z",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "10320b77-5d47-41c0-8fd3-62296da3d59e",
      "text": "để chính anh em cũng được hiệp thông với chúng tôi,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T04:02:01.526Z",
      "updatedAt": "2025-09-03T04:02:01.526Z",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "12287413-a38a-449f-8951-2b16f32eae4e",
      "text": "mà chúng tôi thì hiệp thông với Chúa Cha",
      "label": "3",
      "number": 3,
      "subVerseIndex": 3,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T04:02:01.539Z",
      "updatedAt": "2025-09-03T04:02:01.539Z",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "e8f2381a-5735-4aaa-8aea-633b82e3aa2f",
      "text": "và với Đức Giê-su Ki-tô, Con của Người.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 4,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T04:02:01.551Z",
      "updatedAt": "2025-09-03T04:02:01.551Z",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "dfa5bbf5-f250-4a93-9ff7-d2d57138d98f",
      "text": "Những điều này, chúng tôi viết ra",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T04:02:01.586Z",
      "updatedAt": "2025-09-03T04:02:01.586Z",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "4053fa9d-c0d1-41bb-ac21-b98bad405309",
      "text": "để niềm vui của chúng ta được nên trọn vẹn.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T04:02:01.597Z",
      "updatedAt": "2025-09-03T04:02:01.597Z",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "fffe1e69-9e4c-4b95-88ba-d650cad3e41a",
      "text": "Đây là lời loan báo của Đức Giê-su Ki-tô mà chúng tôi đã nghe,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T04:02:01.619Z",
      "updatedAt": "2025-09-03T04:02:01.619Z",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "a8685001-975d-40af-a7bc-d807c1e23d97",
      "text": "và nay chúng tôi loan báo cho anh em : Thiên Chúa là ánh sáng ;",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T04:02:01.654Z",
      "updatedAt": "2025-09-03T04:02:01.654Z",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "78e9af05-741e-4088-8815-7b7cf38f866c",
      "text": "nơi Người, không có một chút bóng tối nào.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T04:02:01.667Z",
      "updatedAt": "2025-09-03T04:02:01.667Z",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "c4d16e97-87b0-4c79-a200-7a1759c4b0fc",
      "text": "Nếu chúng ta nói là chúng ta hiệp thông với Người",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T04:02:01.692Z",
      "updatedAt": "2025-09-03T04:02:01.692Z",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "a3200265-523e-46f2-9906-fb4f1c6a08f6",
      "text": "mà lại đi trong bóng tối, thì chúng ta nói dối",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T04:02:01.720Z",
      "updatedAt": "2025-09-03T04:02:01.720Z",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "7b7c7a75-5d2b-45d7-9a79-c8ced7fb164c",
      "text": "và không hành động theo sự thật.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T04:02:01.745Z",
      "updatedAt": "2025-09-03T04:02:01.745Z",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "0bbc8df7-8e8c-479f-b4d5-b7ffb142c43c",
      "text": "Nhưng nếu chúng ta đi trong ánh sáng",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T04:02:01.787Z",
      "updatedAt": "2025-09-03T04:02:01.787Z",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "d3c60e55-e27d-4068-928c-44702b129bef",
      "text": "cũng như Thiên Chúa hằng ngự trong ánh sáng,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T04:02:01.799Z",
      "updatedAt": "2025-09-03T04:02:01.799Z",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "f322c63a-16a9-46b5-b17a-0bf61e9682a0",
      "text": "thì chúng ta được hiệp thông với nhau,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T04:02:01.814Z",
      "updatedAt": "2025-09-03T04:02:01.814Z",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "ac0227b2-c715-4531-be65-18e1b9c83330",
      "text": "và máu Đức Giê-su, Con của Người,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 3,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T04:02:01.830Z",
      "updatedAt": "2025-09-03T04:02:01.830Z",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "3b4d67ad-64cb-425b-986e-8e464beae2ff",
      "text": "thanh tẩy chúng ta sạch hết mọi tội lỗi.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 4,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T04:02:01.866Z",
      "updatedAt": "2025-09-03T04:02:01.866Z",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "a77d401c-878e-476e-9704-e1edcdbc8561",
      "text": "Nếu chúng ta nói là chúng ta không có tội,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T04:02:01.876Z",
      "updatedAt": "2025-09-03T04:02:01.876Z",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "87b72ab5-64c1-4314-b600-75a8ba66d0ea",
      "text": "chúng ta tự lừa dối mình,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T04:02:01.896Z",
      "updatedAt": "2025-09-03T04:02:01.896Z",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "d2529076-3595-411e-bf2c-1d762af11ca0",
      "text": "và sự thật không ở trong chúng ta.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T04:02:01.906Z",
      "updatedAt": "2025-09-03T04:02:01.906Z",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "a29d4ec5-0aa0-49a8-8913-7ce85f27ee13",
      "text": "Nếu chúng ta thú nhận tội lỗi,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T04:02:01.922Z",
      "updatedAt": "2025-09-03T04:02:01.922Z",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "bcae6b7b-3b27-4ad1-b97b-b9845d9d90fa",
      "text": "Thiên Chúa là Đấng trung thành và công chính",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T04:02:01.933Z",
      "updatedAt": "2025-09-03T04:02:01.933Z",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "9743e12c-9fe9-4973-9132-b0ae29c24e83",
      "text": "sẽ tha tội cho chúng ta,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T04:02:01.943Z",
      "updatedAt": "2025-09-03T04:02:01.943Z",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "c8d57ab1-62c7-459f-9b4d-5e71874d69e5",
      "text": "và sẽ thanh tẩy chúng ta sạch mọi điều bất chính.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 3,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T04:02:01.954Z",
      "updatedAt": "2025-09-03T04:02:01.954Z",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "fc6a62a6-77f6-46b0-9974-88778ab8c73a",
      "text": "Nếu chúng ta nói là chúng ta đã không phạm tội,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T04:02:01.964Z",
      "updatedAt": "2025-09-03T04:02:01.964Z",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "82f6538b-5e07-437f-9f37-7a2a539a6140",
      "text": "thì chúng ta coi Người là kẻ nói dối,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T04:02:01.975Z",
      "updatedAt": "2025-09-03T04:02:01.975Z",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "32e7c44e-21a6-4984-a154-d7bbfcb767db",
      "text": "và lời của Người không ở trong chúng ta.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
