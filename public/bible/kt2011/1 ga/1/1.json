    {
      "id": "d848bd65-abbb-438c-839a-6bafbf3b6f41",
      "text": "I. BƯỚC ĐI TRONG ÁNH SÁNG",
      "level": 2,
      "sortOrder": 0,
      "createdAt": "2025-09-03T04:02:01.631Z",
      "updatedAt": "2025-09-03T04:02:01.631Z",
