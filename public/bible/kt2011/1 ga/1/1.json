    },
    {
      "id": "a4e80704-fa0d-41f3-83be-b74b63ebda50",
      "content": "Mt 26,28; Rm 3,25; Kh 1,5",
      "kind": "MARK_KIND_REFERENCE",
      "label": "5@",
      "sortOrder": 4,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T04:02:01.856Z",
      "updatedAt": "2025-09-03T04:02:01.856Z",
      "targetId": "ac0227b2-c715-4531-be65-18e1b9c83330",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "f7b497f1-7e9d-4b66-b665-f4fbbd5d9a86",
      "content": "Lời sự sống được đón nhận trong tâm hồn các tín hữu, tạo nên sự hiệp thông của họ với các chứng nhân trực tiếp, trong số đó có tác giả. Họ cũng được hiệp thông với Chúa Cha và Đức Giê-su Ki-tô nhờ sự hiệp thông ấy. Đó là sự hiệp thông trong đức tin, nhờ đức tin.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "6",
      "sortOrder": 5,
      "startOffset": 38,
      "endOffset": 38,
      "createdAt": "2025-09-03T04:02:01.574Z",
      "updatedAt": "2025-09-03T04:02:01.574Z",
      "targetId": "e8f2381a-5735-4aaa-8aea-633b82e3aa2f",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "274b4608-68ee-40c8-8ac6-b3155cf32d07",
      "content": "English: Jesus | French: Jésus | Latin: Iesu | Origin: &#921;&#951;&#963;&#959;&#965;&#962; | Vietnamese: Giê-su 1 -- con ông Xi-ra, Hc (lt) ; 50,27.51",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "7",
      "sortOrder": 6,
      "startOffset": 34,
      "endOffset": 34,
      "createdAt": "2025-09-03T04:02:01.642Z",
      "updatedAt": "2025-09-03T04:02:01.642Z",
      "targetId": "fffe1e69-9e4c-4b95-88ba-d650cad3e41a",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "d5625a1c-5989-4001-b31b-2d90543a77b7",
      "content": "*Ánh sáng* chỉ sự thật và sự thiện. Thiên Chúa là ánh sáng, nghĩa là nguồn sự thật và sự thánh thiện. *Bóng tối*, đối nghịch với *ánh sáng*, chỉ sự sai lạc và sự dữ, tội lỗi.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "8",
      "sortOrder": 7,
      "startOffset": 41,
      "endOffset": 41,
      "createdAt": "2025-09-03T04:02:01.680Z",
      "updatedAt": "2025-09-03T04:02:01.680Z",
      "targetId": "78e9af05-741e-4088-8815-7b7cf38f866c",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "88fe41ef-a21f-416a-99ba-45bfab4cb66f",
      "content": "Đây là cách diễn tả lời khẳng định của các ngôn sứ giả. Trường hợp tương tự : 1,8.10.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "9",
      "sortOrder": 8,
      "startOffset": 16,
      "endOffset": 16,
      "createdAt": "2025-09-03T04:02:01.704Z",
      "updatedAt": "2025-09-03T04:02:01.704Z",
      "targetId": "c4d16e97-87b0-4c79-a200-7a1759c4b0fc",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "d5101118-56e9-4ec2-a5c7-517eee503357",
      "content": "Theo nghĩa sê-mít, *đi* là sống đời sống luân lý. X. 2,11.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "10",
      "sortOrder": 9,
      "startOffset": 24,
      "endOffset": 24,
      "createdAt": "2025-09-03T04:02:01.733Z",
      "updatedAt": "2025-09-03T04:02:01.733Z",
      "targetId": "a3200265-523e-46f2-9906-fb4f1c6a08f6",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "0c55be77-b050-46a1-b48e-37498a8b1188",
      "content": "ds : *làm sự thật*. Kiểu nói này có nghĩa là sống, hành động theo. *Sự thật* ở đây không có liên lạc với trí khôn và tri thức, nhưng liên quan đến ý chí và đời sống luân lý. *Hành động theo sự thật* là làm hết mọi việc do đời sống luân lý và đức tin đòi hỏi.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "11",
      "sortOrder": 10,
      "startOffset": 31,
      "endOffset": 31,
      "createdAt": "2025-09-03T04:02:01.758Z",
      "updatedAt": "2025-09-03T04:02:01.758Z",
      "targetId": "7b7c7a75-5d2b-45d7-9a79-c8ced7fb164c",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "5dc1f83e-8e4d-4618-8922-ac756568cdb4",
      "content": "English: Jesus | French: Jésus | Latin: Iesu | Origin: &#921;&#951;&#963;&#959;&#965;&#962; | Vietnamese: Giê-su 1 -- con ông Xi-ra, Hc (lt) ; 50,27.51",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "12",
      "sortOrder": 11,
      "startOffset": 17,
      "endOffset": 17,
      "createdAt": "2025-09-03T04:02:01.845Z",
      "updatedAt": "2025-09-03T04:02:01.845Z",
