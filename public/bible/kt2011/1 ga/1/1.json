      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "44076809-4232-480a-ba65-acf7cdaecd9d",
      "text": "Điều kiện thứ nhất : đoạn tuyệt với tội lỗi",
      "level": 3,
      "sortOrder": 0,
      "createdAt": "2025-09-03T04:02:01.886Z",
      "updatedAt": "2025-09-03T04:02:01.886Z",
      "verseId": "a77d401c-878e-476e-9704-e1edcdbc8561",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "2f90c076-8999-4986-9d52-602f82a97090",
      "text": "LỜI DẪN NHẬP",
      "level": 2,
      "sortOrder": 1,
      "createdAt": "2025-09-03T04:02:01.285Z",
      "updatedAt": "2025-09-03T04:02:01.285Z",
      "verseId": "1d081268-35be-4682-9c11-10753c131731",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "40c961a4-9f1b-4a3e-b656-340102b550bc",
      "text": "Ngôi Lời nhập thể và sự hiệp thông với Chúa Cha và Chúa Con",
      "level": 3,
      "sortOrder": 2,
      "createdAt": "2025-09-03T04:02:01.295Z",
      "updatedAt": "2025-09-03T04:02:01.295Z",
