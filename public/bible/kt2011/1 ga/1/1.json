    },
    {
      "id": "61b5395d-08f7-45e8-8012-2145ddf15b59",
      "content": "Ga 15,11; 16,22.24; 2 Ga 12",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T04:02:01.608Z",
      "updatedAt": "2025-09-03T04:02:01.608Z",
      "targetId": "4053fa9d-c0d1-41bb-ac21-b98bad405309",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "a647d18c-7a7a-47ac-adf0-3dbf4db8a2ef",
      "content": "Đó là chính sự sống của Thiên Chúa. Chúng ta lãnh nhận sự sống ấy nhờ và nơi Đức Giê-su Ki-tô, Con Thiên Chúa (4,9 ; 5,11).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 45,
      "endOffset": 45,
      "createdAt": "2025-09-03T04:02:01.465Z",
      "updatedAt": "2025-09-03T04:02:01.465Z",
      "targetId": "2a67b3c5-6dd8-41cf-9df1-ef74287175c9",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "fcd9e4ec-e85b-43a4-a320-af864f20590c",
      "content": "Ga 3,21",
      "kind": "MARK_KIND_REFERENCE",
      "label": "4@",
      "sortOrder": 3,
      "startOffset": 9,
      "endOffset": 9,
      "createdAt": "2025-09-03T04:02:01.771Z",
      "updatedAt": "2025-09-03T04:02:01.771Z",
      "targetId": "7b7c7a75-5d2b-45d7-9a79-c8ced7fb164c",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "e0221551-500f-41ce-ae30-cff7842b3ab0"
    },
    {
      "id": "ddc8e3c0-6710-4d3b-bd78-82180b761c8f",
      "content": "English: Jesus | French: Jésus | Latin: Iesu | Origin: &#921;&#951;&#963;&#959;&#965;&#962; | Vietnamese: Giê-su 1 -- con ông Xi-ra, Hc (lt) ; 50,27.51",
