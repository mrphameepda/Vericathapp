  "headings": [
    {
      "id": "790e97d5-53ef-4c61-985f-e3df2a840133",
      "text": "Hàng tư tế mới",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T04:01:08.566Z",
      "updatedAt": "2025-09-03T04:01:08.566Z",
      "verseId": "28eb6134-a334-4583-9c1e-25dc52f36eff",
      "chapterId": "2d90d161-fe65-41b2-a5eb-c9dcd4443a8d"
    },
    {
      "id": "bae0dfe3-fed7-46f8-a91b-ea1d82573f2c",
      "text": "Nhiệm vụ của tín hữu Chúa Ki-tô. Cách đối xử với dân ngoại.",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T04:01:08.986Z",
      "updatedAt": "2025-09-03T04:01:08.986Z",
      "verseId": "b2f35a61-7cf9-4e78-80c9-82e611725fdc",
      "chapterId": "2d90d161-fe65-41b2-a5eb-c9dcd4443a8d"
    },
    {
      "id": "0beb64cf-cb64-410a-b196-68ec99a334bf",
      "text": "Bổn phận đối với các nhà hữu trách",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T04:01:09.121Z",
      "updatedAt": "2025-09-03T04:01:09.121Z",
      "verseId": "882d1d1e-b12b-4f10-9edd-5000c7189949",
      "chapterId": "2d90d161-fe65-41b2-a5eb-c9dcd4443a8d"
    },
    {
      "id": "6624e0e4-4ee6-425e-b120-7a4806ade349",
      "text": "Bổn phận đối với chủ",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T04:01:09.279Z",
      "updatedAt": "2025-09-03T04:01:09.279Z",
