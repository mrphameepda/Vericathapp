    {
      "id": "e0b4fee7-6982-4601-a4b3-d8095c2589c5",
      "content": "English: Christ | French: Chist | Latin: Christus | Origin: &#935;&#961;&#953;&#964;&#959;&#962; | Vietnamese: Ki-tô -- Mt 1,18",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 33,
      "endOffset": 33,
      "createdAt": "2025-09-03T04:01:08.580Z",
      "updatedAt": "2025-09-03T04:01:08.580Z",
