    {
      "id": "3f4cc237-e736-42aa-be90-0951a504f9f3",
      "content": "English: Ecbatana | French: Ecbatane | Latin: Ecbatanis | Origin: &#917;&#954;&#946;&#945;&#964;&#945;&#957;&#945; | Vietnamese: Éc-ba-tan -- Tb 3,7",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "7",
      "sortOrder": 6,
      "startOffset": 26,
      "endOffset": 26,
      "createdAt": "2025-09-03T02:18:43.588Z",
      "updatedAt": "2025-09-03T02:18:43.588Z",
