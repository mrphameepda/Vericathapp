    },
    {
      "id": "1345c0b4-de97-4848-b902-c4a65e63e4b6",
      "content": "Một thành phố cách Péc-xê-pô-li 700 km về hướng tây bắc. Thật ra, An-ti-ô-khô IV đã không chết ở Éc-ba-tan, nhưng chết trên đường từ Péc-xi-a trở về Ba-by-lon (x. 1 Mcb 6,4).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "8",
      "sortOrder": 7,
      "startOffset": 26,
      "endOffset": 26,
      "createdAt": "2025-09-03T02:18:43.599Z",
      "updatedAt": "2025-09-03T02:18:43.599Z",
      "targetId": "dde815f2-afb7-4261-9844-8ce79f86e3ed",
      "targetType": "MARK_TARGET_TYPE_VERSE",
