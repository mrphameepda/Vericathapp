      "chapterId": "16b466e6-568c-4842-8ea8-fb01a4385f6c"
    },
    {
      "id": "7f061dad-d4dd-4f34-985c-9ea0f76d6fd6",
      "content": "Lần thứ nhất tác giả Sb đề cập tới *sách các vua Giu-đa và Ít-ra-en*, mà sau này còn được nhắc đến dưới những tựa đề khác nhau, ở 20,34 ; 23,27 ; 25,26 ; 27,7 ; 28,26 ; 32,32 ; 35,27 ; 36,8.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "53",
      "sortOrder": 52,
      "startOffset": 128,
      "endOffset": 128,
      "createdAt": "2025-09-03T02:02:05.080Z",
