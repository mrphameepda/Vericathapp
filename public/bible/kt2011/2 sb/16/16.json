    {
      "id": "cf3c441a-d29d-4fdf-a304-403097ec515d",
      "content": "Thành này nằm trong lãnh thổ của Ben-gia-min (x. Tl 18,25), chỉ cách Giê-ru-sa-lem 8 cây số về phía bắc và như thế thuộc về vương quốc miền Nam.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "8",
      "sortOrder": 7,
      "startOffset": 90,
      "endOffset": 90,
      "createdAt": "2025-09-03T02:02:04.234Z",
      "updatedAt": "2025-09-03T02:02:04.234Z",
      "targetId": "109e8e24-6abb-4fd4-bdc7-7e4a81149540",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "16b466e6-568c-4842-8ea8-fb01a4385f6c"
    },
