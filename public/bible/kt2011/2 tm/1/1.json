      "chapterId": "d9fa93c9-459f-4977-97e1-a266929aeba1"
    },
    {
      "id": "ab2cb5b8-b3a2-405a-89fe-d95d24d7157d",
      "content": "Một tín hữu người Ê-phê-xô tới Rô-ma, đã giúp thánh Phao-lô rất nhiều, khi thánh nhân bị tù. Ô-nê-xi-phô-rô còn được nhắc tới trong 4,19.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "32",
      "sortOrder": 31,
      "startOffset": 55,
      "endOffset": 55,
      "createdAt": "2025-09-03T03:57:51.580Z",
