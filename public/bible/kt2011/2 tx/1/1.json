    },
    {
      "id": "8db6cc7f-805d-4387-92af-7ea81ea640fa",
      "content": "Is 24,15; 66,5",
      "kind": "MARK_KIND_REFERENCE",
      "label": "14@",
      "sortOrder": 13,
      "startOffset": 9,
      "endOffset": 9,
      "createdAt": "2025-09-03T03:56:50.774Z",
      "updatedAt": "2025-09-03T03:56:50.774Z",
