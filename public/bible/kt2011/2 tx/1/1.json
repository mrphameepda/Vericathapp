    },
    {
      "id": "a489654f-bcbf-435b-ac9e-a053acb0503b",
      "content": "Lửa cháy bừng là yếu tố cổ điển để diễn tả Chúa tỏ hiện (Xh 3,2 ; Is 66,15 ; Đn 7,9-11 ; Tv 18,9 ; 1 Cr 3,13).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "14",
      "sortOrder": 13,
      "startOffset": 25,
      "endOffset": 25,
      "createdAt": "2025-09-03T03:56:50.498Z",
