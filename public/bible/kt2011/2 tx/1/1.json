    {
      "id": "04c954f9-fab1-41aa-9e51-019ca4e96f59",
      "content": "Chúa Giê-su được đặt ngang với Thiên Chúa ... (x. 2 Tx 1,1-2 ; 2,16 ; 3,5).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "25",
