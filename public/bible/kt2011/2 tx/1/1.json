      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "df2cc2d0-b285-4509-9386-15329da95beb"
    },
    {
      "id": "8d15ea90-cdf2-4c35-8304-9896e3f73b2a",
      "content": "Ga 17,10-14",
      "kind": "MARK_KIND_REFERENCE",
      "label": "15@",
      "sortOrder": 14,
