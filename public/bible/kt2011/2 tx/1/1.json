    },
    {
      "id": "f5f5e491-dc4e-428d-be14-3cf7e3ee26f2",
      "content": "*Trong ngày ấy* : Ngày Chúa quang lâm, ngày của Chúa theo như các ngôn sứ loan báo (Am 5,18 ; Is 2,17 ; Mt 24,36 ; 2 Pr 3,10).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "17",
      "sortOrder": 16,
      "startOffset": 28,
      "endOffset": 28,
      "createdAt": "2025-09-03T03:56:50.602Z",
      "updatedAt": "2025-09-03T03:56:50.602Z",
      "targetId": "02494abc-7899-41cc-a485-2cb055390aef",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "df2cc2d0-b285-4509-9386-15329da95beb"
    },
    {
      "id": "4158b67a-747b-4d16-8cd1-a0eb2939e57e",
      "content": "*Các thánh* nghĩa là các tín hữu (1 Tx 2,12 ; 1 Pr 5,10).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "18",
      "sortOrder": 17,
      "startOffset": 76,
      "endOffset": 76,
      "createdAt": "2025-09-03T03:56:50.612Z",
      "updatedAt": "2025-09-03T03:56:50.612Z",
      "targetId": "02494abc-7899-41cc-a485-2cb055390aef",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "df2cc2d0-b285-4509-9386-15329da95beb"
    },
    {
      "id": "9b6b1e99-ae1d-4d72-a80c-8163e76c555a",
      "content": "Lời chứng là lời rao giảng của các Tông Đồ (1 Tx 1,8) ; và cũng là lời chứng của Chúa Ki-tô qua miệng các Tông Đồ (1 Cr 1,6).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "19",
      "sortOrder": 18,
      "startOffset": 147,
      "endOffset": 147,
      "createdAt": "2025-09-03T03:56:50.623Z",
      "updatedAt": "2025-09-03T03:56:50.623Z",
      "targetId": "02494abc-7899-41cc-a485-2cb055390aef",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "df2cc2d0-b285-4509-9386-15329da95beb"
    },
    {
      "id": "3193f110-aaf0-466e-9760-c728ab493711",
      "content": "Ơn gọi làm Ki-tô hữu, làm người thánh của Thiên Chúa. Chính Chúa kêu gọi qua miệng Tông Đồ.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "20",
      "sortOrder": 19,
      "startOffset": 119,
      "endOffset": 119,
      "createdAt": "2025-09-03T03:56:50.664Z",
      "updatedAt": "2025-09-03T03:56:50.664Z",
      "targetId": "42dbfe3d-522e-4651-b057-753ff02017b1",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "df2cc2d0-b285-4509-9386-15329da95beb"
    },
    {
      "id": "92181199-3e0d-4f19-853f-69cb6ec6a9dd",
      "content": "*Thiện chí* : ý muốn làm việc lành, cũng là ơn Chúa ban (Pl 2,13).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "21",
      "sortOrder": 20,
      "startOffset": 177,
      "endOffset": 177,
      "createdAt": "2025-09-03T03:56:50.675Z",
      "updatedAt": "2025-09-03T03:56:50.675Z",
      "targetId": "42dbfe3d-522e-4651-b057-753ff02017b1",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "df2cc2d0-b285-4509-9386-15329da95beb"
    },
    {
      "id": "21432f8c-b318-4809-a69e-a1539f1f2a4e",
      "content": "Lòng tin sống bằng việc làm (1 Tx 1,3-4 ; Gc 2,14-17.26).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "22",
      "sortOrder": 21,
      "startOffset": 228,
      "endOffset": 228,
      "createdAt": "2025-09-03T03:56:50.687Z",
      "updatedAt": "2025-09-03T03:56:50.687Z",
