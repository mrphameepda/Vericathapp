    {
      "id": "abbc8720-5b0e-4b6e-90d3-64d7eb09d110",
      "content": "Các người cha gia đình đã bị giết, bị lưu đày hay bị bán làm nô lệ. Mất cha là mất sự bảo vệ an toàn.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "6",
      "sortOrder": 5,
      "startOffset": 20,
      "endOffset": 20,
      "createdAt": "2025-09-03T03:11:51.361Z",
