{
  "chapter": {
    "id": "7a2ca981-3f24-4c81-92ff-d5dbd953da69",
    "number": 5,
    "createdAt": "2025-09-03T01:07:51.723Z",
    "updatedAt": "2025-09-03T01:07:51.723Z",
    "bookId": "a8370cea-8a3c-45e1-ac12-9acb43e6691b"
  },
  "verses": [
    {
      "id": "e21cc4bc-431a-4f6e-b5c9-4017e2c81051",
      "text": "Lạy ĐỨC CHÚA, xin Ngài nhớ cho :",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:51.178Z",
      "updatedAt": "2025-09-03T03:11:51.178Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "d122dd72-6e3c-407a-8810-881815df64b9",
      "text": "chúng con khổ cực biết chừng nào.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:51.239Z",
      "updatedAt": "2025-09-03T03:11:51.239Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "a8ddfd85-9057-4f6e-99e6-ebfbd885cd65",
      "text": "Xin đưa mắt nhìn xem",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:51.255Z",
      "updatedAt": "2025-09-03T03:11:51.255Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "d459fa1e-cb49-45d6-beb6-345d34af7d65",
      "text": "nỗi nhục nhằn chúng con phải chịu.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 3,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:51.293Z",
      "updatedAt": "2025-09-03T03:11:51.293Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "5d92a7e6-09fe-41f8-a94e-7ebb65ffa2fa",
      "text": "Sản nghiệp chúng con đã về tay ngoại kiều,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:51.306Z",
      "updatedAt": "2025-09-03T03:11:51.306Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "4e953cdb-8435-4e84-9924-5900bc3cae9e",
      "text": "nhà cửa chúng con lại thuộc về kẻ khác.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:51.336Z",
      "updatedAt": "2025-09-03T03:11:51.336Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "c25a5515-3f0a-4aab-80db-af3bea45a8f6",
      "text": "Chúng con mồ côi cha",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:51.349Z",
      "updatedAt": "2025-09-03T03:11:51.349Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "956bece6-eddc-43a3-8301-c3df5b2a438d",
      "text": "mẹ chúng con goá bụa.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:51.372Z",
      "updatedAt": "2025-09-03T03:11:51.372Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "23a997dc-c282-4f02-9385-f39d0540dce4",
      "text": "Đến như nước uống còn phải trả tiền,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:51.384Z",
      "updatedAt": "2025-09-03T03:11:51.384Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "038d4aba-aa9d-41fe-829d-d49170ddc7b1",
      "text": "củi để đun cũng phải mua mới có.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:51.424Z",
      "updatedAt": "2025-09-03T03:11:51.424Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "0130d7a2-8e83-4e40-b938-100003f9cedf",
      "text": "Chúng con bị săn đuổi, cổ đeo gông nặng nề,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:51.437Z",
      "updatedAt": "2025-09-03T03:11:51.437Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "47373768-e3dd-42ec-86cf-ffd465ebebce",
      "text": "xác thân rời rã mà chẳng được nghỉ ngơi.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:51.451Z",
      "updatedAt": "2025-09-03T03:11:51.451Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "c3478765-7472-40ac-865f-d92e2e9795cc",
      "text": "Chúng con ngửa tay xin Ai-cập,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:51.463Z",
      "updatedAt": "2025-09-03T03:11:51.463Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "48a08101-780b-41f0-8149-042d776e6640",
      "text": "chờ Át-sua cho miếng bánh độ thân.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:51.485Z",
      "updatedAt": "2025-09-03T03:11:51.485Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "871774c3-ad4f-4187-9487-df519182e597",
      "text": "Cha ông chúng con phạm tội, nhưng đã khuất,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:51.512Z",
      "updatedAt": "2025-09-03T03:11:51.512Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "cbbd0d2a-e83f-44a6-93d7-c5c7397c950f",
      "text": "chúng con nay gánh chịu vạ các ngài gây nên.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:51.537Z",
      "updatedAt": "2025-09-03T03:11:51.537Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "dfbf537d-4975-4f8c-b762-34cb93503ba8",
      "text": "Đám tôi đòi thống trị chúng con,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:51.559Z",
      "updatedAt": "2025-09-03T03:11:51.559Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "0f6b6bf5-e58c-463d-a054-c075458f1278",
      "text": "chẳng ai cứu chúng con khỏi tay chúng.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:51.570Z",
      "updatedAt": "2025-09-03T03:11:51.570Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "9296e549-3df8-4971-a708-17061f91a5d4",
      "text": "Chúng con đánh liều vào hoang địa,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:51.581Z",
      "updatedAt": "2025-09-03T03:11:51.581Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "3a34983a-3e0e-4938-b10a-a1f218357eaf",
      "text": "bất chấp lưỡi gươm, kiếm bánh về.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:51.612Z",
      "updatedAt": "2025-09-03T03:11:51.612Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "f4436b0b-a8fd-43cd-af73-2273466ad275",
      "text": "Da thịt nóng ran như lò lửa,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:51.626Z",
      "updatedAt": "2025-09-03T03:11:51.626Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "2d87f4cd-83f4-4b0b-9d0a-1d5da6c2ac7e",
      "text": "bụng dạ cồn cào vì cơn đói.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:51.640Z",
      "updatedAt": "2025-09-03T03:11:51.640Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "e921ada1-39d4-42bc-9e23-a05be76202b6",
      "text": "Tại Xi-on, chúng hãm hiếp đàn bà,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:51.654Z",
      "updatedAt": "2025-09-03T03:11:51.654Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "a06b7677-57a9-4e4f-b737-16c2aa4bddfe",
      "text": "trong các thành Giu-đa, chúng làm nhục trinh nữ.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:51.700Z",
      "updatedAt": "2025-09-03T03:11:51.700Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "11f51dbd-6e23-4b21-8019-e8696ee68219",
      "text": "Chúng tra tay treo cổ các thủ lãnh chúng con,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:51.728Z",
      "updatedAt": "2025-09-03T03:11:51.728Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "8058e72d-4691-45da-83dd-782b6556ebf4",
      "text": "hàng kỳ mục, chúng chẳng thèm kiêng nể.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:51.763Z",
      "updatedAt": "2025-09-03T03:11:51.763Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "6e650965-6d3b-448f-a796-63c16d4e8f46",
      "text": "Đám thanh niên phải khiêng cối đá,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:51.774Z",
      "updatedAt": "2025-09-03T03:11:51.774Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "9bc9aad7-3ee4-4533-abd4-8d018bbcecd0",
      "text": "còn thiếu niên lảo đảo dưới khối gỗ nặng nề.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:51.796Z",
      "updatedAt": "2025-09-03T03:11:51.796Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "1d9ce54f-317a-4e3d-a78b-6243cbf29ccd",
      "text": "Cổng thành vắng bóng hàng kỳ mục,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:51.809Z",
      "updatedAt": "2025-09-03T03:11:51.809Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "9dcfdd48-c8b1-448c-b946-4561fe116719",
      "text": "thanh niên hết đàn ca xướng hát.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:51.836Z",
      "updatedAt": "2025-09-03T03:11:51.836Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "49e9d7fe-17df-4f3b-9cb6-f9f824d0d2c9",
      "text": "Tim chúng con hết rạo rực niềm vui,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:51.854Z",
      "updatedAt": "2025-09-03T03:11:51.854Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "112f68b6-75e4-438c-aaad-95c74e70cb3d",
      "text": "tang tóc sầu thương thay thế cho vũ điệu.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:51.868Z",
      "updatedAt": "2025-09-03T03:11:51.868Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "6800f7d1-255f-4bcb-81e4-293c3d7cd1b8",
      "text": "Triều thiên đội đầu nay đã rớt,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:51.895Z",
      "updatedAt": "2025-09-03T03:11:51.895Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "0fcd9929-12df-40d8-b3c8-0520ffce6b81",
      "text": "khốn thân chúng con : chúng con đã lỗi phạm đến Ngài.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:51.919Z",
      "updatedAt": "2025-09-03T03:11:51.919Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "e848adcd-a027-405c-ad63-38df25ccb49c",
      "text": "Hỏi vì đâu mà lòng chúng con sầu muộn,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:51.933Z",
      "updatedAt": "2025-09-03T03:11:51.933Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "1c59eaa2-67ae-4839-b346-74a029274635",
      "text": "vì đâu mắt chúng con mù tối ?",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:51.959Z",
      "updatedAt": "2025-09-03T03:11:51.959Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "83a546d7-e8da-42a3-a4e1-cd09b91588c1",
      "text": "Âu cũng vì núi Xi-on vắng lặng điêu tàn,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:51.973Z",
      "updatedAt": "2025-09-03T03:11:51.973Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "04f97498-3779-43f6-ad79-5318c950fc9c",
      "text": "trở thành nơi cho sói rừng lảng vảng.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:52.004Z",
      "updatedAt": "2025-09-03T03:11:52.004Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "d1d4ed54-cce6-42dc-b205-1d44c19e17ed",
      "text": "Còn Ngài, lạy ĐỨC CHÚA, Ngài muôn đời tồn tại,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:52.046Z",
      "updatedAt": "2025-09-03T03:11:52.046Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "6ab39557-1ed5-4ff2-bce5-705118fd5830",
      "text": "vương quyền Ngài bền vững thiên thu.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:52.102Z",
      "updatedAt": "2025-09-03T03:11:52.102Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "b546fff3-198f-4963-87f8-3875b803b43a",
      "text": "Sao Ngài đành quên chúng con mãi mãi,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:52.116Z",
      "updatedAt": "2025-09-03T03:11:52.116Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "d10e14b5-6050-4d69-bbc5-6824f1c31a37",
      "text": "đành bỏ mặc chúng con suốt chuỗi ngày dài ?",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:52.130Z",
      "updatedAt": "2025-09-03T03:11:52.130Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "81b8117a-5195-4599-bb3c-2242ef119c14",
      "text": "Xin đưa chúng con về với Ngài, lạy ĐỨC CHÚA,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:52.145Z",
      "updatedAt": "2025-09-03T03:11:52.145Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "0978ea45-091d-4226-9844-44b42c3dfdfe",
      "text": "để chúng con trở về.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:52.206Z",
      "updatedAt": "2025-09-03T03:11:52.206Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "119be43a-dfbf-437f-b7f4-6efa0cc2856d",
      "text": "Xin đổi mới cuộc đời chúng con",
      "label": "21",
      "number": 21,
      "subVerseIndex": 2,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:52.235Z",
      "updatedAt": "2025-09-03T03:11:52.235Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "191b7741-5c94-4550-985b-285f4e9e99f3",
      "text": "cho được như thời xa xưa ấy.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 3,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:52.263Z",
      "updatedAt": "2025-09-03T03:11:52.263Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "1d2f08b0-63bf-4845-90d9-a63a3d8356ce",
      "text": "Hay Ngài đã thật sự ruồng rẫy chúng con,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:52.277Z",
      "updatedAt": "2025-09-03T03:11:52.277Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    },
    {
      "id": "58634b00-ec96-48a7-873c-df47c1e5d132",
      "text": "đã giận chúng con hết mức rồi ?",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:11:52.296Z",
      "updatedAt": "2025-09-03T03:11:52.296Z",
      "chapterId": "7a2ca981-3f24-4c81-92ff-d5dbd953da69"
    }
  ],
  "marks": [
    {
      "id": "b8ac9606-6302-4c41-b853-da86f0c62a7f",
      "content": "PT đặt tên cho bài thứ năm là *lời cầu nguyện của ông Giê-rê-mi-a*. Bài ca này là lời than vãn của tập thể. Tác giả tóm tắt các biến cố, các sự kiện liên quan đến Giê-ru-sa-lem thất thủ và tất cả phải đi đày, dân chúng buồn rầu vì Giê-ru-sa-lem không còn là nơi Đức Chúa ngự. Đầy lòng tin tưởng, tác giả hy vọng Đức Chúa sẽ nhớ lại và giải thoát dân khỏi cảnh lưu đày mà cho về quê cha đất tổ.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 11,
      "endOffset": 11,
      "createdAt": "2025-09-03T03:11:51.207Z",
