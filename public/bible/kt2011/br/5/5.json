{
  "chapter": {
    "id": "4bed4dc0-4305-47dd-9239-6eca41434f72",
    "number": 5,
    "createdAt": "2025-09-03T01:07:51.743Z",
    "updatedAt": "2025-09-03T01:07:51.743Z",
    "bookId": "82bf3b2f-32d6-4d18-8651-11c3020ea68f"
  },
  "verses": [
    {
      "id": "343455fe-3069-4f60-ba0d-65cc91f7f958",
      "text": "Hỡi Giê-ru-sa-lem, hãy cởi bỏ áo tang khổ nhục,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:12:27.431Z",
      "updatedAt": "2025-09-03T03:12:27.431Z",
      "chapterId": "4bed4dc0-4305-47dd-9239-6eca41434f72"
    },
    {
      "id": "2f42477c-aae1-4d5b-9c8a-4c31cffba283",
      "text": "và mặc lấy ánh vinh quang vĩnh cửu Thiên Chúa ban cho ngươi ;",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:12:27.464Z",
      "updatedAt": "2025-09-03T03:12:27.464Z",
      "chapterId": "4bed4dc0-4305-47dd-9239-6eca41434f72"
    },
    {
      "id": "17f9afee-b9c7-464f-8db0-8fc950c7791d",
      "text": "hãy khoác vào mình áo choàng công chính của Thiên Chúa ;",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:12:27.489Z",
      "updatedAt": "2025-09-03T03:12:27.489Z",
      "chapterId": "4bed4dc0-4305-47dd-9239-6eca41434f72"
    },
    {
      "id": "b4237e83-03fe-4d65-8947-63381f572246",
      "text": "và đội lên đầu triều thiên vinh quang",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:12:27.512Z",
      "updatedAt": "2025-09-03T03:12:27.512Z",
      "chapterId": "4bed4dc0-4305-47dd-9239-6eca41434f72"
    },
    {
      "id": "157d5ce9-ca0d-48b9-a234-d7715e196578",
      "text": "Đấng Vĩnh Hằng ban tặng.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:12:27.523Z",
      "updatedAt": "2025-09-03T03:12:27.523Z",
      "chapterId": "4bed4dc0-4305-47dd-9239-6eca41434f72"
    },
    {
      "id": "497eab7f-4733-481e-928a-19b4800e4930",
      "text": "Vì Thiên Chúa sẽ cho khắp cả hoàn cầu",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:12:27.534Z",
      "updatedAt": "2025-09-03T03:12:27.534Z",
      "chapterId": "4bed4dc0-4305-47dd-9239-6eca41434f72"
    },
    {
      "id": "c889aa61-3202-474f-a49c-87f5ecb6b6c3",
      "text": "thấy hào quang rực rỡ của ngươi.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:12:27.558Z",
      "updatedAt": "2025-09-03T03:12:27.558Z",
      "chapterId": "4bed4dc0-4305-47dd-9239-6eca41434f72"
    },
    {
      "id": "9cf05c5a-0873-4c08-ba7b-7bb6625d1788",
      "text": "Mãi mãi Người sẽ gọi ngươi",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:12:27.570Z",
      "updatedAt": "2025-09-03T03:12:27.570Z",
      "chapterId": "4bed4dc0-4305-47dd-9239-6eca41434f72"
    },
    {
      "id": "c4db8fef-7122-43fb-9e8d-72c62815ea9f",
      "text": "là “Bình an xây dựng trên công chính”,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:12:27.584Z",
      "updatedAt": "2025-09-03T03:12:27.584Z",
      "chapterId": "4bed4dc0-4305-47dd-9239-6eca41434f72"
    },
    {
      "id": "d6cc0dfb-7812-4daf-bef0-f5e4f49d40b5",
      "text": "và “Vinh quang phát xuất từ lòng kính sợ Thiên Chúa”.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:12:27.601Z",
      "updatedAt": "2025-09-03T03:12:27.601Z",
      "chapterId": "4bed4dc0-4305-47dd-9239-6eca41434f72"
    },
    {
      "id": "8d2de2a8-5956-49d5-881c-8fc48a2be78b",
      "text": "Vùng lên, Giê-ru-sa-lem hỡi,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:12:27.630Z",
      "updatedAt": "2025-09-03T03:12:27.630Z",
      "chapterId": "4bed4dc0-4305-47dd-9239-6eca41434f72"
    },
    {
      "id": "5cec0a0e-92e6-4794-952c-6c99c0adb142",
      "text": "hãy đứng ở nơi cao, và hướng nhìn về phía đông :",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:12:27.666Z",
      "updatedAt": "2025-09-03T03:12:27.666Z",
      "chapterId": "4bed4dc0-4305-47dd-9239-6eca41434f72"
    },
    {
      "id": "c876ea51-be92-4b9d-8ab8-451495967670",
      "text": "Kìa xem con cái ngươi từ đông sang tây tụ họp về",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:12:27.688Z",
      "updatedAt": "2025-09-03T03:12:27.688Z",
      "chapterId": "4bed4dc0-4305-47dd-9239-6eca41434f72"
    },
    {
      "id": "f742b008-5969-49da-b1a2-8aa42e14769a",
      "text": "theo lời Đấng Thánh đã truyền dạy.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 3,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:12:27.699Z",
      "updatedAt": "2025-09-03T03:12:27.699Z",
      "chapterId": "4bed4dc0-4305-47dd-9239-6eca41434f72"
    },
    {
      "id": "33c9df1d-08c8-4512-be49-4b3ddcecb123",
      "text": "Được Thiên Chúa nhớ đến, chúng hớn hở mừng vui.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 4,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:12:27.712Z",
      "updatedAt": "2025-09-03T03:12:27.712Z",
      "chapterId": "4bed4dc0-4305-47dd-9239-6eca41434f72"
    },
    {
      "id": "3e0f9faf-84b1-4ab8-839d-1c6baca22d15",
      "text": "Xưa chúng bị quân thù áp giải,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:12:27.725Z",
      "updatedAt": "2025-09-03T03:12:27.725Z",
      "chapterId": "4bed4dc0-4305-47dd-9239-6eca41434f72"
    },
    {
      "id": "da4f31f3-efc7-4dc6-b967-d19930c2787d",
      "text": "phải rời ngươi, không xe không ngựa.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:12:27.740Z",
      "updatedAt": "2025-09-03T03:12:27.740Z",
      "chapterId": "4bed4dc0-4305-47dd-9239-6eca41434f72"
    },
    {
      "id": "62ea3a90-1e2f-4e53-92f0-3ecd9e4daab1",
      "text": "Nay Thiên Chúa lại đưa chúng trở về với ngươi,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:12:27.753Z",
      "updatedAt": "2025-09-03T03:12:27.753Z",
      "chapterId": "4bed4dc0-4305-47dd-9239-6eca41434f72"
    },
    {
      "id": "5a70df42-2a32-400e-bfe4-c59692679c2f",
      "text": "chúng được kiệu đi vinh quang rực rỡ, khác chi một ngai vàng.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 3,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:12:27.767Z",
      "updatedAt": "2025-09-03T03:12:27.767Z",
      "chapterId": "4bed4dc0-4305-47dd-9239-6eca41434f72"
    },
    {
      "id": "59505777-2dce-471c-8e22-cd6f5cd37c50",
      "text": "Vì Thiên Chúa đã ra lệnh phải bạt thấp núi cao",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:12:27.781Z",
      "updatedAt": "2025-09-03T03:12:27.781Z",
      "chapterId": "4bed4dc0-4305-47dd-9239-6eca41434f72"
    },
    {
      "id": "e6c6276f-3425-4799-a793-68e225b66e9f",
      "text": "và gò nổng có tự lâu đời,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:12:27.809Z",
      "updatedAt": "2025-09-03T03:12:27.809Z",
      "chapterId": "4bed4dc0-4305-47dd-9239-6eca41434f72"
    },
    {
      "id": "55d3d945-d5bd-4bd4-b817-bc8b6dc8deaf",
      "text": "phải lấp đầy thung lũng cho mặt đất phẳng phiu,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:12:27.822Z",
      "updatedAt": "2025-09-03T03:12:27.822Z",
      "chapterId": "4bed4dc0-4305-47dd-9239-6eca41434f72"
    },
    {
      "id": "75d7ee52-3cc1-4a8a-b27a-dcff106c15f8",
      "text": "để Ít-ra-en tiến bước an toàn",
      "label": "7",
      "number": 7,
      "subVerseIndex": 3,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:12:27.836Z",
      "updatedAt": "2025-09-03T03:12:27.836Z",
      "chapterId": "4bed4dc0-4305-47dd-9239-6eca41434f72"
    },
    {
      "id": "c5c0241a-de80-4d27-ab6b-718fe37a7188",
      "text": "dưới ánh vinh quang của Thiên Chúa.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 4,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:12:27.865Z",
      "updatedAt": "2025-09-03T03:12:27.865Z",
      "chapterId": "4bed4dc0-4305-47dd-9239-6eca41434f72"
    },
    {
      "id": "cc713587-cce8-4f3a-afcc-a433c2ec411a",
      "text": "Theo lệnh của Thiên Chúa, rừng xanh và đủ loại quế trầm",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:12:27.878Z",
      "updatedAt": "2025-09-03T03:12:27.878Z",
      "chapterId": "4bed4dc0-4305-47dd-9239-6eca41434f72"
    },
    {
      "id": "dbc257d0-728c-4449-b7f9-8e9a791939e9",
      "text": "sẽ toả bóng che rợp Ít-ra-en,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:12:27.893Z",
      "updatedAt": "2025-09-03T03:12:27.893Z",
      "chapterId": "4bed4dc0-4305-47dd-9239-6eca41434f72"
    },
    {
      "id": "5fe56a8f-e76c-454c-b97f-098caf7f1fde",
      "text": "vì Thiên Chúa sẽ dẫn Ít-ra-en đi trong hoan lạc,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:12:27.930Z",
      "updatedAt": "2025-09-03T03:12:27.930Z",
      "chapterId": "4bed4dc0-4305-47dd-9239-6eca41434f72"
    },
    {
      "id": "5932e6de-8f00-479c-b68e-a9b7cb047ea4",
      "text": "dưới ánh sáng vinh quang của Chúa,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:12:27.972Z",
      "updatedAt": "2025-09-03T03:12:27.972Z",
      "chapterId": "4bed4dc0-4305-47dd-9239-6eca41434f72"
    },
    {
      "id": "04f58e2f-6ef7-407b-a074-8996078e5123",
      "text": "cùng với lòng từ bi và sự công chính của Người.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:12:27.986Z",
      "updatedAt": "2025-09-03T03:12:27.986Z",
      "chapterId": "4bed4dc0-4305-47dd-9239-6eca41434f72"
    }
  ],
  "marks": [
    {
      "id": "00aa7b49-74dd-49e9-b06d-0eceb4ca42de",
      "content": "English: Jerusalem | French: Jérusalem | Latin: Ierusalem | Origin: &#1497;&#1456;&#1512;&#64309;&#64298;&#1464;&#1500;&#1461;&#1501; | Vietnamese: Giê-ru-sa-lem -- kinh thành Thiên Chúa, thành vua Đa-vít... -- 1 V 8,44.48",
      "kind": "MARK_KIND_FOOTNOTE",
