      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "4bed4dc0-4305-47dd-9239-6eca41434f72"
    },
    {
      "id": "ffea2fe6-90f6-478c-9673-f6ed20a290dd",
      "content": "Is 52,1",
      "kind": "MARK_KIND_REFERENCE",
      "label": "1@",
      "sortOrder": 0,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T03:12:27.453Z",
      "updatedAt": "2025-09-03T03:12:27.453Z",
      "targetId": "343455fe-3069-4f60-ba0d-65cc91f7f958",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "4bed4dc0-4305-47dd-9239-6eca41434f72"
    },
    {
      "id": "163c0f2c-6e00-4629-a2c1-51ccd1d36f28",
      "content": "Tác giả loan báo một niềm hy vọng lớn lao : những ngày sầu khổ không còn nữa. Thiên Chúa hiện diện giữa dân Người là dấu chứng bảo đảm cho sự thịnh vượng, an toàn.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 59,
      "endOffset": 59,
      "createdAt": "2025-09-03T03:12:27.478Z",
      "updatedAt": "2025-09-03T03:12:27.478Z",
      "targetId": "2f42477c-aae1-4d5b-9c8a-4c31cffba283",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "4bed4dc0-4305-47dd-9239-6eca41434f72"
    },
    {
      "id": "1d659ab8-f217-405b-8e02-0269452b2fe8",
      "content": "Is 61,10",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 19,
      "endOffset": 19,
      "createdAt": "2025-09-03T03:12:27.500Z",
      "updatedAt": "2025-09-03T03:12:27.500Z",
      "targetId": "17f9afee-b9c7-464f-8db0-8fc950c7791d",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "4bed4dc0-4305-47dd-9239-6eca41434f72"
    },
    {
      "id": "0ab7ffe7-8a2e-4664-888d-b73f959bf50a",
      "content": "Giê-ru-sa-lem được nổi danh hơn trước kia. Khắp thiên hạ sẽ thán phục Giê-ru-sa-lem. Nhưng có lẽ phải đợi Đức Ki-tô đến, một Giê-ru-sa-lem mới sẽ xuất hiện và thực hiện lời tiên báo này (x. Kh 21,1 – 22,15).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 37,
      "endOffset": 37,
      "createdAt": "2025-09-03T03:12:27.546Z",
      "updatedAt": "2025-09-03T03:12:27.546Z",
      "targetId": "497eab7f-4733-481e-928a-19b4800e4930",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "4bed4dc0-4305-47dd-9239-6eca41434f72"
    },
    {
      "id": "5fa8da14-32a3-4026-a43c-c329266701c1",
      "content": "Br 4,36-37",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 37,
      "endOffset": 37,
      "createdAt": "2025-09-03T03:12:27.677Z",
      "updatedAt": "2025-09-03T03:12:27.677Z",
      "targetId": "5cec0a0e-92e6-4794-952c-6c99c0adb142",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "4bed4dc0-4305-47dd-9239-6eca41434f72"
    },
    {
      "id": "ff72ce7d-027f-4d04-bc90-32e2a7e29109",
      "content": "Đặt tên mới cho Giê-ru-sa-lem là kêu gọi thành này sống đúng tên đó. Về tên thành Giê-ru-sa-lem x. Is 1,26 ; 60,14 ; 62,4.12 ; Gr 33,16 ; Ed 48,35.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 52,
      "endOffset": 52,
