      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "859468f7-9dd2-47bb-8c40-df992d3ca817",
      "content": "*Nháy mắt* có thể là hành vi ra hiệu mời ai liên minh trong một điều xấu, không tiện nói ra. Nháy mắt cũng có thể là hành vi chế giễu lầm lỗi của người khác.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "5",
      "sortOrder": 4,
      "startOffset": 11,
      "endOffset": 11,
      "createdAt": "2025-09-03T02:41:20.104Z",
      "updatedAt": "2025-09-03T02:41:20.104Z",
      "targetId": "739e59b1-5ff8-4731-9a61-4fdc9e9e6516",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "6489147f-bac0-4ae6-8f48-232556dcde46",
      "content": "Cn 10,11",
      "kind": "MARK_KIND_REFERENCE",
      "label": "6@",
      "sortOrder": 5,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:41:19.971Z",
      "updatedAt": "2025-09-03T02:41:19.971Z",
      "targetId": "c57065ba-3c54-4276-ae27-5d42e6eaacfa",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "30d6ede8-9526-4a93-bdab-cf2a987e7b20",
      "content": "C.10b được dịch theo HL. Theo HR, c.10b giống hệt c.8b.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "6",
      "sortOrder": 5,
      "startOffset": 41,
      "endOffset": 41,
      "createdAt": "2025-09-03T02:41:20.147Z",
      "updatedAt": "2025-09-03T02:41:20.147Z",
      "targetId": "72b605af-4f54-48bb-85c7-ce10c05a241f",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "b7aa82ad-9a77-4abf-a7d3-c6837a71aec0",
      "content": "Cn 10,10 =",
      "kind": "MARK_KIND_REFERENCE",
      "label": "7@",
      "sortOrder": 6,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:41:20.042Z",
      "updatedAt": "2025-09-03T02:41:20.042Z",
      "targetId": "71631e9b-9c4a-41b3-92c1-c83e7ec1da4b",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "90c464ba-9deb-4e25-a604-c127b2295db9",
      "content": "ds : *che giấu*. Có sự che giấu vì muốn giữ kín một âm mưu (c.11b). Có sự che giấu vì yêu thương (c.12b). Đây là một châm ngôn được các Tông Đồ ưa thích (x. 1 Cr 13,7 ; Gc 5,20 ; 1 Pr 4,8).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "7",
      "sortOrder": 6,
      "startOffset": 17,
      "endOffset": 17,
      "createdAt": "2025-09-03T02:41:20.259Z",
      "updatedAt": "2025-09-03T02:41:20.259Z",
      "targetId": "d6c5c5bf-8005-4bf5-a2c2-740565c3b62b",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "fb27356e-2ca9-40f7-8964-3199796b072b",
      "content": "Cn 6,13",
      "kind": "MARK_KIND_REFERENCE",
      "label": "8@",
      "sortOrder": 7,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:41:20.118Z",
      "updatedAt": "2025-09-03T02:41:20.118Z",
      "targetId": "739e59b1-5ff8-4731-9a61-4fdc9e9e6516",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "61f3743c-322c-460c-ab8d-414672d81927",
      "content": "Đây chỉ là một nhận xét của tác giả được linh hứng. Quả thực của cải đem lại bạn hữu (14,20 ; 19,4) và quyền uy (18,23 ; 22,7). Còn cảnh nghèo khiến người ta phải chịu lép vế (18,23), không có bạn bè (19,7), không chỗ cậy dựa. Dĩ nhiên ai cũng biết, chỉ Thiên Chúa mới là chỗ cậy dựa vững chắc nhất cho con người (x. Tv 52,7).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "8",
      "sortOrder": 7,
      "startOffset": 42,
      "endOffset": 42,
      "createdAt": "2025-09-03T02:41:20.388Z",
      "updatedAt": "2025-09-03T02:41:20.388Z",
      "targetId": "e7f22acc-ca54-42cd-bbd0-3d8d01d26f16",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "ee062656-6b01-44f4-b27f-34092198c592",
      "content": "Cn 10,3 =",
      "kind": "MARK_KIND_REFERENCE",
      "label": "9@",
      "sortOrder": 8,
      "startOffset": 35,
      "endOffset": 35,
      "createdAt": "2025-09-03T02:41:20.161Z",
      "updatedAt": "2025-09-03T02:41:20.161Z",
      "targetId": "72b605af-4f54-48bb-85c7-ce10c05a241f",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "2482c6e6-5894-4892-b799-14df36ecbbf0",
      "content": "Câu này và ba câu sau đều bàn về lời nói. Lời nói có thể gây thương tích và làm hại, nhưng nó cũng có thể nâng đỡ người khác lúc gặp khó khăn.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "9",
      "sortOrder": 8,
      "startOffset": 33,
      "endOffset": 33,
      "createdAt": "2025-09-03T02:41:20.489Z",
      "updatedAt": "2025-09-03T02:41:20.489Z",
      "targetId": "6914cb86-319d-45ca-9602-9baf2221feb9",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "71e832a9-1e3b-4389-b830-46bda03de5b2",
      "content": "Cn 13,14; 14,27",
