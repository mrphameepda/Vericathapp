{
  "chapter": {
    "id": "80fb2c7d-9948-402c-b5db-2328b66b5b14",
    "number": 10,
    "createdAt": "2025-09-03T01:07:51.667Z",
    "updatedAt": "2025-09-03T01:07:51.667Z",
    "bookId": "1ea97633-82d8-4f1a-bffc-dfb2da235911"
  },
  "verses": [
    {
      "id": "9e40a346-4175-4277-a147-10ae9e2f0e6b",
      "text": "Châm ngôn của vua Sa-lô-môn.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:41:19.650Z",
      "updatedAt": "2025-09-03T02:41:19.650Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "4b91137d-9e19-4bc6-901b-d4dc1ddacd5b",
      "text": "Con khôn làm cha vui sướng,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:19.730Z",
      "updatedAt": "2025-09-03T02:41:19.730Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "7b99c1e9-2ae4-45f7-b737-03e6e533734c",
      "text": "con dại làm mẹ buồn phiền.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:19.757Z",
      "updatedAt": "2025-09-03T02:41:19.757Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "4d4de04c-149a-4c47-8b75-59d8b634d663",
      "text": "Của phi nghĩa nào lợi ích chi,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:19.774Z",
      "updatedAt": "2025-09-03T02:41:19.774Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "11ee4e66-59b9-4fbd-90fd-38f7af5fd5d5",
      "text": "sống công chính mới cứu ta khỏi chết.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:19.789Z",
      "updatedAt": "2025-09-03T02:41:19.789Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "917d27f4-3a7a-4ac1-a3e9-8b388461a7bf",
      "text": "ĐỨC CHÚA không để kẻ công chính phải đói bao giờ ;",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:19.817Z",
      "updatedAt": "2025-09-03T02:41:19.817Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "033ae57c-b016-42c3-8879-496ba64bb34c",
      "text": "Người gạt bỏ tham vọng phường gian ác.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:19.845Z",
      "updatedAt": "2025-09-03T02:41:19.845Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "97d71fea-1267-4933-8754-ef37ecc70f78",
      "text": "Kẻ biếng nhác phải chịu cảnh nghèo hèn,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:19.859Z",
      "updatedAt": "2025-09-03T02:41:19.859Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "7b20e710-f9e7-43d7-8b58-39ad4ff0ef5c",
      "text": "người siêng năng được giàu sang phú quý.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:19.872Z",
      "updatedAt": "2025-09-03T02:41:19.872Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "752c3533-a841-407e-bb26-96eda277d521",
      "text": "Mùa hè thu hoạch là khôn,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:19.887Z",
      "updatedAt": "2025-09-03T02:41:19.887Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "4d105eaa-4cc9-432b-9147-bf74fd513d79",
      "text": "mùa gặt ngủ vùi là nhục.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:19.901Z",
      "updatedAt": "2025-09-03T02:41:19.901Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "2c2a65b2-791b-4ea3-af64-8efd25a43b25",
      "text": "Đầu người công chính được Chúa chúc lành,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:19.930Z",
      "updatedAt": "2025-09-03T02:41:19.930Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "c57065ba-3c54-4276-ae27-5d42e6eaacfa",
      "text": "miệng kẻ gian ác chất chứa lời độc địa.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:19.957Z",
      "updatedAt": "2025-09-03T02:41:19.957Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "75f88c86-d999-47ab-a481-98b13801093d",
      "text": "Người ngay chính được tưởng nhớ và ngợi khen,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:19.985Z",
      "updatedAt": "2025-09-03T02:41:19.985Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "3cb2b699-8be2-4e44-b253-081ef93713c1",
      "text": "còn tên tuổi kẻ gian tà sẽ mai một.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20Z",
      "updatedAt": "2025-09-03T02:41:20Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "b1db7494-6af4-4c9e-8933-8a7582f1a153",
      "text": "Người có trí khôn ngoan đón nhận các lệnh truyền,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.014Z",
      "updatedAt": "2025-09-03T02:41:20.014Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "71631e9b-9c4a-41b3-92c1-c83e7ec1da4b",
      "text": "kẻ môi miệng dại khờ sẽ bị tiêu vong.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.028Z",
      "updatedAt": "2025-09-03T02:41:20.028Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "2ddca6c3-4ef4-4b58-af08-c3cad2ba0f71",
      "text": "Ai sống liêm chính sẽ được an toàn,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.056Z",
      "updatedAt": "2025-09-03T02:41:20.056Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "8582a794-1914-468d-b75c-1612ccc3e544",
      "text": "kẻ đi đường quanh co ắt sẽ bị phát hiện.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.073Z",
      "updatedAt": "2025-09-03T02:41:20.073Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "739e59b1-5ff8-4731-9a61-4fdc9e9e6516",
      "text": "Kẻ nháy mắt sẽ gây ra đau khổ,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.090Z",
      "updatedAt": "2025-09-03T02:41:20.090Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "72b605af-4f54-48bb-85c7-ce10c05a241f",
      "text": "người thẳng thắn rầy la sẽ đem lại an hoà.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.132Z",
      "updatedAt": "2025-09-03T02:41:20.132Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "6bb007fd-601f-4400-b735-aab0be66238c",
      "text": "Miệng người ngay là suối nguồn sự sống,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.175Z",
      "updatedAt": "2025-09-03T02:41:20.175Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "9e05b646-188f-402d-ab59-63e64b05b8e0",
      "text": "miệng kẻ ác ẩn giấu bạo hành.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.203Z",
      "updatedAt": "2025-09-03T02:41:20.203Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "6e52be93-fd0c-417d-a00d-5e3339dd07df",
      "text": "Ghét ghen sinh cãi vã,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.230Z",
      "updatedAt": "2025-09-03T02:41:20.230Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "d6c5c5bf-8005-4bf5-a2c2-740565c3b62b",
      "text": "tình yêu khoả lấp mọi lỗi lầm.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.244Z",
      "updatedAt": "2025-09-03T02:41:20.244Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "88221cad-8585-46cc-9311-da49f45f42ba",
      "text": "Khôn ngoan ở trên môi người sáng suốt,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.273Z",
      "updatedAt": "2025-09-03T02:41:20.273Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "7f198466-2b20-4645-940c-b95d2dc22ab9",
      "text": "roi vọt đập xuống lưng kẻ ngu si.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.287Z",
      "updatedAt": "2025-09-03T02:41:20.287Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "68d6d78a-4eec-430c-96a8-4b38e81b9543",
      "text": "Người khôn giữ kỹ điều mình biết,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.319Z",
      "updatedAt": "2025-09-03T02:41:20.319Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "d001213b-8720-4ce2-9384-f3448455fd27",
      "text": "kẻ ngu mở miệng là tai hoạ đến gần.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.333Z",
      "updatedAt": "2025-09-03T02:41:20.333Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "4d0b70c2-67c3-4ca3-aaca-660f03f856fc",
      "text": "Của cải người giàu là thành trì kiên vững,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.356Z",
      "updatedAt": "2025-09-03T02:41:20.356Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "e7f22acc-ca54-42cd-bbd0-3d8d01d26f16",
      "text": "cảnh nghèo khiến kẻ yếu thế phải tiêu vong.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.377Z",
      "updatedAt": "2025-09-03T02:41:20.377Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "e8d81a32-0e65-49bb-9754-0c7bd6fb118b",
      "text": "Lương bổng của người ngay dẫn đến sự sống,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.398Z",
      "updatedAt": "2025-09-03T02:41:20.398Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "05f6e4f5-2331-4639-9c59-197e9800bd1b",
      "text": "huê lợi của kẻ ác đưa đến tội khiên.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.409Z",
      "updatedAt": "2025-09-03T02:41:20.409Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "9c304646-ea83-4c90-b43d-cfdf2f398ab9",
      "text": "Người giữ lời nghiêm huấn thì đi trong sinh lộ,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.421Z",
      "updatedAt": "2025-09-03T02:41:20.421Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "a98d7ab1-118d-412f-bb02-b9391a3fab92",
      "text": "kẻ khinh lời sửa dạy ắt sẽ bị lạc đường.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.447Z",
      "updatedAt": "2025-09-03T02:41:20.447Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "03b1b93c-d0e5-4fab-a271-b27e1a2e76db",
      "text": "Môi lọc lừa che giấu lòng thù ghét,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.461Z",
      "updatedAt": "2025-09-03T02:41:20.461Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "6914cb86-319d-45ca-9602-9baf2221feb9",
      "text": "kẻ buông lời vu cáo là đứa ngu si.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.475Z",
      "updatedAt": "2025-09-03T02:41:20.475Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "30b7b8c7-93d6-485f-9e3f-b609f179a051",
      "text": "Người năng nói năng lỗi,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.503Z",
      "updatedAt": "2025-09-03T02:41:20.503Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "904b955c-10e7-4721-8152-b9045966094e",
      "text": "ai dè giữ lời nói mới là người khôn.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.517Z",
      "updatedAt": "2025-09-03T02:41:20.517Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "fe21873a-1f2d-4553-81ce-38b8dc621953",
      "text": "Lưỡi người ngay là bạc ròng hảo hạng,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.544Z",
      "updatedAt": "2025-09-03T02:41:20.544Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "a7020370-6b33-42a1-b541-91f8a89819a4",
      "text": "tâm kẻ dữ chẳng đáng giá bao nhiêu.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.573Z",
      "updatedAt": "2025-09-03T02:41:20.573Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "6147e7a9-9bb7-4736-9635-4c07127f7c15",
      "text": "Môi kẻ ngay nuôi sống nhiều người,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.587Z",
      "updatedAt": "2025-09-03T02:41:20.587Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "221534d6-a726-44f3-a726-474a3a918deb",
      "text": "còn đứa dại chết vì dốt nát.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.601Z",
      "updatedAt": "2025-09-03T02:41:20.601Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "102e3465-52a7-4c2e-bd76-1bdd6db6ecf3",
      "text": "Chính phúc lành của ĐỨC CHÚA cho ta được giàu sang,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.615Z",
      "updatedAt": "2025-09-03T02:41:20.615Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "c562fa81-965f-42db-b614-1aa348bb5438",
      "text": "vất vả nhọc nhằn chẳng thêm chi vào đó.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.657Z",
      "updatedAt": "2025-09-03T02:41:20.657Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "45225ccb-740b-421f-82c5-36ae3ad298cf",
      "text": "Gây tội ác là trò tiêu khiển của người ngu,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.685Z",
      "updatedAt": "2025-09-03T02:41:20.685Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "2f42dac9-1475-49e0-8cad-e71059fe62cb",
      "text": "còn khôn ngoan là thú vui cho người hiểu biết.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.703Z",
      "updatedAt": "2025-09-03T02:41:20.703Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "7be26ced-4a66-4ad6-b73c-3e1d08133f36",
      "text": "Ác nhân khiếp sợ chi là gặp ngay điều đó,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.731Z",
      "updatedAt": "2025-09-03T02:41:20.731Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "fd0b9e64-f56c-4c44-9022-7be693fbf8b2",
      "text": "chính nhân mong ước gì, ắt sẽ được ban cho.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.745Z",
      "updatedAt": "2025-09-03T02:41:20.745Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "c6c73c78-34d9-46a8-9d10-24b3e9acbbd4",
      "text": "Cuồng phong thổi qua, ác nhân đâu còn nữa,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.760Z",
      "updatedAt": "2025-09-03T02:41:20.760Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "a67658f6-1bc8-4807-901b-ebb288cfb443",
      "text": "nhưng người ngay chính vẫn bền vững ngàn năm.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.774Z",
      "updatedAt": "2025-09-03T02:41:20.774Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "e1443fbb-2912-405e-bf31-d134f2c92b9b",
      "text": "Giấm làm ghê răng, khói làm cay mắt,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.788Z",
      "updatedAt": "2025-09-03T02:41:20.788Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "2c5fdc06-fb35-4c1e-971a-0cf6fc3c9a09",
      "text": "đứa lười làm bực bội người sai nó đi.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.802Z",
      "updatedAt": "2025-09-03T02:41:20.802Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "ca90afe2-8c74-406e-8194-974b6cbe787c",
      "text": "Ai kính sợ ĐỨC CHÚA sẽ được trường thọ,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.817Z",
      "updatedAt": "2025-09-03T02:41:20.817Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "cbe18462-36f5-477e-b6b8-90ea6bb298fa",
      "text": "còn tuổi đời đứa ác bị rút ngắn đi.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.873Z",
      "updatedAt": "2025-09-03T02:41:20.873Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "07718efc-eaf1-4464-96a0-c194946e4a4b",
      "text": "Mong ước của người ngay dẫn đến vui mừng,",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.888Z",
      "updatedAt": "2025-09-03T02:41:20.888Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "c46dce0b-160e-466a-9634-28a04f66d38b",
      "text": "hy vọng của ác nhân sẽ tan thành mây khói.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 1,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.902Z",
      "updatedAt": "2025-09-03T02:41:20.902Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "d6232a83-1ce1-41e8-83e2-ede6e4d5b5d5",
      "text": "Đường lối của ĐỨC CHÚA là thành luỹ chở che người liêm chính,",
      "label": "29",
      "number": 29,
      "subVerseIndex": 0,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.931Z",
      "updatedAt": "2025-09-03T02:41:20.931Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "a31da0c4-10f4-47b4-aa78-c03d0df2205b",
      "text": "nhưng lại khiến kẻ làm điều ác phải tiêu vong.",
      "label": "29",
      "number": 29,
      "subVerseIndex": 1,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.959Z",
      "updatedAt": "2025-09-03T02:41:20.959Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "526c0707-5957-4e30-9a75-df02737ce686",
      "text": "Muôn đời người ngay không nao núng,",
      "label": "30",
      "number": 30,
      "subVerseIndex": 0,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:20.973Z",
      "updatedAt": "2025-09-03T02:41:20.973Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "31a14334-5f27-45cc-a4c1-2888cd59e450",
      "text": "còn ác nhân sẽ chẳng được sống ở quê hương.",
      "label": "30",
      "number": 30,
      "subVerseIndex": 1,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:21.001Z",
      "updatedAt": "2025-09-03T02:41:21.001Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "5e03d173-46de-4241-a8e6-2d91d36852d1",
      "text": "Miệng người công chính nói điều khôn ngoan,",
      "label": "31",
      "number": 31,
      "subVerseIndex": 0,
      "paragraphNumber": 61,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:21.015Z",
      "updatedAt": "2025-09-03T02:41:21.015Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "43ead906-c036-4fc4-a171-7ef6dde65161",
      "text": "lưỡi đứa gian tà sẽ bị xẻo đi mất.",
      "label": "31",
      "number": 31,
      "subVerseIndex": 1,
      "paragraphNumber": 62,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:21.043Z",
      "updatedAt": "2025-09-03T02:41:21.043Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "b8259308-01aa-4dc8-b052-59296aa96184",
      "text": "Môi người ngay làm kẻ nghe hả dạ,",
      "label": "32",
      "number": 32,
      "subVerseIndex": 0,
      "paragraphNumber": 63,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:21.058Z",
      "updatedAt": "2025-09-03T02:41:21.058Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    },
    {
      "id": "3093766f-102b-4276-9809-c5c2a6536052",
      "text": "miệng đứa ác nói toàn chuyện dối gian.",
      "label": "32",
      "number": 32,
      "subVerseIndex": 1,
      "paragraphNumber": 64,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:21.072Z",
      "updatedAt": "2025-09-03T02:41:21.072Z",
      "chapterId": "80fb2c7d-9948-402c-b5db-2328b66b5b14"
    }
  ],
  "marks": [
    {
      "id": "656f9d82-ab46-48d0-81b1-69cae5f61524",
      "content": "Đây là phần dài nhất trong sách Cn (10,1 – 22,16), gồm 375 câu châm ngôn về mọi khía cạnh của cuộc sống cá nhân trong xã hội. Các câu có cùng chủ đề lại nằm rải rác ở những chỗ khác nhau. Có thể nói các ch. 10-15 phần lớn gồm những châm ngôn nói lên sự tương phản giữa người công chính và đứa ác nhân. Còn các ch. 16-22 nói nhiều hơn về những lời khuyên thực tế để giúp thành đạt ở đời. Các châm ngôn cổ thường ít khi nhắc đến Thiên Chúa, chỉ giúp cách đạt được thành công. Các châm ngôn sau này nhấn mạnh đến quyền làm chủ của Đức Chúa trên thành công và thất bại.",
      "kind": "MARK_KIND_FOOTNOTE",
