    {
      "id": "71f8e27e-4191-4aab-a55f-04aae7e4f8e2",
      "content": "Cn 10,7.22; 11,11",
      "kind": "MARK_KIND_REFERENCE",
      "label": "5@",
      "sortOrder": 4,
      "startOffset": 31,
      "endOffset": 31,
      "createdAt": "2025-09-03T02:41:19.944Z",
