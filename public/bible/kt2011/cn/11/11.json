      "sortOrder": 0,
      "startOffset": 17,
      "endOffset": 17,
      "createdAt": "2025-09-03T02:41:26.171Z",
      "updatedAt": "2025-09-03T02:41:26.171Z",
      "targetId": "5e700603-38a7-41cb-87c7-4e94be935ee6",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "2aeba1ff-3f49-432f-a0dd-dd7f48d96264",
      "content": "Đức Chúa yêu chuộng sự công bình, đó là lời nhắc nhở của các nhà khôn ngoan. Ta gặp những lời nhắc nhở tương tự trong Luật (Lv 19,35-36 ; Đnl 25,13-16), và trong các sách Ngôn Sứ (Am 8,5-6 ; Mk 6,11).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 32,
      "endOffset": 32,
      "createdAt": "2025-09-03T02:41:26.200Z",
      "updatedAt": "2025-09-03T02:41:26.200Z",
      "targetId": "1baf29ae-bc01-4483-8659-b1fec315b87d",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "c2cb0c03-f9be-4cea-ba50-3f63600881c3",
      "content": "Cn 13,10; 16,18; 21,24",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:41:26.227Z",
      "updatedAt": "2025-09-03T02:41:26.227Z",
      "targetId": "dddf7a3e-38b1-473e-a855-4f330e81187d",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "9b5ca044-fe35-4d39-ac9d-6c69d7089e76",
      "content": "Điều đáng kể trước mặt Chúa không phải là điều tôi có, nhưng là chính con người tôi.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 39,
      "endOffset": 39,
      "createdAt": "2025-09-03T02:41:26.310Z",
      "updatedAt": "2025-09-03T02:41:26.310Z",
      "targetId": "318defd1-43d1-4806-b172-c8307ea12ed1",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "178b012f-7def-4af9-b3ca-b8089a63d1d5",
      "content": "Cn 10,2",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 8,
      "endOffset": 8,
      "createdAt": "2025-09-03T02:41:26.325Z",
      "updatedAt": "2025-09-03T02:41:26.325Z",
      "targetId": "318defd1-43d1-4806-b172-c8307ea12ed1",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "5e2b4ef0-69ff-4146-a933-72a1efe1042c",
      "content": "Cn 10,28",
      "kind": "MARK_KIND_REFERENCE",
      "label": "4@",
      "sortOrder": 3,
      "startOffset": 23,
      "endOffset": 23,
      "createdAt": "2025-09-03T02:41:26.415Z",
      "updatedAt": "2025-09-03T02:41:26.415Z",
      "targetId": "4e033c46-a1c1-46bf-b16e-b5fe5d304b98",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "c440b852-5f6d-48f4-b424-ea0e105608b1",
      "content": "Câu không rõ. Có bản dịch là *cậy trông vào sức mình*.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 29,
      "endOffset": 29,
      "createdAt": "2025-09-03T02:41:26.441Z",
      "updatedAt": "2025-09-03T02:41:26.441Z",
      "targetId": "5ce8157b-99b1-4e16-8f4e-6ce0cd95232e",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "e1674014-d12f-4c0e-bbe4-b42fc9867038",
      "content": "Ha-man bị hành hình thế chỗ cho ông Moóc-đo-khai được cứu thoát (Et 5,14 ; 7,10).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "5",
      "sortOrder": 4,
      "startOffset": 31,
      "endOffset": 31,
      "createdAt": "2025-09-03T02:41:26.485Z",
      "updatedAt": "2025-09-03T02:41:26.485Z",
      "targetId": "a8996f27-ca88-4066-a90a-ad865e115bd8",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "f8ccd697-2260-4855-a8c4-790c84997311",
      "content": "Cn 28,12.28; 29,2.16",
      "kind": "MARK_KIND_REFERENCE",
      "label": "5@",
      "sortOrder": 4,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:41:26.553Z",
      "updatedAt": "2025-09-03T02:41:26.553Z",
      "targetId": "f6626377-dde6-4eac-b2e1-cdb87f2bdb32",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "42a1c5f4-e19d-438a-97d7-8c219a685fd0",
      "content": "Cc. 9-15 đặc biệt cho thấy lối sống của người lành kẻ dữ gây ảnh hưởng trên tha nhân và xã hội như thế nào.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "6",
      "sortOrder": 5,
