{
  "chapter": {
    "id": "ece8dbc3-354b-4da9-aa42-d40328e3630b",
    "number": 11,
    "createdAt": "2025-09-03T01:07:51.667Z",
    "updatedAt": "2025-09-03T01:07:51.667Z",
    "bookId": "1ea97633-82d8-4f1a-bffc-dfb2da235911"
  },
  "verses": [
    {
      "id": "5e700603-38a7-41cb-87c7-4e94be935ee6",
      "text": "ĐỨC CHÚA ghê tởm bàn cân gian,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:26.139Z",
      "updatedAt": "2025-09-03T02:41:26.139Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "1baf29ae-bc01-4483-8659-b1fec315b87d",
      "text": "nhưng ưa thích quả cân chính xác.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:26.185Z",
      "updatedAt": "2025-09-03T02:41:26.185Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "dddf7a3e-38b1-473e-a855-4f330e81187d",
      "text": "Kiêu hãnh đi liền với ô nhục,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:26.213Z",
      "updatedAt": "2025-09-03T02:41:26.213Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "59efb22e-5d2f-487f-b244-c80c3f7b4aa8",
      "text": "khôn ngoan ở với kẻ khiêm nhường.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:26.241Z",
      "updatedAt": "2025-09-03T02:41:26.241Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "8dd9b210-ba83-44ee-b249-0b3e1306ea17",
      "text": "Đức liêm khiết của người chính trực sẽ dẫn lối họ đi,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:26.255Z",
      "updatedAt": "2025-09-03T02:41:26.255Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "30f0e4e1-4bde-42b6-8f26-efcda262a5dc",
      "text": "còn mưu mô của kẻ lọc lừa khiến chúng bị tiêu diệt.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:26.268Z",
      "updatedAt": "2025-09-03T02:41:26.268Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "97891475-0cb6-421d-93f3-f2c98338d0b9",
      "text": "Trong ngày thịnh nộ, của cải ích lợi chi,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:26.282Z",
      "updatedAt": "2025-09-03T02:41:26.282Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "318defd1-43d1-4806-b172-c8307ea12ed1",
      "text": "chỉ đức công chính mới cứu khỏi tử thần.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:26.296Z",
      "updatedAt": "2025-09-03T02:41:26.296Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "177c7304-8f96-43ea-8959-ac1b2ca14580",
      "text": "Đức công chính của người sống vẹn toàn",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:26.338Z",
      "updatedAt": "2025-09-03T02:41:26.338Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "3a52afdc-ff29-4261-8841-f5e23973c2f8",
      "text": "sẽ giúp họ thẳng đường tiến bước,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:26.352Z",
      "updatedAt": "2025-09-03T02:41:26.352Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "76dc685a-0e08-48b3-848a-4acde8cbe4f7",
      "text": "còn ác nhân lại sa vào chính mưu độc của nó.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:26.364Z",
      "updatedAt": "2025-09-03T02:41:26.364Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "eaa77f18-967a-4c47-93c0-d86afa150afc",
      "text": "Đức công chính của người ngay thẳng sẽ cứu họ,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:26.377Z",
      "updatedAt": "2025-09-03T02:41:26.377Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "20e59396-ae97-47bc-9ffd-7d8cba8ad9c8",
      "text": "còn kẻ lừa đảo lại mắc bẫy vì tham lam.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:26.390Z",
      "updatedAt": "2025-09-03T02:41:26.390Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "4e033c46-a1c1-46bf-b16e-b5fe5d304b98",
      "text": "Khi ác nhân nằm xuống, mối hy vọng của nó tiêu tan,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:26.402Z",
      "updatedAt": "2025-09-03T02:41:26.402Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "5ce8157b-99b1-4e16-8f4e-6ce0cd95232e",
      "text": "và niềm cậy trông vào của cải cũng tan thành mây khói.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:26.428Z",
      "updatedAt": "2025-09-03T02:41:26.428Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "2a925c44-4aed-4ef2-bc48-4b894ca66e60",
      "text": "Người công chính được thoát cảnh hiểm nghèo,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:26.455Z",
      "updatedAt": "2025-09-03T02:41:26.455Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "a8996f27-ca88-4066-a90a-ad865e115bd8",
      "text": "đứa gian tà lại rơi vào thế chỗ.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:26.472Z",
      "updatedAt": "2025-09-03T02:41:26.472Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "6391f456-9a6e-45ad-bbe7-6b4412ed769a",
      "text": "Quân vô đạo dùng miệng lưỡi làm hại tha nhân,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:26.498Z",
      "updatedAt": "2025-09-03T02:41:26.498Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "b4866b90-5bcb-403b-b633-d13b118e4a24",
      "text": "bậc chính nhân nhờ tri thức mà được cứu thoát.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:26.512Z",
      "updatedAt": "2025-09-03T02:41:26.512Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "f6626377-dde6-4eac-b2e1-cdb87f2bdb32",
      "text": "Chính nhân thịnh đạt, cả thành mừng rỡ,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:26.539Z",
      "updatedAt": "2025-09-03T02:41:26.539Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "078677f7-eece-410d-92fe-fe6a3cb314e6",
      "text": "kẻ ác tiêu vong, ai cũng reo hò.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:26.566Z",
      "updatedAt": "2025-09-03T02:41:26.566Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "fd8897a0-1bed-4126-b93b-5d37d51263c1",
      "text": "Người ngay chúc phúc, cả thành được thịnh vượng,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:26.580Z",
      "updatedAt": "2025-09-03T02:41:26.580Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "c7d9dd56-e451-4151-aa10-ab7caab06670",
      "text": "ác nhân mở miệng, cả thành phải tiêu vong.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:26.595Z",
      "updatedAt": "2025-09-03T02:41:26.595Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "d4149a02-91c7-4d5a-95cf-7756afc759fe",
      "text": "Kẻ thiếu lương tri mới khinh khi người khác,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:26.633Z",
      "updatedAt": "2025-09-03T02:41:26.633Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "3a42a656-7e4b-406b-8d47-358f3d14f445",
      "text": "người giàu hiểu biết thì ngậm miệng làm thinh.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:26.661Z",
      "updatedAt": "2025-09-03T02:41:26.661Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "46be5d0a-99be-4849-b472-c7310df5e094",
      "text": "Đứa ngồi lê đôi mách sẽ tiết lộ điều bí mật,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:26.675Z",
      "updatedAt": "2025-09-03T02:41:26.675Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "a3d46cc3-9cc5-445a-81d9-1729ce37d0f2",
      "text": "còn người tín cẩn giữ kín chuyện riêng tư.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:26.703Z",
      "updatedAt": "2025-09-03T02:41:26.703Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "35d3057b-446f-4dd6-8b63-a5109c5dab18",
      "text": "Thiếu lãnh đạo, dân tộc bị sụp đổ,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:26.717Z",
      "updatedAt": "2025-09-03T02:41:26.717Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "58eb4aab-ef9c-4e51-886e-e708ec39e247",
      "text": "nhiều cố vấn, đất nước được an ninh.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:26.744Z",
      "updatedAt": "2025-09-03T02:41:26.744Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "9a6e5cd7-a58c-4fe5-9c0b-c078df980fcb",
      "text": "Ai bảo lãnh người lạ sẽ chuốc hoạ vào thân,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:26.758Z",
      "updatedAt": "2025-09-03T02:41:26.758Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "471a3dc2-4a5e-4353-9ec7-1fba40490a80",
      "text": "kẻ ghét chuyện giao kèo được bình yên vô sự.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:26.787Z",
      "updatedAt": "2025-09-03T02:41:26.787Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "ebdac37d-64ba-421f-ae23-48a0b413fc1e",
      "text": "Đàn bà có duyên được tiếng tăm,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:26.814Z",
      "updatedAt": "2025-09-03T02:41:26.814Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "1d548f42-b7d5-42ac-a292-e738fea19605",
      "text": "đàn ông gan dạ được giàu có.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:26.828Z",
      "updatedAt": "2025-09-03T02:41:26.828Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "e42bb06c-554b-45ed-bc03-e6950a337e0d",
      "text": "Người nhân hậu làm ích cho bản thân,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:26.861Z",
      "updatedAt": "2025-09-03T02:41:26.861Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "e8def4d3-d936-44c3-ad0f-27e74de438ec",
      "text": "kẻ tàn nhẫn lại làm hại chính mình.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:26.872Z",
      "updatedAt": "2025-09-03T02:41:26.872Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "149ae395-63f9-48af-b4e0-54372e4427fc",
      "text": "Kẻ làm điều ác lãnh đồng lương hư ảo,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:26.896Z",
      "updatedAt": "2025-09-03T02:41:26.896Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "62d3d579-0fd2-478b-afe4-31746efb0448",
      "text": "người gieo công chính được phần thưởng vững bền.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:26.909Z",
      "updatedAt": "2025-09-03T02:41:26.909Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "0e8d29e1-a81c-46af-8047-3242ae341728",
      "text": "Người thực thi công chính được đi vào cõi sống,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:26.921Z",
      "updatedAt": "2025-09-03T02:41:26.921Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "ba6633f3-234c-432d-ab18-e22b153099e0",
      "text": "kẻ theo đuổi gian tà phải đến chốn tử vong.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:26.933Z",
      "updatedAt": "2025-09-03T02:41:26.933Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "e8880a69-d63a-45a4-a81c-84a94d3978c0",
      "text": "ĐỨC CHÚA ghê tởm tâm địa quanh co,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:26.945Z",
      "updatedAt": "2025-09-03T02:41:26.945Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "fcbaf64d-4963-4954-b14b-8e01bc7d9bcc",
      "text": "nhưng ưa thích lối sống vẹn toàn.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:26.984Z",
      "updatedAt": "2025-09-03T02:41:26.984Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "139d282d-d35d-4780-bc25-3b53935e55be",
      "text": "Hẳn ác nhân không thoát khỏi hình phạt,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:26.997Z",
      "updatedAt": "2025-09-03T02:41:26.997Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "60a76e99-1252-4b8b-9d71-d7ab8619a8bc",
      "text": "nhưng giống nòi người công chính sẽ được cứu nguy.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:27.011Z",
      "updatedAt": "2025-09-03T02:41:27.011Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "2606ea8a-3154-489a-95ca-75ec966caa49",
      "text": "Phụ nữ đẹp người mà không đẹp nết",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:27.024Z",
      "updatedAt": "2025-09-03T02:41:27.024Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "756fb6fd-d00e-488c-be98-7aed94f923e1",
      "text": "khác chi khuyên vàng đem xỏ mũi heo.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:27.037Z",
      "updatedAt": "2025-09-03T02:41:27.037Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "a5e315ba-3aa3-4074-b46e-7d16a494e7b7",
      "text": "Khát vọng của chính nhân ắt sẽ được thành tựu,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:27.064Z",
      "updatedAt": "2025-09-03T02:41:27.064Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "fa2c5481-472f-42dd-87fe-41d183af7066",
      "text": "hy vọng của kẻ ác đáng chịu thịnh nộ thôi.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:27.078Z",
      "updatedAt": "2025-09-03T02:41:27.078Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "cdb3ce0a-81e1-40d9-ac12-e29be5b4b33c",
      "text": "Người hào phóng lại được thêm giàu có,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:27.092Z",
      "updatedAt": "2025-09-03T02:41:27.092Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "89ed1a75-6de0-4629-b1ae-f0b59087e458",
      "text": "kẻ hà tiện lại lâm cảnh túng nghèo.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:27.107Z",
      "updatedAt": "2025-09-03T02:41:27.107Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "f2b2b889-8e30-4dc3-a9ff-c072988fa0ba",
      "text": "Người rộng lượng được phương phi béo tốt,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:27.135Z",
      "updatedAt": "2025-09-03T02:41:27.135Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "eb469284-03a0-4b8c-9f6b-7f7233e9b823",
      "text": "chính kẻ cho uống lại được uống thoả thuê.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:27.149Z",
      "updatedAt": "2025-09-03T02:41:27.149Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "9cec85d9-b1dd-47a4-93c9-29f7e900a2b4",
      "text": "Dân chúng nguyền rủa kẻ đầu cơ lúa gạo,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:27.163Z",
      "updatedAt": "2025-09-03T02:41:27.163Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "f86a587b-7f94-41c8-adcc-46358675fc51",
      "text": "nhưng chúc phúc cho người đem bán ra.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:27.177Z",
      "updatedAt": "2025-09-03T02:41:27.177Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "3b16ede5-007e-4980-baa3-4419b1846539",
      "text": "Người tìm kiếm điều thiện thì gặp được ân phúc,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:27.191Z",
      "updatedAt": "2025-09-03T02:41:27.191Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "98657b95-9e07-46d2-92ac-8006e18640a7",
      "text": "kẻ chạy theo điều ác, điều ác đến bên mình.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:27.219Z",
      "updatedAt": "2025-09-03T02:41:27.219Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "8a83572f-e537-4f63-8f26-227afd4703fa",
      "text": "Ai cậy trông vào của cải, người ấy sẽ quỵ ngã,",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:27.233Z",
      "updatedAt": "2025-09-03T02:41:27.233Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "f3fa1919-e5a5-404b-90e9-27a258b5338f",
      "text": "còn chính nhân sẽ vươn lên như cành lá xanh tươi.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 1,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:27.246Z",
      "updatedAt": "2025-09-03T02:41:27.246Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "05fd20c5-0bce-4c39-9186-1f09cdf94bc9",
      "text": "Ai gây bất thuận trong nhà sẽ chẳng có chi làm di sản,",
      "label": "29",
      "number": 29,
      "subVerseIndex": 0,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:27.273Z",
      "updatedAt": "2025-09-03T02:41:27.273Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "e6adc39a-bed0-456a-a4ca-6c7939524a81",
      "text": "kẻ ngu si đần độn phải làm đầy tớ cho người khôn.",
      "label": "29",
      "number": 29,
      "subVerseIndex": 1,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:27.297Z",
      "updatedAt": "2025-09-03T02:41:27.297Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "d5f1bc98-415d-4fcc-851d-be3ee299a746",
      "text": "Người công chính được thừa hưởng cây sự sống,",
      "label": "30",
      "number": 30,
      "subVerseIndex": 0,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:27.311Z",
      "updatedAt": "2025-09-03T02:41:27.311Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "e67f5d19-7cf8-424f-b727-ca062409510c",
      "text": "kẻ khôn ngoan chinh phục được lòng người.",
      "label": "30",
      "number": 30,
      "subVerseIndex": 1,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:27.339Z",
      "updatedAt": "2025-09-03T02:41:27.339Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "0fe247a0-f4c9-446c-96a8-9c9842bf12d2",
      "text": "Người công chính còn lãnh thưởng phạt nơi trần thế,",
      "label": "31",
      "number": 31,
      "subVerseIndex": 0,
      "paragraphNumber": 61,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:27.352Z",
      "updatedAt": "2025-09-03T02:41:27.352Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    },
    {
      "id": "5f2820f8-3cff-4f6f-a1ce-51f08e3b899f",
      "text": "huống chi là kẻ tội lỗi, đứa ác tâm.",
      "label": "31",
      "number": 31,
      "subVerseIndex": 1,
      "paragraphNumber": 62,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:27.364Z",
      "updatedAt": "2025-09-03T02:41:27.364Z",
      "chapterId": "ece8dbc3-354b-4da9-aa42-d40328e3630b"
    }
  ],
  "marks": [
    {
      "id": "946c1bc8-a497-40cd-a68e-800bd8a6b1af",
