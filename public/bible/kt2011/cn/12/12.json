    },
    {
      "id": "77fe6a31-ce43-4b49-9ee1-11e22288d07e",
      "content": "Ta gặp thấy những châm ngôn có chủ đề về lời nói trong chương này (cc. 13.14.17-19.22-23). Đặc biệt trong c.22, chính Đức Chúa ghê tởm lời nói dối gian, lừa đảo. Thường trong Cựu Ước, thờ ngẫu tượng là điều Đức Chúa ghê tởm (Đn 9,27 ; 11,31 ; 12,11) ; nhưng trong sách Cn, tội gian dối cũng bị Người ghê tởm.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "6",
      "sortOrder": 5,
      "startOffset": 45,
      "endOffset": 45,
      "createdAt": "2025-09-03T02:41:33.548Z",
      "updatedAt": "2025-09-03T02:41:33.548Z",
      "targetId": "4158de0e-5df7-40b6-af4d-53809f1c2c2f",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "4e8d269c-c7a6-4a88-9aee-ce972b4af947",
      "content": "Cn 6,12; 11,20",
      "kind": "MARK_KIND_REFERENCE",
