{
  "chapter": {
    "id": "6c560782-723c-4a7d-b37b-8e84aaea4fff",
    "number": 12,
    "createdAt": "2025-09-03T01:07:51.667Z",
    "updatedAt": "2025-09-03T01:07:51.667Z",
    "bookId": "1ea97633-82d8-4f1a-bffc-dfb2da235911"
  },
  "verses": [
    {
      "id": "eea293f5-b645-4cd7-89a0-daba51b9cb44",
      "text": "Yêu lời nghiêm huấn là yêu tri thức,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:32.760Z",
      "updatedAt": "2025-09-03T02:41:32.760Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "c2f0280e-099a-4a17-a1d2-e04c8418f41c",
      "text": "ghét lời sửa dạy là dại dột ngu si.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:32.788Z",
      "updatedAt": "2025-09-03T02:41:32.788Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "7b328b80-02ee-4d27-9752-38d51b98a36d",
      "text": "ĐỨC CHÚA quý chuộng người lương thiện,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:32.799Z",
      "updatedAt": "2025-09-03T02:41:32.799Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "72adfdf5-5930-448a-8a92-1f6ca6d5ce66",
      "text": "nhưng Người kết án kẻ mưu mô.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:32.829Z",
      "updatedAt": "2025-09-03T02:41:32.829Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "9de41108-8b47-4f3c-a50e-d6ca6a8fe229",
      "text": "Kẻ làm ác đâu đứng vững được hoài,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:32.843Z",
      "updatedAt": "2025-09-03T02:41:32.843Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "cae6bf3e-0690-487b-901b-70b7451ebf4b",
      "text": "nền móng của chính nhân chẳng bao giờ lay chuyển.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:32.859Z",
      "updatedAt": "2025-09-03T02:41:32.859Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "c5e8c967-aae3-4d2c-9f87-741c12921e63",
      "text": "Có vợ đảm đang như được mang ngọc miện,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:32.875Z",
      "updatedAt": "2025-09-03T02:41:32.875Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "081624aa-b439-4b53-9be9-d807f191ec50",
      "text": "có vợ hư hỏng như bị bệnh mục xương.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:32.886Z",
      "updatedAt": "2025-09-03T02:41:32.886Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "892c7118-4e81-49ad-9058-9e7684da674e",
      "text": "Người ngay chính chỉ nghĩ chuyện công minh,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:32.924Z",
      "updatedAt": "2025-09-03T02:41:32.924Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "1ecd8dd5-d564-4b1f-8d3a-aad62ee95a1b",
      "text": "kẻ gian tà luôn bày mưu lường gạt.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:32.939Z",
      "updatedAt": "2025-09-03T02:41:32.939Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "fff94293-bbac-4eba-8b78-80e6ef12f7f8",
      "text": "Lời kẻ ác giương bẫy giết người,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:32.952Z",
      "updatedAt": "2025-09-03T02:41:32.952Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "56dcba1b-f36a-4144-8c2d-f2eb82433e67",
      "text": "miệng chính nhân thì lo cứu sống.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:32.967Z",
      "updatedAt": "2025-09-03T02:41:32.967Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "2b4b9d91-41ee-49b3-ad1a-8669254c7725",
      "text": "Ác nhân đã bị lật nhào là không còn nữa,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:32.981Z",
      "updatedAt": "2025-09-03T02:41:32.981Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "1548337c-ff46-4b8a-9953-ae69b93e2123",
      "text": "còn nhà người công chính vẫn đứng nguyên.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:32.995Z",
      "updatedAt": "2025-09-03T02:41:32.995Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "c246c020-1662-4804-8437-feb61c162219",
      "text": "Người biết điều phải trái sẽ được khen ngợi,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:33.009Z",
      "updatedAt": "2025-09-03T02:41:33.009Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "c98b0d43-be59-499a-80cd-7553fba3e63c",
      "text": "kẻ phán đoán lệch lạc sẽ bị khinh chê.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:33.023Z",
      "updatedAt": "2025-09-03T02:41:33.023Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "7a0b92fc-2a20-41f8-9829-39f0174bbc84",
      "text": "Thà làm dân thường mà có một đầy tớ",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:33.037Z",
      "updatedAt": "2025-09-03T02:41:33.037Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "4ed28431-72f5-4e81-b243-17f5f0913f24",
      "text": "còn hơn ra bộ ông lớn mà chẳng đủ cơm ăn.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:33.065Z",
      "updatedAt": "2025-09-03T02:41:33.065Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "c395fde3-f729-4956-9696-a61fbc2d5918",
      "text": "Người công chính chăm lo cho sự sống đàn vật,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:33.079Z",
      "updatedAt": "2025-09-03T02:41:33.079Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "dff031d4-fa38-4ad3-b2f2-1f426dc03687",
      "text": "còn ác nhân thì thâm độc tận đáy lòng.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:33.107Z",
      "updatedAt": "2025-09-03T02:41:33.107Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "173c5a41-37cf-407b-9e5d-6d9301813893",
      "text": "Người canh tác đất đai được no đầy cơm bánh,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:33.121Z",
      "updatedAt": "2025-09-03T02:41:33.121Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "2721f13a-8e61-4404-a803-4494f5df1ebf",
      "text": "kẻ chạy theo chuyện phù phiếm là đứa ngu si.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:33.148Z",
      "updatedAt": "2025-09-03T02:41:33.148Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "2ca9387a-22df-45b3-88b2-9ed728e1b3c5",
      "text": "Lưới dò của kẻ xấu lôi cuốn ác nhân,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:33.162Z",
      "updatedAt": "2025-09-03T02:41:33.162Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "2fe1f765-d855-4bef-b483-9e14ff2ca220",
      "text": "cội rễ của người công chính thì bền vững.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:33.177Z",
      "updatedAt": "2025-09-03T02:41:33.177Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "73459b8c-43fc-4c2d-9e9c-daabb927b7e0",
      "text": "Vì tội lỗi của đôi môi mà ác nhân sa bẫy,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:33.205Z",
      "updatedAt": "2025-09-03T02:41:33.205Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "c29c6007-8100-4223-8d91-59b21c06c98c",
      "text": "còn người công chính được thoát cảnh khốn cùng.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:33.219Z",
      "updatedAt": "2025-09-03T02:41:33.219Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "6c400e75-d5bc-4670-a6cd-2d91ec08446a",
      "text": "Người ăn nói tử tế sẽ được bao điều tốt đẹp,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:33.232Z",
      "updatedAt": "2025-09-03T02:41:33.232Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "d74a6a0a-a82f-4b5c-9a4a-3d1ef80f0377",
      "text": "mỗi người sẽ lãnh hậu quả việc mình làm.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:33.261Z",
      "updatedAt": "2025-09-03T02:41:33.261Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "cbf27716-919b-4993-8000-80a65dd696c8",
      "text": "Kẻ ngu cứ tưởng mình đi đường ngay chính,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:33.289Z",
      "updatedAt": "2025-09-03T02:41:33.289Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "76557695-3240-44a9-b664-c62e67973403",
      "text": "ai nghe lời khuyên nhủ mới là người khôn.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:33.303Z",
      "updatedAt": "2025-09-03T02:41:33.303Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "85237495-b222-4ce9-8b0b-e1559559cdb3",
      "text": "Kẻ ngu si không kìm được giận dữ,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:33.317Z",
      "updatedAt": "2025-09-03T02:41:33.317Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "390511ff-f18b-4a40-9aa8-4edf54d118bd",
      "text": "người khôn khéo biết nén nhục nuốt sầu.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:33.332Z",
      "updatedAt": "2025-09-03T02:41:33.332Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "ebd345fd-5131-42ca-8701-faecea9f8876",
      "text": "Ai trình bày sự thật thì nói lên công lý,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:33.352Z",
      "updatedAt": "2025-09-03T02:41:33.352Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "406c8966-b0fd-4a8f-9018-45a974ac965f",
      "text": "kẻ làm chứng gian toàn bịa chuyện lọc lừa.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:33.366Z",
      "updatedAt": "2025-09-03T02:41:33.366Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "4339f800-7515-4828-a658-f529e625899c",
      "text": "Lời nói bừa bãi khác nào mũi gươm đâm,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:33.381Z",
      "updatedAt": "2025-09-03T02:41:33.381Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "0ccdc15e-a4c3-415c-854d-5fc43fb4700e",
      "text": "miệng lưỡi khôn ngoan lại chữa trị cho lành.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:33.395Z",
      "updatedAt": "2025-09-03T02:41:33.395Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "d0f7b09c-daab-4bbd-9d47-ad599683f9f3",
      "text": "Lời ngay thật lưu tồn mãi mãi,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:33.408Z",
      "updatedAt": "2025-09-03T02:41:33.408Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "09170e8c-50b9-4291-8713-535ec8894198",
      "text": "lưỡi dối gian chỉ có một thời.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:33.422Z",
      "updatedAt": "2025-09-03T02:41:33.422Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "c37ba445-e90e-40bc-8288-e989203e9578",
      "text": "Lòng kẻ mưu điều ác chất đầy chuyện lừa đảo,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:33.436Z",
      "updatedAt": "2025-09-03T02:41:33.436Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "63c20d1c-62f2-4f89-943d-7b5230cb9755",
      "text": "người cổ võ hoà bình được chan chứa niềm vui.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:33.450Z",
      "updatedAt": "2025-09-03T02:41:33.450Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "eebd0170-b152-4e9a-b2f5-6c2ac0d50606",
      "text": "Người công chính không khi nào gặp nạn,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:33.464Z",
      "updatedAt": "2025-09-03T02:41:33.464Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "7d66211f-14f1-42ac-ab69-22b8d0e5f088",
      "text": "còn ác nhân, tai hoạ cứ dập dồn.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:33.478Z",
      "updatedAt": "2025-09-03T02:41:33.478Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "80c83bd9-808f-44f7-9c15-ddb1a6ca58bd",
      "text": "Đôi môi gian tà bị ĐỨC CHÚA ghê tởm,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:33.492Z",
      "updatedAt": "2025-09-03T02:41:33.492Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "4158de0e-5df7-40b6-af4d-53809f1c2c2f",
      "text": "kẻ thực thi chân lý thì được Người mến thương.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:33.534Z",
      "updatedAt": "2025-09-03T02:41:33.534Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "68ec0f28-b23d-4c03-97f5-6038b062d997",
      "text": "Người khôn khéo chẳng khoe điều mình biết,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:33.563Z",
      "updatedAt": "2025-09-03T02:41:33.563Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "01833799-4441-45c2-8f65-d0ec8e80ea2a",
      "text": "kẻ dại khờ để lộ chuyện ngu si.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:33.591Z",
      "updatedAt": "2025-09-03T02:41:33.591Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "5fd38819-8cac-4336-9654-0cdf690d68ab",
      "text": "Người cần mẫn sẽ nắm quyền thống trị,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:33.605Z",
      "updatedAt": "2025-09-03T02:41:33.605Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "ebb0f36d-38fc-494b-9942-0e33b7976ac8",
      "text": "kẻ biếng lười thì bị bắt làm phu.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:33.620Z",
      "updatedAt": "2025-09-03T02:41:33.620Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "7f44676a-557e-4948-80a2-2266b1347c22",
      "text": "Mối lo lắng trong lòng khiến con người suy sụp,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:33.648Z",
      "updatedAt": "2025-09-03T02:41:33.648Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "be2999dc-30dc-4cc7-9837-8f0e7528c5a6",
      "text": "nhưng những lời tử tế làm cho họ hân hoan.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:33.662Z",
      "updatedAt": "2025-09-03T02:41:33.662Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "f970fbaa-4d78-4b78-a040-0b497dc9f765",
      "text": "Người công chính dẫn lối cho bạn bè,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:33.676Z",
      "updatedAt": "2025-09-03T02:41:33.676Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "7ab6f30f-6f27-4036-a411-71440bbd147d",
      "text": "nhưng đường ác nhân đi khiến chúng bị lạc.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:33.703Z",
      "updatedAt": "2025-09-03T02:41:33.703Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "2e4bf96a-e888-411f-8e98-9b1720ad7e06",
      "text": "Kẻ lười biếng có thịt săn cũng không chịu nấu,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:33.731Z",
      "updatedAt": "2025-09-03T02:41:33.731Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "ab5aef64-f90e-439c-bd96-a9f26a0af3f0",
      "text": "nhưng siêng năng là vốn quý của con người.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:33.745Z",
      "updatedAt": "2025-09-03T02:41:33.745Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "1bb7aaef-c560-47ca-880b-04e8bba49790",
      "text": "Đường công minh đưa tới sự sống,",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:33.772Z",
      "updatedAt": "2025-09-03T02:41:33.772Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "04816d51-5482-4188-b71a-40d32a715478",
      "text": "lối gian tà dẫn đến tử vong.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 1,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:33.786Z",
      "updatedAt": "2025-09-03T02:41:33.786Z",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    }
  ],
