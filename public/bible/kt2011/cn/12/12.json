      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "3d0ea31c-6a3d-4e05-939d-b31cc2debbde",
      "content": "Mỗi người đều phải lãnh hậu quả tốt hay xấu do lời nói, việc làm của mình.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 39,
      "endOffset": 39,
