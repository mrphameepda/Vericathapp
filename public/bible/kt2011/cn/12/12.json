    },
    {
      "id": "903a183b-9f18-460a-be5a-de2c8d1dc1a9",
      "content": "Cn 13,16",
      "kind": "MARK_KIND_REFERENCE",
      "label": "8@",
      "sortOrder": 7,
      "startOffset": 6,
      "endOffset": 6,
      "createdAt": "2025-09-03T02:41:33.577Z",
      "updatedAt": "2025-09-03T02:41:33.577Z",
      "targetId": "68ec0f28-b23d-4c03-97f5-6038b062d997",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "6c560782-723c-4a7d-b37b-8e84aaea4fff"
    },
    {
      "id": "11de4452-6db5-4fd3-b3f6-ba0c2cf53699",
      "content": "Câu hiểu được, nhưng hình thức hơi lạ. Hiếm khi thấy nói rằng *con đường làm người ta đi lạc*.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "8",
      "sortOrder": 7,
