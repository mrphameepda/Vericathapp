{
  "chapter": {
    "id": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e",
    "number": 13,
    "createdAt": "2025-09-03T01:07:51.667Z",
    "updatedAt": "2025-09-03T01:07:51.667Z",
    "bookId": "1ea97633-82d8-4f1a-bffc-dfb2da235911"
  },
  "verses": [
    {
      "id": "b5524197-bd97-4e0f-8e1d-5995591a3eb7",
      "text": "Con khôn giữ lời cha nghiêm huấn,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:38.496Z",
      "updatedAt": "2025-09-03T02:41:38.496Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "693219b8-1954-4d4d-8b22-97f71b16ba18",
      "text": "kẻ nhạo báng chẳng nghe lời sửa dạy.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:38.514Z",
      "updatedAt": "2025-09-03T02:41:38.514Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "a0a59d52-e8d1-4e57-8c47-564714e72dd2",
      "text": "Người nói điều lành thì được hưởng điều lành,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:38.538Z",
      "updatedAt": "2025-09-03T02:41:38.538Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "a7ba5e26-be5a-4978-a4b5-14f9ba32785b",
      "text": "còn quân phản trắc chỉ thích gây bạo động.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:38.549Z",
      "updatedAt": "2025-09-03T02:41:38.549Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "caf00ffe-e123-4390-a774-bd65bc32289e",
      "text": "Giữ mồm giữ miệng là bảo toàn mạng sống,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:38.561Z",
      "updatedAt": "2025-09-03T02:41:38.561Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "1d375d98-5b6a-44a6-8c6a-24bba5f64638",
      "text": "khua môi múa mép ắt sẽ phải thiệt thân.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:38.588Z",
      "updatedAt": "2025-09-03T02:41:38.588Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "32d73df4-20de-4305-ad7d-c0a4822877a3",
      "text": "Kẻ lười biếng thèm muốn mà chẳng được gì,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:38.601Z",
      "updatedAt": "2025-09-03T02:41:38.601Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "bcbcf7a6-a3bf-41ae-9274-d37678f84f58",
      "text": "người chuyên cần muốn chi cũng được thoả mãn.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:38.629Z",
      "updatedAt": "2025-09-03T02:41:38.629Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "8af7c740-7219-4b5d-aefa-6cec5e5ac875",
      "text": "Người chính trực ghét lời dối trá lọc lừa,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:38.643Z",
      "updatedAt": "2025-09-03T02:41:38.643Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "feac7b3a-2bf5-4d45-ae4c-68bfafa3251e",
      "text": "kẻ gian ác làm điều xấu xa ô nhục.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:38.656Z",
      "updatedAt": "2025-09-03T02:41:38.656Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "068db6d2-19c8-4fd5-9491-f368a1e18571",
      "text": "Đức công chính giữ gìn người sống thanh liêm,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:38.671Z",
      "updatedAt": "2025-09-03T02:41:38.671Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "68b51f84-5b46-4063-b268-550718b73ff6",
      "text": "còn tội lỗi đưa ác nhân đến chỗ tiêu diệt.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:38.686Z",
      "updatedAt": "2025-09-03T02:41:38.686Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "f04245e5-f63c-479f-9ef8-90606aaf77a0",
      "text": "Người chẳng có chi thì khoe mình giàu có,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:38.701Z",
      "updatedAt": "2025-09-03T02:41:38.701Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "c928cb2e-348f-4e38-9c6a-6223a565b117",
      "text": "kẻ nhiều của cải lại làm bộ túng nghèo.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:38.714Z",
      "updatedAt": "2025-09-03T02:41:38.714Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "64f66768-718f-4446-9af8-015bb47b6692",
      "text": "Của cải có sức chuộc mạng người,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:38.728Z",
      "updatedAt": "2025-09-03T02:41:38.728Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "4a862797-e7f4-4fc8-b673-376aa58ab5c7",
      "text": "còn kẻ nghèo chẳng nghe ai trách móc.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:38.742Z",
      "updatedAt": "2025-09-03T02:41:38.742Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "513159d0-b56a-402e-8a17-cf56f3759bd9",
      "text": "Ánh sáng người chính trực đem lại niềm vui,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:38.770Z",
      "updatedAt": "2025-09-03T02:41:38.770Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "8895297e-97ed-4f0a-b162-b10f00dfa676",
      "text": "ngọn đèn của ác nhân sẽ bị dập tắt.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:38.785Z",
      "updatedAt": "2025-09-03T02:41:38.785Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "14be48b2-e30f-4fe0-a96e-97ace7f6c8f9",
      "text": "Tự mãn tự kiêu chỉ gây ra cãi cọ,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:38.828Z",
      "updatedAt": "2025-09-03T02:41:38.828Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "eb20c9c7-2bb1-462a-b892-b6e984d81fae",
      "text": "nghe lời khuyên nhủ thì sẽ được khôn ngoan.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:38.855Z",
      "updatedAt": "2025-09-03T02:41:38.855Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "51d3a5a9-4622-4798-a6e1-61eddbbf9a2c",
      "text": "Của cải mau tăng sẽ mau giảm,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:38.869Z",
      "updatedAt": "2025-09-03T02:41:38.869Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "c1714c5b-abd1-49f9-b351-6f052d3916b5",
      "text": "ai từ từ thu góp sẽ giàu lên.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:38.912Z",
      "updatedAt": "2025-09-03T02:41:38.912Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "c1377086-7a5f-418d-8a99-1ee4e33296f7",
      "text": "Giấc mộng chưa thành làm trái tim khắc khoải,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:38.926Z",
      "updatedAt": "2025-09-03T02:41:38.926Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "f2bced19-b67f-4c7e-b8a2-cee53b6913a7",
      "text": "ước mơ toại nguyện là cây ban sự sống.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:38.940Z",
      "updatedAt": "2025-09-03T02:41:38.940Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "8f9e3d56-8bc9-4420-8e47-f6ee2cedff00",
      "text": "Coi khinh lời dạy sẽ bị tiêu vong,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:38.968Z",
      "updatedAt": "2025-09-03T02:41:38.968Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "8ff118e5-160a-4c4d-a9c7-cece71a10dcb",
      "text": "tôn trọng lệnh truyền sẽ được ân thưởng.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:38.989Z",
      "updatedAt": "2025-09-03T02:41:38.989Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "f7e63677-4afd-4eb6-94e2-9b0862f2359c",
      "text": "Giáo huấn của hiền nhân là suối nguồn sự sống",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:39.003Z",
      "updatedAt": "2025-09-03T02:41:39.003Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "4fecdc2d-28cc-4c69-a8f9-c1af7c5c647c",
      "text": "giúp chúng ta tránh cạm bẫy tử thần.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:39.030Z",
      "updatedAt": "2025-09-03T02:41:39.030Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "7858961d-1b24-4f4b-87c3-29712d709ac8",
      "text": "Biết xử sự thì người đời mộ mến,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:39.043Z",
      "updatedAt": "2025-09-03T02:41:39.043Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "b503497a-6425-4533-9e58-29151945cf51",
      "text": "theo đường bất tín sẽ chẳng tới đâu.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:39.057Z",
      "updatedAt": "2025-09-03T02:41:39.057Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "12cf7697-aafb-44cd-b87a-a2d411ca71d6",
      "text": "Người khôn ý thức việc mình làm,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:39.086Z",
      "updatedAt": "2025-09-03T02:41:39.086Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "a5f9e589-03f9-448a-b13d-9cef15047e94",
      "text": "kẻ ngu để lộ điều dại dột.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:39.100Z",
      "updatedAt": "2025-09-03T02:41:39.100Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "47c32ce1-13d1-44ed-9a33-eac813729990",
      "text": "Sứ giả gian manh chỉ gây nên tai hoạ,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:39.127Z",
      "updatedAt": "2025-09-03T02:41:39.127Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "86c2fa48-6d8f-4f6f-b3d6-e2a37dfc44b3",
      "text": "sứ giả trung tín là phương thuốc chữa lành.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:39.155Z",
      "updatedAt": "2025-09-03T02:41:39.155Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "539736e1-66f7-48bd-9f62-0d076b042752",
      "text": "Coi khinh lời nghiêm huấn ắt phải nghèo phải nhục,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:39.169Z",
      "updatedAt": "2025-09-03T02:41:39.169Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "5096c884-ce15-4561-9995-c93809cec459",
      "text": "tuân giữ lời sửa dạy hẳn sẽ được hiển vinh.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:39.183Z",
      "updatedAt": "2025-09-03T02:41:39.183Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "c2ec4002-2018-4ee0-afb3-8f72af68da9a",
      "text": "Ước mơ thành tựu khiến tâm hồn vui thú,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:39.197Z",
      "updatedAt": "2025-09-03T02:41:39.197Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "6a71307b-1098-4c22-bc28-c5de8a7bd91b",
      "text": "từ bỏ gian tà là điều đứa ngu ghê tởm.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:39.225Z",
      "updatedAt": "2025-09-03T02:41:39.225Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "7dadc136-617d-48f3-9f0e-d744a0e40b52",
      "text": "Đi với người khôn, ắt sẽ nên khôn,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:39.253Z",
      "updatedAt": "2025-09-03T02:41:39.253Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "4f87cd7e-1871-4f79-8696-5cb4395f838b",
      "text": "chơi cùng kẻ dại, sẽ mang lấy hoạ.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:39.281Z",
      "updatedAt": "2025-09-03T02:41:39.281Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "5549344b-a798-40c0-be84-75bec9314635",
      "text": "Điều bất hạnh bám sát người tội lỗi,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:39.295Z",
      "updatedAt": "2025-09-03T02:41:39.295Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "8942beab-43d9-4655-9ca4-e3cc26e6fffb",
      "text": "chuyện may lành là phần thưởng của chính nhân.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:39.309Z",
      "updatedAt": "2025-09-03T02:41:39.309Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "b70f1735-b357-4653-9fa6-1ef63734039a",
      "text": "Người đức độ để gia sản tới đời con đời cháu,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:39.322Z",
      "updatedAt": "2025-09-03T02:41:39.322Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "2384df68-d975-49c7-a6a1-3ef00fd02b26",
      "text": "của cải đứa tội lỗi lại dành cho chính nhân.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:39.336Z",
      "updatedAt": "2025-09-03T02:41:39.336Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "d5ec468c-8029-4bc8-85dc-0cf59c59dd69",
      "text": "Đất người nghèo vỡ hoang thì dồi dào lương thực,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:39.350Z",
      "updatedAt": "2025-09-03T02:41:39.350Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "6734d381-0e5b-4fc5-903e-64d5f72bd82a",
      "text": "nhưng nhiều kẻ mất mạng vì bất công.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:39.362Z",
      "updatedAt": "2025-09-03T02:41:39.362Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "41c8c709-cef1-419f-8dbc-ba1eab60a563",
      "text": "Kẻ ghét con mới không dùng roi vọt,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:39.384Z",
      "updatedAt": "2025-09-03T02:41:39.384Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "681769ef-862d-4652-87ea-6a7c34982d98",
      "text": "người thương con sẽ lo sửa phạt con.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:39.424Z",
      "updatedAt": "2025-09-03T02:41:39.424Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "39dfecf7-3fb6-4de6-bd01-77e50d974578",
      "text": "Chính nhân được ăn no, kẻ ác phải đói bụng.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:39.438Z",
      "updatedAt": "2025-09-03T02:41:39.438Z",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    }
  ],
  "marks": [
    {
      "id": "e9589684-5a71-45e4-a66a-fcc44cb44933",
      "content": "Cn 14,6; 15,12; 24,9",
      "kind": "MARK_KIND_REFERENCE",
      "label": "1@",
      "sortOrder": 0,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:41:38.524Z",
      "updatedAt": "2025-09-03T02:41:38.524Z",
      "targetId": "693219b8-1954-4d4d-8b22-97f71b16ba18",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "ab53bcf9-fbd9-49d5-baed-5aa5b83ee194",
      "content": "Đời sống người giàu được bảo đảm bằng của cải, nhưng người nghèo được yên ổn vì không có gì.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 36,
      "endOffset": 36,
      "createdAt": "2025-09-03T02:41:38.756Z",
      "updatedAt": "2025-09-03T02:41:38.756Z",
      "targetId": "4a862797-e7f4-4fc8-b673-376aa58ab5c7",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "23b934b3-184a-4ff9-910e-389442853d7f",
      "content": "Cn 21,23",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 8,
      "endOffset": 8,
      "createdAt": "2025-09-03T02:41:38.573Z",
      "updatedAt": "2025-09-03T02:41:38.573Z",
      "targetId": "caf00ffe-e123-4390-a774-bd65bc32289e",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "08a257f4-666d-41ab-b891-e2f2c9cd916c",
      "content": "*Ánh sáng, ngọn đèn* là biểu hiệu của sự sống và niềm vui. *Ngọn đèn* tắt tượng trưng cho sự sống bị lấy đi (20,20 ; 24,20 ; G 18,5 ; 21,17).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 34,
      "endOffset": 34,
      "createdAt": "2025-09-03T02:41:38.799Z",
      "updatedAt": "2025-09-03T02:41:38.799Z",
      "targetId": "8895297e-97ed-4f0a-b162-b10f00dfa676",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "76e93281-17f3-450f-ac42-8ab4310c1237",
      "content": "Cn 6,6-11; 21,25",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:41:38.615Z",
      "updatedAt": "2025-09-03T02:41:38.615Z",
      "targetId": "32d73df4-20de-4305-ad7d-c0a4822877a3",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "7fb385f6-25c8-49e9-9afe-f2961517cdc4",
      "content": "Có ý nói đến việc mau giàu nhờ dùng những phương pháp bất chính (x. 21,6).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 28,
      "endOffset": 28,
      "createdAt": "2025-09-03T02:41:38.884Z",
      "updatedAt": "2025-09-03T02:41:38.884Z",
      "targetId": "51d3a5a9-4622-4798-a6e1-61eddbbf9a2c",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "2a34a74a-8ccb-4286-8a93-91b2ae274dcc",
      "content": "Cn 20,20; 24,20",
      "kind": "MARK_KIND_REFERENCE",
      "label": "4@",
      "sortOrder": 3,
      "startOffset": 5,
      "endOffset": 5,
      "createdAt": "2025-09-03T02:41:38.813Z",
      "updatedAt": "2025-09-03T02:41:38.813Z",
      "targetId": "8895297e-97ed-4f0a-b162-b10f00dfa676",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "9f48a457-32d8-4487-b90e-dd7dc975e926",
      "content": "ds : *con đường của ác nhân thì kéo dài mãi*.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 35,
      "endOffset": 35,
      "createdAt": "2025-09-03T02:41:39.072Z",
      "updatedAt": "2025-09-03T02:41:39.072Z",
      "targetId": "b503497a-6425-4533-9e58-29151945cf51",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "190ac67f-4f4d-403f-b6fd-051ed50fe934",
      "content": "Cn 11,2",
      "kind": "MARK_KIND_REFERENCE",
      "label": "5@",
      "sortOrder": 4,
      "startOffset": 7,
      "endOffset": 7,
      "createdAt": "2025-09-03T02:41:38.842Z",
      "updatedAt": "2025-09-03T02:41:38.842Z",
      "targetId": "14be48b2-e30f-4fe0-a96e-97ace7f6c8f9",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "e3e172c0-f497-4924-95b7-7d3638c9d140",
      "content": "Hai vế không mạch lạc với nhau.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "5",
      "sortOrder": 4,
      "startOffset": 37,
      "endOffset": 37,
      "createdAt": "2025-09-03T02:41:39.239Z",
      "updatedAt": "2025-09-03T02:41:39.239Z",
      "targetId": "6a71307b-1098-4c22-bc28-c5de8a7bd91b",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "7b2d8981-527b-42c1-9517-9731c8bf13d3",
      "content": "Cn 20,21",
      "kind": "MARK_KIND_REFERENCE",
      "label": "6@",
      "sortOrder": 5,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:41:38.898Z",
      "updatedAt": "2025-09-03T02:41:38.898Z",
      "targetId": "51d3a5a9-4622-4798-a6e1-61eddbbf9a2c",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "8df47ab3-4be3-4fad-bc03-5e5dda8c59cf",
      "content": "Để được khôn ngoan phải sống gần người khôn.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "6",
      "sortOrder": 5,
      "startOffset": 33,
      "endOffset": 33,
      "createdAt": "2025-09-03T02:41:39.267Z",
      "updatedAt": "2025-09-03T02:41:39.267Z",
      "targetId": "7dadc136-617d-48f3-9f0e-d744a0e40b52",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "745c5801-c74a-4580-94ca-61e718f37e11",
      "content": "Cn 3,18",
      "kind": "MARK_KIND_REFERENCE",
      "label": "7@",
      "sortOrder": 6,
      "startOffset": 22,
      "endOffset": 22,
      "createdAt": "2025-09-03T02:41:38.954Z",
      "updatedAt": "2025-09-03T02:41:38.954Z",
      "targetId": "f2bced19-b67f-4c7e-b8a2-cee53b6913a7",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "e4784b03-74cc-471c-a563-14f32455959c",
      "content": "Câu không rõ. Hai vế không có mạch lạc. Vế một đưa ra một nhận xét khác thường. Vế hai mơ hồ : không rõ *mất mạng* vì sống bất công hay vì chịu bất công.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "7",
      "sortOrder": 6,
      "startOffset": 35,
      "endOffset": 35,
      "createdAt": "2025-09-03T02:41:39.373Z",
      "updatedAt": "2025-09-03T02:41:39.373Z",
      "targetId": "6734d381-0e5b-4fc5-903e-64d5f72bd82a",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "688144b7-18ab-4d30-9f43-81972cf7985c",
      "content": "Cn 10,11; 14,27",
      "kind": "MARK_KIND_REFERENCE",
      "label": "8@",
      "sortOrder": 7,
      "startOffset": 27,
      "endOffset": 27,
      "createdAt": "2025-09-03T02:41:39.016Z",
      "updatedAt": "2025-09-03T02:41:39.016Z",
      "targetId": "f7e63677-4afd-4eb6-94e2-9b0862f2359c",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
    {
      "id": "bbd5e0a4-0a8a-4df6-9959-ea8acb040d7c",
      "content": "Sách Cn nói nhiều đến việc *dùng roi vọt* để sửa phạt con cái cho khỏi hư (22,15 ; 23,13-14 ; 29,15). *Sửa phạt* phải bắt nguồn từ yêu thương (3,12). *Roi vọt* ở đây còn tượng trưng cho mọi hình thức sửa phạt, kỷ luật khác.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "8",
      "sortOrder": 7,
      "startOffset": 34,
      "endOffset": 34,
      "createdAt": "2025-09-03T02:41:39.397Z",
      "updatedAt": "2025-09-03T02:41:39.397Z",
      "targetId": "41c8c709-cef1-419f-8dbc-ba1eab60a563",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d52f93a7-c4f3-475a-a6b9-50dadde3fc6e"
    },
