{
  "chapter": {
    "id": "d52181a8-a84f-4a0c-b31a-7229959052f3",
    "number": 14,
    "createdAt": "2025-09-03T01:07:51.667Z",
    "updatedAt": "2025-09-03T01:07:51.667Z",
    "bookId": "1ea97633-82d8-4f1a-bffc-dfb2da235911"
  },
  "verses": [
    {
      "id": "c896c2a6-dbad-4e5c-9df7-d090f56a028e",
      "text": "Phụ nữ khôn ngoan xây dựng cửa nhà,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:44.869Z",
      "updatedAt": "2025-09-03T02:41:44.869Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "c4b4d79b-1e96-48b4-b958-77e877dff1b3",
      "text": "phụ nữ dại dột tự tay phá đổ.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:44.896Z",
      "updatedAt": "2025-09-03T02:41:44.896Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "087500dd-6b1a-4381-a4d4-99148165fa56",
      "text": "Người sống đời ngay thẳng thì kính sợ ĐỨC CHÚA,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:44.919Z",
      "updatedAt": "2025-09-03T02:41:44.919Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "a7133c1d-a182-4b60-b1b8-600d78436952",
      "text": "kẻ lạc xa chính lộ lại khinh dể Người.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:44.958Z",
      "updatedAt": "2025-09-03T02:41:44.958Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "adfb0047-25d5-4038-aaff-7e88284b39cc",
      "text": "Miệng kẻ dại có mầm kiêu ngạo,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:44.972Z",
      "updatedAt": "2025-09-03T02:41:44.972Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "79e97370-5f5e-4013-a779-864ca9d7d765",
      "text": "môi người khôn bảo vệ người khôn.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:44.985Z",
      "updatedAt": "2025-09-03T02:41:44.985Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "3e0ad2ef-b384-4856-b6b8-bccd501a4081",
      "text": "Không có bò, máng ăn trống rỗng,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:44.999Z",
      "updatedAt": "2025-09-03T02:41:44.999Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "faa3e1b4-ee8a-4aba-a7df-64ddc418b4b2",
      "text": "nhờ sức trâu, nguồn lợi dồi dào.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.013Z",
      "updatedAt": "2025-09-03T02:41:45.013Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "98e7fc82-b31d-449f-b590-ac3e82304604",
      "text": "Chứng nhân ngay thật thì không hề gian dối,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.042Z",
      "updatedAt": "2025-09-03T02:41:45.042Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "55f516a8-daee-48e7-90bc-ff6d3bb958b9",
      "text": "chứng nhân xảo trá toàn nói chuyện dối gian.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.071Z",
      "updatedAt": "2025-09-03T02:41:45.071Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "d7e9a7ff-d111-4da9-a9fb-1cf6f02ff3bc",
      "text": "Đứa nhạo báng tìm khôn ngoan chẳng thấy,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.087Z",
      "updatedAt": "2025-09-03T02:41:45.087Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "ce4625b6-80f2-4f43-af17-6a1614611f7a",
      "text": "người hiểu biết gặp tri thức dễ dàng.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.104Z",
      "updatedAt": "2025-09-03T02:41:45.104Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "4cdd9892-f204-4d2f-9f4c-0b67bd769c5b",
      "text": "Bạn hãy tránh xa đứa ngu si dại dột,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.119Z",
      "updatedAt": "2025-09-03T02:41:45.119Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "970f9a9a-835c-4af2-8b50-dcb6e9d999d9",
      "text": "vì biết rằng hắn chẳng có lời lẽ khôn ngoan.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.133Z",
      "updatedAt": "2025-09-03T02:41:45.133Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "5a7a378b-9cbd-417c-9033-a83c82d9671c",
      "text": "Cái khôn của kẻ sáng suốt là biết rõ đường mình đi,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.147Z",
      "updatedAt": "2025-09-03T02:41:45.147Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "d707ae86-9a92-4eb3-a0b5-a89950d76eb2",
      "text": "cái dại của kẻ ngu si là đi lường gạt.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.162Z",
      "updatedAt": "2025-09-03T02:41:45.162Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "e2ea617b-c3bc-41f3-a293-5d5a4983f5f4",
      "text": "Kẻ ngu nhạo báng hy lễ đền tội,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.191Z",
      "updatedAt": "2025-09-03T02:41:45.191Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "6488924d-e2cd-44a7-aca6-c940cfff2e5e",
      "text": "và ơn Chúa ở với những người ngay.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.219Z",
      "updatedAt": "2025-09-03T02:41:45.219Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "8a1de6f3-bcf9-4bbe-affa-b073aff28db9",
      "text": "Nỗi đắng cay chỉ riêng lòng mình biết,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.233Z",
      "updatedAt": "2025-09-03T02:41:45.233Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "d914e6f4-49c0-4c71-8bd7-8716bc6130d2",
      "text": "niềm hân hoan đâu chia sẻ được với người ngoài.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.246Z",
      "updatedAt": "2025-09-03T02:41:45.246Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "7bfd5084-f8f3-49cf-b850-470bf8979134",
      "text": "Nhà của ác nhân sẽ bị tàn phá,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.260Z",
      "updatedAt": "2025-09-03T02:41:45.260Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "adc1f6c9-0576-4b71-8f97-89ce12d4a8f4",
      "text": "lều của người ngay ngày càng phát đạt.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.274Z",
      "updatedAt": "2025-09-03T02:41:45.274Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "5e758ad2-aa28-4e70-a780-8bf195a4c6fd",
      "text": "Có con đường xem ra ngay thẳng,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.288Z",
      "updatedAt": "2025-09-03T02:41:45.288Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "5b980518-0517-4c05-bae7-f52ee1fa0e10",
      "text": "nhưng rốt cuộc lại đưa đến tử vong.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.316Z",
      "updatedAt": "2025-09-03T02:41:45.316Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "e8a2c491-92a3-4af4-bcd1-750b04c6aa49",
      "text": "Cả khi cười, lòng vẫn vương sầu muộn,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.330Z",
      "updatedAt": "2025-09-03T02:41:45.330Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "bb07565f-fbe7-4293-9a6f-e7f09d5345d8",
      "text": "sau niềm vui lại đến nỗi buồn phiền.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.346Z",
      "updatedAt": "2025-09-03T02:41:45.346Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "2743f925-157f-43b6-8573-cc674a591dd2",
      "text": "Kẻ bất trung lãnh hậu quả do cách mình sống,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.360Z",
      "updatedAt": "2025-09-03T02:41:45.360Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "3e649180-aa43-41ea-bbf9-0cbcc637df52",
      "text": "người tử tế hưởng hoa trái của việc mình làm.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.373Z",
      "updatedAt": "2025-09-03T02:41:45.373Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "71496098-61d5-4300-9432-98269b95a420",
      "text": "Kẻ khờ khạo ai nói gì cũng tin,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.384Z",
      "updatedAt": "2025-09-03T02:41:45.384Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "c8c0d593-ddf7-498e-b449-43c0cfbd2777",
      "text": "người khôn ngoan thì đắn đo từng bước.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.395Z",
      "updatedAt": "2025-09-03T02:41:45.395Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "3b5d4838-8266-4d70-bf21-ae9ec3d9d9ef",
      "text": "Người khôn sợ điều dữ và tìm cách tránh xa,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.407Z",
      "updatedAt": "2025-09-03T02:41:45.407Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "2a843fb8-dff6-4246-8518-40b5d91295ab",
      "text": "kẻ dại thì hung hăng và tự tin quá đáng.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.419Z",
      "updatedAt": "2025-09-03T02:41:45.419Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "61e194b5-6683-4350-9fae-9e0a3407ed56",
      "text": "Người nóng tính làm những điều dại dột,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.430Z",
      "updatedAt": "2025-09-03T02:41:45.430Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "59142fc1-bd1b-4c77-9c18-939330c25246",
      "text": "đứa mưu mô bị kẻ ghét người khinh.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.454Z",
      "updatedAt": "2025-09-03T02:41:45.454Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "60622e7d-b3eb-4832-a05e-9b10bc16b785",
      "text": "Kỷ phần của kẻ ngây thơ là dại dột,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.467Z",
      "updatedAt": "2025-09-03T02:41:45.467Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "0f5f93d7-e74e-4804-af3b-0c78af5f6084",
      "text": "tri thức là triều thiên trên đầu người khôn.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.480Z",
      "updatedAt": "2025-09-03T02:41:45.480Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "a62e47b2-fb10-4fa6-b03e-20d823fc414f",
      "text": "Kẻ xấu phải cúi mình trước mặt người lành,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.498Z",
      "updatedAt": "2025-09-03T02:41:45.498Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "52ce458c-34a1-4525-a91d-25b8c2167f7c",
      "text": "kẻ ác chầu chực nơi cửa nhà người công chính.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.512Z",
      "updatedAt": "2025-09-03T02:41:45.512Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "3a1eca4b-0581-4a70-a36e-9668767e0b41",
      "text": "Kẻ nghèo khó, láng giềng cũng ghét bỏ,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.525Z",
      "updatedAt": "2025-09-03T02:41:45.525Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "1ed01d78-e0fb-4015-8e21-e6692bc51179",
      "text": "người giàu sang có vô số bạn bè.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.554Z",
      "updatedAt": "2025-09-03T02:41:45.554Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "b5cd8578-eac6-4e86-8861-7c13e0088dcb",
      "text": "Khinh rẻ tha nhân thì mắc tội,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.568Z",
      "updatedAt": "2025-09-03T02:41:45.568Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "9a2955ee-d2b6-46ef-86c3-43a69b8134ce",
      "text": "nhưng xót thương kẻ nghèo là có phúc.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.582Z",
      "updatedAt": "2025-09-03T02:41:45.582Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "7b94f0c4-be4e-41c4-9c3c-c2e3cfa61ad8",
      "text": "Kẻ mưu toan điều ác lại chẳng lầm lạc sao ?",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.623Z",
      "updatedAt": "2025-09-03T02:41:45.623Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "bb7d070d-b42c-40ea-80ca-09bf56c1e890",
      "text": "Người toan làm điều thiện sẽ gặp được nhân nghĩa tín thành.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.637Z",
      "updatedAt": "2025-09-03T02:41:45.637Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "d01920d7-cb13-4a58-8878-0acb306aefbe",
      "text": "Chịu cực là có ăn,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.651Z",
      "updatedAt": "2025-09-03T02:41:45.651Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "7115ca1d-2cb8-473e-9e07-4092551b4aba",
      "text": "nói suông thì chỉ tổ đói nghèo.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.661Z",
      "updatedAt": "2025-09-03T02:41:45.661Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "2db9a666-a569-4c3b-98bf-19d71e3805bf",
      "text": "Phú quý là triều thiên của người khôn,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.672Z",
      "updatedAt": "2025-09-03T02:41:45.672Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "daa1509e-290c-4ea0-843e-2403f606635d",
      "text": "còn kẻ ngu thì dại vẫn hoàn dại.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.683Z",
      "updatedAt": "2025-09-03T02:41:45.683Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "d2fa20e7-4edd-4794-9b40-479bd967fa95",
      "text": "Chứng nhân ngay thật cứu được bao mạng người,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.693Z",
      "updatedAt": "2025-09-03T02:41:45.693Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "dc87734e-da61-4d15-a319-27d2690cc3ea",
      "text": "chứng nhân dối trá chỉ làm trò bịp bợm.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.706Z",
      "updatedAt": "2025-09-03T02:41:45.706Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "819f38ae-2858-4f69-8573-1adfe5bbd596",
      "text": "Kính sợ ĐỨC CHÚA sẽ được an toàn kiên vững,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.734Z",
      "updatedAt": "2025-09-03T02:41:45.734Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "0b398564-e9de-4678-893d-3a5f66e0a299",
      "text": "Người là nơi ẩn náu cho con cái Người.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.761Z",
      "updatedAt": "2025-09-03T02:41:45.761Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "0d4a150a-3796-4908-9a14-fc9de5f3bba1",
      "text": "Kính sợ ĐỨC CHÚA là nguồn sự sống,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.775Z",
      "updatedAt": "2025-09-03T02:41:45.775Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "3495f352-19a1-400b-94c8-5649af335b00",
      "text": "giúp ta tránh được cạm bẫy tử thần.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.818Z",
      "updatedAt": "2025-09-03T02:41:45.818Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "4d53b508-f6ce-497e-91b8-8c6feaf969d8",
      "text": "Đông dân, nhà vua được mạnh thế,",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.832Z",
      "updatedAt": "2025-09-03T02:41:45.832Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "e80ee2fd-7a77-427f-8bc1-f09cb3b6680b",
      "text": "thiếu dân, lãnh tụ sẽ đổ nhào.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 1,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.846Z",
      "updatedAt": "2025-09-03T02:41:45.846Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "3a136035-0959-44ab-a4a0-c085aa32c179",
      "text": "Người chậm giận thì đầy sáng suốt,",
      "label": "29",
      "number": 29,
      "subVerseIndex": 0,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.860Z",
      "updatedAt": "2025-09-03T02:41:45.860Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "9e65ab38-98f9-42f5-a975-0a26d30399fc",
      "text": "kẻ nóng tính để lộ cái dại khờ.",
      "label": "29",
      "number": 29,
      "subVerseIndex": 1,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.888Z",
      "updatedAt": "2025-09-03T02:41:45.888Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "cc242d0e-4e3b-455e-a2da-aff02329ed5e",
      "text": "Tâm hồn bình an là nguồn sống cho thể xác,",
      "label": "30",
      "number": 30,
      "subVerseIndex": 0,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.903Z",
      "updatedAt": "2025-09-03T02:41:45.903Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "becb9903-14bf-445e-a0d8-654d8f1dec55",
      "text": "nhưng lòng ghen ghét tựa chứng bệnh mục xương.",
      "label": "30",
      "number": 30,
      "subVerseIndex": 1,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.917Z",
      "updatedAt": "2025-09-03T02:41:45.917Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "817a6267-6e09-4626-85cf-9293f5172c4c",
      "text": "Áp bức người yếu thế là sỉ nhục Đấng tạo thành nên họ,",
      "label": "31",
      "number": 31,
      "subVerseIndex": 0,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.931Z",
      "updatedAt": "2025-09-03T02:41:45.931Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "e4fa31ee-5939-4394-adfe-2b25ea1ce09e",
      "text": "thương xót kẻ khó nghèo là tôn kính Đấng dựng nên người đó.",
      "label": "31",
      "number": 31,
      "subVerseIndex": 1,
      "paragraphNumber": 61,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.960Z",
      "updatedAt": "2025-09-03T02:41:45.960Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "a4722a37-f815-4a8c-8e95-f518044802be",
      "text": "Ác nhân té nhào vì điều ác nó gây ra,",
      "label": "33",
      "number": 33,
      "subVerseIndex": 0,
      "paragraphNumber": 62,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:45.989Z",
      "updatedAt": "2025-09-03T02:41:45.989Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "a54c8223-1e82-4653-896a-a949fd55bc58",
      "text": "chính nhân vững dạ vì đã sống vẹn toàn.",
      "label": "33",
      "number": 33,
      "subVerseIndex": 1,
      "paragraphNumber": 63,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:46.003Z",
      "updatedAt": "2025-09-03T02:41:46.003Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "307656a3-a92d-401c-9704-d3cc98f80805",
      "text": "Khôn ngoan ngự trị trong lòng người hiểu biết,",
      "label": "33",
      "number": 33,
      "subVerseIndex": 2,
      "paragraphNumber": 64,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:46.031Z",
      "updatedAt": "2025-09-03T02:41:46.031Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "f73645f9-919d-4354-915b-8b6e1bc7ee5e",
      "text": "nhưng chẳng ai thấy nó trong dạ đứa ngu si.",
      "label": "33",
      "number": 33,
      "subVerseIndex": 3,
      "paragraphNumber": 65,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:46.045Z",
      "updatedAt": "2025-09-03T02:41:46.045Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "7204a65f-5781-423b-bd2d-c266ef472e1c",
      "text": "Đức công chính đem cường thịnh cho nước,",
      "label": "34",
      "number": 34,
      "subVerseIndex": 0,
      "paragraphNumber": 66,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:46.073Z",
      "updatedAt": "2025-09-03T02:41:46.073Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "0a550090-c68a-46cf-8aab-0bcb7adb902d",
      "text": "còn tội lỗi gây nhục nhằn cho dân.",
      "label": "34",
      "number": 34,
      "subVerseIndex": 1,
      "paragraphNumber": 67,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:46.086Z",
      "updatedAt": "2025-09-03T02:41:46.086Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "46c910ea-c8f9-4f32-9d36-a2f93a7309e6",
      "text": "Bầy tôi mưu trí được hưởng ơn vua,",
      "label": "35",
      "number": 35,
      "subVerseIndex": 0,
      "paragraphNumber": 68,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:46.100Z",
      "updatedAt": "2025-09-03T02:41:46.100Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "022a9396-57ac-497c-a99c-0eb335a611da",
      "text": "bầy tôi bất tài làm vua thịnh nộ.",
      "label": "35",
      "number": 35,
      "subVerseIndex": 1,
      "paragraphNumber": 69,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:46.129Z",
      "updatedAt": "2025-09-03T02:41:46.129Z",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    }
  ],
  "marks": [
    {
      "id": "27c2eeb3-1c4c-481c-a329-ff684a4986dc",
      "content": "Cn 9,1; 24,3",
      "kind": "MARK_KIND_REFERENCE",
      "label": "1@",
      "sortOrder": 0,
      "startOffset": 18,
      "endOffset": 18,
      "createdAt": "2025-09-03T02:41:44.886Z",
      "updatedAt": "2025-09-03T02:41:44.886Z",
      "targetId": "c896c2a6-dbad-4e5c-9df7-d090f56a028e",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "dffd8a18-0a02-4795-be5f-f1e6342e0870",
      "content": "Người phụ nữ đảm đang biết lo xây dựng gia đình, ngược với người phụ nữ không biết lo xa. Có người cho rằng câu này cũng phải hiểu theo lối nhân cách hoá ở ch. 9.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 28,
      "endOffset": 28,
      "createdAt": "2025-09-03T02:41:44.908Z",
      "updatedAt": "2025-09-03T02:41:44.908Z",
      "targetId": "c4b4d79b-1e96-48b4-b958-77e877dff1b3",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "e2f51eed-1458-4945-a16e-ecdfdff40b81",
      "content": "English: Yahweh | French: SEIGNEUR | Latin: Dominus | Origin: &#1497;&#1456;&#1492;&#64331;&#1464;&#1492; | Vietnamese: ĐỨC CHÚA -- Danh của Thiên Chúa Ít-ra-en, St 2,4...",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 46,
      "endOffset": 46,
      "createdAt": "2025-09-03T02:41:44.931Z",
      "updatedAt": "2025-09-03T02:41:44.931Z",
      "targetId": "087500dd-6b1a-4381-a4d4-99148165fa56",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "2346218b-5ec1-47d1-8e32-f3f7d0fe7eb3",
      "content": "Cn 1,7",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 30,
      "endOffset": 30,
      "createdAt": "2025-09-03T02:41:44.944Z",
      "updatedAt": "2025-09-03T02:41:44.944Z",
      "targetId": "087500dd-6b1a-4381-a4d4-99148165fa56",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d52181a8-a84f-4a0c-b31a-7229959052f3"
    },
    {
      "id": "fd4946cc-5dd2-485b-a4c6-bab2220e13fb",
      "content": "*Trâu bò* thật cần thiết cho nông nghiệp, nên phải nuôi và chăm lo cho chúng.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 31,
      "endOffset": 31,
