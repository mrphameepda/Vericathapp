      "updatedAt": "2025-09-03T02:41:51.580Z",
      "targetId": "e23d75f0-33f5-4c52-8d17-280d97bcb78b",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "fd94e66c-bf9d-433a-b9fe-7cce0d6312b9",
      "content": "Cn 13,18",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 7,
      "endOffset": 7,
      "createdAt": "2025-09-03T02:41:51.678Z",
      "updatedAt": "2025-09-03T02:41:51.678Z",
      "targetId": "fcff177a-9761-48a8-bb9e-5a1f0b1a1d53",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "70ce505b-3f09-4205-9811-be9d67e493eb",
      "content": "*Lời nghiêm huấn, sửa dạy,* khiển trách là cần thiết cho việc giáo dục con người. Muốn nên khôn, cần phải mở lòng đón nhận (cc. 5.12.31.32).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 30,
      "endOffset": 30,
      "createdAt": "2025-09-03T02:41:51.664Z",
      "updatedAt": "2025-09-03T02:41:51.664Z",
