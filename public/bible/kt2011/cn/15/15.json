{
  "chapter": {
    "id": "e5cc5d58-e5b8-4b09-9058-c8a991a56063",
    "number": 15,
    "createdAt": "2025-09-03T01:07:51.667Z",
    "updatedAt": "2025-09-03T01:07:51.667Z",
    "bookId": "1ea97633-82d8-4f1a-bffc-dfb2da235911"
  },
  "verses": [
    {
      "id": "3376c6a7-97c1-41b2-84fc-98372f69be24",
      "text": "Câu đáp dịu dàng khiến cơn giận tiêu tan,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:51.491Z",
      "updatedAt": "2025-09-03T02:41:51.491Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "2f57fddf-5616-47c4-b4a0-2b3cd02a87ef",
      "text": "lời nói khiêu khích làm nổi cơn thịnh nộ.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:51.512Z",
      "updatedAt": "2025-09-03T02:41:51.512Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "5a2b3b1f-1d64-45df-aa57-1cee55d208e6",
      "text": "Lưỡi người khôn tiết ra tri thức,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:51.522Z",
      "updatedAt": "2025-09-03T02:41:51.522Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "1f431e92-05a7-43e4-8447-d7477464d5c6",
      "text": "miệng kẻ dại tuôn chuyện ngu si.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:51.544Z",
      "updatedAt": "2025-09-03T02:41:51.544Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "e23d75f0-33f5-4c52-8d17-280d97bcb78b",
      "text": "Mắt ĐỨC CHÚA ở mọi nơi mọi chỗ",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:51.554Z",
      "updatedAt": "2025-09-03T02:41:51.554Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "7ec132e0-410b-44f7-9835-46dce7825889",
      "text": "hằng dõi theo kẻ dữ người lành.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:51.594Z",
      "updatedAt": "2025-09-03T02:41:51.594Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "67b9f8d7-7b08-4845-acff-61324c88b2cc",
      "text": "Lời xoa dịu tựa cây ban sự sống,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:51.608Z",
      "updatedAt": "2025-09-03T02:41:51.608Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "51b00ba6-f266-4920-99dd-1c7008559d53",
      "text": "lời nham hiểm làm tan nát tâm can.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:51.622Z",
      "updatedAt": "2025-09-03T02:41:51.622Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "86ae7568-8162-4827-b566-a01461e38809",
      "text": "Kẻ ngu khinh lời cha nghiêm huấn,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:51.636Z",
      "updatedAt": "2025-09-03T02:41:51.636Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "fcff177a-9761-48a8-bb9e-5a1f0b1a1d53",
      "text": "ai giữ lời sửa dạy sẽ nên khôn.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:51.650Z",
      "updatedAt": "2025-09-03T02:41:51.650Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "50bbfa2f-a6bd-4b7c-80f1-fe776f857f31",
      "text": "Nhà người ngay dư đầy của cải,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:51.692Z",
      "updatedAt": "2025-09-03T02:41:51.692Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "addb3419-460d-464d-8fff-f1c63745630d",
      "text": "nhưng huê lợi của kẻ ác gây bối rối âu lo.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:51.712Z",
      "updatedAt": "2025-09-03T02:41:51.712Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "1ff492d3-663b-49c1-9e05-92cf1bc7e6b8",
      "text": "Môi người khôn truyền bá kiến thức,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:51.726Z",
      "updatedAt": "2025-09-03T02:41:51.726Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "d6079ca3-a7f5-4022-9ea2-2691a6925721",
      "text": "lòng kẻ dại chẳng được thế đâu.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:51.741Z",
      "updatedAt": "2025-09-03T02:41:51.741Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "4a09f8e7-8b33-4f47-ba69-2a0065f14b39",
      "text": "ĐỨC CHÚA ghê tởm hy lễ của đứa ác,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:51.755Z",
      "updatedAt": "2025-09-03T02:41:51.755Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "53a48395-cb54-48a0-9ac2-515581d66d73",
      "text": "nhưng ưa thích lời cầu của kẻ ngay.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:51.797Z",
      "updatedAt": "2025-09-03T02:41:51.797Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "1559141f-0fa1-4dde-90b0-9c817fe433ae",
      "text": "ĐỨC CHÚA ghê tởm lối sống của ác nhân,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:51.825Z",
      "updatedAt": "2025-09-03T02:41:51.825Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "ad11ba2a-f482-40b3-bcec-10165888f066",
      "text": "nhưng mến thương người theo đuổi sự công chính.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:51.867Z",
      "updatedAt": "2025-09-03T02:41:51.867Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "a48567f3-3fb9-4145-bb28-ccb3e571efd8",
      "text": "Kẻ rời xa đường ngay chính sẽ bị nghiêm trị,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:51.881Z",
      "updatedAt": "2025-09-03T02:41:51.881Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "1e4e5037-6d6d-4b56-af7c-56dcf78dcde8",
      "text": "ai khinh thường lời sửa dạy sẽ phải mạng vong.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:51.895Z",
      "updatedAt": "2025-09-03T02:41:51.895Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "91882bb7-f685-4121-874b-d0676a363ad8",
      "text": "Âm phủ, âm ty còn phơi bày trước nhan ĐỨC CHÚA,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:51.910Z",
      "updatedAt": "2025-09-03T02:41:51.910Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "ac61aa99-c499-49a8-ba13-db7f3368df80",
      "text": "huống chi là lòng dạ con người !",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:51.952Z",
      "updatedAt": "2025-09-03T02:41:51.952Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "50adc89c-03f0-4f98-8749-df3aaa62e7a2",
      "text": "Kẻ nhạo báng không thích bị khiển trách,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:51.966Z",
      "updatedAt": "2025-09-03T02:41:51.966Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "f8c71cd5-d7ff-4573-87d9-aef94197835a",
      "text": "cũng chẳng chịu đến với người khôn.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:51.995Z",
      "updatedAt": "2025-09-03T02:41:51.995Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "34e1f685-d79a-436a-9fc5-407e0d802c56",
      "text": "Lòng mừng vui làm hân hoan nét mặt,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:52.008Z",
      "updatedAt": "2025-09-03T02:41:52.008Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "ea880b2a-0b1a-4848-8d28-92f52253b164",
      "text": "lòng sầu muộn khiến tâm trí rã rời.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:52.036Z",
      "updatedAt": "2025-09-03T02:41:52.036Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "549a25f9-963e-4d8d-86b7-0ac5c403acd9",
      "text": "Trí người minh mẫn kiếm tìm tri thức,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:52.053Z",
      "updatedAt": "2025-09-03T02:41:52.053Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "b5b60d94-1ab6-4ee8-9586-66478e8b668d",
      "text": "miệng kẻ ngu si ham thích chuyện điên rồ.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:52.082Z",
      "updatedAt": "2025-09-03T02:41:52.082Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "de26f793-b886-434e-a725-3415cd23c380",
      "text": "Kẻ cùng khốn thấy ngày nào cũng xấu,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:52.097Z",
      "updatedAt": "2025-09-03T02:41:52.097Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "df5ef1df-1ffb-46b8-8360-ef21764ebca4",
      "text": "đời người vui là yến tiệc kéo dài.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:52.110Z",
      "updatedAt": "2025-09-03T02:41:52.110Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "101bc84e-e1bc-4074-b387-b86e99709681",
      "text": "Ít của ít tiền mà biết kính sợ ĐỨC CHÚA",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:52.125Z",
      "updatedAt": "2025-09-03T02:41:52.125Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "ae970f86-f35a-446b-b386-9638bb9d2f1e",
      "text": "hơn có cả kho tàng mà cứ phải âu lo.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:52.167Z",
      "updatedAt": "2025-09-03T02:41:52.167Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "c548d441-e560-45ac-84e9-78b3042fb728",
      "text": "Thà bữa rau bữa cháo mà yêu thương nhau",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:52.182Z",
      "updatedAt": "2025-09-03T02:41:52.182Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "6d22adcc-bcd2-4e7d-992c-e5a26e9fc8a3",
      "text": "còn hơn mâm cao cỗ đầy mà bất hoà bất thuận.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:52.196Z",
      "updatedAt": "2025-09-03T02:41:52.196Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "9afdf0d3-3f81-4099-a49c-7ad294ff5eb6",
      "text": "Kẻ nóng tính gây ra cãi vã,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:52.224Z",
      "updatedAt": "2025-09-03T02:41:52.224Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "7e9eecf2-a086-4cbe-a200-e6f4bf1116c6",
      "text": "người chậm giận làm dịu cuộc đôi co.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:52.238Z",
      "updatedAt": "2025-09-03T02:41:52.238Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "0b729ed7-cc7b-493d-ba06-f57d27194d00",
      "text": "Đường kẻ lười bị rào gai cản trở,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:52.252Z",
      "updatedAt": "2025-09-03T02:41:52.252Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "03732430-7853-495b-a39e-9945a00970df",
      "text": "lối người ngay được bồi đắp thênh thang.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:52.266Z",
      "updatedAt": "2025-09-03T02:41:52.266Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "6f072c25-3e38-410c-9bb8-e237e8406b4f",
      "text": "Con khôn làm hài lòng cha,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:52.280Z",
      "updatedAt": "2025-09-03T02:41:52.280Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "741cae04-ab86-4a2e-a830-74e35464eafa",
      "text": "đứa dại không nể mặt mẹ.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:52.309Z",
      "updatedAt": "2025-09-03T02:41:52.309Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "56ca447c-8f40-4304-87e2-0d84ead98ed9",
      "text": "Kẻ ngu si lấy điều dại làm vui,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:52.322Z",
      "updatedAt": "2025-09-03T02:41:52.322Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "f2bee752-f3f4-411a-9527-afd9e21cd2ce",
      "text": "người hiểu biết cứ thẳng đường mà tiến.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:52.336Z",
      "updatedAt": "2025-09-03T02:41:52.336Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "12c61ea8-3c33-411e-983e-904335caee0d",
      "text": "Thiếu bàn bạc, chương trình đổ vỡ,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:52.350Z",
      "updatedAt": "2025-09-03T02:41:52.350Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "7d687183-267e-4c2b-9e29-8934145d1b79",
      "text": "nhiều cố vấn, ắt sẽ thành công.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:52.365Z",
      "updatedAt": "2025-09-03T02:41:52.365Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "431b2438-8ecd-4f40-af8e-da81f13ca564",
      "text": "Biết đối đáp khiến con người vui thú,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:52.391Z",
      "updatedAt": "2025-09-03T02:41:52.391Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "c0195906-de70-41e2-8616-ec8e9a36b04d",
      "text": "nói đúng lúc, thật tốt đẹp dường bao !",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:52.403Z",
      "updatedAt": "2025-09-03T02:41:52.403Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "a249fbeb-a9b0-4ef9-8e04-098e14d1a17c",
      "text": "Người khôn theo con đường đưa lên sự sống,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:52.415Z",
      "updatedAt": "2025-09-03T02:41:52.415Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "f7f8d6f0-af7f-4d4f-bd7a-805484a655a8",
      "text": "tránh con đường dẫn xuống âm ty.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:52.439Z",
      "updatedAt": "2025-09-03T02:41:52.439Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "984e36ae-2cf1-4c8b-a376-171283c3f304",
      "text": "Nhà đứa kiêu căng, ĐỨC CHÚA giật cho sập,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:52.452Z",
      "updatedAt": "2025-09-03T02:41:52.452Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "fc0f8b24-9435-4d06-ac18-f4cb98a821d5",
      "text": "đất kẻ goá bụa, Người giữ vững đường ranh.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:52.479Z",
      "updatedAt": "2025-09-03T02:41:52.479Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "4cd98096-e8dc-4f3a-970f-81dde829d005",
      "text": "ĐỨC CHÚA ghê tởm những mưu đồ xấu xa,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:52.507Z",
      "updatedAt": "2025-09-03T02:41:52.507Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "37f8b40c-ff7c-4a06-a62e-5c812de68a7f",
      "text": "còn lời lẽ nhân hậu thì thuần khiết.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:52.534Z",
      "updatedAt": "2025-09-03T02:41:52.534Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "d84fcebf-8127-404e-8e09-4de3bc308d72",
      "text": "Kẻ hám lợi làm tan hoang nhà cửa,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:52.547Z",
      "updatedAt": "2025-09-03T02:41:52.547Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "4dc57051-87d9-4672-9f21-3c77ae9701cc",
      "text": "người khinh chê quà hối lộ sẽ được sống lâu.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:52.573Z",
      "updatedAt": "2025-09-03T02:41:52.573Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "555abc03-1db6-4a1b-97a8-ac46d654b905",
      "text": "Người công chính nghĩ suy rồi mới đáp,",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:52.586Z",
      "updatedAt": "2025-09-03T02:41:52.586Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "55ecb788-de71-46b4-bfb0-a86fbbf52fa4",
      "text": "miệng kẻ ác tuôn trào chuyện xấu xa.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 1,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:52.599Z",
      "updatedAt": "2025-09-03T02:41:52.599Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "bce505e2-6d59-480f-9f18-bb49b7a57c2c",
      "text": "ĐỨC CHÚA ở xa phường gian ác,",
      "label": "29",
      "number": 29,
      "subVerseIndex": 0,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:52.613Z",
      "updatedAt": "2025-09-03T02:41:52.613Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "1bf51ed5-035d-4231-86d5-2a867e330728",
      "text": "nhưng nghe lời nguyện của chính nhân.",
      "label": "29",
      "number": 29,
      "subVerseIndex": 1,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:52.647Z",
      "updatedAt": "2025-09-03T02:41:52.647Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "ce4d489e-0632-4b0b-893b-5005b02368ca",
      "text": "Cái nhìn ngời sáng làm tâm hồn vui sướng,",
      "label": "30",
      "number": 30,
      "subVerseIndex": 0,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:52.661Z",
      "updatedAt": "2025-09-03T02:41:52.661Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "8fb4188b-84de-48db-815d-9770c1455a0f",
      "text": "tin tức may lành khiến xương cốt vững vàng.",
      "label": "30",
      "number": 30,
      "subVerseIndex": 1,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:52.675Z",
      "updatedAt": "2025-09-03T02:41:52.675Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "48f42f2e-a2ad-4004-bf19-f6898a757699",
      "text": "Kẻ lắng nghe lời sửa dạy, lời ban sự sống,",
      "label": "31",
      "number": 31,
      "subVerseIndex": 0,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:52.688Z",
      "updatedAt": "2025-09-03T02:41:52.688Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "45aac5fb-35e5-4882-a671-43b2d798f667",
      "text": "sẽ được cư ngụ với những bậc khôn ngoan.",
      "label": "31",
      "number": 31,
      "subVerseIndex": 1,
      "paragraphNumber": 61,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:52.716Z",
      "updatedAt": "2025-09-03T02:41:52.716Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "854446ea-bfb0-45f6-a633-3fb93808cc5f",
      "text": "Bỏ lời nghiêm huấn là coi rẻ chính mình,",
      "label": "32",
      "number": 32,
      "subVerseIndex": 0,
      "paragraphNumber": 62,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:52.730Z",
      "updatedAt": "2025-09-03T02:41:52.730Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "7e81dc39-1d85-4d95-8142-86a9f06a81f1",
      "text": "nghe lời sửa dạy là sắm lấy hiểu biết.",
      "label": "32",
      "number": 32,
      "subVerseIndex": 1,
      "paragraphNumber": 63,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:52.744Z",
      "updatedAt": "2025-09-03T02:41:52.744Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "f2c29d0e-aa36-42f3-8092-617742d47906",
      "text": "Lòng kính sợ ĐỨC CHÚA là trường dạy khôn ngoan,",
      "label": "33",
      "number": 33,
      "subVerseIndex": 0,
      "paragraphNumber": 64,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:52.758Z",
      "updatedAt": "2025-09-03T02:41:52.758Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    },
    {
      "id": "bdc7e154-179e-48e4-aff2-a648b467db70",
      "text": "khiêm nhu là đường dẫn đến vinh dự.",
      "label": "33",
      "number": 33,
      "subVerseIndex": 1,
      "paragraphNumber": 65,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:52.786Z",
      "updatedAt": "2025-09-03T02:41:52.786Z",
      "chapterId": "e5cc5d58-e5b8-4b09-9058-c8a991a56063"
    }
  ],
