      "updatedAt": "2025-09-03T02:41:58.344Z",
      "targetId": "eeb1b7e7-69d7-4bfa-8c51-7153e40d1013",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "97484d01-42a0-4434-b798-f7203bc36565",
      "content": "1 Pr 4,8",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:41:58.562Z",
      "updatedAt": "2025-09-03T02:41:58.562Z",
      "targetId": "576f3e98-18ac-4ee1-9024-463eb91e78bf",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "c7a64d87-e0a4-46ad-9eb2-32d84e8e8779",
      "content": "ds : *Con người cho mọi nẻo đường mình đi là trong sáng, nhưng chính Đức Chúa cân lòng dạ tâm can*. Con người dễ rơi vào tự mãn khi đánh giá mình. Cần đo mình bằng thước đo của Đức Chúa.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 36,
      "endOffset": 36,
      "createdAt": "2025-09-03T02:41:58.358Z",
      "updatedAt": "2025-09-03T02:41:58.358Z",
      "targetId": "eeb1b7e7-69d7-4bfa-8c51-7153e40d1013",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
