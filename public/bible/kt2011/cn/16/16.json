    },
    {
      "id": "3211b492-dca1-4bb4-89e7-cd4f91ca8a3b",
      "content": "Cn 14,12",
      "kind": "MARK_KIND_REFERENCE",
      "label": "13@",
      "sortOrder": 12,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:41:59.366Z",
      "updatedAt": "2025-09-03T02:41:59.366Z",
      "targetId": "ebdac56a-98cb-410c-a943-6b14cf541127",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "7349abe5-bfd3-4a81-bef0-e4add22b9a53",
      "content": "Vì vua là đại diện của Thiên Chúa, phân xử nhân danh Người theo đúng lẽ công bình (x. 2 Sm 14,17-20 ; 1 V 3,4-28). Trong cc. 10-15 (trừ c.11), ta đều thấy nói đến vua.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "14",
      "sortOrder": 13,
      "startOffset": 41,
      "endOffset": 41,
      "createdAt": "2025-09-03T02:41:58.796Z",
      "updatedAt": "2025-09-03T02:41:58.796Z",
      "targetId": "cc5c6c99-46c5-4d0d-9998-45181d721ded",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "0546e5a4-5725-425d-88e9-f801e2a660c7",
      "content": "Gc 3,6",
      "kind": "MARK_KIND_REFERENCE",
      "label": "14@",
      "sortOrder": 13,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:41:59.441Z",
