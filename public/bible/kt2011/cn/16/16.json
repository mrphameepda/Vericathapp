    {
      "id": "c3011888-d3af-4c6d-a13a-4c65eb4f4ae3",
      "content": "Câu này ý nghĩa tương tự như 16,1.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "13",
      "sortOrder": 12,
      "startOffset": 35,
