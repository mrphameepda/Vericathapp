{
  "chapter": {
    "id": "20524418-494e-4890-92d2-1fcbdc5abf25",
    "number": 16,
    "createdAt": "2025-09-03T01:07:51.667Z",
    "updatedAt": "2025-09-03T01:07:51.667Z",
    "bookId": "1ea97633-82d8-4f1a-bffc-dfb2da235911"
  },
  "verses": [
    {
      "id": "97849e4f-df4e-44e9-aab1-fa987ed899b4",
      "text": "Suy nghĩ lo toan là việc của con người,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:58.263Z",
      "updatedAt": "2025-09-03T02:41:58.263Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "6f528c31-2354-43be-b576-563667a4c05b",
      "text": "còn nói câu trả lời là do ĐỨC CHÚA.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:58.273Z",
      "updatedAt": "2025-09-03T02:41:58.273Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "6b80a230-0726-4b4f-a1ac-dbe44d2dd67b",
      "text": "Con người cho lối sống của mình là trong sáng,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:58.309Z",
      "updatedAt": "2025-09-03T02:41:58.309Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "eeb1b7e7-69d7-4bfa-8c51-7153e40d1013",
      "text": "nhưng ĐỨC CHÚA thấu suốt mọi tâm can.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:58.331Z",
      "updatedAt": "2025-09-03T02:41:58.331Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "0a5cf67a-a699-4500-b629-e69b4057ac5a",
      "text": "Hãy ký thác việc bạn làm cho ĐỨC CHÚA,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:58.372Z",
      "updatedAt": "2025-09-03T02:41:58.372Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "6048782e-7476-4f16-be06-591fd23d5c4d",
      "text": "dự tính của bạn ắt sẽ thành công.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:58.400Z",
      "updatedAt": "2025-09-03T02:41:58.400Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "b2cae36b-f9dd-4a77-af3c-788006d635e6",
      "text": "Mọi việc ĐỨC CHÚA làm đều có cùng đích riêng,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:58.413Z",
      "updatedAt": "2025-09-03T02:41:58.413Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "73d6f483-a379-4d37-b975-261eed290a6f",
      "text": "người ác được dựng nên là cho ngày tai hoạ.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:58.441Z",
      "updatedAt": "2025-09-03T02:41:58.441Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "30fbe32c-4604-4051-bba1-3b8ec6c27413",
      "text": "Đứa kiêu căng làm ĐỨC CHÚA ghê tởm,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:58.455Z",
      "updatedAt": "2025-09-03T02:41:58.455Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "de6f866f-ca49-490b-b664-6ed41bbc0f3b",
      "text": "hẳn nó không thoát khỏi án phạt đâu.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:58.497Z",
      "updatedAt": "2025-09-03T02:41:58.497Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "576f3e98-18ac-4ee1-9024-463eb91e78bf",
      "text": "Nhờ nhân nghĩa tín thành mà tội được xoá bỏ,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:58.528Z",
      "updatedAt": "2025-09-03T02:41:58.528Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "dbf0144a-fe7e-4d3b-a845-54bd1cd377e7",
      "text": "nhờ kính sợ ĐỨC CHÚA mà tránh được sự dữ.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:58.576Z",
      "updatedAt": "2025-09-03T02:41:58.576Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "1c1e4c1f-c0ea-4af9-be8b-fa41e079fc6d",
      "text": "Khi ĐỨC CHÚA hài lòng về lối sống của ai",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:58.605Z",
      "updatedAt": "2025-09-03T02:41:58.605Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "74020164-6bb1-47ef-86f8-8a9e91982f15",
      "text": "Người khiến cả quân thù cũng làm hoà với kẻ ấy.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:58.633Z",
      "updatedAt": "2025-09-03T02:41:58.633Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "32d9c82e-2cf3-4162-a2ee-bb1224246a69",
      "text": "Thà ít của cải mà sống công chính",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:58.648Z",
      "updatedAt": "2025-09-03T02:41:58.648Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "f3155e5a-ebbd-4482-a876-b0291f9c22f9",
      "text": "hơn nhiều huê lợi mà thiếu công minh.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:58.675Z",
      "updatedAt": "2025-09-03T02:41:58.675Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "73f6b7fa-065a-42ea-80fc-d9ba5e5391ca",
      "text": "Tâm trí con người nghĩ ra đường lối,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:58.689Z",
      "updatedAt": "2025-09-03T02:41:58.689Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "50b59007-9732-4573-8213-3e1bdd9686d7",
      "text": "còn ĐỨC CHÚA hướng dẫn từng bước đi.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:58.719Z",
      "updatedAt": "2025-09-03T02:41:58.719Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "e6160eab-5b0c-44db-a1bf-3bbfa995cedf",
      "text": "Lời vua là lời sấm,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:58.767Z",
      "updatedAt": "2025-09-03T02:41:58.767Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "cc5c6c99-46c5-4d0d-9998-45181d721ded",
      "text": "mở miệng ra phân xử, vua sẽ chẳng sai lầm.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:58.781Z",
      "updatedAt": "2025-09-03T02:41:58.781Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "d0bbe156-8516-4f76-824b-c8d552f87e8a",
      "text": "Cán cân và bàn cân chính xác là của ĐỨC CHÚA,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:58.810Z",
      "updatedAt": "2025-09-03T02:41:58.810Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "509f93c8-5787-4ccb-b54f-2e20cf8eaec5",
      "text": "mọi quả cân trong túi là sản phẩm của Người.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:58.853Z",
      "updatedAt": "2025-09-03T02:41:58.853Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "9f8caf3a-5fbc-42de-b8af-290ff92264aa",
      "text": "Làm điều dữ là chuyện vua ghê tởm,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:58.867Z",
      "updatedAt": "2025-09-03T02:41:58.867Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "cf6d205f-69ce-4cbc-9c3b-06ffa7885fbc",
      "text": "vì nhờ sống công chính mà ngai báu vững bền.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:58.881Z",
      "updatedAt": "2025-09-03T02:41:58.881Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "3278dc2b-2c3e-457e-9bf9-12fc7dbcc042",
      "text": "Lời lẽ chân thành khiến vua quý chuộng,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:58.923Z",
      "updatedAt": "2025-09-03T02:41:58.923Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "8e660486-edf1-423c-8081-95f12036020f",
      "text": "vua yêu thương kẻ ăn nói thẳng ngay.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:58.937Z",
      "updatedAt": "2025-09-03T02:41:58.937Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "9df3828e-385d-494a-87f4-5219442c9abd",
      "text": "Cơn giận của vua báo tin thần chết đến,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:58.950Z",
      "updatedAt": "2025-09-03T02:41:58.950Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "dbe4adb6-5048-46c1-b07b-af2b7d7f0689",
      "text": "biết làm vua nguôi giận ấy mới là người khôn.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:58.978Z",
      "updatedAt": "2025-09-03T02:41:58.978Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "9b80a1bc-0e53-4cba-93bd-1dace516871d",
      "text": "Long nhan rạng rỡ là bầy tôi được sống,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:58.992Z",
      "updatedAt": "2025-09-03T02:41:58.992Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "2526dd53-9e21-4cbb-acfa-f820b2fdd22a",
      "text": "ơn vua ban xuống như mây đổ mưa xuân.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:59.008Z",
      "updatedAt": "2025-09-03T02:41:59.008Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "c1c85b5b-1c51-4ab8-bfb6-740153a137af",
      "text": "Được khôn ngoan tốt hơn được vàng,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:59.035Z",
      "updatedAt": "2025-09-03T02:41:59.035Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "2753f339-9bde-4596-96cc-a17594e45d56",
      "text": "được hiểu biết quý hơn được bạc.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:59.046Z",
      "updatedAt": "2025-09-03T02:41:59.046Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "9d1158b0-25b7-404b-91e4-653cf552914a",
      "text": "Nẻo đường người chính trực tránh xa điều ác ;",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:59.057Z",
      "updatedAt": "2025-09-03T02:41:59.057Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "afdde72a-cde1-481f-9a54-5b2b6db9c48d",
      "text": "ai để mắt nhìn lối mình đi thì sinh mạng an toàn.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:59.069Z",
      "updatedAt": "2025-09-03T02:41:59.069Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "b2d31139-aaa1-4451-9075-c8f30f895382",
      "text": "Kiêu căng đưa đến sụp đổ,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:59.083Z",
      "updatedAt": "2025-09-03T02:41:59.083Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "da7f1cf4-b038-4064-a5d9-daa715a99ea1",
      "text": "ngạo mạn dẫn đến té nhào.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:59.110Z",
      "updatedAt": "2025-09-03T02:41:59.110Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "b7e4fa5b-d85b-4c36-a58f-bac9907e1e10",
      "text": "Thà sống tự hạ với kẻ khiêm nhu",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:59.123Z",
      "updatedAt": "2025-09-03T02:41:59.123Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "3fcd6d57-60a9-4503-9cdb-a03e05fc78bf",
      "text": "hơn chia chiến lợi phẩm với phường kiêu hãnh.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:59.138Z",
      "updatedAt": "2025-09-03T02:41:59.138Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "a787205c-b26e-4b99-8837-48639f95f092",
      "text": "Kẻ chú tâm vào lời Chúa dạy sẽ gặp chuyện tốt lành,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:59.152Z",
      "updatedAt": "2025-09-03T02:41:59.152Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "506af8ac-37cc-42c2-8337-98ff84a903da",
      "text": "người đặt niềm tin vào ĐỨC CHÚA thật hạnh phúc dường bao.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:59.166Z",
      "updatedAt": "2025-09-03T02:41:59.166Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "de0a9e53-b659-46a5-b389-44afbd924c0f",
      "text": "Người có trí khôn ngoan được coi là sáng suốt,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:59.211Z",
      "updatedAt": "2025-09-03T02:41:59.211Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "214be8a4-5b5c-46b0-998f-9c3e501dc660",
      "text": "lời ngọt ngào làm cho sức thuyết phục gia tăng.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:59.239Z",
      "updatedAt": "2025-09-03T02:41:59.239Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "0145a69e-6a92-444f-86df-688be751f564",
      "text": "Kẻ có lương tri là có nguồn sự sống,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:59.254Z",
      "updatedAt": "2025-09-03T02:41:59.254Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "a81a2c83-d8b5-46ed-a831-25d8ed5a7e52",
      "text": "sự dại khờ là hình phạt kẻ ngu si.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:59.267Z",
      "updatedAt": "2025-09-03T02:41:59.267Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "25412c07-b635-4d2a-9514-42cfa5396ce5",
      "text": "Trí khôn ngoan làm miệng nên khéo léo",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:59.281Z",
      "updatedAt": "2025-09-03T02:41:59.281Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "4121c255-f085-4711-ad1d-656b1da3b046",
      "text": "và thêm sức thuyết phục cho đôi môi.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:59.295Z",
      "updatedAt": "2025-09-03T02:41:59.295Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "9c4d3037-3a05-4ccd-ad04-b3beb7e49dd5",
      "text": "Lời tử tế là tảng mật ong",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:59.323Z",
      "updatedAt": "2025-09-03T02:41:59.323Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "c4a7bc26-63f8-46af-aecc-50d16d809372",
      "text": "làm cổ họng ngọt ngào, khiến xương cốt lành mạnh.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:59.337Z",
      "updatedAt": "2025-09-03T02:41:59.337Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "ebdac56a-98cb-410c-a943-6b14cf541127",
      "text": "Có con đường xem ra ngay thẳng,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:59.352Z",
      "updatedAt": "2025-09-03T02:41:59.352Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "38b9a8a3-330c-44fe-9c94-e628ef483b28",
      "text": "nhưng rốt cuộc lại đưa đến tử vong.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:59.380Z",
      "updatedAt": "2025-09-03T02:41:59.380Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "da3c12e8-576a-40f4-9d3d-388ab5035592",
      "text": "Miệng muốn ăn khiến con người vất vả,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:59.394Z",
      "updatedAt": "2025-09-03T02:41:59.394Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "247b91a9-6aba-440a-974b-02455368e6ce",
      "text": "vì bụng đói nên đầu gối phải bò.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:59.406Z",
      "updatedAt": "2025-09-03T02:41:59.406Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "e97cf746-09bf-4fe1-8912-0336bfaddeb5",
      "text": "Quân vô lại đào hố gây tai ương,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:59.429Z",
      "updatedAt": "2025-09-03T02:41:59.429Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "0d4b3e31-16f6-4635-a243-f4490e270326",
      "text": "đôi môi nó như lửa hồng cháy bỏng.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:59.454Z",
      "updatedAt": "2025-09-03T02:41:59.454Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "47e92948-01bd-4a56-aa26-0bcf567c4eba",
      "text": "Kẻ dối gian gây bất hoà tranh chấp,",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:59.468Z",
      "updatedAt": "2025-09-03T02:41:59.468Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "ffddc303-b0a9-4156-af44-9789682882d8",
      "text": "tên mách lẻo chuyên chia rẽ bạn bè.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 1,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:59.482Z",
      "updatedAt": "2025-09-03T02:41:59.482Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "63fb7627-ff58-4d33-9d1c-86584246007c",
      "text": "Người thô bạo phỉnh phờ bằng hữu,",
      "label": "29",
      "number": 29,
      "subVerseIndex": 0,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:59.495Z",
      "updatedAt": "2025-09-03T02:41:59.495Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "2d6f1726-6565-485e-827f-c153c297d9c2",
      "text": "dẫn họ vào đường nẻo xấu xa.",
      "label": "29",
      "number": 29,
      "subVerseIndex": 1,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:59.509Z",
      "updatedAt": "2025-09-03T02:41:59.509Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "7e6e61f6-22de-4f9c-8ffa-5efea3c7847f",
      "text": "Nháy mắt mím môi, nghĩ ra điều dối trá",
      "label": "30",
      "number": 30,
      "subVerseIndex": 0,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:59.523Z",
      "updatedAt": "2025-09-03T02:41:59.523Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "967d35b0-5f81-4b72-a897-7dac9d50ed01",
      "text": "là làm sự ác rồi.",
      "label": "30",
      "number": 30,
      "subVerseIndex": 1,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:59.536Z",
      "updatedAt": "2025-09-03T02:41:59.536Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "b65101df-b90b-4a37-85b3-64c8971e7872",
      "text": "Mái đầu bạc là triều thiên vinh hiển",
      "label": "31",
      "number": 31,
      "subVerseIndex": 0,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:59.551Z",
      "updatedAt": "2025-09-03T02:41:59.551Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "7d4b2dba-e6d1-404f-a29d-8530e77cffab",
      "text": "được tặng ban cho kẻ sống công chính.",
      "label": "31",
      "number": 31,
      "subVerseIndex": 1,
      "paragraphNumber": 61,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:59.578Z",
      "updatedAt": "2025-09-03T02:41:59.578Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "8d4e110a-3df9-4345-99c5-e492c47dae2e",
      "text": "Người chậm giận thì hơn trang hào kiệt,",
      "label": "32",
      "number": 32,
      "subVerseIndex": 0,
      "paragraphNumber": 62,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:59.592Z",
      "updatedAt": "2025-09-03T02:41:59.592Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "ac3b1aef-7ede-4057-af72-2595fcb61ceb",
      "text": "người tự chủ hơn kẻ chiếm được thành.",
      "label": "32",
      "number": 32,
      "subVerseIndex": 1,
      "paragraphNumber": 63,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:59.606Z",
      "updatedAt": "2025-09-03T02:41:59.606Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "c35994cf-fdbf-4cb1-9286-6797c87ab906",
      "text": "Người ta gieo quẻ trong vạt áo,",
      "label": "33",
      "number": 33,
      "subVerseIndex": 0,
      "paragraphNumber": 64,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:59.620Z",
      "updatedAt": "2025-09-03T02:41:59.620Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "0a8aec1f-c231-41b0-ba9d-36b246e7a758",
      "text": "nhưng mọi quyết định của phàm nhân",
      "label": "33",
      "number": 33,
      "subVerseIndex": 1,
      "paragraphNumber": 65,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:59.648Z",
      "updatedAt": "2025-09-03T02:41:59.648Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    },
    {
      "id": "e3e2dd86-4dff-412f-a28a-0b9ebb3ca62b",
      "text": "đều bắt nguồn từ ĐỨC CHÚA.",
      "label": "33",
      "number": 33,
      "subVerseIndex": 2,
      "paragraphNumber": 66,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:59.662Z",
      "updatedAt": "2025-09-03T02:41:59.662Z",
      "chapterId": "20524418-494e-4890-92d2-1fcbdc5abf25"
    }
  ],
