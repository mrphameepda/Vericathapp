{
  "chapter": {
    "id": "98d21b9e-13d5-4908-89c0-94c4f611df54",
    "number": 17,
    "createdAt": "2025-09-03T01:07:51.667Z",
    "updatedAt": "2025-09-03T01:07:51.667Z",
    "bookId": "1ea97633-82d8-4f1a-bffc-dfb2da235911"
  },
  "verses": [
    {
      "id": "1bfd7bf5-213b-432b-9543-c1275ff92e05",
      "text": "Thà ăn mẩu bánh khô mà được êm ấm",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:05.965Z",
      "updatedAt": "2025-09-03T02:42:05.965Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "c31659f9-0e0a-4f9e-8ec6-ece85303dc92",
      "text": "còn hơn đầy yến tiệc mà nhà cửa bất hoà.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:05.994Z",
      "updatedAt": "2025-09-03T02:42:05.994Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "2f743bee-f42e-40ee-9495-805d15dd9038",
      "text": "Đầy tớ tài giỏi thì hơn cả đứa con hư đốn,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.017Z",
      "updatedAt": "2025-09-03T02:42:06.017Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "2b2948a3-4abf-48aa-ab26-ad44aa2c7537",
      "text": "lại được chia gia sản với anh em trong nhà.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.030Z",
      "updatedAt": "2025-09-03T02:42:06.030Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "3b4e7597-1d76-4c1d-8fd1-539617a09f79",
      "text": "Lò thử vàng, nồi thử bạc,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.059Z",
      "updatedAt": "2025-09-03T02:42:06.059Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "4d6933ed-6007-40a2-ac8c-cf5411506115",
      "text": "còn ĐỨC CHÚA thử lòng dạ con người.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.100Z",
      "updatedAt": "2025-09-03T02:42:06.100Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "b6fe87d4-142c-47ce-88b5-62212730b7aa",
      "text": "Phường gian ác để tâm đến những lời bất chính,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.127Z",
      "updatedAt": "2025-09-03T02:42:06.127Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "101a3e32-fa8c-41cc-9bba-6926ac2ab6ce",
      "text": "quân lừa đảo lắng tai nghe những chuyện hại người.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.141Z",
      "updatedAt": "2025-09-03T02:42:06.141Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "0b6b2284-96c2-4256-ad00-8f93cef442ae",
      "text": "Chế giễu kẻ lâm cảnh túng nghèo",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.155Z",
      "updatedAt": "2025-09-03T02:42:06.155Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "8156bccc-50d3-4521-99d4-610df88c05a6",
      "text": "là sỉ nhục Đấng tạo thành nên họ.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.169Z",
      "updatedAt": "2025-09-03T02:42:06.169Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "e5eb9c5a-e24e-4287-99f4-415376a9456c",
      "text": "Vui mừng khi người gặp tai ương",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.197Z",
      "updatedAt": "2025-09-03T02:42:06.197Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "ded9eedf-af58-4f99-8f9d-b15934e13e19",
      "text": "thì sẽ không thoát khỏi án phạt.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 3,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.211Z",
      "updatedAt": "2025-09-03T02:42:06.211Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "a948ce34-16f3-49c1-b33b-30988d79eb63",
      "text": "Triều thiên của người già là đàn con cháu,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.225Z",
      "updatedAt": "2025-09-03T02:42:06.225Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "2f0a1eab-4af8-4436-912c-d7e7f7b9f8dd",
      "text": "vinh dự của con cái là chính người cha.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.239Z",
      "updatedAt": "2025-09-03T02:42:06.239Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "f3c1c302-d6ef-4eb8-8140-c848d35ce7d9",
      "text": "Lời tao nhã đâu có hợp với kẻ ngu dốt,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.252Z",
      "updatedAt": "2025-09-03T02:42:06.252Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "96480469-e804-4f3c-bec2-e20aa84fb4cb",
      "text": "lời dối gian càng không hợp với người thanh cao.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.266Z",
      "updatedAt": "2025-09-03T02:42:06.266Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "cb5360ce-206d-4b16-9108-863e0d792c02",
      "text": "Quà hối lộ là bùa mê dưới mắt người đem biếu,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.280Z",
      "updatedAt": "2025-09-03T02:42:06.280Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "d873e347-82de-4d57-9393-c12513f97f44",
      "text": "người đó làm gì cũng thành công.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.329Z",
      "updatedAt": "2025-09-03T02:42:06.329Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "b73f1cf8-022d-4fe2-b7c7-5ee9787c4ca5",
      "text": "Ai muốn có bạn bè thì quên đi lầm lỗi,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.343Z",
      "updatedAt": "2025-09-03T02:42:06.343Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "76966ad9-aedf-4265-84ab-0f0d18d92c45",
      "text": "nhắc hoài chuyện cũ làm cho bạn xa mình.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.357Z",
      "updatedAt": "2025-09-03T02:42:06.357Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "2bd2d654-e89e-49eb-a7ef-774de64b0e3a",
      "text": "Trăm roi đánh người dại",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.370Z",
      "updatedAt": "2025-09-03T02:42:06.370Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "96a7e522-ebb3-4a77-b9dc-e0d5aa5faf2c",
      "text": "không bằng một lời mắng người khôn.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.414Z",
      "updatedAt": "2025-09-03T02:42:06.414Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "8a4be907-d8ff-4532-89bb-b2a4fc6465a8",
      "text": "Ác nhân chỉ mưu tìm nổi loạn,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.428Z",
      "updatedAt": "2025-09-03T02:42:06.428Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "d9843098-ce99-44b9-a60b-c71e620ef56d",
      "text": "nhưng một sứ giả dữ dằn sẽ được sai đến trừng trị nó.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.443Z",
      "updatedAt": "2025-09-03T02:42:06.443Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "6bb715f4-232b-4cce-816b-d54174b526bb",
      "text": "Gặp gấu mẹ mất con",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.456Z",
      "updatedAt": "2025-09-03T02:42:06.456Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "46d34939-2e18-4295-b464-98dbbec648db",
      "text": "còn hơn gặp người ngu lên cơn rồ dại.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.470Z",
      "updatedAt": "2025-09-03T02:42:06.470Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "9789972c-0900-4a39-8525-f74b2d70e362",
      "text": "Bất hạnh sẽ không chịu rời bỏ,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.484Z",
      "updatedAt": "2025-09-03T02:42:06.484Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "5fe3d3ee-014f-4a45-8a6c-ea17604a2a21",
      "text": "nhà kẻ nào lấy oán đền ơn.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.499Z",
      "updatedAt": "2025-09-03T02:42:06.499Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "b1d44637-5823-40cd-92e0-29bbcf5820f2",
      "text": "Bắt đầu cãi cọ là như để cho nước vỡ bờ,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.512Z",
      "updatedAt": "2025-09-03T02:42:06.512Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "1e4534de-83d3-466f-af81-680ca3ab97a5",
      "text": "hãy tránh xa trước khi cuộc tranh cãi bùng nổ.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.526Z",
      "updatedAt": "2025-09-03T02:42:06.526Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "70ff385e-4330-483d-b782-f6f7fc3d65ab",
      "text": "Bênh vực đứa ác, kết tội chính nhân,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.543Z",
      "updatedAt": "2025-09-03T02:42:06.543Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "114d49db-0120-4438-b2f8-603de0a5f523",
      "text": "hai việc này đều làm ĐỨC CHÚA ghê tởm.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.571Z",
      "updatedAt": "2025-09-03T02:42:06.571Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "659d86ba-22be-4781-bb8f-5b9ffc1d0b8a",
      "text": "Để sắm được khôn ngoan, tiền bạc trong tay đứa ngu ích lợi gì,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.600Z",
      "updatedAt": "2025-09-03T02:42:06.600Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "573f1cfc-5378-408d-9998-7c980e5ea132",
      "text": "bởi vì nó quá ư đần độn ?",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.614Z",
      "updatedAt": "2025-09-03T02:42:06.614Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "c21c3a3e-b58a-4b69-b1e1-aea883e2531b",
      "text": "Bè bạn thương nhau mọi thời mọi lúc,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.628Z",
      "updatedAt": "2025-09-03T02:42:06.628Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "6dda13fb-b134-4563-9996-f5bde538822b",
      "text": "vào ngày hoạn nạn chỉ có anh em.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.656Z",
      "updatedAt": "2025-09-03T02:42:06.656Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "ae9f986a-ef37-4793-a408-67a7cc6f1285",
      "text": "Đứa ngu mới ký giao kèo,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.670Z",
      "updatedAt": "2025-09-03T02:42:06.670Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "6858b04e-2428-4fb0-93f0-8a89e6f193be",
      "text": "mới đứng ra bảo lãnh cho bè bạn.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.698Z",
      "updatedAt": "2025-09-03T02:42:06.698Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "2213b6e2-58e9-4ce7-ad8d-c9b179bf1ecb",
      "text": "Ưa cãi nhau là ưa phạm tội,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.712Z",
      "updatedAt": "2025-09-03T02:42:06.712Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "4e0b0d80-30c8-4208-9c9e-5918eb9b3503",
      "text": "tự cao tự đại là chuốc lấy suy vong.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.726Z",
      "updatedAt": "2025-09-03T02:42:06.726Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "c6dcfe88-07d5-490a-8ca7-f07d982ad17a",
      "text": "Tâm địa quanh co sao gặp được hạnh phúc,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.753Z",
      "updatedAt": "2025-09-03T02:42:06.753Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "b828d20a-a1db-4c77-b48c-6b0374cc4580",
      "text": "miệng lưỡi dối trá ắt phải chịu tai ương.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.767Z",
      "updatedAt": "2025-09-03T02:42:06.767Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "bc634e78-845b-4043-9c9b-c62ac5e9348d",
      "text": "Sinh ra đứa ngu là chuốc lấy phiền muộn,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.781Z",
      "updatedAt": "2025-09-03T02:42:06.781Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "e7d27aab-4413-422f-b629-9c57124d5504",
      "text": "làm cha kẻ dại nào vui sướng gì đâu !",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.794Z",
      "updatedAt": "2025-09-03T02:42:06.794Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "a49ec0d8-5ce6-444e-bc63-9b6d6a776f97",
      "text": "Tâm trí hân hoan làm thân xác lành mạnh,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.808Z",
      "updatedAt": "2025-09-03T02:42:06.808Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "9db00e99-f6b6-4f51-9812-c0e0975d7c2d",
      "text": "tinh thần suy sụp khiến xương cốt rã rời.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.836Z",
      "updatedAt": "2025-09-03T02:42:06.836Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "910fa36c-262e-4259-b2ca-e405ed2ac2ed",
      "text": "Ác nhân nhận quà được giấu trong ngực áo,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.863Z",
      "updatedAt": "2025-09-03T02:42:06.863Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "bd7dc71d-ff04-4659-9bc8-05cfcfd9873a",
      "text": "khiến cán cân công lý bị bẻ cong.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.877Z",
      "updatedAt": "2025-09-03T02:42:06.877Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "403b609d-87b9-4e12-bee9-5fc76c8d9789",
      "text": "Người hiểu biết chỉ nhắm đến khôn ngoan,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.891Z",
      "updatedAt": "2025-09-03T02:42:06.891Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "c96bf086-8571-4c4b-b69f-9250ceba88ff",
      "text": "còn người ngu để mắt khắp cùng trời cuối đất.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.905Z",
      "updatedAt": "2025-09-03T02:42:06.905Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "bb74bc31-04cd-4487-b71d-6355a5c57c6a",
      "text": "Con ngu khiến cha buồn giận,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.934Z",
      "updatedAt": "2025-09-03T02:42:06.934Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "b57bb1b5-a409-402c-8cdc-99c79502b54d",
      "text": "con dại làm mẹ đắng cay.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.962Z",
      "updatedAt": "2025-09-03T02:42:06.962Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "94a28a02-7132-4400-8fce-ce39ef90c579",
      "text": "Phạt vạ chính nhân thì không phải lẽ,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.975Z",
      "updatedAt": "2025-09-03T02:42:06.975Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "f6728b1d-8f8e-4f27-9881-3a94ce173dda",
      "text": "đánh người khả kính là ngược với công bằng.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:06.990Z",
      "updatedAt": "2025-09-03T02:42:06.990Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "e6109108-0770-4973-940f-929087002561",
      "text": "Người nói năng dè dặt là người hiểu biết,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:07.004Z",
      "updatedAt": "2025-09-03T02:42:07.004Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "6f87704a-a3c8-4166-a57c-8e22cff67f74",
      "text": "kẻ giữ được điềm tĩnh là kẻ khôn ngoan.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:07.032Z",
      "updatedAt": "2025-09-03T02:42:07.032Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "241cdd4f-c10c-4d82-a907-07c75a599f8f",
      "text": "Nếu biết giữ thinh lặng,",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:07.046Z",
      "updatedAt": "2025-09-03T02:42:07.046Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "9459f9db-3cd9-40d1-8208-40779e6619a9",
      "text": "kẻ ngu cũng được kể là người khôn ngoan ;",
      "label": "28",
      "number": 28,
      "subVerseIndex": 1,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:07.073Z",
      "updatedAt": "2025-09-03T02:42:07.073Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "3b163fa2-9ec2-4953-8526-142984f9ba33",
      "text": "nếu biết ngậm môi,",
      "label": "28",
      "number": 28,
      "subVerseIndex": 2,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:07.087Z",
      "updatedAt": "2025-09-03T02:42:07.087Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    },
    {
      "id": "06b42d42-6368-427e-9450-ae7fa78cb5d4",
      "text": "kẻ đó được coi là người thông hiểu.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 3,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:07.101Z",
      "updatedAt": "2025-09-03T02:42:07.101Z",
      "chapterId": "98d21b9e-13d5-4908-89c0-94c4f611df54"
    }
  ],
