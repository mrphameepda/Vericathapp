{
  "chapter": {
    "id": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45",
    "number": 18,
    "createdAt": "2025-09-03T01:07:51.667Z",
    "updatedAt": "2025-09-03T01:07:51.667Z",
    "bookId": "1ea97633-82d8-4f1a-bffc-dfb2da235911"
  },
  "verses": [
    {
      "id": "5390fe83-fe6a-447f-a889-617538a4407e",
      "text": "Kẻ ích kỷ chạy theo dục vọng,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.018Z",
      "updatedAt": "2025-09-03T02:42:12.018Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "f01551f9-a00a-4a2d-b9b3-afc7e48a2103",
      "text": "và nổi giận trước mọi lời khuyên.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.053Z",
      "updatedAt": "2025-09-03T02:42:12.053Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "3efe3bf5-4d34-4cb0-9b0c-a35dc780041e",
      "text": "Người ngu không ưa chuyện hiểu biết,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.063Z",
      "updatedAt": "2025-09-03T02:42:12.063Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "e9142aab-3005-4db9-9b7f-772f92369dad",
      "text": "nhưng thích phô bày cảm nghĩ riêng.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.076Z",
      "updatedAt": "2025-09-03T02:42:12.076Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "8d737a93-0122-45f6-9a2c-b937c7e59cce",
      "text": "Đâu có kẻ ác, đấy có khinh khi,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.088Z",
      "updatedAt": "2025-09-03T02:42:12.088Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "e0cd89b4-91ad-4883-882e-51cee0be0aee",
      "text": "đâu có nhục nhã, đấy có lăng mạ.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.099Z",
      "updatedAt": "2025-09-03T02:42:12.099Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "5802b459-d58e-47d2-a6c5-70b974009ab8",
      "text": "Lời miệng con người là nước sâu thăm thẳm,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.110Z",
      "updatedAt": "2025-09-03T02:42:12.110Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "9e701461-e3e1-4d12-a6c3-41c570749633",
      "text": "là dòng suối tràn trề, là nguồn mạch khôn ngoan.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.122Z",
      "updatedAt": "2025-09-03T02:42:12.122Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "0683e2c0-cab2-4b5d-a8d5-4b5ce83530e6",
      "text": "Bênh vực kẻ gian ác, đè nén người vô tội,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.150Z",
      "updatedAt": "2025-09-03T02:42:12.150Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "c0f7454c-2d10-47cb-a9bd-68452ddd3971",
      "text": "xét xử như thế chẳng tốt đẹp gì.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.164Z",
      "updatedAt": "2025-09-03T02:42:12.164Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "eb1cb6b8-bf63-4a11-8a06-2e44ef16f605",
      "text": "Môi người ngu gây ra tranh cãi,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.179Z",
      "updatedAt": "2025-09-03T02:42:12.179Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "223ae690-8f03-4857-b97d-c583c33e7d44",
      "text": "miệng của nó khiến nó chịu đòn.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.192Z",
      "updatedAt": "2025-09-03T02:42:12.192Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "aec1d836-36bd-4234-8607-4c72c98de195",
      "text": "Miệng kẻ ngu làm cho nó tàn tạ,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.206Z",
      "updatedAt": "2025-09-03T02:42:12.206Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "4a722654-19da-451d-9db7-699e700c46e4",
      "text": "môi của nó là cạm bẫy cho mình.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.234Z",
      "updatedAt": "2025-09-03T02:42:12.234Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "bb25cc47-55ec-4b56-a8cf-ec35e3c8aaf2",
      "text": "Lời kẻ mách lẻo như của ngon vật lạ",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.248Z",
      "updatedAt": "2025-09-03T02:42:12.248Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "86baa936-c749-43c2-8850-6a414f847e7a",
      "text": "trôi xuống tận ruột gan.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.276Z",
      "updatedAt": "2025-09-03T02:42:12.276Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "06b5b4a1-503a-42d7-a3bc-3422d92ef5b3",
      "text": "Người biếng nhác việc bổn phận mình",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.293Z",
      "updatedAt": "2025-09-03T02:42:12.293Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "d79d5bfe-1893-4bd7-ac96-dd5466a013e0",
      "text": "là anh em với quân phá hoại.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.321Z",
      "updatedAt": "2025-09-03T02:42:12.321Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "a115a939-0b1f-40c4-af20-7fb76629d8a3",
      "text": "Danh ĐỨC CHÚA là tháp canh kiên vững,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.336Z",
      "updatedAt": "2025-09-03T02:42:12.336Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "12dcc625-5079-4c5b-ad7e-610289fe58f7",
      "text": "chính nhân chạy đến là được an toàn.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.379Z",
      "updatedAt": "2025-09-03T02:42:12.379Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "0ce53d02-de03-42b7-8041-8e9b06f7378c",
      "text": "Người giàu coi của cải là thành trì kiên cố,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.393Z",
      "updatedAt": "2025-09-03T02:42:12.393Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "6261d293-9011-4d76-8c39-87768c33ff58",
      "text": "họ cho đó là tường cao luỹ dầy.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.417Z",
      "updatedAt": "2025-09-03T02:42:12.417Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "efc0f6ca-f61d-4d5a-aee0-99f061c075c3",
      "text": "Lòng tự cao dẫn đến suy sụp,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.429Z",
      "updatedAt": "2025-09-03T02:42:12.429Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "1de73ff0-98c4-4019-b1d9-f9c5dcb450d2",
      "text": "đức khiêm tốn đem lại vinh quang.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.451Z",
      "updatedAt": "2025-09-03T02:42:12.451Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "98cfafe9-1ca9-4626-93cb-0ea3dd7ea204",
      "text": "Kẻ chưa nghe đã vội cãi,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.467Z",
      "updatedAt": "2025-09-03T02:42:12.467Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "37ac6c62-b7f9-4ce1-8a7a-65a84c70a883",
      "text": "sẽ chịu tiếng nhục nhã, ngu si.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.495Z",
      "updatedAt": "2025-09-03T02:42:12.495Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "f3fa3e61-adb5-47c9-a1d0-b18f4d3c316d",
      "text": "Người đau yếu được tinh thần nâng đỡ,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.508Z",
      "updatedAt": "2025-09-03T02:42:12.508Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "498d41dd-5668-46f6-bf35-2bf1735b85ed",
      "text": "nhưng tinh thần suy sụp thì lấy ai vực lên ?",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.522Z",
      "updatedAt": "2025-09-03T02:42:12.522Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "6340da46-4106-47c2-8933-59e6ccc34694",
      "text": "Trí người minh mẫn tiếp thu hiểu biết,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.536Z",
      "updatedAt": "2025-09-03T02:42:12.536Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "fad0a485-6852-47c2-a0a7-88e65e291328",
      "text": "tri thức là điều tai kẻ khôn kiếm tìm.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.567Z",
      "updatedAt": "2025-09-03T02:42:12.567Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "6a72e360-8695-45b8-bba0-3bad592e21a3",
      "text": "Ai có quà biếu sẽ rộng đường lui tới,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.581Z",
      "updatedAt": "2025-09-03T02:42:12.581Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "b1540788-9dc1-4247-95bf-556238abda23",
      "text": "sẽ gặp được người chức trọng quyền cao.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.595Z",
      "updatedAt": "2025-09-03T02:42:12.595Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "a7b8b8ff-c95a-4235-830f-23d4b38d682d",
      "text": "Kẻ nói trước cứ biện hộ cho mình là đúng,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.609Z",
      "updatedAt": "2025-09-03T02:42:12.609Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "3546244b-ccf1-409e-905f-ccc2121a4575",
      "text": "nhưng đối phương đến, sẽ lột mặt nạ y.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.623Z",
      "updatedAt": "2025-09-03T02:42:12.623Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "62348a19-a95c-4f8a-9cb1-2976c0090ea6",
      "text": "Quẻ gieo chấm dứt các vụ tương tranh",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.637Z",
      "updatedAt": "2025-09-03T02:42:12.637Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "65795892-d222-43f8-b95c-ebb695c73485",
      "text": "và phân định quyền lợi giữa những người quyền thế.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.651Z",
      "updatedAt": "2025-09-03T02:42:12.651Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "ae3952f0-f8d0-4249-be08-264eddc7be94",
      "text": "Một người anh em bị xúc phạm",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.665Z",
      "updatedAt": "2025-09-03T02:42:12.665Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "e080d9e3-d6d2-4676-bdec-f6d1385b4dcd",
      "text": "thì còn hơn một thành trì vững chắc.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.678Z",
      "updatedAt": "2025-09-03T02:42:12.678Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "509841e9-2157-4246-9d96-a12b46d43219",
      "text": "Các cuộc cãi vã tựa như then cài cửa luỹ đồn.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 2,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.706Z",
      "updatedAt": "2025-09-03T02:42:12.706Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "c2281337-e2ca-42e4-8b2a-e00978b70019",
      "text": "Con người phải chịu hậu quả lời mình nói",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.720Z",
      "updatedAt": "2025-09-03T02:42:12.720Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "0db75ecc-e875-432d-9262-015d933fe451",
      "text": "và được hưởng những gì môi miệng họ thốt ra.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.755Z",
      "updatedAt": "2025-09-03T02:42:12.755Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "2fb40c9c-d11d-446c-92e1-75fe268ecbe9",
      "text": "Sống hay chết đều do cái lưỡi,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.783Z",
      "updatedAt": "2025-09-03T02:42:12.783Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "a448792d-1188-4210-807d-6074791a7b9f",
      "text": "ai yêu chuộng nó, sẽ lãnh nhận hậu quả.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.797Z",
      "updatedAt": "2025-09-03T02:42:12.797Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "ff4b16bf-9e39-43f0-9fd5-1e74b0d5217f",
      "text": "Tìm được vợ hiền là tìm thấy hạnh phúc,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.824Z",
      "updatedAt": "2025-09-03T02:42:12.824Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "b9933f28-3681-4f68-b951-6adc7b87549b",
      "text": "và nhận được ơn ĐỨC CHÚA ban cho.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.852Z",
      "updatedAt": "2025-09-03T02:42:12.852Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "54659652-a897-4d58-8f95-8e5dcad29c70",
      "text": "Người nghèo khẩn khoản nài xin,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.881Z",
      "updatedAt": "2025-09-03T02:42:12.881Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "897e79a0-421c-4a00-9d50-b3a416b363dc",
      "text": "người giàu trả lời hống hách.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.897Z",
      "updatedAt": "2025-09-03T02:42:12.897Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "dbf5927f-03ae-486e-83ee-8dd0934458b4",
      "text": "Có thứ bạn bè gây ra tai hoạ,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.914Z",
      "updatedAt": "2025-09-03T02:42:12.914Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    },
    {
      "id": "fd8c72cb-0318-4dcf-b240-0c37c9e96483",
      "text": "có người thân hữu gắn bó hơn cả anh em.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:12.957Z",
      "updatedAt": "2025-09-03T02:42:12.957Z",
      "chapterId": "02b1fc46-c6a2-4868-9b5c-a8849cee3b45"
    }
  ],
