{
  "chapter": {
    "id": "ed23ffb6-b44e-40d6-9478-da45ff372f2b",
    "number": 19,
    "createdAt": "2025-09-03T01:07:51.667Z",
    "updatedAt": "2025-09-03T01:07:51.667Z",
    "bookId": "1ea97633-82d8-4f1a-bffc-dfb2da235911"
  },
  "verses": [
    {
      "id": "ffb4d6ad-e4fa-4928-a368-b030c91c6a2e",
      "text": "Thà nghèo túng mà sống vẹn toàn,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:17.822Z",
      "updatedAt": "2025-09-03T02:42:17.822Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "38f7a91e-a57a-4bfd-b904-b7fde54f593c",
      "text": "còn hơn điêu ngoa mà ngu ngốc.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:17.850Z",
      "updatedAt": "2025-09-03T02:42:17.850Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "3528c091-3996-4211-b694-657d82c1913a",
      "text": "Nhiệt tình mà thiếu suy xét nào có ích chi,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:17.860Z",
      "updatedAt": "2025-09-03T02:42:17.860Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "15bf0936-3c3b-46fa-a0ae-532720adee94",
      "text": "bước vội vàng ắt có khi lầm lỡ.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:17.871Z",
      "updatedAt": "2025-09-03T02:42:17.871Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "7b12a711-4dc1-4f48-bb60-1326ff006063",
      "text": "Kẻ ngu dại làm hại đời mình,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:17.882Z",
      "updatedAt": "2025-09-03T02:42:17.882Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "3d1ff301-7e63-4de1-bd8b-fee6d431a7dc",
      "text": "nhưng lòng nó lại căm ĐỨC CHÚA.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:17.894Z",
      "updatedAt": "2025-09-03T02:42:17.894Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "754c65cc-a978-464a-8dfa-2506efe891a5",
      "text": "Người lắm của được thêm nhiều bạn,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:17.920Z",
      "updatedAt": "2025-09-03T02:42:17.920Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "9ef4e9f2-8d64-4919-bf9e-13fc8f0551c5",
      "text": "còn kẻ nghèo bị bạn hữu lánh xa.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:17.948Z",
      "updatedAt": "2025-09-03T02:42:17.948Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "fbfadd92-3851-4b83-8973-b4fbd7cc6647",
      "text": "Kẻ làm chứng gian không thoát khỏi hình phạt,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:17.962Z",
      "updatedAt": "2025-09-03T02:42:17.962Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "0ff7d893-9e30-4973-94db-e372b29c61d1",
      "text": "người nói năng dối trá sẽ chẳng được yên hàn.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:17.990Z",
      "updatedAt": "2025-09-03T02:42:17.990Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "43bd7db6-7545-421c-93f1-653b5c89a03c",
      "text": "Lắm kẻ tâng bốc người hào phóng,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.003Z",
      "updatedAt": "2025-09-03T02:42:18.003Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "9a68ab48-d8c7-4b3d-98c7-4ea437e15022",
      "text": "ai cũng làm bạn với kẻ cho quà.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.031Z",
      "updatedAt": "2025-09-03T02:42:18.031Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "557268a6-9879-4992-9f67-960bfdc51bee",
      "text": "Kẻ nghèo túng bị mọi anh em khinh rẻ,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.062Z",
      "updatedAt": "2025-09-03T02:42:18.062Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "1c99f92b-b36e-4443-a66b-0a1d9a556347",
      "text": "bạn hữu lại càng lánh xa !",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.076Z",
      "updatedAt": "2025-09-03T02:42:18.076Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "98d343a1-494c-4876-9bea-642a742b84e3",
      "text": "Mong được đôi lời, cũng chẳng có.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.090Z",
      "updatedAt": "2025-09-03T02:42:18.090Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "1ada8a54-9bcb-4948-b91c-d034ca25f97d",
      "text": "Ai có óc hiểu biết thì yêu bản thân mình,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.118Z",
      "updatedAt": "2025-09-03T02:42:18.118Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "0523d190-1f50-46f1-a9cb-5c1983392bbd",
      "text": "ai giữ được sáng suốt thì tìm ra hạnh phúc.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.132Z",
      "updatedAt": "2025-09-03T02:42:18.132Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "49721c84-c810-49b8-a470-f8e7b71244df",
      "text": "Kẻ làm chứng gian không thoát khỏi hình phạt,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.146Z",
      "updatedAt": "2025-09-03T02:42:18.146Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "2d37a6bc-5c6d-49f1-80b6-e4810e82573a",
      "text": "người nói năng dối trá sẽ phải mạng vong.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.173Z",
      "updatedAt": "2025-09-03T02:42:18.173Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "abacd8f0-0ffd-4875-b15c-cd619cbab99f",
      "text": "Người ngu không hợp với nếp sống phong lưu,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.201Z",
      "updatedAt": "2025-09-03T02:42:18.201Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "67484f23-de56-4b3a-bdb8-7fc5af3faaa4",
      "text": "người nô lệ càng không thể điều khiển hàng thủ lãnh.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.229Z",
      "updatedAt": "2025-09-03T02:42:18.229Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "90c89829-44fd-49cd-9ee3-730c55b49ff6",
      "text": "Hiểu biết làm con người chậm giận,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.257Z",
      "updatedAt": "2025-09-03T02:42:18.257Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "034a75b7-9e3b-4c99-abba-bfb031e037d4",
      "text": "bỏ qua lời xúc phạm khiến con người được tôn vinh.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.271Z",
      "updatedAt": "2025-09-03T02:42:18.271Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "741e9db1-596c-464b-acde-2a9a8ef80fbe",
      "text": "Cơn giận của vua như tiếng gầm sư tử,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.286Z",
      "updatedAt": "2025-09-03T02:42:18.286Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "0f28f3fd-ad8e-4fb6-8c99-b562a5ae0a1c",
      "text": "ân lộc vua ban tựa mưa móc trên cỏ xanh.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.313Z",
      "updatedAt": "2025-09-03T02:42:18.313Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "bd981c8b-17b0-488b-99a3-b5aba839b65a",
      "text": "Con ngu là mối hoạ cho cha,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.328Z",
      "updatedAt": "2025-09-03T02:42:18.328Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "43271272-680d-43f8-9580-2e0022e63027",
      "text": "vợ lắm điều như mái nhà dột.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.342Z",
      "updatedAt": "2025-09-03T02:42:18.342Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "421cc18b-443a-47ad-abfc-665d177aa269",
      "text": "Cửa nhà, tài sản là gia nghiệp của cha ông,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.384Z",
      "updatedAt": "2025-09-03T02:42:18.384Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "abaf6494-f3f7-4148-9f0f-547e61039659",
      "text": "còn người vợ khôn ngoan là do ĐỨC CHÚA.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.412Z",
      "updatedAt": "2025-09-03T02:42:18.412Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "7b79cac1-acdd-4a61-8a4a-478318fda8f2",
      "text": "Thói lười biếng làm con người ngủ mê,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.434Z",
      "updatedAt": "2025-09-03T02:42:18.434Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "e32560eb-56fb-49e9-b35b-13198be41bf5",
      "text": "kẻ biếng nhác sẽ phải nhịn đói.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.445Z",
      "updatedAt": "2025-09-03T02:42:18.445Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "faa2c6b9-eb07-4812-92eb-1680765996d6",
      "text": "Tuân giữ lệnh truyền là giữ được mạng sống,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.456Z",
      "updatedAt": "2025-09-03T02:42:18.456Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "fe9a63b8-f9a2-42e6-9ca8-b7959ad0672e",
      "text": "khinh thường đường lối Chúa ắt phải mạng vong.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.467Z",
      "updatedAt": "2025-09-03T02:42:18.467Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "2de8c36f-24cd-4530-ad46-47d2ece063fb",
      "text": "Thương xót kẻ khó nghèo là cho ĐỨC CHÚA vay mượn,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.480Z",
      "updatedAt": "2025-09-03T02:42:18.480Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "a46bec7a-020c-4dd7-b677-52399bf31575",
      "text": "Người sẽ đáp trả xứng việc đã làm.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.508Z",
      "updatedAt": "2025-09-03T02:42:18.508Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "370f6883-e359-41cd-8471-0312c2d413d4",
      "text": "Hãy sửa phạt con cái bao lâu còn hy vọng,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.523Z",
      "updatedAt": "2025-09-03T02:42:18.523Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "7ac1e0be-59ca-4060-bb39-2283b75c6ad9",
      "text": "nhưng đừng nóng nảy khiến nó phải chết.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.550Z",
      "updatedAt": "2025-09-03T02:42:18.550Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "44bee17d-02d7-47d3-ac69-b497d5fa8cec",
      "text": "Người giận dữ hung hăng sẽ phải nộp phạt,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.579Z",
      "updatedAt": "2025-09-03T02:42:18.579Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "33a9b8ca-5b3c-40f0-aba0-633d4ec8e83c",
      "text": "nếu cứu nó, bạn chỉ làm tăng sự ác mà thôi.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.593Z",
      "updatedAt": "2025-09-03T02:42:18.593Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "86e847ba-6b9d-430e-8ba7-2423bb2ba3da",
      "text": "Hãy lắng nghe lời khuyên, đón nhận lời nghiêm huấn,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.623Z",
      "updatedAt": "2025-09-03T02:42:18.623Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "63dbbacc-e679-48bf-8b25-cfca56fdacef",
      "text": "để sau này bạn được nên khôn.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.652Z",
      "updatedAt": "2025-09-03T02:42:18.652Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "c25ef152-9874-4f22-b56c-3cf28b5cd3ce",
      "text": "Lòng con người ấp ủ bao dự tính,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.666Z",
      "updatedAt": "2025-09-03T02:42:18.666Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "fa78b9f7-30bd-4a51-99d3-3b31c24ccca9",
      "text": "duy kế hoạch của ĐỨC CHÚA mới trường tồn.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.694Z",
      "updatedAt": "2025-09-03T02:42:18.694Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "edb30c97-685a-4c7f-ad00-dcb8ea17783f",
      "text": "Con người ao ước lòng nhân nghĩa,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.722Z",
      "updatedAt": "2025-09-03T02:42:18.722Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "103c0474-8b24-4453-85b4-6653d7de04ca",
      "text": "thà là kẻ nghèo khó còn hơn là đứa dối gian.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.747Z",
      "updatedAt": "2025-09-03T02:42:18.747Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "220de25a-bcc2-4cbf-98f9-b6a8adf1d1f2",
      "text": "Lòng kính sợ ĐỨC CHÚA đem lại sự sống,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.759Z",
      "updatedAt": "2025-09-03T02:42:18.759Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "350b8379-ad7c-423a-b2b2-930d91862ef8",
      "text": "cho người ta ăn no ngủ kỹ, thoát khỏi mọi tai ương.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.799Z",
      "updatedAt": "2025-09-03T02:42:18.799Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "b4651bc0-f4d0-4eba-8cd9-ddd99ba3b8f9",
      "text": "Đứa lười biếng thò tay vào đĩa,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.813Z",
      "updatedAt": "2025-09-03T02:42:18.813Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "e1a0b207-5a24-4c1b-bc93-ee4101bdce10",
      "text": "nhưng chẳng buồn đưa thức ăn lên miệng.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.841Z",
      "updatedAt": "2025-09-03T02:42:18.841Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "8bd0d703-84bb-4b3e-a35b-e7d085ae5d64",
      "text": "Hãy đánh người ưa chế giễu,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.855Z",
      "updatedAt": "2025-09-03T02:42:18.855Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "20eaad85-2edb-47c4-b340-504105b20b3e",
      "text": "ắt kẻ ngây thơ sẽ nên lanh lợi ;",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.883Z",
      "updatedAt": "2025-09-03T02:42:18.883Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "faee1b0e-2117-45b9-b69e-26cc93bc9a36",
      "text": "hãy quở mắng người khôn,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 2,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.911Z",
      "updatedAt": "2025-09-03T02:42:18.911Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "a0239950-5a46-499b-803b-24e5512c12e9",
      "text": "người ấy sẽ thêm hiểu biết.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 3,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.925Z",
      "updatedAt": "2025-09-03T02:42:18.925Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "9694ba5b-4235-4295-96d0-11502650d525",
      "text": "Kẻ bạc đãi cha và xua đuổi mẹ,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.939Z",
      "updatedAt": "2025-09-03T02:42:18.939Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "d15bcbb8-949a-43a6-b70e-5a200768f024",
      "text": "là đứa con đốn mạt, nhuốc nhơ.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.967Z",
      "updatedAt": "2025-09-03T02:42:18.967Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "e7bacda5-09ef-4e0f-9ec1-5992d66c21e6",
      "text": "Này con, nếu thôi không nghe lời nghiêm huấn,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:18.988Z",
      "updatedAt": "2025-09-03T02:42:18.988Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "0bb71601-862b-42a9-98ff-8a023984a0f0",
      "text": "con sẽ lạc xa những lời lẽ khôn ngoan.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:19.002Z",
      "updatedAt": "2025-09-03T02:42:19.002Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "e1625c1f-e516-4f5e-908d-8071c283a9f7",
      "text": "Kẻ làm chứng gian nhạo cười công lý,",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:19.016Z",
      "updatedAt": "2025-09-03T02:42:19.016Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "debf1fa0-d7b9-4f3b-9df8-bf04edb0999a",
      "text": "miệng ác nhân ngốn ngấu chuyện gian tà.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 1,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:19.030Z",
      "updatedAt": "2025-09-03T02:42:19.030Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "7054bbc9-78f3-4c93-90b7-f562b07606a1",
      "text": "Án phạt dành sẵn cho kẻ ưa chế giễu,",
      "label": "29",
      "number": 29,
      "subVerseIndex": 0,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:19.044Z",
      "updatedAt": "2025-09-03T02:42:19.044Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    },
    {
      "id": "2dd1390a-6a5c-4acb-b3e0-c4495863dac6",
      "text": "và đòn vọt kề lưng đứa ngu si.",
      "label": "29",
      "number": 29,
      "subVerseIndex": 1,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:19.061Z",
      "updatedAt": "2025-09-03T02:42:19.061Z",
      "chapterId": "ed23ffb6-b44e-40d6-9478-da45ff372f2b"
    }
  ],
