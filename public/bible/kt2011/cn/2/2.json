{
  "chapter": {
    "id": "f88e826c-89bc-43ad-b20c-6705bbab6050",
    "number": 2,
    "createdAt": "2025-09-03T01:07:51.666Z",
    "updatedAt": "2025-09-03T01:07:51.666Z",
    "bookId": "1ea97633-82d8-4f1a-bffc-dfb2da235911"
  },
  "verses": [
    {
      "id": "e1b34665-163f-4705-8f68-b2929324d88f",
      "text": "Này con, nếu lời thầy, con luôn nhận lấy,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:29.512Z",
      "updatedAt": "2025-09-03T02:40:29.512Z",
      "chapterId": "f88e826c-89bc-43ad-b20c-6705bbab6050"
    },
    {
      "id": "d02eeb33-a135-45f6-bcec-dfbd71a9c345",
      "text": "và huấn lệnh thầy, con hằng ấp ủ,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:29.552Z",
      "updatedAt": "2025-09-03T02:40:29.552Z",
      "chapterId": "f88e826c-89bc-43ad-b20c-6705bbab6050"
    },
    {
      "id": "5b5eb64f-8b7d-4dd5-8399-e89996bf403b",
      "text": "nếu con lắng tai nghe lẽ khôn ngoan,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:29.567Z",
      "updatedAt": "2025-09-03T02:40:29.567Z",
      "chapterId": "f88e826c-89bc-43ad-b20c-6705bbab6050"
    },
    {
      "id": "9500582b-7e8f-4b1d-8977-e0e75f1427b7",
      "text": "và hướng lòng theo sự hiểu biết,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:29.578Z",
      "updatedAt": "2025-09-03T02:40:29.578Z",
      "chapterId": "f88e826c-89bc-43ad-b20c-6705bbab6050"
    },
    {
      "id": "32abdf29-8f11-43d0-8916-0261c5c9ddf5",
      "text": "phải, nếu con cầu xin trí thông minh, van nài ơn hiểu biết,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:29.603Z",
      "updatedAt": "2025-09-03T02:40:29.603Z",
      "chapterId": "f88e826c-89bc-43ad-b20c-6705bbab6050"
    },
    {
      "id": "f15b30c9-8ed7-48d2-9446-e26e20bd2a11",
      "text": "nếu con tìm khôn ngoan như tìm bạc,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:29.630Z",
      "updatedAt": "2025-09-03T02:40:29.630Z",
      "chapterId": "f88e826c-89bc-43ad-b20c-6705bbab6050"
    },
    {
      "id": "776eee53-7ec2-4e97-8f60-74a4885ebd5e",
      "text": "và lùng kiếm như thể kho tàng,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:29.659Z",
      "updatedAt": "2025-09-03T02:40:29.659Z",
      "chapterId": "f88e826c-89bc-43ad-b20c-6705bbab6050"
    },
    {
      "id": "d3c34d6c-25db-4d0d-8e40-2eab251f25cf",
      "text": "thì lúc đó con sẽ hiểu thế nào là kính sợ ĐỨC CHÚA,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:29.673Z",
      "updatedAt": "2025-09-03T02:40:29.673Z",
      "chapterId": "f88e826c-89bc-43ad-b20c-6705bbab6050"
    },
    {
      "id": "0fe67f54-410e-4c6c-9cc8-287c1da8e6d4",
      "text": "và sẽ khám phá ra hiểu biết Thiên Chúa có nghĩa là gì.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:29.715Z",
      "updatedAt": "2025-09-03T02:40:29.715Z",
      "chapterId": "f88e826c-89bc-43ad-b20c-6705bbab6050"
    },
    {
      "id": "3c71f072-bf04-4bd8-86a1-dd8259af131e",
      "text": "Vì chính ĐỨC CHÚA ban tặng khôn ngoan ;",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:29.728Z",
      "updatedAt": "2025-09-03T02:40:29.728Z",
      "chapterId": "f88e826c-89bc-43ad-b20c-6705bbab6050"
    },
    {
      "id": "3b87b583-86c9-4a9e-b5bd-f7946ae4e495",
      "text": "tri thức và hiểu biết là nhờ Người mà có.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:29.761Z",
      "updatedAt": "2025-09-03T02:40:29.761Z",
      "chapterId": "f88e826c-89bc-43ad-b20c-6705bbab6050"
    },
    {
      "id": "3f8dd764-f85d-4c43-a46f-fad7c5f8cf69",
      "text": "Ai ngay chính được Người trợ lực,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:29.772Z",
      "updatedAt": "2025-09-03T02:40:29.772Z",
      "chapterId": "f88e826c-89bc-43ad-b20c-6705bbab6050"
    },
    {
      "id": "34e226b9-ab28-4f74-b2b8-d07b5d04744c",
      "text": "Người thành khiên thuẫn cho kẻ sống thanh liêm,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:29.783Z",
      "updatedAt": "2025-09-03T02:40:29.783Z",
      "chapterId": "f88e826c-89bc-43ad-b20c-6705bbab6050"
    },
    {
      "id": "52225520-490a-4c66-8efa-55472cc5c7b8",
      "text": "giữ gìn đường nẻo người chính trực,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:29.794Z",
      "updatedAt": "2025-09-03T02:40:29.794Z",
      "chapterId": "f88e826c-89bc-43ad-b20c-6705bbab6050"
    },
    {
      "id": "66a78e92-5905-4eb9-8608-cf5baf727789",
      "text": "bảo vệ lối đi kẻ tín trung.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:29.807Z",
      "updatedAt": "2025-09-03T02:40:29.807Z",
      "chapterId": "f88e826c-89bc-43ad-b20c-6705bbab6050"
    },
    {
      "id": "9c5f82b7-bd69-4cc9-ba58-d9c5709bdf75",
      "text": "Bấy giờ con sẽ hiểu thế nào là công bằng,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:29.822Z",
      "updatedAt": "2025-09-03T02:40:29.822Z",
      "chapterId": "f88e826c-89bc-43ad-b20c-6705bbab6050"
    },
    {
      "id": "8654bdc7-6d36-464c-99d3-7d768d4ad37a",
      "text": "thế nào là chính trực công minh :",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:29.836Z",
      "updatedAt": "2025-09-03T02:40:29.836Z",
      "chapterId": "f88e826c-89bc-43ad-b20c-6705bbab6050"
    },
    {
      "id": "7eb1d3b8-3b87-40c6-b415-95ba7b7aceb5",
      "text": "đó là đường đưa tới hạnh phúc.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:29.850Z",
      "updatedAt": "2025-09-03T02:40:29.850Z",
      "chapterId": "f88e826c-89bc-43ad-b20c-6705bbab6050"
    },
    {
      "id": "932c94ea-974f-4e85-9c26-b54493ff1ff8",
      "text": "Vì khôn ngoan sẽ vào tận lòng con,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:29.863Z",
      "updatedAt": "2025-09-03T02:40:29.863Z",
      "chapterId": "f88e826c-89bc-43ad-b20c-6705bbab6050"
    },
    {
      "id": "0c77ad47-679f-47a7-86f6-b1f0714b6523",
      "text": "và tri thức khiến hồn con vui thú,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:29.877Z",
      "updatedAt": "2025-09-03T02:40:29.877Z",
      "chapterId": "f88e826c-89bc-43ad-b20c-6705bbab6050"
    },
    {
      "id": "0d8639a1-eeb2-4d38-924d-012fabaf1850",
      "text": "óc thận trọng sẽ giữ gìn con,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:29.892Z",
      "updatedAt": "2025-09-03T02:40:29.892Z",
      "chapterId": "f88e826c-89bc-43ad-b20c-6705bbab6050"
    },
    {
      "id": "ff8ab2cd-6752-42f1-a8aa-04f4ba45dbb7",
      "text": "trí hiểu biết sẽ như người bảo vệ,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:29.906Z",
      "updatedAt": "2025-09-03T02:40:29.906Z",
      "chapterId": "f88e826c-89bc-43ad-b20c-6705bbab6050"
    },
    {
      "id": "4dd0aeff-6939-4203-87e2-f0d24b099851",
      "text": "để giải thoát con khỏi lối sống xấu xa,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:29.919Z",
      "updatedAt": "2025-09-03T02:40:29.919Z",
      "chapterId": "f88e826c-89bc-43ad-b20c-6705bbab6050"
    },
    {
      "id": "63324343-05a0-4806-a5d0-ad7720936892",
      "text": "cứu con khỏi người nói những lời xằng bậy,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:29.933Z",
      "updatedAt": "2025-09-03T02:40:29.933Z",
      "chapterId": "f88e826c-89bc-43ad-b20c-6705bbab6050"
    },
    {
      "id": "0711b81a-5ef5-4923-9192-c7371fbbdd30",
      "text": "khỏi những kẻ bỏ đường ngay chính, đi vào nẻo tối tăm ;",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:29.947Z",
      "updatedAt": "2025-09-03T02:40:29.947Z",
      "chapterId": "f88e826c-89bc-43ad-b20c-6705bbab6050"
    },
    {
      "id": "7c575993-ff24-44d7-8718-7ec1e7e15bb6",
      "text": "chúng hả hê khi phạm điều ác,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:29.961Z",
      "updatedAt": "2025-09-03T02:40:29.961Z",
      "chapterId": "f88e826c-89bc-43ad-b20c-6705bbab6050"
    },
    {
      "id": "a7944f77-a8d1-421d-8536-966e38591fdb",
      "text": "thích thú khi làm điều tồi tệ xấu xa.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:29.989Z",
      "updatedAt": "2025-09-03T02:40:29.989Z",
      "chapterId": "f88e826c-89bc-43ad-b20c-6705bbab6050"
    },
    {
      "id": "62f1ac5f-0a59-41e7-9f42-7e31ba883aee",
      "text": "Đường chúng đầy uẩn khúc, lối chúng thật quanh co.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:30.009Z",
      "updatedAt": "2025-09-03T02:40:30.009Z",
      "chapterId": "f88e826c-89bc-43ad-b20c-6705bbab6050"
    },
    {
      "id": "81213c71-c894-47cd-ad0b-66b960ad2d61",
      "text": "Nhờ thế, con sẽ thoát khỏi người đàn bà trắc nết,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:30.023Z",
      "updatedAt": "2025-09-03T02:40:30.023Z",
      "chapterId": "f88e826c-89bc-43ad-b20c-6705bbab6050"
    },
    {
      "id": "b5569071-b097-43bc-831f-cc2daff7171e",
      "text": "khỏi người phụ nữ không quen cứ nói ngon nói ngọt.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:30.051Z",
      "updatedAt": "2025-09-03T02:40:30.051Z",
      "chapterId": "f88e826c-89bc-43ad-b20c-6705bbab6050"
    },
    {
      "id": "3bf16f3c-a373-42ac-ad51-eeb2c56360da",
      "text": "Người bạn đường thời son trẻ, ả đã bỏ rơi,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:30.079Z",
      "updatedAt": "2025-09-03T02:40:30.079Z",
      "chapterId": "f88e826c-89bc-43ad-b20c-6705bbab6050"
    },
    {
      "id": "c90adb8a-977d-4b61-ac26-e06df6e6e957",
      "text": "giao ước của Thiên Chúa, ả hằng quên lãng.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:30.092Z",
      "updatedAt": "2025-09-03T02:40:30.092Z",
      "chapterId": "f88e826c-89bc-43ad-b20c-6705bbab6050"
    },
    {
      "id": "12b6168e-24a3-48ae-8fe2-af6ef84fb4d0",
      "text": "Nhà nó ở nghiêng về cõi chết,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:30.120Z",
      "updatedAt": "2025-09-03T02:40:30.120Z",
      "chapterId": "f88e826c-89bc-43ad-b20c-6705bbab6050"
    },
    {
      "id": "62258540-aa94-4745-ae6c-1b7b063f5f66",
      "text": "lối nó đi, dẫn tới các âm hồn.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:30.134Z",
      "updatedAt": "2025-09-03T02:40:30.134Z",
      "chapterId": "f88e826c-89bc-43ad-b20c-6705bbab6050"
    },
    {
      "id": "6bec370a-8d94-46f1-a3c3-2eeae234e82a",
      "text": "Kẻ theo nó rồi, không hề trở lại,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:30.162Z",
      "updatedAt": "2025-09-03T02:40:30.162Z",
      "chapterId": "f88e826c-89bc-43ad-b20c-6705bbab6050"
    },
    {
      "id": "a4ddc7f7-52fd-4029-b2b8-cad6699f73f6",
      "text": "chẳng ai tìm được đường về cõi sống.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:30.176Z",
      "updatedAt": "2025-09-03T02:40:30.176Z",
      "chapterId": "f88e826c-89bc-43ad-b20c-6705bbab6050"
    },
    {
      "id": "cfbfb0eb-7ca0-47fe-a54c-ff37f801c1e8",
      "text": "Như thế con sẽ bước đi trên đường người lương thiện,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:30.189Z",
      "updatedAt": "2025-09-03T02:40:30.189Z",
      "chapterId": "f88e826c-89bc-43ad-b20c-6705bbab6050"
    },
    {
      "id": "10e11c65-472e-4345-b330-ff41d418022a",
      "text": "và dõi theo lối của chính nhân.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:30.203Z",
      "updatedAt": "2025-09-03T02:40:30.203Z",
      "chapterId": "f88e826c-89bc-43ad-b20c-6705bbab6050"
    },
    {
      "id": "fd607946-d358-4bcc-a077-319f7d2b7c4c",
      "text": "Vì người ngay thẳng sẽ được an cư trong đất nước,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:30.217Z",
      "updatedAt": "2025-09-03T02:40:30.217Z",
      "chapterId": "f88e826c-89bc-43ad-b20c-6705bbab6050"
    },
    {
      "id": "5d1fb5f8-9a98-4f17-b0e3-5501e50bac49",
      "text": "người hoàn thiện sẽ lưu lại nơi đây.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:30.245Z",
      "updatedAt": "2025-09-03T02:40:30.245Z",
      "chapterId": "f88e826c-89bc-43ad-b20c-6705bbab6050"
    },
    {
      "id": "ae7718b4-0a5a-4039-9d30-c5ffb98db2eb",
      "text": "Còn ác nhân sẽ phải xa lìa quê cha đất tổ,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:30.256Z",
      "updatedAt": "2025-09-03T02:40:30.256Z",
      "chapterId": "f88e826c-89bc-43ad-b20c-6705bbab6050"
    },
    {
      "id": "17b97850-317e-4831-9aab-67be46ed812c",
      "text": "phường bất trung sẽ bị trục xuất khỏi quê hương.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:30.267Z",
      "updatedAt": "2025-09-03T02:40:30.267Z",
      "chapterId": "f88e826c-89bc-43ad-b20c-6705bbab6050"
    }
  ],
  "marks": [
    {
      "id": "eb7bf130-7b2f-4c02-b3d3-28a5b28a0b3b",
      "content": "Qua bài huấn dụ thứ hai này (cc. 1-22), vị thầy dạy cho cậu học trò ngoan về những phúc lành do khôn ngoan ban tặng. Cấu trúc của bài này như sau : Các phúc lành của khôn ngoan (cc. 1-11) ; cảnh giác trước người đàn ông xấu xa (cc. 12-15) ; cảnh giác trước người đàn bà trắc nết (cc. 16-19) ; nhắc lại lời hứa ban phúc lành (cc. 20-22). Huấn dụ này có nét của Đệ nhị luật và các Thánh vịnh, đặc biệt trong sự tương phản giữa hai con đường của kẻ xấu và người chính trực (Đnl 4,11 ; Tv 1).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 38,
      "endOffset": 38,
      "createdAt": "2025-09-03T02:40:29.542Z",
