{
  "chapter": {
    "id": "e24d2494-d1e2-4212-90d8-76da18914c1a",
    "number": 20,
    "createdAt": "2025-09-03T01:07:51.667Z",
    "updatedAt": "2025-09-03T01:07:51.667Z",
    "bookId": "1ea97633-82d8-4f1a-bffc-dfb2da235911"
  },
  "verses": [
    {
      "id": "3dea0c86-256c-4020-8f39-051a6a5f33c5",
      "text": "Rượu nồng sinh nhạo báng, men say tạo ồn ào,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:24.440Z",
      "updatedAt": "2025-09-03T02:42:24.440Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "49470914-72f9-44ca-b5a7-a06a568c2f35",
      "text": "kẻ nào vướng vào đó, đâu còn là người khôn.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:24.469Z",
      "updatedAt": "2025-09-03T02:42:24.469Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "9b72b22b-42d1-49a2-ad72-efa4a1b03ac8",
      "text": "Cơn thịnh nộ của vua như tiếng gầm sư tử,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:24.491Z",
      "updatedAt": "2025-09-03T02:42:24.491Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "b064c8ce-5e3e-4dd2-aae2-c7ea05183860",
      "text": "kẻ làm vua nổi giận là làm hại chính mình.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:24.528Z",
      "updatedAt": "2025-09-03T02:42:24.528Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "619e13d9-f2a1-4d4e-848a-6d7d9da47f76",
      "text": "Tránh đôi co đem lại vinh dự cho con người,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:24.542Z",
      "updatedAt": "2025-09-03T02:42:24.542Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "c163c6d6-e9fd-4b05-9cd7-f0e495ac6cfa",
      "text": "mọi kẻ ngu đều hay sinh sự.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:24.556Z",
      "updatedAt": "2025-09-03T02:42:24.556Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "226e4fae-cee0-45be-b668-d036c1ff81db",
      "text": "Đầu mùa đông, kẻ lười không lo cày cấy,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:24.571Z",
      "updatedAt": "2025-09-03T02:42:24.571Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "c62379b4-2409-483b-ba90-d1ad48a054cb",
      "text": "đến mùa gặt, nó tìm kiếm cũng uổng công.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:24.599Z",
      "updatedAt": "2025-09-03T02:42:24.599Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "c2a76159-69e0-4197-acad-1365152bc2e3",
      "text": "Ý định lòng người tựa nước sâu thăm thẳm,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:24.627Z",
      "updatedAt": "2025-09-03T02:42:24.627Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "68cbf613-5728-4005-9cb5-d18f042587ee",
      "text": "người hiểu biết mới kín múc được.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:24.656Z",
      "updatedAt": "2025-09-03T02:42:24.656Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "5ea4cb3e-0e9a-41c3-bd27-eee645be42b8",
      "text": "Lắm kẻ tự hào mình nhân nghĩa,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:24.669Z",
      "updatedAt": "2025-09-03T02:42:24.669Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "9b6cbb05-c4e5-4c5b-a547-48aeaefeacd9",
      "text": "nhưng người thành tín, nào ai kiếm cho ra ?",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:24.683Z",
      "updatedAt": "2025-09-03T02:42:24.683Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "117bb783-6744-4bde-b689-5325b4cdcc5f",
      "text": "Người công chính ăn ở đức độ,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:24.698Z",
      "updatedAt": "2025-09-03T02:42:24.698Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "523cc017-958f-4695-afa5-fe6ce8b7feb0",
      "text": "phúc cho đàn con nối dõi tông đường !",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:24.712Z",
      "updatedAt": "2025-09-03T02:42:24.712Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "2d0c6057-42d7-407f-a77e-ef096fbf9187",
      "text": "Đức vua ngự trên ngai xét xử,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:24.726Z",
      "updatedAt": "2025-09-03T02:42:24.726Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "25cd4952-6b02-4094-89be-227aa0b70ebe",
      "text": "đưa mắt sàng lọc mọi xấu xa.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:24.740Z",
      "updatedAt": "2025-09-03T02:42:24.740Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "9b3d925a-0209-4237-9767-5898382d8c96",
      "text": "Ai dám nói : “Tôi đã giữ lòng mình thanh khiết,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:24.754Z",
      "updatedAt": "2025-09-03T02:42:24.754Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "e5ce8de1-784e-409e-bad8-0cf0bc2f21cf",
      "text": "và tôi đã sạch tội rồi !”",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:24.782Z",
      "updatedAt": "2025-09-03T02:42:24.782Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "8b5ccd30-dc76-46a0-b70e-09234ddd27a5",
      "text": "Cân non cân già, đấu gian đấu dối,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:24.796Z",
      "updatedAt": "2025-09-03T02:42:24.796Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "3969216d-9646-4743-810d-7c0197f72e30",
      "text": "ĐỨC CHÚA ghê tởm cả hai.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:24.824Z",
      "updatedAt": "2025-09-03T02:42:24.824Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "86b9cd9a-f3d3-4d16-8a53-3d45c58373a2",
      "text": "Qua việc làm, mà người ta biết được",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:24.851Z",
      "updatedAt": "2025-09-03T02:42:24.851Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "aca53410-4b23-47ec-a7cd-dde1aad77306",
      "text": "tính hạnh đứa trẻ có trong sáng thẳng ngay.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:24.865Z",
      "updatedAt": "2025-09-03T02:42:24.865Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "b53629c8-0254-4afc-94b9-490d51da1509",
      "text": "Tai để nghe, mắt để thấy,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:24.879Z",
      "updatedAt": "2025-09-03T02:42:24.879Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "607176ac-3bb1-4687-91e9-6ec5d13f8d98",
      "text": "ĐỨC CHÚA làm nên cả hai.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:24.907Z",
      "updatedAt": "2025-09-03T02:42:24.907Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "9eb67b1c-ef97-49c5-ba22-6ed82f9fe4e9",
      "text": "Đừng mê ngủ kẻo ra nghèo túng,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:24.934Z",
      "updatedAt": "2025-09-03T02:42:24.934Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "821d9c4b-7014-45d7-808d-05dacd87a083",
      "text": "chong mắt thức, bạn sẽ được cơm bánh no nê.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:24.962Z",
      "updatedAt": "2025-09-03T02:42:24.962Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "53cc334d-f110-44a9-a917-9db295cf2fa8",
      "text": "Khi mua thì chê “Đồ ôi, đồ dở !”",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:24.976Z",
      "updatedAt": "2025-09-03T02:42:24.976Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "73cb6b71-6dc6-4cc5-a300-2bc6692537f9",
      "text": "lúc đi khỏi, lại tự khen mua được giá hời !",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:24.990Z",
      "updatedAt": "2025-09-03T02:42:24.990Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "682682da-ff50-45e4-bb4a-dfc8c3ffb85a",
      "text": "Vàng bạc trân châu : nhiều vô kể,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:25.004Z",
      "updatedAt": "2025-09-03T02:42:25.004Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "04e7ac55-6f27-4330-967b-956882d75f84",
      "text": "miệng lưỡi thông thái : thật hiếm hoi !",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:25.032Z",
      "updatedAt": "2025-09-03T02:42:25.032Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "33762432-fb98-4d5b-a7ca-cfc979c67c30",
      "text": "Người nào dám bảo lãnh cho kẻ không quen,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:25.046Z",
      "updatedAt": "2025-09-03T02:42:25.046Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "644586b4-638f-4c55-a22e-4651a0b70467",
      "text": "phải giữ lấy áo của người đó ;",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:25.073Z",
      "updatedAt": "2025-09-03T02:42:25.073Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "97474898-d82a-4a0e-8c2a-52517efac553",
      "text": "người nào muốn bảo đảm cho phụ nữ xa lạ,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 2,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:25.087Z",
      "updatedAt": "2025-09-03T02:42:25.087Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "6a26aff1-4f1b-4662-8aeb-022c08f7f304",
      "text": "phải đòi người đó vật thế chân.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 3,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:25.101Z",
      "updatedAt": "2025-09-03T02:42:25.101Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "b0b58ea4-4eec-4a19-87f0-896da7132ea4",
      "text": "Bánh phi nghĩa, con người lấy làm ngon,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:25.121Z",
      "updatedAt": "2025-09-03T02:42:25.121Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "086c2f80-9e7f-4897-849e-702e14375b3b",
      "text": "nhưng sau đó, miệng nó đầy đá sỏi.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:25.135Z",
      "updatedAt": "2025-09-03T02:42:25.135Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "b9b856f7-8f62-49f8-9c2f-65c2feeb1967",
      "text": "Lên kế hoạch, hãy dựa vào lời khuyên,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:25.162Z",
      "updatedAt": "2025-09-03T02:42:25.162Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "67296311-f635-4c5a-ac02-a265f99ab0e7",
      "text": "lúc giao tranh, hãy nghe lời cố vấn.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:25.176Z",
      "updatedAt": "2025-09-03T02:42:25.176Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "d6fddfbb-cc03-4e41-af65-4c675f8fa14b",
      "text": "Đứa ngồi lê đôi mách tiết lộ điều bí mật,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:25.191Z",
      "updatedAt": "2025-09-03T02:42:25.191Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "3c8dcbc8-17cc-406e-856c-a47e8b96c1a7",
      "text": "vậy đừng giao du với kẻ lắm lời.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:25.219Z",
      "updatedAt": "2025-09-03T02:42:25.219Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "2860cb21-c64d-4cd3-96ec-feeb05bebe0a",
      "text": "Kẻ nào nguyền rủa mẹ cha,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:25.232Z",
      "updatedAt": "2025-09-03T02:42:25.232Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "b1fbc692-e72c-453f-a7c9-b1999cb885d4",
      "text": "ngay giữa đêm khuya, đèn nó bị tắt ngúm.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:25.260Z",
      "updatedAt": "2025-09-03T02:42:25.260Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "7aebb628-2b65-4b10-a550-8df897bdde7e",
      "text": "Của cải kiếm vội được lúc đầu,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:25.302Z",
      "updatedAt": "2025-09-03T02:42:25.302Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "c3671df4-7793-4f4e-9418-1b949bf116cf",
      "text": "thì về sau sẽ không được chúc phúc.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:25.329Z",
      "updatedAt": "2025-09-03T02:42:25.329Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "1bb06b17-981e-4049-baca-c6d4d9666e56",
      "text": "Bạn đừng nói : “Tôi sẽ báo thù !”",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:25.343Z",
      "updatedAt": "2025-09-03T02:42:25.343Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "d49e69b5-09a1-435e-abe3-1355f00b3573",
      "text": "Hãy cậy trông ĐỨC CHÚA, Người sẽ cứu bạn.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:25.371Z",
      "updatedAt": "2025-09-03T02:42:25.371Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "6985210c-e7cf-4797-963a-ba2c8dcc205f",
      "text": "Cân non cân già làm ĐỨC CHÚA ghê tởm,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:25.405Z",
      "updatedAt": "2025-09-03T02:42:25.405Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "b0121bf4-4e47-4ee1-ac08-6cb4b2c92d0d",
      "text": "bàn cân gian dối, nào tốt đẹp chi !",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:25.448Z",
      "updatedAt": "2025-09-03T02:42:25.448Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "8ca3269d-a467-45a2-ba0e-afffc5b8c661",
      "text": "ĐỨC CHÚA dẫn dắt từng bước chân con người,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:25.475Z",
      "updatedAt": "2025-09-03T02:42:25.475Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "bbf0bd0e-d1c4-4430-9fb1-2699df578403",
      "text": "nẻo đời mình, phàm nhân sao hiểu hết.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:25.517Z",
      "updatedAt": "2025-09-03T02:42:25.517Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "e8f39e01-f459-4db6-8588-82ce9a9426ae",
      "text": "Nguy hiểm thay, khi vội vàng khấn dâng của cải,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:25.545Z",
      "updatedAt": "2025-09-03T02:42:25.545Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "19425761-cf48-4b8f-91c4-32e88cabe65f",
      "text": "rồi sau đó lại tiếc nuối nghĩ suy.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:25.573Z",
      "updatedAt": "2025-09-03T02:42:25.573Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "7f96090b-b843-4fab-896a-dd97b3734b09",
      "text": "Vị minh quân sàng lọc lũ gian tà,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:25.601Z",
      "updatedAt": "2025-09-03T02:42:25.601Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "bb050bcb-a760-46fe-b4e4-95a10aedba69",
      "text": "cho bánh xe cán lên bọn chúng.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:25.615Z",
      "updatedAt": "2025-09-03T02:42:25.615Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "58ab3bb2-5b6f-41b8-a47f-c42599dfa9d8",
      "text": "Tinh thần là đèn sáng ĐỨC CHÚA ban cho con người,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:25.629Z",
      "updatedAt": "2025-09-03T02:42:25.629Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "4ef6a1d8-25df-4dc5-8a45-64f53c6fa134",
      "text": "dò xét mọi ngõ ngách tâm can.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:25.686Z",
      "updatedAt": "2025-09-03T02:42:25.686Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "a91a0a7c-439d-4fac-862a-142f9ccef42f",
      "text": "Nhân nghĩa và tín thành gìn giữ đức vua,",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:25.699Z",
      "updatedAt": "2025-09-03T02:42:25.699Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "b5e64d3b-a45d-417a-bc85-495986649244",
      "text": "nhờ nhân ái, ngai vàng người bền vững.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 1,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:25.713Z",
      "updatedAt": "2025-09-03T02:42:25.713Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "ecc9e488-b49c-431f-994e-066cb7ace827",
      "text": "Sức mạnh là niềm tự hào của giới thanh niên,",
      "label": "29",
      "number": 29,
      "subVerseIndex": 0,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:25.741Z",
      "updatedAt": "2025-09-03T02:42:25.741Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "1466ae5b-bf4a-4f68-82e4-abea1eb51db0",
      "text": "mái đầu bạc là vinh dự của hàng bô lão.",
      "label": "29",
      "number": 29,
      "subVerseIndex": 1,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:25.755Z",
      "updatedAt": "2025-09-03T02:42:25.755Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "9d221431-5a1e-4ea8-9ed0-d28b4e44b296",
      "text": "Vết thương nhức nhối tẩy sạch điều gian ác,",
      "label": "30",
      "number": 30,
      "subVerseIndex": 0,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:25.782Z",
      "updatedAt": "2025-09-03T02:42:25.782Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    },
    {
      "id": "abcb86f5-b90d-41f9-a64f-00a8dbd04da1",
      "text": "và roi vọt thấu đến tận cõi lòng.",
      "label": "30",
      "number": 30,
      "subVerseIndex": 1,
      "paragraphNumber": 61,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:25.796Z",
      "updatedAt": "2025-09-03T02:42:25.796Z",
      "chapterId": "e24d2494-d1e2-4212-90d8-76da18914c1a"
    }
  ],
