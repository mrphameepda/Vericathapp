      "endOffset": 0,
      "createdAt": "2025-09-03T02:42:31.449Z",
      "updatedAt": "2025-09-03T02:42:31.449Z",
      "targetId": "ff2d28d1-f151-4a63-a441-5cef23c5bee4",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "1cabc207-537a-45d1-9dc8-2d74bdd51f80",
      "content": "Đây là một trong những lời giáo huấn thiết yếu của các ngôn sứ (Am 5,22-24 ; Hs 6,6 ; Is 1,11-17).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 39,
      "endOffset": 39,
      "createdAt": "2025-09-03T02:42:31.217Z",
      "updatedAt": "2025-09-03T02:42:31.217Z",
      "targetId": "eb410769-87d4-4dfb-8580-3b4ed255926d",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "b620df4d-c58f-474b-926a-b81221467ca6",
      "content": "Cn 17,8",
      "kind": "MARK_KIND_REFERENCE",
      "label": "4@",
      "sortOrder": 3,
      "startOffset": 22,
      "endOffset": 22,
      "createdAt": "2025-09-03T02:42:31.553Z",
      "updatedAt": "2025-09-03T02:42:31.553Z",
      "targetId": "61d73f69-095d-4134-b91e-dd86a1e700d5",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "5588cf2c-801f-46bf-99d5-3df90c4b9b17",
      "content": "*Mái nhà* phẳng, có thể có phòng nhỏ dành cho khách (Đnl 22,8). Vì vợ lắm lời mà chồng phải lên ở trên mái.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "5",
      "sortOrder": 4,
      "startOffset": 26,
      "endOffset": 26,
      "createdAt": "2025-09-03T02:42:31.359Z",
      "updatedAt": "2025-09-03T02:42:31.359Z",
      "targetId": "fc8601de-4519-4c5e-bb39-5bf69c427cc7",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "c95ad302-c7d8-4a6d-b4b7-7506517250f0",
      "content": "Cn 9,18",
      "kind": "MARK_KIND_REFERENCE",
      "label": "5@",
      "sortOrder": 4,
      "startOffset": 27,
      "endOffset": 27,
      "createdAt": "2025-09-03T02:42:31.637Z",
      "updatedAt": "2025-09-03T02:42:31.637Z",
      "targetId": "844b3afb-2036-4db1-abf5-98955b6e5978",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "d663926e-433a-4dc2-8dcd-b0e8c6949420",
      "content": "*Đấng Công Chính* ở đây phải hiểu là Thiên Chúa, vì chỉ Người mới bắt ác nhân phải sụp đổ. Tuy nhiên, trong sách Cn cũng như trong Cựu Ước (trừ G 34,17), chẳng khi nào Thiên Chúa được gọi như vậy.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "6",
      "sortOrder": 5,
      "startOffset": 15,
      "endOffset": 15,
      "createdAt": "2025-09-03T02:42:31.487Z",
      "updatedAt": "2025-09-03T02:42:31.487Z",
      "targetId": "600d1b25-7681-4dba-98d8-3331c1e69807",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "04e77627-b1be-4391-aabf-9780b1dd1910",
      "content": "Cn 19,13",
      "kind": "MARK_KIND_REFERENCE",
      "label": "6@",
      "sortOrder": 5,
      "startOffset": 25,
      "endOffset": 25,
