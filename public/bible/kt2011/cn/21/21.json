{
  "chapter": {
    "id": "456a442c-4701-413f-b71b-2af089c27787",
    "number": 21,
    "createdAt": "2025-09-03T01:07:51.667Z",
    "updatedAt": "2025-09-03T01:07:51.667Z",
    "bookId": "1ea97633-82d8-4f1a-bffc-dfb2da235911"
  },
  "verses": [
    {
      "id": "4b91f178-3df8-499f-aee3-8919a3ac11e8",
      "text": "Trong tay ĐỨC CHÚA, lòng vua tựa dòng nước chảy,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.095Z",
      "updatedAt": "2025-09-03T02:42:31.095Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "8e663b69-487f-4771-821f-349486cade51",
      "text": "Người lèo lái đi đâu tuỳ ý Người.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.122Z",
      "updatedAt": "2025-09-03T02:42:31.122Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "08d2bc95-bcf6-4c2e-bbcc-91e0fe2857a7",
      "text": "Con người cho lối sống của mình là ngay thẳng,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.132Z",
      "updatedAt": "2025-09-03T02:42:31.132Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "b51bd1ce-1acb-4f2c-9726-9ef87f9314ab",
      "text": "nhưng ĐỨC CHÚA thấu suốt mọi tâm can.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.154Z",
      "updatedAt": "2025-09-03T02:42:31.154Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "d39b5e26-aabb-4dfa-9ca7-0383b19afde2",
      "text": "Thực thi điều công minh chính trực",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.176Z",
      "updatedAt": "2025-09-03T02:42:31.176Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "eb410769-87d4-4dfb-8580-3b4ed255926d",
      "text": "thì đẹp lòng ĐỨC CHÚA hơn là dâng hy lễ.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.190Z",
      "updatedAt": "2025-09-03T02:42:31.190Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "3588d7b7-1df9-41f7-b339-d1d46d786a4b",
      "text": "Mắt kiêu hãnh, lòng tự cao,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.230Z",
      "updatedAt": "2025-09-03T02:42:31.230Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "ec38310f-1506-43b0-9e5b-916ad8f3ff0d",
      "text": "vẻ hào nhoáng của ác nhân : thảy đều là tội lỗi.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.242Z",
      "updatedAt": "2025-09-03T02:42:31.242Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "bfcf4585-8b7e-4e3f-abca-770587df740f",
      "text": "Kế hoạch người siêng năng hẳn tạo ra lợi nhuận,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.252Z",
      "updatedAt": "2025-09-03T02:42:31.252Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "85d07706-8ee0-4fe5-b599-da4cfc9477ff",
      "text": "ai vội vàng hấp tấp, ắt phải chịu đói nghèo.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.263Z",
      "updatedAt": "2025-09-03T02:42:31.263Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "15341272-2bae-4b46-a914-dbcb4a7fc16b",
      "text": "Kho tàng thu tích nhờ môi miệng điêu ngoa",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.274Z",
      "updatedAt": "2025-09-03T02:42:31.274Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "cd9507f5-da20-4ce7-9436-8a4b3fdc3b47",
      "text": "là hơi thở thoáng qua, là bẫy làm thiệt mạng.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.284Z",
      "updatedAt": "2025-09-03T02:42:31.284Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "10286ff4-e8bc-4dda-9ebd-9cbf67bacdfa",
      "text": "Bạo hành của kẻ ác sẽ cuốn phăng kẻ ác,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.296Z",
      "updatedAt": "2025-09-03T02:42:31.296Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "481fd7de-13e5-4409-b596-381f0cee577e",
      "text": "vì chúng không chịu thực thi công bằng.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.307Z",
      "updatedAt": "2025-09-03T02:42:31.307Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "050b5c48-6e41-4dbf-b2c1-4a0d7e087cf5",
      "text": "Đường lối của kẻ gian ác thì quanh co,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.318Z",
      "updatedAt": "2025-09-03T02:42:31.318Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "00186dff-1506-47d9-ad94-5af41c1326b9",
      "text": "hành động của người trong sạch thì ngay thẳng.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.331Z",
      "updatedAt": "2025-09-03T02:42:31.331Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "fc8601de-4519-4c5e-bb39-5bf69c427cc7",
      "text": "Thà ở một góc trên mái nhà,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.345Z",
      "updatedAt": "2025-09-03T02:42:31.345Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "6c86b304-f43e-45cb-9e8f-2016cd236c2d",
      "text": "còn hơn chung sống với một bà hay gây.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.388Z",
      "updatedAt": "2025-09-03T02:42:31.388Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "ca3e22ca-68c0-4644-a5d4-97f6b489a1a3",
      "text": "Lòng ác nhân ước ao sự dữ,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.404Z",
      "updatedAt": "2025-09-03T02:42:31.404Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "2490f3a0-7f37-4e39-af4f-c0e8acbc47d9",
      "text": "ngay bạn bè, nó chẳng để mắt thương.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.422Z",
      "updatedAt": "2025-09-03T02:42:31.422Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "ff2d28d1-f151-4a63-a441-5cef23c5bee4",
      "text": "Phạt đứa ưa chế giễu, kẻ khờ dại nên khôn,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.436Z",
      "updatedAt": "2025-09-03T02:42:31.436Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "bda12df5-1c12-4d15-b082-8e609bd74ecc",
      "text": "dạy bảo người khôn, người khôn càng hiểu biết.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.464Z",
      "updatedAt": "2025-09-03T02:42:31.464Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "600d1b25-7681-4dba-98d8-3331c1e69807",
      "text": "Đấng Công Chính xem xét nhà của ác nhân,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.475Z",
      "updatedAt": "2025-09-03T02:42:31.475Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "ffa5bd70-1e05-4fdf-8baf-5d5dea8929fd",
      "text": "bắt ác nhân lâm vòng tai hoạ.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.498Z",
      "updatedAt": "2025-09-03T02:42:31.498Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "8372b94a-a389-4b47-bf66-4de36c8f7841",
      "text": "Kẻ bịt tai trước tiếng kêu của người cô thế,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.511Z",
      "updatedAt": "2025-09-03T02:42:31.511Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "31d2ca5e-5869-4d2f-81cb-7adadc575dac",
      "text": "đến lúc nó kêu, sẽ chẳng được đáp lời.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.525Z",
      "updatedAt": "2025-09-03T02:42:31.525Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "61d73f69-095d-4134-b91e-dd86a1e700d5",
      "text": "Tặng phẩm kín đáo làm tiêu tan cơn giận,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.539Z",
      "updatedAt": "2025-09-03T02:42:31.539Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "d46dee97-4bc2-4b88-b65d-c12aea5e55f3",
      "text": "quà giấu trong áo làm dịu trận lôi đình.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.567Z",
      "updatedAt": "2025-09-03T02:42:31.567Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "f4da2665-63a8-499d-b0d0-2482f82c707b",
      "text": "Thực thi công lý là niềm vui cho người công chính,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.581Z",
      "updatedAt": "2025-09-03T02:42:31.581Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "47099796-95c2-45ec-a87c-db8e4bebc31d",
      "text": "nhưng là nỗi kinh hoàng cho kẻ bất lương.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.595Z",
      "updatedAt": "2025-09-03T02:42:31.595Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "39116176-9c18-4c08-b4d4-bbbd99c3d126",
      "text": "Kẻ lạc xa con đường hiểu biết,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.609Z",
      "updatedAt": "2025-09-03T02:42:31.609Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "844b3afb-2036-4db1-abf5-98955b6e5978",
      "text": "sẽ phải sống chung với đám âm hồn.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.623Z",
      "updatedAt": "2025-09-03T02:42:31.623Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "8fe710a0-ef44-4fbf-85b1-a69d9893bf60",
      "text": "Kẻ ham vui sẽ bần cùng đói khổ,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.651Z",
      "updatedAt": "2025-09-03T02:42:31.651Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "8e897498-dd15-47ce-8443-aaede4b333b8",
      "text": "người mê rượu chè sẽ chẳng giàu đâu !",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.665Z",
      "updatedAt": "2025-09-03T02:42:31.665Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "ae93efe3-16a2-4652-aecc-c8882d03d464",
      "text": "Kẻ ác thành giá chuộc cho người công chính,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.695Z",
      "updatedAt": "2025-09-03T02:42:31.695Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "db22cd05-1ac2-4f6d-aaac-faca60c76766",
      "text": "tên phản bội bị phạt thay cho kẻ ngay lành.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.708Z",
      "updatedAt": "2025-09-03T02:42:31.708Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "52050441-72b2-4da1-8830-70034f78aa9b",
      "text": "Thà sống nơi đìu hiu cô quạnh,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.736Z",
      "updatedAt": "2025-09-03T02:42:31.736Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "7a4a0e6e-0f95-4894-9bf7-80c9f50b6182",
      "text": "còn hơn bên người vợ hay gây gổ nổi xung.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.750Z",
      "updatedAt": "2025-09-03T02:42:31.750Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "5618d099-5623-4f99-a114-62da4051628b",
      "text": "Nhà người khôn có kho báu và dầu,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.779Z",
      "updatedAt": "2025-09-03T02:42:31.779Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "ad6a1a3f-027f-4c17-b07b-71851aefc893",
      "text": "còn người ngu có gì nuốt hết.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.793Z",
      "updatedAt": "2025-09-03T02:42:31.793Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "0e36a13b-9b64-4c9a-8610-4432dffd1113",
      "text": "Người theo đuổi công chính và nhân nghĩa,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.806Z",
      "updatedAt": "2025-09-03T02:42:31.806Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "bd594c4f-ed74-4b7b-99d3-7c8c72f0f462",
      "text": "sẽ được sống lâu và vinh dự.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.820Z",
      "updatedAt": "2025-09-03T02:42:31.820Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "d457a9e7-8b65-4e9f-b481-e05a661ae4ac",
      "text": "Người khôn tấn công thành của quân thiện chiến,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.848Z",
      "updatedAt": "2025-09-03T02:42:31.848Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "7756821e-3d7f-42f5-8fef-c89d1d3c58a4",
      "text": "và lật nhào đồn luỹ chúng cậy trông.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.875Z",
      "updatedAt": "2025-09-03T02:42:31.875Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "3eb8f50a-6efa-4268-a07f-9bc7faace348",
      "text": "Kẻ giữ mồm giữ miệng,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.889Z",
      "updatedAt": "2025-09-03T02:42:31.889Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "14c7b970-e027-49dc-bb45-d74ce2596431",
      "text": "thì giữ mình khỏi những hiểm nguy.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.917Z",
      "updatedAt": "2025-09-03T02:42:31.917Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "b56ffb3b-51a0-45cd-87de-6eadeaba11a7",
      "text": "Đứa kiêu căng xấc xược được gọi là quân nhạo báng,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.931Z",
      "updatedAt": "2025-09-03T02:42:31.931Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "0e77df27-11ff-4033-921e-ccdf8d2bfc8b",
      "text": "nó cư xử ngạo ngược kiêu căng.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.960Z",
      "updatedAt": "2025-09-03T02:42:31.960Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "08423834-4a6c-4a24-a8ce-cce14061db5a",
      "text": "Vì ham muốn, đứa lười mất mạng,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:31.974Z",
      "updatedAt": "2025-09-03T02:42:31.974Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "fb46aedf-9b9c-4efa-aaea-68103829895a",
      "text": "bởi nó không chịu ra tay làm.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:32.001Z",
      "updatedAt": "2025-09-03T02:42:32.001Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "e04282ed-68b6-4ce7-a362-3c4cccb61b7f",
      "text": "Suốt ngày nó những ham cùng muốn,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:32.015Z",
      "updatedAt": "2025-09-03T02:42:32.015Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "5d5bdee9-c131-408c-9e55-f6a765446183",
      "text": "còn chính nhân cho hết, chẳng giữ lại gì.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:32.029Z",
      "updatedAt": "2025-09-03T02:42:32.029Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "8c5d206f-240d-4984-808d-d5a70ef5f996",
      "text": "Hy lễ của ác nhân là điều ghê tởm,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:32.043Z",
      "updatedAt": "2025-09-03T02:42:32.043Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "7144b7ee-f116-419f-af8d-7fc38d7ef554",
      "text": "nhất là khi dâng với ý gian tà.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:32.071Z",
      "updatedAt": "2025-09-03T02:42:32.071Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "3d04e91b-8c4c-4537-95c9-e75589cb05d7",
      "text": "Kẻ làm chứng gian sẽ phải tiêu vong,",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:32.085Z",
      "updatedAt": "2025-09-03T02:42:32.085Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "fa136951-ed48-46c1-af2b-18415cda3c40",
      "text": "còn người biết nghe có thể nói hoài.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 1,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:32.115Z",
      "updatedAt": "2025-09-03T02:42:32.115Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "68a550fc-2d5d-4dc4-aff8-ba60db3b8737",
      "text": "Kẻ gian ác mang bộ mặt trơ trẽn,",
      "label": "29",
      "number": 29,
      "subVerseIndex": 0,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:32.137Z",
      "updatedAt": "2025-09-03T02:42:32.137Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "e5fc373c-bbd4-45d6-895a-4287a8d03c87",
      "text": "còn người ngay cứ vững bước trên đường.",
      "label": "29",
      "number": 29,
      "subVerseIndex": 1,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:32.147Z",
      "updatedAt": "2025-09-03T02:42:32.147Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "4ab1c81b-afd1-40d5-9dba-68101ea52af0",
      "text": "Khôn ngoan, hiểu biết, nhủ khuyên,",
      "label": "30",
      "number": 30,
      "subVerseIndex": 0,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:32.158Z",
      "updatedAt": "2025-09-03T02:42:32.158Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "42f037a9-d10f-47d0-bc3d-f0ca1931b783",
      "text": "tất cả chẳng là gì sánh với ĐỨC CHÚA.",
      "label": "30",
      "number": 30,
      "subVerseIndex": 1,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:32.168Z",
      "updatedAt": "2025-09-03T02:42:32.168Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "b0e6c519-5335-4f49-8b71-b1748dd3ee94",
      "text": "Chiến mã được chuẩn bị cho ngày giao tranh,",
      "label": "31",
      "number": 31,
      "subVerseIndex": 0,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:32.200Z",
      "updatedAt": "2025-09-03T02:42:32.200Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    },
    {
      "id": "5cf5f060-90b2-44f8-b6b9-d85950658e50",
      "text": "nhưng thắng bại thuộc quyền ĐỨC CHÚA.",
      "label": "31",
      "number": 31,
      "subVerseIndex": 1,
      "paragraphNumber": 61,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:32.224Z",
      "updatedAt": "2025-09-03T02:42:32.224Z",
      "chapterId": "456a442c-4701-413f-b71b-2af089c27787"
    }
  ],
