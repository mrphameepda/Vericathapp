{
  "chapter": {
    "id": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79",
    "number": 22,
    "createdAt": "2025-09-03T01:07:51.667Z",
    "updatedAt": "2025-09-03T01:07:51.667Z",
    "bookId": "1ea97633-82d8-4f1a-bffc-dfb2da235911"
  },
  "verses": [
    {
      "id": "047b4f58-adb4-45fc-917b-fcd698e1f2c4",
      "text": "Lắm của cải đâu quý bằng danh thơm tiếng tốt,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:37.779Z",
      "updatedAt": "2025-09-03T02:42:37.779Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "3cd5aa71-ee1a-4ca7-b583-c28f11f5adf9",
      "text": "vàng với bạc nào trọng bằng được mến được thương.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:37.796Z",
      "updatedAt": "2025-09-03T02:42:37.796Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "111d8fb4-8a1b-4ad0-9cb0-fe12b3291928",
      "text": "Kẻ giàu người nghèo gặp nhau ở điểm này :",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:37.807Z",
      "updatedAt": "2025-09-03T02:42:37.807Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "a171c6fd-07c2-43e4-9351-da4bb03b1506",
      "text": "cả hai đều được ĐỨC CHÚA tạo dựng.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:37.828Z",
      "updatedAt": "2025-09-03T02:42:37.828Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "2261a65c-beab-4a1e-b913-4bb4d66d7e32",
      "text": "Gặp nguy hiểm, người khôn ẩn mình,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:37.852Z",
      "updatedAt": "2025-09-03T02:42:37.852Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "762b4649-1315-4322-ab74-6454510fd145",
      "text": "đứa khờ dại lao tới và bị thiệt thân.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:37.884Z",
      "updatedAt": "2025-09-03T02:42:37.884Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "e9004adb-1530-4c90-9241-6d40ab5c0288",
      "text": "Giàu sang, vinh dự và sự sống là phần thưởng",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:37.903Z",
      "updatedAt": "2025-09-03T02:42:37.903Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "0662483d-de32-44e4-a3b8-51f6d6ecdbc6",
      "text": "ĐỨC CHÚA dành cho kẻ khiêm nhu và kính sợ Người.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:37.932Z",
      "updatedAt": "2025-09-03T02:42:37.932Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "7486bcdd-7eec-4c07-8994-9841f1456d04",
      "text": "Đường kẻ quanh co thì có gai, có bẫy,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:37.960Z",
      "updatedAt": "2025-09-03T02:42:37.960Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "ca8c353f-1726-4940-a7b4-b3013b4bc173",
      "text": "ai biết giữ mình ắt sẽ tránh xa.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:37.974Z",
      "updatedAt": "2025-09-03T02:42:37.974Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "61921ffc-d8f9-4ec8-be72-8bb4a1bd7417",
      "text": "Hãy dạy đứa trẻ đi con đường nó phải đi,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:37.988Z",
      "updatedAt": "2025-09-03T02:42:37.988Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "3338c8e1-2de6-4489-a991-f3c5cccf9280",
      "text": "để đến tuổi già, nó vẫn không lìa bỏ.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.030Z",
      "updatedAt": "2025-09-03T02:42:38.030Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "a8ac23bf-e57a-4919-b354-f90460d76dfa",
      "text": "Người giàu thì thống trị kẻ nghèo,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.044Z",
      "updatedAt": "2025-09-03T02:42:38.044Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "2a2f75b2-fe57-4be0-bfe7-e64d68bfd710",
      "text": "người đi vay làm tôi cho chủ nợ.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.058Z",
      "updatedAt": "2025-09-03T02:42:38.058Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "61520825-c62d-4914-a734-9c0e31d3fa2a",
      "text": "Kẻ gieo tai ác sẽ gặt tai ương,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.072Z",
      "updatedAt": "2025-09-03T02:42:38.072Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "ec09aeee-9f34-4e6f-9abb-ab15081486cb",
      "text": "nó đã tàn phá, ắt sẽ tàn lụi.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.086Z",
      "updatedAt": "2025-09-03T02:42:38.086Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "bb9123bf-b37a-44f1-9f40-3e08e34d11af",
      "text": "Người tử tế sẽ được chúc phúc,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.114Z",
      "updatedAt": "2025-09-03T02:42:38.114Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "9e2adbdb-4e17-4e4b-9118-0a153af1f17e",
      "text": "vì đã đem cơm bánh cho người nghèo.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.128Z",
      "updatedAt": "2025-09-03T02:42:38.128Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "719f0934-0cb2-46f0-ad8d-73d3cba8eb0b",
      "text": "Đuổi quân nhạo báng đi là hết chuyện đôi co,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.155Z",
      "updatedAt": "2025-09-03T02:42:38.155Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "3f37de8f-671f-4a48-ac1f-81738ee2b690",
      "text": "cũng chẳng còn tranh chấp với lăng mạ.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.184Z",
      "updatedAt": "2025-09-03T02:42:38.184Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "cde7dc82-9eb8-49d2-83bc-eaab37d3a809",
      "text": "Ai chuộng lòng thanh khiết và ăn nói dễ thương",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.197Z",
      "updatedAt": "2025-09-03T02:42:38.197Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "fe1624fd-0dbb-4c9a-be0a-909fe0c8b318",
      "text": "sẽ được vua nhận làm bạn hữu.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.211Z",
      "updatedAt": "2025-09-03T02:42:38.211Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "fb89e5dc-d535-4116-a75b-3ee5bc7b002a",
      "text": "ĐỨC CHÚA để mắt trông nom người hiểu biết,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.225Z",
      "updatedAt": "2025-09-03T02:42:38.225Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "72b4e28d-3eb1-43b7-a1f4-1e1505d428d0",
      "text": "và phi bác lời lẽ kẻ bất trung.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.253Z",
      "updatedAt": "2025-09-03T02:42:38.253Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "5d203b5b-bcdd-4820-94f7-1e966fc3251c",
      "text": "Đứa lười nói : “Có con sư tử ở ngoài kia ;",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.268Z",
      "updatedAt": "2025-09-03T02:42:38.268Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "5a6fc2c6-e6fa-444d-8770-73f6c68a17d3",
      "text": "nếu tôi ra đường, chắc sẽ bị ăn thịt.”",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.295Z",
      "updatedAt": "2025-09-03T02:42:38.295Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "2cac3443-f9dc-40f9-91d6-5a9676928128",
      "text": "Miệng người phụ nữ trắc nết ví tựa hố sâu,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.309Z",
      "updatedAt": "2025-09-03T02:42:38.309Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "5582c184-6992-4949-b39d-80ef1a959305",
      "text": "kẻ bị ĐỨC CHÚA ruồng bỏ sẽ sa vào đó.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.337Z",
      "updatedAt": "2025-09-03T02:42:38.337Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "be108ae0-854c-4692-9949-de19e74c4ceb",
      "text": "Tâm trí trẻ con vốn dại khờ,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.365Z",
      "updatedAt": "2025-09-03T02:42:38.365Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "7062f521-6ab0-464a-b5c4-3d47b4c00ba9",
      "text": "lấy roi sửa phạt là giúp nó nên khôn.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.379Z",
      "updatedAt": "2025-09-03T02:42:38.379Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "38b20424-d966-4b02-83c7-d9fe017771b0",
      "text": "Bóc lột người nghèo là làm giàu cho họ,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.407Z",
      "updatedAt": "2025-09-03T02:42:38.407Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "b646e957-3841-411d-8993-a8709e592483",
      "text": "tặng cho kẻ giàu là khiến mình nghèo đi.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.420Z",
      "updatedAt": "2025-09-03T02:42:38.420Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "47af2af6-8be6-4946-959a-01ca4fc0297f",
      "text": "Con hãy lắng tai nghe lời bậc khôn ngoan,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.448Z",
      "updatedAt": "2025-09-03T02:42:38.448Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "917a5ed3-eb76-423f-8888-9074fa2383a9",
      "text": "và chú tâm vào những hiểu biết của thầy.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.499Z",
      "updatedAt": "2025-09-03T02:42:38.499Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "a8067a86-58f2-4229-bcdb-60ec0736c6cd",
      "text": "Vì khi con giữ những lời ấy trong tâm khảm",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.524Z",
      "updatedAt": "2025-09-03T02:42:38.524Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "a3cdf762-fa36-4ce2-afc9-ec754a683f5c",
      "text": "và sẵn sàng nói hết ra ngoài miệng",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.537Z",
      "updatedAt": "2025-09-03T02:42:38.537Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "c589b2e8-e269-47b2-8bae-5451580a888d",
      "text": "thì thật là vui thú dường bao !",
      "label": "18",
      "number": 18,
      "subVerseIndex": 2,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.551Z",
      "updatedAt": "2025-09-03T02:42:38.551Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "fb00ff0f-25a0-4334-ac0b-d2dc6b7b3306",
      "text": "Hôm nay thầy muốn dạy con, cả con nữa,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.565Z",
      "updatedAt": "2025-09-03T02:42:38.565Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "c543f017-5930-4f50-b30d-f5fa9d980e91",
      "text": "để con một niềm tin tưởng vào ĐỨC CHÚA.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.579Z",
      "updatedAt": "2025-09-03T02:42:38.579Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "44bb5faf-fcb6-4897-a627-0ae24bdb229b",
      "text": "Há thầy đã chẳng viết cho con ba mươi huấn dụ",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.606Z",
      "updatedAt": "2025-09-03T02:42:38.606Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "ed4baf6e-70d6-44ad-8a19-23cbabd45fab",
      "text": "gồm những lời khuyên răn và hiểu biết đó sao ?",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.640Z",
      "updatedAt": "2025-09-03T02:42:38.640Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "d38663d2-cf1c-436c-b094-cfcedb6e3585",
      "text": "Mục đích là để giúp con am tường",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.654Z",
      "updatedAt": "2025-09-03T02:42:38.654Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "0655b65b-0bf7-4c97-ab43-82f2c6c6f57f",
      "text": "những lời chân thật",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.668Z",
      "updatedAt": "2025-09-03T02:42:38.668Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "aadbff86-675a-4782-b65b-c79ac6a835d7",
      "text": "và trình bày lại cho người đã sai con",
      "label": "21",
      "number": 21,
      "subVerseIndex": 2,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.682Z",
      "updatedAt": "2025-09-03T02:42:38.682Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "69e75bb3-a292-4ff5-af5f-7de0c274d2f0",
      "text": "sao cho thật trung thành.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 3,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.696Z",
      "updatedAt": "2025-09-03T02:42:38.696Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "cc1d9326-417a-430f-91e7-f1a3ae6f7a4f",
      "text": "Đừng bóc lột người nghèo, vì họ đã nghèo sẵn ;",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.710Z",
      "updatedAt": "2025-09-03T02:42:38.710Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "5512356e-8f9f-4b30-bb79-f1d5c25748fa",
      "text": "cũng đừng chà đạp người yếu thế nơi cửa công,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.725Z",
      "updatedAt": "2025-09-03T02:42:38.725Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "069bf290-390d-4017-befa-162c64b5f5f9",
      "text": "vì ĐỨC CHÚA sẽ biện hộ cho họ,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.738Z",
      "updatedAt": "2025-09-03T02:42:38.738Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "87fac0be-6a9c-4d1c-90c9-52fa05015d93",
      "text": "và những ai tước đoạt họ, Người sẽ tước mạng sống.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.781Z",
      "updatedAt": "2025-09-03T02:42:38.781Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "35e486de-8f91-4efa-980d-c3a366cff2db",
      "text": "Đừng bè bạn với người hay nóng giận,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.794Z",
      "updatedAt": "2025-09-03T02:42:38.794Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "b3ef0f0e-1d12-4b04-8c7d-f7fb759247bf",
      "text": "chớ giao du với kẻ dễ nổi xung,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.808Z",
      "updatedAt": "2025-09-03T02:42:38.808Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "768889f7-7bcf-409b-9a13-456ef31d2485",
      "text": "kẻo con lại học đòi lối sống của chúng,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.823Z",
      "updatedAt": "2025-09-03T02:42:38.823Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "fd08611c-55cd-4b46-a638-7408a97d6081",
      "text": "khiến thân con mắc phải bẫy dò.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.836Z",
      "updatedAt": "2025-09-03T02:42:38.836Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "e2d8bb2a-81bc-4936-bbe0-1c471e86af47",
      "text": "Đừng thuộc hạng người bắt tay giao kèo,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.850Z",
      "updatedAt": "2025-09-03T02:42:38.850Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "7e95bc71-c2fd-45ce-90aa-e12a0c624d3a",
      "text": "hay hạng người bảo lãnh cho kẻ khác vay mượn,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.864Z",
      "updatedAt": "2025-09-03T02:42:38.864Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "b974eeb1-5d90-433c-b88e-75e1ed88c9f3",
      "text": "vì nếu con không có gì để trả,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.891Z",
      "updatedAt": "2025-09-03T02:42:38.891Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "b21eabd9-32d1-4896-aef0-fa3bca2aeb98",
      "text": "giường con đang nằm, người ta cũng lấy đi.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.903Z",
      "updatedAt": "2025-09-03T02:42:38.903Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "8bb9f890-2690-4b7c-abe7-ff796e79ebcc",
      "text": "Đường ranh cha ông đã ấn định từ trước,",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.926Z",
      "updatedAt": "2025-09-03T02:42:38.926Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "019fcbfa-55b8-4129-bc60-51c96c9c0bd4",
      "text": "con đừng có chuyển dời.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 1,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.949Z",
      "updatedAt": "2025-09-03T02:42:38.949Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "3a6486cf-71da-4f81-a33a-38b1aaf03f27",
      "text": "Con có thấy người giỏi giang khéo léo ?",
      "label": "29",
      "number": 29,
      "subVerseIndex": 0,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.974Z",
      "updatedAt": "2025-09-03T02:42:38.974Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "af4d8911-db17-4260-965f-62e96ecd0f51",
      "text": "Người ấy sẽ được vào phục vụ các vua,",
      "label": "29",
      "number": 29,
      "subVerseIndex": 1,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:38.987Z",
      "updatedAt": "2025-09-03T02:42:38.987Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "d32ee735-7c82-426b-9ef8-7cb1ecc45282",
      "text": "chứ không phục vụ hạng tầm thường.",
      "label": "29",
      "number": 29,
      "subVerseIndex": 2,
      "paragraphNumber": 61,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:39.004Z",
      "updatedAt": "2025-09-03T02:42:39.004Z",
      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    }
  ],
