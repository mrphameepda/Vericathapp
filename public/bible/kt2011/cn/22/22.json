      "chapterId": "e2aa8fec-7ff3-4e29-b45f-83d7ffd6cc79"
    },
    {
      "id": "cd4358b3-f4ad-4581-a726-84a5ed5a2423",
      "content": "Nghĩa là theo hướng sống riêng mà nó sẽ đi suốt đời.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 39,
      "endOffset": 39,
