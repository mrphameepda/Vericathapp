    },
    {
      "id": "3d9a7673-b731-4967-a28d-b2116ae7dfd4",
      "content": "Cn 23,3",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 5,
      "endOffset": 5,
      "createdAt": "2025-09-03T02:42:44.565Z",
      "updatedAt": "2025-09-03T02:42:44.565Z",
      "targetId": "0445ae10-9246-4bf1-a30d-482db518b820",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "e8b83a52-a809-4770-920e-a9c6805430de",
      "content": "*Đồ ăn phỉnh gạt* là thứ đồ ăn được mời với ý hướng xấu, nhằm lôi kéo ta vào những mưu mô tà vạy (x. Tv 141,4).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 28,
      "endOffset": 28,
      "createdAt": "2025-09-03T02:42:44.457Z",
      "updatedAt": "2025-09-03T02:42:44.457Z",
      "targetId": "d05e82fc-3f78-4f65-ae06-4dd24ed39f40",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "e6a63ddc-4931-4abd-bea6-4e3206a15232",
      "content": "Cn 15,25; 22,28",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 19,
      "endOffset": 19,
      "createdAt": "2025-09-03T02:42:44.710Z",
      "updatedAt": "2025-09-03T02:42:44.710Z",
      "targetId": "979227c1-03d2-4fcc-875f-f6c7b87c19fc",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "8a9a6642-9463-4bd7-88fa-bfe36bbf452d",
      "content": "*Thổ ra* vì kinh tởm thái độ gạt gẫm của chủ nhà. Lời tốt đẹp là những lời khen ngợi, cám ơn trước sự hiếu khách.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 41,
      "endOffset": 41,
      "createdAt": "2025-09-03T02:42:44.629Z",
      "updatedAt": "2025-09-03T02:42:44.629Z",
      "targetId": "af103a7a-0153-4d67-8643-62b231fdc1c9",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "d1a72d4e-234a-481d-b4be-f3dd8fe92a4a",
      "content": "Cn 22,23",
      "kind": "MARK_KIND_REFERENCE",
      "label": "4@",
      "sortOrder": 3,
      "startOffset": 15,
      "endOffset": 15,
      "createdAt": "2025-09-03T02:42:44.784Z",
      "updatedAt": "2025-09-03T02:42:44.784Z",
      "targetId": "10ceda2d-1e87-4ecf-a3de-686f4778878d",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "e9e9f28d-7e33-4a19-8b6c-8b050258eea8",
      "content": "Nếu hiểu ở đây là *đường ranh của người goá bụa* (15,25) thì rất hợp với vế sau.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "5",
      "sortOrder": 4,
      "startOffset": 32,
      "endOffset": 32,
      "createdAt": "2025-09-03T02:42:44.696Z",
      "updatedAt": "2025-09-03T02:42:44.696Z",
      "targetId": "979227c1-03d2-4fcc-875f-f6c7b87c19fc",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "0deb8f3f-4de8-47a1-9032-8c9402d18db1",
      "content": "Cn 22,17",
      "kind": "MARK_KIND_REFERENCE",
      "label": "5@",
      "sortOrder": 4,
      "startOffset": 22,
      "endOffset": 22,
      "createdAt": "2025-09-03T02:42:44.826Z",
      "updatedAt": "2025-09-03T02:42:44.826Z",
      "targetId": "11d2650c-12b9-4047-83d3-13e539becde8",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "eb584d3f-da76-45fc-8ea4-5a550b3acc26",
      "content": "*Người chuộc* (Gö´ël) là người có bổn phận giúp họ hàng thân thuộc của mình lấy lại đất đai (x. Lv 25,25), hay trả thù cho họ (x. Ds 35,12.19). Ở đây *người chuộc* là chính Thiên Chúa, Đấng là *Cha nuôi dưỡng cô nhi, Đấng đỡ bênh quả phụ* (Tv 68,6).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "6",
      "sortOrder": 5,
      "startOffset": 17,
      "endOffset": 17,
      "createdAt": "2025-09-03T02:42:44.751Z",
      "updatedAt": "2025-09-03T02:42:44.751Z",
      "targetId": "53b2ffda-4995-43d8-be13-6ad497c4afe1",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "11707621-f51c-4080-98e8-800de6fdc71f",
      "content": "Cn 13,24; 19,18",
      "kind": "MARK_KIND_REFERENCE",
      "label": "6@",
      "sortOrder": 5,
      "startOffset": 8,
      "endOffset": 8,
      "createdAt": "2025-09-03T02:42:44.867Z",
      "updatedAt": "2025-09-03T02:42:44.867Z",
      "targetId": "e945a5f4-1b47-4768-903c-797a6155e9f0",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "95999dbe-7f21-4e76-866f-c6bc514ebff3",
      "content": "Chính việc sửa phạt con sẽ giúp nó tránh cái chết thể lý.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "7",
      "sortOrder": 6,
      "startOffset": 36,
      "endOffset": 36,
      "createdAt": "2025-09-03T02:42:44.896Z",
      "updatedAt": "2025-09-03T02:42:44.896Z",
      "targetId": "e5f53cfb-f58e-4f23-8ee1-0680dc30b610",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "784d4e9b-645e-46c8-a7e1-50c6959cbea5",
      "content": "Cn 1,12",
      "kind": "MARK_KIND_REFERENCE",
      "label": "7@",
      "sortOrder": 6,
      "startOffset": 31,
      "endOffset": 31,
      "createdAt": "2025-09-03T02:42:44.910Z",
      "updatedAt": "2025-09-03T02:42:44.910Z",
      "targetId": "e5f53cfb-f58e-4f23-8ee1-0680dc30b610",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "82cd3a39-256b-47bd-b227-33e2357244ac",
      "content": "ds : *thận của thầy*. Người Do-thái coi tim và thận chẳng những là bộ phận quan trọng của thân xác, mà còn là trung tâm của đời sống trí tuệ, luân lý và tôn giáo (x. Gr 11,20 ; Tv 26,2). Các bản dịch thường dịch tim thận thành tâm can.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "8",
      "sortOrder": 7,
      "startOffset": 36,
      "endOffset": 36,
      "createdAt": "2025-09-03T02:42:44.980Z",
      "updatedAt": "2025-09-03T02:42:44.980Z",
      "targetId": "d43a3c1a-62fd-4ad9-b3b7-f9d43411db16",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "eb236d07-5259-4591-b36b-b550fb2ea987",
      "content": "Cn 3,31",
      "kind": "MARK_KIND_REFERENCE",
      "label": "8@",
      "sortOrder": 7,
      "startOffset": 17,
      "endOffset": 17,
      "createdAt": "2025-09-03T02:42:45.008Z",
      "updatedAt": "2025-09-03T02:42:45.008Z",
      "targetId": "5976bc88-bb21-4e7c-b4ad-a8127475d836",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "6f00f4b2-f4df-4960-91f1-cccaec2e2360",
      "content": "English: Yahweh | French: SEIGNEUR | Latin: Dominus | Origin: &#1497;&#1456;&#1492;&#64331;&#1464;&#1492; | Vietnamese: ĐỨC CHÚA -- Danh của Thiên Chúa Ít-ra-en, St 2,4...",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "9",
      "sortOrder": 8,
      "startOffset": 31,
      "endOffset": 31,
      "createdAt": "2025-09-03T02:42:45.036Z",
