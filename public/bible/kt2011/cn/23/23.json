      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "8e8a6868-07ed-42cf-9814-4921e2e99497",
      "content": "Cn 24,14",
      "kind": "MARK_KIND_REFERENCE",
      "label": "9@",
      "sortOrder": 8,
      "startOffset": 24,
      "endOffset": 24,
      "createdAt": "2025-09-03T02:42:45.063Z",
      "updatedAt": "2025-09-03T02:42:45.063Z",
      "targetId": "2d1a1385-5f10-4cfb-92f8-ed1021b8792b",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "4774a0cf-9c4f-4fd8-9278-706ebeae7c42",
      "content": "Cn 6,10; 24,33-34",
      "kind": "MARK_KIND_REFERENCE",
      "label": "10@",
      "sortOrder": 9,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:42:45.184Z",
      "updatedAt": "2025-09-03T02:42:45.184Z",
      "targetId": "ea2db8d5-1869-4447-a59b-5bf85f91e307",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "62c44bbd-8b8f-4dc5-baa9-bbce8ce40e8d",
      "content": "ds : *hãy cho thầy trái tim của con, và để mắt con vui thoả trong đường lối của thầy.*",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "10",
      "sortOrder": 9,
      "startOffset": 28,
      "endOffset": 28,
      "createdAt": "2025-09-03T02:42:45.365Z",
      "updatedAt": "2025-09-03T02:42:45.365Z",
      "targetId": "ce0cc166-f68e-4753-9c23-f70fab31135f",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "61608e18-a889-4888-ad69-0fb43696c800",
      "content": "Cn 15,20; 30,17",
      "kind": "MARK_KIND_REFERENCE",
      "label": "11@",
      "sortOrder": 10,
      "startOffset": 14,
      "endOffset": 14,
      "createdAt": "2025-09-03T02:42:45.226Z",
      "updatedAt": "2025-09-03T02:42:45.226Z",
      "targetId": "bf99d94f-44ad-4bd9-af4d-9a607ec05770",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "46792e64-f2f3-482d-9c0f-a132a0d3accb",
      "content": "*Hố sâu* hay *giếng hẹp* đều khó ra nếu đã lỡ rơi vào.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "11",
      "sortOrder": 10,
      "startOffset": 33,
      "endOffset": 33,
      "createdAt": "2025-09-03T02:42:45.422Z",
      "updatedAt": "2025-09-03T02:42:45.422Z",
      "targetId": "5799a4ca-8dda-4e76-a2ca-752924c29aba",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "0878d28c-2fdb-4cb1-9f95-5ba2fe95d399",
      "content": "Cn 10,1",
      "kind": "MARK_KIND_REFERENCE",
      "label": "12@",
      "sortOrder": 11,
      "startOffset": 23,
      "endOffset": 23,
      "createdAt": "2025-09-03T02:42:45.310Z",
      "updatedAt": "2025-09-03T02:42:45.310Z",
      "targetId": "bc21ca0b-ffe3-41a1-bea3-356c15b5b406",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "8f6c0c1c-2811-4c05-90a3-6ed88360b62a",
      "content": "Đây là một mô tả sống động về tình cảnh đáng thương của người say rượu, cả về thể lý lẫn tâm lý. Có một lời cảnh giác về nguy hiểm của chuyện say sưa (cc. 31-32).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "12",
      "sortOrder": 11,
      "startOffset": 45,
      "endOffset": 45,
      "createdAt": "2025-09-03T02:42:45.490Z",
      "updatedAt": "2025-09-03T02:42:45.490Z",
      "targetId": "8758638f-2366-4ee0-96eb-bf9e8b72ae70",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
