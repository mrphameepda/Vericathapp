{
  "chapter": {
    "id": "99a9cfbf-6170-44f1-abc7-454af68db8f3",
    "number": 23,
    "createdAt": "2025-09-03T01:07:51.667Z",
    "updatedAt": "2025-09-03T01:07:51.667Z",
    "bookId": "1ea97633-82d8-4f1a-bffc-dfb2da235911"
  },
  "verses": [
    {
      "id": "f3c4dfc0-ced5-428b-88b3-ce7df6c5b4d1",
      "text": "Khi con ngồi ăn với kẻ có chức quyền,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:44.357Z",
      "updatedAt": "2025-09-03T02:42:44.357Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "9493376a-6399-46a3-8a9f-bb20cdeb6ae8",
      "text": "hãy để ý kỹ người đối diện.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:44.374Z",
      "updatedAt": "2025-09-03T02:42:44.374Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "a6fd3f41-0756-4c3a-8d64-c722971f8afd",
      "text": "Nếu con vốn tham ăn, hãy đặt dao kề cổ.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:44.396Z",
      "updatedAt": "2025-09-03T02:42:44.396Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "d1c40705-d83e-44bf-a43e-f6684b85a9a5",
      "text": "Đừng thèm thuồng cao lương mỹ vị của hắn,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:44.418Z",
      "updatedAt": "2025-09-03T02:42:44.418Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "d05e82fc-3f78-4f65-ae06-4dd24ed39f40",
      "text": "vì đó là thứ đồ ăn phỉnh gạt.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:44.444Z",
      "updatedAt": "2025-09-03T02:42:44.444Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "de9b4d03-8599-4a35-ae56-7e42e6126daf",
      "text": "Chớ nhọc công thu tích của cải,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:44.470Z",
      "updatedAt": "2025-09-03T02:42:44.470Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "8a79ddf6-7864-4c6d-8eec-b1a02ae42f33",
      "text": "và cũng đừng bận tâm đến nó ;",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:44.483Z",
      "updatedAt": "2025-09-03T02:42:44.483Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "8f795465-fb95-4d69-aefb-6223cfac3408",
      "text": "mắt con vừa thấy, nó đã chẳng còn,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:44.496Z",
      "updatedAt": "2025-09-03T02:42:44.496Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "13925a11-58dd-4c49-bc98-df75e4660e27",
      "text": "vì nó mọc cánh bay đi mất,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:44.510Z",
      "updatedAt": "2025-09-03T02:42:44.510Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "f10f8bb1-0029-42bc-9dc2-83657cc5c3ba",
      "text": "tựa đại bàng bay tới trời cao.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:44.524Z",
      "updatedAt": "2025-09-03T02:42:44.524Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "3bc27fc4-6577-4ac3-9172-8b042050595b",
      "text": "Chớ ăn bánh của quân xấu bụng,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:44.538Z",
      "updatedAt": "2025-09-03T02:42:44.538Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "0445ae10-9246-4bf1-a30d-482db518b820",
      "text": "đừng thèm thuồng cao lương mỹ vị của hắn.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:44.552Z",
      "updatedAt": "2025-09-03T02:42:44.552Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "26d59392-7be9-48d2-ab94-a4fb406455c8",
      "text": "Vì lòng hắn nghĩ sao, con người hắn như vậy.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:44.578Z",
      "updatedAt": "2025-09-03T02:42:44.578Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "d2e52ca4-3ce6-42ae-ad32-6cf7446d9f19",
      "text": "Hắn mời con : “Ăn uống đi nào !”",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:44.590Z",
      "updatedAt": "2025-09-03T02:42:44.590Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "9df0233b-aaa8-4bcc-8559-d3d3db230155",
      "text": "Nhưng đâu phải hắn có lòng với con.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:44.603Z",
      "updatedAt": "2025-09-03T02:42:44.603Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "af103a7a-0153-4d67-8643-62b231fdc1c9",
      "text": "Mẩu bánh vừa nuốt vào, con đã phải thổ ra.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:44.616Z",
      "updatedAt": "2025-09-03T02:42:44.616Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "be3a2de1-105f-4e75-86ef-f3b823816e57",
      "text": "Mất công toi bao nhiêu lời tốt đẹp,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:44.641Z",
      "updatedAt": "2025-09-03T02:42:44.641Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "23843358-805c-41ec-87d0-2952894ece78",
      "text": "con đừng nói vào tai đứa dốt,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:44.654Z",
      "updatedAt": "2025-09-03T02:42:44.654Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "6d8f296a-a743-4230-85e1-092a46e58e3c",
      "text": "vì nó sẽ khinh dể lời lẽ khôn ngoan của con.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:44.667Z",
      "updatedAt": "2025-09-03T02:42:44.667Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "979227c1-03d2-4fcc-875f-f6c7b87c19fc",
      "text": "Con chớ chuyển dời đường ranh cũ,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:44.681Z",
      "updatedAt": "2025-09-03T02:42:44.681Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "3b6b3b37-c085-4a81-ba69-6cf3f4d01716",
      "text": "cũng đừng xâm phạm cánh đồng của trẻ mồ côi,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:44.724Z",
      "updatedAt": "2025-09-03T02:42:44.724Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "53b2ffda-4995-43d8-be13-6ad497c4afe1",
      "text": "vì Đấng cứu chuộc chúng là Đấng hùng mạnh,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:44.737Z",
      "updatedAt": "2025-09-03T02:42:44.737Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "10ceda2d-1e87-4ecf-a3de-686f4778878d",
      "text": "chính Người sẽ biện hộ cho chúng chống lại con.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:44.771Z",
      "updatedAt": "2025-09-03T02:42:44.771Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "435fd3b8-9295-425e-98ad-5c0dea6dd533",
      "text": "Con hãy để tâm đón lấy lời huấn dụ,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:44.798Z",
      "updatedAt": "2025-09-03T02:42:44.798Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "11d2650c-12b9-4047-83d3-13e539becde8",
      "text": "và lắng tai nghe điều hiểu biết.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:44.813Z",
      "updatedAt": "2025-09-03T02:42:44.813Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "e1cd783b-611a-4fbd-abcb-49046eab8c0f",
      "text": "Đừng ngại gì khi phải phạt trẻ con,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:44.840Z",
      "updatedAt": "2025-09-03T02:42:44.840Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "e945a5f4-1b47-4768-903c-797a6155e9f0",
      "text": "nếu con đánh nó bằng roi, nó đâu có chết.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:44.853Z",
      "updatedAt": "2025-09-03T02:42:44.853Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "e5f53cfb-f58e-4f23-8ee1-0680dc30b610",
      "text": "Lấy roi đánh nó là cứu nó khỏi âm ty.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:44.882Z",
      "updatedAt": "2025-09-03T02:42:44.882Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "a6fdf9a6-2ba8-41a7-baf1-7c4f92da9d26",
      "text": "Hỡi con, tâm trí con khôn ngoan",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:44.924Z",
      "updatedAt": "2025-09-03T02:42:44.924Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "ecbe6052-2695-4a82-a6c0-7bbf7debaa93",
      "text": "thì lòng dạ thầy cũng vui sướng.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:44.938Z",
      "updatedAt": "2025-09-03T02:42:44.938Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "405a57a6-0d89-43d8-bd99-34b877319c07",
      "text": "Môi miệng con nói những lời chính trực",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:44.952Z",
      "updatedAt": "2025-09-03T02:42:44.952Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "d43a3c1a-62fd-4ad9-b3b7-f9d43411db16",
      "text": "thì tâm hồn thầy sẽ mừng rỡ hân hoan.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:44.966Z",
      "updatedAt": "2025-09-03T02:42:44.966Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "5976bc88-bb21-4e7c-b4ad-a8127475d836",
      "text": "Đừng để lòng con phân bì với quân tội lỗi,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:44.994Z",
      "updatedAt": "2025-09-03T02:42:44.994Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "43a1c146-8d3f-4a57-9188-086264ff71c9",
      "text": "nhưng hãy luôn kính sợ ĐỨC CHÚA,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:45.022Z",
      "updatedAt": "2025-09-03T02:42:45.022Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "2d1a1385-5f10-4cfb-92f8-ed1021b8792b",
      "text": "vì chắc chắn con có một tương lai",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:45.050Z",
      "updatedAt": "2025-09-03T02:42:45.050Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "80c71da5-204f-4270-beb3-4e57137bb3a3",
      "text": "và niềm hy vọng của con sẽ không thành mây khói.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:45.077Z",
      "updatedAt": "2025-09-03T02:42:45.077Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "33db3bf6-086f-4b5e-9b13-4ab070a76c66",
      "text": "Hỡi con, hãy nghe thầy và con sẽ nên khôn,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:45.091Z",
      "updatedAt": "2025-09-03T02:42:45.091Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "1b45294e-5522-4c68-9684-95d2b0fe15a9",
      "text": "hãy hướng lòng con theo chính đạo.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:45.105Z",
      "updatedAt": "2025-09-03T02:42:45.105Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "e67a0368-5adc-4797-987b-88cf406c89ea",
      "text": "Đừng nhập bọn với quân chè chén say sưa,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:45.123Z",
      "updatedAt": "2025-09-03T02:42:45.123Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "f7055038-c3ce-46a1-ad67-26cb81edce91",
      "text": "với những kẻ chỉ mê ăn mê nhậu.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:45.139Z",
      "updatedAt": "2025-09-03T02:42:45.139Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "187d9c87-e0ee-4d4f-a469-1b1e03904162",
      "text": "Bởi vì kẻ say sưa ăn nhậu ắt sẽ phải túng nghèo ;",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:45.157Z",
      "updatedAt": "2025-09-03T02:42:45.157Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "ea2db8d5-1869-4447-a59b-5bf85f91e307",
      "text": "kẻ mơ màng buồn ngủ sẽ khố rách áo ôm.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:45.170Z",
      "updatedAt": "2025-09-03T02:42:45.170Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "de3e7b2e-4103-4763-bc16-48b067acd0dd",
      "text": "Hãy lắng nghe cha con, đấng sinh thành ra con,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:45.199Z",
      "updatedAt": "2025-09-03T02:42:45.199Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "bf99d94f-44ad-4bd9-af4d-9a607ec05770",
      "text": "đừng khinh dể mẹ con khi người già yếu.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:45.213Z",
      "updatedAt": "2025-09-03T02:42:45.213Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "878cabc9-82b4-4987-8755-69b5d986afe5",
      "text": "Chân lý và khôn ngoan, nghiêm huấn và hiểu biết,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:45.240Z",
      "updatedAt": "2025-09-03T02:42:45.240Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "31286713-cf49-43c0-990c-2a9c059ab853",
      "text": "con hãy mua lấy chứ đừng bán đi.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:45.254Z",
      "updatedAt": "2025-09-03T02:42:45.254Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "d86f13d1-eb7e-4ba3-8404-70951a5d0b1e",
      "text": "Thân phụ người công chính sẽ mừng vui,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:45.268Z",
      "updatedAt": "2025-09-03T02:42:45.268Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "4ea83d19-1088-48bd-8a52-c741e8a8410c",
      "text": "đấng sinh thành người khôn sẽ hoan hỷ.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:45.281Z",
      "updatedAt": "2025-09-03T02:42:45.281Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "bc21ca0b-ffe3-41a1-bea3-356c15b5b406",
      "text": "Ước gì cha mẹ con được hỷ hoan",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:45.296Z",
      "updatedAt": "2025-09-03T02:42:45.296Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "4ec06cdb-4d6b-4e32-9f0b-cc1d505181a2",
      "text": "và người sinh ra con được mừng rỡ.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:45.324Z",
      "updatedAt": "2025-09-03T02:42:45.324Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "d0a7c9d5-2cb1-4fae-b8dd-530a34724b2c",
      "text": "Hỡi con, hãy hết lòng tin tưởng vào thầy",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:45.338Z",
      "updatedAt": "2025-09-03T02:42:45.338Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "ce0cc166-f68e-4753-9c23-f70fab31135f",
      "text": "và hãy để mắt noi gương thầy.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:45.352Z",
      "updatedAt": "2025-09-03T02:42:45.352Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "7e9efa7b-bbde-4cc9-81ad-633ae4f1bea9",
      "text": "Vì gái điếm là hố sâu",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:45.380Z",
      "updatedAt": "2025-09-03T02:42:45.380Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "5799a4ca-8dda-4e76-a2ca-752924c29aba",
      "text": "và phụ nữ ngoại tình là giếng hẹp.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:45.408Z",
      "updatedAt": "2025-09-03T02:42:45.408Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "d7dd51e6-3634-4067-a7bd-f7db4eca44c5",
      "text": "Nó khác nào kẻ cướp rình chờ",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:45.436Z",
      "updatedAt": "2025-09-03T02:42:45.436Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "9111288e-6878-43d4-a547-e301b55eada1",
      "text": "hòng tăng số những kẻ bất trung trong nhân loại.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 1,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:45.464Z",
      "updatedAt": "2025-09-03T02:42:45.464Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "8758638f-2366-4ee0-96eb-bf9e8b72ae70",
      "text": "Ai kêu : “Than ôi !” ? Ai kêu : “Khổ quá !” ?",
      "label": "29",
      "number": 29,
      "subVerseIndex": 0,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:45.478Z",
      "updatedAt": "2025-09-03T02:42:45.478Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "00f7d90d-cf7b-45b0-ae38-2973b868ea20",
      "text": "Ai cứ gây gổ ? Ai phải thở than ?",
      "label": "29",
      "number": 29,
      "subVerseIndex": 1,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:45.503Z",
      "updatedAt": "2025-09-03T02:42:45.503Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "ce9b26f9-f049-4219-b7e8-de31b2e9f517",
      "text": "Ai chịu những vết thương vô lý ?",
      "label": "29",
      "number": 29,
      "subVerseIndex": 2,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:45.515Z",
      "updatedAt": "2025-09-03T02:42:45.515Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "19af465c-fef1-4728-85fa-055da64956de",
      "text": "Ai có đôi mắt đỏ ngầu ?",
      "label": "29",
      "number": 29,
      "subVerseIndex": 3,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:45.529Z",
      "updatedAt": "2025-09-03T02:42:45.529Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "1150d30c-c93e-4743-955d-50b9814d3861",
      "text": "Đó là kẻ nấn ná mãi bên ly rượu,",
      "label": "30",
      "number": 30,
      "subVerseIndex": 0,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:45.541Z",
      "updatedAt": "2025-09-03T02:42:45.541Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "9931e48b-9375-4806-8dfd-e80d1e91a594",
      "text": "là người đã nếm đủ thứ rượu ngon.",
      "label": "30",
      "number": 30,
      "subVerseIndex": 1,
      "paragraphNumber": 61,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:45.554Z",
      "updatedAt": "2025-09-03T02:42:45.554Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "cd95abda-1b76-4278-9c2e-9147b524b409",
      "text": "Nhìn rượu làm chi : rượu màu đỏ hồng,",
      "label": "31",
      "number": 31,
      "subVerseIndex": 0,
      "paragraphNumber": 62,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:45.566Z",
      "updatedAt": "2025-09-03T02:42:45.566Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "711d4587-c918-411c-aa88-060d3192bac7",
      "text": "óng ánh trong ly, rồi trôi xuống cổ.",
      "label": "31",
      "number": 31,
      "subVerseIndex": 1,
      "paragraphNumber": 63,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:45.579Z",
      "updatedAt": "2025-09-03T02:42:45.579Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "4dff488e-5fe9-4b90-9ed0-05f39157f6c4",
      "text": "Nhưng rốt cuộc, rượu như rắn cắn,",
      "label": "32",
      "number": 32,
      "subVerseIndex": 0,
      "paragraphNumber": 64,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:45.591Z",
      "updatedAt": "2025-09-03T02:42:45.591Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "7091b60f-222d-446b-8579-73bffb65e611",
      "text": "như nọc độc hổ mang.",
      "label": "32",
      "number": 32,
      "subVerseIndex": 1,
      "paragraphNumber": 65,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:45.604Z",
      "updatedAt": "2025-09-03T02:42:45.604Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "d127fab3-0316-46ab-8f48-b2f1130cb055",
      "text": "Mắt con sẽ thấy những điều kỳ dị,",
      "label": "33",
      "number": 33,
      "subVerseIndex": 0,
      "paragraphNumber": 66,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:45.618Z",
      "updatedAt": "2025-09-03T02:42:45.618Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "6c16bbaa-8790-4175-a3e5-1109ddbd7ac2",
      "text": "lòng con tuôn ra bao chuyện nhảm nhí.",
      "label": "33",
      "number": 33,
      "subVerseIndex": 1,
      "paragraphNumber": 67,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:45.632Z",
      "updatedAt": "2025-09-03T02:42:45.632Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "bd1097a2-dbc1-4139-9b64-5c3b6154ea33",
      "text": "Con như người bồng bềnh giữa biển khơi,",
      "label": "34",
      "number": 34,
      "subVerseIndex": 0,
      "paragraphNumber": 68,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:45.646Z",
      "updatedAt": "2025-09-03T02:42:45.646Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "b1cc5b26-e849-4470-af29-876302752630",
      "text": "lắc lư trên cột buồm.",
      "label": "34",
      "number": 34,
      "subVerseIndex": 1,
      "paragraphNumber": 69,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:45.660Z",
      "updatedAt": "2025-09-03T02:42:45.660Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "bcd45965-ddb1-4fb4-bddf-ee773d50c89d",
      "text": "“Bị người đánh, tôi chẳng biết đau,",
      "label": "35",
      "number": 35,
      "subVerseIndex": 0,
      "paragraphNumber": 70,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:45.675Z",
      "updatedAt": "2025-09-03T02:42:45.675Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "fd8d9a84-6079-45e9-8ae3-b91dbadddca3",
      "text": "bị người đập, tôi đâu cảm thấy.",
      "label": "35",
      "number": 35,
      "subVerseIndex": 1,
      "paragraphNumber": 71,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:45.688Z",
      "updatedAt": "2025-09-03T02:42:45.688Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "80e405ef-631d-4dbd-8e86-d1cc87e42b69",
      "text": "Đến bao giờ mới tỉnh rượu đây",
      "label": "35",
      "number": 35,
      "subVerseIndex": 2,
      "paragraphNumber": 72,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:45.702Z",
      "updatedAt": "2025-09-03T02:42:45.702Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "57435c97-446e-4992-a0cf-c03d586d823b",
      "text": "để tôi lại kiếm thêm ly nữa ?”",
      "label": "35",
      "number": 35,
      "subVerseIndex": 3,
      "paragraphNumber": 73,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:45.716Z",
      "updatedAt": "2025-09-03T02:42:45.716Z",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    }
  ],
  "marks": [
    {
      "id": "c514d187-791e-42b7-a0c6-ca11c74a0a52",
      "content": "*Người đối diện* ở đây là kẻ có chức quyền. Cũng có thể hiểu câu này theo nghĩa : phải để ý đến những gì trước mặt mình, tức phải biết chọn đồ ăn.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 26,
      "endOffset": 26,
      "createdAt": "2025-09-03T02:42:44.385Z",
      "updatedAt": "2025-09-03T02:42:44.385Z",
      "targetId": "9493376a-6399-46a3-8a9f-bb20cdeb6ae8",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "72ac94cd-9533-4977-a4ed-86cdf453e0b9",
      "content": "Cn 23,6",
      "kind": "MARK_KIND_REFERENCE",
      "label": "1@",
      "sortOrder": 0,
      "startOffset": 5,
      "endOffset": 5,
      "createdAt": "2025-09-03T02:42:44.430Z",
      "updatedAt": "2025-09-03T02:42:44.430Z",
      "targetId": "d1c40705-d83e-44bf-a43e-f6684b85a9a5",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "99a9cfbf-6170-44f1-abc7-454af68db8f3"
    },
    {
      "id": "9cdf5d09-22cb-4f8e-99b2-b99c0c35664e",
      "content": "Có thể đây là lối nói gợi hình để chỉ sự tự chủ.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 38,
      "endOffset": 38,
      "createdAt": "2025-09-03T02:42:44.407Z",
