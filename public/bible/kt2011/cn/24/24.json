{
  "chapter": {
    "id": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1",
    "number": 24,
    "createdAt": "2025-09-03T01:07:51.667Z",
    "updatedAt": "2025-09-03T01:07:51.667Z",
    "bookId": "1ea97633-82d8-4f1a-bffc-dfb2da235911"
  },
  "verses": [
    {
      "id": "cec5b1b7-fa9d-4144-b3ab-124a772f87e6",
      "text": "Chớ phân bì với quân tội lỗi,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.149Z",
      "updatedAt": "2025-09-03T02:42:51.149Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "41bd68d8-8c3d-4c4d-987a-18a1c47509d6",
      "text": "cũng đừng ham bè bạn với chúng,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.184Z",
      "updatedAt": "2025-09-03T02:42:51.184Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "d7ccb8e5-4987-4afd-8e4b-f4f4cf80bbe1",
      "text": "vì lòng chúng chỉ nghĩ đến bạo hành",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.198Z",
      "updatedAt": "2025-09-03T02:42:51.198Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "74748d02-2f98-4994-b29d-c71455594fa7",
      "text": "và môi chúng toàn nói lời độc ác.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.212Z",
      "updatedAt": "2025-09-03T02:42:51.212Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "31f36cf4-564c-4fe5-a2c6-022e3c672316",
      "text": "Có khôn ngoan mới dựng được nhà,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.226Z",
      "updatedAt": "2025-09-03T02:42:51.226Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "18ea4f44-1ef1-4932-a852-e4c798ee4ca3",
      "text": "có sáng suốt mới biết xây cho vững.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.253Z",
      "updatedAt": "2025-09-03T02:42:51.253Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "fa4707e7-5e15-4425-a7df-d39f0f0414af",
      "text": "Nhờ hiểu biết, phòng ốc mới đầy dư",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.267Z",
      "updatedAt": "2025-09-03T02:42:51.267Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "9cd80460-c8c9-4c22-a498-6d716e62d207",
      "text": "mọi của cải sang trọng và quý giá.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.280Z",
      "updatedAt": "2025-09-03T02:42:51.280Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "a3ca59f9-90de-41d4-95ba-7649330cf142",
      "text": "Người khôn ngoan được nên mạnh mẽ,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.294Z",
      "updatedAt": "2025-09-03T02:42:51.294Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "8d6d57da-e68f-4362-bcbe-bef2cfec1dfd",
      "text": "kẻ hiểu biết làm sức mạnh gia tăng.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.307Z",
      "updatedAt": "2025-09-03T02:42:51.307Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "18606714-ceeb-4931-953c-5f51225f3052",
      "text": "Khi giao chiến, cần lời chỉ đạo,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.322Z",
      "updatedAt": "2025-09-03T02:42:51.322Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "26462683-2696-4c25-8e98-9577d1dee456",
      "text": "muốn thắng trận, cần nhiều cố vấn.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.353Z",
      "updatedAt": "2025-09-03T02:42:51.353Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "0a9cc500-b651-410c-a03c-d567e1e009ae",
      "text": "Đối với kẻ ngu, đức khôn ngoan cao vời vợi,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.380Z",
      "updatedAt": "2025-09-03T02:42:51.380Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "1f2da459-8127-483b-a94a-396c6b9f46f6",
      "text": "nơi cổng thành, nó chẳng dám hé môi.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.408Z",
      "updatedAt": "2025-09-03T02:42:51.408Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "560feb65-e02a-4fcc-8046-37e7527d013f",
      "text": "Kẻ mưu tính những chuyện gian tà",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.422Z",
      "updatedAt": "2025-09-03T02:42:51.422Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "12f1391a-78c3-4287-a46a-1c83e4c94fe1",
      "text": "sẽ bị gọi là vua bịp bợm.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.436Z",
      "updatedAt": "2025-09-03T02:42:51.436Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "d57357e7-a783-4197-81d7-5b713e1183c1",
      "text": "Kẻ ngu si chỉ mưu toan tội lỗi,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.452Z",
      "updatedAt": "2025-09-03T02:42:51.452Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "afaa3eee-7f8b-4d54-8496-f157ca81b0d5",
      "text": "quân chế nhạo bị kẻ ghét người khinh.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.465Z",
      "updatedAt": "2025-09-03T02:42:51.465Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "5d187c7b-569b-4ecc-b066-97113afea5cd",
      "text": "Ngày khốn quẫn mà để mất tinh thần,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.487Z",
      "updatedAt": "2025-09-03T02:42:51.487Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "f71b1821-ed94-4235-9709-276a47eb3c31",
      "text": "sức lực con ắt sẽ bị suy giảm.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.497Z",
      "updatedAt": "2025-09-03T02:42:51.497Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "83ca852c-ee88-4b10-9c3d-952f3f531d68",
      "text": "Hãy giải thoát những người bị đem đi giết,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.507Z",
      "updatedAt": "2025-09-03T02:42:51.507Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "0498b290-97ef-4a1b-99e7-71abe85693c2",
      "text": "cứu những ai lảo đảo bước đến pháp trường.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.517Z",
      "updatedAt": "2025-09-03T02:42:51.517Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "7bc3317e-f284-4677-9425-e31302e4f591",
      "text": "Giả như con bảo : “Tôi đâu biết chuyện ấy”,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.537Z",
      "updatedAt": "2025-09-03T02:42:51.537Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "9ea5cc4d-bd48-459c-8e95-020b1e343e90",
      "text": "thì Đấng đo lòng người lại không hiểu hết sao ?",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.554Z",
      "updatedAt": "2025-09-03T02:42:51.554Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "d675fe42-3beb-467f-96bc-305547adf9fb",
      "text": "Đấng canh giữ lòng con thấu suốt cả,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.564Z",
      "updatedAt": "2025-09-03T02:42:51.564Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "3c8ede0c-8c1f-4f95-98a9-6457086d22c1",
      "text": "Người sẽ thưởng phạt ai nấy theo việc họ làm.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 3,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.574Z",
      "updatedAt": "2025-09-03T02:42:51.574Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "6a22ba58-f234-4d74-88fd-6d83c381b56a",
      "text": "Hỡi con, cứ ăn đi, mật ong ngon lắm,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.594Z",
      "updatedAt": "2025-09-03T02:42:51.594Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "4078ccd3-7e79-4d4f-8a0a-b4ad808fe707",
      "text": "mật ong nguyên chất ngọt ngào trong miệng con.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.605Z",
      "updatedAt": "2025-09-03T02:42:51.605Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "067592df-d9b4-4aa8-8eb4-f6e8bd7bd93d",
      "text": "Con nên nhớ : đức khôn ngoan đối với con cũng vậy.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.615Z",
      "updatedAt": "2025-09-03T02:42:51.615Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "ce030b04-0ff9-4dbd-9fff-d79de0cbe227",
      "text": "Nếu con gặp được, hẳn sẽ có tương lai,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.625Z",
      "updatedAt": "2025-09-03T02:42:51.625Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "904753b9-84be-4998-97a5-b540679ff86a",
      "text": "và niềm hy vọng của con sẽ không tan vỡ.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 2,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.635Z",
      "updatedAt": "2025-09-03T02:42:51.635Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "e38b40d4-ab79-4d22-8abe-480ca2f07db7",
      "text": "Này kẻ gian, chớ rình rập nhà người công chính,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.655Z",
      "updatedAt": "2025-09-03T02:42:51.655Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "9eb87b6e-9af6-4e32-99a6-815051e8ecaf",
      "text": "cũng đừng phá phách nơi họ ở.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.665Z",
      "updatedAt": "2025-09-03T02:42:51.665Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "c5a56076-1336-4b6e-a2ca-804bbf66f66e",
      "text": "Vì chính nhân có ngã bảy lần cũng đứng lên được,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.675Z",
      "updatedAt": "2025-09-03T02:42:51.675Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "5ed27963-c2cd-4904-979a-4d26831d0814",
      "text": "còn kẻ ác cứ lảo đảo hoài trong cảnh tai ương.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.695Z",
      "updatedAt": "2025-09-03T02:42:51.695Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "dcf758d3-cf90-44b0-8bd5-8d6470a9f84e",
      "text": "Khi quân thù gục ngã, con đừng lấy làm vui,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.705Z",
      "updatedAt": "2025-09-03T02:42:51.705Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "3848d4b5-d63a-47f3-b202-01a0fe8510d9",
      "text": "lúc nó bị lảo đảo, lòng con chớ reo mừng,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.717Z",
      "updatedAt": "2025-09-03T02:42:51.717Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "da800ba8-9370-4b4a-9152-586bfd61e73c",
      "text": "kẻo ĐỨC CHÚA trông thấy mà gai mắt",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.728Z",
      "updatedAt": "2025-09-03T02:42:51.728Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "7acbf9a8-2164-4b42-b501-dba28a1de22d",
      "text": "và không nổi giận với nó nữa đâu.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.749Z",
      "updatedAt": "2025-09-03T02:42:51.749Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "f9ec60f8-ef70-4772-a6da-0f9bbc9f89a6",
      "text": "Đừng ganh ghét với bọn bất lương,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.771Z",
      "updatedAt": "2025-09-03T02:42:51.771Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "4e4b9643-4571-497b-8769-eb8c0bc075a6",
      "text": "chớ ghen tuông cùng phường gian ác.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.782Z",
      "updatedAt": "2025-09-03T02:42:51.782Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "168ee9d5-23df-49c6-a662-e1bad5075029",
      "text": "Vì bọn bất lương chẳng có tương lai,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.804Z",
      "updatedAt": "2025-09-03T02:42:51.804Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "b1fb7d35-fdbc-4844-8f59-fe9b8ce004be",
      "text": "và ngọn đèn của phường gian ác sẽ tàn lụi.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.818Z",
      "updatedAt": "2025-09-03T02:42:51.818Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "a72a6826-dbf7-4fa8-92db-70532dfbbacb",
      "text": "Hỡi con, hãy kính sợ ĐỨC CHÚA và nhà vua,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.846Z",
      "updatedAt": "2025-09-03T02:42:51.846Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "f6f1317b-49a0-42dd-b08f-bf306fdd3384",
      "text": "đừng giao du với những quân nổi loạn.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.874Z",
      "updatedAt": "2025-09-03T02:42:51.874Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "28ff1e62-c35d-4fa9-9735-eac458d9e705",
      "text": "Vì tai hoạ sẽ giáng xuống bất ngờ,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.888Z",
      "updatedAt": "2025-09-03T02:42:51.888Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "1f85af3b-996e-4eac-a9d2-02e2ef268e4a",
      "text": "cả hai sẽ tiêu diệt chúng ra sao, nào có ai lường được ?",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.902Z",
      "updatedAt": "2025-09-03T02:42:51.902Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "9d63b722-2508-46ec-a723-b06b0f7798fe",
      "text": "Những câu sau đây cũng là của bậc khôn ngoan :",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:42:51.916Z",
      "updatedAt": "2025-09-03T02:42:51.916Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "48822db5-0ffc-4277-bbda-48f51401ff66",
      "text": "Xét xử thiên vị là điều không tốt.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.943Z",
      "updatedAt": "2025-09-03T02:42:51.943Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "6363de35-0566-4b76-b19e-f6baf80d0ad0",
      "text": "Ai bảo kẻ gian ác rằng : “Anh vô tội !”",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.970Z",
      "updatedAt": "2025-09-03T02:42:51.970Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "b71ab712-54d9-4d43-9b5b-f9d8006bd135",
      "text": "thì sẽ bị các dân nguyền rủa, các nước cười chê.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:51.998Z",
      "updatedAt": "2025-09-03T02:42:51.998Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "f03b8954-a131-442a-aff0-5fc76d14c25b",
      "text": "Còn ai răn đe nó, ắt sẽ được mừng vui",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:52.012Z",
      "updatedAt": "2025-09-03T02:42:52.012Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "539df935-1e8a-440f-acfb-b3916089a5cf",
      "text": "và phúc lành sẽ đến trên người đó.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:52.025Z",
      "updatedAt": "2025-09-03T02:42:52.025Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "792ce45a-5691-4b03-b499-53519d5c69c9",
      "text": "Ai trả lời thẳng thắn mới là người bạn thật.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:52.040Z",
      "updatedAt": "2025-09-03T02:42:52.040Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "e3eb218a-530c-42d5-bc19-20ce2923c894",
      "text": "Hãy ổn định mọi chuyện bên ngoài",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:52.068Z",
      "updatedAt": "2025-09-03T02:42:52.068Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "523afedb-17e8-4636-a7eb-7b06ea23a564",
      "text": "và thu xếp công việc đồng áng,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:52.081Z",
      "updatedAt": "2025-09-03T02:42:52.081Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "a3bab4c2-e19b-4814-b115-eb06cd77b2c3",
      "text": "rồi sau đó mới lo dựng nhà.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 2,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:52.095Z",
      "updatedAt": "2025-09-03T02:42:52.095Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "dfe3d8fa-b4f4-4e3d-b9cb-dd0eca6727db",
      "text": "Đừng vô cớ làm chứng hại bạn bè,",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:52.129Z",
      "updatedAt": "2025-09-03T02:42:52.129Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "07e011a7-42c2-48f6-a251-18a48562e8c3",
      "text": "cũng đừng nói ngọt nói ngon mà lừa đảo họ.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 1,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:52.143Z",
      "updatedAt": "2025-09-03T02:42:52.143Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "779e3336-ecbd-42a4-a68f-826c8497559f",
      "text": "Con đừng nói : “Hắn đối xử với tôi ra sao,",
      "label": "29",
      "number": 29,
      "subVerseIndex": 0,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:52.156Z",
      "updatedAt": "2025-09-03T02:42:52.156Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "e9ad804f-78a0-486f-8302-caa6553d6afc",
      "text": "tôi xử lại với hắn như vậy.",
      "label": "29",
      "number": 29,
      "subVerseIndex": 1,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:52.170Z",
      "updatedAt": "2025-09-03T02:42:52.170Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "f5402929-1850-4e9d-ba2b-2baed605c47f",
      "text": "Tôi trả báo từng người theo việc họ làm.”",
      "label": "29",
      "number": 29,
      "subVerseIndex": 2,
      "paragraphNumber": 61,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:52.184Z",
      "updatedAt": "2025-09-03T02:42:52.184Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "9a9aa597-8a49-4191-8784-d1beee5abcf8",
      "text": "Tôi đi ngang cánh đồng của người biếng nhác,",
      "label": "30",
      "number": 30,
      "subVerseIndex": 0,
      "paragraphNumber": 62,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:52.212Z",
      "updatedAt": "2025-09-03T02:42:52.212Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "80457a3a-9871-4081-80c4-349b9ae34d1b",
      "text": "qua vườn nho của kẻ ngu si.",
      "label": "30",
      "number": 30,
      "subVerseIndex": 1,
      "paragraphNumber": 63,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:52.239Z",
      "updatedAt": "2025-09-03T02:42:52.239Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "fe6ea89e-206b-47ab-b1e5-6c2862010814",
      "text": "Và này : chỗ nào cũng um tùm gai góc,",
      "label": "31",
      "number": 31,
      "subVerseIndex": 0,
      "paragraphNumber": 64,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:52.252Z",
      "updatedAt": "2025-09-03T02:42:52.252Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "55d9a9ec-cf28-4e73-ad43-92516b2d2073",
      "text": "khắp mặt đất phủ đầy cỏ dại,",
      "label": "31",
      "number": 31,
      "subVerseIndex": 1,
      "paragraphNumber": 65,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:52.267Z",
      "updatedAt": "2025-09-03T02:42:52.267Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "57be52b9-38f8-4651-ba61-62f74fbf5011",
      "text": "tường đá bị sụp đổ hoang tàn.",
      "label": "31",
      "number": 31,
      "subVerseIndex": 2,
      "paragraphNumber": 66,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:52.281Z",
      "updatedAt": "2025-09-03T02:42:52.281Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "3d51377b-f466-4946-b672-feb4a9c9b96a",
      "text": "Tôi đã nhìn và để tâm suy nghĩ,",
      "label": "32",
      "number": 32,
      "subVerseIndex": 0,
      "paragraphNumber": 67,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:52.295Z",
      "updatedAt": "2025-09-03T02:42:52.295Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "7d9d12dd-38fa-43b3-818e-2da7690145bb",
      "text": "tôi đã thấy và rút ra bài học này :",
      "label": "32",
      "number": 32,
      "subVerseIndex": 1,
      "paragraphNumber": 68,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:52.308Z",
      "updatedAt": "2025-09-03T02:42:52.308Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "c238cfd7-6309-4990-962b-dd4d2a551e8e",
      "text": "Ngủ một chút, chợp mắt một chút,",
      "label": "33",
      "number": 33,
      "subVerseIndex": 0,
      "paragraphNumber": 69,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:52.322Z",
      "updatedAt": "2025-09-03T02:42:52.322Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "619ef82c-39f4-40cd-9c52-15ce543a1140",
      "text": "khoanh tay nằm một chút,",
      "label": "33",
      "number": 33,
      "subVerseIndex": 1,
      "paragraphNumber": 70,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:52.336Z",
      "updatedAt": "2025-09-03T02:42:52.336Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "355c0379-c794-454d-bac8-307ecae0efbb",
      "text": "là cái nghèo sẽ đến với bạn như tên du thủ du thực,",
      "label": "34",
      "number": 34,
      "subVerseIndex": 0,
      "paragraphNumber": 71,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:52.350Z",
      "updatedAt": "2025-09-03T02:42:52.350Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    },
    {
      "id": "1a0ad68e-f772-4583-a368-23bfa1958739",
      "text": "cảnh bần cùng sẽ đột nhập như người có vũ trang.",
      "label": "34",
      "number": 34,
      "subVerseIndex": 1,
      "paragraphNumber": 72,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:52.364Z",
      "updatedAt": "2025-09-03T02:42:52.364Z",
      "chapterId": "3739d7ec-1870-4a30-9493-34d5fc7b0eb1"
    }
  ],
