    },
    {
      "id": "3c3af88e-7194-402f-9728-7981bd2b73d3",
      "content": "Cn 14,1",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 18,
      "endOffset": 18,
