{
  "chapter": {
    "id": "f375edc7-d5d2-4fad-9fec-f0e541747e1a",
    "number": 25,
    "createdAt": "2025-09-03T01:07:51.667Z",
    "updatedAt": "2025-09-03T01:07:51.667Z",
    "bookId": "1ea97633-82d8-4f1a-bffc-dfb2da235911"
  },
  "verses": [
    {
      "id": "817b553f-b4b0-4922-8fb6-9206fe6f0f6c",
      "text": "Đây cũng là những châm ngôn của vua Sa-lô-môn",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:57.802Z",
      "updatedAt": "2025-09-03T02:42:57.802Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "b3bdc793-4dec-483a-889c-e00d08961511",
      "text": "được quần thần của Khít-ki-gia, vua nước Giu-đa, ghi chép lại.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:57.882Z",
      "updatedAt": "2025-09-03T02:42:57.882Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "927f5d31-f26a-46b1-9e21-57e90d33d2b3",
      "text": "Thiên Chúa vinh quang khi giấu kín việc Người làm,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:57.924Z",
      "updatedAt": "2025-09-03T02:42:57.924Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "aa44ba2a-5bdf-4ce1-b776-c9c75bbc3e7b",
      "text": "đức vua vinh quang khi thấu hiểu việc nước.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:57.941Z",
      "updatedAt": "2025-09-03T02:42:57.941Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "775b50a2-5d9f-41c4-a35e-049039555535",
      "text": "Như trời cao đất dày,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:57.969Z",
      "updatedAt": "2025-09-03T02:42:57.969Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "86282bd3-4ad2-4578-8d28-647c9a179de9",
      "text": "tâm trí bậc đế vương thật vô phương dò thấu.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:57.982Z",
      "updatedAt": "2025-09-03T02:42:57.982Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "e944ea87-3b89-4910-b57d-5a25472f4b7a",
      "text": "Lọc hết cặn bẩn ra khỏi bạc,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:57.996Z",
      "updatedAt": "2025-09-03T02:42:57.996Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "591a2495-8717-4340-a53a-4d577bc0ce11",
      "text": "thợ bạc sẽ có một cái bình.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.011Z",
      "updatedAt": "2025-09-03T02:42:58.011Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "e103bc1c-2ad5-4042-93d2-73b15936f1b2",
      "text": "Loại người gian ác khỏi long nhan,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.038Z",
      "updatedAt": "2025-09-03T02:42:58.038Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "1863fd82-3bdc-4bc5-90ce-04aefc6083ae",
      "text": "ngai vàng sẽ kiên vững trên nền công chính.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.052Z",
      "updatedAt": "2025-09-03T02:42:58.052Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "9a2df9bb-33a1-4023-b068-6cf716b064f3",
      "text": "Trước long nhan, đừng lên mặt kiêu kỳ,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.080Z",
      "updatedAt": "2025-09-03T02:42:58.080Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "a1f53fb3-bf7b-4b04-8af9-eb5a87159f7a",
      "text": "chớ đứng vào chỗ của hàng vị vọng.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.094Z",
      "updatedAt": "2025-09-03T02:42:58.094Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "afb45da9-7bb0-42ae-aa08-bfa9d54884e3",
      "text": "Thà được người ta bảo : “Xin mời ông lên trên !”",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.122Z",
      "updatedAt": "2025-09-03T02:42:58.122Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "f4d111d9-e177-4e66-abcd-90d08cde9d5b",
      "text": "còn hơn bị hạ xuống trước mặt người quyền cao chức trọng.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.165Z",
      "updatedAt": "2025-09-03T02:42:58.165Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "2d30fddc-1320-4c7f-a03a-dc56bdf8fb8a",
      "text": "Điều mắt con nhìn thấy,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.178Z",
      "updatedAt": "2025-09-03T02:42:58.178Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "ca83cfe3-8555-4aa4-821d-0247ad71d982",
      "text": "con đừng vội đem ra trước toà,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.192Z",
      "updatedAt": "2025-09-03T02:42:58.192Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "1a702779-07a6-4044-ac84-a1796eb873bb",
      "text": "vì nếu đối phương làm cho con phải xấu hổ,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.206Z",
      "updatedAt": "2025-09-03T02:42:58.206Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "6284c538-0dcf-4a82-a2ae-8ae6d67a5f17",
      "text": "thì rốt cuộc con sẽ ăn nói ra sao ?",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.221Z",
      "updatedAt": "2025-09-03T02:42:58.221Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "4e41214c-26c5-426e-99e8-f86b3c5f3405",
      "text": "Cứ tranh cãi với đối phương,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.235Z",
      "updatedAt": "2025-09-03T02:42:58.235Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "1517cd58-0ed8-4365-b58c-9733dd3b907e",
      "text": "nhưng đừng tiết lộ chuyện riêng của người khác,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.248Z",
      "updatedAt": "2025-09-03T02:42:58.248Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "8fcc84f6-c860-4dde-ab10-32e8dd71586d",
      "text": "kẻo có ai nghe được, họ sẽ phỉ báng con,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.262Z",
      "updatedAt": "2025-09-03T02:42:58.262Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "bfdef3b8-bf4d-4d6a-a420-c24a161f877f",
      "text": "và con không rút lại được những lời nói xấu.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.276Z",
      "updatedAt": "2025-09-03T02:42:58.276Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "67f1d4c8-59ff-4a54-9ace-5096f34938f8",
      "text": "Lời nói ra đúng lúc đúng thời",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.290Z",
      "updatedAt": "2025-09-03T02:42:58.290Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "a22c32bf-1e58-440f-b117-b36ede14ed29",
      "text": "khác chi táo vàng trên đĩa bạc chạm trổ.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.304Z",
      "updatedAt": "2025-09-03T02:42:58.304Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "3e51b60a-ab31-449f-a5fc-7839ae79faa8",
      "text": "Đối với kẻ biết nghe, lời trách cứ của người khôn",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.332Z",
      "updatedAt": "2025-09-03T02:42:58.332Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "ae739176-db62-41f1-849f-497e97842d60",
      "text": "tựa nhẫn vàng hay kiềng vàng hảo hạng.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.346Z",
      "updatedAt": "2025-09-03T02:42:58.346Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "f48aec00-05d0-4b03-b6a7-3cd498f4771b",
      "text": "Sứ giả trung tín với kẻ sai mình đi",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.360Z",
      "updatedAt": "2025-09-03T02:42:58.360Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "fb762ffe-7c0f-455b-8730-178bb147adb8",
      "text": "thì đáng quý như tuyết mát ngày mùa :",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.387Z",
      "updatedAt": "2025-09-03T02:42:58.387Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "ddfd0d9c-a74a-4ae0-9538-6e0340c86b73",
      "text": "người đó làm vững lòng ông chủ.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.416Z",
      "updatedAt": "2025-09-03T02:42:58.416Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "f0442969-df59-4c68-a375-08294c8546fb",
      "text": "Kẻ to miệng hứa tặng quà mà không giữ lời hứa",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.430Z",
      "updatedAt": "2025-09-03T02:42:58.430Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "32b1e92c-cd88-4fb8-8aaf-043e1bde68a7",
      "text": "chẳng khác nào có mây, có gió mà chẳng có mưa.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.444Z",
      "updatedAt": "2025-09-03T02:42:58.444Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "962735f3-4c24-4d8c-9239-ab7cc5da2570",
      "text": "Cứ kiên nhẫn, thủ lãnh sẽ xiêu lòng,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.459Z",
      "updatedAt": "2025-09-03T02:42:58.459Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "be220090-d882-4d77-8a71-1c616c7d72b4",
      "text": "lời mềm mỏng làm nát tan xương cốt.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.473Z",
      "updatedAt": "2025-09-03T02:42:58.473Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "8166eb40-5a78-4d9e-b15f-217559c94b89",
      "text": "Kiếm được mật, con chỉ ăn vừa đủ,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.501Z",
      "updatedAt": "2025-09-03T02:42:58.501Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "592faef7-6be1-4605-ad9f-745d27ba739c",
      "text": "ăn quá nhiều, ắt sẽ mửa ra thôi.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.528Z",
      "updatedAt": "2025-09-03T02:42:58.528Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "2322e59c-df1b-4a64-a5ee-1746cf72950f",
      "text": "Đừng năng lui tới với bạn bè,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.545Z",
      "updatedAt": "2025-09-03T02:42:58.545Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "fbb907dd-a2e0-4cb8-90a3-0cdb24474bc9",
      "text": "kẻo nó chán ngấy con mà đem lòng ghét bỏ.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.561Z",
      "updatedAt": "2025-09-03T02:42:58.561Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "6eddd786-d959-4c6d-8762-aa056fc8a74f",
      "text": "Kẻ làm chứng gian hại bạn bè",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.576Z",
      "updatedAt": "2025-09-03T02:42:58.576Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "2d47c4ce-2278-4542-8b57-ca8881c6693b",
      "text": "chẳng khác nào chuỳ, gươm và tên nhọn.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.603Z",
      "updatedAt": "2025-09-03T02:42:58.603Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "40f8c3f4-0869-4285-a985-c5092f0890aa",
      "text": "Trong ngày khốn quẫn,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.617Z",
      "updatedAt": "2025-09-03T02:42:58.617Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "5cc4cd9d-064d-43eb-bbc0-fc7b652f3856",
      "text": "lòng tin tưởng vào đứa bất trung",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.630Z",
      "updatedAt": "2025-09-03T02:42:58.630Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "748963b3-6783-4bb3-b9b2-5b286cfd01ce",
      "text": "sẽ như răng lung lay, như chân lảo đảo.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 2,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.644Z",
      "updatedAt": "2025-09-03T02:42:58.644Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "f7e27a3b-7114-4e21-b977-157a5343b131",
      "text": "Ca hát khi người khác khổ đau",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.658Z",
      "updatedAt": "2025-09-03T02:42:58.658Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "666b5e0e-d2e7-478c-b9f9-7543016ce410",
      "text": "thì như lột áo lúc trời lạnh",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.672Z",
      "updatedAt": "2025-09-03T02:42:58.672Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "9262f3b5-7379-44f7-9be4-8730df34d865",
      "text": "hay đổ thêm giấm vào nước chanh.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 2,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.686Z",
      "updatedAt": "2025-09-03T02:42:58.686Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "4e6c00e9-9d1e-4b41-ad3d-84ee0b701624",
      "text": "Kẻ thù con có đói, hãy cho nó bánh ăn,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.700Z",
      "updatedAt": "2025-09-03T02:42:58.700Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "64449774-9ba0-4455-aebc-76d4d8e4e61e",
      "text": "nó có khát, hãy cho nước uống.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.714Z",
      "updatedAt": "2025-09-03T02:42:58.714Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "451d3cbb-17a5-4ad2-a370-d31696a56398",
      "text": "Như vậy là chất than hồng lên đầu nó,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.728Z",
      "updatedAt": "2025-09-03T02:42:58.728Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "67b7fa19-0134-4a10-827f-8da441c052ad",
      "text": "và ĐỨC CHÚA sẽ thưởng cho con.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.773Z",
      "updatedAt": "2025-09-03T02:42:58.773Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "79ebbbc4-9788-42be-89c7-a39faa5ac9b9",
      "text": "Như gió bấc khiến trời đổ mưa,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.801Z",
      "updatedAt": "2025-09-03T02:42:58.801Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "16c66f71-a2ff-4ea6-a0ee-61e764f74b76",
      "text": "lời nói lén làm người ta nổi giận.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.815Z",
      "updatedAt": "2025-09-03T02:42:58.815Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "cd89ee5b-7289-47d6-b3d6-cc56a4f2b19c",
      "text": "Thà ở một góc trên mái nhà,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.828Z",
      "updatedAt": "2025-09-03T02:42:58.828Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "67fe1603-1ec1-44be-99da-b5ebe61afb52",
      "text": "còn hơn chung sống với một bà hay gây.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.842Z",
      "updatedAt": "2025-09-03T02:42:58.842Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "994cac3a-ffa7-4d8d-8475-8910a2975b53",
      "text": "Tin vui từ phương xa đến",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.870Z",
      "updatedAt": "2025-09-03T02:42:58.870Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "e204319f-6746-459b-9dd4-c18404f1ca28",
      "text": "tựa nước mát khi cổ họng ráo khô.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.884Z",
      "updatedAt": "2025-09-03T02:42:58.884Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "32e95488-cbc1-4755-bd37-23f433bb9525",
      "text": "Nước bị đục, suối bị dơ,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.901Z",
      "updatedAt": "2025-09-03T02:42:58.901Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "52fe872a-81ab-4c68-a6cb-ef8ba93954d3",
      "text": "chính nhân bị kẻ gian ác làm nghiêng ngửa.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.932Z",
      "updatedAt": "2025-09-03T02:42:58.932Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "36baeb44-a2b4-4288-bb3c-c77ce1796777",
      "text": "Mật ong, ăn quá nhiều không tốt,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.945Z",
      "updatedAt": "2025-09-03T02:42:58.945Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "07df2a6f-4669-420d-b8e7-113ba27a7a27",
      "text": "những lời ca ngợi, con chớ mải kiếm tìm.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:58.973Z",
      "updatedAt": "2025-09-03T02:42:58.973Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "ba0392de-0286-41be-8c9a-9af95df9b16d",
      "text": "Người không biết tự chủ",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:59.001Z",
      "updatedAt": "2025-09-03T02:42:59.001Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "f00470b5-2079-4f9d-807c-9bb27f95ecc7",
      "text": "ví như thành bỏ ngỏ, không tường luỹ chở che.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 1,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:42:59.014Z",
      "updatedAt": "2025-09-03T02:42:59.014Z",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    }
  ],
  "marks": [
    {
      "id": "bb69cee2-0898-4ea7-8f0e-df8b70c289ed",
      "content": "Bộ sưu tập này (25,1 – 29,27) do các viên chức của vua Khít-ki-gia (715-688 tCN) thực hiện. Họ đã thu thập những châm ngôn bắt nguồn từ thời Sa-lô-môn (từ chính Sa-lô-môn hay từ các trường trong triều do ông sáng lập). Sưu tập này lặp lại nhiều châm ngôn trong sưu tập trước (ch. 10-22). Đức Chúa ít được nhắc đến : sáu lần trong năm chương. Các chương 25-27 cho ta những châm ngôn thuộc một nền khôn ngoan cổ xưa hơn, ít mang tính tôn giáo. Hai chương sau là những suy tư trực tiếp hơn về lối sống đạo của Ít-ra-en.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
