    },
    {
      "id": "b18980b6-8a66-4184-bb73-c96b2d737a25",
      "content": "Cn 13,17",
      "kind": "MARK_KIND_REFERENCE",
      "label": "5@",
      "sortOrder": 4,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:42:58.374Z",
      "updatedAt": "2025-09-03T02:42:58.374Z",
      "targetId": "f48aec00-05d0-4b03-b6a7-3cd498f4771b",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f375edc7-d5d2-4fad-9fec-f0e541747e1a"
    },
    {
      "id": "fea33036-e1b2-407e-8682-c759b0d2ecda",
      "content": "Việc làm của Chúa trong vũ trụ và lịch sử thật là mầu nhiệm ẩn giấu. Vị minh quân là người đưa chân lý ra ánh sáng.",
      "kind": "MARK_KIND_FOOTNOTE",
