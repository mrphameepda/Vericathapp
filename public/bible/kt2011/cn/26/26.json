      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "f9f39527-87d2-4c7b-9ade-36b08ab89699",
      "content": "Cn 26,9",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 17,
      "endOffset": 17,
