    {
      "id": "97238fb8-71e8-4ad9-9498-8c8d0c9807e4",
      "content": "Hai câu 4 và 5 có vẻ ngược nhau, nhưng cho thấy cần biết nhận định khi phải xử đối với người ngu, sao cho ích lợi hơn cả.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 26,
      "endOffset": 26,
      "createdAt": "2025-09-03T02:43:04.132Z",
