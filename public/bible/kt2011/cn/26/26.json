    },
    {
      "id": "db43c41e-8f08-43ee-8b3e-7747ec7fabe6",
      "content": "Câu không rõ.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 37,
      "endOffset": 37,
      "createdAt": "2025-09-03T02:43:04.376Z",
