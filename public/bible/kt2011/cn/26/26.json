{
  "chapter": {
    "id": "1fdb2167-7591-4694-a48c-e24339d13c7c",
    "number": 26,
    "createdAt": "2025-09-03T01:07:51.667Z",
    "updatedAt": "2025-09-03T01:07:51.667Z",
    "bookId": "1ea97633-82d8-4f1a-bffc-dfb2da235911"
  },
  "verses": [
    {
      "id": "68de7374-ab49-4f2c-baa4-ee404f13a20a",
      "text": "Tuyết đâu rơi mùa hè, trời đâu mưa mùa gặt,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:03.983Z",
      "updatedAt": "2025-09-03T02:43:03.983Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "4dd7fb78-3885-4af4-a713-dcc469f4da1c",
      "text": "quyền cao chức trọng đâu hợp với kẻ ngu si.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.001Z",
      "updatedAt": "2025-09-03T02:43:04.001Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "2e6c43d4-4178-458a-86a7-71eb8d0a1c9c",
      "text": "Như chim sẻ bay, như chim én lượn,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.012Z",
      "updatedAt": "2025-09-03T02:43:04.012Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "62718fd9-f854-4b9a-80f5-b9bd258676eb",
      "text": "lời nguyền rủa vô cớ cũng chẳng đi tới đâu.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.023Z",
      "updatedAt": "2025-09-03T02:43:04.023Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "8c044ce5-990e-405e-9707-0ec361a1b2e8",
      "text": "Roi dành cho ngựa, hàm thiếc cho lừa,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.034Z",
      "updatedAt": "2025-09-03T02:43:04.034Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "6f3169c3-6b81-4939-8c85-a474d6d95b55",
      "text": "đòn vọt dành cho lưng đứa ngu xuẩn.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.047Z",
      "updatedAt": "2025-09-03T02:43:04.047Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "f6f090f4-bcce-416f-98e2-43b555e5a2b6",
      "text": "Đừng đáp lại đứa ngu theo cái ngu của nó,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.075Z",
      "updatedAt": "2025-09-03T02:43:04.075Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "08412978-d33e-46ba-9801-ef2971dbe88e",
      "text": "kẻo chính con cũng lại giống nó thôi.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.089Z",
      "updatedAt": "2025-09-03T02:43:04.089Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "87c94f1b-121d-4ccc-8edf-98aaad537ab5",
      "text": "Hãy đáp lại đứa ngu theo cái ngu của nó,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.104Z",
      "updatedAt": "2025-09-03T02:43:04.104Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "66752e04-1876-429d-acbd-244f40662d55",
      "text": "kẻo nó cứ tưởng là nó khôn.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.118Z",
      "updatedAt": "2025-09-03T02:43:04.118Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "3510007a-d4ef-439b-af53-01d6356bf416",
      "text": "Nhờ đứa ngu chuyển giùm sứ điệp",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.146Z",
      "updatedAt": "2025-09-03T02:43:04.146Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "0f517d46-befc-4d86-b591-03463fafdf14",
      "text": "chẳng khác chi tự chặt chân mình",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.173Z",
      "updatedAt": "2025-09-03T02:43:04.173Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "0d89f172-78d1-4db9-a5a0-2da75838e369",
      "text": "và gánh lấy biết bao tai hoạ.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.190Z",
      "updatedAt": "2025-09-03T02:43:04.190Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "037f60a0-6151-4346-a3ae-155139f1ef28",
      "text": "Đứa dốt mở miệng nói khôn nói ngoan",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.203Z",
      "updatedAt": "2025-09-03T02:43:04.203Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "4cd21318-9fc6-422f-a1cf-8ec6cc550f67",
      "text": "thì cũng như anh què đi khập khiễng.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.233Z",
      "updatedAt": "2025-09-03T02:43:04.233Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "e58d6505-d23a-45a0-8631-0ab4b19111f6",
      "text": "Bày tỏ lòng kính trọng đứa ngu",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.247Z",
      "updatedAt": "2025-09-03T02:43:04.247Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "1ce1975e-bdae-4fdb-ad67-da454b8109fe",
      "text": "chẳng khác chi cột sỏi vào ná bắn.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.262Z",
      "updatedAt": "2025-09-03T02:43:04.262Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "4c675f5c-af57-4fd3-8fe4-58e557f00abf",
      "text": "Đứa dốt mở miệng nói khôn nói ngoan",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.290Z",
      "updatedAt": "2025-09-03T02:43:04.290Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "64b0426a-ac57-48ad-8dc5-d837ff5f418f",
      "text": "chẳng khác gì kẻ say vung cành gai mà múa.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.318Z",
      "updatedAt": "2025-09-03T02:43:04.318Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "4dc8203f-4725-4abc-82ec-fc16e15fb4ca",
      "text": "Ai mướn kẻ ngu hay người say",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.332Z",
      "updatedAt": "2025-09-03T02:43:04.332Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "cce9a703-1c95-44f7-a83d-d3e6793454f8",
      "text": "thì cũng ví tựa kẻ bắn cung",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.346Z",
      "updatedAt": "2025-09-03T02:43:04.346Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "3d0d7061-b600-4e26-b892-f3b4a76a3d6a",
      "text": "gây thương tích cho mọi người qua lại.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.360Z",
      "updatedAt": "2025-09-03T02:43:04.360Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "2fe3b6bd-e69d-4b27-a7c6-bed9e780f336",
      "text": "Con chó quay lại chỗ nó mửa,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.390Z",
      "updatedAt": "2025-09-03T02:43:04.390Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "f9250094-dcc7-4d38-a1e9-b975d34f8516",
      "text": "đứa ngu lặp lại chuyện ngu đần.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.418Z",
      "updatedAt": "2025-09-03T02:43:04.418Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "c4aefb11-4416-4c1e-89f6-bffc9c92dd59",
      "text": "Nếu con gặp một kẻ tự cho mình là khôn,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.432Z",
      "updatedAt": "2025-09-03T02:43:04.432Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "022f2bef-2418-4c6d-add7-3e9ebe148a13",
      "text": "thì thà hy vọng vào đứa ngu còn hơn.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.460Z",
      "updatedAt": "2025-09-03T02:43:04.460Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "2d34b9e9-4a9a-4aa8-ae81-b8885af8983d",
      "text": "Tên lười nói : “Ngoài đường có sư tử,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.488Z",
      "updatedAt": "2025-09-03T02:43:04.488Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "a5eef9df-0cc4-42be-aed8-487e6b44410f",
      "text": "nơi quảng trường có chúa sơn lâm.”",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.500Z",
      "updatedAt": "2025-09-03T02:43:04.500Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "95b2ad51-59cb-4c06-b0b9-afa6d9fae91b",
      "text": "Cánh cửa xoay trên trục,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.513Z",
      "updatedAt": "2025-09-03T02:43:04.513Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "edd2f690-6aed-4796-8b22-8794a8c9cf92",
      "text": "đứa lười lăn trên giường.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.525Z",
      "updatedAt": "2025-09-03T02:43:04.525Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "9ab192f9-e38b-4635-a4ba-33eae4824b2e",
      "text": "Kẻ lười biếng thò tay vào đĩa,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.551Z",
      "updatedAt": "2025-09-03T02:43:04.551Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "5ccc938b-a0d9-422c-9f18-3c2132f63896",
      "text": "nhưng chẳng buồn đưa thức ăn lên miệng.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.578Z",
      "updatedAt": "2025-09-03T02:43:04.578Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "24637d02-f54c-4e28-86f9-667ca04554a6",
      "text": "Kẻ lười biếng tự hào",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.592Z",
      "updatedAt": "2025-09-03T02:43:04.592Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "c8ddbc37-c663-4044-8965-0be6102c2a63",
      "text": "mình khôn hơn bảy người có tài đối đáp.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.606Z",
      "updatedAt": "2025-09-03T02:43:04.606Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "3b0e437d-7870-43c6-9e01-7cba5e74970e",
      "text": "Xen vô chuyện của người",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.620Z",
      "updatedAt": "2025-09-03T02:43:04.620Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "9c5aaf5e-f9e0-4331-8213-2be0479a4c34",
      "text": "khác nào kéo tai chó chạy rông.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.634Z",
      "updatedAt": "2025-09-03T02:43:04.634Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "3ac06fb6-632f-4a2f-b1c9-6dad11917169",
      "text": "thì cũng như người giả vờ điên",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.660Z",
      "updatedAt": "2025-09-03T02:43:04.660Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "c03eb15b-9dc5-4ddd-b4cb-bd0e57a1ead7",
      "text": "phóng lửa, bắn tên gây chết chóc.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.674Z",
      "updatedAt": "2025-09-03T02:43:04.674Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "e4c533e5-12a1-4f0c-9227-876e29177313",
      "text": "Kẻ lừa đảo bạn bè, rồi bảo : “Đùa đấy thôi !”",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.647Z",
      "updatedAt": "2025-09-03T02:43:04.647Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "ef30ffc0-24b4-4e7c-823b-5ccd27a27ac1",
      "text": "Củi tàn thì lửa tắt,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.688Z",
      "updatedAt": "2025-09-03T02:43:04.688Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "39d2e942-64f7-4cc5-a81d-0107a7a09db4",
      "text": "hết kẻ mách lẻo thì cũng bớt đôi co.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.701Z",
      "updatedAt": "2025-09-03T02:43:04.701Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "8a244cf9-cb50-489a-b813-94f366aa30e3",
      "text": "Than nuôi bếp hồng, củi nuôi lửa đỏ,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.729Z",
      "updatedAt": "2025-09-03T02:43:04.729Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "e532b821-1510-43a3-839f-5234c0b9a1e9",
      "text": "kẻ hay gây gổ khiến cãi cọ bùng lên.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.743Z",
      "updatedAt": "2025-09-03T02:43:04.743Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "d982bb6f-5064-48ea-85c9-bd101fcd90e1",
      "text": "Lời đứa mách lẻo như của ngon vật lạ",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.757Z",
      "updatedAt": "2025-09-03T02:43:04.757Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "3484243f-6de6-48b9-80bd-e2d7ecd5229b",
      "text": "trôi xuống tận ruột gan.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.785Z",
      "updatedAt": "2025-09-03T02:43:04.785Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "eaea14f6-5022-4a19-852e-34a1f25459c5",
      "text": "Lời lẽ mặn nồng mà lòng dạ xấu xa",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.799Z",
      "updatedAt": "2025-09-03T02:43:04.799Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "5494bf48-6a33-4c91-8280-13a8bd544cc8",
      "text": "chẳng khác nào bạc cặn dát trên đồ gốm.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.813Z",
      "updatedAt": "2025-09-03T02:43:04.813Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "ca010109-d253-4155-8897-f2325d560bb7",
      "text": "Kẻ ghét ghen, môi miệng khéo vờ vĩnh,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.827Z",
      "updatedAt": "2025-09-03T02:43:04.827Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "0dca1516-ab0e-4953-9a61-fdf3348aabb9",
      "text": "nhưng thâm tâm vẫn đặt chuyện lọc lừa.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.841Z",
      "updatedAt": "2025-09-03T02:43:04.841Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "38bb40b8-66a6-4195-b697-f1e0d085e0a7",
      "text": "Nó dùng lời quyến rũ, con đừng có tin,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.873Z",
      "updatedAt": "2025-09-03T02:43:04.873Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "2a6d7207-feef-4492-83e7-7b59344e4514",
      "text": "vì lòng nó chứa đầy chuyện ghê tởm.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.890Z",
      "updatedAt": "2025-09-03T02:43:04.890Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "de2f3043-70ff-405d-b110-bdd3817207f4",
      "text": "Nó mưu mô che đậy lòng ghen ghét,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.904Z",
      "updatedAt": "2025-09-03T02:43:04.904Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "69bd0c98-aa1d-4724-9ea8-2f5181670f53",
      "text": "nhưng ác tâm của nó bị đại hội vạch trần.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.918Z",
      "updatedAt": "2025-09-03T02:43:04.918Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "496c4ef9-cdc6-4e6d-acdd-816143429484",
      "text": "Kẻ đào hố bị sa xuống hố,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.932Z",
      "updatedAt": "2025-09-03T02:43:04.932Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "728484ba-53d4-40b8-82ee-841e26d68067",
      "text": "người lăn đá lại bị đá đè.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.960Z",
      "updatedAt": "2025-09-03T02:43:04.960Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "1d9d8405-e1d2-4a09-9083-1f5b115449bb",
      "text": "Lưỡi dối gian ghét người nó làm hại,",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:04.974Z",
      "updatedAt": "2025-09-03T02:43:04.974Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "44fa33fe-51ab-48dd-9bfe-5198c3b7558d",
      "text": "miệng ngọt xớt gây đổ vỡ nát tan.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 1,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:05.001Z",
      "updatedAt": "2025-09-03T02:43:05.001Z",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    }
  ],
  "marks": [
