    },
    {
      "id": "65149fbf-bafa-4518-83f5-853ff91ef364",
      "content": "Cn 13,17",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 24,
      "endOffset": 24,
      "createdAt": "2025-09-03T02:43:04.159Z",
      "updatedAt": "2025-09-03T02:43:04.159Z",
      "targetId": "3510007a-d4ef-439b-af53-01d6356bf416",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1fdb2167-7591-4694-a48c-e24339d13c7c"
    },
    {
      "id": "6704b40e-2978-40b1-b163-8e64e2d5acde",
      "content": "Nếu viên sỏi bị cột vào ná, khi bắn nó sẽ không đi và đập lại người bắn.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 33,
      "endOffset": 33,
      "createdAt": "2025-09-03T02:43:04.276Z",
