{
  "chapter": {
    "id": "ad28ce46-6094-434e-91c4-ee835413ecd8",
    "number": 27,
    "createdAt": "2025-09-03T01:07:51.667Z",
    "updatedAt": "2025-09-03T01:07:51.667Z",
    "bookId": "1ea97633-82d8-4f1a-bffc-dfb2da235911"
  },
  "verses": [
    {
      "id": "43c62867-4218-457e-a380-fd85f37e8837",
      "text": "Chớ huênh hoang tự đắc về ngày mai,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:10.511Z",
      "updatedAt": "2025-09-03T02:43:10.511Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "755ab1e8-c07e-4c57-8687-d61943d9fdb0",
      "text": "vì hôm nay sẽ xảy ra chuyện gì, con đâu biết được.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:10.532Z",
      "updatedAt": "2025-09-03T02:43:10.532Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "482eb4c3-2f7b-4003-9070-3dc3d8c2597f",
      "text": "Hãy để kẻ xa người lạ ngợi khen con,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:10.553Z",
      "updatedAt": "2025-09-03T02:43:10.553Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "ff3c5525-2762-458b-88eb-ee9fa3b667b6",
      "text": "đừng có hé môi khen ngợi chính mình.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:10.564Z",
      "updatedAt": "2025-09-03T02:43:10.564Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "bcf48040-496c-4867-b683-01e6961caed1",
      "text": "Đá nặng, cát cũng nặng,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:10.575Z",
      "updatedAt": "2025-09-03T02:43:10.575Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "8507967a-fad0-470a-ae80-059796b26998",
      "text": "đứa ngu nổi giận còn nặng nề hơn.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:10.587Z",
      "updatedAt": "2025-09-03T02:43:10.587Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "7678bb0a-201d-41d6-b753-55c78025395f",
      "text": "Đứa nóng giận thì độc ác, kẻ thịnh nộ thì bạo tàn,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:10.600Z",
      "updatedAt": "2025-09-03T02:43:10.600Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "2ae0e161-4e5b-498e-9cea-36dd7b786c36",
      "text": "nhưng trước người nổi cơn ghen, ai nào đứng vững ?",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:10.614Z",
      "updatedAt": "2025-09-03T02:43:10.614Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "cbb1bedf-6f74-4691-a19b-c7d4c5cae2a9",
      "text": "Thà chỉ trích công khai",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:10.643Z",
      "updatedAt": "2025-09-03T02:43:10.643Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "b8447eb7-44b0-4451-9ea4-e655c6dc3080",
      "text": "còn hơn yêu thương mà không bày tỏ.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:10.657Z",
      "updatedAt": "2025-09-03T02:43:10.657Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "57fbaca9-50d6-4905-843d-d8276dc3a5a5",
      "text": "Bạn bè làm thương tổn, bạn bè vẫn chân thành,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:10.671Z",
      "updatedAt": "2025-09-03T02:43:10.671Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "a3a55593-8a54-4b0e-ace3-5f9a04694efb",
      "text": "kẻ thù có ôm hôn, kẻ thù cũng giả dối.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:10.685Z",
      "updatedAt": "2025-09-03T02:43:10.685Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "c756a194-15d0-41b8-b765-e830e60cbed8",
      "text": "Người no, tảng mật cũng coi thường,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:10.699Z",
      "updatedAt": "2025-09-03T02:43:10.699Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "06f31ffa-75f3-4458-bf4b-77a1d84b76a5",
      "text": "kẻ đói thấy đắng cay cũng ngọt.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:10.713Z",
      "updatedAt": "2025-09-03T02:43:10.713Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "26b9aa0c-c4b7-47b8-8dd2-951606d79c0b",
      "text": "Người xa quê như chim xa tổ.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:10.727Z",
      "updatedAt": "2025-09-03T02:43:10.727Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "96c3a846-e2a6-4b1d-b5eb-38a6d02ade2e",
      "text": "Dầu và hương thơm làm phấn khởi lòng người,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:10.740Z",
      "updatedAt": "2025-09-03T02:43:10.740Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "a59d4ef7-0923-4732-b2b8-206808b0753c",
      "text": "tình bạn ngọt ngào giúp tinh thần thêm vững mạnh.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:10.754Z",
      "updatedAt": "2025-09-03T02:43:10.754Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "12285ee6-ace7-4ee4-adec-13512a406a58",
      "text": "Bạn của con hay bạn của cha con, đừng nỡ bỏ rơi họ.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:10.782Z",
      "updatedAt": "2025-09-03T02:43:10.782Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "48b7086d-2fdf-492c-a56b-47071de9cd21",
      "text": "Gặp ngày khốn quẫn, đừng đến nhà anh em con,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:10.810Z",
      "updatedAt": "2025-09-03T02:43:10.810Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "db40dcae-691d-4d41-8a24-2abcfae025b7",
      "text": "vì anh em xa không bằng láng giềng gần.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:10.824Z",
      "updatedAt": "2025-09-03T02:43:10.824Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "dc66c92b-af8e-4fb7-b128-9532dc9317db",
      "text": "Này con, hãy khôn ngoan cho thầy được thoả dạ",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:10.838Z",
      "updatedAt": "2025-09-03T02:43:10.838Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "052ff474-2403-4a74-93cb-3c9ce67c04cc",
      "text": "và có thể đối đáp với ai sỉ nhục thầy.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:10.851Z",
      "updatedAt": "2025-09-03T02:43:10.851Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "e3255148-e914-47a0-81a9-4174a3e9eb3b",
      "text": "Gặp nguy hiểm, người khôn ẩn mình,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:10.866Z",
      "updatedAt": "2025-09-03T02:43:10.866Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "22daf59a-f1d4-4971-832c-e16bbf6a9e2e",
      "text": "đứa khờ dại lao tới và bị thiệt thân.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:10.901Z",
      "updatedAt": "2025-09-03T02:43:10.901Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "834d257f-08eb-4cf9-a13d-6d102042a592",
      "text": "Người nào dám bảo lãnh cho kẻ không quen,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:10.929Z",
      "updatedAt": "2025-09-03T02:43:10.929Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "ec998e96-544f-49de-80b4-be74c857015b",
      "text": "phải giữ lấy áo của người đó ;",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:10.957Z",
      "updatedAt": "2025-09-03T02:43:10.957Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "0db1a1ca-c2e3-4706-8ba8-31a1dafd15a2",
      "text": "người nào muốn bảo đảm cho phụ nữ xa lạ,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:10.971Z",
      "updatedAt": "2025-09-03T02:43:10.971Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "0cf817b0-93c9-4caa-8b4f-11784c8b7df2",
      "text": "phải đòi người đó vật thế chân.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 3,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:10.985Z",
      "updatedAt": "2025-09-03T02:43:10.985Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "10668826-7cfe-4de7-8b67-97e3f7ba7cbd",
      "text": "Lớn tiếng chúc lành cho bạn hữu ngay từ sáng sớm",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:11.013Z",
      "updatedAt": "2025-09-03T02:43:11.013Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "5e42aee0-2fdb-4ae1-a369-97eaac9d5f0a",
      "text": "thì chẳng khác nào nguyền rủa họ.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:11.041Z",
      "updatedAt": "2025-09-03T02:43:11.041Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "4ddb34da-335a-4870-9000-e46b88a8b3c7",
      "text": "Đàn bà lắm điều như nhà dột ngày mưa.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:11.069Z",
      "updatedAt": "2025-09-03T02:43:11.069Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "9f9b947b-41b8-422b-9996-ce68da9dee10",
      "text": "Giữ được đàn bà như giữ được gió,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:11.096Z",
      "updatedAt": "2025-09-03T02:43:11.096Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "343dedf5-1227-4520-bd53-c0daeea556c6",
      "text": "hay nắm được dầu trong tay.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:11.109Z",
      "updatedAt": "2025-09-03T02:43:11.109Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "a7cd2cc9-5cb9-4264-a7f6-f48f20cc2258",
      "text": "Sắt bén nhờ sắt,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:11.122Z",
      "updatedAt": "2025-09-03T02:43:11.122Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "068711a6-cfca-45d1-bd72-be17bffd4266",
      "text": "con người nên sắc bén nhờ bạn bè.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:11.134Z",
      "updatedAt": "2025-09-03T02:43:11.134Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "3f971def-7113-4dc8-a89d-5b97ec0a6e98",
      "text": "Giữ cây vả thì được ăn trái vả,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:11.147Z",
      "updatedAt": "2025-09-03T02:43:11.147Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "26aa5e4a-2b25-455c-8bb1-ec6327e688e8",
      "text": "bảo vệ thầy ắt sẽ được kính yêu.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:11.160Z",
      "updatedAt": "2025-09-03T02:43:11.160Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "00785b45-c023-4339-a9b1-66616e910c3a",
      "text": "Nước phản chiếu khuôn mặt,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:11.172Z",
      "updatedAt": "2025-09-03T02:43:11.172Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "368a1cff-efeb-4040-ba39-674dac39608d",
      "text": "tâm tư phản ánh con người.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:11.201Z",
      "updatedAt": "2025-09-03T02:43:11.201Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "596904f3-65e5-4e87-a5c4-b50475c26099",
      "text": "Âm ty, âm phủ không bao giờ đầy,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:11.232Z",
      "updatedAt": "2025-09-03T02:43:11.232Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "f6532ccd-7b0d-48d0-b50a-cac960afa4a8",
      "text": "cặp mắt con người chẳng bao giờ thoả.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:11.274Z",
      "updatedAt": "2025-09-03T02:43:11.274Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "743700ef-4ab1-465d-930f-a561b3587f56",
      "text": "Lò thử vàng, nồi thử bạc,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:11.288Z",
      "updatedAt": "2025-09-03T02:43:11.288Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "33395d0c-a509-4031-889a-5ec7481a79de",
      "text": "tiếng khen cho thấy giá trị con người.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:11.329Z",
      "updatedAt": "2025-09-03T02:43:11.329Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "6f8b17ae-345d-4b8c-91d6-2c9d35608c62",
      "text": "Giã đứa ngu trong cối như lấy chày giã gạo,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:11.357Z",
      "updatedAt": "2025-09-03T02:43:11.357Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "41e403a2-9dc3-4f04-9059-d2bcdd9aff0b",
      "text": "con cũng chẳng lột được cái ngu của nó.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:11.371Z",
      "updatedAt": "2025-09-03T02:43:11.371Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "5a12a383-1b8e-4f3c-93f1-80569edb583c",
      "text": "Hãy biết rõ tình trạng bầy gia súc",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:11.385Z",
      "updatedAt": "2025-09-03T02:43:11.385Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "7925a642-3f72-4b34-b70b-ee3f1059d510",
      "text": "và lưu tâm đến đàn vật của con,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:11.414Z",
      "updatedAt": "2025-09-03T02:43:11.414Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "9bb766e6-51ff-4518-86f9-b06155d880fd",
      "text": "vì của cải không bền lâu muôn thuở",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:11.441Z",
      "updatedAt": "2025-09-03T02:43:11.441Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "ce8cb511-3b62-4d16-8740-6f954485cedd",
      "text": "và danh vọng chẳng lưu truyền muôn kiếp.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:11.455Z",
      "updatedAt": "2025-09-03T02:43:11.455Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "ccb02e7c-a788-4a93-82fa-bd5958f80d73",
      "text": "Khi cỏ khô đã cắt và cỏ non lại mọc,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:11.483Z",
      "updatedAt": "2025-09-03T02:43:11.483Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "305d4c86-2240-483b-b522-9ad19993dc1d",
      "text": "khi cỏ xanh trên đồi núi cũng được gom về",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:11.498Z",
      "updatedAt": "2025-09-03T02:43:11.498Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "640b82d3-7c21-46b4-af0c-928a77ca84e1",
      "text": "thì chiên sẽ cho con có áo che thân,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:11.512Z",
      "updatedAt": "2025-09-03T02:43:11.512Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "967bd689-a3b3-43cf-b3de-dae8236d395c",
      "text": "dê sẽ giúp con có tiền tậu ruộng,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:11.524Z",
      "updatedAt": "2025-09-03T02:43:11.524Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "f0db63fa-d2f1-49b4-82ad-80f06a6f71f4",
      "text": "và sẽ có đủ sữa dê để nuôi bản thân con,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:11.537Z",
      "updatedAt": "2025-09-03T02:43:11.537Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    },
    {
      "id": "b51a4cc9-9f8d-4e09-9f58-c20e1eff15ff",
      "text": "nuôi cả nhà và các tỳ nữ.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:11.549Z",
      "updatedAt": "2025-09-03T02:43:11.549Z",
      "chapterId": "ad28ce46-6094-434e-91c4-ee835413ecd8"
    }
