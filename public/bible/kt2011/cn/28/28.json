    },
    {
      "id": "7765ae89-9725-4885-ad6f-671cd2179002",
      "content": "Lề luật là giáo huấn có tính tôn giáo và luân lý.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
