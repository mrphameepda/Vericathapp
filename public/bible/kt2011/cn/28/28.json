{
  "chapter": {
    "id": "a8af7b73-6a52-485d-8248-a09729d12a94",
    "number": 28,
    "createdAt": "2025-09-03T01:07:51.667Z",
    "updatedAt": "2025-09-03T01:07:51.667Z",
    "bookId": "1ea97633-82d8-4f1a-bffc-dfb2da235911"
  },
  "verses": [
    {
      "id": "269cc120-186a-4b6f-b747-d04a03e63b44",
      "text": "Ác nhân trốn chạy dù không ai đuổi bắt,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:16.957Z",
      "updatedAt": "2025-09-03T02:43:16.957Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "046fd52b-9ea8-424c-9b61-c950db92cbb2",
      "text": "còn chính nhân đứng vững tựa sư tử con.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:16.975Z",
      "updatedAt": "2025-09-03T02:43:16.975Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "d5f9fb1c-59de-42d2-8033-bd3967aca9be",
      "text": "Khi đất nước loạn lạc",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:16.985Z",
      "updatedAt": "2025-09-03T02:43:16.985Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "489f6f92-c637-4458-b889-0a8c54f66306",
      "text": "thì lắm kẻ xưng hùng xưng bá,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:16.995Z",
      "updatedAt": "2025-09-03T02:43:16.995Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "baf7d443-6dbd-4afc-893f-df9a5ccd207b",
      "text": "còn đất nước được ổn định",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.006Z",
      "updatedAt": "2025-09-03T02:43:17.006Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "d829ffc6-5599-420a-867a-3ed1190eb858",
      "text": "là nhờ một người hiểu biết khôn ngoan.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 3,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.017Z",
      "updatedAt": "2025-09-03T02:43:17.017Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "ed24ddc1-468a-4aeb-9951-2976d95c5951",
      "text": "Ác nhân bóc lột người thiếu thốn,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.028Z",
      "updatedAt": "2025-09-03T02:43:17.028Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "0657139a-c5c0-40f0-b9c1-48e580a6d14f",
      "text": "khác nào cơn mưa lũ gây nên cảnh đói ăn.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.055Z",
      "updatedAt": "2025-09-03T02:43:17.055Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "a2be99ca-312a-4d48-b88b-c05539521006",
      "text": "Kẻ bỏ lề luật thì ca ngợi ác nhân,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.069Z",
      "updatedAt": "2025-09-03T02:43:17.069Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "978a421c-4405-4795-9b57-09607ae373fa",
      "text": "người giữ lề luật thì chống lại bọn chúng.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.111Z",
      "updatedAt": "2025-09-03T02:43:17.111Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "fd832573-ffea-4d96-b6ef-24d8b1b8cfa5",
      "text": "Phường gian ác đâu hiểu lẽ công bằng,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.125Z",
      "updatedAt": "2025-09-03T02:43:17.125Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "01e05d6c-9c98-4fd3-809e-6cb931acaa1a",
      "text": "nhưng ai kiếm tìm ĐỨC CHÚA thì am tường mọi sự.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.138Z",
      "updatedAt": "2025-09-03T02:43:17.138Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "06b98aff-5f33-468e-b969-1eaec0544b8c",
      "text": "Thà nghèo mà ăn ở vẹn toàn",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.180Z",
      "updatedAt": "2025-09-03T02:43:17.180Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "585a4e0e-015d-4a99-9847-4ee8c0b8179d",
      "text": "còn hơn giàu mà sống quanh co.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.207Z",
      "updatedAt": "2025-09-03T02:43:17.207Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "49adbbf0-4866-4c25-b35f-59fe7f131b54",
      "text": "Người giữ lề luật là đứa con khôn,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.224Z",
      "updatedAt": "2025-09-03T02:43:17.224Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "502d72be-511d-48e3-90b2-ea39e101aca6",
      "text": "kẻ bè bạn với phường bê tha làm cho cha tủi nhục.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.241Z",
      "updatedAt": "2025-09-03T02:43:17.241Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "ebd6625f-8843-4495-9ad9-7057c2a8d050",
      "text": "Cho vay nặng lãi để được thêm giàu có",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.255Z",
      "updatedAt": "2025-09-03T02:43:17.255Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "642b3548-b930-4776-9bdc-92b367319af9",
      "text": "là gom của vào tay kẻ biết thương người nghèo.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.283Z",
      "updatedAt": "2025-09-03T02:43:17.283Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "4100b3c4-3310-4cf5-ab48-12fc78714e3d",
      "text": "Ai bưng tai chẳng muốn nghe lề luật,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.297Z",
      "updatedAt": "2025-09-03T02:43:17.297Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "c6416afb-3d3f-49b7-afad-3195becd9846",
      "text": "cả lời nó nguyện cầu cũng đáng ghê tởm.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.311Z",
      "updatedAt": "2025-09-03T02:43:17.311Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "e8c2dbcc-d1cb-43bd-b5d4-c4a346827db5",
      "text": "Kẻ quyến rũ người ngay thẳng theo đường xấu",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.325Z",
      "updatedAt": "2025-09-03T02:43:17.325Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "ba2d6b51-3daf-4dd7-9e37-c37751f02302",
      "text": "thì chính nó lại sa vào hố nó đào,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.338Z",
      "updatedAt": "2025-09-03T02:43:17.338Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "9312f5a2-0512-4f26-8260-716677ed1b69",
      "text": "nhưng người sống vẹn toàn sẽ thừa hưởng hạnh phúc.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.366Z",
      "updatedAt": "2025-09-03T02:43:17.366Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "1c781149-ccff-47b0-9d3f-528fecb36b36",
      "text": "Kẻ giàu có cứ tưởng mình khôn,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.380Z",
      "updatedAt": "2025-09-03T02:43:17.380Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "ba89ebe6-64f9-4280-ae19-c180d0108906",
      "text": "nhưng người nghèo mà sáng suốt thì biết rõ kẻ ấy.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.408Z",
      "updatedAt": "2025-09-03T02:43:17.408Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "aff1bc70-9cb4-410f-936b-73c20ce56209",
      "text": "Khi chính nhân thắng trận",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.422Z",
      "updatedAt": "2025-09-03T02:43:17.422Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "ed040984-b011-4b88-9c31-6352b205ad5a",
      "text": "thì vinh quang chiếu toả nơi nơi,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.436Z",
      "updatedAt": "2025-09-03T02:43:17.436Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "ef590d17-1049-473a-8ef0-688e9d9f3448",
      "text": "khi kẻ ác đứng lên, ai cũng phải ẩn mình.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.454Z",
      "updatedAt": "2025-09-03T02:43:17.454Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "b14bddde-57bf-4397-9c86-3243dc586831",
      "text": "Kẻ giấu tội mình sẽ không thành đạt,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.481Z",
      "updatedAt": "2025-09-03T02:43:17.481Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "47f7fade-b315-4145-838d-bd58eeb7df21",
      "text": "nhưng ai xưng thú và chừa tội sẽ được xót thương.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.510Z",
      "updatedAt": "2025-09-03T02:43:17.510Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "68f43c76-2d8a-4c6e-9496-5ab94b4dbbb9",
      "text": "Phúc cho người luôn luôn biết sợ,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.534Z",
      "updatedAt": "2025-09-03T02:43:17.534Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "100353d0-f6d7-4f76-ac98-5a9a4c0d36a3",
      "text": "còn kẻ cứng lòng sẽ gặp phải tai ương.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.558Z",
      "updatedAt": "2025-09-03T02:43:17.558Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "8e9744e4-58db-4c2e-850c-bb6301273d69",
      "text": "Như sư tử rống, như gấu xông vào mồi,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.591Z",
      "updatedAt": "2025-09-03T02:43:17.591Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "79aed2ef-f814-4d19-af24-16218e22ecf6",
      "text": "kẻ bất lương thống trị đám dân đen cũng vậy.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.606Z",
      "updatedAt": "2025-09-03T02:43:17.606Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "f308922c-e2f5-4183-8607-27120a049439",
      "text": "Kẻ cầm quyền ngu dốt lo chiếm đoạt cho nhiều,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.620Z",
      "updatedAt": "2025-09-03T02:43:17.620Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "6df07b53-7fad-41ba-af9b-e0af311752b7",
      "text": "còn ai khinh chê lợi lộc bất chính, sẽ được trường thọ.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.634Z",
      "updatedAt": "2025-09-03T02:43:17.634Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "1b7b36fe-c88d-4670-bcb6-b7696f9b1f99",
      "text": "Kẻ bị giày vò vì tội sát nhân sẽ phải trốn chạy cho đến chết",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.648Z",
      "updatedAt": "2025-09-03T02:43:17.648Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "28771f39-e255-414d-b8cc-7708651ee1a0",
      "text": "chẳng cần bắt nó làm chi !",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.661Z",
      "updatedAt": "2025-09-03T02:43:17.661Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "efaadd8d-709c-4868-b26e-80a2e4332c0f",
      "text": "Người sống thanh liêm sẽ được cứu thoát,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.675Z",
      "updatedAt": "2025-09-03T02:43:17.675Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "1dac12bb-d7b0-49ec-b2e7-ccc5b213920d",
      "text": "kẻ ăn ở quanh co sẽ sa vào hố bẫy.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.690Z",
      "updatedAt": "2025-09-03T02:43:17.690Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "41d83303-c737-427e-a2cf-c8e1956f6bd1",
      "text": "Người canh tác đất đai được no đầy cơm bánh,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.704Z",
      "updatedAt": "2025-09-03T02:43:17.704Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "57087b0a-8001-4bfb-a4e7-bb4af76e7e79",
      "text": "kẻ chạy theo chuyện phù phiếm sẽ phải chịu bần cùng.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.732Z",
      "updatedAt": "2025-09-03T02:43:17.732Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "df3d548e-f354-42c5-8d8c-463606348a9e",
      "text": "Người trung tín được đầy dư phúc lành,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.746Z",
      "updatedAt": "2025-09-03T02:43:17.746Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "63d2c22c-b517-4819-b470-dff86e3a2705",
      "text": "kẻ muốn mau giàu sẽ không thoát khỏi hình phạt.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.759Z",
      "updatedAt": "2025-09-03T02:43:17.759Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "d8ce8d3b-0e80-49a0-9379-6c8219220f66",
      "text": "Thiên vị thì chẳng tốt đẹp gì,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.787Z",
      "updatedAt": "2025-09-03T02:43:17.787Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "9bec6752-efb8-42e7-8a44-36e81fdbf46e",
      "text": "người ta có thể phạm tội chỉ vì một mẩu bánh.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.815Z",
      "updatedAt": "2025-09-03T02:43:17.815Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "ca748a23-b24e-4a07-b2f8-0a99ddf8e77c",
      "text": "Người xấu bụng chạy theo tiền của,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.843Z",
      "updatedAt": "2025-09-03T02:43:17.843Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "58588e8b-ae07-45e3-9326-1defb9b29286",
      "text": "đâu biết rằng cảnh nghèo sắp ập đến bên mình.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.858Z",
      "updatedAt": "2025-09-03T02:43:17.858Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "f1440aac-153d-48b2-b24f-80c8182b3b0e",
      "text": "Kẻ dám khiển trách người",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.871Z",
      "updatedAt": "2025-09-03T02:43:17.871Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "3cf4b136-0aa1-49cc-a9b2-592a6fdf9ee4",
      "text": "cuối cùng lại được người quý yêu",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.884Z",
      "updatedAt": "2025-09-03T02:43:17.884Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "29f90813-b9cb-40f9-82f9-a9fdb55da4b8",
      "text": "hơn kẻ chỉ buông lời xu nịnh.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 2,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.899Z",
      "updatedAt": "2025-09-03T02:43:17.899Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "8c2523e9-d024-48b2-aa16-56325ce6ae08",
      "text": "Kẻ bóc lột mẹ cha, rồi bảo : “Đâu có tội vạ gì !”,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.913Z",
      "updatedAt": "2025-09-03T02:43:17.913Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "2b6b6309-ebb2-4efa-82b2-db025328d27c",
      "text": "chính hắn là bạn của quân ăn cướp.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.926Z",
      "updatedAt": "2025-09-03T02:43:17.926Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "165a6e12-620f-4f0a-aaca-f4cdbafe110a",
      "text": "Kẻ lắm tham vọng thì gây ra cãi vã,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.940Z",
      "updatedAt": "2025-09-03T02:43:17.940Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "9ad262b6-6e27-4337-8cb3-e78e863938ce",
      "text": "còn ai cậy vào ĐỨC CHÚA sẽ được thịnh đạt.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:17.968Z",
      "updatedAt": "2025-09-03T02:43:17.968Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "8201319c-96e6-42f4-a122-314e863ba518",
      "text": "Kẻ cậy mình tài trí, ấy là kẻ ngu si.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:18.010Z",
      "updatedAt": "2025-09-03T02:43:18.010Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "94565539-cf79-432b-a2a9-ad9d8cab1dc5",
      "text": "Người theo lẽ khôn ngoan, ắt sẽ được cứu thoát.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:18.023Z",
      "updatedAt": "2025-09-03T02:43:18.023Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "8064e4f4-424a-4206-b8a6-61d76cb80bfc",
      "text": "Ai bố thí cho người nghèo",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:18.036Z",
      "updatedAt": "2025-09-03T02:43:18.036Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "47a36221-bae5-47fa-a47f-0156e9b66caf",
      "text": "sẽ chẳng hề túng thiếu.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:18.062Z",
      "updatedAt": "2025-09-03T02:43:18.062Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "23c92e80-74bb-4bf4-beee-53e2cf62e85f",
      "text": "Còn ai cứ nhắm mắt làm ngơ",
      "label": "27",
      "number": 27,
      "subVerseIndex": 2,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:18.073Z",
      "updatedAt": "2025-09-03T02:43:18.073Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "74cbb6ca-76f3-4e66-be99-f5b2270e79cd",
      "text": "sẽ phải chịu bao lời nguyền rủa.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 3,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:18.084Z",
      "updatedAt": "2025-09-03T02:43:18.084Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "a6fcd83a-fdc6-4d39-8fd1-20be4d7cae06",
      "text": "Kẻ ác đứng lên, người người đều lẩn trốn.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 61,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:18.096Z",
      "updatedAt": "2025-09-03T02:43:18.096Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "74886a77-5bbe-4ff1-81f5-5baffe75b508",
      "text": "Kẻ ác sụp đổ, chính nhân lại thêm đông.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 1,
      "paragraphNumber": 62,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:18.122Z",
      "updatedAt": "2025-09-03T02:43:18.122Z",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    }
  ],
  "marks": [
