    },
    {
      "id": "2f924794-4669-4fae-b65e-da9c4fc400b3",
      "content": "Cn 3,7",
      "kind": "MARK_KIND_REFERENCE",
      "label": "5@",
      "sortOrder": 4,
      "startOffset": 25,
      "endOffset": 25,
      "createdAt": "2025-09-03T02:43:17.394Z",
      "updatedAt": "2025-09-03T02:43:17.394Z",
      "targetId": "1c781149-ccff-47b0-9d3f-528fecb36b36",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "6b47e31b-74a4-4470-85c3-c8f319dacd49",
      "content": "Sợ ở đây không phải là kính sợ Chúa (3,7 ; 24,21), mà là sợ phạm tội. Người luôn cảnh giác như thế ắt sẽ tránh được hình phạt.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "5",
      "sortOrder": 4,
      "startOffset": 32,
      "endOffset": 32,
      "createdAt": "2025-09-03T02:43:17.546Z",
      "updatedAt": "2025-09-03T02:43:17.546Z",
      "targetId": "68f43c76-2d8a-4c6e-9496-5ab94b4dbbb9",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "61e8e7e5-056b-41c8-8ce9-1913727e4975",
      "content": "Cn 11,10; 28,28",
      "kind": "MARK_KIND_REFERENCE",
      "label": "6@",
      "sortOrder": 5,
      "startOffset": 7,
      "endOffset": 7,
      "createdAt": "2025-09-03T02:43:17.468Z",
      "updatedAt": "2025-09-03T02:43:17.468Z",
