    {
      "id": "78655994-e1e9-4099-8111-38f99aa82bfa",
      "content": "Cn 19,1",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 4,
      "endOffset": 4,
      "createdAt": "2025-09-03T02:43:17.193Z",
      "updatedAt": "2025-09-03T02:43:17.193Z",
      "targetId": "06b98aff-5f33-468e-b969-1eaec0544b8c",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "b0d7f44a-66bb-4256-815a-cd851526164c",
      "content": "Việc cho vay nặng lãi giữa những người Ít-ra-en bị lề luật cấm ngặt (x. Xh 22,25 ; Lv 25,35 tt ; Đnl 23,19). Luật đạo cũng như luật đời sẽ tịch thu tài sản của người vi phạm.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 16,
      "endOffset": 16,
      "createdAt": "2025-09-03T02:43:17.269Z",
      "updatedAt": "2025-09-03T02:43:17.269Z",
      "targetId": "ebd6625f-8843-4495-9ad9-7057c2a8d050",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "a8af7b73-6a52-485d-8248-a09729d12a94"
    },
    {
      "id": "f2c7ed7c-d387-46b6-a911-5a972dd50599",
      "content": "Cn 1,31; 26,27",
      "kind": "MARK_KIND_REFERENCE",
      "label": "4@",
      "sortOrder": 3,
      "startOffset": 27,
      "endOffset": 27,
      "createdAt": "2025-09-03T02:43:17.353Z",
