{
  "chapter": {
    "id": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c",
    "number": 29,
    "createdAt": "2025-09-03T01:07:51.667Z",
    "updatedAt": "2025-09-03T01:07:51.667Z",
    "bookId": "1ea97633-82d8-4f1a-bffc-dfb2da235911"
  },
  "verses": [
    {
      "id": "76810f2d-dc45-4ce1-ab9b-8bc1c8f5f2c1",
      "text": "Người được sửa dạy mà cứng đầu cứng cổ",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:23.299Z",
      "updatedAt": "2025-09-03T02:43:23.299Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "97b8ad40-986d-462c-84e4-403fc68736b8",
      "text": "sẽ suy sụp bất ngờ, vô phương cứu chữa.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:23.310Z",
      "updatedAt": "2025-09-03T02:43:23.310Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "42e1d866-6552-49ad-bc85-9f530c426eb4",
      "text": "Chính nhân cầm quyền, dân mừng rỡ.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:23.332Z",
      "updatedAt": "2025-09-03T02:43:23.332Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "412aee0a-9c5c-4cd8-ad1e-fe18dbb81b67",
      "text": "Ác nhân cai trị, dân oán than.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:23.362Z",
      "updatedAt": "2025-09-03T02:43:23.362Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "6898f84a-b3c1-49e9-abed-e6c3921793c5",
      "text": "Người mến chuộng sự khôn ngoan",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:23.377Z",
      "updatedAt": "2025-09-03T02:43:23.377Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "f6f15870-10d8-4fb2-863e-35485359124f",
      "text": "làm cho cha vui thoả.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:23.391Z",
      "updatedAt": "2025-09-03T02:43:23.391Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "5c2c830e-6c53-4bc3-bafc-4ccf2eac15ce",
      "text": "Kẻ giao du với bọn đàng điếm",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:23.418Z",
      "updatedAt": "2025-09-03T02:43:23.418Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "7864e6f0-cf5b-41ea-b8a8-0153b79f17ba",
      "text": "khiến sản nghiệp tiêu tan.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 3,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:23.446Z",
      "updatedAt": "2025-09-03T02:43:23.446Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "d1bc9a14-b1d5-4d06-b01a-7ca25185c527",
      "text": "Vua công minh khiến đất nước ổn định.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:23.460Z",
      "updatedAt": "2025-09-03T02:43:23.460Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "ab5cb708-5eec-407d-a347-4c4725ac75fd",
      "text": "Vua đòi thuế nặng làm đất nước suy vong.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:23.474Z",
      "updatedAt": "2025-09-03T02:43:23.474Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "36f9b89e-ebec-4134-abd0-63e2b82bc724",
      "text": "Nịnh hót ai",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:23.489Z",
      "updatedAt": "2025-09-03T02:43:23.489Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "3b7a04e6-57d6-40f8-a78c-af0e935a25f4",
      "text": "là giăng lưới dưới chân kẻ ấy.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:23.503Z",
      "updatedAt": "2025-09-03T02:43:23.503Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "0efdded8-8784-4579-9a9f-0b8dfe9da464",
      "text": "Ác nhân phạm tội là rơi vào cạm bẫy,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:23.516Z",
      "updatedAt": "2025-09-03T02:43:23.516Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "6a490b88-299b-4fb6-8eeb-562328615b9a",
      "text": "còn chính nhân được vui sướng hò reo.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:23.529Z",
      "updatedAt": "2025-09-03T02:43:23.529Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "a69a5f40-59f6-44a4-b257-99bebd84b40a",
      "text": "Người công chính quan tâm đến quyền lợi kẻ nghèo,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:23.542Z",
      "updatedAt": "2025-09-03T02:43:23.542Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "99087e70-4133-4365-b070-1d427c82227c",
      "text": "điều đó, ác nhân sao hiểu nổi !",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:23.554Z",
      "updatedAt": "2025-09-03T02:43:23.554Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "7f0b4344-614b-40c3-bcdd-f18d3426f75b",
      "text": "Quân chống đối làm cả thành sôi sục,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:23.568Z",
      "updatedAt": "2025-09-03T02:43:23.568Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "5992a682-0924-4ff3-8fe3-38bdcd739bcb",
      "text": "người khôn ngoan khiến cơn giận nguôi ngoai.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:23.582Z",
      "updatedAt": "2025-09-03T02:43:23.582Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "f7808199-79a7-47a3-902d-55f576fa0427",
      "text": "Tranh tụng với kẻ dốt,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:23.595Z",
      "updatedAt": "2025-09-03T02:43:23.595Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "852e133a-1a16-4f2e-aa69-a681be0eb6cb",
      "text": "người khôn có giận hay cười, chẳng lúc nào yên.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:23.609Z",
      "updatedAt": "2025-09-03T02:43:23.609Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "dcd0c42f-32af-4f3e-8096-b2e02f2136b0",
      "text": "Người lương thiện bị quân khát máu căm thù,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:23.625Z",
      "updatedAt": "2025-09-03T02:43:23.625Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "6ee430e2-2d1f-4cd9-9025-358c42026938",
      "text": "nhưng lại được người chính trực tìm kiếm.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:23.639Z",
      "updatedAt": "2025-09-03T02:43:23.639Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "c6c8ea87-1d56-4bf0-8517-f4670f9d479d",
      "text": "Kẻ ngu để cơn giận tự do bộc phát,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:23.652Z",
      "updatedAt": "2025-09-03T02:43:23.652Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "bb80747f-9c91-4199-a768-09876258a664",
      "text": "còn người khôn biết dằn xuống cho êm.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:23.666Z",
      "updatedAt": "2025-09-03T02:43:23.666Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "11e11ea7-b528-4276-8774-01bb25314785",
      "text": "Lãnh đạo mà để tâm nghe lời gian trá",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:23.679Z",
      "updatedAt": "2025-09-03T02:43:23.679Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "8e5c8a8a-b75d-4160-85f4-fc9af291ab03",
      "text": "thì thuộc hạ sẽ thành một lũ xấu xa.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:23.691Z",
      "updatedAt": "2025-09-03T02:43:23.691Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "e2ed854f-40b1-423a-ae9d-72a07a576a3a",
      "text": "Kẻ nghèo hèn và đứa bóc lột",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:23.704Z",
      "updatedAt": "2025-09-03T02:43:23.704Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "eae4d037-6b47-453f-84cf-06f37c16cd2a",
      "text": "giống nhau ở điểm này :",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:23.716Z",
      "updatedAt": "2025-09-03T02:43:23.716Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "13c4e492-350b-44a2-8348-7c8ffd82da29",
      "text": "cả hai đều được ĐỨC CHÚA cho nhìn thấy ánh sáng.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:23.747Z",
      "updatedAt": "2025-09-03T02:43:23.747Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "40ba8b36-5ecd-41ce-9920-6e009a265e6b",
      "text": "Vua theo sự thật mà xét xử người nghèo",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:23.776Z",
      "updatedAt": "2025-09-03T02:43:23.776Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "ac558fe0-c265-4786-86b6-04ba1377e7f1",
      "text": "thì ngai vàng sẽ bền vững thiên thu.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:23.790Z",
      "updatedAt": "2025-09-03T02:43:23.790Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "986c3c6e-08d6-4cf5-94ff-781b9a0e2b12",
      "text": "Có chịu đòn chịu mắng mới nên khôn,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:23.818Z",
      "updatedAt": "2025-09-03T02:43:23.818Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "cea58e39-e3d3-42ed-b315-482a67f51d42",
      "text": "trẻ con thả lỏng gây tủi buồn cho mẹ.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:23.845Z",
      "updatedAt": "2025-09-03T02:43:23.845Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "c6894ca3-384a-4808-b736-d33f67415bc0",
      "text": "Ác nhân cầm quyền thì tội ác gia tăng,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:23.859Z",
      "updatedAt": "2025-09-03T02:43:23.859Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "74a0d230-9699-46d6-9a5a-515b7ce6be22",
      "text": "nhưng chính nhân sẽ thấy chúng suy tàn.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:23.887Z",
      "updatedAt": "2025-09-03T02:43:23.887Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "85dec05e-c5d2-4fd0-b439-3fee6dc010df",
      "text": "Hãy sửa phạt con, nó sẽ cho bạn được thảnh thơi",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:23.901Z",
      "updatedAt": "2025-09-03T02:43:23.901Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "79c79b64-4740-4c5d-8e3c-8324b67c9516",
      "text": "và khiến lòng bạn vui sướng.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:23.931Z",
      "updatedAt": "2025-09-03T02:43:23.931Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "8f71c984-7428-4f26-b2b1-47500ae7448c",
      "text": "Khi không còn thị kiến, dân sẽ sống buông thả,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:23.945Z",
      "updatedAt": "2025-09-03T02:43:23.945Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "fe52c8df-3f76-438b-942d-5628afa67e17",
      "text": "nhưng ai còn giữ luật, quả là người có phúc.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:23.959Z",
      "updatedAt": "2025-09-03T02:43:23.959Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "fda543a8-f39d-4b13-bfaa-03016927a287",
      "text": "Đừng sửa dạy tôi tớ bằng lời nói suông,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:23.987Z",
      "updatedAt": "2025-09-03T02:43:23.987Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "819d9329-e394-40e5-9e44-00d914cb97e8",
      "text": "nó hiểu cũng chẳng tuân chẳng giữ.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:24.002Z",
      "updatedAt": "2025-09-03T02:43:24.002Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "c4a79f6e-05a2-4316-9a81-12223044fd9f",
      "text": "Gặp phải người nói năng bộp chộp,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:24.015Z",
      "updatedAt": "2025-09-03T02:43:24.015Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "ecf59ad3-d559-4ea2-af3d-d2bcaa19122a",
      "text": "thà trông cậy đứa dốt còn hơn.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:24.029Z",
      "updatedAt": "2025-09-03T02:43:24.029Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "0fcaea11-24c2-426c-910b-87a12f7a4af6",
      "text": "Nuông chiều tôi tớ khi nó còn nhỏ dại",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:24.058Z",
      "updatedAt": "2025-09-03T02:43:24.058Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "0ed3e920-e25e-4c50-94b3-8916f8de574e",
      "text": "thế nào cũng biến nó thành tên cứng đầu.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:24.072Z",
      "updatedAt": "2025-09-03T02:43:24.072Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "cf0755da-754b-4dd5-affe-601aa63e099d",
      "text": "Người hay giận thường gây tranh cãi,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:24.085Z",
      "updatedAt": "2025-09-03T02:43:24.085Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "f965b569-3a9e-411f-807f-a8f097afe4e7",
      "text": "kẻ nóng tính phạm bao lỗi lầm.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:24.113Z",
      "updatedAt": "2025-09-03T02:43:24.113Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "12bf7201-73f3-4aaa-a4ff-a8bef053fee4",
      "text": "Tính tự cao hạ đứa tự cao xuống,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:24.127Z",
      "updatedAt": "2025-09-03T02:43:24.127Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "f58c968d-3df8-4286-8520-48eeaebd4b48",
      "text": "người tự hạ sẽ được tôn vinh.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:24.154Z",
      "updatedAt": "2025-09-03T02:43:24.154Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "2c7839f4-3605-4936-a637-b85ecc9682af",
      "text": "Kẻ đồng loã với tên trộm cắp",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:24.168Z",
      "updatedAt": "2025-09-03T02:43:24.168Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "935ab552-5031-4e11-95fc-27585e3670f1",
      "text": "là làm hại chính bản thân mình.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:24.182Z",
      "updatedAt": "2025-09-03T02:43:24.182Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "cacf1a82-d286-4209-9d78-953395463851",
      "text": "Nó nghe thấy lời nguyền rủa",
      "label": "24",
      "number": 24,
      "subVerseIndex": 2,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:24.197Z",
      "updatedAt": "2025-09-03T02:43:24.197Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "120a0604-e0fd-4fa5-a727-f01b1fcd0ab9",
      "text": "mà vẫn không chịu tiết lộ chi.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 3,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:24.211Z",
      "updatedAt": "2025-09-03T02:43:24.211Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "86be79f0-2d65-46c2-a1e9-ab6a5301b063",
      "text": "Nỗi sợ sệt khiến con người sa bẫy,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:24.244Z",
      "updatedAt": "2025-09-03T02:43:24.244Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "449f8f3a-7253-4cf5-a6e2-fb7477f93d36",
      "text": "nhưng ai cậy trông ĐỨC CHÚA thì được an toàn.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:24.272Z",
      "updatedAt": "2025-09-03T02:43:24.272Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "b38756ba-c7d8-4bb8-91b8-f2fb95cc71c8",
      "text": "Lắm kẻ đến cầu cạnh người quyền thế,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:24.314Z",
      "updatedAt": "2025-09-03T02:43:24.314Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "d3086979-f14c-4a70-810a-a49752ce3d7e",
      "text": "nhưng ĐỨC CHÚA mới đem lại công lý cho mỗi người.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:24.327Z",
      "updatedAt": "2025-09-03T02:43:24.327Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "0dcc4fc2-072d-47f9-aad9-81296defc675",
      "text": "Chính nhân kinh tởm kẻ sống bất công,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:24.370Z",
      "updatedAt": "2025-09-03T02:43:24.370Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    },
    {
      "id": "1ba63299-e004-47c6-ac2f-19b628ce5a67",
      "text": "ác nhân kinh tởm người theo đường chính trực.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:24.384Z",
      "updatedAt": "2025-09-03T02:43:24.384Z",
      "chapterId": "8a0c8ce3-1c93-40c5-9e73-cd6845d4828c"
    }
  ],
