    {
      "id": "4ad9f13d-3fba-4621-939e-bdffbb425d66",
      "content": "Đức Chúa chi phối quyết định của nhà vua (21,1), và bảo vệ quyền lợi của người nghèo, người công chính.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "6",
      "sortOrder": 5,
