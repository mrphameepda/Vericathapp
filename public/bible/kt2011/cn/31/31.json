    },
    {
      "id": "7f655647-e1d5-4055-a2ab-80555525fa6a",
      "text": "Sin",
      "label": "29",
      "number": 29,
      "subVerseIndex": 2,
      "paragraphNumber": 80,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:43:38.480Z",
      "updatedAt": "2025-09-03T02:43:38.480Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "85153342-2fe5-457e-8c05-58546a52a5b7",
      "text": "Duyên dáng là giả trá, sắc đẹp là phù vân.",
      "label": "30",
      "number": 30,
      "subVerseIndex": 0,
      "paragraphNumber": 81,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:38.494Z",
      "updatedAt": "2025-09-03T02:43:38.494Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "8d942c79-7784-4e4c-a56c-c1fde73912ce",
      "text": "Người phụ nữ kính sợ ĐỨC CHÚA",
      "label": "30",
      "number": 30,
      "subVerseIndex": 1,
      "paragraphNumber": 82,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:38.508Z",
      "updatedAt": "2025-09-03T02:43:38.508Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "641e4a88-070f-45a6-bfee-e234bcd4d7ce",
      "text": "mới đáng cho người đời ca tụng.",
      "label": "30",
      "number": 30,
      "subVerseIndex": 2,
      "paragraphNumber": 83,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:38.537Z",
      "updatedAt": "2025-09-03T02:43:38.537Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "ebb08653-a09b-4bd1-b836-263ec0f9ffdd",
      "text": "Tau",
      "label": "30",
      "number": 30,
      "subVerseIndex": 3,
      "paragraphNumber": 84,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:43:38.551Z",
      "updatedAt": "2025-09-03T02:43:38.551Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "435587be-085d-4cc0-8132-e247345d9bbb",
      "text": "Hãy để cho nàng hưởng những thành quả tay nàng làm ra.",
      "label": "31",
      "number": 31,
      "subVerseIndex": 0,
      "paragraphNumber": 85,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:38.565Z",
      "updatedAt": "2025-09-03T02:43:38.565Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "659e151a-1616-46ee-a81c-198953a59f89",
      "text": "Ước chi nơi cổng thành nàng luôn được tán dương ca tụng",
      "label": "31",
      "number": 31,
      "subVerseIndex": 1,
      "paragraphNumber": 86,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:38.579Z",
      "updatedAt": "2025-09-03T02:43:38.579Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "671621d0-24fa-4ad3-9c6e-abd75cafab38",
      "text": "do những việc nàng làm.",
      "label": "31",
      "number": 31,
      "subVerseIndex": 2,
      "paragraphNumber": 87,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:38.593Z",
      "updatedAt": "2025-09-03T02:43:38.593Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    }
  ],
  "marks": [
    {
      "id": "d02870e2-cea4-4e81-b05e-97725fc823f9",
      "content": "Cc. 1-9 được viết theo thể văn huấn dụ nhằm dạy các viên chức trong triều. Có thể Lơ-mu-ên chỉ là tên của một vị vua không có thật, nhằm tăng thêm giá trị cho những lời khuyên sau đó. Ta thấy vị vua được thái hậu nhắc nhở về chuyện liên hệ với phụ nữ, chuyện uống rượu và chuyện bênh vực quyền lợi kẻ nghèo.",
      "kind": "MARK_KIND_FOOTNOTE",
