    },
    {
      "id": "a59e389f-960f-40d8-a6f0-56c74a29d74e",
      "content": "ds : *người Ca-na-an*. Đây là những người giỏi buôn bán vào thời đó.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "8",
      "sortOrder": 7,
      "startOffset": 30,
      "endOffset": 30,
      "createdAt": "2025-09-03T02:43:38.239Z",
      "updatedAt": "2025-09-03T02:43:38.239Z",
      "targetId": "8bd1a228-ab72-4d41-ac8f-1cbee7ff4b64",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "4a039292-7d78-4a3c-93a3-768cbd1d4d2d",
      "content": "ds : nàng không ăn bánh của sự lười biếng.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "9",
      "sortOrder": 8,
      "startOffset": 46,
      "endOffset": 46,
      "createdAt": "2025-09-03T02:43:38.384Z",
      "updatedAt": "2025-09-03T02:43:38.384Z",
      "targetId": "126294a5-5c4f-495b-8f09-bb9e42b2d768",
      "targetType": "MARK_TARGET_TYPE_VERSE",
