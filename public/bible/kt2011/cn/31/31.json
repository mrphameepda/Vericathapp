{
  "chapter": {
    "id": "3c1965dd-ef16-4925-945f-f957ff3a8b70",
    "number": 31,
    "createdAt": "2025-09-03T01:07:51.667Z",
    "updatedAt": "2025-09-03T01:07:51.667Z",
    "bookId": "1ea97633-82d8-4f1a-bffc-dfb2da235911"
  },
  "verses": [
    {
      "id": "b6863c66-bc28-4dae-a45e-e0f6066aa3c1",
      "text": "Lời của Lơ-mu-ên, vua Ma-xa,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:37.165Z",
      "updatedAt": "2025-09-03T02:43:37.165Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "b9460078-e6a9-4256-8adb-66ca4cd5a60b",
      "text": "những lời thái hậu đã dạy người.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:37.225Z",
      "updatedAt": "2025-09-03T02:43:37.225Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "027f092e-8159-466f-9b58-83ca3d2c2379",
      "text": "Hỡi con trai ta, đứa con lòng dạ ta đã cưu mang,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:37.236Z",
      "updatedAt": "2025-09-03T02:43:37.236Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "4dbde71b-b048-4500-9281-fde4e1afea91",
      "text": "đứa con ta đã cầu khẩn được.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:37.246Z",
      "updatedAt": "2025-09-03T02:43:37.246Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "a04fd9cc-884e-4e29-8008-231e7400860c",
      "text": "Đừng hiến sinh lực của con cho phụ nữ,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:37.257Z",
      "updatedAt": "2025-09-03T02:43:37.257Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "42fc8fa9-6137-4bbb-840a-773d19b4dc3b",
      "text": "đừng trao cuộc đời cho những ả làm hư hỏng các vua.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:37.283Z",
      "updatedAt": "2025-09-03T02:43:37.283Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "d3de0371-efd0-4d6c-b474-b2c903451db9",
      "text": "Hỡi Lơ-mu-ên,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:37.311Z",
      "updatedAt": "2025-09-03T02:43:37.311Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "268260ca-e4a8-4a21-a4ce-129519e7ae02",
      "text": "đã làm vua thì đừng nên uống rượu,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:37.339Z",
      "updatedAt": "2025-09-03T02:43:37.339Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "6506127b-9368-483d-bc75-4b2e935adb74",
      "text": "làm người lãnh đạo thì đừng thích chất men,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:37.366Z",
      "updatedAt": "2025-09-03T02:43:37.366Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "a3c6ed58-8b63-4340-836b-097669b5176c",
      "text": "kẻo uống vào rồi thì quên cả luật pháp,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:37.380Z",
      "updatedAt": "2025-09-03T02:43:37.380Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "25c3c705-26a8-4c16-9d56-53c02ba2b43f",
      "text": "và coi thường quyền lợi của mọi kẻ khốn cùng.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:37.394Z",
      "updatedAt": "2025-09-03T02:43:37.394Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "dad813d4-320f-4cff-86c4-cbb2d063fa19",
      "text": "Hãy đem chất men cho kẻ đang hấp hối,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:37.408Z",
      "updatedAt": "2025-09-03T02:43:37.408Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "2910da8e-eb59-4e31-9a50-f08f1b2df26a",
      "text": "và đem rượu cho người chịu đắng cay,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:37.422Z",
      "updatedAt": "2025-09-03T02:43:37.422Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "71273309-dbeb-4fd7-8d7b-4121f5ed6a5b",
      "text": "để họ uống mà quên đi cảnh nghèo,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:37.435Z",
      "updatedAt": "2025-09-03T02:43:37.435Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "ec311fe3-1890-4899-96f9-aceefad32d56",
      "text": "khỏi nhớ đến nỗi khổ đau phiền muộn nữa.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:37.449Z",
      "updatedAt": "2025-09-03T02:43:37.449Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "6be6b6dc-11b9-4f10-a3b5-dfb53e60dce1",
      "text": "Con hãy mở miệng nói thay cho người câm,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:37.463Z",
      "updatedAt": "2025-09-03T02:43:37.463Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "08f33f8b-8975-4c9a-9e9c-0e3aa91e11ed",
      "text": "và biện hộ cho mọi người bất hạnh.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:37.477Z",
      "updatedAt": "2025-09-03T02:43:37.477Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "2d7c5a4b-2063-4c7b-977d-63590c57f7d8",
      "text": "Hãy mở miệng xét xử thật công minh,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:37.491Z",
      "updatedAt": "2025-09-03T02:43:37.491Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "96d00073-a759-4b34-b67b-0dabdccb49c7",
      "text": "biện hộ cho những kẻ nghèo nàn khốn khổ.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:37.505Z",
      "updatedAt": "2025-09-03T02:43:37.505Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "4cce96a2-7eca-49d5-bbe9-30b3cdfa0f49",
      "text": "A-lép",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:43:37.520Z",
      "updatedAt": "2025-09-03T02:43:37.520Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "eee14130-aba5-451f-8d20-fc221a7b3112",
      "text": "Tìm đâu ra một người vợ đảm đang ?",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:37.562Z",
      "updatedAt": "2025-09-03T02:43:37.562Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "1e439a31-a9c3-423a-842e-694c4c7a98b4",
      "text": "Nàng quý giá vượt xa châu ngọc.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:37.589Z",
      "updatedAt": "2025-09-03T02:43:37.589Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "1b10633c-6acd-4f58-a002-356df1d25875",
      "text": "Bết",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:43:37.604Z",
      "updatedAt": "2025-09-03T02:43:37.604Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "5aa380b8-469a-4c4c-abf2-9632cb8fe5eb",
      "text": "Chồng nàng hết dạ tin tưởng nàng,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:37.618Z",
      "updatedAt": "2025-09-03T02:43:37.618Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "4f8c2eac-d838-476c-8ec6-66ea4587c011",
      "text": "chàng sẽ chẳng thiếu chi lợi lộc.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:37.632Z",
      "updatedAt": "2025-09-03T02:43:37.632Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "639ae293-c05d-4f4f-ac12-247337475ea4",
      "text": "Ghi-men",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:43:37.646Z",
      "updatedAt": "2025-09-03T02:43:37.646Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "ffb0c595-d39d-4cfd-9bcf-89a7e68e104e",
      "text": "Suốt đời, nàng đem lại hạnh phúc",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:37.659Z",
      "updatedAt": "2025-09-03T02:43:37.659Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "22782746-846e-43a8-b98d-5c3b9889a557",
      "text": "chứ không gây tai hoạ cho chồng.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:37.673Z",
      "updatedAt": "2025-09-03T02:43:37.673Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "668ac13b-aaa4-4f3a-a3ac-4b5408e79934",
      "text": "Đa-lét",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:43:37.687Z",
      "updatedAt": "2025-09-03T02:43:37.687Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "a2d0889e-2e28-42e2-92f9-2719b1d5924e",
      "text": "Nàng tìm kiếm len và vải gai,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:37.701Z",
      "updatedAt": "2025-09-03T02:43:37.701Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "eeda3e47-c7ea-45e7-b679-50c7b0a059cc",
      "text": "rồi vui vẻ ra tay làm việc.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:37.716Z",
      "updatedAt": "2025-09-03T02:43:37.716Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "af06e083-88c3-478f-a991-eba8e68eb6c7",
      "text": "Hê",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:43:37.729Z",
      "updatedAt": "2025-09-03T02:43:37.729Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "bf8904dd-9994-465f-9863-76459e6dc0a5",
      "text": "Giống như những thương thuyền,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:37.743Z",
      "updatedAt": "2025-09-03T02:43:37.743Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "492ff2be-caf1-4175-aeaa-3a3b901f685a",
      "text": "nàng đem lương thực về từ tận phương xa.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:37.757Z",
      "updatedAt": "2025-09-03T02:43:37.757Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "a702fec8-25c3-4e1c-806f-2f0019bcb7c0",
      "text": "Vau",
      "label": "14",
      "number": 14,
      "subVerseIndex": 2,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:43:37.771Z",
      "updatedAt": "2025-09-03T02:43:37.771Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "d28751e5-a090-4ab1-81aa-d8dc60ae3df2",
      "text": "Nàng thức dậy khi trời còn tối,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:37.785Z",
      "updatedAt": "2025-09-03T02:43:37.785Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "ab4a336f-feee-4275-85fe-e34200b966fb",
      "text": "cung cấp phần ăn cho cả nhà, và sai bảo con ăn đứa ở.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:37.798Z",
      "updatedAt": "2025-09-03T02:43:37.798Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "f9bdba5c-d8c8-47eb-9bb7-f49002f17c78",
      "text": "Da-in",
      "label": "15",
      "number": 15,
      "subVerseIndex": 2,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:43:37.812Z",
      "updatedAt": "2025-09-03T02:43:37.812Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "ddefd6e6-6fc8-42ab-9951-32a1a2ea3038",
      "text": "Nàng để mắt đến một thửa ruộng và tậu lấy ;",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:37.826Z",
      "updatedAt": "2025-09-03T02:43:37.826Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "8f6a4f61-5c9f-4fea-a150-ce4630498c18",
      "text": "nàng dùng huê lợi đôi tay mình làm ra",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:37.840Z",
      "updatedAt": "2025-09-03T02:43:37.840Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "a329d8ab-8964-45de-bf48-f7478a023d11",
      "text": "mà canh tác một vườn nho.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 2,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:37.854Z",
      "updatedAt": "2025-09-03T02:43:37.854Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "280f3aee-ee46-42c6-ba6f-3020e52a4fa2",
      "text": "Khết",
      "label": "16",
      "number": 16,
      "subVerseIndex": 3,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:43:37.882Z",
      "updatedAt": "2025-09-03T02:43:37.882Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "f36e1f2d-7fd9-4f3f-8285-85a1e464f748",
      "text": "Nàng thắt lưng cho chặt,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:37.895Z",
      "updatedAt": "2025-09-03T02:43:37.895Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "1210162d-3b6a-43cf-bbac-b3c65481c6ac",
      "text": "luyện cánh tay cho mạnh mẽ dẻo dai.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:37.909Z",
      "updatedAt": "2025-09-03T02:43:37.909Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "a8a36de9-efe5-459c-9731-4b56cb083865",
      "text": "Tết",
      "label": "17",
      "number": 17,
      "subVerseIndex": 2,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:43:37.923Z",
      "updatedAt": "2025-09-03T02:43:37.923Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "2b8d040a-dfb5-42e3-b01f-36b5259943d4",
      "text": "Nàng thấy công việc sinh nhiều lợi nhuận,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:37.943Z",
      "updatedAt": "2025-09-03T02:43:37.943Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "3a74a1a8-e201-4a40-9a51-76881085e32f",
      "text": "đèn trong nhà thắp sáng thâu đêm.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:37.957Z",
      "updatedAt": "2025-09-03T02:43:37.957Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "414da0f0-778a-4d37-8e33-d91487f157c9",
      "text": "Giốt",
      "label": "18",
      "number": 18,
      "subVerseIndex": 2,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:43:37.971Z",
      "updatedAt": "2025-09-03T02:43:37.971Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "470f3228-77bf-4324-82f9-752626b823f4",
      "text": "Nàng tra tay vào guồng kéo sợi,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:37.985Z",
      "updatedAt": "2025-09-03T02:43:37.985Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "74647d11-78be-405a-877f-dddb8c6ddf89",
      "text": "và cầm chắc suốt chỉ trong tay.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:37.998Z",
      "updatedAt": "2025-09-03T02:43:37.998Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "c8aa652d-9d6b-4935-bb6d-f08e166ed10c",
      "text": "Cáp",
      "label": "19",
      "number": 19,
      "subVerseIndex": 2,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:43:38.012Z",
      "updatedAt": "2025-09-03T02:43:38.012Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "a37a8d1e-507e-4b2d-8780-5198f4709b2c",
      "text": "Nàng rộng tay giúp người nghèo khổ",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:38.026Z",
      "updatedAt": "2025-09-03T02:43:38.026Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "0ea2294b-a501-4a31-8a38-08bde42a6125",
      "text": "và đưa tay cứu kẻ khốn cùng.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:38.040Z",
      "updatedAt": "2025-09-03T02:43:38.040Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "e74f6a8d-28c4-43dc-a0f5-17a9d7500d43",
      "text": "La-mét",
      "label": "20",
      "number": 20,
      "subVerseIndex": 2,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:43:38.054Z",
      "updatedAt": "2025-09-03T02:43:38.054Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "cfaed912-2cd2-45fc-a8ee-25e81434ba12",
      "text": "Nàng không sợ người nhà bị lạnh vì tuyết sương,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:38.068Z",
      "updatedAt": "2025-09-03T02:43:38.068Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "280516ee-9dc5-49ec-be4a-629053e30e5f",
      "text": "bởi cả nhà đều được mặc hai áo.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:38.081Z",
      "updatedAt": "2025-09-03T02:43:38.081Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "dc3436ab-f8b2-413c-b0a4-b9290273303a",
      "text": "Mêm",
      "label": "21",
      "number": 21,
      "subVerseIndex": 2,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:43:38.095Z",
      "updatedAt": "2025-09-03T02:43:38.095Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "904ba605-4258-45ff-b8a0-5b4e2e0d79b1",
      "text": "Nàng tự tay làm lấy chăn mền,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:38.115Z",
      "updatedAt": "2025-09-03T02:43:38.115Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "c28867b2-5c3b-4373-9410-da45265df76b",
      "text": "nàng mặc toàn vải gai, vải tía.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:38.128Z",
      "updatedAt": "2025-09-03T02:43:38.128Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "c36b3f04-57e0-43f5-afb0-76811bb3548b",
      "text": "Nun",
      "label": "22",
      "number": 22,
      "subVerseIndex": 2,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:43:38.142Z",
      "updatedAt": "2025-09-03T02:43:38.142Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "ffc027e2-4230-400c-be3c-ff7c769ff44d",
      "text": "Chồng nàng được tiếng thơm nơi cổng thành",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:38.170Z",
      "updatedAt": "2025-09-03T02:43:38.170Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "2c5742a6-d417-476c-9f51-40803bcb9589",
      "text": "khi ngồi chung với hàng kỳ mục trong dân.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 61,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:38.184Z",
      "updatedAt": "2025-09-03T02:43:38.184Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "46ed156a-e8b6-4295-a3db-bd032e2632ba",
      "text": "Xa-méc",
      "label": "23",
      "number": 23,
      "subVerseIndex": 2,
      "paragraphNumber": 62,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:43:38.197Z",
      "updatedAt": "2025-09-03T02:43:38.197Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "8161249b-d667-4ff0-beab-8b2f51b656be",
      "text": "Nàng dệt vải đem bán,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 63,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:38.211Z",
      "updatedAt": "2025-09-03T02:43:38.211Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "8bd1a228-ab72-4d41-ac8f-1cbee7ff4b64",
      "text": "cung cấp dây lưng cho nhà buôn.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 64,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:38.225Z",
      "updatedAt": "2025-09-03T02:43:38.225Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "5dd0b9e4-2399-4226-8034-f07012761c97",
      "text": "Pê",
      "label": "24",
      "number": 24,
      "subVerseIndex": 2,
      "paragraphNumber": 65,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:43:38.252Z",
      "updatedAt": "2025-09-03T02:43:38.252Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "ef7afede-d77e-4040-bba1-f75d6a80925e",
      "text": "Trang phục của nàng là quyền uy danh giá,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 66,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:38.267Z",
      "updatedAt": "2025-09-03T02:43:38.267Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "be9297da-7f19-4bd8-9bb8-2901307aecd0",
      "text": "nàng mỉm cười khi nghĩ đến tương lai.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 67,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:38.280Z",
      "updatedAt": "2025-09-03T02:43:38.280Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "6cb4fe7a-5d21-40aa-9e70-27bf21ba5793",
      "text": "A-in",
      "label": "25",
      "number": 25,
      "subVerseIndex": 2,
      "paragraphNumber": 68,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:43:38.294Z",
      "updatedAt": "2025-09-03T02:43:38.294Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "93e8fec8-9223-4604-993e-3fa0b98febfc",
      "text": "Nàng khôn ngoan trong lời ăn tiếng nói",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 69,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:38.308Z",
      "updatedAt": "2025-09-03T02:43:38.308Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "6f9aadb2-e043-4c98-9df7-649b4987f52f",
      "text": "và dịu hiền khi dạy dỗ bảo ban.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 70,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:38.322Z",
      "updatedAt": "2025-09-03T02:43:38.322Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "48103aa8-0348-4e00-8b41-bab9df98aa3b",
      "text": "Xa-đê",
      "label": "26",
      "number": 26,
      "subVerseIndex": 2,
      "paragraphNumber": 71,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:43:38.342Z",
      "updatedAt": "2025-09-03T02:43:38.342Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "d10dd0c5-a1db-45af-9e90-092f13a66f3a",
      "text": "Nàng để mắt trông nom mọi việc trong nhà,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 72,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:38.356Z",
      "updatedAt": "2025-09-03T02:43:38.356Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "126294a5-5c4f-495b-8f09-bb9e42b2d768",
      "text": "bánh nàng ăn là do mồ hôi nước mắt nàng làm ra,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 73,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:38.370Z",
      "updatedAt": "2025-09-03T02:43:38.370Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "5c494bc5-fbc6-406e-b68c-4db87d723a26",
      "text": "Cốp",
      "label": "27",
      "number": 27,
      "subVerseIndex": 2,
      "paragraphNumber": 74,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:43:38.397Z",
      "updatedAt": "2025-09-03T02:43:38.397Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "a4526bd8-c2be-4eb5-a2e4-d1efefe451d3",
      "text": "con nàng đứng lên ca tụng nàng có phúc,",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 75,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:38.411Z",
      "updatedAt": "2025-09-03T02:43:38.411Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "1afa6368-225b-4b85-9276-aea28b59106f",
      "text": "chồng nàng cũng tấm tắc ngợi khen :",
      "label": "28",
      "number": 28,
      "subVerseIndex": 1,
      "paragraphNumber": 76,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:38.425Z",
      "updatedAt": "2025-09-03T02:43:38.425Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "dcb068ad-0706-405b-b119-e8b0a869fe7e",
      "text": "Rết",
      "label": "28",
      "number": 28,
      "subVerseIndex": 2,
      "paragraphNumber": 77,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:43:38.439Z",
      "updatedAt": "2025-09-03T02:43:38.439Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "3a845352-c6f2-4348-8a43-d660f1bdd9d3",
      "text": "“Có nhiều cô đảm đang,",
      "label": "29",
      "number": 29,
      "subVerseIndex": 0,
      "paragraphNumber": 78,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:38.453Z",
      "updatedAt": "2025-09-03T02:43:38.453Z",
      "chapterId": "3c1965dd-ef16-4925-945f-f957ff3a8b70"
    },
    {
      "id": "94a5d7db-0c02-4ffc-92b2-42cdcd6c08fa",
      "text": "nhưng em còn trổi trang gấp bội.”",
      "label": "29",
      "number": 29,
      "subVerseIndex": 1,
      "paragraphNumber": 79,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:43:38.466Z",
