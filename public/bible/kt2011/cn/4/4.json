{
  "chapter": {
    "id": "d336c1b8-7369-4bba-8c8b-7429d4da850e",
    "number": 4,
    "createdAt": "2025-09-03T01:07:51.666Z",
    "updatedAt": "2025-09-03T01:07:51.666Z",
    "bookId": "1ea97633-82d8-4f1a-bffc-dfb2da235911"
  },
  "verses": [
    {
      "id": "b0f4c41f-ca56-4213-90dc-f2473535e67b",
      "text": "Hỡi các con,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:41.884Z",
      "updatedAt": "2025-09-03T02:40:41.884Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "8751d81b-fd06-4c30-8d65-29a63b7f36ca",
      "text": "hãy lắng nghe lời nghiêm huấn của bậc cha anh,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:41.924Z",
      "updatedAt": "2025-09-03T02:40:41.924Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "0edd30e7-c1cc-4079-a53a-a1cfb1d9393f",
      "text": "và chú ý để hiểu cho tường.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:41.935Z",
      "updatedAt": "2025-09-03T02:40:41.935Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "17787f62-5c45-4078-a6cc-2b72ab5f7d52",
      "text": "Thật vậy, thầy ban cho các con lời khuyên quý báu ;",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:41.946Z",
      "updatedAt": "2025-09-03T02:40:41.946Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "4d4cf963-c384-4f15-af00-85b9cde51f8d",
      "text": "đừng sao nhãng giáo huấn của thầy.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:41.958Z",
      "updatedAt": "2025-09-03T02:40:41.958Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "24f753fc-8744-4534-8eb5-6478b72b48bc",
      "text": "Thuở xưa, khi thầy còn nhỏ dại trước mặt phụ thân",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:41.971Z",
      "updatedAt": "2025-09-03T02:40:41.971Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "fa39e1af-be07-46f8-b1f3-bd7e4d165b8d",
      "text": "và được mẫu thân yêu dấu như con một,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:41.985Z",
      "updatedAt": "2025-09-03T02:40:41.985Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "428b9157-746e-4d61-a09d-3728dd835b78",
      "text": "phụ thân vẫn thường dạy thầy rằng :",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:41.999Z",
      "updatedAt": "2025-09-03T02:40:41.999Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "f8c5a6a3-54cb-4645-a035-f3710eb6947d",
      "text": "“Hãy để tâm nắm chắc lời cha,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.014Z",
      "updatedAt": "2025-09-03T02:40:42.014Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "e6ae118c-b18f-4b1e-acd6-a4103fff4d54",
      "text": "tuân giữ lệnh cha truyền, và con sẽ được sống.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.028Z",
      "updatedAt": "2025-09-03T02:40:42.028Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "f31f87c0-b698-4dca-b2fb-0655650965fc",
      "text": "Hiểu biết và khôn ngoan, con hãy mua hãy sắm.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.058Z",
      "updatedAt": "2025-09-03T02:40:42.058Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "c5181dd0-cf56-4a76-8ad8-a0af171dd7fa",
      "text": "Đừng bao giờ quên lãng và cũng chớ lìa xa",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.086Z",
      "updatedAt": "2025-09-03T02:40:42.086Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "9690f6ff-8c4a-4498-a7ad-3cdd9723412c",
      "text": "lời miệng cha dạy dỗ.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.100Z",
      "updatedAt": "2025-09-03T02:40:42.100Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "4ebfd0dc-cd64-4c75-b2d5-70efe9575da4",
      "text": "Con chớ bao giờ lìa bỏ khôn ngoan,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.115Z",
      "updatedAt": "2025-09-03T02:40:42.115Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "51deddb3-c69e-44a7-b6a5-4621ffad40f8",
      "text": "thì khôn ngoan sẽ giữ gìn con mãi.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.129Z",
      "updatedAt": "2025-09-03T02:40:42.129Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "848e3866-820e-43ce-b354-06cde8d29938",
      "text": "Hãy yêu mến khôn ngoan,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.142Z",
      "updatedAt": "2025-09-03T02:40:42.142Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "3eede53c-146f-48be-b7c7-efe2fffadd3a",
      "text": "khôn ngoan sẽ chở che bảo vệ.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 3,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.157Z",
      "updatedAt": "2025-09-03T02:40:42.157Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "d7e47a26-69a3-40ed-8700-91d3524e6f03",
      "text": "Đây là bước đầu của khôn ngoan :",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.171Z",
      "updatedAt": "2025-09-03T02:40:42.171Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "b7aaed11-a6e3-4172-bbfa-57bdb8831b54",
      "text": "con hãy mua lấy khôn ngoan ;",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.186Z",
      "updatedAt": "2025-09-03T02:40:42.186Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "fef2cd66-f76f-4333-8950-f945a7ebe931",
      "text": "và dùng tất cả những gì con sở hữu",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.203Z",
      "updatedAt": "2025-09-03T02:40:42.203Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "7ef0e09c-6350-4896-ad16-2beda2a5982e",
      "text": "mà sắm lấy hiểu biết.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 3,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.220Z",
      "updatedAt": "2025-09-03T02:40:42.220Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "7467e38e-f4df-436f-b538-65b0e47211f1",
      "text": "Hãy kính trọng khôn ngoan,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.250Z",
      "updatedAt": "2025-09-03T02:40:42.250Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "dcf4a9c9-63d4-4588-8a34-e67e88710465",
      "text": "con sẽ được khôn ngoan tán dương ca tụng ;",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.263Z",
      "updatedAt": "2025-09-03T02:40:42.263Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "074d8b1a-5998-42d3-a0bd-5ff7542b6734",
      "text": "nếu con cùng khôn ngoan gắn bó,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.274Z",
      "updatedAt": "2025-09-03T02:40:42.274Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "a1b68f6d-2cc3-496f-b5f1-8ffa6396aa21",
      "text": "khôn ngoan sẽ đem vinh dự lại cho con.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 3,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.296Z",
      "updatedAt": "2025-09-03T02:40:42.296Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "305cffba-140f-4675-9467-7fdd085037b9",
      "text": "Khôn ngoan sẽ đội lên đầu con vòng hoa lộng lẫy,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.308Z",
      "updatedAt": "2025-09-03T02:40:42.308Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "15f9fb5b-20f4-44e8-8724-36c3065e7bf9",
      "text": "sẽ tặng cho con ngọc miện huy hoàng.”",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.335Z",
      "updatedAt": "2025-09-03T02:40:42.335Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "961af6c2-cce1-4045-a66e-589f0a553d02",
      "text": "Này con, hãy lắng nghe và đón nhận lời thầy dạy bảo,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.349Z",
      "updatedAt": "2025-09-03T02:40:42.349Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "1c2e252a-493b-4cd9-b583-893e71812744",
      "text": "để năm tháng đời con được thêm nhiều.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.382Z",
      "updatedAt": "2025-09-03T02:40:42.382Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "04b4a95c-811f-4f68-8437-1f5d91789c8e",
      "text": "Thầy dạy cho con biết lối khôn ngoan,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.409Z",
      "updatedAt": "2025-09-03T02:40:42.409Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "4a5d878b-5471-4ec7-9ac3-24138e1be470",
      "text": "dẫn con đi trên đường ngay nẻo chính.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.423Z",
      "updatedAt": "2025-09-03T02:40:42.423Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "064a8bf7-c791-45ab-8a93-b1ff63d37163",
      "text": "Khi con đi, bước chân sẽ thênh thang,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.437Z",
      "updatedAt": "2025-09-03T02:40:42.437Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "79edf08c-dd39-4298-b2df-914e42d931af",
      "text": "con có chạy cũng không hề vấp ngã.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.450Z",
      "updatedAt": "2025-09-03T02:40:42.450Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "b5cdf57e-35a2-4734-a3a0-0a943c570d03",
      "text": "Hãy bám chắc vào lời nghiêm huấn,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.483Z",
      "updatedAt": "2025-09-03T02:40:42.483Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "e9a61e83-6d29-47b2-9f91-a7552509b15a",
      "text": "con chớ có lìa xa, nhưng gắng mà tuân giữ,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.497Z",
      "updatedAt": "2025-09-03T02:40:42.497Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "d2f64ca1-947f-4e62-ab4b-4c635f87eae1",
      "text": "vì đó là sự sống của con.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.511Z",
      "updatedAt": "2025-09-03T02:40:42.511Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "b1248930-0c27-463c-a995-19d5fc5232a3",
      "text": "Nẻo ác nhân, con chớ đi vào,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.525Z",
      "updatedAt": "2025-09-03T02:40:42.525Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "dcb0a3bd-9cc6-493b-95dc-ce22eb6e3479",
      "text": "đường kẻ xấu, con đừng bước tới.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.539Z",
      "updatedAt": "2025-09-03T02:40:42.539Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "20db16fd-a5da-4cde-b49a-a5fab0bb8e59",
      "text": "Hãy tránh xa, đừng ngang qua lối ấy,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.571Z",
      "updatedAt": "2025-09-03T02:40:42.571Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "5dfe1af2-ed2f-40c6-9b63-5a6a41d748ee",
      "text": "quay lưng lại, tìm lối khác mà đi.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.585Z",
      "updatedAt": "2025-09-03T02:40:42.585Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "3a3b3b77-1f4d-4cab-aad8-baa85756e44c",
      "text": "Vì khi chưa làm được điều dữ, ác nhân không tài nào chợp mắt,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.599Z",
      "updatedAt": "2025-09-03T02:40:42.599Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "b312129a-7345-4ef2-8fbb-261a625861b6",
      "text": "khi chưa làm cho ai vấp ngã, chúng không thể ngủ yên.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.614Z",
      "updatedAt": "2025-09-03T02:40:42.614Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "0db49ad3-4c05-4a95-bba1-7589816b0355",
      "text": "Vì gian ác là bánh chúng ăn",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.628Z",
      "updatedAt": "2025-09-03T02:40:42.628Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "ac96a747-fa91-4ebf-8d72-c6d3a1d380e9",
      "text": "và bạo hành là rượu chúng uống.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.642Z",
      "updatedAt": "2025-09-03T02:40:42.642Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "e8281849-00fe-43be-9bf9-a16695a4037d",
      "text": "Đường người công chính tựa ánh bình minh,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.656Z",
      "updatedAt": "2025-09-03T02:40:42.656Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "c26d25da-56ae-4c68-a135-e31db3d2d07c",
      "text": "rực rỡ thêm cho đến hồi chính ngọ.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.670Z",
      "updatedAt": "2025-09-03T02:40:42.670Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "9f6d3d98-f44a-40b1-991e-79f3af85a8af",
      "text": "Còn đường ác nhân khác nào ngõ tối,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.685Z",
      "updatedAt": "2025-09-03T02:40:42.685Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "7153c5f7-b4f8-40c6-a96b-a6b05c80933f",
      "text": "chúng không biết mình sẽ vấp vào đâu.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.712Z",
      "updatedAt": "2025-09-03T02:40:42.712Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "029d3b7c-464c-4878-a74b-d4bc7da03234",
      "text": "Này con, lời thầy nói, con chú tâm để ý,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.726Z",
      "updatedAt": "2025-09-03T02:40:42.726Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "d429e7ed-0162-426c-904c-ba0d97522246",
      "text": "lời thầy dạy, con hãy lắng tai nghe :",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.740Z",
      "updatedAt": "2025-09-03T02:40:42.740Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "bd0471e3-61cc-415e-b9ba-2482f2d4ac0d",
      "text": "đừng để mắt rời xa lời thầy,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.754Z",
      "updatedAt": "2025-09-03T02:40:42.754Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "a0db260b-98ca-4982-beac-4ad0f42cc67b",
      "text": "nhưng hãy luôn gìn giữ ở tận đáy lòng con.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.769Z",
      "updatedAt": "2025-09-03T02:40:42.769Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "5b80f600-78ab-4c51-adb6-14edaadaa8b8",
      "text": "Vì lời thầy là sức sống cho ai tìm thấy",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.783Z",
      "updatedAt": "2025-09-03T02:40:42.783Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "7d6d754b-aadb-45d0-adc8-e37943483626",
      "text": "làm cho toàn thân được mạnh khoẻ an lành.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.797Z",
      "updatedAt": "2025-09-03T02:40:42.797Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "ba8d41b1-20b5-4e78-8d19-132d226d8a49",
      "text": "Hãy gìn giữ tim con cho thật kỹ,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.810Z",
      "updatedAt": "2025-09-03T02:40:42.810Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "0d6b2fb6-ddda-4088-8fe1-9c7f1e0c64f0",
      "text": "vì từ đó mà sự sống phát sinh.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.824Z",
      "updatedAt": "2025-09-03T02:40:42.824Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "66681c7c-7833-4778-b8bc-c7741fc839cd",
      "text": "Miệng lọc lừa, con đẩy cho xa,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.835Z",
      "updatedAt": "2025-09-03T02:40:42.835Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "fc545b78-6578-4197-b3c9-1d3a84f0dfcb",
      "text": "môi thâm độc, con xua cho khuất.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.847Z",
      "updatedAt": "2025-09-03T02:40:42.847Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "2281700c-7e38-4553-ab48-bebfad80a26d",
      "text": "Đôi mắt con, hãy nhìn ngay phía trước,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.872Z",
      "updatedAt": "2025-09-03T02:40:42.872Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "fd486e5f-8952-4aa4-aeb3-ee797ee29398",
      "text": "ánh mắt con, hướng thẳng trước mặt con.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.884Z",
      "updatedAt": "2025-09-03T02:40:42.884Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "c3ed8de9-f28a-4e42-b454-0c5a3a124faa",
      "text": "Đường con đi, hãy san cho phẳng,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.896Z",
      "updatedAt": "2025-09-03T02:40:42.896Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "eb7e9ddd-3408-4025-956a-129c24f41118",
      "text": "ước chi mọi nẻo con bước được an toàn.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 61,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.921Z",
      "updatedAt": "2025-09-03T02:40:42.921Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "44025006-ace8-464e-8a01-c761291345b4",
      "text": "Đừng quanh bên phải, chớ quẹo bên trái,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 62,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.935Z",
      "updatedAt": "2025-09-03T02:40:42.935Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "94d8dcc9-a73a-46b9-ba9a-1e9343587650",
      "text": "cố giữ chân con khỏi điều xấu xa.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 63,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:42.963Z",
      "updatedAt": "2025-09-03T02:40:42.963Z",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    }
  ],
  "marks": [
    {
      "id": "648dad35-bfdc-4b46-b88c-54dfeded55c5",
      "content": "Bài huấn dụ thứ năm (cc. 1-9) là lời mời gọi hãy mua lấy khôn ngoan. Khôn ngoan đến qua lời giáo huấn của người cha trong gia đình (cc. 4-9). Muốn được khôn ngoan, cần tập lắng nghe, vâng phục với tinh thần phó thác của trẻ thơ. Không thấy nhắc đến Đức Chúa trong cả đoạn này.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 11,
      "endOffset": 11,
      "createdAt": "2025-09-03T02:40:41.914Z",
      "updatedAt": "2025-09-03T02:40:41.914Z",
      "targetId": "b0f4c41f-ca56-4213-90dc-f2473535e67b",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "fc126d29-6e7b-46c9-b0b7-4ec5ee2ce662",
      "content": "Cn 7,2",
      "kind": "MARK_KIND_REFERENCE",
      "label": "1@",
      "sortOrder": 0,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:40:42.044Z",
      "updatedAt": "2025-09-03T02:40:42.044Z",
      "targetId": "e6ae118c-b18f-4b1e-acd6-a4103fff4d54",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "90481f6a-96a4-4f5a-859e-4d9619d28c58",
      "content": "Cn 4,7; Mt 13,44-46",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:40:42.072Z",
      "updatedAt": "2025-09-03T02:40:42.072Z",
      "targetId": "f31f87c0-b698-4dca-b2fb-0655650965fc",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "c8d398e1-1a4f-4004-b817-a38857463f63",
      "content": "Để sắm được khôn ngoan cần phải thấy giá trị của nó và dám chấp nhận những hy sinh như giá phải trả.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 20,
      "endOffset": 20,
      "createdAt": "2025-09-03T02:40:42.234Z",
      "updatedAt": "2025-09-03T02:40:42.234Z",
      "targetId": "7ef0e09c-6350-4896-ad16-2beda2a5982e",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "bd17b5e4-d614-45ec-a04a-32397218566b",
      "content": "Nghĩa không rõ. Nhiều bản hiểu là *khen ngợi* hay *ôm ghì*. Khôn ngoan cần phải được yêu mến (c.6) và gắn bó như một con người.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 30,
      "endOffset": 30,
      "createdAt": "2025-09-03T02:40:42.285Z",
      "updatedAt": "2025-09-03T02:40:42.285Z",
      "targetId": "074d8b1a-5998-42d3-a0bd-5ff7542b6734",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "9e6d0341-d08e-4a54-bc17-beb02e0182cb",
      "content": "Cn 1,9",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 30,
      "endOffset": 30,
      "createdAt": "2025-09-03T02:40:42.322Z",
      "updatedAt": "2025-09-03T02:40:42.322Z",
      "targetId": "305cffba-140f-4675-9467-7fdd085037b9",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "b3c0552d-f0df-434a-9e3a-be7f9f74f578",
      "content": "Ta gặp những từ như *đường, nẻo, lối* trong huấn dụ thứ sáu này (cc. 10-27). Chủ đề về con đường là một trong những chủ đề chính của văn chương khôn ngoan. Đường thẳng dẫn đến ánh sáng và sự sống. Đường quanh co dẫn đến bóng tối và sự chết.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 51,
      "endOffset": 51,
      "createdAt": "2025-09-03T02:40:42.367Z",
      "updatedAt": "2025-09-03T02:40:42.367Z",
      "targetId": "961af6c2-cce1-4045-a66e-589f0a553d02",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "30322549-8575-42d3-8693-c58ff253397f",
      "content": "Cn 3,2",
      "kind": "MARK_KIND_REFERENCE",
      "label": "4@",
      "sortOrder": 3,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:40:42.396Z",
      "updatedAt": "2025-09-03T02:40:42.396Z",
      "targetId": "1c2e252a-493b-4cd9-b583-893e71812744",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "e5191d78-4ae5-4f21-9d9b-0cf0de72ad67",
      "content": "Cn 3,23",
      "kind": "MARK_KIND_REFERENCE",
      "label": "5@",
      "sortOrder": 4,
      "startOffset": 26,
      "endOffset": 26,
      "createdAt": "2025-09-03T02:40:42.465Z",
      "updatedAt": "2025-09-03T02:40:42.465Z",
      "targetId": "79edf08c-dd39-4298-b2df-914e42d931af",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d336c1b8-7369-4bba-8c8b-7429d4da850e"
    },
    {
      "id": "b63fe12d-4767-45dc-b4f8-c7ef9fe29d89",
      "content": "Cần dứt khoát với cái xấu ngay từ đầu ; nếu để mình vướng vào sẽ khó thoát ra được. Cc. 23-27 cũng cho thấy thái độ kiên quyết không khoan nhượng trước những điều xấu nhỏ. Chỉ có một con đường thẳng trước mặt để tiến tới.",
      "kind": "MARK_KIND_FOOTNOTE",
