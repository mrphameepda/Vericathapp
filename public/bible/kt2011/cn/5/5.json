{
  "chapter": {
    "id": "2f649756-37ee-47fb-817f-5c451d12d769",
    "number": 5,
    "createdAt": "2025-09-03T01:07:51.667Z",
    "updatedAt": "2025-09-03T01:07:51.667Z",
    "bookId": "1ea97633-82d8-4f1a-bffc-dfb2da235911"
  },
  "verses": [
    {
      "id": "c0fc128b-7bbb-4932-9e56-ddb0220e5668",
      "text": "Này con, khôn ngoan của thầy, con hãy chú tâm học hỏi,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.039Z",
      "updatedAt": "2025-09-03T02:40:48.039Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "1c6bf0ed-a9ef-41d1-b1b8-cfc79edec07c",
      "text": "hiểu biết của thầy, con hãy lắng tai nghe,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.090Z",
      "updatedAt": "2025-09-03T02:40:48.090Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "af436040-edc0-4cbb-8cb5-ebcf3f861342",
      "text": "để con cân nhắc thận trọng",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.102Z",
      "updatedAt": "2025-09-03T02:40:48.102Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "cd529aaa-45e0-46a7-affe-aab99abd2fe3",
      "text": "và nói năng như người hiểu biết.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.113Z",
      "updatedAt": "2025-09-03T02:40:48.113Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "d53b46bc-98db-4f0a-acd9-5c844584694d",
      "text": "Quả thật, môi người đàn bà trắc nết tiết ra mật ngọt,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.140Z",
      "updatedAt": "2025-09-03T02:40:48.140Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "476e122c-df4d-47d3-8bde-852a05dc434b",
      "text": "miệng của nó trơn tru hơn dầu.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.171Z",
      "updatedAt": "2025-09-03T02:40:48.171Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "30da33ad-24d1-426a-a214-50435d8f8882",
      "text": "Nhưng cuối cùng, nó vẫn đắng như khổ ngải,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.185Z",
      "updatedAt": "2025-09-03T02:40:48.185Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "4268ffb5-6c5e-4f65-a3ec-c0401d908312",
      "text": "bén như gươm hai lưỡi.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.214Z",
      "updatedAt": "2025-09-03T02:40:48.214Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "e0daf869-60df-4327-9a03-925c21a91b9e",
      "text": "Đôi chân nó đi vào cõi chết,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.227Z",
      "updatedAt": "2025-09-03T02:40:48.227Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "22daae60-696e-4331-8ccb-caa74f77bd2a",
      "text": "nó thẳng đường bước tới âm ty.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.242Z",
      "updatedAt": "2025-09-03T02:40:48.242Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "6bf8c963-1e39-4944-9ff5-f209876204c1",
      "text": "Đường dẫn vào sự sống, nó không theo,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.257Z",
      "updatedAt": "2025-09-03T02:40:48.257Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "b50fd364-d90e-4a6f-bdc6-dbf6f93e4958",
      "text": "nó lạc lối, mà không hay biết.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.271Z",
      "updatedAt": "2025-09-03T02:40:48.271Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "158b2314-1059-4a57-9621-853c5feb244b",
      "text": "Vậy giờ đây, hỡi các con, hãy nghe thầy,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.285Z",
      "updatedAt": "2025-09-03T02:40:48.285Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "d7b3d672-5ca5-4682-9e54-2fcdde90c81d",
      "text": "đừng bỏ đi khi thầy lên tiếng nói.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.299Z",
      "updatedAt": "2025-09-03T02:40:48.299Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "716712b3-8faa-4cd0-b682-d7a12765b656",
      "text": "Trên đường đời, con hãy xa lánh nó,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.312Z",
      "updatedAt": "2025-09-03T02:40:48.312Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "dc204443-d4c9-4a5d-9969-92748ae364b7",
      "text": "lối vào nhà nó, con chớ lại gần,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.325Z",
      "updatedAt": "2025-09-03T02:40:48.325Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "8e523a72-bb65-4379-9561-c65e6749951c",
      "text": "kẻo danh dự con bị trao vào tay người khác,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.351Z",
      "updatedAt": "2025-09-03T02:40:48.351Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "9d74e6ed-49cf-48ff-9fc1-22194a4bf5a2",
      "text": "và năm tháng đời con bị nộp cho đứa bạo tàn,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.364Z",
      "updatedAt": "2025-09-03T02:40:48.364Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "7a8efd2f-c145-44c1-af8b-fe5b07985372",
      "text": "kẻo tài sản của con, người ngoài tha hồ hưởng,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.378Z",
      "updatedAt": "2025-09-03T02:40:48.378Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "d45c1f67-0e56-4ac3-a85b-dfddd45177e2",
      "text": "và mồ hôi nước mắt của con lại giúp cho thiên hạ làm giàu,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.392Z",
      "updatedAt": "2025-09-03T02:40:48.392Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "02fc76c7-00fd-477c-bf87-65810f160c99",
      "text": "để cuối cùng, khi thân tàn ma dại,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.416Z",
      "updatedAt": "2025-09-03T02:40:48.416Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "001f65eb-bc33-4a9a-8b73-15f670c4a559",
      "text": "con đành phải trách phận than thân,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.430Z",
      "updatedAt": "2025-09-03T02:40:48.430Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "f055085a-c8f0-4059-98b0-a46424ee39a1",
      "text": "và phải kêu lên rằng : “Than ôi, tôi đã ghét bỏ lời nghiêm huấn,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.444Z",
      "updatedAt": "2025-09-03T02:40:48.444Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "04d67357-932b-4577-9db5-074ab66b73c0",
      "text": "và lời sửa dạy, lòng tôi đã coi khinh !",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.459Z",
      "updatedAt": "2025-09-03T02:40:48.459Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "3db69792-54bc-4faa-8c22-c9daef6b60dc",
      "text": "Tôi chẳng vâng theo các bậc thầy.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.473Z",
      "updatedAt": "2025-09-03T02:40:48.473Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "bca67cdb-2577-4c47-a14a-e42140b1255d",
      "text": "Không để tai nghe những người dạy dỗ.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.487Z",
      "updatedAt": "2025-09-03T02:40:48.487Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "674b48af-0766-428b-8fd1-6cd844613410",
      "text": "Tôi suýt chịu bao nỗi khốn cùng",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.501Z",
      "updatedAt": "2025-09-03T02:40:48.501Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "c2b34a3f-bbcb-4165-9f33-39193af6da60",
      "text": "ở ngay giữa cộng đoàn và hội nghị !”",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.515Z",
      "updatedAt": "2025-09-03T02:40:48.515Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "d2536e75-bd78-484d-a547-4e6134aa6f02",
      "text": "Con hãy uống từ bồn nước của con,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.543Z",
      "updatedAt": "2025-09-03T02:40:48.543Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "be61ffea-e650-45ba-8200-d6fc829616db",
      "text": "từ giếng của con, hãy uống nước tuôn trào.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.572Z",
      "updatedAt": "2025-09-03T02:40:48.572Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "0f8de1bb-012e-4218-a877-50d107dca2be",
      "text": "Các suối nước của con, đừng để chảy ra ngoài,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.586Z",
      "updatedAt": "2025-09-03T02:40:48.586Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "d0db43a3-3c23-4925-b4c5-90196eae1d46",
      "text": "các dòng nước của con, đừng để chảy ở nơi đường phố.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.600Z",
      "updatedAt": "2025-09-03T02:40:48.600Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "b8246f14-85ac-4756-9aba-790109a8bac5",
      "text": "Con cứ giữ lấy làm của riêng mình,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.614Z",
      "updatedAt": "2025-09-03T02:40:48.614Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "faa38060-6064-484d-8619-117c8341b6f1",
      "text": "đừng để cho người khác dùng chung.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.628Z",
      "updatedAt": "2025-09-03T02:40:48.628Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "c6746191-aada-4cbb-8a6b-60c2994e7eb8",
      "text": "Ước gì nguồn nước của con được Chúa chúc lành.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.643Z",
      "updatedAt": "2025-09-03T02:40:48.643Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "85093243-0d3c-4357-8191-ffabec21307f",
      "text": "Hãy hưởng thú vui bên người vợ thời son trẻ.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.657Z",
      "updatedAt": "2025-09-03T02:40:48.657Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "c93a8eb9-47b0-43b6-966f-dddec3d6c084",
      "text": "Nàng là nai vàng đáng yêu, là sơn dương kiều diễm.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.684Z",
      "updatedAt": "2025-09-03T02:40:48.684Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "9ae27217-2244-47b8-87cd-6e117f6d28b7",
      "text": "Ước chi tấm thân nàng luôn làm con vui sướng thoả thuê,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.713Z",
      "updatedAt": "2025-09-03T02:40:48.713Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "52c494fb-9470-4b8a-bae4-74fc4cb2c98d",
      "text": "và tình yêu của nàng mãi làm con say sưa ngây ngất.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 2,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.728Z",
      "updatedAt": "2025-09-03T02:40:48.728Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "e84d418d-ed89-4eb4-916c-005b4bb8708d",
      "text": "Hỡi con, sao con lại mê say người đàn bà xa lạ,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.757Z",
      "updatedAt": "2025-09-03T02:40:48.757Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "96140c45-615e-4de1-8452-da1c02b798c3",
      "text": "ôm ấp người phụ nữ không quen ?",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.784Z",
      "updatedAt": "2025-09-03T02:40:48.784Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "9da71959-6fa3-4f27-a3dc-aefbef2786d8",
      "text": "Vì ĐỨC CHÚA thấy rõ đường nẻo của mỗi người,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.798Z",
      "updatedAt": "2025-09-03T02:40:48.798Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "c89150b0-e5e1-487a-bbbf-c41b0c7e4dd5",
      "text": "hết mọi lối đi, Người đều biết cả.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.829Z",
      "updatedAt": "2025-09-03T02:40:48.829Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "2077cc10-eb75-4fa8-b6d7-1d0b91deba59",
      "text": "Ác nhân vướng mắc trong tội ác của mình,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.843Z",
      "updatedAt": "2025-09-03T02:40:48.843Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "0e05b514-f006-46db-9007-844d7fb78328",
      "text": "nó sa vào bẫy tội lỗi nó giăng ra.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.857Z",
      "updatedAt": "2025-09-03T02:40:48.857Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "d03f71c2-957e-4538-a0e2-2b36b29b22cc",
      "text": "Nó sẽ chết vì thiếu lời nghiêm huấn,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.870Z",
      "updatedAt": "2025-09-03T02:40:48.870Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "e8a614f5-5dfe-481c-ba38-2e5a0bcc024d",
      "text": "vì ngu si quá đỗi, nó sẽ phải lạc đường.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:48.884Z",
      "updatedAt": "2025-09-03T02:40:48.884Z",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    }
  ],
  "marks": [
    {
      "id": "375013aa-7e26-4e08-b8d7-8c50798635e4",
      "content": "Huấn dụ thứ bảy (cc. 1-23) nói về nguy hiểm của người đàn bà trắc nết. Lời nói quyến rũ của mụ rốt cuộc đưa người thanh niên vào chỗ chết (cc. 1-6).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 7,
      "endOffset": 7,
      "createdAt": "2025-09-03T02:40:48.069Z",
      "updatedAt": "2025-09-03T02:40:48.069Z",
      "targetId": "c0fc128b-7bbb-4932-9e56-ddb0220e5668",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "f8c43d9c-d04b-4ef6-95cc-340e30407407",
      "content": "Cn 3,1",
      "kind": "MARK_KIND_REFERENCE",
      "label": "1@",
      "sortOrder": 0,
      "startOffset": 4,
      "endOffset": 4,
      "createdAt": "2025-09-03T02:40:48.079Z",
      "updatedAt": "2025-09-03T02:40:48.079Z",
      "targetId": "c0fc128b-7bbb-4932-9e56-ddb0220e5668",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "dd364c5a-c55d-448a-a667-d39590a85e25",
      "content": "Nhờ lắng nghe lời khôn ngoan của thầy mà người môn sinh giữ được sự tự do nội tâm trước những cám dỗ của dục vọng.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 31,
      "endOffset": 31,
      "createdAt": "2025-09-03T02:40:48.127Z",
      "updatedAt": "2025-09-03T02:40:48.127Z",
      "targetId": "cd529aaa-45e0-46a7-affe-aab99abd2fe3",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "71d4e692-67ae-4acc-9bea-488fd3423785",
      "content": "Cn 2,16",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 20,
      "endOffset": 20,
      "createdAt": "2025-09-03T02:40:48.158Z",
      "updatedAt": "2025-09-03T02:40:48.158Z",
      "targetId": "d53b46bc-98db-4f0a-acd9-5c844584694d",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "197deb03-1a1c-4785-b219-7fa0879e52c4",
      "content": "Gv 7,26",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 24,
      "endOffset": 24,
      "createdAt": "2025-09-03T02:40:48.199Z",
      "updatedAt": "2025-09-03T02:40:48.199Z",
      "targetId": "30da33ad-24d1-426a-a214-50435d8f8882",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "9f2911b1-58e8-4880-9c1b-8d1ec717d39d",
      "content": "Hậu quả của sự sa ngã với vợ người khác : mất danh dự, hỏng cuộc đời (c.9), mất tiền bạc để bồi thường cho người chồng (c.10), mất sức khoẻ (c.11).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 31,
      "endOffset": 31,
      "createdAt": "2025-09-03T02:40:48.338Z",
      "updatedAt": "2025-09-03T02:40:48.338Z",
      "targetId": "dc204443-d4c9-4a5d-9969-92748ae364b7",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "f318e758-a046-4434-8e6c-0e48623ad219",
      "content": "*Cộng đoàn và hội nghị* để chỉ toàn thể cộng đoàn dân Chúa, đôi khi được coi như một cộng đoàn phụng tự, thánh thiêng. Người phạm tội ngoại tình có thể bị ăn đòn và chịu ô nhục (6,33), thậm chí bị xử tử (Đnl 22,22).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 33,
      "endOffset": 33,
      "createdAt": "2025-09-03T02:40:48.529Z",
      "updatedAt": "2025-09-03T02:40:48.529Z",
      "targetId": "c2b34a3f-bbcb-4165-9f33-39193af6da60",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "7d576f3d-19d8-4ae1-a264-a787f05d3b67",
      "content": "Gv 9,9-10",
      "kind": "MARK_KIND_REFERENCE",
      "label": "4@",
      "sortOrder": 3,
      "startOffset": 28,
      "endOffset": 28,
      "createdAt": "2025-09-03T02:40:48.670Z",
      "updatedAt": "2025-09-03T02:40:48.670Z",
      "targetId": "85093243-0d3c-4357-8191-ffabec21307f",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "cdb2ae00-2c7f-4d46-8aa2-62f4fec855e3",
      "content": "Người vợ chính thức được ví bằng những hình ảnh khác nhau về *nước* : bồn nước, giếng nước, suối nước, dòng nước, nguồn nước. *Nước* là điều quan trọng cho sự sống trong một xứ sở khô nóng như Ít-ra-en.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "5",
      "sortOrder": 4,
      "startOffset": 24,
      "endOffset": 24,
      "createdAt": "2025-09-03T02:40:48.559Z",
      "updatedAt": "2025-09-03T02:40:48.559Z",
      "targetId": "d2536e75-bd78-484d-a547-4e6134aa6f02",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "012a0cbc-e154-49ab-a77b-80ad03c3273f",
      "content": "Dc 2,9; 7,4; 8,14",
      "kind": "MARK_KIND_REFERENCE",
      "label": "5@",
      "sortOrder": 4,
      "startOffset": 8,
      "endOffset": 8,
      "createdAt": "2025-09-03T02:40:48.700Z",
      "updatedAt": "2025-09-03T02:40:48.700Z",
      "targetId": "c93a8eb9-47b0-43b6-966f-dddec3d6c084",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
      "id": "316a5f77-0e6c-468e-8f89-8b8cba136d8f",
      "content": "Tình yêu như một thứ rượu làm người ta say (x. 20,1).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "6",
      "sortOrder": 5,
      "startOffset": 50,
      "endOffset": 50,
      "createdAt": "2025-09-03T02:40:48.743Z",
      "updatedAt": "2025-09-03T02:40:48.743Z",
      "targetId": "52c494fb-9470-4b8a-bae4-74fc4cb2c98d",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "2f649756-37ee-47fb-817f-5c451d12d769"
    },
    {
