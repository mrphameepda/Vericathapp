{
  "chapter": {
    "id": "6bf53da1-8bc2-4981-9f88-da98649d6aad",
    "number": 6,
    "createdAt": "2025-09-03T01:07:51.667Z",
    "updatedAt": "2025-09-03T01:07:51.667Z",
    "bookId": "1ea97633-82d8-4f1a-bffc-dfb2da235911"
  },
  "verses": [
    {
      "id": "6d134e50-4b1a-4190-981f-cbe1fb30dcf2",
      "text": "Hỡi con, nếu con đã bảo lãnh cho một người bạn của mình,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:54.451Z",
      "updatedAt": "2025-09-03T02:40:54.451Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "f2441ad7-4d65-4f09-84a9-33d960d04243",
      "text": "hay đã bắt tay giao kèo với một người xa lạ,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:54.502Z",
      "updatedAt": "2025-09-03T02:40:54.502Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "baa9f6db-4a44-49d7-b964-e6fb04f60d5a",
      "text": "nếu con bị trói buộc vì những điều con đã hứa",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:54.526Z",
      "updatedAt": "2025-09-03T02:40:54.526Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "6de0e53d-4f53-4c9d-9f4c-1686ee8606b9",
      "text": "hay vướng mắc vì những lời con đã nói ra,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:54.540Z",
      "updatedAt": "2025-09-03T02:40:54.540Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "1526a216-7be7-46bf-bea0-c6c626a1752a",
      "text": "thì con ơi, khi đã trót rơi vào tay người bạn,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:54.554Z",
      "updatedAt": "2025-09-03T02:40:54.554Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "6316ff50-df04-48ee-a956-2c1882cf2776",
      "text": "muốn thoát thân, con phải làm điều này",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:54.571Z",
      "updatedAt": "2025-09-03T02:40:54.571Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "0477c471-be49-423e-8ce9-09fc9bb948c5",
      "text": "là hãy đi lạy lục van xin nó.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:54.588Z",
      "updatedAt": "2025-09-03T02:40:54.588Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "83358da0-7361-4bd2-9598-3fede3c105ad",
      "text": "Đừng chớp mắt khép mi, chớ nghỉ ngơi yên giấc.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:54.601Z",
      "updatedAt": "2025-09-03T02:40:54.601Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "71ab1dbc-db92-4ef6-9c7d-77c19f2058ea",
      "text": "Hãy tìm cách thoát thân như linh dương thoát bẫy,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:54.618Z",
      "updatedAt": "2025-09-03T02:40:54.618Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "dff0e939-a3e1-4f90-8195-39b08a8a1c3e",
      "text": "như chim thoát khỏi tay người tìm bắt chim.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:54.629Z",
      "updatedAt": "2025-09-03T02:40:54.629Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "b46fcec0-2203-41b7-80df-24d8e3de3a4a",
      "text": "Hỡi người biếng nhác, hãy đến xem loài kiến sống thế nào",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:54.641Z",
      "updatedAt": "2025-09-03T02:40:54.641Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "30b18fd9-615f-4d5d-a19e-eab52d655c7b",
      "text": "và nhờ đó mà trở nên khôn.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:54.692Z",
      "updatedAt": "2025-09-03T02:40:54.692Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "21316d2b-c29f-40b1-8f4d-0b536d7f26af",
      "text": "Nó chẳng có thủ trưởng,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:54.721Z",
      "updatedAt": "2025-09-03T02:40:54.721Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "70768ca7-3f8d-419e-a376-a73c03daac69",
      "text": "chẳng có giám sát, chẳng có lãnh đạo.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:54.738Z",
      "updatedAt": "2025-09-03T02:40:54.738Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "f524ca27-228b-4507-a09b-3ca5142e7fc0",
      "text": "Nhưng mùa khô đến, chúng biết tích trữ thức ăn,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:54.754Z",
      "updatedAt": "2025-09-03T02:40:54.754Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "39b8671b-d573-4e87-878d-66452b6e58e1",
      "text": "tới mùa gặt, chúng thu gom lương thực.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:54.767Z",
      "updatedAt": "2025-09-03T02:40:54.767Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "1bb2b6f2-300e-4376-9f92-0a96752bff05",
      "text": "Hỡi người biếng nhác, ngươi còn nằm đó tới bao giờ ?",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:54.787Z",
      "updatedAt": "2025-09-03T02:40:54.787Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "ed29d6e8-ccb7-47f5-a9fc-51967d7720c6",
      "text": "Chừng nào ngươi mới ngủ dậy ?",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:54.802Z",
      "updatedAt": "2025-09-03T02:40:54.802Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "01ac8d44-398e-4f25-863e-ed09c45d9e0a",
      "text": "Ngủ một chút, chợp mắt một chút, khoanh tay nằm một chút,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:54.816Z",
      "updatedAt": "2025-09-03T02:40:54.816Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "0c735a86-d5e5-4156-9b0b-1bad23d840ff",
      "text": "là cái nghèo sẽ đến như tên du thủ du thực,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:54.844Z",
      "updatedAt": "2025-09-03T02:40:54.844Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "7041c6f1-6c74-4084-93dd-ee41f6e148d1",
      "text": "cảnh bần cùng sẽ đột nhập như người có vũ trang.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:54.858Z",
      "updatedAt": "2025-09-03T02:40:54.858Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "7d47b69b-bea8-4b1d-8372-d32e75825c9f",
      "text": "Đây tên gian ác, đây đứa xấu xa,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:54.872Z",
      "updatedAt": "2025-09-03T02:40:54.872Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "090d15b2-b345-41a5-aafa-2a07446fdb5d",
      "text": "nó tới lui, miệng buông lời dối trá,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:54.915Z",
      "updatedAt": "2025-09-03T02:40:54.915Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "c309ae10-29c8-401f-99dc-15710a268873",
      "text": "nó nháy mắt, khều chân, dùng ngón tay ra hiệu.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:54.929Z",
      "updatedAt": "2025-09-03T02:40:54.929Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "596d7092-3cdb-48b5-91ac-051b2e4d7bd7",
      "text": "Nó toan tính trong lòng mọi chước độc mưu thâm,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:54.943Z",
      "updatedAt": "2025-09-03T02:40:54.943Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "5a66bbfe-b5b9-48f1-96e0-1e3c3ce1e9a7",
      "text": "lúc nào cũng gieo bất hoà, xung khắc.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:54.957Z",
      "updatedAt": "2025-09-03T02:40:54.957Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "59bbc1df-224d-4945-837d-87738dd1b54b",
      "text": "Thế nên tai hoạ sẽ giáng xuống nó thình lình,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:54.975Z",
      "updatedAt": "2025-09-03T02:40:54.975Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "64d45265-b251-4ffd-889a-60900b95bf8f",
      "text": "bất ngờ nó bị suy sụp, vô phương cứu chữa.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:54.992Z",
      "updatedAt": "2025-09-03T02:40:54.992Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "a632cdd3-ac28-4e9d-a513-e6c6cbd1a720",
      "text": "Có sáu điều làm ĐỨC CHÚA gớm ghét,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:55.006Z",
      "updatedAt": "2025-09-03T02:40:55.006Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "338ac2cf-3d2a-471d-b94e-91379b562e95",
      "text": "có bảy điều khiến Người ghê tởm :",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:55.052Z",
      "updatedAt": "2025-09-03T02:40:55.052Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "d09457eb-cee3-43a6-8e88-a4fee9656c3e",
      "text": "mắt kiêu kỳ, lưỡi điêu ngoa, tay đổ máu người vô tội,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:55.063Z",
      "updatedAt": "2025-09-03T02:40:55.063Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "48743bcb-d5ff-41b8-8973-bf2e342a316c",
      "text": "lòng mưu tính những chuyện xấu xa,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:55.085Z",
      "updatedAt": "2025-09-03T02:40:55.085Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "4fe20e1b-01ce-4320-aafe-b4399fa404a3",
      "text": "chân mau mắn chạy đi làm điều dữ,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:55.096Z",
      "updatedAt": "2025-09-03T02:40:55.096Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "0dd13494-6474-4cc6-af29-4461c7e3832b",
      "text": "kẻ làm chứng gian thốt ra lời dối trá,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:55.118Z",
      "updatedAt": "2025-09-03T02:40:55.118Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "b74c830a-6b11-4ca1-9817-ab7834d416c9",
      "text": "người gieo xung khắc giữa anh em.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:55.146Z",
      "updatedAt": "2025-09-03T02:40:55.146Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "7f83bc41-ce0d-4932-b2bd-fb94784796a9",
      "text": "Hỡi con, lệnh cha con truyền, hãy lo tuân giữ,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:55.160Z",
      "updatedAt": "2025-09-03T02:40:55.160Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "5e6ecdeb-51dd-4bd7-88f8-a3df3e44197b",
      "text": "lời mẹ con dạy, chớ bỏ ngoài tai.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:55.218Z",
      "updatedAt": "2025-09-03T02:40:55.218Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "de0ea561-3211-4ae7-90c6-0436cd624aaf",
      "text": "Những lời truyền dạy đó,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:55.232Z",
      "updatedAt": "2025-09-03T02:40:55.232Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "d4edbc6b-c527-43db-bcfa-67c08d9d3e80",
      "text": "con hãy khắc trong tim, con hãy đeo vào cổ,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:55.246Z",
      "updatedAt": "2025-09-03T02:40:55.246Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "01ec8cf2-d8a8-4964-90b5-37c11b21c020",
      "text": "để ghi nhớ đêm ngày.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 2,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:55.276Z",
      "updatedAt": "2025-09-03T02:40:55.276Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "20abdc4a-674d-4c74-a1c6-31c386c0483f",
      "text": "Những lời đó sẽ hướng dẫn con lúc con tới lui,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:55.289Z",
      "updatedAt": "2025-09-03T02:40:55.289Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "9a3ebc89-cd5b-4cf3-a60e-31a4ae21276b",
      "text": "sẽ giữ gìn con khi con nằm xuống,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:55.301Z",
      "updatedAt": "2025-09-03T02:40:55.301Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "14fa34b1-1b96-4f79-a6aa-2acf9f580602",
      "text": "sẽ cùng con chuyện trò khi con thức dậy.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 2,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:55.327Z",
      "updatedAt": "2025-09-03T02:40:55.327Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "e121a45a-1abe-4a35-a1c8-2c0000af656e",
      "text": "Vì huấn lệnh là ngọn đèn, lời dạy dỗ là ánh sáng,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:55.357Z",
      "updatedAt": "2025-09-03T02:40:55.357Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "e9678bae-af3f-406e-8432-7986baf20c05",
      "text": "và lời quở trách bảo ban là đường dẫn tới sự sống,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:55.382Z",
      "updatedAt": "2025-09-03T02:40:55.382Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "ce997f99-0327-4c19-8bbd-650679c98c64",
      "text": "nhờ đó con sẽ được giữ gìn",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:55.424Z",
      "updatedAt": "2025-09-03T02:40:55.424Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "b915acd0-ae67-4c08-ba76-d22fa02acc44",
      "text": "khỏi tay người đàn bà trắc nết,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:55.438Z",
      "updatedAt": "2025-09-03T02:40:55.438Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "3fb90ebd-d4b4-47a9-986f-d4019ff75325",
      "text": "khỏi lời đường mật của người phụ nữ đã có chồng.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 2,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:55.466Z",
      "updatedAt": "2025-09-03T02:40:55.466Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "90ef73e9-e8bb-4336-8395-9eb408e6bb42",
      "text": "Đừng để sắc đẹp nó quyến rũ lòng con,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:55.480Z",
      "updatedAt": "2025-09-03T02:40:55.480Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "7ad2f047-5705-419b-946a-68e9a53b5f9e",
      "text": "đừng để ánh mắt nó làm con mê mẩn.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:55.494Z",
      "updatedAt": "2025-09-03T02:40:55.494Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "33204707-b199-4fba-b333-ad01f88ecd12",
      "text": "Vì gái điếm chỉ đòi một ổ bánh thôi,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:55.508Z",
      "updatedAt": "2025-09-03T02:40:55.508Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "a4e344b3-dd90-4427-9cc8-d69f2066e80c",
      "text": "còn người phụ nữ đã có chồng",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:55.537Z",
      "updatedAt": "2025-09-03T02:40:55.537Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "00143259-cee9-4497-b547-24423d6760a2",
      "text": "làm hỏng cả một cuộc đời cao quý.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 2,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:55.551Z",
      "updatedAt": "2025-09-03T02:40:55.551Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "e7bc970d-b144-4f24-a794-a3427aa419f6",
      "text": "Có ai giấu lửa trong người mà không bị cháy áo ?",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:55.565Z",
      "updatedAt": "2025-09-03T02:40:55.565Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "a07a1e05-c21e-47b7-aacb-feeffffa8c8e",
      "text": "Có ai đi trên than hồng mà không bị bỏng chân ?",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:55.579Z",
      "updatedAt": "2025-09-03T02:40:55.579Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "b6f3f688-d025-41bb-b241-27ff59f57249",
      "text": "Người giao du với vợ bạn mình cũng thế,",
      "label": "29",
      "number": 29,
      "subVerseIndex": 0,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:55.593Z",
      "updatedAt": "2025-09-03T02:40:55.593Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "9d2d31af-f9b0-43d2-b7f4-41ba6e4df8c5",
      "text": "gần gũi nàng ắt bị trừng phạt thôi.",
      "label": "29",
      "number": 29,
      "subVerseIndex": 1,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:55.606Z",
      "updatedAt": "2025-09-03T02:40:55.606Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "1b2c2d92-278a-4ef4-ae67-7adb6cf52699",
      "text": "Chẳng ai khinh đứa đi ăn trộm chỉ vì đói mà muốn có ăn.",
      "label": "30",
      "number": 30,
      "subVerseIndex": 0,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:55.620Z",
      "updatedAt": "2025-09-03T02:40:55.620Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "3a290283-763f-41d5-8bde-3cd256a42a8c",
      "text": "Tuy nhiên nếu bị bắt,",
      "label": "31",
      "number": 31,
      "subVerseIndex": 0,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:55.635Z",
      "updatedAt": "2025-09-03T02:40:55.635Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "c7a62a25-58b1-4c82-ae37-b659d6415db5",
      "text": "nó phải đền gấp bảy, phải giao mọi của cải trong nhà.",
      "label": "31",
      "number": 31,
      "subVerseIndex": 1,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:55.649Z",
      "updatedAt": "2025-09-03T02:40:55.649Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "253059c1-85b4-44b6-b9d0-7d25c1bc67c4",
      "text": "Đàn ông ngoại tình thì mất hết lý trí,",
      "label": "32",
      "number": 32,
      "subVerseIndex": 0,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:55.663Z",
      "updatedAt": "2025-09-03T02:40:55.663Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "8ca51f38-8997-41ff-a714-f1e608f14be4",
      "text": "người phạm tội ấy tự huỷ hoại đời mình.",
      "label": "32",
      "number": 32,
      "subVerseIndex": 1,
      "paragraphNumber": 61,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:55.691Z",
      "updatedAt": "2025-09-03T02:40:55.691Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "c607e464-b6e5-4ea4-9b11-f453b428bfeb",
      "text": "Nó phải ăn đòn và mang tiếng xấu,",
      "label": "33",
      "number": 33,
      "subVerseIndex": 0,
      "paragraphNumber": 62,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:55.705Z",
      "updatedAt": "2025-09-03T02:40:55.705Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "a685e300-f858-4f4a-915a-15440135aaf1",
      "text": "nỗi ô nhục của nó, không làm sao gột rửa.",
      "label": "33",
      "number": 33,
      "subVerseIndex": 1,
      "paragraphNumber": 63,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:55.719Z",
      "updatedAt": "2025-09-03T02:40:55.719Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "d0d77776-ae5a-41b1-9257-6bac0900da95",
      "text": "Vì người chồng sẽ nổi cơn ghen,",
      "label": "34",
      "number": 34,
      "subVerseIndex": 0,
      "paragraphNumber": 64,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:55.733Z",
      "updatedAt": "2025-09-03T02:40:55.733Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "2d52f193-01c9-4ff0-9cac-b78e880bb8fc",
      "text": "lúc trả thù, anh ta sẽ không mảy may thương xót.",
      "label": "34",
      "number": 34,
      "subVerseIndex": 1,
      "paragraphNumber": 65,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:55.762Z",
      "updatedAt": "2025-09-03T02:40:55.762Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "f3bcd932-2835-4d18-9291-2a60b4c12106",
      "text": "Mọi đền bù, anh ta sẽ không thèm nhận,",
      "label": "35",
      "number": 35,
      "subVerseIndex": 0,
      "paragraphNumber": 66,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:55.776Z",
      "updatedAt": "2025-09-03T02:40:55.776Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "ab5d3a0f-a13e-4138-b441-d0738c76209e",
      "text": "có đưa bao quà cáp, cũng một mực chối từ.",
      "label": "35",
      "number": 35,
      "subVerseIndex": 1,
      "paragraphNumber": 67,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:55.793Z",
      "updatedAt": "2025-09-03T02:40:55.793Z",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    }
  ],
  "marks": [
    {
      "id": "2abddf4a-6d86-4c5c-a8ee-3e0c73db0728",
      "content": "Bảo lãnh cho bạn bè hay cho người xa lạ để họ đi vay mượn, là điều khá nguy hiểm. Sách Cn nói nhiều về nguy cơ này (11,15 ; 17,18 ; 20,16 ; 22,26-27). Cần mau mau gỡ mình ra khỏi lời đã hứa. Sau này, sách Hc lại khuyến khích việc bảo lãnh, coi đó như một hành vi bác ái (Hc 29,14-20).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 55,
      "endOffset": 55,
      "createdAt": "2025-09-03T02:40:54.479Z",
      "updatedAt": "2025-09-03T02:40:54.479Z",
      "targetId": "6d134e50-4b1a-4190-981f-cbe1fb30dcf2",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "d96f1017-4628-470f-b9c9-fa771576746d",
      "content": "Cn 11,15; 17,18; 20,16; 22,26-27; Hc 8,13; 29,14-19",
      "kind": "MARK_KIND_REFERENCE",
      "label": "1@",
      "sortOrder": 0,
      "startOffset": 20,
      "endOffset": 20,
      "createdAt": "2025-09-03T02:40:54.491Z",
      "updatedAt": "2025-09-03T02:40:54.491Z",
      "targetId": "6d134e50-4b1a-4190-981f-cbe1fb30dcf2",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "3a36b235-aee5-4ada-86f1-2604bda2507d",
      "content": "ds : *đập vào tay nhau* (x. 2 V 10,15). Cử chỉ này biểu thị sự đồng ý.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 23,
      "endOffset": 23,
      "createdAt": "2025-09-03T02:40:54.513Z",
      "updatedAt": "2025-09-03T02:40:54.513Z",
      "targetId": "f2441ad7-4d65-4f09-84a9-33d960d04243",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "e07802e8-5519-4c49-b58a-7f7f9536a383",
      "content": "Cn 30,25",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 10,
      "endOffset": 10,
      "createdAt": "2025-09-03T02:40:54.679Z",
      "updatedAt": "2025-09-03T02:40:54.679Z",
      "targetId": "b46fcec0-2203-41b7-80df-24d8e3de3a4a",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "e3d31b1f-8230-4dec-83be-44440f15982d",
      "content": "Kiến là giống vật cần cù, kỷ luật và có tính tập thể cao. Còn người biếng nhác chẳng tính gì cho tương lai, nên phải chịu nghèo đói. Cc. 10-11 còn được lặp lại ở 24,33-34.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 56,
      "endOffset": 56,
      "createdAt": "2025-09-03T02:40:54.666Z",
      "updatedAt": "2025-09-03T02:40:54.666Z",
      "targetId": "b46fcec0-2203-41b7-80df-24d8e3de3a4a",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "3a3f28f3-381b-4482-8273-a0423dafe181",
      "content": "Cn 10,26; 12,24; 13,4; 15,19; 18,9; 19,24; 20,4.13; 21,25; 22,13; 23,21; 24,30-34; 26,13-16",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 21,
      "endOffset": 21,
