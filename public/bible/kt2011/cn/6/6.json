    {
      "id": "30177192-5a07-457c-b030-411555f84184",
      "content": "Cn 24,33-34; Gv 4,5xt*",
      "kind": "MARK_KIND_REFERENCE",
      "label": "4@",
      "sortOrder": 3,
      "startOffset": 14,
      "endOffset": 14,
      "createdAt": "2025-09-03T02:40:54.830Z",
      "updatedAt": "2025-09-03T02:40:54.830Z",
      "targetId": "01ac8d44-398e-4f25-863e-ed09c45d9e0a",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "53d86bfa-ccf6-4c87-979e-5ea36795107f",
      "content": "Một mô tả sinh động về kẻ dùng miệng, mắt, chân, ngón tay để thực hiện những âm mưu gian xảo của lòng mình. Sự dối trá làm hỏng tương quan giữa người với người.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 13,
      "endOffset": 13,
      "createdAt": "2025-09-03T02:40:54.901Z",
      "updatedAt": "2025-09-03T02:40:54.901Z",
      "targetId": "29864140-5864-4160-b46e-2c1a4994244a",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "6bf53da1-8bc2-4981-9f88-da98649d6aad"
    },
    {
      "id": "3981d0d2-e5bc-401c-ab2c-99edc502f21c",
      "content": "Đây là một châm ngôn số. Có thể nói đây là bản tóm những thói xấu đã nói ở 6,1-15. Phần lớn các thói xấu này gắn liền với các bộ phận trong thân thể : mắt, lưỡi, tay, tim (lòng), chân.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "5",
      "sortOrder": 4,
      "startOffset": 27,
      "endOffset": 27,
      "createdAt": "2025-09-03T02:40:55.031Z",
      "updatedAt": "2025-09-03T02:40:55.031Z",
      "targetId": "be2e2453-1fa2-4552-8d0a-4f47f1dee39a",
      "targetType": "MARK_TARGET_TYPE_HEADING",
