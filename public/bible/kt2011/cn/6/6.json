  "headings": [
    {
      "id": "608e5a64-7282-4196-93f2-47a23e08bd40",
      "text": "Sự bảo lãnh thiếu khôn ngoan",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T02:40:54.468Z",
      "updatedAt": "2025-09-03T02:40:54.468Z",
