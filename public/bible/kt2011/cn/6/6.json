      "content": "Cn 1,8",
      "kind": "MARK_KIND_REFERENCE",
      "label": "8@",
      "sortOrder": 7,
      "startOffset": 4,
      "endOffset": 4,
      "createdAt": "2025-09-03T02:40:55.201Z",
