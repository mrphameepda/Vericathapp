{
  "chapter": {
    "id": "08fb29d6-731b-46b0-bed8-754c06d1809d",
    "number": 7,
    "createdAt": "2025-09-03T01:07:51.667Z",
    "updatedAt": "2025-09-03T01:07:51.667Z",
    "bookId": "1ea97633-82d8-4f1a-bffc-dfb2da235911"
  },
  "verses": [
    {
      "id": "12b6b73f-fc1e-4a09-9f75-3a6558a012c6",
      "text": "Hỡi con, lời thầy, con hãy giữ,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:00.748Z",
      "updatedAt": "2025-09-03T02:41:00.748Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "0a703d0a-b72a-4e79-ae0f-d8d8096a6157",
      "text": "huấn lệnh của thầy, hãy ấp ủ trong tim.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:00.780Z",
      "updatedAt": "2025-09-03T02:41:00.780Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "fef9cc99-f431-4685-a573-fab8d03606f8",
      "text": "Hãy tuân giữ huấn lệnh của thầy, để cho con được sống,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:00.805Z",
      "updatedAt": "2025-09-03T02:41:00.805Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "b5884634-d7fa-4fe3-b918-441a4811e4cb",
      "text": "hãy giữ lời thầy dạy như con ngươi mắt con.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:00.832Z",
      "updatedAt": "2025-09-03T02:41:00.832Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "8b6ba086-0c56-4ff7-9d85-7e2a7ddf9a5a",
      "text": "Lời giáo huấn của thầy, hãy đeo vào ngón tay,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:00.846Z",
      "updatedAt": "2025-09-03T02:41:00.846Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "2dfd31b8-9556-4889-99aa-087c9bef0b52",
      "text": "ghi khắc trong tâm khảm.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:00.860Z",
      "updatedAt": "2025-09-03T02:41:00.860Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "e5ab4a69-13d1-4e20-8292-07fb60df2146",
      "text": "Hãy gọi khôn ngoan là bà chị,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:00.888Z",
      "updatedAt": "2025-09-03T02:41:00.888Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "413a3c0c-cd71-482b-9345-35e0ffe27c45",
      "text": "xem hiểu biết như thể người thân.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:00.903Z",
      "updatedAt": "2025-09-03T02:41:00.903Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "a6e8cba7-f812-40e9-8562-295d04329bc6",
      "text": "Nhờ thế, con sẽ được bảo vệ",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:00.916Z",
      "updatedAt": "2025-09-03T02:41:00.916Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "df2c2708-ff1a-4d1a-90a4-e0732d878303",
      "text": "khỏi người phụ nữ đã có chồng,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:00.931Z",
      "updatedAt": "2025-09-03T02:41:00.931Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "53fac4b9-6ed2-4920-b062-735a625bb0fd",
      "text": "khỏi người đàn bà trắc nết nói lời đường mật.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:00.945Z",
      "updatedAt": "2025-09-03T02:41:00.945Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "f37b2fdd-f596-43a6-b931-1d7c5d1b318c",
      "text": "Khi thầy ngồi trong nhà, bên cửa sổ, nhìn qua lưới mắt cáo,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:00.972Z",
      "updatedAt": "2025-09-03T02:41:00.972Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "426a3405-cda2-46b7-bbb9-ade969623764",
      "text": "thầy đã trông thấy một chàng giữa đám người ngây thơ ;",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:01.001Z",
      "updatedAt": "2025-09-03T02:41:01.001Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "92b3dbcc-a5a0-403a-bbf8-3c3d931c8afb",
      "text": "trong đám thanh niên, thầy đã nhận ra một anh ngu ngốc.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:01.015Z",
      "updatedAt": "2025-09-03T02:41:01.015Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "f5a69fd9-8160-4d23-ab1e-77c94aca3687",
      "text": "Chàng ta đang đi giữa phố hẹp,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:01.028Z",
      "updatedAt": "2025-09-03T02:41:01.028Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "1b4ac122-8de4-44cf-9e02-eac29e6c48af",
      "text": "gần góc đường có nhà người phụ nữ kia ;",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:01.042Z",
      "updatedAt": "2025-09-03T02:41:01.042Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "deb7299d-b07d-4061-aef0-6f0a7c00bddb",
      "text": "chàng bước trên đường dẫn đến nhà cô ấy,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:01.070Z",
      "updatedAt": "2025-09-03T02:41:01.070Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "86bc6182-f89d-4ace-a506-56d41cbc70f1",
      "text": "khi hoàng hôn, lúc chiều tà, hoặc giữa đêm tăm tối.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:01.084Z",
      "updatedAt": "2025-09-03T02:41:01.084Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "94014ccd-d3e3-4fb5-a319-6bfb5c7020ea",
      "text": "Kìa người phụ nữ ấy ra đón chàng,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:01.098Z",
      "updatedAt": "2025-09-03T02:41:01.098Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "8627b379-3c2c-4c80-a695-60813e1966e1",
      "text": "ăn mặc như gái điếm, lòng ẩn chứa mưu gian.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:01.112Z",
      "updatedAt": "2025-09-03T02:41:01.112Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "c7dcf1c9-f070-4d81-9f0d-6c483f9c0da7",
      "text": "Đó là một con người ồn ào, thích bay nhảy,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:01.125Z",
      "updatedAt": "2025-09-03T02:41:01.125Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "4eeececa-ad02-4578-8b49-38ab84589193",
      "text": "chứ không chịu chôn chân ở nhà.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:01.139Z",
      "updatedAt": "2025-09-03T02:41:01.139Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "58576106-5141-4704-a29c-e0d51518b333",
      "text": "Lúc ở công trường, khi ngoài đường phố,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:01.154Z",
      "updatedAt": "2025-09-03T02:41:01.154Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "0655df7b-ae64-409e-84c3-b34548ded519",
      "text": "góc nào cũng thấy cô ta rình chờ.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:01.168Z",
      "updatedAt": "2025-09-03T02:41:01.168Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "283a3074-04d8-49dd-bc64-9e9f6cf6fad3",
      "text": "Cô ả ôm ghì lấy chàng ta mà hôn,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:01.196Z",
      "updatedAt": "2025-09-03T02:41:01.196Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "6ad59bfb-760a-458d-b74f-673765b7a2f2",
      "text": "giơ bộ mặt trơ trẽn, ả nói :",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:01.210Z",
      "updatedAt": "2025-09-03T02:41:01.210Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "1f545855-f88b-4b41-abee-ecdf0f19d93f",
      "text": "“Em đã khấn dâng hy lễ tạ ơn,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:01.224Z",
      "updatedAt": "2025-09-03T02:41:01.224Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "fcde1bc9-980e-4962-a3d8-79a2a44870f3",
      "text": "hôm nay em chu toàn lời khấn ấy,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:01.238Z",
      "updatedAt": "2025-09-03T02:41:01.238Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "64a8d632-7f1f-467e-b0e1-fd510b7749d4",
      "text": "vì thế em ra đây để đón anh,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:01.267Z",
      "updatedAt": "2025-09-03T02:41:01.267Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "da253a18-e56c-425e-a322-7d97ba845152",
      "text": "em tìm kiếm anh hoài và em đã gặp.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:01.281Z",
      "updatedAt": "2025-09-03T02:41:01.281Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "656201fc-da39-4a77-b5c4-f847a636b390",
      "text": "Giường em, em đã trải nệm êm,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:01.295Z",
      "updatedAt": "2025-09-03T02:41:01.295Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "d55209dd-e35a-41d7-9f12-24f66e133e30",
      "text": "trải hàng thêu nhiều màu và vải Ai-cập.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:01.309Z",
      "updatedAt": "2025-09-03T02:41:01.309Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "7437b169-61bf-4e2f-bd2f-2ca5394836a5",
      "text": "Chỗ em nằm, em rảy dầu thơm",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:01.334Z",
      "updatedAt": "2025-09-03T02:41:01.334Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "5cc7b4cb-2691-46ed-a1a8-63fa6073e87b",
      "text": "chế từ một dược, lô hội và nhục quế.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:01.348Z",
      "updatedAt": "2025-09-03T02:41:01.348Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "f77dcafa-1444-426d-9371-b3a88acca3fc",
      "text": "Hãy đến anh ơi ! Ta hãy say ngất men tình cho đến sáng,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:01.360Z",
      "updatedAt": "2025-09-03T02:41:01.360Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "83ca16d0-c2d6-475b-a189-0d5518f2a9b7",
      "text": "cùng nhau ta tận hưởng khoái lạc của yêu đương.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:01.372Z",
      "updatedAt": "2025-09-03T02:41:01.372Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "1b95632b-37d2-4db8-87b9-b836c6eb9be5",
      "text": "Vì chồng em vắng nhà, anh ấy đã lên đường đi xa,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:01.385Z",
      "updatedAt": "2025-09-03T02:41:01.385Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "b2432792-a6b6-4cab-bc1b-4a4deb300128",
      "text": "mang theo mình túi bạc ;",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:01.398Z",
      "updatedAt": "2025-09-03T02:41:01.398Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "40d51f78-52ee-4e88-86da-71581a4baabb",
      "text": "đến ngày rằm anh ấy mới trở về.”",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:01.412Z",
      "updatedAt": "2025-09-03T02:41:01.412Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "bc9897c5-1a0c-4551-b9dc-9dc179f9b265",
      "text": "Ả hết lời cám dỗ làm chàng ta xiêu lòng,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:01.426Z",
      "updatedAt": "2025-09-03T02:41:01.426Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "a692001d-2a31-41a6-b413-9c52a2cdc693",
      "text": "dùng lời đường mật mà quyến rũ ;",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:01.440Z",
      "updatedAt": "2025-09-03T02:41:01.440Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "e6708071-9b1b-4df9-a661-4f029f790f50",
      "text": "thế là chàng ta đi theo tức khắc,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:01.454Z",
      "updatedAt": "2025-09-03T02:41:01.454Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "9bde5b39-a09d-4f3f-b425-80ec18b13939",
      "text": "như con bò đi vào lò sát sinh,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:01.468Z",
      "updatedAt": "2025-09-03T02:41:01.468Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "9d537013-dcf2-464b-8e29-19b3778aaeeb",
      "text": "như con nai sa vào tròng vào bẫy,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 2,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:01.482Z",
      "updatedAt": "2025-09-03T02:41:01.482Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "701eecf5-68e9-4024-8b41-62f421632b4d",
      "text": "cho đến khi một mũi tên đâm thủng ruột gan ;",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:01.509Z",
      "updatedAt": "2025-09-03T02:41:01.509Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "df5fa4df-9655-44f2-a4a8-46e2e651e976",
      "text": "hoặc như chim vội bay vào lưới,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:01.529Z",
      "updatedAt": "2025-09-03T02:41:01.529Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "e6b4d7e9-e687-47e2-8615-2b932dfecb16",
      "text": "đâu biết mình sẽ mất mạng như chơi.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 2,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:01.557Z",
      "updatedAt": "2025-09-03T02:41:01.557Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "877b07c6-4595-49bd-9ed4-752202ce7478",
      "text": "Vậy giờ đây, các con ơi, hãy lắng nghe thầy,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:01.571Z",
      "updatedAt": "2025-09-03T02:41:01.571Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "d5331927-c7f7-4d73-a25b-cca2e3b334e4",
      "text": "và lưu tâm đến lời thầy nói.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:01.585Z",
      "updatedAt": "2025-09-03T02:41:01.585Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "30fe6cff-b573-4b12-875d-ad32ab81668c",
      "text": "Đừng để lòng con ngả theo nàng,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:01.599Z",
      "updatedAt": "2025-09-03T02:41:01.599Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "f370f35b-ee0c-417d-a9c0-c40d08d9cd1f",
      "text": "chớ lạc vào những lối nàng đi.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:01.613Z",
      "updatedAt": "2025-09-03T02:41:01.613Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "bc8ca876-432f-4d8f-a7e5-05a84327b7f7",
      "text": "Vì cô ta đã làm nhiều người ngã gục,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:01.627Z",
      "updatedAt": "2025-09-03T02:41:01.627Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "990626e9-1764-4240-a66f-8b4147816707",
      "text": "ngay cả những người rắn rỏi nhất",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:01.641Z",
      "updatedAt": "2025-09-03T02:41:01.641Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "07154eb2-8497-4dec-8f2c-ffe48f65f457",
      "text": "cũng đều bị cô ta sát hại.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 2,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:01.658Z",
      "updatedAt": "2025-09-03T02:41:01.658Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "802d7443-b808-46aa-a95f-0686fac20c18",
      "text": "Nhà cô ở là đường dẫn tới âm ty,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:01.672Z",
      "updatedAt": "2025-09-03T02:41:01.672Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "55c35ce3-4dc0-450e-a00e-9dd672c56b14",
      "text": "xuống ngục sâu thăm thẳm của tử thần.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:01.684Z",
      "updatedAt": "2025-09-03T02:41:01.684Z",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    }
  ],
  "marks": [
    {
      "id": "98d00cca-8b1b-4630-9aaf-24f93c55e8bc",
      "content": "Nhập đề (cc. 1-5) của huấn dụ thứ chín (cc. 1-27) cũng có tầm mức như 6,20-24.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 7,
      "endOffset": 7,
      "createdAt": "2025-09-03T02:41:00.759Z",
      "updatedAt": "2025-09-03T02:41:00.759Z",
      "targetId": "12b6b73f-fc1e-4a09-9f75-3a6558a012c6",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "91094b4c-d55b-46eb-a263-ff9b59a5ba6b",
      "content": "Cn 3,1",
      "kind": "MARK_KIND_REFERENCE",
      "label": "1@",
      "sortOrder": 0,
      "startOffset": 9,
      "endOffset": 9,
      "createdAt": "2025-09-03T02:41:00.769Z",
      "updatedAt": "2025-09-03T02:41:00.769Z",
      "targetId": "12b6b73f-fc1e-4a09-9f75-3a6558a012c6",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "743ceee4-6d3a-42dd-827d-a1ac33d8911b",
      "content": "Cn 2,1; 6,20",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:41:00.794Z",
      "updatedAt": "2025-09-03T02:41:00.794Z",
      "targetId": "0a703d0a-b72a-4e79-ae0f-d8d8096a6157",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "80dd0e13-da2d-4cb9-8e2d-4ac18095b7ff",
      "content": "Qua một trình thuật sống động và gợi hình, vị thầy cho thấy cách một phụ nữ cám dỗ chàng thanh niên. Sau những khoái lạc nhất thời, chàng sẽ phải chịu những hậu quả nghiêm trọng (cc. 24-27).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 35,
      "endOffset": 35,
      "createdAt": "2025-09-03T02:41:00.987Z",
      "updatedAt": "2025-09-03T02:41:00.987Z",
      "targetId": "f37b2fdd-f596-43a6-b931-1d7c5d1b318c",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "7387a294-b5f9-4016-b4c8-a86e0a7ca3cf",
      "content": "Cn 4,4",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 49,
      "endOffset": 49,
      "createdAt": "2025-09-03T02:41:00.818Z",
      "updatedAt": "2025-09-03T02:41:00.818Z",
      "targetId": "fef9cc99-f431-4685-a573-fab8d03606f8",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "858d5c6f-97ec-4a45-b53a-092c0b5d77de",
      "content": "Đây không phải là một gái điếm chuyên nghiệp. Chị ta đã có chồng, có nhà (c.19). Nhưng cách ăn mặc, nói năng và cử chỉ thì giống với gái điếm (cc. 10-13).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 37,
      "endOffset": 37,
      "createdAt": "2025-09-03T02:41:01.056Z",
      "updatedAt": "2025-09-03T02:41:01.056Z",
      "targetId": "1b4ac122-8de4-44cf-9e02-eac29e6c48af",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "435586c5-a819-40b9-a5ff-60c9e6983c07",
      "content": "Cn 3,3",
      "kind": "MARK_KIND_REFERENCE",
      "label": "4@",
      "sortOrder": 3,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:41:00.874Z",
      "updatedAt": "2025-09-03T02:41:00.874Z",
      "targetId": "2dfd31b8-9556-4889-99aa-087c9bef0b52",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "011d0423-f9cc-4c02-9148-34c8ec752d05",
      "content": "Khi dâng một hy lễ tạ ơn để làm tròn một lời đã khấn nguyện, người dâng lễ và cả gia đình được chia một phần thịt để ăn (Lv 7,12-16). Anh thanh niên ngây thơ được mời vào dự bữa tiệc có tính tôn giáo này, do người phụ nữ ngoại tình khoản đãi.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 31,
      "endOffset": 31,
      "createdAt": "2025-09-03T02:41:01.252Z",
      "updatedAt": "2025-09-03T02:41:01.252Z",
      "targetId": "fcde1bc9-980e-4962-a3d8-79a2a44870f3",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "08fb29d6-731b-46b0-bed8-754c06d1809d"
    },
    {
      "id": "18c4d636-0c53-41b6-83fe-29d62e4b08fb",
      "content": "Cn 2,16",
      "kind": "MARK_KIND_REFERENCE",
      "label": "5@",
      "sortOrder": 4,
      "startOffset": 35,
      "endOffset": 35,
      "createdAt": "2025-09-03T02:41:00.959Z",
