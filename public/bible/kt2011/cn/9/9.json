      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "7d83a12b-c777-4234-9093-5a5a62b382c8"
    },
    {
      "id": "e6cd81aa-d912-4c8d-b9ea-80456f802da6",
      "content": "Cn 14,1; 24,3",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 18,
      "endOffset": 18,
      "createdAt": "2025-09-03T02:41:13.429Z",
      "updatedAt": "2025-09-03T02:41:13.429Z",
      "targetId": "7d1b8ddf-27e2-4847-a80b-0299f6e89e66",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7d83a12b-c777-4234-9093-5a5a62b382c8"
    },
    {
      "id": "3e6ffed2-6a31-440b-8192-89adb32144b6",
      "content": "Đức Khôn Ngoan xây nhà có *bảy cột*, nghĩa là một ngôi nhà lớn như một cung điện nhà vua.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 20,
      "endOffset": 20,
      "createdAt": "2025-09-03T02:41:13.454Z",
      "updatedAt": "2025-09-03T02:41:13.454Z",
      "targetId": "bb42f440-c88b-4b9f-95b9-4b403e03b5b5",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7d83a12b-c777-4234-9093-5a5a62b382c8"
    },
    {
      "id": "c60c8cae-20b0-4e74-bdcb-acdad2364fae",
      "content": "Đức Khôn Ngoan dọn tiệc hẳn để mừng tân gia. Bữa tiệc này không chỉ dành cho người quen biết, mà cho tất cả những ai đang cần.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 36,
      "endOffset": 36,
      "createdAt": "2025-09-03T02:41:13.483Z",
      "updatedAt": "2025-09-03T02:41:13.483Z",
      "targetId": "6ddf29a7-6162-40cf-8ce2-8995494e26e7",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7d83a12b-c777-4234-9093-5a5a62b382c8"
    },
    {
      "id": "640424ba-aa96-4205-8ce0-909434c64261",
      "content": "Is 55,1-3; Ga 6,35",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 1,
      "endOffset": 1,
      "createdAt": "2025-09-03T02:41:13.596Z",
      "updatedAt": "2025-09-03T02:41:13.596Z",
      "targetId": "6ad862c4-c599-40f0-a543-67cbca74b1eb",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7d83a12b-c777-4234-9093-5a5a62b382c8"
    },
    {
      "id": "7a8b5908-58be-4bc1-b223-c6aab8727355",
      "content": "Thức ăn Đức Khôn Ngoan mời các thực khách chính là những lời giáo huấn. Giáo huấn này đem lại sự sống và sự hiểu biết (x. Is 55,1-3 ; Am 8,11).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 53,
      "endOffset": 53,
      "createdAt": "2025-09-03T02:41:13.583Z",
      "updatedAt": "2025-09-03T02:41:13.583Z",
      "targetId": "6ad862c4-c599-40f0-a543-67cbca74b1eb",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7d83a12b-c777-4234-9093-5a5a62b382c8"
    },
    {
      "id": "58c3677b-1260-4cf6-abdb-bccd30d2aaee",
      "content": "Cn 9,12; 19,25; 21,11.24",
      "kind": "MARK_KIND_REFERENCE",
      "label": "4@",
      "sortOrder": 3,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:41:13.680Z",
      "updatedAt": "2025-09-03T02:41:13.680Z",
      "targetId": "1f905cc1-b05f-44af-b0fc-fc11d9e2b420",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7d83a12b-c777-4234-9093-5a5a62b382c8"
    },
    {
      "id": "36d01290-c755-45cd-be39-ef6cc2ddb380",
      "content": "Phần này gồm ba châm ngôn nói lên sự tương phản giữa lối sống của kẻ gian ác và người khôn ngoan (cc. 7.8.9). Cc. 10-12 là những lời cuối của Đức Khôn Ngoan, trong đó ta gặp lại chủ đề đã được loan báo ở 1,7 : *kính sợ Đức Chúa* là bước đầu của khôn ngoan. Toàn bộ các ch. 1-9 được tóm lại trong chủ đề này.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "5",
      "sortOrder": 4,
      "startOffset": 25,
      "endOffset": 25,
      "createdAt": "2025-09-03T02:41:13.666Z",
      "updatedAt": "2025-09-03T02:41:13.666Z",
      "targetId": "2cfd5804-a8fc-4469-9bd4-d39350ef54e8",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "7d83a12b-c777-4234-9093-5a5a62b382c8"
    },
    {
