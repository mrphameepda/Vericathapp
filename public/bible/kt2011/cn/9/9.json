{
  "chapter": {
    "id": "7d83a12b-c777-4234-9093-5a5a62b382c8",
    "number": 9,
    "createdAt": "2025-09-03T01:07:51.667Z",
    "updatedAt": "2025-09-03T01:07:51.667Z",
    "bookId": "1ea97633-82d8-4f1a-bffc-dfb2da235911"
  },
  "verses": [
    {
      "id": "7d1b8ddf-27e2-4847-a80b-0299f6e89e66",
      "text": "Đức Khôn Ngoan đã xây cất nhà mình,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:13.378Z",
      "updatedAt": "2025-09-03T02:41:13.378Z",
      "chapterId": "7d83a12b-c777-4234-9093-5a5a62b382c8"
    },
    {
      "id": "bb42f440-c88b-4b9f-95b9-4b403e03b5b5",
      "text": "dựng lên bảy cây cột,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:13.441Z",
      "updatedAt": "2025-09-03T02:41:13.441Z",
      "chapterId": "7d83a12b-c777-4234-9093-5a5a62b382c8"
    },
    {
      "id": "6ddf29a7-6162-40cf-8ce2-8995494e26e7",
      "text": "hạ thú vật, pha chế rượu, dọn bàn ăn",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:13.468Z",
      "updatedAt": "2025-09-03T02:41:13.468Z",
      "chapterId": "7d83a12b-c777-4234-9093-5a5a62b382c8"
    },
    {
      "id": "6729a5c6-f21e-4947-aba9-560ea9e8c06f",
      "text": "và sai các nữ tỳ ra đi.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:13.496Z",
      "updatedAt": "2025-09-03T02:41:13.496Z",
      "chapterId": "7d83a12b-c777-4234-9093-5a5a62b382c8"
    },
    {
      "id": "61836c95-5efc-448d-aeed-1beb311fbc97",
      "text": "Đức Khôn Ngoan còn lên các nơi cao trong thành phố",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:13.511Z",
      "updatedAt": "2025-09-03T02:41:13.511Z",
      "chapterId": "7d83a12b-c777-4234-9093-5a5a62b382c8"
    },
    {
      "id": "52c0e9ee-2ab7-4331-bb09-f5e4c2e26f16",
      "text": "và kêu gọi :",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:13.525Z",
      "updatedAt": "2025-09-03T02:41:13.525Z",
      "chapterId": "7d83a12b-c777-4234-9093-5a5a62b382c8"
    },
    {
      "id": "20fd92b2-f749-4b6c-bf19-2e09087ade34",
      "text": "“Hỡi người ngây thơ, hãy lại đây !”",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:13.540Z",
      "updatedAt": "2025-09-03T02:41:13.540Z",
      "chapterId": "7d83a12b-c777-4234-9093-5a5a62b382c8"
    },
    {
      "id": "bf7520cc-7d73-43d1-884a-9da8a1f4e3d4",
      "text": "Với người ngu si, Đức Khôn Ngoan bảo :",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:13.554Z",
      "updatedAt": "2025-09-03T02:41:13.554Z",
      "chapterId": "7d83a12b-c777-4234-9093-5a5a62b382c8"
    },
    {
      "id": "6ad862c4-c599-40f0-a543-67cbca74b1eb",
      "text": "“Hãy đến mà ăn bánh của ta và uống rượu do ta pha chế !",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:13.568Z",
      "updatedAt": "2025-09-03T02:41:13.568Z",
      "chapterId": "7d83a12b-c777-4234-9093-5a5a62b382c8"
    },
    {
      "id": "c1ce61fd-5380-4dc9-9543-118187293799",
      "text": "Đừng ngây thơ khờ dại nữa, và các con sẽ được sống ;",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:13.610Z",
      "updatedAt": "2025-09-03T02:41:13.610Z",
      "chapterId": "7d83a12b-c777-4234-9093-5a5a62b382c8"
    },
    {
      "id": "5849048d-84cc-41ee-b034-02f6d12451ce",
      "text": "hãy bước đi trên con đường hiểu biết.”",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:13.624Z",
      "updatedAt": "2025-09-03T02:41:13.624Z",
      "chapterId": "7d83a12b-c777-4234-9093-5a5a62b382c8"
    },
    {
      "id": "1f905cc1-b05f-44af-b0fc-fc11d9e2b420",
      "text": "Ai sửa dạy đứa ngoan cố là chuốc lấy khinh dể vào thân.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:13.639Z",
      "updatedAt": "2025-09-03T02:41:13.639Z",
      "chapterId": "7d83a12b-c777-4234-9093-5a5a62b382c8"
    },
    {
      "id": "559a892a-0893-4ad7-8d31-c97b3fb196a1",
      "text": "Ai khiển trách tên gian ác sẽ bị nó chửi rủa.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:13.694Z",
      "updatedAt": "2025-09-03T02:41:13.694Z",
      "chapterId": "7d83a12b-c777-4234-9093-5a5a62b382c8"
    },
    {
      "id": "b5490885-f785-4ffc-bd11-ef23883fa7e3",
      "text": "Đừng khiển trách đứa ngoan cố kẻo nó thù ghét con.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:13.709Z",
      "updatedAt": "2025-09-03T02:41:13.709Z",
      "chapterId": "7d83a12b-c777-4234-9093-5a5a62b382c8"
    },
    {
      "id": "f54ceafa-5847-4b77-bf2a-6af45b7b70e4",
      "text": "Hãy khiển trách người khôn ngoan, con sẽ được họ thương mến.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:13.723Z",
      "updatedAt": "2025-09-03T02:41:13.723Z",
      "chapterId": "7d83a12b-c777-4234-9093-5a5a62b382c8"
    },
    {
      "id": "b388864a-5b09-4d88-838c-5e81a2d1aa3f",
      "text": "Hãy giáo huấn người khôn, họ sẽ khôn hơn nữa.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:13.737Z",
      "updatedAt": "2025-09-03T02:41:13.737Z",
      "chapterId": "7d83a12b-c777-4234-9093-5a5a62b382c8"
    },
    {
      "id": "afc95dc5-5ca8-400c-b68c-8ce51ba9969b",
      "text": "Hãy dạy bảo người công chính, họ sẽ hiểu biết thêm.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:13.751Z",
      "updatedAt": "2025-09-03T02:41:13.751Z",
      "chapterId": "7d83a12b-c777-4234-9093-5a5a62b382c8"
    },
    {
      "id": "7311319d-601d-4d63-a353-6e2abf9ec893",
      "text": "Kính sợ ĐỨC CHÚA là bước đầu của khôn ngoan ;",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:13.765Z",
      "updatedAt": "2025-09-03T02:41:13.765Z",
      "chapterId": "7d83a12b-c777-4234-9093-5a5a62b382c8"
    },
    {
      "id": "e5c0dacf-4f5f-445b-8c15-1aa11be2c042",
      "text": "biết Đấng Chí Thánh mới là hiểu biết thật.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:13.810Z",
      "updatedAt": "2025-09-03T02:41:13.810Z",
      "chapterId": "7d83a12b-c777-4234-9093-5a5a62b382c8"
    },
    {
      "id": "fed4f534-701a-4a42-b2c6-1c758b26353e",
      "text": "Vì nhờ ta, con sẽ được sống lâu, và tăng thêm tuổi thọ.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:13.824Z",
      "updatedAt": "2025-09-03T02:41:13.824Z",
      "chapterId": "7d83a12b-c777-4234-9093-5a5a62b382c8"
    },
    {
      "id": "704ab146-85b6-430a-8e80-1b55637232ed",
      "text": "Nếu con khôn thì chính con được hưởng,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:13.852Z",
      "updatedAt": "2025-09-03T02:41:13.852Z",
      "chapterId": "7d83a12b-c777-4234-9093-5a5a62b382c8"
    },
    {
      "id": "c62c84c2-5da0-46c1-bcc0-ce1de1ad5ed9",
      "text": "còn con ngoan cố thì gánh chịu một mình.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:13.866Z",
      "updatedAt": "2025-09-03T02:41:13.866Z",
      "chapterId": "7d83a12b-c777-4234-9093-5a5a62b382c8"
    },
    {
      "id": "c7618592-38ae-4d95-aabf-ff1c56adde75",
      "text": "Mụ Khờ Dại là một mụ đàn bà ầm ĩ,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:13.879Z",
      "updatedAt": "2025-09-03T02:41:13.879Z",
      "chapterId": "7d83a12b-c777-4234-9093-5a5a62b382c8"
    },
    {
      "id": "b8ac3ad4-ffd0-447d-a2fb-45104ff2f612",
      "text": "đần độn, chẳng hiểu biết chi.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:13.907Z",
      "updatedAt": "2025-09-03T02:41:13.907Z",
      "chapterId": "7d83a12b-c777-4234-9093-5a5a62b382c8"
    },
    {
      "id": "4dcc2951-afda-45a2-98e1-710f32457408",
      "text": "Mụ ngồi bên cửa nhà,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:13.921Z",
      "updatedAt": "2025-09-03T02:41:13.921Z",
      "chapterId": "7d83a12b-c777-4234-9093-5a5a62b382c8"
    },
    {
      "id": "3e27745e-9826-4de9-be71-b89b143ac29b",
      "text": "trên ngai, hay tại những nơi cao trong thành phố,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:13.949Z",
      "updatedAt": "2025-09-03T02:41:13.949Z",
      "chapterId": "7d83a12b-c777-4234-9093-5a5a62b382c8"
    },
    {
      "id": "d71c9665-8f76-40d2-b263-c3333dcb017c",
      "text": "để mời mọc kẻ qua người lại, mời những ai đi đường :",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:13.963Z",
      "updatedAt": "2025-09-03T02:41:13.963Z",
      "chapterId": "7d83a12b-c777-4234-9093-5a5a62b382c8"
    },
    {
      "id": "1653f1ec-07d7-4c1a-bc6e-054f44803a29",
      "text": "“Hỡi người ngây thơ, hãy lại đây !”",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:13.990Z",
      "updatedAt": "2025-09-03T02:41:13.990Z",
      "chapterId": "7d83a12b-c777-4234-9093-5a5a62b382c8"
    },
    {
      "id": "faedf48f-81a4-43c7-86f9-a70d793bcf1b",
      "text": "Với người ngu si, mụ bảo :",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:14.004Z",
      "updatedAt": "2025-09-03T02:41:14.004Z",
      "chapterId": "7d83a12b-c777-4234-9093-5a5a62b382c8"
    },
    {
      "id": "496e442c-ad65-4779-b438-8af98cfe576c",
      "text": "“Nước uống lén mới ngọt, bánh ăn vụng mới ngon.”",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:14.018Z",
      "updatedAt": "2025-09-03T02:41:14.018Z",
      "chapterId": "7d83a12b-c777-4234-9093-5a5a62b382c8"
    },
    {
      "id": "e07bbfa0-bd55-4999-9bf5-6048717eda09",
      "text": "Nhưng nào ai biết được bóng âm hồn lảng vảng nơi đây,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:14.061Z",
      "updatedAt": "2025-09-03T02:41:14.061Z",
      "chapterId": "7d83a12b-c777-4234-9093-5a5a62b382c8"
    },
    {
      "id": "591f73ee-a04d-4aae-b878-49c5f632c000",
      "text": "và thực khách mụ mời lại phải ở trong chốn âm ty sâu thẳm.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:41:14.088Z",
      "updatedAt": "2025-09-03T02:41:14.088Z",
      "chapterId": "7d83a12b-c777-4234-9093-5a5a62b382c8"
    }
  ],
  "marks": [
    {
      "id": "d0c397c1-d1a9-45e7-a9dd-aaaf862f8e78",
      "content": "Ch. 9 chủ yếu mô tả hai bữa tiệc do Đức Khôn Ngoan và Mụ Khờ Dại khoản đãi. Cả hai đều từ các nơi cao trong thành mà kêu gọi những kẻ ngây thơ, khờ dại đến dự. Kết quả của hai bữa tiệc thật khác nhau, một đưa đến sự sống, một dẫn đến cái chết.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 32,
      "endOffset": 32,
      "createdAt": "2025-09-03T02:41:13.407Z",
      "updatedAt": "2025-09-03T02:41:13.407Z",
      "targetId": "f6342cf2-1599-4ea2-956f-b26246803144",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "7d83a12b-c777-4234-9093-5a5a62b382c8"
    },
    {
      "id": "64b59198-b4f6-4bc2-9551-5591ca92406b",
      "content": "Mt 22,1-14",
      "kind": "MARK_KIND_REFERENCE",
      "label": "1@",
      "sortOrder": 0,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:41:13.418Z",
      "updatedAt": "2025-09-03T02:41:13.418Z",
