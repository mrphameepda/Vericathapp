    {
      "id": "fb0b386a-5080-4169-98b4-2ae5773877ca",
      "content": "English: Paul | French: Paul | Latin: Paulus | Origin: &#928;&#945;&#965;&#955;&#959;&#962; | Vietnamese: Phao-lô -- Cv 13,9",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 41,
      "endOffset": 41,
