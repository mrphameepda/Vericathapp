    {
      "id": "35fdde81-503a-4504-ad54-c076efd1c65e",
      "text": "Tổng trấn Phê-lích xử vụ kiện ông Phao-lô",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:46:14.881Z",
