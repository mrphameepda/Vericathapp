    {
      "id": "6fba5156-2d25-414d-95a2-d57edbc40448",
      "content": "English: Hadad-Rimmon | French: Hadad-Rimmôn | Latin: Adadremmon | Origin: &#1492;&#1458;&#1491;&#1463;&#1491;&#1470;&#1512;&#1460;&#1502;&#1468;&#64331;&#1503; | Vietnamese: Ha-đát Rim-môn -- Dcr 12,11",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "43",
      "sortOrder": 42,
      "startOffset": 99,
      "endOffset": 99,
      "createdAt": "2025-09-03T03:29:17.262Z",
      "updatedAt": "2025-09-03T03:29:17.262Z",
      "targetId": "ae6855af-2afb-4421-a376-305366ec043c",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "8c2d51ba-1a71-4972-8209-4fb7776368a2"
    },
    {
      "id": "2572980d-9361-4ab4-a9ab-9be97e8c192d",
      "content": "*Ha-đát* là thần sấm, thần mưa nổi tiếng của người Phê-ni-xi. *Ha-đát Rim-môn* còn là thần của rau quả phải chết vào cuối vụ mùa thu hoạch, vì thần này gắn liền với sự sinh ra, sống, chết, sống lại và mỗi giai đoạn số phận của rau quả xảy ra vào mỗi dịp lễ. Hằng năm người ta cử hành tang lễ tại đồng bằng phì nhiêu Gít-ra-en.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "44",
      "sortOrder": 43,
      "startOffset": 99,
      "endOffset": 99,
      "createdAt": "2025-09-03T03:29:17.272Z",
      "updatedAt": "2025-09-03T03:29:17.272Z",
      "targetId": "ae6855af-2afb-4421-a376-305366ec043c",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "8c2d51ba-1a71-4972-8209-4fb7776368a2"
    },
    {
      "id": "bf42a000-c582-44d0-81e5-197adaa3b26c",
      "content": "English: Megiddo | French: Meguiddo | Latin: Mageddo | Origin: &#1502;&#1456;&#1490;&#1460;&#1491;&#1468;&#64331; | Vietnamese: Mơ-ghít-đô -- Gs 12,21 ; Tl 5,19 ; Dcr 12,11",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "45",
      "sortOrder": 44,
      "startOffset": 122,
      "endOffset": 122,
      "createdAt": "2025-09-03T03:29:17.289Z",
      "updatedAt": "2025-09-03T03:29:17.289Z",
      "targetId": "ae6855af-2afb-4421-a376-305366ec043c",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "8c2d51ba-1a71-4972-8209-4fb7776368a2"
    },
    {
      "id": "643c421e-d1b8-4ab2-9200-45d402f801d4",
      "content": "Mỗi giai cấp xã hội ở Giê-ru-sa-lem khóc thương riêng : nhà Đa-vít tức các chức sự dân chính, nhà Na-than tức các ngôn sứ, nhà Lê-vi tức các Lê-vi, nhà Sim-y tức các tư tế. Như vậy có sự hoà hợp giữa các thủ lãnh chính trị và tôn giáo.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "46",
      "sortOrder": 45,
      "startOffset": 38,
      "endOffset": 38,
      "createdAt": "2025-09-03T03:29:17.311Z",
      "updatedAt": "2025-09-03T03:29:17.311Z",
      "targetId": "251cadca-3c97-4d4f-a7c8-e88cf4e7c57f",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "8c2d51ba-1a71-4972-8209-4fb7776368a2"
    },
