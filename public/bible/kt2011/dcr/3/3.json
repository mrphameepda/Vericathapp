    },
    {
      "id": "9cef441a-0346-4b37-927b-2c0df67bd3ad",
      "content": "English: Yahweh | French: SEIGNEUR | Latin: Dominus | Origin: &#1497;&#1456;&#1492;&#64331;&#1464;&#1492; | Vietnamese: ĐỨC CHÚA -- Danh của Thiên Chúa Ít-ra-en, St 2,4...",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "26",
      "sortOrder": 25,
      "startOffset": 9,
      "endOffset": 9,
      "createdAt": "2025-09-03T03:28:10.915Z",
      "updatedAt": "2025-09-03T03:28:10.915Z",
      "targetId": "d3eff860-470d-468e-aeca-b9db11acd68b",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9122b83d-943b-4de8-a0d4-dbd500ca823f"
    },
    {
      "id": "4753b0bf-d18e-4a17-b6a3-b5e1e16cf2da",
      "content": "Ngoài Lề Luật dành cho toàn thể con cái Ít-ra-en, vị thượng tế còn tuân giữ luật riêng dành cho chức vụ của mình (x. St 26,5 ; Gs 22,3 ; Lv 8,35 ; 18,30 ; Đnl 14,1 ; 1 V 2,3 ; Ml 3,14).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "27",
      "sortOrder": 26,
      "startOffset": 106,
      "endOffset": 106,
      "createdAt": "2025-09-03T03:28:10.925Z",
      "updatedAt": "2025-09-03T03:28:10.925Z",
      "targetId": "d3eff860-470d-468e-aeca-b9db11acd68b",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9122b83d-943b-4de8-a0d4-dbd500ca823f"
    },
    {
      "id": "75c76455-0638-49ac-8351-ca76b9c17dc5",
      "content": "Không ai được vào Nơi Cực Thánh, chỉ một mình vị thượng tế mới được vào.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "28",
      "sortOrder": 27,
      "startOffset": 186,
      "endOffset": 186,
      "createdAt": "2025-09-03T03:28:10.935Z",
      "updatedAt": "2025-09-03T03:28:10.935Z",
      "targetId": "d3eff860-470d-468e-aeca-b9db11acd68b",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9122b83d-943b-4de8-a0d4-dbd500ca823f"
    },
    {
      "id": "82eef82f-ef1f-4326-80ad-9334fe6d3829",
      "content": "C.8 xen vào giữa c.9a và c.9b.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "29",
      "sortOrder": 28,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T03:28:10.976Z",
      "updatedAt": "2025-09-03T03:28:10.976Z",
      "targetId": "21a52f58-7f7b-42ef-b2a2-04d52f3794f4",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9122b83d-943b-4de8-a0d4-dbd500ca823f"
    },
    {
      "id": "2409cea9-8e5e-48e6-86e9-73615c23fd15",
      "content": "Phiến đá này ám chỉ Đền Thờ, được trao cho thượng tế canh giữ và chăm sóc. Bảy con mắt tượng trưng cho sự hiện diện của Thiên Chúa luôn săn sóc dân Người.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "30",
      "sortOrder": 29,
      "startOffset": 19,
      "endOffset": 19,
      "createdAt": "2025-09-03T03:28:10.987Z",
      "updatedAt": "2025-09-03T03:28:10.987Z",
      "targetId": "21a52f58-7f7b-42ef-b2a2-04d52f3794f4",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9122b83d-943b-4de8-a0d4-dbd500ca823f"
    },
