      "targetId": "8ece4cdd-1359-4111-8f1f-41ad51001297",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9122b83d-943b-4de8-a0d4-dbd500ca823f"
    },
