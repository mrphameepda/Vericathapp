    {
      "id": "6a1bc92d-f033-4f8f-8826-70cb36d5850b",
      "content": "Có nghĩa là thoát khỏi cuộc tàn phá ở Giê-ru-sa-lem và sống sót sau cuộc lưu đày.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "18",
      "sortOrder": 17,
      "startOffset": 298,
      "endOffset": 298,
      "createdAt": "2025-09-03T03:28:10.678Z",
