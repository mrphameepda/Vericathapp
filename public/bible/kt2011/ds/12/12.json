    {
      "id": "af029040-52b5-449f-8c45-9fc0269a714d",
      "content": "Có lẽ, như ở Xh 33,20-23, ám chỉ nhìn một người từ phía sau lưng. Nhìn thấy Thiên Chúa thì phải chết.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "26",
      "sortOrder": 25,
      "startOffset": 12,
      "endOffset": 12,
      "createdAt": "2025-09-03T01:23:51.493Z",
      "updatedAt": "2025-09-03T01:23:51.493Z",
      "targetId": "071593bf-17b3-4563-8842-f6e24cd4c710",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "59a56c30-3fb5-4998-a554-7ef52735e5cd"
    },
