    {
      "id": "10992458-d945-4bcb-bbed-e91a8eda3275",
      "content": "Đức Chúa không cho ngôn sứ của Người trả lời những người Ít-ra-en bắt cá hai tay đến thỉnh vấn. Chính Đức Chúa sẽ trả lời họ bằng hình phạt.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "15",
      "sortOrder": 14,
      "startOffset": 267,
      "endOffset": 267,
      "createdAt": "2025-09-03T03:14:12.051Z",
      "updatedAt": "2025-09-03T03:14:12.051Z",
      "targetId": "aef0465e-ab60-4cdc-8dd7-b94cb4ba577d",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "18c2fbdc-6fd6-4d9a-b2f6-7d586019cbb8"
    },
    {
      "id": "e5f1e018-3e0f-4baa-bb98-0a7aec2ba96b",
      "content": "English: Yahweh | French: SEIGNEUR | Latin: Dominus | Origin: &#1497;&#1456;&#1492;&#64331;&#1464;&#1492; | Vietnamese: ĐỨC CHÚA -- Danh của Thiên Chúa Ít-ra-en, St 2,4...",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "16",
      "sortOrder": 15,
      "startOffset": 152,
      "endOffset": 152,
      "createdAt": "2025-09-03T03:14:12.074Z",
      "updatedAt": "2025-09-03T03:14:12.074Z",
      "targetId": "dd311a8f-2ba5-477f-80e4-3ae5f3d04265",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "18c2fbdc-6fd6-4d9a-b2f6-7d586019cbb8"
    },
    {
      "id": "ea11ddbe-5102-4d26-8762-de2782f1a114",
      "content": "Còn ngôn sứ nào được người ta nhờ thỉnh vấn, mà lại chiều theo ý thích của họ, thì chính Đức Chúa sẽ để cho ngôn sứ ấy rơi vào tình trạng bị dụ dỗ, bởi vì Người đã nhất định phạt.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "17",
      "sortOrder": 16,
      "startOffset": 11,
      "endOffset": 11,
      "createdAt": "2025-09-03T03:14:12.112Z",
      "updatedAt": "2025-09-03T03:14:12.112Z",
      "targetId": "e7b23101-bd34-4d00-a4df-a2650e417aa3",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "18c2fbdc-6fd6-4d9a-b2f6-7d586019cbb8"
    },
    {
      "id": "97f09d10-a47f-46eb-a1d7-3a6d9afd704d",
      "content": "English: Yahweh | French: SEIGNEUR | Latin: Dominus | Origin: &#1497;&#1456;&#1492;&#64331;&#1464;&#1492; | Vietnamese: ĐỨC CHÚA -- Danh của Thiên Chúa Ít-ra-en, St 2,4...",
