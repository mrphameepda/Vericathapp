{
  "chapter": {
    "id": "19b169d6-8350-4625-9d85-e6910e92613d",
    "number": 19,
    "createdAt": "2025-09-03T01:07:51.769Z",
    "updatedAt": "2025-09-03T01:07:51.769Z",
    "bookId": "cbbbd5bb-2d7d-4ef5-9b0d-6d5626c7c516"
  },
  "verses": [
    {
      "id": "50141dc8-ac7a-432a-b57f-58416d346ae6",
      "text": "Phần ngươi, hãy cất lên khúc ai ca khóc thương các ông hoàng Ít-ra-en.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T03:14:48.070Z",
      "updatedAt": "2025-09-03T03:14:48.070Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "8635fa93-f732-4bf5-b7d6-82de10e3230a",
      "text": "Ngươi sẽ nói :",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 1,
      "isPoetry": false,
      "createdAt": "2025-09-03T03:14:48.143Z",
      "updatedAt": "2025-09-03T03:14:48.143Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "65b20698-66d5-45ba-aa32-c462cc57bfb5",
      "text": "Mẹ của ngươi là ai ?",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.156Z",
      "updatedAt": "2025-09-03T03:14:48.156Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "8907e6ad-88c6-4da3-8c2d-a3127f4c913d",
      "text": "Nó như sư tử cái",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.175Z",
      "updatedAt": "2025-09-03T03:14:48.175Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "db019514-b244-44f6-befb-16e45e10880a",
      "text": "cạnh bầy sư tử đực,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 3,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.198Z",
      "updatedAt": "2025-09-03T03:14:48.198Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "53026ab4-ae20-4b1d-a9f8-c7bca378eb3e",
      "text": "giữa đám sư tử con",
      "label": "2",
      "number": 2,
      "subVerseIndex": 4,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.210Z",
      "updatedAt": "2025-09-03T03:14:48.210Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "ba0cf73f-16e8-43ff-9c89-ce82244d448e",
      "text": "nuôi nấng đàn con nhỏ.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 5,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.223Z",
      "updatedAt": "2025-09-03T03:14:48.223Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "e6c53366-3a16-4930-8d7b-393b9a281e86",
      "text": "Trong đàn con ấy,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.234Z",
      "updatedAt": "2025-09-03T03:14:48.234Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "57592306-05d0-44e5-ae71-c02afcf856af",
      "text": "nó huấn luyện một con",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.245Z",
      "updatedAt": "2025-09-03T03:14:48.245Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "54db70ed-9ece-4851-a13e-d9d48718879e",
      "text": "thành một sư tử con,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.255Z",
      "updatedAt": "2025-09-03T03:14:48.255Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "e548fc6c-8b9c-4263-9fca-ba3dbc980a8f",
      "text": "biết xé mồi và ăn thịt thiên hạ.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 3,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.265Z",
      "updatedAt": "2025-09-03T03:14:48.265Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "49205ee9-a577-4202-8230-299363dd5241",
      "text": "Các dân tộc",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.276Z",
      "updatedAt": "2025-09-03T03:14:48.276Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "719f06ba-80dd-43a1-8369-6f0e918a54e3",
      "text": "đã nghe nói về con sư tử đó ;",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.287Z",
      "updatedAt": "2025-09-03T03:14:48.287Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "a0650ca0-7a42-41a5-87d3-e531011d987b",
      "text": "nó sa vào bẫy của chúng",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.298Z",
      "updatedAt": "2025-09-03T03:14:48.298Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "3f17e635-10de-4504-b757-fab055e9d404",
      "text": "và bị bắt.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 3,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.308Z",
      "updatedAt": "2025-09-03T03:14:48.308Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "ebe56f82-d8d1-42b8-97e0-cacf61888768",
      "text": "Người ta lấy móc xích nó lại",
      "label": "4",
      "number": 4,
      "subVerseIndex": 4,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.318Z",
      "updatedAt": "2025-09-03T03:14:48.318Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "f3a8d472-be40-45dc-afc5-e2b4e62c7955",
      "text": "đem đi, đưa về đất Ai-cập.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 5,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.342Z",
      "updatedAt": "2025-09-03T03:14:48.342Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "75c7e30d-2c08-4730-b323-692ead00257d",
      "text": "Thấy hy vọng của mình tiêu tan,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.377Z",
      "updatedAt": "2025-09-03T03:14:48.377Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "f2a0f1d4-18a5-4f58-9bdc-6bab86fda0cf",
      "text": "niềm cậy trông của mình tan vỡ,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.388Z",
      "updatedAt": "2025-09-03T03:14:48.388Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "69adf82f-cc90-4d5a-8e7a-ee45160b5bf3",
      "text": "sư tử mẹ lại huấn luyện",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.401Z",
      "updatedAt": "2025-09-03T03:14:48.401Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "40b7216c-ebe1-4ce3-9dff-1c91ca5eb708",
      "text": "một con nhỏ khác",
      "label": "5",
      "number": 5,
      "subVerseIndex": 3,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.414Z",
      "updatedAt": "2025-09-03T03:14:48.414Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "530c5c5d-d62a-4400-aecd-7fc7ec0c256c",
      "text": "thành một sư tử non.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 4,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.429Z",
      "updatedAt": "2025-09-03T03:14:48.429Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "a858ea19-4ef7-4ee7-b127-525d024da757",
      "text": "Con này đi giữa bầy sư tử đực,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.456Z",
      "updatedAt": "2025-09-03T03:14:48.456Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "6abc5401-6c64-48ed-a0a9-f81f0f569ee8",
      "text": "thành một sư tử non",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.469Z",
      "updatedAt": "2025-09-03T03:14:48.469Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "e42f26e8-c258-48ed-9f1d-f51be5b417eb",
      "text": "biết xé mồi và ăn thịt thiên hạ.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.481Z",
      "updatedAt": "2025-09-03T03:14:48.481Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "0d48afc1-de52-4856-be14-aaca2c22879a",
      "text": "Nó triệt hạ các lâu đài",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.492Z",
      "updatedAt": "2025-09-03T03:14:48.492Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "bcea1f02-d134-4645-ac4e-7b2b30d3afa7",
      "text": "của chư dân",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.515Z",
      "updatedAt": "2025-09-03T03:14:48.515Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "0bc822ae-313e-47bf-8058-4ad4f19b1057",
      "text": "và tàn phá",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.531Z",
      "updatedAt": "2025-09-03T03:14:48.531Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "d91631f0-e038-4fbc-8e26-60e8ccee96de",
      "text": "các thành trì của chúng ;",
      "label": "7",
      "number": 7,
      "subVerseIndex": 3,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.542Z",
      "updatedAt": "2025-09-03T03:14:48.542Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "e0588719-4f7e-41cc-8b30-3d359c296ba1",
      "text": "xứ sở và dân cư kinh hoàng",
      "label": "7",
      "number": 7,
      "subVerseIndex": 4,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.557Z",
      "updatedAt": "2025-09-03T03:14:48.557Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "3fdb33d1-99e2-4a99-a17a-6ce093bad32b",
      "text": "vì tiếng gầm của nó.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 5,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.571Z",
      "updatedAt": "2025-09-03T03:14:48.571Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "64443f4c-12f2-4ec4-9532-1407dd1a353c",
      "text": "Từ khắp các tỉnh ở chung quanh",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.585Z",
      "updatedAt": "2025-09-03T03:14:48.585Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "00e0f9f1-2a39-48b0-aa07-0081767f84e8",
      "text": "các dân tộc nổi lên chống lại nó ;",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.598Z",
      "updatedAt": "2025-09-03T03:14:48.598Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "988c22e3-5e00-4a6e-8bf9-5b612302b6a3",
      "text": "chúng bủa lưới bao vây,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.618Z",
      "updatedAt": "2025-09-03T03:14:48.618Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "2c350965-0505-4867-ab83-5b9a403e890b",
      "text": "nó sa vào bẫy của chúng và bị bắt.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 3,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.632Z",
      "updatedAt": "2025-09-03T03:14:48.632Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "7873af4f-43f1-4204-8099-b68ed05f4ed6",
      "text": "Chúng bắt nó đeo gông,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.642Z",
      "updatedAt": "2025-09-03T03:14:48.642Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "945b8845-296c-4885-b622-c884aaf960b0",
      "text": "lấy móc xiềng nó lại,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.665Z",
      "updatedAt": "2025-09-03T03:14:48.665Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "ecf360c3-946b-4847-8c22-4ea0a5165939",
      "text": "điệu đến vua Ba-by-lon",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.676Z",
      "updatedAt": "2025-09-03T03:14:48.676Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "9e00aab6-7279-416b-b743-15c7b63af65f",
      "text": "và tống giam vào ngục,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 3,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.696Z",
      "updatedAt": "2025-09-03T03:14:48.696Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "2893d5a6-03ee-4dd2-934a-a324544eb489",
      "text": "để tiếng nó,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 4,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.706Z",
      "updatedAt": "2025-09-03T03:14:48.706Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "d4128dff-9781-4597-86c2-009c9e1ecfad",
      "text": "người ta không còn nghe thấy nữa",
      "label": "9",
      "number": 9,
      "subVerseIndex": 5,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.720Z",
      "updatedAt": "2025-09-03T03:14:48.720Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "95a8b3ae-af71-458e-9de0-6e056f6d2a95",
      "text": "trên núi đồi Ít-ra-en.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 6,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.730Z",
      "updatedAt": "2025-09-03T03:14:48.730Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "7f948183-16a6-44c9-9427-06fce1c3b8b6",
      "text": "Mẹ ngươi giống cây nho",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.760Z",
      "updatedAt": "2025-09-03T03:14:48.760Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "04615ed4-9d98-457c-825c-07efa65b7ad3",
      "text": "được trồng bên dòng nước",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.794Z",
      "updatedAt": "2025-09-03T03:14:48.794Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "15ab2950-61c2-42ec-b686-a877b8d99b02",
      "text": "quả trĩu nặng, lá sum sê,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.808Z",
      "updatedAt": "2025-09-03T03:14:48.808Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "843abd42-123d-48cd-a24c-3da38e2dfd01",
      "text": "nhờ mạch nước dồi dào.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 3,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.823Z",
      "updatedAt": "2025-09-03T03:14:48.823Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "40ce8183-dc1f-4bcd-890b-770b116ca6c0",
      "text": "Nó trổ ra những cành vững chắc",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.836Z",
      "updatedAt": "2025-09-03T03:14:48.836Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "607f6ab3-d7de-401f-a160-147d5bc135eb",
      "text": "thành những cây vương trượng ;",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.847Z",
      "updatedAt": "2025-09-03T03:14:48.847Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "c9808a4d-646b-41dc-a810-d6484f45f8ba",
      "text": "thân của nó vươn cao lên",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.857Z",
      "updatedAt": "2025-09-03T03:14:48.857Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "5587493e-cf3b-4634-ac20-f939edcbd607",
      "text": "tới tầng mây thẳm.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 3,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.868Z",
      "updatedAt": "2025-09-03T03:14:48.868Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "4b05be9a-eb04-49d2-8740-27542649e1c2",
      "text": "Người ta nhìn thấy nó",
      "label": "11",
      "number": 11,
      "subVerseIndex": 4,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.879Z",
      "updatedAt": "2025-09-03T03:14:48.879Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "4d92ce08-4671-4c96-9a7f-afe5c2dc8267",
      "text": "vì thân nó cao, cành lá um tùm.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 5,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.890Z",
      "updatedAt": "2025-09-03T03:14:48.890Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "a024d3ca-c96f-4d5d-a07b-4b4f22500913",
      "text": "Nhưng trong cơn thịnh nộ,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.900Z",
      "updatedAt": "2025-09-03T03:14:48.900Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "7d6f59c5-bf7f-487a-a9d9-2c0728b18b69",
      "text": "nó đã bị nhổ lên,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.911Z",
      "updatedAt": "2025-09-03T03:14:48.911Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "09e9060f-32fa-4723-a0ea-8946356e2548",
      "text": "và bị quăng xuống đất ;",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.922Z",
      "updatedAt": "2025-09-03T03:14:48.922Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "f29fcf81-f8e2-4baf-8a86-e240c23ed45a",
      "text": "một cơn gió đông thổi",
      "label": "12",
      "number": 12,
      "subVerseIndex": 3,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.932Z",
      "updatedAt": "2025-09-03T03:14:48.932Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "28c6fa92-f693-4e2c-babb-d0c763ca1f68",
      "text": "làm quả nó héo khô,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 4,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.943Z",
      "updatedAt": "2025-09-03T03:14:48.943Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "29740765-9b45-43c0-8a5b-07c1b40b369c",
      "text": "lìa cây rơi rụng xuống ;",
      "label": "12",
      "number": 12,
      "subVerseIndex": 5,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.954Z",
      "updatedAt": "2025-09-03T03:14:48.954Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "e023879a-018a-4472-9eba-eb673b351b5a",
      "text": "cành chắc đã héo khô",
      "label": "12",
      "number": 12,
      "subVerseIndex": 6,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.964Z",
      "updatedAt": "2025-09-03T03:14:48.964Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "e927e51a-f9a3-459f-bcc9-2bd1704d249c",
      "text": "và bị lửa thiêu rụi.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 7,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.985Z",
      "updatedAt": "2025-09-03T03:14:48.985Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "a6820b3f-d859-4ae5-96aa-657c7937961d",
      "text": "Giờ đây nó bị trồng trong sa mạc cằn cỗi nơi đất khô thiếu nước.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:48.996Z",
      "updatedAt": "2025-09-03T03:14:48.996Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "a78c362e-c119-4de3-9fe7-b9ea686390b0",
      "text": "Tự cành, lửa phát ra",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:49.007Z",
      "updatedAt": "2025-09-03T03:14:49.007Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "0126758c-6e98-4b5c-9a2a-20e6452c830e",
      "text": "thiêu rụi cành và quả.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 61,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:49.018Z",
      "updatedAt": "2025-09-03T03:14:49.018Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "5dbb90bf-894b-4587-ae6a-f6743fbbde0c",
      "text": "Không còn cành vững chắc để dùng làm vương trượng.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 2,
      "paragraphNumber": 62,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:49.041Z",
      "updatedAt": "2025-09-03T03:14:49.041Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "0376279f-fa96-49fd-8ff0-67e48f02a9d8",
      "text": "Đó là lời than vãn",
      "label": "14",
      "number": 14,
      "subVerseIndex": 3,
      "paragraphNumber": 63,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:49.054Z",
      "updatedAt": "2025-09-03T03:14:49.054Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    },
    {
      "id": "f6a5d387-a5c9-48e0-906d-5eab07773201",
      "text": "đã trở thành khúc ai ca.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 4,
      "paragraphNumber": 64,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:14:49.067Z",
      "updatedAt": "2025-09-03T03:14:49.067Z",
      "chapterId": "19b169d6-8350-4625-9d85-e6910e92613d"
    }
  ],
