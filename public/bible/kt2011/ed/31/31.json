{
  "chapter": {
    "id": "ed12924c-4c6d-4985-9cec-c9e25e6523b6",
    "number": 31,
    "createdAt": "2025-09-03T01:07:51.769Z",
    "updatedAt": "2025-09-03T01:07:51.769Z",
    "bookId": "cbbbd5bb-2d7d-4ef5-9b0d-6d5626c7c516"
  },
  "verses": [
    {
      "id": "7f780779-c60a-4146-99a0-2e8b6561a7ff",
      "text": "Ngày mồng một tháng thứ ba, năm thứ mười một, có lời ĐỨC CHÚA phán với tôi rằng :",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T03:16:41.207Z",
      "updatedAt": "2025-09-03T03:16:41.207Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "ba51aea7-4653-41c5-8142-cffdd8caaf57",
      "text": "Hỡi con người, hãy nói với Pha-ra-ô, vua Ai-cập, và với đám dân đông đảo của nó :",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 1,
      "isPoetry": false,
      "createdAt": "2025-09-03T03:16:41.287Z",
      "updatedAt": "2025-09-03T03:16:41.287Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "dbd4128e-b3c3-4986-b7c4-3e84a4ac7dde",
      "text": "Ngươi so sánh sự vĩ đại của ngươi",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:16:41.330Z",
      "updatedAt": "2025-09-03T03:16:41.330Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "b1bf9574-81e3-472f-8791-a7ad2268d8f0",
      "text": "với ai ?",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:16:41.344Z",
      "updatedAt": "2025-09-03T03:16:41.344Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "d57e595c-d723-4143-ac1e-35bea9a0a458",
      "text": "Với cây trắc bá,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:16:41.362Z",
      "updatedAt": "2025-09-03T03:16:41.362Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "e2a26769-2360-4396-b5ce-a6d622c79f81",
      "text": "cây hương nam núi Li-băng,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:16:41.376Z",
      "updatedAt": "2025-09-03T03:16:41.376Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "3060a625-fbb8-42a0-b1d0-25ac7b9b75c4",
      "text": "cành to, lá rườm rà, thân cao lớn",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:16:41.404Z",
      "updatedAt": "2025-09-03T03:16:41.404Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "064a040a-27d3-4e59-85fb-f27dd53ba0bd",
      "text": "ngọn vút lên giữa các tầng mây ?",
      "label": "3",
      "number": 3,
      "subVerseIndex": 3,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:16:41.419Z",
      "updatedAt": "2025-09-03T03:16:41.419Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "793051a4-0d7e-4ba7-b23f-74206fa3f64e",
      "text": "Nước đã nuôi cho nó lớn,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:16:41.433Z",
      "updatedAt": "2025-09-03T03:16:41.433Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "9d81be1a-40c7-4dad-807b-0529a29c6399",
      "text": "vực thẳm làm cho nó cao,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:16:41.460Z",
      "updatedAt": "2025-09-03T03:16:41.460Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "1da81f1d-7a75-4916-872a-289c772ebf34",
      "text": "khi cho những dòng sông mình",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:16:41.474Z",
      "updatedAt": "2025-09-03T03:16:41.474Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "a1b6fe7c-b96e-4aba-877f-ad6f3b474df0",
      "text": "chảy chung quanh",
      "label": "4",
      "number": 4,
      "subVerseIndex": 3,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:16:41.488Z",
      "updatedAt": "2025-09-03T03:16:41.488Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "48334d75-9561-49cb-890b-d1ebbbfb5de5",
      "text": "chỗ nó được trồng ;",
      "label": "4",
      "number": 4,
      "subVerseIndex": 4,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:16:41.502Z",
      "updatedAt": "2025-09-03T03:16:41.502Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "21dd3162-fb7e-41d0-ad73-778f99c50c2d",
      "text": "khi đưa những khe suối len lỏi",
      "label": "4",
      "number": 4,
      "subVerseIndex": 5,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:16:41.516Z",
      "updatedAt": "2025-09-03T03:16:41.516Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "5bec0f2b-1c7f-4f9f-bdf2-7ae5587ec353",
      "text": "vào mọi cây cối trong cánh đồng.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 6,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:16:41.530Z",
      "updatedAt": "2025-09-03T03:16:41.530Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "05a430eb-7898-45d6-a1ec-5a69caf4f4f4",
      "text": "Vì thế, nhờ có nhiều nước",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:16:41.544Z",
      "updatedAt": "2025-09-03T03:16:41.544Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "52750b0d-1972-45ce-b988-982e1c6e3b1f",
      "text": "thân nó cao lớn hơn",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:16:41.558Z",
      "updatedAt": "2025-09-03T03:16:41.558Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "276b4308-bc68-478e-889f-258019e48da0",
      "text": "mọi cây cối trong cánh đồng,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:16:41.571Z",
      "updatedAt": "2025-09-03T03:16:41.571Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "0ac92e39-adbf-4997-9016-b8a4b550a6b7",
      "text": "chồi lộc ra nhiều,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 3,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:16:41.585Z",
      "updatedAt": "2025-09-03T03:16:41.585Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "3013379f-efff-4659-a026-b74b1aa0869d",
      "text": "cành lá vươn rộng.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 4,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:16:41.599Z",
      "updatedAt": "2025-09-03T03:16:41.599Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "163ad952-e79a-4ba1-a1cb-4cb08f3d5239",
      "text": "Trên cành cây,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:16:41.613Z",
      "updatedAt": "2025-09-03T03:16:41.613Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "3fa1fbbf-51ca-478a-bf2f-0aaf77b42a38",
      "text": "mọi giống chim trời đến làm tổ,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:16:41.627Z",
      "updatedAt": "2025-09-03T03:16:41.627Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "0d5d98b0-6ec0-4d82-a905-9aa8ca3fbb5a",
      "text": "dưới bóng lá cành,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:16:41.656Z",
      "updatedAt": "2025-09-03T03:16:41.656Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "01a9a47a-2c06-4ea2-8153-f5db67846c34",
      "text": "mọi dã thú nảy nở sinh sôi,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 3,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:16:41.670Z",
      "updatedAt": "2025-09-03T03:16:41.670Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "438eeb6b-71bc-4194-8155-6619a2a3929b",
      "text": "và dưới bóng nó,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 4,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:16:41.684Z",
      "updatedAt": "2025-09-03T03:16:41.684Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "8393b074-d6b0-47f0-87d7-424ee31cc4e8",
      "text": "vô số dân tộc đến cư ngụ.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 5,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:16:41.698Z",
      "updatedAt": "2025-09-03T03:16:41.698Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "d6b2edfa-ff36-455f-a786-ad8a3e7f6f3b",
      "text": "Đó là một cây xinh đẹp tuyệt vời,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:16:41.712Z",
      "updatedAt": "2025-09-03T03:16:41.712Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "b64cb42d-1d1e-4542-9b19-b5bcf0c23cc2",
      "text": "thân to lớn, cành lá vươn rộng",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:16:41.726Z",
      "updatedAt": "2025-09-03T03:16:41.726Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "5957e4c4-8618-491f-ab5c-43ca993b0ef6",
      "text": "và đâm rễ xuống",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:16:41.740Z",
      "updatedAt": "2025-09-03T03:16:41.740Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "00917388-ee11-48a4-abe2-fab927bfae42",
      "text": "tận nguồn nước dồi dào.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 3,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:16:41.754Z",
      "updatedAt": "2025-09-03T03:16:41.754Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "3bcec29d-2ac9-4bcc-9bfc-6d810d983556",
      "text": "Các cây hương bá trong vườn",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:16:41.768Z",
      "updatedAt": "2025-09-03T03:16:41.768Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "c8a96b59-9277-48ce-8819-734bd6832d46",
      "text": "của Thiên Chúa",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:16:41.795Z",
      "updatedAt": "2025-09-03T03:16:41.795Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "a4fbe880-6bd1-41e3-9902-11bb08ab245e",
      "text": "không sao bằng nó,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:16:41.808Z",
      "updatedAt": "2025-09-03T03:16:41.808Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "4b31fc77-28ac-4aff-b52a-2dae59348acf",
      "text": "so với cành nó, các cây trắc bá",
      "label": "8",
      "number": 8,
      "subVerseIndex": 3,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:16:41.819Z",
      "updatedAt": "2025-09-03T03:16:41.819Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "9ca4d66c-81b6-4060-9ee8-a1aa0f27b4c0",
      "text": "cũng chẳng sánh bằng.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 4,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:16:41.831Z",
      "updatedAt": "2025-09-03T03:16:41.831Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "ac313293-3c55-4542-83d2-ae56530b9a8b",
      "text": "Các cây tiêu huyền",
      "label": "8",
      "number": 8,
      "subVerseIndex": 5,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:16:41.842Z",
      "updatedAt": "2025-09-03T03:16:41.842Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "c5195c72-631f-4534-b1f5-e73b6bd6e3a7",
      "text": "không có lá cành giống như nó.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 6,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:16:41.855Z",
      "updatedAt": "2025-09-03T03:16:41.855Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "e61dc5e1-8c7a-42b9-9487-3dccea689699",
      "text": "Trong vườn của Thiên Chúa,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 7,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:16:41.869Z",
      "updatedAt": "2025-09-03T03:16:41.869Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "645121f5-ecb9-479c-883f-6470f9947ff6",
      "text": "chẳng thứ cây nào",
      "label": "8",
      "number": 8,
      "subVerseIndex": 8,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:16:41.882Z",
      "updatedAt": "2025-09-03T03:16:41.882Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "1ab3426f-3705-45ea-8647-8ab6b1d223d9",
      "text": "sánh được với vẻ đẹp của nó.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 9,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:16:41.896Z",
      "updatedAt": "2025-09-03T03:16:41.896Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "a539e4f5-75b8-4fb8-819b-95e7b366d4d0",
      "text": "Ta đã làm cho nó nên xinh đẹp,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:16:41.910Z",
      "updatedAt": "2025-09-03T03:16:41.910Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "bb66bbad-4aca-430d-b73d-fda31a85a0b6",
      "text": "cành lá um tùm,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:16:41.925Z",
      "updatedAt": "2025-09-03T03:16:41.925Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "9cd418df-668b-4813-b5c1-007450b61c8d",
      "text": "đến nỗi mọi thứ cây ở Ê-đen,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:16:41.942Z",
      "updatedAt": "2025-09-03T03:16:41.942Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "3e2111e2-540c-4572-b09b-5f37dbb07d83",
      "text": "tức là trong vườn của Thiên Chúa",
      "label": "9",
      "number": 9,
      "subVerseIndex": 3,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:16:41.984Z",
      "updatedAt": "2025-09-03T03:16:41.984Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "e9eb9172-414d-484a-946a-c4980813d16e",
      "text": "đều phải ghen tị với nó.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 4,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:16:41.998Z",
      "updatedAt": "2025-09-03T03:16:41.998Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "208c34cd-d21b-451e-93b9-d7869b9dcc26",
      "text": "Vì thế, ĐỨC CHÚA là Chúa Thượng phán thế này :",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T03:16:42.012Z",
      "updatedAt": "2025-09-03T03:16:42.012Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "60efa0c8-9a3f-4a1d-9dfc-84a8808f26c6",
      "text": "Nó tự cao tự đại vì có thân to lớn, ngọn vươn lên trên các tầng mây, nó cậy mình cao rồi sinh lòng kiêu ngạo,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T03:16:42.040Z",
      "updatedAt": "2025-09-03T03:16:42.040Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "c8ab8b36-3f7f-49ae-8480-31ad7f2d444e",
      "text": "nên Ta sẽ trao nó vào tay kẻ thống lãnh các dân, để xử với nó theo sự gian ác của nó. Ta sẽ loại trừ nó.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 1,
      "isPoetry": false,
      "createdAt": "2025-09-03T03:16:42.054Z",
      "updatedAt": "2025-09-03T03:16:42.054Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "63d03f01-1f27-4a27-a92c-5378dad5f4b8",
      "text": "Những kẻ ngoại bang, những kẻ hung dữ nhất trong các dân tộc, sẽ đốn ngã và bỏ mặc nó. Cành của nó ngổn ngang khắp núi đồi và thung lũng ; lá nó bị giập nát phủ đầy mọi khe rãnh trong xứ ; mọi dân trong xứ đi khỏi bóng mát của nó và bỏ mặc nó.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 2,
      "isPoetry": false,
      "createdAt": "2025-09-03T03:16:42.082Z",
      "updatedAt": "2025-09-03T03:16:42.082Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "3c8e0c07-f77c-4e33-b0e1-c8d851532271",
      "text": "Trên đống đổ nát của nó, mọi thứ chim trời đến ở ; nơi lá cành của nó, mọi dã thú đến nương mình.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 3,
      "isPoetry": false,
      "createdAt": "2025-09-03T03:16:42.097Z",
      "updatedAt": "2025-09-03T03:16:42.097Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "711c57cd-d281-4385-b05a-13f20ed1f60d",
      "text": "Như thế, mọi thứ cây mọc bên dòng nước không còn tự cao vì có thân to lớn, không còn vươn ngọn lên trên các tầng mây ; mọi thứ cây được tưới đẫm nước không còn tự cao vì thân hình cao lớn, bởi vì tất cả đều bị phó mặc cho sự chết, cho miền đất thẳm sâu, giữa con cái loài người, bên cạnh những người đã sa xuống hố sâu.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T03:16:42.111Z",
      "updatedAt": "2025-09-03T03:16:42.111Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "0e4ef6bf-f7a0-4902-9ed6-49b7ad8e30bf",
      "text": "ĐỨC CHÚA là Chúa Thượng phán thế này : Vào ngày nó xuống âm phủ, Ta đã bắt mọi loài phải để tang ; vì nó, Ta đã che kín vực thẳm, đã khiến cho các con sông ngừng chảy và các dòng nước lũ ngưng lại. Vì nó, Ta đã làm cho Li-băng ra ảm đạm và mọi cây cối trong cánh đồng phải tàn úa.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T03:16:42.126Z",
      "updatedAt": "2025-09-03T03:16:42.126Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "0a3e1f27-cfc4-4b1b-969e-0adb3a7f3424",
      "text": "Ta đã làm cho các dân tộc rúng động, khi nghe tin nó bị sụp đổ, vì Ta đã xô nó xuống âm phủ, bên cạnh những người đã sa xuống hố. Bấy giờ, trong miền đất thẳm sâu, mọi cây cối ở Ê-đen, những cây đẹp nhất, tốt nhất của Li-băng, mọi thứ cây được tưới đẫm nước, tất cả đều lấy làm vui thích.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 1,
      "isPoetry": false,
      "createdAt": "2025-09-03T03:16:42.186Z",
      "updatedAt": "2025-09-03T03:16:42.186Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "9a333d5a-142c-4bfd-a7ab-5403729a1fbf",
      "text": "Cả chúng cũng đi xuống âm phủ cùng với nó, đến với những kẻ bị gươm đâm, cũng như những người trước kia đã trợ giúp và núp bóng nó giữa các dân tộc.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 2,
      "isPoetry": false,
      "createdAt": "2025-09-03T03:16:42.243Z",
      "updatedAt": "2025-09-03T03:16:42.243Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    },
    {
      "id": "91738612-3ba9-4413-b01e-3e7168066aaa",
      "text": "Cây nào trong số các cây ở Ê-đen vinh hiển và vĩ đại sánh được như ngươi ? Thế mà ngươi đã bị đưa xuống miền đất thẳm sâu, cùng với các cây cối Ê-đen ! Giữa những kẻ không được cắt bì, ngươi phải nằm phơi thây giữa những kẻ bị gươm đâm. Đó là số phận dành cho Pha-ra-ô và tất cả đoàn dân của nó, sấm ngôn của ĐỨC CHÚA là Chúa Thượng.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T03:16:42.271Z",
      "updatedAt": "2025-09-03T03:16:42.271Z",
      "chapterId": "ed12924c-4c6d-4985-9cec-c9e25e6523b6"
    }
  ],
  "marks": [
    {
