    {
      "id": "41d7a930-a626-4659-9b2a-38e0ac2b999c",
      "content": "Xưa Đức Chúa bỏ dân của Người vì dân đã phạm biết bao tội lỗi. Nhưng nay, Đức Chúa sẽ ngự giữa dân Người cho đến muôn đời, bởi vì dân đã dứt khoát bỏ những tội thờ ngẫu tượng, một hình thức đàng điếm về mặt tinh thần. Một lạm dụng khác nữa cũng chấm dứt : đó là việc chôn cất các vua ở chung quanh Đền Thờ, như thói quen cổ xưa.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "10",
      "sortOrder": 9,
      "startOffset": 22,
      "endOffset": 22,
      "createdAt": "2025-09-03T03:18:00.788Z",
      "updatedAt": "2025-09-03T03:18:00.788Z",
      "targetId": "1d45af38-d70f-4ad7-a103-59f7fa517ab2",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "4ebd73cd-d48c-4ad2-96c9-fa7147eb6007"
    },
    {
      "id": "620872ed-b85c-4d66-b778-b724a6743fbc",
      "content": "English: Yahweh | French: SEIGNEUR | Latin: Dominus | Origin: &#1497;&#1456;&#1492;&#64331;&#1464;&#1492; | Vietnamese: ĐỨC CHÚA -- Danh của Thiên Chúa Ít-ra-en, St 2,4...",
      "kind": "MARK_KIND_FOOTNOTE",
