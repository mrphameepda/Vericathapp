      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "4ebd73cd-d48c-4ad2-96c9-fa7147eb6007"
    },
    {
      "id": "c84e720e-dd71-4fda-b8ba-20bfa4f6ec6d",
      "content": "*Góc cong*, ds : *sừng*. Biểu tượng chỉ sức mạnh toàn năng của Thiên Chúa. Người ta bôi máu của các lễ vật hy sinh lên đó (x. Ed 29,14 ; Lv 4,25 ; 30,34) và đụng được vào đó là có quyền lánh nạn, thoát chết (x. 1 V 1,50 tt ; 2,28).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "17",
      "sortOrder": 16,
      "startOffset": 52,
      "endOffset": 52,
      "createdAt": "2025-09-03T03:18:01.036Z",
      "updatedAt": "2025-09-03T03:18:01.036Z",
