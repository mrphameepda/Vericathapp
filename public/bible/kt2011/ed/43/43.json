    },
    {
      "id": "18734ec4-89af-4591-8489-622722338ce3",
      "content": "English: Fours (Tour des) | French: Fours (tour des) | Latin: Furnorum (turrim) | Origin: &#1492;&#1463;&#64330;&#1463;&#1504;&#1468;&#64309;&#1512;&#1460;&#1497;&#1501; | Vietnamese: Lò (Tháp) -- Nkm 3,11",
      "kind": "MARK_KIND_FOOTNOTE",
