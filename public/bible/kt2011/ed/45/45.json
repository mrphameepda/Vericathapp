    {
      "id": "3e95c273-725f-44b1-8b9a-4f8df761fca7",
      "content": "Phần đất dành cho ông hoàng ở trung tâm Đất Thánh, phân cách các chi tộc phía Bắc với các chi tộc phía Nam như sẽ thấy ở Ed 48. Dải đất của ông hoàng bị gián đoạn bởi dải đất dành cho nơi thánh, nơi thánh thành một khoảng đất vuông. Khi phân phối như thế, ngôn sứ muốn nói lên một cách tượng trưng sức mạnh của thần quyền trong tổ chức quốc gia mới, đồng thời cũng muốn nói rằng ông hoàng không có quyền lấy chi tộc nào làm của riêng mình vì ông có phần sở hữu rộng hơn và được nơi tốt nhất trong xứ (x. Mk 2,1 tt ; 3,9 tt ; 6,10-11).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "8",
      "sortOrder": 7,
      "startOffset": 18,
      "endOffset": 18,
      "createdAt": "2025-09-03T03:18:13.688Z",
      "updatedAt": "2025-09-03T03:18:13.688Z",
      "targetId": "5c2451ae-f9c0-446c-bdad-509243f74829",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "27fc1602-da07-409d-8748-8c84e331919d"
    },
