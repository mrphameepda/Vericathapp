      "chapterId": "8a91dfc6-b21c-4809-b5d3-0a9fe98f88ec"
    },
    {
      "id": "44d1ac6b-2cca-4a6a-866f-c79e1be27d4b",
      "content": "*Cả gan*, ds : *dám hết lòng*.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "14",
      "sortOrder": 13,
      "startOffset": 68,
