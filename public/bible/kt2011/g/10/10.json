{
  "chapter": {
    "id": "b61a2499-f4e4-4953-bf63-03fa46b7659c",
    "number": 10,
    "createdAt": "2025-09-03T01:07:51.632Z",
    "updatedAt": "2025-09-03T01:07:51.632Z",
    "bookId": "1672a600-6214-4bc7-aaa4-9b99684355ac"
  },
  "verses": [
    {
      "id": "a1546859-98fe-439f-9eec-19250e48ca05",
      "text": "Hồn tôi chẳng còn ham sống,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:45.957Z",
      "updatedAt": "2025-09-03T02:20:45.957Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "ba2a43ca-6e0f-4b99-8268-129925b72e6e",
      "text": "tôi muốn để mặc cho tiếng thở than tuôn trào,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:45.986Z",
      "updatedAt": "2025-09-03T02:20:45.986Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "1c3b914e-5950-4982-af6e-1b7ed0315e8c",
      "text": "và muốn thốt ra lời khi tâm hồn cay đắng.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:45.996Z",
      "updatedAt": "2025-09-03T02:20:45.996Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "28e6035c-518b-4a2c-8b72-6d68dec344e4",
      "text": "Tôi sẽ thưa với Thiên Chúa : Xin đừng kết án con,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.005Z",
      "updatedAt": "2025-09-03T02:20:46.005Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "9c8cc7c2-9586-4cd1-ad32-79cd97269657",
      "text": "xin cho con biết tại sao Ngài tố cáo con.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.044Z",
      "updatedAt": "2025-09-03T02:20:46.044Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "1cc68cd4-019e-4bb8-bc78-b703297707be",
      "text": "Phải chăng Ngài thích thú khi đàn áp,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.056Z",
      "updatedAt": "2025-09-03T02:20:46.056Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "9555a6ac-9e6e-46a9-8893-4dbef4bcf6cb",
      "text": "khi coi rẻ công trình tay Ngài sáng tạo,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.083Z",
      "updatedAt": "2025-09-03T02:20:46.083Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "1308212b-d86d-4085-8a60-f96e3d675fb0",
      "text": "và ủng hộ mưu đồ của bọn ác nhân ?",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.096Z",
      "updatedAt": "2025-09-03T02:20:46.096Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "4c20856e-3cc8-4c7a-872f-734415780939",
      "text": "Phải chăng mắt Ngài chỉ là mắt thịt,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.110Z",
      "updatedAt": "2025-09-03T02:20:46.110Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "24c0aebe-e005-4452-98a1-14caf3169b8f",
      "text": "và Ngài nhìn theo kiểu phàm nhân ?",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.139Z",
      "updatedAt": "2025-09-03T02:20:46.139Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "c675dc84-69dd-4a9c-b60d-99d0b3a63c89",
      "text": "Phải chăng cuộc đời của Ngài",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.153Z",
      "updatedAt": "2025-09-03T02:20:46.153Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "3c0563d9-2628-434c-b7e7-60acaa87ccb4",
      "text": "cũng ngắn ngủi như đời người phải chết,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.167Z",
      "updatedAt": "2025-09-03T02:20:46.167Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "bbba52e9-65d4-4f6c-9608-72ddd5a5fbce",
      "text": "và năm tháng của Ngài cũng chóng qua như cuộc nhân sinh ?",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.181Z",
      "updatedAt": "2025-09-03T02:20:46.181Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "10eef050-ff3a-4f5c-aecd-170396c8881d",
      "text": "Nhưng chính Ngài tìm bắt lỗi con,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.195Z",
      "updatedAt": "2025-09-03T02:20:46.195Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "e467f0a3-49f7-473f-a0fa-b006d014afab",
      "text": "và điều tra tội con đã phạm,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.209Z",
      "updatedAt": "2025-09-03T02:20:46.209Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "ae939224-68f2-4f86-92a9-377d4bb701c1",
      "text": "mặc dầu Ngài biết : con không tội lỗi gì,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.223Z",
      "updatedAt": "2025-09-03T02:20:46.223Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "e586aa57-9f46-4f1f-8520-d5d4ca306402",
      "text": "và không ai thoát khỏi tay Ngài được.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.237Z",
      "updatedAt": "2025-09-03T02:20:46.237Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "41dad0c6-a642-462a-8b58-6d1232451980",
      "text": "Chính tay Ngài đã tạo tác nên con,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.285Z",
      "updatedAt": "2025-09-03T02:20:46.285Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "5d114319-4a59-4b72-86af-dc695cfa1d01",
      "text": "chẳng lẽ Ngài đổi ý mà huỷ diệt ?",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.309Z",
      "updatedAt": "2025-09-03T02:20:46.309Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "93d4056a-c702-40c5-9301-c561ce6006a2",
      "text": "Xin Ngài nhớ cho : Ngài đã tạo ra con bằng đất sét,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.319Z",
      "updatedAt": "2025-09-03T02:20:46.319Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "9bcb1012-5cbb-4003-8111-ddf37f3c7b18",
      "text": "rồi lại đưa con trở về cát bụi.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.340Z",
      "updatedAt": "2025-09-03T02:20:46.340Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "cd588324-c344-4ab2-88b9-22fb12401424",
      "text": "Há chẳng phải Ngài đã tạo nên con như sữa lỏng,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.363Z",
      "updatedAt": "2025-09-03T02:20:46.363Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "e7356c0e-4147-440d-903c-3e09fca0e5e2",
      "text": "rồi làm con đặc lại như bơ ?",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.394Z",
      "updatedAt": "2025-09-03T02:20:46.394Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "8f648524-5ba6-4baa-a2e6-11868b16bc9c",
      "text": "Ngài đắp lên con bằng da bằng thịt,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.405Z",
      "updatedAt": "2025-09-03T02:20:46.405Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "94b9c875-ad17-4664-a771-4d1eed93950c",
      "text": "rồi lấy gân lấy cốt mà dệt mà thêu.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.427Z",
      "updatedAt": "2025-09-03T02:20:46.427Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "1e74af0d-1408-4f95-b689-7dcf87304477",
      "text": "Ngài đã ban cho con tình thương và sự sống,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.438Z",
      "updatedAt": "2025-09-03T02:20:46.438Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "93be8a7f-b3d6-4733-b2c3-929816b685ab",
      "text": "quan tâm đến từng hơi thở của con.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.449Z",
      "updatedAt": "2025-09-03T02:20:46.449Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "72fa09ff-953c-405a-b3ed-673eba18e665",
      "text": "Nhưng có điều này Ngài luôn giữ kín,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.474Z",
      "updatedAt": "2025-09-03T02:20:46.474Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "aa5345b2-3424-4661-8ebe-7adb55a0177c",
      "text": "con biết rõ đó chính là ý nghĩ của Ngài.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.486Z",
      "updatedAt": "2025-09-03T02:20:46.486Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "8ecfb14e-07ce-4aed-9784-7b098f09d72e",
      "text": "Nếu con phạm tội, Ngài để ý lưu tâm,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.497Z",
      "updatedAt": "2025-09-03T02:20:46.497Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "1a29fc29-d6ee-4ca6-a172-1cd9e0942312",
      "text": "chẳng bỏ qua lỗi lầm con phạm.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.509Z",
      "updatedAt": "2025-09-03T02:20:46.509Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "fe9de3b4-4e6f-4490-8e51-a53a70e8e416",
      "text": "Nếu con có tội, thì khốn cho con !",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.529Z",
      "updatedAt": "2025-09-03T02:20:46.529Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "99b70102-d666-47fd-8467-cfb76ca91689",
      "text": "Mà nếu có công chính, con cũng chẳng dám ngẩng đầu :",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.541Z",
      "updatedAt": "2025-09-03T02:20:46.541Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "55b096ff-5cb0-4c7f-af90-f3d727f89f2e",
      "text": "Tủi hổ đầy tràn, lỗi lầm chồng chất.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 2,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.564Z",
      "updatedAt": "2025-09-03T02:20:46.564Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "e2891586-9f7c-43c8-b941-7f7b786bd254",
      "text": "Nếu con ngẩng đầu, thì khác nào sư tử,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.594Z",
      "updatedAt": "2025-09-03T02:20:46.594Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "c9a73ab8-65c5-4d1a-a129-a2cb9190e247",
      "text": "Ngài liền săn đuổi con, Ngài hạ nhục con để bày tỏ uy quyền.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.613Z",
      "updatedAt": "2025-09-03T02:20:46.613Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "981fc64d-8778-46fe-9136-8de23fbeaf19",
      "text": "Nhằm cáo tội con, Ngài đưa hết lý này đến lý khác ;",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.650Z",
      "updatedAt": "2025-09-03T02:20:46.650Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "7f714b0b-9ea2-4adb-93de-d15a09838504",
      "text": "nhằm chống lại con, Ngài không ngớt khơi dậy cơn phẫn nộ ;",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.670Z",
      "updatedAt": "2025-09-03T02:20:46.670Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "1223f47b-bd74-489c-b252-802b13253f04",
      "text": "nhằm bao vây con, Ngài đưa thêm nhiều đoàn quân mới.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 2,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.687Z",
      "updatedAt": "2025-09-03T02:20:46.687Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "490289ec-6eb0-432d-ab01-b4249ef55e2b",
      "text": "Vậy thì tại sao Ngài lại kéo con ra khỏi lòng mẹ ?",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.719Z",
      "updatedAt": "2025-09-03T02:20:46.719Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "d0e3c522-85f3-4ae1-b19b-02456050a1c3",
      "text": "Phải chi lúc đó con tắt thở cho rồi,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.767Z",
      "updatedAt": "2025-09-03T02:20:46.767Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "cde86c0f-32d1-4655-af53-42e3f1b66091",
      "text": "chẳng còn ai nhìn thấy con nữa !",
      "label": "18",
      "number": 18,
      "subVerseIndex": 2,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.787Z",
      "updatedAt": "2025-09-03T02:20:46.787Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "e36fb4ce-50b1-4ef1-92e8-9ce4b81a7c34",
      "text": "Con sẽ được coi như không có,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.810Z",
      "updatedAt": "2025-09-03T02:20:46.810Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "c8c3a99c-bf26-4ee7-855f-cbd1352c28d5",
      "text": "được đưa thẳng từ dạ mẹ xuống mồ.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.830Z",
      "updatedAt": "2025-09-03T02:20:46.830Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "40691aac-e125-4e01-9f4b-827753790dbc",
      "text": "Ngày đời con, nào có được bao nhiêu !",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.848Z",
      "updatedAt": "2025-09-03T02:20:46.848Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "84f36578-c071-403a-a4e7-e0ec0e201386",
      "text": "Xin Ngài nương tay, để con được đôi phần thanh thoả,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.905Z",
      "updatedAt": "2025-09-03T02:20:46.905Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "c51c93fb-e91f-4d68-9f9b-7fa008d47e21",
      "text": "trước khi con ra đi, không hẹn ngày trở lại,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.938Z",
      "updatedAt": "2025-09-03T02:20:46.938Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "d9605aac-bc65-4873-90c1-1abd39ae0dc9",
      "text": "đi về nơi tăm tối, dưới bóng tử thần,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:46.974Z",
      "updatedAt": "2025-09-03T02:20:46.974Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "5eab7a73-e498-4c62-b938-d2a39bc55c1c",
      "text": "nơi tăm tối, mịt mù, hỗn độn,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:47.012Z",
      "updatedAt": "2025-09-03T02:20:47.012Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "6e917900-f1ec-4802-a147-9abc234f4d9f",
      "text": "nơi ánh sáng và bóng tối cũng như nhau.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:47.050Z",
      "updatedAt": "2025-09-03T02:20:47.050Z",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    }
  ],
  "marks": [
    {
      "id": "e3143ff6-1408-4c06-9191-19899fda9ba5",
      "content": "G 7,11-15",
      "kind": "MARK_KIND_REFERENCE",
      "label": "1@",
      "sortOrder": 0,
