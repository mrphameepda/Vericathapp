      "targetId": "a1546859-98fe-439f-9eec-19250e48ca05",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "66f38f5d-c344-48e9-b18b-87d240d54dae",
      "content": "English: Sin | French: Sin | Latin: Sin | Origin: &#1505;&#1460;&#1497;&#1503; | Vietnamese: Xin 1 -- sa mạc trong cuộc Xuất hành, Xh 16,1 ; Ds 33,11-12",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 32,
      "endOffset": 32,
      "createdAt": "2025-09-03T02:20:46.016Z",
      "updatedAt": "2025-09-03T02:20:46.016Z",
      "targetId": "28e6035c-518b-4a2c-8b72-6d68dec344e4",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "0ceb4de3-52e2-44e2-ac35-1fba02ac599f",
      "content": "Ông Gióp muốn biết lý do Thiên Chúa thù ghét và tránh mặt ông. Cc. 3-12 : với lời lẽ rất cảm động, ông nói trực tiếp với Thiên Chúa để tìm ra sự thật về hoàn cảnh của mình.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 48,
      "endOffset": 48,
      "createdAt": "2025-09-03T02:20:46.034Z",
      "updatedAt": "2025-09-03T02:20:46.034Z",
      "targetId": "28e6035c-518b-4a2c-8b72-6d68dec344e4",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "c5be8e6e-33b3-402d-b6d4-84ad71cbccc8",
      "content": "1 Sm 16,7; Gr 11,20",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 11,
      "endOffset": 11,
      "createdAt": "2025-09-03T02:20:46.125Z",
      "updatedAt": "2025-09-03T02:20:46.125Z",
      "targetId": "4c20856e-3cc8-4c7a-872f-734415780939",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "95ad84ef-4a54-404e-800f-aa41ec8bf5ea",
      "content": "Ông Gióp đặt vấn đề có phải ông đau khổ vì những lý do sau đây : Thiên Chúa thích hành hạ (c.3), lầm lẫn (c.4), ghen tuông với hạnh phúc con người vì hạnh phúc của Người cũng vắn vỏi (c.5) ?",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 36,
      "endOffset": 36,
      "createdAt": "2025-09-03T02:20:46.069Z",
      "updatedAt": "2025-09-03T02:20:46.069Z",
      "targetId": "1cc68cd4-019e-4bb8-bc78-b703297707be",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "b4006478-b235-41b5-82f7-f664dad09bf2",
      "content": "Đnl 32,39; Kn 16,15",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:20:46.265Z",
      "updatedAt": "2025-09-03T02:20:46.265Z",
      "targetId": "e586aa57-9f46-4f1f-8520-d5d4ca306402",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "805387f5-7aea-41ad-b37b-8eabe16c7a81",
      "content": "*Tay Ngài* cuối c.7 và đầu c.8 đặt nghi vấn cho ông Gióp : Thiên Chúa có hai bộ mặt : tốt lành và độc ác ?",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 26,
      "endOffset": 26,
      "createdAt": "2025-09-03T02:20:46.251Z",
      "updatedAt": "2025-09-03T02:20:46.251Z",
      "targetId": "e586aa57-9f46-4f1f-8520-d5d4ca306402",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "fe6f60c1-a0f7-4467-b212-44bf36b14aa3",
      "content": "St 2,7; Tv 119,73",
      "kind": "MARK_KIND_REFERENCE",
      "label": "4@",
      "sortOrder": 3,
      "startOffset": 18,
      "endOffset": 18,
      "createdAt": "2025-09-03T02:20:46.298Z",
      "updatedAt": "2025-09-03T02:20:46.298Z",
      "targetId": "41dad0c6-a642-462a-8b58-6d1232451980",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "e0892db2-c1fc-4084-ab86-040059db5d40",
      "content": "English: Sin | French: Sin | Latin: Sin | Origin: &#1505;&#1460;&#1497;&#1503; | Vietnamese: Xin 1 -- sa mạc trong cuộc Xuất hành, Xh 16,1 ; Ds 33,11-12",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "5",
      "sortOrder": 4,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:20:46.330Z",
      "updatedAt": "2025-09-03T02:20:46.330Z",
      "targetId": "93d4056a-c702-40c5-9301-c561ce6006a2",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "4afade0c-02d4-4caf-93d1-dcc9d6cb4843",
      "content": "Kn 7,2",
      "kind": "MARK_KIND_REFERENCE",
      "label": "5@",
      "sortOrder": 4,
      "startOffset": 38,
      "endOffset": 38,
      "createdAt": "2025-09-03T02:20:46.383Z",
      "updatedAt": "2025-09-03T02:20:46.383Z",
      "targetId": "cd588324-c344-4ab2-88b9-22fb12401424",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "e6ed42a1-68a9-4a1f-96cc-3df4211ff63f",
      "content": "Hình ảnh thợ gốm và đất sét là một trong những hình ảnh nổi bật nhất trong Kinh Thánh về quyền tối thượng của Thiên Chúa (x. Is 45,9 ; Gr 18,5-12 ; Rm 9,20-25). Khi chết con người trở về cát bụi (x. St 3,19 ; Tv 90,3).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "6",
      "sortOrder": 5,
      "startOffset": 30,
      "endOffset": 30,
      "createdAt": "2025-09-03T02:20:46.349Z",
      "updatedAt": "2025-09-03T02:20:46.349Z",
      "targetId": "9bcb1012-5cbb-4003-8111-ddf37f3c7b18",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "6164675f-7609-4476-b4c9-12e5746bc526",
      "content": "St 2,7; Tv 139,13",
      "kind": "MARK_KIND_REFERENCE",
      "label": "6@",
      "sortOrder": 5,
      "startOffset": 5,
      "endOffset": 5,
      "createdAt": "2025-09-03T02:20:46.416Z",
      "updatedAt": "2025-09-03T02:20:46.416Z",
      "targetId": "8f648524-5ba6-4baa-a2e6-11868b16bc9c",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "85846b13-c1d8-43e4-bfba-d1dd1dee72a1",
      "content": "Cc. 10-11 mô tả sự hình thành kỳ diệu của bào thai con người từ khi thụ thai, phát triển trước khi chào đời : tinh trùng chảy như sữa vào tử cung rồi đặc lại như bơ và sau cùng xương và bắp thịt được tạo nên (x. Tv 139,13-16 ; Kn 7,2). Thân xác con người là một công trình nghệ thuật do một nghệ sĩ đại tài là Thiên Chúa thực hiện.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "7",
      "sortOrder": 6,
      "startOffset": 2,
      "endOffset": 2,
      "createdAt": "2025-09-03T02:20:46.373Z",
      "updatedAt": "2025-09-03T02:20:46.373Z",
      "targetId": "cd588324-c344-4ab2-88b9-22fb12401424",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "a77bdc1f-5a42-42ce-bb04-b525d4fa9fa8",
      "content": "G 7,21",
      "kind": "MARK_KIND_REFERENCE",
      "label": "7@",
      "sortOrder": 6,
      "startOffset": 6,
      "endOffset": 6,
      "createdAt": "2025-09-03T02:20:46.519Z",
      "updatedAt": "2025-09-03T02:20:46.519Z",
      "targetId": "1a29fc29-d6ee-4ca6-a172-1cd9e0942312",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "7450ada9-4a57-4ecb-b197-69cc03e63d80",
      "content": "Hơi thở biểu hiện sự sống. Nếu Thiên Chúa rút hơi thở, con người sẽ chết. Ông Gióp gặp đau khổ dữ dằn, nhưng vẫn tin tưởng Thiên Chúa lo cho ông được sống.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "8",
      "sortOrder": 7,
      "startOffset": 25,
      "endOffset": 25,
      "createdAt": "2025-09-03T02:20:46.462Z",
      "updatedAt": "2025-09-03T02:20:46.462Z",
      "targetId": "93be8a7f-b3d6-4733-b2c3-929816b685ab",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "248d829b-254b-4f18-a9d6-72fa0d14b0a6",
      "content": "G 9,20",
      "kind": "MARK_KIND_REFERENCE",
      "label": "8@",
      "sortOrder": 7,
      "startOffset": 10,
      "endOffset": 10,
      "createdAt": "2025-09-03T02:20:46.551Z",
      "updatedAt": "2025-09-03T02:20:46.551Z",
      "targetId": "99b70102-d666-47fd-8467-cfb76ca91689",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "c27d8e92-3604-4c5e-912e-c8522ddda94c",
      "content": "Ông Gióp phủ nhận ý kiến của bạn hữu về nhân quả tội phúc. Thiên Chúa chọn hình phạt hành hạ ông vì lý do riêng của Người.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "9",
      "sortOrder": 8,
      "startOffset": 36,
      "endOffset": 36,
      "createdAt": "2025-09-03T02:20:46.576Z",
      "updatedAt": "2025-09-03T02:20:46.576Z",
      "targetId": "55b096ff-5cb0-4c7f-af90-f3d727f89f2e",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "7e841293-9d4e-4e05-a4b9-32db64a16513",
      "content": "G 16,9",
      "kind": "MARK_KIND_REFERENCE",
      "label": "9@",
      "sortOrder": 8,
      "startOffset": 10,
      "endOffset": 10,
      "createdAt": "2025-09-03T02:20:46.633Z",
      "updatedAt": "2025-09-03T02:20:46.633Z",
      "targetId": "c9a73ab8-65c5-4d1a-a129-a2cb9190e247",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "b4d79b56-72d6-4429-a621-5ccfa0268740",
      "content": "Những đau khổ liên tiếp xảy đến cho ông Gióp. Có phải đây nhắc lại 7,5 không ?",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "10",
      "sortOrder": 9,
      "startOffset": 51,
      "endOffset": 51,
      "createdAt": "2025-09-03T02:20:46.702Z",
      "updatedAt": "2025-09-03T02:20:46.702Z",
      "targetId": "1223f47b-bd74-489c-b252-802b13253f04",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "b61a2499-f4e4-4953-bf63-03fa46b7659c"
    },
    {
      "id": "772bd020-83e8-497d-9195-b0f8f40c5f28",
      "content": "G 3,11-16",
      "kind": "MARK_KIND_REFERENCE",
      "label": "10@",
      "sortOrder": 9,
      "startOffset": 25,
      "endOffset": 25,
