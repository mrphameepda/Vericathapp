    {
      "id": "b8fd5114-8012-4e8f-8d4e-197f027416c1",
      "content": "Rm 11,33; 1 Cr 2,9-11",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 28,
      "endOffset": 28,
      "createdAt": "2025-09-03T02:20:52.719Z",
      "updatedAt": "2025-09-03T02:20:52.719Z",
      "targetId": "aec1743b-8aec-47de-a0ac-2359f637475f",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "cb914f87-093d-473e-98b5-f5a59e252e32",
      "content": "Ông Xô-pha tỏ ra là người ít kỳ quặc nhất, nhưng lại hăng hái nhất. Ông không nại đến kinh nghiệm riêng (như ông Ê-li-phát), cũng không nại đến truyền thống tiền nhân (như ông Bin-đát). Thế giá của ông là chính khôn ngoan của Thiên Chúa. Mở đầu, ông Xô-pha cho rằng những lời của ông Gióp chỉ là những lời rỗng tuếch (11,2-3). Lời biện hộ của ông là ảo tưởng (11,4). Nếu Thiên Chúa lên tiếng, Người sẽ chỉ cho ông Gióp nhận ra lỗi lầm của ông (11,5-6). Thiên Chúa là Đấng tuyệt hảo thấu suốt mọi sự, không ai có thể chống lại phán quyết của Người (11,7-12). Nếu ông Gióp nhận mình có tội, thì ông lại được hạnh phúc (11,13-20).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 48,
      "endOffset": 48,
      "createdAt": "2025-09-03T02:20:52.541Z",
      "updatedAt": "2025-09-03T02:20:52.541Z",
      "targetId": "b6df2870-76f1-43a5-9cab-0c343054315e",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "cedadcb6-f907-4a6a-84d1-82cd014cdf58",
      "content": "Ep 3,18",
      "kind": "MARK_KIND_REFERENCE",
      "label": "4@",
      "sortOrder": 3,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:20:52.847Z",
      "updatedAt": "2025-09-03T02:20:52.847Z",
      "targetId": "0232a53e-8a91-430d-9248-ac258d959ca8",
      "targetType": "MARK_TARGET_TYPE_VERSE",
