      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "90c9b616-3ef6-48d3-befb-9ddd12262813",
      "content": "Cc. 8-9 : Thiên Chúa siêu việt hơn mọi hiểu biết của con người : cao, sâu, dài, rộng (x. Is 7,11).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "10",
      "sortOrder": 9,
      "startOffset": 44,
      "endOffset": 44,
      "createdAt": "2025-09-03T02:20:52.889Z",
      "updatedAt": "2025-09-03T02:20:52.889Z",
      "targetId": "204b4914-de03-4a4a-bfb0-51cfdb3a4f7d",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "e9effff7-ffbf-4088-85f4-59db75cde1ca",
      "content": "Is 9,1; 58,8-10",
      "kind": "MARK_KIND_REFERENCE",
      "label": "10@",
      "sortOrder": 9,
      "startOffset": 11,
      "endOffset": 11,
      "createdAt": "2025-09-03T02:20:53.400Z",
      "updatedAt": "2025-09-03T02:20:53.400Z",
      "targetId": "a015b061-74de-43d5-8a68-828259bb627a",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "37ea12e1-63fb-4cf6-96fd-5085689bdb8f",
      "content": "Thiên Chúa toàn năng vượt quá mọi khả năng của con người. Thiên Chúa tự do hành động theo ý muốn của Người. Không ai tránh được sự xét xử của Thiên Chúa.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "11",
      "sortOrder": 10,
      "startOffset": 28,
      "endOffset": 28,
      "createdAt": "2025-09-03T02:20:52.966Z",
      "updatedAt": "2025-09-03T02:20:52.966Z",
      "targetId": "fc9e65cb-bb18-4745-8cf6-f956bb227fe8",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "a7f2a1ff-3553-4089-85f5-69f04be331ef",
      "content": "G 3,21; 6,9; 7,15",
      "kind": "MARK_KIND_REFERENCE",
      "label": "11@",
      "sortOrder": 10,
      "startOffset": 21,
      "endOffset": 21,
      "createdAt": "2025-09-03T02:20:53.579Z",
      "updatedAt": "2025-09-03T02:20:53.579Z",
      "targetId": "4ec25d5b-1039-456c-8100-fd9f95a40723",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "87d91317-cfca-480e-8145-ba1be1efdf63",
      "content": "Hình phạt của Thiên Chúa nhằm hoán cải tội nhân. Nếu biết suy nghĩ, tội nhân sẽ dùng hình phạt để trở nên tốt và tốt hơn.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "12",
      "sortOrder": 11,
      "startOffset": 40,
      "endOffset": 40,
      "createdAt": "2025-09-03T02:20:53.070Z",
      "updatedAt": "2025-09-03T02:20:53.070Z",
      "targetId": "eb60962a-5247-45ae-b9c8-adb81387eb98",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "da5ccbba-2158-41fd-8e51-e6a5dc387fec",
      "content": "Hoặc là nơi cư trú : Ông Gióp phải biệt cư với gia đình hơn là một người du mục ; hoặc là thân xác.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "13",
      "sortOrder": 12,
      "startOffset": 41,
      "endOffset": 41,
      "createdAt": "2025-09-03T02:20:53.199Z",
      "updatedAt": "2025-09-03T02:20:53.199Z",
      "targetId": "f0879e38-7e98-4d2c-a50b-9008be73fb8f",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "5ba485c0-8d30-4065-b4cc-deb5b9e9dc16",
      "content": "Khác hẳn với thái độ của ông Gióp (10,15) ở trên.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "14",
      "sortOrder": 13,
      "startOffset": 33,
      "endOffset": 33,
      "createdAt": "2025-09-03T02:20:53.260Z",
      "updatedAt": "2025-09-03T02:20:53.260Z",
      "targetId": "a721c48e-2618-4449-b66c-2e7b0027f899",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "41e700af-2693-4b60-9fc8-10189fae69dc",
      "content": "Cc. 17-19 : Những tia hy vọng rọi sáng lương tâm ông Gióp : nếu ông Gióp phạm tội, Thiên Chúa tha và tưởng thưởng cho ông ; ông lại có nhiều bạn bè.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "15",
      "sortOrder": 14,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:20:53.381Z",
      "updatedAt": "2025-09-03T02:20:53.381Z",
      "targetId": "a015b061-74de-43d5-8a68-828259bb627a",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "9d6248d8-9503-4c98-97ac-25e2331520da",
      "content": "Kết luận : chỉ kẻ gian ác mới mong chết. Nếu ông Gióp mong chết, đó là dấu cho thấy ông có tội.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "16",
      "sortOrder": 15,
      "startOffset": 43,
      "endOffset": 43,
      "createdAt": "2025-09-03T02:20:53.569Z",
      "updatedAt": "2025-09-03T02:20:53.569Z",
      "targetId": "4ec25d5b-1039-456c-8100-fd9f95a40723",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    }
  ],
