{
  "chapter": {
    "id": "194c2317-9fc2-489d-887c-966dbf1e3495",
    "number": 11,
    "createdAt": "2025-09-03T01:07:51.632Z",
    "updatedAt": "2025-09-03T01:07:51.632Z",
    "bookId": "1672a600-6214-4bc7-aaa4-9b99684355ac"
  },
  "verses": [
    {
      "id": "b6df2870-76f1-43a5-9cab-0c343054315e",
      "text": "Bấy giờ ông Xô-pha, người Na-a-mát lên tiếng nói :",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:20:52.478Z",
      "updatedAt": "2025-09-03T02:20:52.478Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "43b63925-44c1-4032-acad-c2228edf4513",
      "text": "Kẻ nhiều lời, phải chăng không ai đối đáp nổi ?",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:52.554Z",
      "updatedAt": "2025-09-03T02:20:52.554Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "84d23cf2-a8c4-4660-b620-3e69bda1ae28",
      "text": "Khéo ăn khéo nói là chính trực hay sao ?",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:52.568Z",
      "updatedAt": "2025-09-03T02:20:52.568Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "404dbe8c-9bf0-4e41-ad5a-034297713df3",
      "text": "Phải chăng những lời lẽ ba hoa của anh",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:52.582Z",
      "updatedAt": "2025-09-03T02:20:52.582Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "070c1d05-39b3-484a-ac93-981d1295169d",
      "text": "khiến người ta câm miệng ?",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:52.596Z",
      "updatedAt": "2025-09-03T02:20:52.596Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "69dc72fc-740c-4d55-92fb-6b8287a469de",
      "text": "Anh buông lời chế nhạo, mà chẳng ai làm anh nhục nhã sao ?",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:52.621Z",
      "updatedAt": "2025-09-03T02:20:52.621Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "1d85ab26-1ce9-4380-9bc1-ea42745e0702",
      "text": "Anh dám khẳng định : “Điều tôi nói quả là đúng đắn.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:52.632Z",
      "updatedAt": "2025-09-03T02:20:52.632Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "2c0443a4-e763-468a-9d9c-156b621939b6",
      "text": "Có Thiên Chúa làm chứng : tôi là người thanh sạch.”",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:52.654Z",
      "updatedAt": "2025-09-03T02:20:52.654Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "165071b2-fa14-4455-beef-271fdaf01f2d",
      "text": "Nhưng phải chi Thiên Chúa lên tiếng",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:52.666Z",
      "updatedAt": "2025-09-03T02:20:52.666Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "85867a70-ac2e-49ce-b690-837c2f74f8b4",
      "text": "để trực tiếp ngỏ lời với anh.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:52.698Z",
      "updatedAt": "2025-09-03T02:20:52.698Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "aec1743b-8aec-47de-a0ac-2359f637475f",
      "text": "Phải chi Người cho anh được biết",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:52.708Z",
      "updatedAt": "2025-09-03T02:20:52.708Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "d763e7bd-e2b4-45f8-be70-6bef7ce9f656",
      "text": "bao nhiêu bí ẩn của lẽ khôn ngoan",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:52.730Z",
      "updatedAt": "2025-09-03T02:20:52.730Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "bbc8b573-4733-4f5b-9d72-94ff02d6e76c",
      "text": "vượt quá tầm hiểu biết của người phàm.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:52.751Z",
      "updatedAt": "2025-09-03T02:20:52.751Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "55d9bb4e-d9a3-4af5-bb73-77aad9faa464",
      "text": "Bấy giờ anh mới rõ :",
      "label": "6",
      "number": 6,
      "subVerseIndex": 3,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:52.763Z",
      "updatedAt": "2025-09-03T02:20:52.763Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "f4367e06-47d5-4a4d-a2ca-7834ad0f9119",
      "text": "lầm lỗi của anh, Thiên Chúa đã bỏ quên một phần.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 4,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:52.775Z",
      "updatedAt": "2025-09-03T02:20:52.775Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "9a14701b-13d6-41ef-895a-f6f137f5e001",
      "text": "Liệu anh có dò nổi mầu nhiệm cao sâu của Thiên Chúa,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:52.802Z",
      "updatedAt": "2025-09-03T02:20:52.802Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "47a97a5e-05aa-4f5f-bd5d-c5543c77c12d",
      "text": "liệu anh có nhận thức Đấng Toàn Năng tuyệt hảo dường nào ?",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:52.815Z",
      "updatedAt": "2025-09-03T02:20:52.815Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "0232a53e-8a91-430d-9248-ac258d959ca8",
      "text": "Sự tuyệt hảo của Người",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:52.837Z",
      "updatedAt": "2025-09-03T02:20:52.837Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "74441b67-678f-435b-bf65-50a1163c026b",
      "text": "cao hơn các tầng trời, liệu anh làm gì được,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:52.858Z",
      "updatedAt": "2025-09-03T02:20:52.858Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "3781d96f-5c04-4615-823e-3cbb9fcfa802",
      "text": "sâu thẳm hơn âm phủ, hỏi anh biết được gì,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:52.868Z",
      "updatedAt": "2025-09-03T02:20:52.868Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "204b4914-de03-4a4a-bfb0-51cfdb3a4f7d",
      "text": "trải dài hơn cõi đất, rộng hơn cả biển sâu ?",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:52.879Z",
      "updatedAt": "2025-09-03T02:20:52.879Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "deacb790-0107-46f1-89cc-0b1cdb1cf140",
      "text": "Nếu Người đi qua để cầm tù, và triệu tập đại hội để xử án,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:52.902Z",
      "updatedAt": "2025-09-03T02:20:52.902Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "fc9e65cb-bb18-4745-8cf6-f956bb227fe8",
      "text": "thì ai ngăn cản được Người ?",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:52.939Z",
      "updatedAt": "2025-09-03T02:20:52.939Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "20cc0875-940f-4537-bfa1-02ec70673ad3",
      "text": "Quả thật, Người biết rõ quân vô loại,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:52.992Z",
      "updatedAt": "2025-09-03T02:20:52.992Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "80be33bf-73ab-449c-8351-adbb491d7181",
      "text": "tội ác, Người thấy ngay mà không cần chú ý.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:53.012Z",
      "updatedAt": "2025-09-03T02:20:53.012Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "7acacb67-5a35-4ade-9fb4-57ac5c10c49b",
      "text": "Vì thế, kẻ ngu si sẽ thành người am hiểu,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:53.029Z",
      "updatedAt": "2025-09-03T02:20:53.029Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "eb60962a-5247-45ae-b9c8-adb81387eb98",
      "text": "và lừa hoang được huấn luyện thành người.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:53.052Z",
      "updatedAt": "2025-09-03T02:20:53.052Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "272887c6-f15a-4e45-aaae-91a7f3007905",
      "text": "Phần anh, nếu anh giữ lòng mình cho kiên vững,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:53.110Z",
      "updatedAt": "2025-09-03T02:20:53.110Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "b0deabd7-5f03-4aaf-aba5-46cff258df0f",
      "text": "nếu anh dang tay hướng thẳng về Người,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:53.127Z",
      "updatedAt": "2025-09-03T02:20:53.127Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "4e2f2360-8d95-4f74-84ba-5b0ce054af1c",
      "text": "nếu anh ném xa điều gian ác trong tay,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:53.164Z",
      "updatedAt": "2025-09-03T02:20:53.164Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "f0879e38-7e98-4d2c-a50b-9008be73fb8f",
      "text": "và không để cho bất công cư ngụ trong lều,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:53.182Z",
      "updatedAt": "2025-09-03T02:20:53.182Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "a721c48e-2618-4449-b66c-2e7b0027f899",
      "text": "thì bấy giờ, anh sẽ ngẩng mặt lên, không tỳ ố,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:53.238Z",
      "updatedAt": "2025-09-03T02:20:53.238Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "c1fb209a-0cfd-4616-85af-caaaeb71139c",
      "text": "anh sẽ được vững vàng, không sợ hãi chi.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:53.279Z",
      "updatedAt": "2025-09-03T02:20:53.279Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "9c70b268-ac8f-46fa-95ce-eca79b588bc4",
      "text": "Vì bấy giờ anh sẽ quên tai hoạ,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:53.302Z",
      "updatedAt": "2025-09-03T02:20:53.302Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "eea943f2-4103-4d9a-854c-b178fbda427d",
      "text": "dù anh nhớ tới, nó cũng như dòng nước đã chảy qua.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:53.322Z",
      "updatedAt": "2025-09-03T02:20:53.322Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "a015b061-74de-43d5-8a68-828259bb627a",
      "text": "Đời anh sẽ huy hoàng hơn mặt trời chính ngọ,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:53.364Z",
      "updatedAt": "2025-09-03T02:20:53.364Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "f67cff68-2c44-4c6e-ba84-8a3b9d258b23",
      "text": "và tháng ngày tăm tối",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:53.418Z",
      "updatedAt": "2025-09-03T02:20:53.418Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "0ed7bb13-93ab-4e27-b618-a1c631d1f8dd",
      "text": "sẽ trở thành như những buổi bình minh.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 2,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:53.439Z",
      "updatedAt": "2025-09-03T02:20:53.439Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "5ec2ff54-f30b-4288-80a9-d924d8b37d51",
      "text": "Anh sẽ được vững dạ an lòng vì có niềm hy vọng :",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:53.457Z",
      "updatedAt": "2025-09-03T02:20:53.457Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "4df0ea44-ce3f-40c3-b4d5-b5cc17478184",
      "text": "dù đã phải thẹn thùng xấu hổ,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:53.474Z",
      "updatedAt": "2025-09-03T02:20:53.474Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "28719755-570c-46af-ad2e-399693cdbe06",
      "text": "anh sẽ được nghỉ ngơi yên hàn.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 2,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:53.491Z",
      "updatedAt": "2025-09-03T02:20:53.491Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "097780ea-4eef-4f63-b16a-904f8ffe3c7d",
      "text": "Anh sẽ nghỉ yên, không bị ai quấy phá,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:53.510Z",
      "updatedAt": "2025-09-03T02:20:53.510Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "8c1adb6d-9b2c-4790-88d5-d771d1550e2d",
      "text": "có nhiều người sẽ tìm đến cầu thân.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:53.523Z",
      "updatedAt": "2025-09-03T02:20:53.523Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "8fdf8da0-6d70-4b85-a785-dc0e66e2e297",
      "text": "Còn quân gian ác có mỏi mắt tìm",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:53.536Z",
      "updatedAt": "2025-09-03T02:20:53.536Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "14e4221f-6b0a-4090-ac5a-ae0ba440ec5b",
      "text": "cũng chẳng thấy nơi nương ẩn,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:53.548Z",
      "updatedAt": "2025-09-03T02:20:53.548Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "4ec25d5b-1039-456c-8100-fd9f95a40723",
      "text": "hy vọng của chúng là trút hơi thở cuối cùng.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 2,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:53.558Z",
      "updatedAt": "2025-09-03T02:20:53.558Z",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    }
  ],
