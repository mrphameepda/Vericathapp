      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "f6c5d293-ce3f-4596-8520-166c8d3dfe6c",
      "content": "Khôn ngoan là nguồn gốc của hiểu biết. Tác giả ngầm hiểu, hay nhân cách hoá khôn ngoan. Dù chưa hiểu khôn ngoan là Thiên Chúa như sách Khôn ngoan, tác giả đã đề cao tính siêu việt của khôn ngoan.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "7",
      "sortOrder": 6,
      "startOffset": 33,
      "endOffset": 33,
      "createdAt": "2025-09-03T02:20:52.740Z",
      "updatedAt": "2025-09-03T02:20:52.740Z",
      "targetId": "d763e7bd-e2b4-45f8-be70-6bef7ce9f656",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "0477b134-4081-421b-bec7-07743af9bf48",
      "content": "Tv 88,10",
      "kind": "MARK_KIND_REFERENCE",
      "label": "7@",
      "sortOrder": 6,
      "startOffset": 8,
      "endOffset": 8,
      "createdAt": "2025-09-03T02:20:53.144Z",
      "updatedAt": "2025-09-03T02:20:53.144Z",
      "targetId": "b0deabd7-5f03-4aaf-aba5-46cff258df0f",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "0daf7805-744c-4384-86c2-9a70bf1cf331",
      "content": "Ông Xô-pha quả quyết hình phạt ông Gióp chịu chưa tương xứng với tội ông phạm, vì lòng Chúa xót thương.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "8",
      "sortOrder": 7,
      "startOffset": 47,
      "endOffset": 47,
      "createdAt": "2025-09-03T02:20:52.788Z",
      "updatedAt": "2025-09-03T02:20:52.788Z",
      "targetId": "f4367e06-47d5-4a4d-a2ca-7834ad0f9119",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
