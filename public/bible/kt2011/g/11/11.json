      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "dc156a31-3de7-4a45-ada7-9f5380846dc2",
      "content": "G 9,12",
      "kind": "MARK_KIND_REFERENCE",
      "label": "5@",
      "sortOrder": 4,
      "startOffset": 20,
      "endOffset": 20,
