      "chapterId": "194c2317-9fc2-489d-887c-966dbf1e3495"
    },
    {
      "id": "29142973-e10a-4cd5-b1e2-b6cc8cfc014a",
      "content": "G 39,5-8; St 16,12",
      "kind": "MARK_KIND_REFERENCE",
      "label": "6@",
      "sortOrder": 5,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:20:53.091Z",
