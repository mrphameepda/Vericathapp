    },
    {
      "id": "e07c407a-a9fd-4e9c-8dda-7a08167cb02b",
      "content": "Ông Xô-pha tóm tắt lời biện hộ của ông Gióp.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "5",
      "sortOrder": 4,
