      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "c149b08c-b5ff-488c-8381-699c8618f8d1",
      "content": "Cn 17,28",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 22,
      "endOffset": 22,
      "createdAt": "2025-09-03T02:21:05.343Z",
