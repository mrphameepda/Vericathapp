    },
    {
      "id": "7df90026-9618-49b0-ab58-8a955c0b8398",
      "content": "Khi Thiên Chúa biểu lộ tính siêu việt của Người thì con người không thể nào đứng vững được (x. Đnl 10,17).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "9",
      "sortOrder": 8,
      "startOffset": 56,
      "endOffset": 56,
      "createdAt": "2025-09-03T02:21:05.677Z",
      "updatedAt": "2025-09-03T02:21:05.677Z",
      "targetId": "9efbff6a-cf52-4979-b471-f8d384812f30",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "b3e57a91-b806-4a65-9d05-7a355a1a7d4d",
      "content": "G 9,14",
      "kind": "MARK_KIND_REFERENCE",
      "label": "9@",
      "sortOrder": 8,
      "startOffset": 20,
      "endOffset": 20,
      "createdAt": "2025-09-03T02:21:05.946Z",
      "updatedAt": "2025-09-03T02:21:05.946Z",
      "targetId": "b8515867-d676-4fbc-865c-1a2379b95199",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "d3d88be2-140e-441e-9867-ee5c59be98cd",
      "content": "Ông Gióp ngạo các bạn : những câu trả lời của họ là những câu châm ngôn ! Châm ngôn thường có tính răn đời. Ở đây lại là thứ châm ngôn không có giá trị gì : chỉ như tro bụi.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "10",
      "sortOrder": 9,
      "startOffset": 26,
      "endOffset": 26,
      "createdAt": "2025-09-03T02:21:05.733Z",
      "updatedAt": "2025-09-03T02:21:05.733Z",
      "targetId": "878c0dee-820c-420c-9782-2d3e5680cb20",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "1abae9ad-0093-45ea-b585-44470c1f20fd",
      "content": "G 9,34; 23,6",
      "kind": "MARK_KIND_REFERENCE",
      "label": "10@",
      "sortOrder": 9,
      "startOffset": 12,
      "endOffset": 12,
      "createdAt": "2025-09-03T02:21:06.073Z",
      "updatedAt": "2025-09-03T02:21:06.073Z",
      "targetId": "809d916a-ed5e-49ce-bb4c-45839ba5e59a",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "575e8aa0-a9e5-464d-a283-918732657265",
      "content": "Một lần nữa, ông Gióp yêu cầu các bạn im lặng.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "11",
      "sortOrder": 10,
      "startOffset": 5,
      "endOffset": 5,
      "createdAt": "2025-09-03T02:21:05.771Z",
      "updatedAt": "2025-09-03T02:21:05.771Z",
      "targetId": "1282bc62-818d-4f00-bb54-4ce03f7699e7",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "e1320089-f421-469f-98e8-a0e4c77e9e30",
      "content": "Tv 4,7; 44,25",
      "kind": "MARK_KIND_REFERENCE",
      "label": "11@",
      "sortOrder": 10,
      "startOffset": 13,
      "endOffset": 13,
      "createdAt": "2025-09-03T02:21:06.229Z",
      "updatedAt": "2025-09-03T02:21:06.229Z",
      "targetId": "287b48b4-f360-4d87-b649-e86388097cd2",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "ec36e9a9-145d-4ae6-8b0e-b6ec52b936e8",
      "content": "Đứng trước cái chết gần kề, ông Gióp không còn sợ hãi, thử liều một lần : đánh bạo lên tiếng, chết cũng cam.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "12",
      "sortOrder": 11,
      "startOffset": 43,
      "endOffset": 43,
      "createdAt": "2025-09-03T02:21:05.801Z",
      "updatedAt": "2025-09-03T02:21:05.801Z",
      "targetId": "1e5a3ee9-c47b-4095-8e97-2c40a6016de3",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "139f6aef-b572-45d2-8943-847d892a1d83",
      "content": "Tv 83,14",
      "kind": "MARK_KIND_REFERENCE",
      "label": "12@",
      "sortOrder": 11,
      "startOffset": 44,
      "endOffset": 44,
      "createdAt": "2025-09-03T02:21:06.258Z",
      "updatedAt": "2025-09-03T02:21:06.258Z",
      "targetId": "5617cae6-3a26-4dff-a486-ea47679a4786",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "1c5afe03-3dee-4f67-9485-f698d540897b",
      "content": "Đầy lạc quan về lối sống không giả hình của mình, nhưng chân thực, ông Gióp hy vọng mình thoát nạn.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "13",
      "sortOrder": 12,
      "startOffset": 58,
      "endOffset": 58,
      "createdAt": "2025-09-03T02:21:05.863Z",
      "updatedAt": "2025-09-03T02:21:05.863Z",
      "targetId": "0d427d2b-5184-4c58-bd79-f7979d6568f1",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "fe8d3227-d1eb-4a4c-a85b-c6006eebaf57",
      "content": "Tv 25,7",
      "kind": "MARK_KIND_REFERENCE",
      "label": "13@",
      "sortOrder": 12,
      "startOffset": 13,
      "endOffset": 13,
      "createdAt": "2025-09-03T02:21:06.345Z",
      "updatedAt": "2025-09-03T02:21:06.345Z",
      "targetId": "3dfbd393-089c-48ec-bb75-d38a71dc9069",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "e03790a4-be72-483f-bca0-be69c2a58f8a",
      "content": "English: Sin | French: Sin | Latin: Sin | Origin: &#1505;&#1460;&#1497;&#1503; | Vietnamese: Xin 1 -- sa mạc trong cuộc Xuất hành, Xh 16,1 ; Ds 33,11-12",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "14",
      "sortOrder": 13,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:21:05.895Z",
      "updatedAt": "2025-09-03T02:21:05.895Z",
      "targetId": "48fb61a0-4b8f-42d0-9340-85d5e1f70ced",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "58641348-d085-450d-82d6-c1e5bec3397a",
      "content": "G 33,11",
      "kind": "MARK_KIND_REFERENCE",
      "label": "14@",
      "sortOrder": 13,
      "startOffset": 7,
      "endOffset": 7,
      "createdAt": "2025-09-03T02:21:06.365Z",
      "updatedAt": "2025-09-03T02:21:06.365Z",
      "targetId": "ed127706-08f9-4b12-b7b2-e7fca7cf97ee",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "ef78d256-1e21-4d42-9599-79f15f616024",
      "content": "Ông Gióp đứng ra tự biện hộ và nói trực tiếp với Thiên Chúa. Ông không sợ chết nữa.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "15",
      "sortOrder": 14,
      "startOffset": 35,
      "endOffset": 35,
      "createdAt": "2025-09-03T02:21:05.913Z",
      "updatedAt": "2025-09-03T02:21:05.913Z",
      "targetId": "48fb61a0-4b8f-42d0-9340-85d5e1f70ced",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "d9b7655f-730f-48d4-b3e6-f2862a53f921",
      "content": "Tv 39,12; 102,27; Is 50,9; Hc 10,1-10",
      "kind": "MARK_KIND_REFERENCE",
      "label": "15@",
      "sortOrder": 14,
      "startOffset": 47,
      "endOffset": 47,
      "createdAt": "2025-09-03T02:21:06.419Z",
      "updatedAt": "2025-09-03T02:21:06.419Z",
      "targetId": "51d42578-dcd8-4b38-889e-b0db391859d1",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "8244db8c-b1cc-4309-8a69-d735c6ccbf52",
      "content": "Đề tài chính của vụ kiện : ông Gióp công chính. Ông Gióp đặt điều kiện : nếu bị đánh bại, ông sẽ chết tức thì.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "16",
      "sortOrder": 15,
      "startOffset": 37,
      "endOffset": 37,
      "createdAt": "2025-09-03T02:21:05.995Z",
      "updatedAt": "2025-09-03T02:21:05.995Z",
      "targetId": "3a2f4178-3370-4c7a-81e1-01e06863f046",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "3085a0c4-fc79-4ccd-9cb8-7e8f01aa7a1d",
      "content": "Cc. 13,20 – 14,22 : ông Gióp nói thẳng với Chúa.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "17",
      "sortOrder": 16,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:21:06.018Z",
      "updatedAt": "2025-09-03T02:21:06.018Z",
      "targetId": "ce0cd975-2279-4e6f-abf8-6cd08cac9eae",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "48d22c58-91aa-4956-8bcb-3146a51c70f8",
      "content": "English: Sin | French: Sin | Latin: Sin | Origin: &#1505;&#1460;&#1497;&#1503; | Vietnamese: Xin 1 -- sa mạc trong cuộc Xuất hành, Xh 16,1 ; Ds 33,11-12",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "18",
      "sortOrder": 17,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:21:06.058Z",
      "updatedAt": "2025-09-03T02:21:06.058Z",
      "targetId": "809d916a-ed5e-49ce-bb4c-45839ba5e59a",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "f32d5c5c-14c2-4992-b96c-2a0041a873fa",
      "content": "Ông Gióp xin Chúa cho ông được bình đẳng trong cuộc tranh luận.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "19",
      "sortOrder": 18,
      "startOffset": 33,
      "endOffset": 33,
      "createdAt": "2025-09-03T02:21:06.101Z",
      "updatedAt": "2025-09-03T02:21:06.101Z",
      "targetId": "97bf8a0a-3d19-4cad-815d-4151947a11e4",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "28df3e49-e387-4507-8588-88e3e3c58618",
      "content": "Phương thức đối đáp giữa hai bên bảo đảm tính công bằng trong vụ kiện.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "20",
      "sortOrder": 19,
      "startOffset": 32,
      "endOffset": 32,
      "createdAt": "2025-09-03T02:21:06.143Z",
      "updatedAt": "2025-09-03T02:21:06.143Z",
      "targetId": "eee0d34f-5aaa-4b47-a24b-385142696e26",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "aa4f3d1c-0373-4fa2-8f85-6feef7ea6083",
      "content": "Dấu chỉ sự hờ hững hay cơn thịnh nộ của Thiên Chúa (x. Tv 27,9 ; 30,8 ; 104,29 ; Is 54,8).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "21",
      "sortOrder": 20,
      "startOffset": 19,
      "endOffset": 19,
      "createdAt": "2025-09-03T02:21:06.215Z",
      "updatedAt": "2025-09-03T02:21:06.215Z",
      "targetId": "287b48b4-f360-4d87-b649-e86388097cd2",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "c174185c-5e57-4520-9e99-bb6fe04c4a5e",
      "content": "Hình ảnh này muốn giúp ta hiểu số phận kẻ gian ác (x. Is 1,30 ; 34,4 ; 64,5 ; Gr 8,13 ; Ed 47,12 ; Tv 1,3 ; 4).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "22",
      "sortOrder": 21,
      "startOffset": 36,
      "endOffset": 36,
      "createdAt": "2025-09-03T02:21:06.286Z",
      "updatedAt": "2025-09-03T02:21:06.286Z",
      "targetId": "6068e077-bb73-4b3b-afe7-dd2f051636a6",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "24b06b76-8d8a-4abc-a090-f0c26dd0d0f3",
      "content": "Ông Gióp thừa nhận có phạm tội lúc thanh xuân (x. Tv 25,7), nhưng không nghĩ Chúa lại trở về quá khứ xa xôi để trừng phạt ông.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "23",
      "sortOrder": 22,
      "startOffset": 40,
      "endOffset": 40,
      "createdAt": "2025-09-03T02:21:06.335Z",
      "updatedAt": "2025-09-03T02:21:06.335Z",
      "targetId": "3dfbd393-089c-48ec-bb75-d38a71dc9069",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "15bdf53e-01e8-4213-824c-df00d88c6f39",
      "content": "Nô lệ bị đóng dấu trên các phần khác nhau của thân thể, đôi khi trên trán, thường hơn là trên cánh tay (x. Is 44,5 ; 49,16) và cũng có khi ở bàn chân.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "24",
      "sortOrder": 23,
      "startOffset": 22,
      "endOffset": 22,
      "createdAt": "2025-09-03T02:21:06.385Z",
      "updatedAt": "2025-09-03T02:21:06.385Z",
      "targetId": "3219e77c-8ab1-4c72-ac4c-49402d7a4421",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "24db27e0-4a5f-40c9-80d8-03f243a0fc86",
      "content": "Có lẽ câu này đặt sau 14,2 hoặc 14,6 thích hợp hơn.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "25",
      "sortOrder": 24,
      "startOffset": 56,
      "endOffset": 56,
      "createdAt": "2025-09-03T02:21:06.406Z",
      "updatedAt": "2025-09-03T02:21:06.406Z",
      "targetId": "51d42578-dcd8-4b38-889e-b0db391859d1",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    }
  ],
