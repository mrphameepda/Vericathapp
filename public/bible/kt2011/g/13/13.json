    },
    {
      "id": "4627af70-e4d0-426d-b842-deb3ec3a5414",
      "content": "Ông Gióp phủ nhận sự hiểu biết và trí khôn ngoan của các bạn. Ông muốn tự biện hộ, vì ông hiểu mình và tin tưởng vào Thiên Chúa.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 43,
      "endOffset": 43,
