{
  "chapter": {
    "id": "ef890a24-64b5-4c2e-99d5-41def423afd8",
    "number": 13,
    "createdAt": "2025-09-03T01:07:51.632Z",
    "updatedAt": "2025-09-03T01:07:51.632Z",
    "bookId": "1672a600-6214-4bc7-aaa4-9b99684355ac"
  },
  "verses": [
    {
      "id": "a8ebc732-a1bb-4c77-868b-54cb34f065d0",
      "text": "Những chuyện này chính mắt tôi đã thấy,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:05.183Z",
      "updatedAt": "2025-09-03T02:21:05.183Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "d8f35918-92fb-4e44-bb43-ea1be410d439",
      "text": "chính tai tôi đã nghe và đã hiểu.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:05.211Z",
      "updatedAt": "2025-09-03T02:21:05.211Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "d5296265-4967-4080-a70a-d064b968606e",
      "text": "Điều các anh biết, tôi đây cũng biết, tôi chẳng thua kém gì.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:05.222Z",
      "updatedAt": "2025-09-03T02:21:05.222Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "de126512-f731-47c2-a2a2-a46f81c83a04",
      "text": "Phần tôi, tôi sẽ thưa với chính Đấng Toàn Năng,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:05.242Z",
      "updatedAt": "2025-09-03T02:21:05.242Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "8f4b5276-7294-49cc-a76b-9bb45daee314",
      "text": "tôi muốn biện hộ cho mình trước Thiên Chúa.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:05.277Z",
      "updatedAt": "2025-09-03T02:21:05.277Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "3a3be6f7-6067-41d0-a304-8cbba6b25ccb",
      "text": "Còn các anh, hạng láo khoét bày trò,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:05.302Z",
      "updatedAt": "2025-09-03T02:21:05.302Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "1fa212cf-b6b0-4275-baf4-97e78b545006",
      "text": "tất cả các anh chỉ là bọn lang băm !",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:05.313Z",
      "updatedAt": "2025-09-03T02:21:05.313Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "d2885c25-fa41-4e0e-8bdf-b9c8e3292fa2",
      "text": "Phải chi các anh biết nín lặng !",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:05.333Z",
      "updatedAt": "2025-09-03T02:21:05.333Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "d14272c2-1b40-43f0-8216-b37d8a135ee2",
      "text": "Như thế các anh mới là người khôn ngoan.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:05.354Z",
      "updatedAt": "2025-09-03T02:21:05.354Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "75de1f17-7ef9-44c5-9d8a-c57d72683227",
      "text": "Xin các anh nghe lời tôi biện hộ ;",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:05.385Z",
      "updatedAt": "2025-09-03T02:21:05.385Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "eade6724-cd22-4d00-aa91-1264f11847e2",
      "text": "xin để ý lời miệng tôi phân trần.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:05.437Z",
      "updatedAt": "2025-09-03T02:21:05.437Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "a246eee9-d59d-4d11-b446-db15068be0fe",
      "text": "Có phải nhân danh Thiên Chúa mà các anh nói lời dối trá ?",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:05.457Z",
      "updatedAt": "2025-09-03T02:21:05.457Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "9ab1af7c-ef18-424e-9e03-be3fdb4d8856",
      "text": "Có phải vì Người, mà các anh bày chuyện điêu ngoa ?",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:05.485Z",
      "updatedAt": "2025-09-03T02:21:05.485Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "ed771ab4-a0e1-446f-a724-f324470af74f",
      "text": "Có phải các anh đứng về phe Người ?",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:05.503Z",
      "updatedAt": "2025-09-03T02:21:05.503Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "c3cfa377-4686-4890-8d41-7b028843cd7d",
      "text": "Có phải các anh biện hộ cho Thiên Chúa ?",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:05.522Z",
      "updatedAt": "2025-09-03T02:21:05.522Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "5b087001-b4e8-4eaf-96ef-c43926e98ef1",
      "text": "Người dò xét các anh, phải chăng đó là điều tốt ?",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:05.559Z",
      "updatedAt": "2025-09-03T02:21:05.559Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "00188d1e-3801-4826-a8b7-c6ef769601ab",
      "text": "Phải chăng các anh phỉnh gạt Người",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:05.576Z",
      "updatedAt": "2025-09-03T02:21:05.576Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "c9c18f09-8640-4400-b795-5c69a1bc46ba",
      "text": "như phỉnh gạt phàm nhân ?",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:05.615Z",
      "updatedAt": "2025-09-03T02:21:05.615Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "b94439b7-33f0-48fd-bff9-891d76eadf73",
      "text": "Hẳn Người sẽ phiền trách các anh,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:05.631Z",
      "updatedAt": "2025-09-03T02:21:05.631Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "25b806b8-e3ce-486c-9b94-7fa0888710a9",
      "text": "nếu các anh đã bí mật theo phe phái.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:05.650Z",
      "updatedAt": "2025-09-03T02:21:05.650Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "9efbff6a-cf52-4979-b471-f8d384812f30",
      "text": "Phải chăng uy phong Người chẳng làm cho các anh khiếp sợ,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:05.665Z",
      "updatedAt": "2025-09-03T02:21:05.665Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "fb74b01f-47ea-4721-acb0-cca312c2e64d",
      "text": "nỗi kinh hoàng Người chẳng ập xuống các anh ?",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:05.701Z",
      "updatedAt": "2025-09-03T02:21:05.701Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "dca51395-6a6d-42b0-824f-d73b76d83e01",
      "text": "Lời các anh khuyên bảo",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:05.712Z",
      "updatedAt": "2025-09-03T02:21:05.712Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "878c0dee-820c-420c-9782-2d3e5680cb20",
      "text": "chỉ là những câu châm ngôn tầm thường như tro bụi,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:05.722Z",
      "updatedAt": "2025-09-03T02:21:05.722Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "bcef284e-fd87-434d-b43b-511245445064",
      "text": "lập luận của các anh là thứ lập luận mềm nhũn như đất sét.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:05.743Z",
      "updatedAt": "2025-09-03T02:21:05.743Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "1282bc62-818d-4f00-bb54-4ce03f7699e7",
      "text": "Im đi, để mặc tôi ! Chính tôi sẽ nói, rồi muốn ra sao thì ra.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:05.758Z",
      "updatedAt": "2025-09-03T02:21:05.758Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "1e5a3ee9-c47b-4095-8e97-2c40a6016de3",
      "text": "Vì thế tôi sẽ liều mạng đến một mất một còn.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:05.791Z",
      "updatedAt": "2025-09-03T02:21:05.791Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "dad54078-66ae-4d32-98a7-b908d725e22d",
      "text": "Người có thể giết tôi, tôi chẳng còn gì để hy vọng,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:05.811Z",
      "updatedAt": "2025-09-03T02:21:05.811Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "b5b26231-bee2-400d-a3d1-70c6edb54016",
      "text": "nhưng trước nhan Người,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:05.822Z",
      "updatedAt": "2025-09-03T02:21:05.822Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "455cc462-1d65-474b-af09-1c6cd9e44484",
      "text": "cách sống của tôi, tôi phải biện hộ.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 2,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:05.832Z",
      "updatedAt": "2025-09-03T02:21:05.832Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "c0a8adfd-2b18-4adf-8e65-f9750e830083",
      "text": "Đó chính là điều sẽ cứu tôi,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:05.842Z",
      "updatedAt": "2025-09-03T02:21:05.842Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "0d427d2b-5184-4c58-bd79-f7979d6568f1",
      "text": "vì trước nhan Người, ác nhân sẽ không dám xuất đầu lộ diện.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:05.852Z",
      "updatedAt": "2025-09-03T02:21:05.852Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "48fb61a0-4b8f-42d0-9340-85d5e1f70ced",
      "text": "Xin các anh để tâm nghe lời tôi nói,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:05.885Z",
      "updatedAt": "2025-09-03T02:21:05.885Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "12fb57bc-dfb0-4925-b6d7-a830e6daabff",
      "text": "lắng tai nghe lời tôi giãi bày.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:05.924Z",
      "updatedAt": "2025-09-03T02:21:05.924Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "b8515867-d676-4fbc-865c-1a2379b95199",
      "text": "Này đây tôi sắp sửa trình bày vụ việc,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:05.935Z",
      "updatedAt": "2025-09-03T02:21:05.935Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "1f885c0d-7d39-48d9-8b40-bdc365962daf",
      "text": "tôi biết rõ rằng tôi công chính.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:05.957Z",
      "updatedAt": "2025-09-03T02:21:05.957Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "fd3d32e6-2995-4048-b365-f39ebe0507ab",
      "text": "Vậy nếu có ai cãi và thắng được tôi,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:05.972Z",
      "updatedAt": "2025-09-03T02:21:05.972Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "3a2f4178-3370-4c7a-81e1-01e06863f046",
      "text": "tôi sẽ làm thinh ngay và chết tức thì.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:05.984Z",
      "updatedAt": "2025-09-03T02:21:05.984Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "ce0cd975-2279-4e6f-abf8-6cd08cac9eae",
      "text": "Chỉ xin Chúa miễn cho con hai điều này thôi,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:06.007Z",
      "updatedAt": "2025-09-03T02:21:06.007Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "c99f15e2-8a3e-4ba6-ad8d-d8e2dfd7d088",
      "text": "và con sẽ không trốn để khỏi giáp mặt Ngài :",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:06.030Z",
      "updatedAt": "2025-09-03T02:21:06.030Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "809d916a-ed5e-49ce-bb4c-45839ba5e59a",
      "text": "Xin đừng để tay Ngài đè nặng lên con,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:06.044Z",
      "updatedAt": "2025-09-03T02:21:06.044Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "97bf8a0a-3d19-4cad-815d-4151947a11e4",
      "text": "và đừng làm con kinh hoàng sợ hãi.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:06.087Z",
      "updatedAt": "2025-09-03T02:21:06.087Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "3ce8ae77-399e-4672-a666-ccd243eae33a",
      "text": "Bấy giờ Ngài gọi, con sẽ xin thưa,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:06.115Z",
      "updatedAt": "2025-09-03T02:21:06.115Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "eee0d34f-5aaa-4b47-a24b-385142696e26",
      "text": "hoặc con có hỏi, Ngài sẽ trả lời.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:06.128Z",
      "updatedAt": "2025-09-03T02:21:06.128Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "de1361c0-ee89-4259-857e-1c1eb2cb06ff",
      "text": "Con đã phạm bao nhiêu tội lỗi ?",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:06.157Z",
      "updatedAt": "2025-09-03T02:21:06.157Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "b4821176-0820-45a6-9092-b011747e4eb2",
      "text": "Bao nhiêu lần con đã phản nghịch,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:06.171Z",
      "updatedAt": "2025-09-03T02:21:06.171Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "61cc64d6-610c-45b5-aef1-f488cae9a459",
      "text": "đã đắc tội với Ngài, xin cho con được biết.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 2,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:06.186Z",
      "updatedAt": "2025-09-03T02:21:06.186Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "287b48b4-f360-4d87-b649-e86388097cd2",
      "text": "Sao Ngài lại ẩn mặt, và xem con như thù địch của Ngài ?",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:06.201Z",
      "updatedAt": "2025-09-03T02:21:06.201Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "5617cae6-3a26-4dff-a486-ea47679a4786",
      "text": "Có phải điều Ngài muốn là làm run rẩy chiếc lá gió thổi bay,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:06.243Z",
      "updatedAt": "2025-09-03T02:21:06.243Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "6068e077-bb73-4b3b-afe7-dd2f051636a6",
      "text": "hay đuổi theo một cọng rơm khô héo ?",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:06.272Z",
      "updatedAt": "2025-09-03T02:21:06.272Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "69a1022a-c590-422a-a4a6-bf2f2ddf1e55",
      "text": "Quả thật, nhằm chống lại con,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:06.299Z",
      "updatedAt": "2025-09-03T02:21:06.299Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "ef037461-23d0-46ef-b140-38af2c7d8c7a",
      "text": "Ngài đã viết những lời cay đắng,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:06.312Z",
      "updatedAt": "2025-09-03T02:21:06.312Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "3dfbd393-089c-48ec-bb75-d38a71dc9069",
      "text": "đã kể ra các tội con phạm lúc xuân xanh,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 2,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:06.324Z",
      "updatedAt": "2025-09-03T02:21:06.324Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "ed127706-08f9-4b12-b7b2-e7fca7cf97ee",
      "text": "đã tra chân con vào cùm, theo dõi mọi đường nẻo con đi,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:06.355Z",
      "updatedAt": "2025-09-03T02:21:06.355Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "3219e77c-8ab1-4c72-ac4c-49402d7a4421",
      "text": "và dò xét mọi dấu chân con bước.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:06.375Z",
      "updatedAt": "2025-09-03T02:21:06.375Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "51d42578-dcd8-4b38-889e-b0db391859d1",
      "text": "Con người mục nát như gỗ mọt, như tấm áo đã bị mối xông.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:06.396Z",
      "updatedAt": "2025-09-03T02:21:06.396Z",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    }
  ],
  "marks": [
