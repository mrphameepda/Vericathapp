      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "ae526cdf-05fa-493b-83fd-33357210f10f",
      "content": "G 10,1",
      "kind": "MARK_KIND_REFERENCE",
      "label": "7@",
      "sortOrder": 6,
      "startOffset": 7,
      "endOffset": 7,
      "createdAt": "2025-09-03T02:21:05.781Z",
      "updatedAt": "2025-09-03T02:21:05.781Z",
      "targetId": "1282bc62-818d-4f00-bb54-4ce03f7699e7",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "a0711910-792b-4790-a206-80c9147a42f9",
      "content": "Các bạn tự đứng về phía Thiên Chúa, kết tội ông Gióp. Nhưng họ dùng chứng gian, thì làm sao biện hộ cho Thiên Chúa được ?",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "8",
      "sortOrder": 7,
      "startOffset": 40,
      "endOffset": 40,
      "createdAt": "2025-09-03T02:21:05.542Z",
      "updatedAt": "2025-09-03T02:21:05.542Z",
      "targetId": "c3cfa377-4686-4890-8d41-7b028843cd7d",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ef890a24-64b5-4c2e-99d5-41def423afd8"
    },
    {
      "id": "bebd208e-0a15-4b40-a0e3-5075c74812d5",
      "content": "St 3,8",
      "kind": "MARK_KIND_REFERENCE",
      "label": "8@",
      "sortOrder": 7,
      "startOffset": 32,
      "endOffset": 32,
