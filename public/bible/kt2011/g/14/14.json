    {
      "id": "8e0223d8-d0a4-4ccb-b4a2-6a39a82cc15e",
      "content": "Ông Gióp mơ ước chỉ phải ở tạm trong âm phủ, rồi sau đó được trở về nơi có ánh sáng ; nhưng ông không đạt được ý nguyện.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "10",
      "sortOrder": 9,
      "startOffset": 50,
      "endOffset": 50,
      "createdAt": "2025-09-03T02:21:11.895Z",
      "updatedAt": "2025-09-03T02:21:11.895Z",
      "targetId": "8182202a-f32c-4ef4-ac19-838525ea5cad",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "1662a5e3-9213-4c33-a320-514d1ded5289",
      "content": "G 31,4",
      "kind": "MARK_KIND_REFERENCE",
      "label": "10@",
      "sortOrder": 9,
      "startOffset": 13,
      "endOffset": 13,
      "createdAt": "2025-09-03T02:21:12.021Z",
      "updatedAt": "2025-09-03T02:21:12.021Z",
      "targetId": "d6aa2f20-b401-46f1-80d6-622c6ae0aecc",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "577e4657-6f61-4eea-8bec-900527ad5f0e",
      "content": "Như người lính hay như nô lệ, ông Gióp mong được thoát khỏi những vất vả.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "11",
      "sortOrder": 10,
      "startOffset": 32,
      "endOffset": 32,
      "createdAt": "2025-09-03T02:21:11.917Z",
      "updatedAt": "2025-09-03T02:21:11.917Z",
      "targetId": "1618bf0a-af6b-4ef1-9237-3f8579e05b74",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "49567e5d-9d76-4e87-a1cb-acd7b02e34ab",
      "content": "G 10,6",
      "kind": "MARK_KIND_REFERENCE",
      "label": "11@",
      "sortOrder": 10,
      "startOffset": 32,
      "endOffset": 32,
      "createdAt": "2025-09-03T02:21:12.041Z",
      "updatedAt": "2025-09-03T02:21:12.041Z",
      "targetId": "50c44422-a2bb-4580-bb83-f32d6f893ca9",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "e5056291-3338-432f-bc10-ba9b7ff3daf2",
      "content": "Không phải toàn thể công trình sáng tạo, mà nói riêng đến con người.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "12",
      "sortOrder": 11,
      "startOffset": 40,
      "endOffset": 40,
      "createdAt": "2025-09-03T02:21:11.987Z",
      "updatedAt": "2025-09-03T02:21:11.987Z",
      "targetId": "645b1c1a-3766-4ae6-a9f7-33a7a6892227",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "3a98f267-7194-4588-839a-65c561013c4e",
      "content": "G 9,30-31",
      "kind": "MARK_KIND_REFERENCE",
      "label": "12@",
      "sortOrder": 11,
      "startOffset": 21,
      "endOffset": 21,
      "createdAt": "2025-09-03T02:21:12.087Z",
      "updatedAt": "2025-09-03T02:21:12.087Z",
      "targetId": "75ce8077-773a-4fee-b3ca-6137b87f92a3",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "0507e714-def0-4418-8bce-78976c057767",
      "content": "Chúa theo dõi ông Gióp, vì Người coi ông như kẻ thù.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "13",
      "sortOrder": 12,
      "startOffset": 26,
      "endOffset": 26,
      "createdAt": "2025-09-03T02:21:12.010Z",
      "updatedAt": "2025-09-03T02:21:12.010Z",
      "targetId": "d6aa2f20-b401-46f1-80d6-622c6ae0aecc",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "254d0850-4a60-4f42-872b-c63bc8c2dc3d",
      "content": "G 6,12; 18,4",
      "kind": "MARK_KIND_REFERENCE",
      "label": "13@",
      "sortOrder": 12,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:21:12.117Z",
      "updatedAt": "2025-09-03T02:21:12.117Z",
      "targetId": "b863ebe9-5d85-4e83-a701-974dd184dcbc",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "2bd85249-0933-4a09-9094-2077b2eaad02",
      "content": "Chúa sẽ quên mọi tội ác và tha thứ cho ông Gióp.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "14",
      "sortOrder": 13,
      "startOffset": 31,
      "endOffset": 31,
      "createdAt": "2025-09-03T02:21:12.077Z",
      "updatedAt": "2025-09-03T02:21:12.077Z",
      "targetId": "75ce8077-773a-4fee-b3ca-6137b87f92a3",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "bbcd9180-2da5-4393-8639-fbf5da286c1f",
      "content": "G 21,21",
      "kind": "MARK_KIND_REFERENCE",
      "label": "14@",
      "sortOrder": 13,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:21:12.199Z",
      "updatedAt": "2025-09-03T02:21:12.199Z",
      "targetId": "a61a3336-9072-48d7-8e41-c26d4eea2066",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "a1c2c59a-9637-4451-a338-041a8f93aa59",
      "content": "Thực tế cho thấy thân phận con người bị Thiên Chúa đày đoạ và làm tiêu tan mọi hy vọng.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "15",
      "sortOrder": 14,
      "startOffset": 55,
      "endOffset": 55,
      "createdAt": "2025-09-03T02:21:12.147Z",
      "updatedAt": "2025-09-03T02:21:12.147Z",
      "targetId": "b288f3f4-1f76-4387-bf4c-e1ddeb63227e",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "d4f60743-fb2b-4b4a-9ee8-d25b9a21105c",
      "content": "Hiểu cách chung. Còn trường hợp ông Gióp, hiện nay không còn con cái nữa.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "16",
      "sortOrder": 15,
      "startOffset": 46,
      "endOffset": 46,
      "createdAt": "2025-09-03T02:21:12.220Z",
      "updatedAt": "2025-09-03T02:21:12.220Z",
      "targetId": "8d00dd11-454f-44c9-9873-d0c21f09a096",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    }
