{
  "chapter": {
    "id": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca",
    "number": 14,
    "createdAt": "2025-09-03T01:07:51.632Z",
    "updatedAt": "2025-09-03T01:07:51.632Z",
    "bookId": "1672a600-6214-4bc7-aaa4-9b99684355ac"
  },
  "verses": [
    {
      "id": "204a3e96-60c6-457e-b0a5-a4b0144a0638",
      "text": "Con người do phụ nữ sinh ra,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:11.301Z",
      "updatedAt": "2025-09-03T02:21:11.301Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "198cd802-7635-4139-a30f-f73749af3942",
      "text": "tuổi đời ngắn ngủi, mà âu lo chồng chất.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:11.342Z",
      "updatedAt": "2025-09-03T02:21:11.342Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "49b78373-7ac8-4ea2-8181-235dbe91e090",
      "text": "Tựa đoá hoa mới nở đã tàn,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:11.364Z",
      "updatedAt": "2025-09-03T02:21:11.364Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "ae112bb2-c520-4bcb-852d-8fc8b5026268",
      "text": "con người qua mau, khác nào bóng câu qua cửa sổ,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:11.403Z",
      "updatedAt": "2025-09-03T02:21:11.403Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "503e078e-eb20-4cc4-b599-3e11335c905d",
      "text": "thế mà Ngài lại để mắt nhìn xem,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:11.417Z",
      "updatedAt": "2025-09-03T02:21:11.417Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "6e606412-a9a0-47b8-abf3-482be393ab10",
      "text": "còn bắt ra đối chất với Ngài.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:11.445Z",
      "updatedAt": "2025-09-03T02:21:11.445Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "6362e8b4-e1a2-476f-8463-3ab218b9ca28",
      "text": "Ai tìm thanh sạch được từ ô uế ?",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:11.459Z",
      "updatedAt": "2025-09-03T02:21:11.459Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "c4896279-88cc-494b-b4bd-792e368f4040",
      "text": "Dứt khoát chẳng một ai !",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:11.500Z",
      "updatedAt": "2025-09-03T02:21:11.500Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "9a58271c-0f74-4a91-9fbd-972ecebf1e62",
      "text": "Vì tuổi con người đã được Ngài ấn định,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:11.513Z",
      "updatedAt": "2025-09-03T02:21:11.513Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "4ff2535b-3a20-45b7-8538-a6f3f3447295",
      "text": "sống được bao năm tháng là tuỳ thuộc ở Ngài.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:11.524Z",
      "updatedAt": "2025-09-03T02:21:11.524Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "bc4e3846-0a2f-48e8-a910-8bcfc1598ea3",
      "text": "Ngài định giới hạn rồi, sao có thể vượt qua !",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:11.535Z",
      "updatedAt": "2025-09-03T02:21:11.535Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "e7ca35c1-f227-4174-9312-298427799abc",
      "text": "Xin Ngài đừng để ý đến con người nữa,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:11.545Z",
      "updatedAt": "2025-09-03T02:21:11.545Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "83aee0df-acae-4917-8138-f4133ee63f7c",
      "text": "cho nó được an nhàn thư thái, và phấn khởi mừng vui",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:11.566Z",
      "updatedAt": "2025-09-03T02:21:11.566Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "94182897-9a16-4cc0-9b57-c0b65e22ceb9",
      "text": "như người làm mướn xong được một ngày.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:11.577Z",
      "updatedAt": "2025-09-03T02:21:11.577Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "97275161-b2be-4bbf-b7f4-0f907fcc6141",
      "text": "Quả vậy, đến như cây cối mà vẫn còn có niềm hy vọng,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:11.588Z",
      "updatedAt": "2025-09-03T02:21:11.588Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "fdfd80e3-36c9-464e-a8b3-8a814b9e34ea",
      "text": "bị chặt rồi, còn có thể mọc lại xanh tươi,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:11.610Z",
      "updatedAt": "2025-09-03T02:21:11.610Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "8fdc0ae4-33ac-425e-acfe-bb1701c03b09",
      "text": "và không ngớt đâm chồi nảy lộc,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:11.636Z",
      "updatedAt": "2025-09-03T02:21:11.636Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "f9dcbdbf-449f-4430-b1cb-9dc6b42f8ba0",
      "text": "dầu cho dưới đất rễ cây có già",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:11.649Z",
      "updatedAt": "2025-09-03T02:21:11.649Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "febfd4d3-f8a3-46e1-9822-fcffc94161f5",
      "text": "và gốc cây nằm chết trong cát bụi,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:11.666Z",
      "updatedAt": "2025-09-03T02:21:11.666Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "4de519f2-5226-4901-9103-788ad249780f",
      "text": "chỉ cần một ít nước là đã vội đâm chồi,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:11.679Z",
      "updatedAt": "2025-09-03T02:21:11.679Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "a49b8dde-310e-4593-a0bc-326e11fe76f6",
      "text": "nhánh vươn dài như một cây non.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:11.692Z",
      "updatedAt": "2025-09-03T02:21:11.692Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "67aeb5c8-e082-4fe4-8cf5-cce619dd09df",
      "text": "Còn con người chết là nằm bất động,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:11.704Z",
      "updatedAt": "2025-09-03T02:21:11.704Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "51cf68c6-0b38-4045-add2-0a86eb7c37dc",
      "text": "sẽ ở đâu khi tắt thở rồi ?",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:11.726Z",
      "updatedAt": "2025-09-03T02:21:11.726Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "3f6aee31-ba76-4442-ba86-04b2c3c5b8a4",
      "text": "Nước biển có thể biến mất, sông ngòi có thể cạn khô,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:11.749Z",
      "updatedAt": "2025-09-03T02:21:11.749Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "6912d17b-55ac-4a83-b6af-c26c500bf49f",
      "text": "cũng thế, con người nằm xuống ngủ yên rồi",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:11.787Z",
      "updatedAt": "2025-09-03T02:21:11.787Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "878025d6-2197-4c77-9885-9598a0570a3b",
      "text": "là không thức dậy nữa.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:11.799Z",
      "updatedAt": "2025-09-03T02:21:11.799Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "30f8d9ce-1d1d-4831-9a91-9f0bf5a57364",
      "text": "Bao lâu các tầng trời còn tồn tại,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:11.810Z",
      "updatedAt": "2025-09-03T02:21:11.810Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "06994b9f-900d-4ca9-bc83-3bb8d69f3370",
      "text": "nó vẫn không thức giấc, không tỉnh dậy, không hết ngủ say.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 3,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:11.820Z",
      "updatedAt": "2025-09-03T02:21:11.820Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "5b852d65-6011-45a1-8c02-c5f3f0bd576b",
      "text": "Ôi, giả như Ngài giấu con trong âm phủ,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:11.841Z",
      "updatedAt": "2025-09-03T02:21:11.841Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "aa4b397b-01d7-4be6-9c79-fdaab2565bf1",
      "text": "cất con ở đó cho đến lúc cơn giận Ngài nguôi,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:11.861Z",
      "updatedAt": "2025-09-03T02:21:11.861Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "8c4b87c6-8519-4877-a91f-b3293bbd1815",
      "text": "cho con một thời hạn, rồi lại nhớ đến con ?",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:11.875Z",
      "updatedAt": "2025-09-03T02:21:11.875Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "8182202a-f32c-4ef4-ac19-838525ea5cad",
      "text": "–vì đã chết rồi, làm sao con người sống lại được ?–",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:11.885Z",
      "updatedAt": "2025-09-03T02:21:11.885Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "1618bf0a-af6b-4ef1-9237-3f8579e05b74",
      "text": "Trong suốt cả thời gian khổ dịch",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:11.906Z",
      "updatedAt": "2025-09-03T02:21:11.906Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "0cf0eb84-ee86-4eba-ab7c-6cec6cb31ecc",
      "text": "con vẫn cứ đợi chờ, cho tới khi Ngài nâng con dậy.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 2,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:11.938Z",
      "updatedAt": "2025-09-03T02:21:11.938Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "7e1f45d7-f20f-471f-8b7d-0cb8f817fccc",
      "text": "Bấy giờ Ngài gọi, con sẽ xin thưa.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:11.950Z",
      "updatedAt": "2025-09-03T02:21:11.950Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "9774af32-6c3f-4b27-a80a-59b42f15ca07",
      "text": "Bởi vì Ngài những khát khao mòn mỏi",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:11.961Z",
      "updatedAt": "2025-09-03T02:21:11.961Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "645b1c1a-3766-4ae6-a9f7-33a7a6892227",
      "text": "nhìn thấy công trình do tay Ngài làm nên.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 2,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:11.974Z",
      "updatedAt": "2025-09-03T02:21:11.974Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "d6aa2f20-b401-46f1-80d6-622c6ae0aecc",
      "text": "Bây giờ Ngài đếm từng bước con đi,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:12Z",
      "updatedAt": "2025-09-03T02:21:12Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "50c44422-a2bb-4580-bb83-f32d6f893ca9",
      "text": "nhưng lúc ấy, Ngài sẽ không còn quan tâm đến tội con nữa.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:12.031Z",
      "updatedAt": "2025-09-03T02:21:12.031Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "77ea8c7e-95a3-4855-8d3c-3c279eb8ea13",
      "text": "Lúc ấy, tội ác con, Ngài sẽ niêm trong bọc,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:12.057Z",
      "updatedAt": "2025-09-03T02:21:12.057Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "75ce8077-773a-4fee-b3ca-6137b87f92a3",
      "text": "lỗi lầm con, Ngài sẽ phủ lấp đi.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:12.067Z",
      "updatedAt": "2025-09-03T02:21:12.067Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "8c92e633-d091-4013-ba08-2f196c6bdc83",
      "text": "Than ôi ! Chẳng khác chi núi sập xuống vỡ tan,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:12.097Z",
      "updatedAt": "2025-09-03T02:21:12.097Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "b863ebe9-5d85-4e83-a701-974dd184dcbc",
      "text": "đá tảng bị dời qua chỗ khác,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:12.107Z",
      "updatedAt": "2025-09-03T02:21:12.107Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "816f4d4a-8e6f-416d-be1a-ce30faa2eab7",
      "text": "chẳng khác chi nước chảy đá mòn, và mưa rào cuốn trôi cát bụi,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:12.127Z",
      "updatedAt": "2025-09-03T02:21:12.127Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "b288f3f4-1f76-4387-bf4c-e1ddeb63227e",
      "text": "cũng vậy, hy vọng của người phàm, Ngài làm tiêu tan hết.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:12.137Z",
      "updatedAt": "2025-09-03T02:21:12.137Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "e356b634-fe82-465b-ab35-79295a8ada17",
      "text": "Ngài quật cho nó ngã không dậy được, và nó phải ra đi,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:12.158Z",
      "updatedAt": "2025-09-03T02:21:12.158Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "da842c0d-f968-4576-8446-7fdbf012f744",
      "text": "Ngài làm cho mặt mày nó ra xấu xa ghê tởm,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:12.169Z",
      "updatedAt": "2025-09-03T02:21:12.169Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "38daaee8-0b8d-483a-a130-fa50124db4e6",
      "text": "rồi Ngài đuổi nó đi.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 2,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:12.179Z",
      "updatedAt": "2025-09-03T02:21:12.179Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "a61a3336-9072-48d7-8e41-c26d4eea2066",
      "text": "Con cái nó có được vẻ vang rạng rỡ, nó cũng chẳng hay ;",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:12.189Z",
      "updatedAt": "2025-09-03T02:21:12.189Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "8d00dd11-454f-44c9-9873-d0c21f09a096",
      "text": "chúng có bị khinh khi miệt thị, nó nào có biết !",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:12.209Z",
      "updatedAt": "2025-09-03T02:21:12.209Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "82ece8bf-712c-4915-a7c1-15678364432e",
      "text": "Đau đớn trong thân xác, duy một mình nó chịu,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:12.230Z",
      "updatedAt": "2025-09-03T02:21:12.230Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    },
    {
      "id": "85e9de1c-0a29-42a4-a7d7-3c4a2f75474f",
      "text": "tang tóc trong tâm hồn, chỉ một mình nó hay.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:12.241Z",
      "updatedAt": "2025-09-03T02:21:12.241Z",
      "chapterId": "fecfb7d1-8faa-4f94-ab11-8692e8f422ca"
    }
  ],
  "marks": [
    {
      "id": "f6133504-97f3-4c5c-9db9-7c4ffaa1661d",
      "content": "Ch. 14 có thể được coi như một bài thơ riêng biệt. Cung giọng giống như ch. 7, nhưng nhấn mạnh đến nỗi khốn khổ của con người và đời người vắn vỏi. Cc. 1-13 : than vãn thân phận con người nói chung, đồng hoá nỗi bất hạnh của riêng mình với nỗi bất hạnh của mọi người. Cc. 14-17 nói về riêng mình, nhưng rồi lại tổng quát hoá số phận nhân loại cc. 18-22.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
