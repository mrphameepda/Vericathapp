{
  "chapter": {
    "id": "34468c9c-17d5-4585-8c86-44ec59a0ba14",
    "number": 16,
    "createdAt": "2025-09-03T01:07:51.632Z",
    "updatedAt": "2025-09-03T01:07:51.632Z",
    "bookId": "1672a600-6214-4bc7-aaa4-9b99684355ac"
  },
  "verses": [
    {
      "id": "c8bae8e3-ae39-4d04-96ee-eb8d911d6b64",
      "text": "Bấy giờ, ông Gióp lên tiếng nói :",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:21:24.352Z",
      "updatedAt": "2025-09-03T02:21:24.352Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "1626321a-a866-4079-9129-2fe57c9902ce",
      "text": "Những điều như thế, tôi nghe đã bao lần.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:24.404Z",
      "updatedAt": "2025-09-03T02:21:24.404Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "68142d1b-b8bc-4f78-9249-34a82a6716a4",
      "text": "Các anh muốn ủi an nhưng tất cả chỉ gây thêm đau khổ.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:24.430Z",
      "updatedAt": "2025-09-03T02:21:24.430Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "2801b40f-5956-415f-9e30-e5835025578b",
      "text": "“Những lời lẽ viển vông như thế liệu đã chấm dứt chưa ?”",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:24.449Z",
      "updatedAt": "2025-09-03T02:21:24.449Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "6f027910-65a6-4f8f-a217-2da670f011a5",
      "text": "Hoặc : “Điều gì bắt anh phải trả lời thêm nữa ?”",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:24.478Z",
      "updatedAt": "2025-09-03T02:21:24.478Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "ecb4b1bd-622c-4897-99b2-40cbe0e93c76",
      "text": "Giả như các anh ở vào địa vị tôi,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:24.493Z",
      "updatedAt": "2025-09-03T02:21:24.493Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "fb82c259-2444-4345-a603-c623a1a99325",
      "text": "tôi cũng sẽ nói như các anh,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:24.522Z",
      "updatedAt": "2025-09-03T02:21:24.522Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "1d814b82-9603-4df0-940a-6acc3b661c90",
      "text": "cũng sẽ có những lời đối đáp,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:24.540Z",
      "updatedAt": "2025-09-03T02:21:24.540Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "ca75f2ab-dc59-4638-9213-e883cce1909c",
      "text": "sẽ lắc đầu mai mỉa các anh.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 3,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:24.553Z",
      "updatedAt": "2025-09-03T02:21:24.553Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "59bb8f69-d51d-47dc-a5b3-60573f3efe77",
      "text": "Tôi cũng sẽ dùng ba tấc lưỡi",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:24.596Z",
      "updatedAt": "2025-09-03T02:21:24.596Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "9f11f441-e571-46a8-bfdf-5b73f9743dd7",
      "text": "để làm cho các anh nên vững vàng,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:24.610Z",
      "updatedAt": "2025-09-03T02:21:24.610Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "064872ae-b9a9-4e2b-80f8-29617a6f54e6",
      "text": "sẽ không tiếc mấp máy đôi môi",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:24.624Z",
      "updatedAt": "2025-09-03T02:21:24.624Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "6d8c1859-4fb9-497e-a4dc-e5d2dff1db99",
      "text": "mà làm cho các anh thêm mạnh mẽ.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 3,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:24.637Z",
      "updatedAt": "2025-09-03T02:21:24.637Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "b034ca37-142b-41ef-b99f-2f52d30f5e29",
      "text": "Nếu tôi có nói, nỗi khổ của tôi vẫn khôn nguôi,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:24.650Z",
      "updatedAt": "2025-09-03T02:21:24.650Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "aa4aeed0-c072-4675-993a-64fb6025d75e",
      "text": "tôi mà nín thinh, nỗi khổ của tôi liệu có dứt ?",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:24.663Z",
      "updatedAt": "2025-09-03T02:21:24.663Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "0460f1e1-23f3-4d88-875f-cab2f98e961a",
      "text": "Nhưng giờ đây Thiên Chúa làm cho tôi kiệt quệ.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:24.675Z",
      "updatedAt": "2025-09-03T02:21:24.675Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "a5467d9a-33a0-484d-b5f1-8f9e5bb6f167",
      "text": "Phải, Ngài đã gieo kinh hoàng",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:24.687Z",
      "updatedAt": "2025-09-03T02:21:24.687Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "ede041db-279e-47ca-b3da-c9cbdc3dacf0",
      "text": "trên mọi người thân cận của con.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:24.707Z",
      "updatedAt": "2025-09-03T02:21:24.707Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "39a38e38-bf86-41fc-9134-6a244b54a6b2",
      "text": "Ngài đã để cho da con phải nhăn nheo xấu xí,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:24.729Z",
      "updatedAt": "2025-09-03T02:21:24.729Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "a2993a05-9ece-4e30-b97e-5ade5005de0b",
      "text": "đó là một bằng cớ tố cáo con ;",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:24.750Z",
      "updatedAt": "2025-09-03T02:21:24.750Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "026358ee-916a-44eb-ba1e-a65726d16335",
      "text": "và vẻ xanh xao gầy còm của thân thể",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:24.773Z",
      "updatedAt": "2025-09-03T02:21:24.773Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "67b1c684-192d-482c-a7d6-fa589be34016",
      "text": "cũng là một bằng cớ nữa tố cáo con.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 3,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:24.785Z",
      "updatedAt": "2025-09-03T02:21:24.785Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "f128eee5-c9fc-4238-ab16-34f2107de638",
      "text": "Tôi bị cơn giận của Người cấu xé và săn đuổi,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:24.799Z",
      "updatedAt": "2025-09-03T02:21:24.799Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "ac93dc96-83d0-4d80-bc38-7d098d6a800c",
      "text": "Người nghiến răng nghiến lợi doạ dẫm tôi.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:24.813Z",
      "updatedAt": "2025-09-03T02:21:24.813Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "6ee73b12-227f-48d2-bd63-a0e4d70abe40",
      "text": "Kẻ thù tôi đưa mắt nhìn tôi chòng chọc.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:24.840Z",
      "updatedAt": "2025-09-03T02:21:24.840Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "07a3e00a-5996-4203-9913-d9ce6349bf5c",
      "text": "Chúng há mồm há miệng doạ dẫm tôi, lại hè nhau chế giễu,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:24.861Z",
      "updatedAt": "2025-09-03T02:21:24.861Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "bfa10bff-5931-4daf-ab8f-62ec56ccbe68",
      "text": "cùng nhau tụ họp chống lại tôi.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:24.872Z",
      "updatedAt": "2025-09-03T02:21:24.872Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "f37670c4-a816-4a4f-acdc-51424cc4e61f",
      "text": "Thiên Chúa đã trao tôi cho bọn điên khùng,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:24.882Z",
      "updatedAt": "2025-09-03T02:21:24.882Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "a7c6cc8b-dc9e-461f-8988-2f1605f753c5",
      "text": "quẳng tôi vào tay phường gian ác.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:24.913Z",
      "updatedAt": "2025-09-03T02:21:24.913Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "9abe4d35-a86c-423d-8a43-dd16b2b88592",
      "text": "Tôi đang sống yên ổn thì Người đánh tôi,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:24.923Z",
      "updatedAt": "2025-09-03T02:21:24.923Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "f84f5fde-405b-4cc6-ad05-e2ce2b1669c7",
      "text": "nắm lấy gáy tôi mà bẻ gãy,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:24.943Z",
      "updatedAt": "2025-09-03T02:21:24.943Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "b8166db9-548a-4e3b-a268-d6640b6b9e88",
      "text": "rồi dựng tôi lên làm bia mà bắn :",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:24.953Z",
      "updatedAt": "2025-09-03T02:21:24.953Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "17092703-25ee-49dd-b991-f7c94126aa6f",
      "text": "tên nhọn của Người vây bủa lấy tôi,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:24.963Z",
      "updatedAt": "2025-09-03T02:21:24.963Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "0b68dc89-e2c3-497f-ad22-1386da0bd853",
      "text": "đâm thẳng vào lưng, không mảy may thương hại,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:24.983Z",
      "updatedAt": "2025-09-03T02:21:24.983Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "2f04a7af-3eb3-4830-9d3c-c4fc97e61f3e",
      "text": "khiến cho mật tôi đổ tràn ra đất.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:24.993Z",
      "updatedAt": "2025-09-03T02:21:24.993Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "da815fa1-07c1-4c21-ab94-c17f79218f9d",
      "text": "Rồi Người chọc thủng tôi lỗ chỗ ;",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:25.013Z",
      "updatedAt": "2025-09-03T02:21:25.013Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "3873a415-f6e7-4adb-ae72-6dd3e756c8fd",
      "text": "tựa trang chiến sĩ, Người nhảy vào đánh tôi tơi bời,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:25.044Z",
      "updatedAt": "2025-09-03T02:21:25.044Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "f38f1c0c-e15d-40db-8ad5-3b298d5993cc",
      "text": "tôi khoác lên da khô của mình tấm áo vải thô,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:25.055Z",
      "updatedAt": "2025-09-03T02:21:25.055Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "80a166ec-c280-42bf-bbec-5e4b7214daa2",
      "text": "lại vùi trán tôi trong bụi đất.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:25.076Z",
      "updatedAt": "2025-09-03T02:21:25.076Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "5499dcca-c85d-4e8a-8a6e-06c1fe2ff505",
      "text": "Khóc lóc nhiều, mặt tôi đỏ ửng,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:25.098Z",
      "updatedAt": "2025-09-03T02:21:25.098Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "4c22658d-ac85-44e6-bd19-b99c3af6228d",
      "text": "phiền muộn quá, cặp mắt thâm quầng.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:25.119Z",
      "updatedAt": "2025-09-03T02:21:25.119Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "1bf4fc66-d5f4-4f9e-b9ad-0197098acf4b",
      "text": "Thế nhưng bàn tay tôi chẳng vương bạo lực,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:25.129Z",
      "updatedAt": "2025-09-03T02:21:25.129Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "e08da30b-e109-4eb5-a4ae-5e6298735823",
      "text": "và lời cầu nguyện của tôi thật tinh tuyền.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:25.149Z",
      "updatedAt": "2025-09-03T02:21:25.149Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "0a30bb1c-4ad6-47ff-9414-a42fea1c1924",
      "text": "Đất ơi, đừng vùi lấp máu ta đi,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:25.169Z",
      "updatedAt": "2025-09-03T02:21:25.169Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "24652528-5d8f-445a-b9f8-2a9360b2ec3f",
      "text": "ước gì tiếng tôi kêu còn vọng ngân mãi mãi !",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:25.190Z",
      "updatedAt": "2025-09-03T02:21:25.190Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "68744a06-11a2-4d9c-bff3-015efb738f53",
      "text": "Ngay giờ đây trên trời, tôi đã có một nhân chứng,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:25.210Z",
      "updatedAt": "2025-09-03T02:21:25.210Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "96b0fb61-3df8-4d29-a833-0b1343f5e639",
      "text": "nơi chốn cao xanh, tôi đã có một người bảo lãnh.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:25.221Z",
      "updatedAt": "2025-09-03T02:21:25.221Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "57c41ecc-9fd1-44b9-8a20-ddfaeef8c558",
      "text": "Bạn bè của tôi chế nhạo tôi,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:25.251Z",
      "updatedAt": "2025-09-03T02:21:25.251Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "2734dc02-64fd-4e10-a38c-4432821e4723",
      "text": "nhưng tôi hướng nhìn lên Thiên Chúa, mắt đầm đìa giọt lệ.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:25.261Z",
      "updatedAt": "2025-09-03T02:21:25.261Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "78cfc920-a8c2-40d8-84a1-703429510471",
      "text": "Phải chi nhân vật kia",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:25.271Z",
      "updatedAt": "2025-09-03T02:21:25.271Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "f7584b36-df66-42f7-a5fe-5d0949b8559d",
      "text": "có thể làm trọng tài giữa con người và Thiên Chúa,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:25.281Z",
      "updatedAt": "2025-09-03T02:21:25.281Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "7376868c-c0fe-4236-b530-a2376a020c7a",
      "text": "như giữa hai con người với nhau.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 2,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:25.291Z",
      "updatedAt": "2025-09-03T02:21:25.291Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "8e41e244-33f2-40b5-a986-de0a459dbabb",
      "text": "Vì năm tháng đời tôi đã được đếm hết,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:25.301Z",
      "updatedAt": "2025-09-03T02:21:25.301Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "e68f89a1-513d-4988-b04b-54ff30d1efb2",
      "text": "con đường tôi đang đi không dẫn tôi trở lại.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:25.324Z",
      "updatedAt": "2025-09-03T02:21:25.324Z",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    }
  ],
  "marks": [
    {
      "id": "b70e8677-5033-42b1-a7f2-32b2e57ee5c3",
      "content": "English: Job | French: Job | Latin: Iob | Origin: &#1488;&#1460;&#1497;&#1468;&#64331;&#1489; | Vietnamese: Gióp -- nhân vật chính trong sách Gióp, G 1,1",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 17,
      "endOffset": 17,
      "createdAt": "2025-09-03T02:21:24.381Z",
      "updatedAt": "2025-09-03T02:21:24.381Z",
      "targetId": "c8bae8e3-ae39-4d04-96ee-eb8d911d6b64",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "cae3c1be-20af-49ff-8e71-2fc83fccc26e",
      "content": "G 15,11",
      "kind": "MARK_KIND_REFERENCE",
      "label": "1@",
      "sortOrder": 0,
      "startOffset": 32,
      "endOffset": 32,
      "createdAt": "2025-09-03T02:21:24.416Z",
      "updatedAt": "2025-09-03T02:21:24.416Z",
      "targetId": "1626321a-a866-4079-9129-2fe57c9902ce",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "53783d46-8233-4b17-a745-7b29d6743d3c",
      "content": "Đây là lần trả lời thứ bốn của ông Gióp. Trước hết, ông tức tối vì những lời trách móc và kết tội của ông Ê-li-phát (16,2-6). Những lời ấy không an ủi ông trước cơn thịnh nộ Thiên Chúa tấn công ông cách tàn bạo (16,7-16). Mặc dù ông vô tội (16,17), bỗng dưng một tia hy vọng loé lên, vì ông có chứng nhân trên trời, và có người bảo lãnh cho ông để tiếng ông kêu thấu tới trời (16,18-22). Sau đó, ông lại phàn nàn về những kẻ lên án ông (17,1-10), những kẻ an ủi giả dối (17,11-12) ; chỉ còn âm phủ chờ đợi ông (17,13-16).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 31,
      "endOffset": 31,
      "createdAt": "2025-09-03T02:21:24.392Z",
      "updatedAt": "2025-09-03T02:21:24.392Z",
      "targetId": "c8bae8e3-ae39-4d04-96ee-eb8d911d6b64",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "3b93e410-8f99-485f-a3ab-11ee16d16380",
      "content": "Mt 27,39",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:21:24.581Z",
      "updatedAt": "2025-09-03T02:21:24.581Z",
      "targetId": "ca75f2ab-dc59-4638-9213-e883cce1909c",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "52ce45dc-5e9b-429f-abe4-840da9cfe653",
      "content": "Dùng lại câu 15,2 của ông Ê-li-phát để trả lời cho ông ấy : an ủi chỉ là vu vơ.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 56,
      "endOffset": 56,
      "createdAt": "2025-09-03T02:21:24.464Z",
      "updatedAt": "2025-09-03T02:21:24.464Z",
      "targetId": "2801b40f-5956-415f-9e30-e5835025578b",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "4c9a9650-e3b7-470f-9d4c-559d2a5bd469",
      "content": "G 19,20; 33,21",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 15,
      "endOffset": 15,
      "createdAt": "2025-09-03T02:21:24.739Z",
      "updatedAt": "2025-09-03T02:21:24.739Z",
      "targetId": "39a38e38-bf86-41fc-9134-6a244b54a6b2",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "790e6fe2-5388-42fc-8b59-d1b4c2dcb293",
      "content": "Cc. 4-5 nói với cả ba người bạn.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 15,
      "endOffset": 15,
      "createdAt": "2025-09-03T02:21:24.508Z",
      "updatedAt": "2025-09-03T02:21:24.508Z",
      "targetId": "ecb4b1bd-622c-4897-99b2-40cbe0e93c76",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "6143b36e-4daf-41ec-87ef-b84b67a658b5",
      "content": "G 10,16",
      "kind": "MARK_KIND_REFERENCE",
      "label": "4@",
      "sortOrder": 3,
      "startOffset": 10,
      "endOffset": 10,
      "createdAt": "2025-09-03T02:21:24.762Z",
      "updatedAt": "2025-09-03T02:21:24.762Z",
      "targetId": "a2993a05-9ece-4e30-b97e-5ade5005de0b",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "5858b4ea-0221-4775-8a0b-9c453ed3043e",
      "content": "Hoặc là dấu cười nhạo (x. Tv 22,8 ; Hc 12,18) ; hoặc dấu chỉ sự thông cảm, thiện cảm (x. Tv 69,21 ; Is 51,19 ; Gr 15,5 ; Nk 3,7). Ở đây chắc chắn là cười chê, như Mt 27,39.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "5",
      "sortOrder": 4,
      "startOffset": 10,
      "endOffset": 10,
      "createdAt": "2025-09-03T02:21:24.568Z",
      "updatedAt": "2025-09-03T02:21:24.568Z",
      "targetId": "ca75f2ab-dc59-4638-9213-e883cce1909c",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "9b7d08b0-38cf-4298-bea6-b95ee9d6ae2e",
      "content": "G 30,1",
      "kind": "MARK_KIND_REFERENCE",
      "label": "5@",
      "sortOrder": 4,
      "startOffset": 27,
      "endOffset": 27,
      "createdAt": "2025-09-03T02:21:24.903Z",
      "updatedAt": "2025-09-03T02:21:24.903Z",
      "targetId": "f37670c4-a816-4a4f-acdc-51424cc4e61f",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "d4acd084-4da4-4b5b-87d1-b314dff1dc78",
      "content": "Cc. 7b-8 nói trực tiếp với Chúa về nỗi khổ của những người thân và chính bản thân. Có lẽ hai câu này đã bị sửa lại. Nhiều bản dịch để ngôi thứ ba nói gián tiếp.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "6",
      "sortOrder": 5,
      "startOffset": 10,
      "endOffset": 10,
      "createdAt": "2025-09-03T02:21:24.697Z",
      "updatedAt": "2025-09-03T02:21:24.697Z",
      "targetId": "a5467d9a-33a0-484d-b5f1-8f9e5bb6f167",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "9cbce242-c198-4a07-b708-68e4b70404d1",
      "content": "G 30,12-14",
      "kind": "MARK_KIND_REFERENCE",
      "label": "6@",
      "sortOrder": 5,
      "startOffset": 9,
      "endOffset": 9,
      "createdAt": "2025-09-03T02:21:24.933Z",
      "updatedAt": "2025-09-03T02:21:24.933Z",
      "targetId": "9abe4d35-a86c-423d-8a43-dd16b2b88592",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "995bff0d-c6f3-42e8-a1bd-e01463555378",
      "content": "Vợ và bạn bè của ông Gióp.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "7",
      "sortOrder": 6,
      "startOffset": 23,
      "endOffset": 23,
      "createdAt": "2025-09-03T02:21:24.718Z",
      "updatedAt": "2025-09-03T02:21:24.718Z",
      "targetId": "ede041db-279e-47ca-b3da-c9cbdc3dacf0",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "5f0c1dd4-0d17-4d04-b8bf-17b9a882770c",
      "content": "G 6,4; 7,20; 34,6",
      "kind": "MARK_KIND_REFERENCE",
      "label": "7@",
      "sortOrder": 6,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:21:24.973Z",
      "updatedAt": "2025-09-03T02:21:24.973Z",
      "targetId": "17092703-25ee-49dd-b991-f7c94126aa6f",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "60bc8d9a-8e87-4fea-b12b-39b8ef031d48",
      "content": "Nhân hoá Thiên Chúa, mô tả sự giận dữ của Thiên Chúa hành hạ ông Gióp.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "8",
      "sortOrder": 7,
      "startOffset": 28,
      "endOffset": 28,
      "createdAt": "2025-09-03T02:21:24.826Z",
      "updatedAt": "2025-09-03T02:21:24.826Z",
      "targetId": "ac93dc96-83d0-4d80-bc38-7d098d6a800c",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "5a6cfc94-ec62-4b80-89e4-12c56dd50709",
      "content": "G 10,17",
      "kind": "MARK_KIND_REFERENCE",
      "label": "8@",
      "sortOrder": 7,
      "startOffset": 10,
      "endOffset": 10,
      "createdAt": "2025-09-03T02:21:25.034Z",
      "updatedAt": "2025-09-03T02:21:25.034Z",
      "targetId": "da815fa1-07c1-4c21-ab94-c17f79218f9d",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "41ba258d-336f-4a70-887d-f13694a39b9a",
      "content": "Ở số ít, có lẽ không phải Xa-tan, không phải Thiên Chúa. Kẻ thù ở đây chỉ là một người ác nào đó.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "9",
      "sortOrder": 8,
      "startOffset": 6,
      "endOffset": 6,
      "createdAt": "2025-09-03T02:21:24.851Z",
      "updatedAt": "2025-09-03T02:21:24.851Z",
      "targetId": "6ee73b12-227f-48d2-bd63-a0e4d70abe40",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "7a33ecf9-e44d-4840-9ab1-6d731b1c63d7",
      "content": "G 16,20",
      "kind": "MARK_KIND_REFERENCE",
      "label": "9@",
      "sortOrder": 8,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:21:25.108Z",
      "updatedAt": "2025-09-03T02:21:25.108Z",
      "targetId": "5499dcca-c85d-4e8a-8a6e-06c1fe2ff505",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "b1d85693-4fc7-4b35-b094-4c5d6a54a788",
      "content": "Ông Gióp quả quyết chính Thiên Chúa chủ động làm ông khốn khổ. Người mượn tay kẻ dữ thực hiện ý muốn của Người trên ông Gióp.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "10",
      "sortOrder": 9,
      "startOffset": 10,
      "endOffset": 10,
      "createdAt": "2025-09-03T02:21:24.892Z",
      "updatedAt": "2025-09-03T02:21:24.892Z",
      "targetId": "f37670c4-a816-4a4f-acdc-51424cc4e61f",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "f89ad19c-ebf1-40a0-a77c-8e368ace859f",
      "content": "G 31,1-34",
      "kind": "MARK_KIND_REFERENCE",
      "label": "10@",
      "sortOrder": 9,
      "startOffset": 22,
      "endOffset": 22,
      "createdAt": "2025-09-03T02:21:25.139Z",
      "updatedAt": "2025-09-03T02:21:25.139Z",
      "targetId": "1bf4fc66-d5f4-4f9e-b9ad-0197098acf4b",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "e1e4d574-1d47-4be4-8bfe-1ff78af7e211",
      "content": "Đánh ai vỡ mật là cố ý đánh cho người ấy chết (x. Ac 2,11 ; Cn 7,23 ; 2 Sm 20,10).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "11",
      "sortOrder": 10,
      "startOffset": 13,
      "endOffset": 13,
      "createdAt": "2025-09-03T02:21:25.003Z",
      "updatedAt": "2025-09-03T02:21:25.003Z",
      "targetId": "2f04a7af-3eb3-4830-9d3c-c4fc97e61f3e",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "a3299448-6caf-4643-9269-34c04ad5206f",
      "content": "Kh 8,4",
      "kind": "MARK_KIND_REFERENCE",
      "label": "11@",
      "sortOrder": 10,
      "startOffset": 25,
      "endOffset": 25,
      "createdAt": "2025-09-03T02:21:25.200Z",
      "updatedAt": "2025-09-03T02:21:25.200Z",
      "targetId": "24652528-5d8f-445a-b9f8-2a9360b2ec3f",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "02a706ab-22a4-49ac-9e86-1c49ab4997cd",
      "content": "Hình ảnh này gợi lên cuộc tấn công vào pháo đài hay tường thành.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "12",
      "sortOrder": 11,
      "startOffset": 33,
      "endOffset": 33,
      "createdAt": "2025-09-03T02:21:25.023Z",
      "updatedAt": "2025-09-03T02:21:25.023Z",
      "targetId": "da815fa1-07c1-4c21-ab94-c17f79218f9d",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "dc4646b3-4733-4938-a350-297e5675cbad",
      "content": "G 19,25",
      "kind": "MARK_KIND_REFERENCE",
      "label": "12@",
      "sortOrder": 11,
      "startOffset": 33,
      "endOffset": 33,
      "createdAt": "2025-09-03T02:21:25.241Z",
      "updatedAt": "2025-09-03T02:21:25.241Z",
      "targetId": "96b0fb61-3df8-4d29-a833-0b1343f5e639",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "021ce2ee-0eac-4bae-899d-17c5a72e153d",
      "content": "*Áo vải thô* ở đây không phải là dấu chỉ tang chế hay sám hối, mà là để chuẩn bị chết (x. St 37,34 ; 1 V 21,27 ; Gr 48,37).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "13",
      "sortOrder": 12,
      "startOffset": 45,
      "endOffset": 45,
      "createdAt": "2025-09-03T02:21:25.066Z",
      "updatedAt": "2025-09-03T02:21:25.066Z",
      "targetId": "f38f1c0c-e15d-40db-8ad5-3b298d5993cc",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "bd8fbff3-a459-4344-8e44-16c9d821dc4b",
      "content": "G 10,21",
      "kind": "MARK_KIND_REFERENCE",
      "label": "13@",
      "sortOrder": 12,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:21:25.312Z",
      "updatedAt": "2025-09-03T02:21:25.312Z",
      "targetId": "8e41e244-33f2-40b5-a986-de0a459dbabb",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "61ca15cc-2986-4152-b3c0-b23a2c3be2ea",
      "content": "ds : cái sừng, tượng trưng cho sức mạnh, kiêu hãnh, phẩm giá (x. Tv 75,11 ; 89,18 ; 112,9). Ông Gióp bị thương tích vì những khổ đau tinh thần và thể xác ; ông kiệt lực chờ chết.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "14",
      "sortOrder": 13,
      "startOffset": 12,
      "endOffset": 12,
      "createdAt": "2025-09-03T02:21:25.087Z",
      "updatedAt": "2025-09-03T02:21:25.087Z",
      "targetId": "80a166ec-c280-42bf-bbec-5e4b7214daa2",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "c9553018-96e0-469c-9a3d-c318899b18ce",
      "content": "Câu này cho thấy đau khổ ông Gióp chịu không thể chứng minh là ông có tội.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "15",
      "sortOrder": 14,
      "startOffset": 41,
      "endOffset": 41,
      "createdAt": "2025-09-03T02:21:25.159Z",
      "updatedAt": "2025-09-03T02:21:25.159Z",
      "targetId": "e08da30b-e109-4eb5-a4ae-5e6298735823",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "68cbf172-9754-41cf-9c3d-42b93b7a07a5",
      "content": "Máu đổ ra đất là tiếng kêu xin báo thù (x. St 4,10 ; 37,26 ; Is 26,21 ; Ed 24,7).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "16",
      "sortOrder": 15,
      "startOffset": 24,
      "endOffset": 24,
      "createdAt": "2025-09-03T02:21:25.180Z",
      "updatedAt": "2025-09-03T02:21:25.180Z",
      "targetId": "0a30bb1c-4ad6-47ff-9414-a42fea1c1924",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "703edb47-47d7-4eea-945f-7b446ede89fd",
      "content": "Nhân chứng và người bảo lãnh là chính Thiên Chúa. Có người cho đó là lời cầu nguyện của chính ông Gióp c.18b (x. Tv 79,11 ; 88,3 ; Ac 3,44).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "17",
      "sortOrder": 16,
      "startOffset": 47,
      "endOffset": 47,
      "createdAt": "2025-09-03T02:21:25.231Z",
      "updatedAt": "2025-09-03T02:21:25.231Z",
      "targetId": "96b0fb61-3df8-4d29-a833-0b1343f5e639",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    },
    {
      "id": "5272eb72-e26e-4f4d-a6d3-bf58c484e990",
      "content": "Cuối cùng ông Gióp đành chấp nhận cái chết.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "18",
      "sortOrder": 17,
      "startOffset": 44,
      "endOffset": 44,
      "createdAt": "2025-09-03T02:21:25.336Z",
      "updatedAt": "2025-09-03T02:21:25.336Z",
      "targetId": "e68f89a1-513d-4988-b04b-54ff30d1efb2",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "34468c9c-17d5-4585-8c86-44ec59a0ba14"
    }
  ],
  "headings": [
    {
      "id": "aa564651-283c-4e72-9052-17056573e000",
      "text": "Con người không công chính còn Thiên Chúa công chính",
      "level": 1,
      "sortOrder": 0,
