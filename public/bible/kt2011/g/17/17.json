    {
      "id": "f0b69ef1-5efd-410c-af17-80fe2628d99d",
      "content": "G 42,7-8",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 23,
      "endOffset": 23,
      "createdAt": "2025-09-03T02:21:30.784Z",
      "updatedAt": "2025-09-03T02:21:30.784Z",
      "targetId": "5a81389a-fc4d-41ee-a73c-e7230a55e2c7",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "721fe2ff-9c63-43ff-a39c-30124ecb59d4",
      "content": "Cc. 3-4 diễn tả lời than trực tiếp với Thiên Chúa và hy vọng chỉ một mình Người làm trọng tài thôi.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:21:30.728Z",
      "updatedAt": "2025-09-03T02:21:30.728Z",
      "targetId": "1a887c02-977c-4c9d-8c3e-2405eb2b206c",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "e204ee5b-f7eb-4251-864c-2b37bea7581b",
      "content": "G 30,9",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 13,
      "endOffset": 13,
      "createdAt": "2025-09-03T02:21:30.884Z",
      "updatedAt": "2025-09-03T02:21:30.884Z",
      "targetId": "8e6aa92c-cbde-4b56-abac-f9e3f0586963",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "778aa4e7-6c1f-4fac-9e0f-bad5a0890949",
      "content": "Cử chỉ làm dấu bảo đảm cho một người nào (x. Cn 6,1 ; 17,18).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 36,
      "endOffset": 36,
      "createdAt": "2025-09-03T02:21:30.756Z",
      "updatedAt": "2025-09-03T02:21:30.756Z",
      "targetId": "fa46abaf-f82a-46c0-95f7-f4d113b930e9",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "f2ea93a7-35a6-473a-9638-47f83fa419d5",
      "content": "G 13,5.12",
      "kind": "MARK_KIND_REFERENCE",
      "label": "4@",
      "sortOrder": 3,
      "startOffset": 42,
      "endOffset": 42,
      "createdAt": "2025-09-03T02:21:31.065Z",
      "updatedAt": "2025-09-03T02:21:31.065Z",
      "targetId": "244bd94f-a406-4c37-8ff1-257c923b967c",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "d8ce2aad-80ce-41fa-a0aa-7f1de74ecf18",
      "content": "Câu này tối nghĩa ; tuy nhiên chúng ta hiểu rằng ông Gióp thất vọng, vì Thiên Chúa cũng không bênh vực ông, lại vào hùa với các bạn của ông mà chế nhạo.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "5",
      "sortOrder": 4,
      "startOffset": 45,
      "endOffset": 45,
      "createdAt": "2025-09-03T02:21:30.855Z",
      "updatedAt": "2025-09-03T02:21:30.855Z",
      "targetId": "0d7608d8-e72c-4e71-85a2-62c78f9ca2fb",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "205c90b1-57bd-49e0-82b0-73d1b7c8a0a7",
      "content": "G 5,17-26; 8,6-7",
      "kind": "MARK_KIND_REFERENCE",
      "label": "5@",
      "sortOrder": 4,
      "startOffset": 14,
      "endOffset": 14,
      "createdAt": "2025-09-03T02:21:31.142Z",
      "updatedAt": "2025-09-03T02:21:31.142Z",
      "targetId": "4c1262d6-a84f-4b98-afc9-ddc5aa347198",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "6efce214-824f-4bb6-acd2-98efe5d56a2d",
      "content": "Tỏ dấu lăng nhục và khinh miệt (x. Đnl 25,9 ; Mt 26,67 ; 27,30 ; Mc 10,34 ; 14,65 ; 15,19).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "6",
      "sortOrder": 5,
      "startOffset": 36,
      "endOffset": 36,
      "createdAt": "2025-09-03T02:21:30.913Z",
      "updatedAt": "2025-09-03T02:21:30.913Z",
      "targetId": "a19fe5d5-6275-4b48-9cec-711d163865f7",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "0e50327f-7d74-4678-bf23-96d0a57a71a0",
      "content": "Ga 8,12",
      "kind": "MARK_KIND_REFERENCE",
      "label": "6@",
      "sortOrder": 5,
      "startOffset": 12,
      "endOffset": 12,
      "createdAt": "2025-09-03T02:21:31.189Z",
      "updatedAt": "2025-09-03T02:21:31.189Z",
      "targetId": "a9b6bf01-2145-430e-bf25-a78716affb51",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "f596d2f8-af06-4105-ab54-da75396f530e",
      "content": "Đầy tin tưởng, ông Gióp hy vọng mình sẽ thoát chết, vì ông công chính và thanh sạch.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "7",
      "sortOrder": 6,
      "startOffset": 45,
      "endOffset": 45,
      "createdAt": "2025-09-03T02:21:31.008Z",
      "updatedAt": "2025-09-03T02:21:31.008Z",
      "targetId": "6f762301-1887-4e10-b4f0-d5d9065db516",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "c8916ca6-96d8-4af8-9593-cf57f03b788c",
      "content": "G 19,10",
      "kind": "MARK_KIND_REFERENCE",
      "label": "7@",
      "sortOrder": 6,
      "startOffset": 4,
      "endOffset": 4,
      "createdAt": "2025-09-03T02:21:31.291Z",
      "updatedAt": "2025-09-03T02:21:31.291Z",
      "targetId": "458d61d4-c10c-4ce9-a4de-58dfe8a674e3",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "af6eaeb7-4499-44da-9009-eb5020fe4749",
      "content": "Ông Gióp lại cho các bạn của mình không phải là những kẻ khôn ngoan.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "8",
      "sortOrder": 7,
      "startOffset": 7,
      "endOffset": 7,
      "createdAt": "2025-09-03T02:21:31.037Z",
      "updatedAt": "2025-09-03T02:21:31.037Z",
      "targetId": "b027d786-e724-438f-b289-eb597fbb046f",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "a87afcd3-9c2c-4dd7-8513-66c8ddb88281",
      "content": "G 20,11",
      "kind": "MARK_KIND_REFERENCE",
      "label": "8@",
      "sortOrder": 7,
      "startOffset": 32,
      "endOffset": 32,
      "createdAt": "2025-09-03T02:21:31.364Z",
      "updatedAt": "2025-09-03T02:21:31.364Z",
      "targetId": "5880f7a2-567d-4c9c-9fb4-faec7d0fe7a7",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "e1141b3a-0256-42a1-aefb-117ebec47f8c",
      "content": "Trở lại tư tưởng bi quan của chủ đề : đời người vắn vỏi, chết là hết.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "9",
      "sortOrder": 8,
      "startOffset": 57,
      "endOffset": 57,
      "createdAt": "2025-09-03T02:21:31.097Z",
      "updatedAt": "2025-09-03T02:21:31.097Z",
      "targetId": "f39f7bb1-4f33-49ca-ab8e-b0eed6a5f3b7",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "e1fd71a3-af82-4f53-b7ce-4af4baa0d469",
      "content": "Các bạn muốn an ủi, gây niềm hy vọng cho ông Gióp, là sẽ sớm chấm dứt khổ đau.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "10",
      "sortOrder": 9,
      "startOffset": 43,
      "endOffset": 43,
      "createdAt": "2025-09-03T02:21:31.174Z",
      "updatedAt": "2025-09-03T02:21:31.174Z",
      "targetId": "a9b6bf01-2145-430e-bf25-a78716affb51",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "9feaa984-0f16-4a31-948b-61ffb6e02273",
      "content": "X. Cn 7,4. Câu nói mỉa mai này nói lên phải chấp nhận cái chết.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "11",
      "sortOrder": 10,
      "startOffset": 48,
      "endOffset": 48,
      "createdAt": "2025-09-03T02:21:31.262Z",
      "updatedAt": "2025-09-03T02:21:31.262Z",
      "targetId": "7d581957-5dcd-4608-a7cf-e6285d3cc425",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "8c96a646-cf86-4582-8913-1f6236548ef1",
      "content": "Hạnh phúc và hy vọng dành cho người sống. Còn kẻ chết nơi âm phủ không còn gì cả.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "12",
      "sortOrder": 11,
      "startOffset": 28,
      "endOffset": 28,
      "createdAt": "2025-09-03T02:21:31.335Z",
      "updatedAt": "2025-09-03T02:21:31.335Z",
      "targetId": "2fc708a5-9704-4e44-b79a-ea767253a47f",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    }
  ],
