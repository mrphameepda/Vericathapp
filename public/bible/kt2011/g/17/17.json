{
  "chapter": {
    "id": "d8a69095-977f-4bdb-a648-7ce5d26f21b3",
    "number": 17,
    "createdAt": "2025-09-03T01:07:51.632Z",
    "updatedAt": "2025-09-03T01:07:51.632Z",
    "bookId": "1672a600-6214-4bc7-aaa4-9b99684355ac"
  },
  "verses": [
    {
      "id": "c96ddcd1-11e7-433f-a3a1-f77685dbf929",
      "text": "Hơi thở tôi đã cạn, ngày đời tôi đã hết,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:30.599Z",
      "updatedAt": "2025-09-03T02:21:30.599Z",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "72811fd7-f266-4ae6-a3d2-d43a967661de",
      "text": "một nấm mồ đang đợi chờ tôi.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:30.620Z",
      "updatedAt": "2025-09-03T02:21:30.620Z",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "74354c45-751b-4b85-a9d5-a5a0adfd7bd8",
      "text": "Chung quanh tôi lại chẳng phải là một đám người",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:30.642Z",
      "updatedAt": "2025-09-03T02:21:30.642Z",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "e6964a14-599b-4e63-b5a8-945533c2067a",
      "text": "ưa cười đùa chế nhạo đó sao ?",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:30.653Z",
      "updatedAt": "2025-09-03T02:21:30.653Z",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "05013d89-7627-4544-a64f-0e455132359d",
      "text": "Suốt canh khuya, mắt tôi đắm chìm trong cay đắng !",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:30.677Z",
      "updatedAt": "2025-09-03T02:21:30.677Z",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "1a887c02-977c-4c9d-8c3e-2405eb2b206c",
      "text": "Xin Ngài đứng ra bảo đảm cho con,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:30.691Z",
      "updatedAt": "2025-09-03T02:21:30.691Z",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "fa46abaf-f82a-46c0-95f7-f4d113b930e9",
      "text": "vì ngoài Ngài ra, ai nào dám đưa tay cam kết ?",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:30.742Z",
      "updatedAt": "2025-09-03T02:21:30.742Z",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "5a81389a-fc4d-41ee-a73c-e7230a55e2c7",
      "text": "Quả thật, Ngài làm cho lòng chúng ra mù tối,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:30.770Z",
      "updatedAt": "2025-09-03T02:21:30.770Z",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "e435393f-60a7-46f1-8f54-d205f9796560",
      "text": "chẳng còn nhận ra điều hay lẽ phải.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:30.799Z",
      "updatedAt": "2025-09-03T02:21:30.799Z",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "94f4c02f-4866-4bb0-9a9a-ab6479ccc38c",
      "text": "Vì vậy, Ngài không chịu để cho chúng đắc thắng.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:30.813Z",
      "updatedAt": "2025-09-03T02:21:30.813Z",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "768397d0-6486-4833-94f7-0672ca5cdc81",
      "text": "Tựa như ai đó mời bạn đến chia phần,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:30.827Z",
      "updatedAt": "2025-09-03T02:21:30.827Z",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "0d7608d8-e72c-4e71-85a2-62c78f9ca2fb",
      "text": "trong khi chính con mình lại mỏi mắt chờ mong.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:30.841Z",
      "updatedAt": "2025-09-03T02:21:30.841Z",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "8e6aa92c-cbde-4b56-abac-f9e3f0586963",
      "text": "Tôi cũng nên trò cười cho thiên hạ,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:30.869Z",
      "updatedAt": "2025-09-03T02:21:30.869Z",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "a19fe5d5-6275-4b48-9cec-711d163865f7",
      "text": "ai đưa mắt nhìn cũng phải ngoảnh mặt đi.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:30.898Z",
      "updatedAt": "2025-09-03T02:21:30.898Z",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "7a000da6-2f06-4630-8820-d2e12fda36dd",
      "text": "Mắt tôi hoen mờ vì đau khổ, toàn thân tôi chỉ còn là cái bóng.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:30.931Z",
      "updatedAt": "2025-09-03T02:21:30.931Z",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "a3ead6ad-d097-4b2c-8cc7-d8ebe19fe47f",
      "text": "Thấy cảnh này, người ngay thẳng cũng phải bàng hoàng,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:30.945Z",
      "updatedAt": "2025-09-03T02:21:30.945Z",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "446d3f47-4604-49b4-8984-0562db152974",
      "text": "người vô tội phẫn nộ với ác nhân.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:30.965Z",
      "updatedAt": "2025-09-03T02:21:30.965Z",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "87113db3-9d06-408a-a423-a1531650f249",
      "text": "Nhưng người công chính luôn giữ vững đường lối của mình,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:30.979Z",
      "updatedAt": "2025-09-03T02:21:30.979Z",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "6f762301-1887-4e10-b4f0-d5d9065db516",
      "text": "kẻ tay sạch lòng thanh sẽ được thêm sức mạnh.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:30.994Z",
      "updatedAt": "2025-09-03T02:21:30.994Z",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "b027d786-e724-438f-b289-eb597fbb046f",
      "text": "Các anh cứ trở lại, cứ đến đây,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:31.022Z",
      "updatedAt": "2025-09-03T02:21:31.022Z",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "244bd94f-a406-4c37-8ff1-257c923b967c",
      "text": "nhưng trong các anh, tôi chẳng thấy ai là khôn ngoan cả.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:31.051Z",
      "updatedAt": "2025-09-03T02:21:31.051Z",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "f39f7bb1-4f33-49ca-ab8e-b0eed6a5f3b7",
      "text": "Ngày đời tôi qua nhanh, toan tính của tôi thành mây khói,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:31.079Z",
      "updatedAt": "2025-09-03T02:21:31.079Z",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "1d546926-4b8f-4659-ae43-9401ac8eb220",
      "text": "cùng với những ước mơ tôi hằng ấp ủ.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:31.114Z",
      "updatedAt": "2025-09-03T02:21:31.114Z",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "4c1262d6-a84f-4b98-afc9-ddc5aa347198",
      "text": "Thiên hạ muốn biến đêm thành ngày,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:31.129Z",
      "updatedAt": "2025-09-03T02:21:31.129Z",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "a9b6bf01-2145-430e-bf25-a78716affb51",
      "text": "tưởng chừng bóng tối sẽ qua đi và trời sáng.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:31.159Z",
      "updatedAt": "2025-09-03T02:21:31.159Z",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "998e7f41-a046-4df6-9484-55240c900966",
      "text": "Nếu tôi hy vọng âm phủ sẽ là nhà,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:31.203Z",
      "updatedAt": "2025-09-03T02:21:31.203Z",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "2b4b28fd-8f46-40d2-93c4-85451f9a86d6",
      "text": "và tôi sẽ kê giường trong bóng tối,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:31.218Z",
      "updatedAt": "2025-09-03T02:21:31.218Z",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "de9cab04-3d83-420b-a2aa-b9d2eab19725",
      "text": "nếu tôi nhìn nấm mồ mà nói : “Đây là cha tôi !”",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:31.232Z",
      "updatedAt": "2025-09-03T02:21:31.232Z",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "7d581957-5dcd-4608-a7cf-e6285d3cc425",
      "text": "và nhìn giòi bọ : “Đây là mẹ, đây là chị tôi !”,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:31.247Z",
      "updatedAt": "2025-09-03T02:21:31.247Z",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "458d61d4-c10c-4ce9-a4de-58dfe8a674e3",
      "text": "thì hy vọng của tôi ở chỗ nào,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:31.276Z",
      "updatedAt": "2025-09-03T02:21:31.276Z",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "7af802d3-f1ab-4cb2-9be5-78f28bda2742",
      "text": "hạnh phúc của tôi, ai là người nhìn thấy ?",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:31.305Z",
      "updatedAt": "2025-09-03T02:21:31.305Z",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "2fc708a5-9704-4e44-b79a-ea767253a47f",
      "text": "Bấy giờ hạnh phúc và hy vọng có đi vào âm phủ hay chăng,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:31.320Z",
      "updatedAt": "2025-09-03T02:21:31.320Z",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    },
    {
      "id": "5880f7a2-567d-4c9c-9fb4-faec7d0fe7a7",
      "text": "khi ta cùng nhau yên nghỉ trong bụi đất ?",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:31.349Z",
      "updatedAt": "2025-09-03T02:21:31.349Z",
      "chapterId": "d8a69095-977f-4bdb-a648-7ce5d26f21b3"
    }
  ],
  "marks": [
    {
