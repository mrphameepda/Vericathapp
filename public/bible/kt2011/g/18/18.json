      "content": "Tv 18,37; Cn 4,12",
      "kind": "MARK_KIND_REFERENCE",
      "label": "4@",
      "sortOrder": 3,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:21:36.876Z",
      "updatedAt": "2025-09-03T02:21:36.876Z",
