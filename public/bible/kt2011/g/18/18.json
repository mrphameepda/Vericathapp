    {
      "id": "1c9bfd34-1c0b-4554-a0fd-73e63aba36c6",
      "content": "Cc. 7-10 : hình ảnh này diễn tả số phận kẻ ác được định sẵn.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "7",
