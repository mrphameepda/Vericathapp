{
  "chapter": {
    "id": "ac64f780-ca78-436a-9886-5360a259b03f",
    "number": 18,
    "createdAt": "2025-09-03T01:07:51.632Z",
    "updatedAt": "2025-09-03T01:07:51.632Z",
    "bookId": "1672a600-6214-4bc7-aaa4-9b99684355ac"
  },
  "verses": [
    {
      "id": "154d2e97-c407-4bca-9999-5a8febf389b0",
      "text": "Bấy giờ ông Bin-đát, người Su-ác, lên tiếng nói :",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:21:36.540Z",
      "updatedAt": "2025-09-03T02:21:36.540Z",
      "chapterId": "ac64f780-ca78-436a-9886-5360a259b03f"
    },
    {
      "id": "5fa61ba5-cb6d-451d-997c-5e3aeb9d713a",
      "text": "Đến bao giờ các anh còn nói những lời độc địa ?",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:36.617Z",
      "updatedAt": "2025-09-03T02:21:36.617Z",
      "chapterId": "ac64f780-ca78-436a-9886-5360a259b03f"
    },
    {
      "id": "cfff59c8-e123-4288-b947-707b95f354b3",
      "text": "Cứ suy nghĩ, rồi chúng tôi sẽ nói cho hay.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:36.643Z",
      "updatedAt": "2025-09-03T02:21:36.643Z",
      "chapterId": "ac64f780-ca78-436a-9886-5360a259b03f"
    },
    {
      "id": "c557478f-0cdd-4508-ab23-07fa0669555c",
      "text": "Tại sao các anh coi chúng tôi như súc vật,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:36.654Z",
      "updatedAt": "2025-09-03T02:21:36.654Z",
      "chapterId": "ac64f780-ca78-436a-9886-5360a259b03f"
    },
    {
      "id": "508afd39-a353-4c3b-b6bd-d69f62296a34",
      "text": "như những đứa thô lỗ tục tằn ?",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:36.676Z",
      "updatedAt": "2025-09-03T02:21:36.676Z",
      "chapterId": "ac64f780-ca78-436a-9886-5360a259b03f"
    },
    {
      "id": "2a4cfc75-2578-4fdf-84ee-d907fef068a2",
      "text": "Chính anh đã tự giày vò trong khi giận dữ,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:36.689Z",
      "updatedAt": "2025-09-03T02:21:36.689Z",
      "chapterId": "ac64f780-ca78-436a-9886-5360a259b03f"
    },
    {
      "id": "251a29ab-cece-495f-a5fc-8c1e7ca3da42",
      "text": "chẳng lẽ vì anh mà cả trái đất lại bị bỏ hoang",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:36.717Z",
      "updatedAt": "2025-09-03T02:21:36.717Z",
      "chapterId": "ac64f780-ca78-436a-9886-5360a259b03f"
    },
    {
      "id": "3e5a0ad9-0346-48d5-af5f-807d2b8bf915",
      "text": "và núi đá chuyển mình dời chỗ ?",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:36.731Z",
      "updatedAt": "2025-09-03T02:21:36.731Z",
      "chapterId": "ac64f780-ca78-436a-9886-5360a259b03f"
    },
    {
      "id": "a7d2e6a3-01fe-4ee9-8cc8-ca514718e0b5",
      "text": "Phải, ánh sáng của ác nhân rồi sẽ tắt,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:36.760Z",
      "updatedAt": "2025-09-03T02:21:36.760Z",
      "chapterId": "ac64f780-ca78-436a-9886-5360a259b03f"
    },
    {
      "id": "248fadef-0329-4bc4-86d5-0e2562a9bfff",
      "text": "đuốc phừng phừng của nó cũng không chiếu toả.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:36.803Z",
      "updatedAt": "2025-09-03T02:21:36.803Z",
      "chapterId": "ac64f780-ca78-436a-9886-5360a259b03f"
    },
    {
      "id": "096cf392-f576-4ea9-8c1e-4ceeb2a11609",
      "text": "Trong lều nó ở, ánh sáng thành bóng tối,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:36.818Z",
      "updatedAt": "2025-09-03T02:21:36.818Z",
      "chapterId": "ac64f780-ca78-436a-9886-5360a259b03f"
    },
    {
      "id": "c06b34fa-722c-4ac2-86ec-38b8b78297d1",
      "text": "đèn đóm cũng tắt luôn.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:36.832Z",
      "updatedAt": "2025-09-03T02:21:36.832Z",
      "chapterId": "ac64f780-ca78-436a-9886-5360a259b03f"
    },
    {
      "id": "c42dc4a5-269a-47a4-8dd4-d1ec36cc1976",
      "text": "Bước đi của nó xưa kia vững chắc, giờ đây lảo đảo,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:36.847Z",
      "updatedAt": "2025-09-03T02:21:36.847Z",
      "chapterId": "ac64f780-ca78-436a-9886-5360a259b03f"
    },
    {
      "id": "f3fb2081-ab35-4fe8-80f7-efcbba82d592",
      "text": "mưu đồ của nó làm cho nó ngả nghiêng.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:36.890Z",
      "updatedAt": "2025-09-03T02:21:36.890Z",
      "chapterId": "ac64f780-ca78-436a-9886-5360a259b03f"
    },
    {
      "id": "026e2864-fa40-460a-a9cd-6b354b4e757d",
      "text": "Bởi vì chân nó sa vào lưới, nó bước đi trên lưới đã giăng ra.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:36.905Z",
      "updatedAt": "2025-09-03T02:21:36.905Z",
      "chapterId": "ac64f780-ca78-436a-9886-5360a259b03f"
    },
    {
      "id": "aae3c1f4-ca2b-41af-a581-0453c49e7c93",
      "text": "Cạm bẫy sập xuống trúng gót chân nó,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:36.934Z",
      "updatedAt": "2025-09-03T02:21:36.934Z",
      "chapterId": "ac64f780-ca78-436a-9886-5360a259b03f"
    },
    {
      "id": "165a4682-3f18-4758-9dfe-1ca814f71e80",
      "text": "và dò lưới siết chặt thân mình.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:36.948Z",
      "updatedAt": "2025-09-03T02:21:36.948Z",
      "chapterId": "ac64f780-ca78-436a-9886-5360a259b03f"
    },
    {
      "id": "2af16f9f-1bf4-4635-a3ac-16fa0629c1c9",
      "text": "Dây bắt nó giấu ngầm dưới đất,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:36.962Z",
      "updatedAt": "2025-09-03T02:21:36.962Z",
      "chapterId": "ac64f780-ca78-436a-9886-5360a259b03f"
    },
    {
      "id": "a41b8f03-d0e8-4c79-ae5a-78cb7fc2df40",
      "text": "bẫy gài nó nằm ở trên đường.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:36.976Z",
      "updatedAt": "2025-09-03T02:21:36.976Z",
      "chapterId": "ac64f780-ca78-436a-9886-5360a259b03f"
    },
    {
      "id": "63fbca92-c635-47e6-b1bb-82ccbac24df7",
      "text": "Nó hoảng sợ vì bao nỗi kinh hoàng ập xuống từ khắp nơi,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:36.991Z",
      "updatedAt": "2025-09-03T02:21:36.991Z",
      "chapterId": "ac64f780-ca78-436a-9886-5360a259b03f"
    },
    {
      "id": "302ac3e9-60b2-453c-a032-663113e796d5",
      "text": "theo sát gót chân nó.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:37.035Z",
      "updatedAt": "2025-09-03T02:21:37.035Z",
      "chapterId": "ac64f780-ca78-436a-9886-5360a259b03f"
    },
    {
      "id": "b10f8b4b-17da-4660-9a80-ad14ed0bf43a",
      "text": "Đói khát trở nên bạn đồng hành,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:37.049Z",
      "updatedAt": "2025-09-03T02:21:37.049Z",
      "chapterId": "ac64f780-ca78-436a-9886-5360a259b03f"
    },
    {
      "id": "8fa27a3d-9394-4c8b-800f-8eef5a3c5a9b",
      "text": "tai ương không ngớt nằm bên cạnh.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:37.063Z",
      "updatedAt": "2025-09-03T02:21:37.063Z",
      "chapterId": "ac64f780-ca78-436a-9886-5360a259b03f"
    },
    {
      "id": "9649d5d7-b036-4e7a-8338-4d068a6d4304",
      "text": "Bệnh tật làm hao mòn da thịt nó,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:37.077Z",
      "updatedAt": "2025-09-03T02:21:37.077Z",
      "chapterId": "ac64f780-ca78-436a-9886-5360a259b03f"
    },
    {
      "id": "3b6ecb55-bc32-49e2-a962-9a8e30db439a",
      "text": "tử thần lấy đi nhiều phần thân thể.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:37.091Z",
      "updatedAt": "2025-09-03T02:21:37.091Z",
      "chapterId": "ac64f780-ca78-436a-9886-5360a259b03f"
    },
    {
      "id": "9260d109-c05c-4dcc-8e16-1ad8a0e7d3f4",
      "text": "Nó đã bị lôi ra khỏi lều, và hết còn được sống yên ổn,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:37.106Z",
      "updatedAt": "2025-09-03T02:21:37.106Z",
      "chapterId": "ac64f780-ca78-436a-9886-5360a259b03f"
    },
    {
      "id": "c2f6dbfc-2900-4167-b380-4ecb5b35f3fe",
      "text": "lại bị dẫn đến gặp Vua Tàn Ác.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:37.120Z",
      "updatedAt": "2025-09-03T02:21:37.120Z",
      "chapterId": "ac64f780-ca78-436a-9886-5360a259b03f"
    },
    {
      "id": "08ceeef9-cf73-4151-9a92-1be1da1e5e10",
      "text": "Người ta sẽ cư ngụ trong lều nó đã ở",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:37.163Z",
      "updatedAt": "2025-09-03T02:21:37.163Z",
      "chapterId": "ac64f780-ca78-436a-9886-5360a259b03f"
    },
    {
      "id": "87c22248-07b4-4d6c-bc6a-ea9c0102e9e8",
      "text": "nhưng nay chẳng còn thuộc về nó,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:37.177Z",
      "updatedAt": "2025-09-03T02:21:37.177Z",
      "chapterId": "ac64f780-ca78-436a-9886-5360a259b03f"
    },
    {
      "id": "9d2e2f4d-8a90-4e7c-be42-a232b823861f",
      "text": "và sẽ rắc lưu huỳnh tại nơi nó thường chăn súc vật.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 2,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:37.191Z",
      "updatedAt": "2025-09-03T02:21:37.191Z",
      "chapterId": "ac64f780-ca78-436a-9886-5360a259b03f"
    },
    {
      "id": "69371021-cbfd-4af1-8ea0-9232877bb431",
      "text": "Phía dưới, rễ héo khô, phía trên, cành bị đốn.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:37.236Z",
      "updatedAt": "2025-09-03T02:21:37.236Z",
      "chapterId": "ac64f780-ca78-436a-9886-5360a259b03f"
    },
    {
      "id": "7f67bf6a-fff1-4188-8789-de52a49d3304",
      "text": "Chẳng ai trong xứ còn nhớ đến nó nữa,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:37.250Z",
      "updatedAt": "2025-09-03T02:21:37.250Z",
      "chapterId": "ac64f780-ca78-436a-9886-5360a259b03f"
    },
    {
      "id": "e5841d3c-d52f-426b-87f4-746f9d2a1a44",
      "text": "tên nó cũng không được nhắc đến trong miền.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:37.278Z",
      "updatedAt": "2025-09-03T02:21:37.278Z",
      "chapterId": "ac64f780-ca78-436a-9886-5360a259b03f"
    },
    {
      "id": "23758671-d736-465a-b18f-003d0d7f5934",
      "text": "Nó bị tống khỏi chỗ đầy ánh sáng đến chốn tối tăm,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:37.307Z",
      "updatedAt": "2025-09-03T02:21:37.307Z",
      "chapterId": "ac64f780-ca78-436a-9886-5360a259b03f"
    },
    {
      "id": "3c599026-d752-4908-8da4-d50cfc2e3ee6",
      "text": "bị đuổi khỏi nơi có người cư ngụ.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:37.321Z",
      "updatedAt": "2025-09-03T02:21:37.321Z",
      "chapterId": "ac64f780-ca78-436a-9886-5360a259b03f"
    },
    {
      "id": "5e05ef37-ab7c-4da2-a8ff-507076bd0324",
      "text": "Trong dân mình, nó sẽ chẳng có con có cháu,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:37.336Z",
      "updatedAt": "2025-09-03T02:21:37.336Z",
      "chapterId": "ac64f780-ca78-436a-9886-5360a259b03f"
    },
    {
      "id": "75c552f0-76e7-4560-b81b-4f994088fbbd",
      "text": "tại nhà nó ở, sẽ chẳng còn sống sót một ai.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:37.378Z",
      "updatedAt": "2025-09-03T02:21:37.378Z",
      "chapterId": "ac64f780-ca78-436a-9886-5360a259b03f"
    },
    {
      "id": "6c7da621-4a9e-4ace-9041-7ed4e38d9277",
      "text": "Khi thấy nó đến ngày tận số,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:37.392Z",
      "updatedAt": "2025-09-03T02:21:37.392Z",
      "chapterId": "ac64f780-ca78-436a-9886-5360a259b03f"
    },
    {
      "id": "cf9478c3-9a38-4f72-98d4-09bcfeff379f",
      "text": "người Phương Tây kinh hoàng, người Phương Đông sợ hãi.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:37.406Z",
      "updatedAt": "2025-09-03T02:21:37.406Z",
      "chapterId": "ac64f780-ca78-436a-9886-5360a259b03f"
    },
    {
      "id": "a48ae3f8-419a-4efe-9f2a-5f5983b2830a",
      "text": "Quả thật, chỗ cư ngụ của kẻ bất công là như thế,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:37.431Z",
      "updatedAt": "2025-09-03T02:21:37.431Z",
      "chapterId": "ac64f780-ca78-436a-9886-5360a259b03f"
    },
    {
      "id": "4234f4e3-978a-402e-bf0e-4c4d7b2717fb",
      "text": "nơi sinh sống của người không biết Thiên Chúa là như vậy !",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:37.444Z",
      "updatedAt": "2025-09-03T02:21:37.444Z",
      "chapterId": "ac64f780-ca78-436a-9886-5360a259b03f"
    }
  ],
