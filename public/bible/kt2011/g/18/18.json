    },
    {
      "id": "33fc9d88-9d88-45a9-a435-844326af97be",
      "content": "Có lẽ ông Bin-đát nói với ông Gióp hơn là nói với các bạn.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 19,
      "endOffset": 19,
      "createdAt": "2025-09-03T02:21:36.629Z",
      "updatedAt": "2025-09-03T02:21:36.629Z",
