      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ac64f780-ca78-436a-9886-5360a259b03f"
    },
    {
      "id": "bc4fde48-8ac0-4165-850d-b982cb13460a",
      "content": "Tv 37,28; Is 14,22; Gr 22,30",
      "kind": "MARK_KIND_REFERENCE",
      "label": "9@",
      "sortOrder": 8,
      "startOffset": 28,
      "endOffset": 28,
