      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "1310ff7f-ed93-42a7-92b8-cac21b8adf85",
      "content": "St 11,4; Tv 37,35; Is 14,13-14",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 21,
      "endOffset": 21,
      "createdAt": "2025-09-03T02:21:49.470Z",
      "updatedAt": "2025-09-03T02:21:49.470Z",
      "targetId": "e23a9d7f-1d79-4285-ac06-1a343e2fc5a1",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "b13c0d9b-bf49-4c12-91f7-1e22d5f71dfa",
      "content": "Chương này song song với ch. 18. Cả hai đều nói về một đề tài : tiêu diệt kẻ ác. Ông Xô-pha kịch liệt chống lại niềm tin vững chắc của ông Gióp trong ch. 19. Đối lại lòng tin sống động và trưởng thành của ông Gióp, ông Xô-pha trình bày giáo lý truyền thống về thưởng phạt một cách cứng cỏi. Tóm tắt nội dung như sau : Phẫn nộ vì những lời ông Gióp vừa nói (20,2-3), ông Xô-pha dùng những lời mạnh mẽ và đầy tượng hình để tái khẳng định giáo lý cổ truyền về hạnh phúc mau qua của kẻ ác (20,4-9) và sự trừng phạt khủng khiếp không thể tránh được trên tội ác của kẻ dữ (20,10-29).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 48,
      "endOffset": 48,
      "createdAt": "2025-09-03T02:21:49.259Z",
      "updatedAt": "2025-09-03T02:21:49.259Z",
      "targetId": "691df551-eaa3-42e8-8e08-8cdb373ac089",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "70da37a0-e6ca-45d8-9cf0-8fef9a2e3038",
      "content": "Tv 73,20; Kn 5,14; Is 29,8",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 4,
      "endOffset": 4,
      "createdAt": "2025-09-03T02:21:49.534Z",
      "updatedAt": "2025-09-03T02:21:49.534Z",
      "targetId": "e6800434-4dd1-404d-a910-fad78b7631ad",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "c435fb0a-2bf3-4ebf-833d-8500ab5a524b",
      "content": "Có lẽ vì câu nói 19,22 của ông Gióp ám chỉ đến các bạn lạm dụng thân xác của ông Gióp, mà ông Xô-pha tức giận và cho đó là điều sỉ nhục, nên gay gắt trả lời thiếu bình tĩnh.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 49,
      "endOffset": 49,
      "createdAt": "2025-09-03T02:21:49.323Z",
      "updatedAt": "2025-09-03T02:21:49.323Z",
      "targetId": "705cfbf3-9949-465d-ac69-99bcfbddf25c",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "53fc6f55-5a85-41f7-b3ac-11578aa1cdc7",
      "content": "G 27,16-17",
      "kind": "MARK_KIND_REFERENCE",
      "label": "4@",
      "sortOrder": 3,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:21:49.621Z",
      "updatedAt": "2025-09-03T02:21:49.621Z",
      "targetId": "211a78d7-d3f6-41b1-bc59-f5b339f64a47",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "58da4154-e15c-4062-abb3-19cd47cd2250",
      "content": "Từ khi có loài người, đã có chân lý về thưởng phạt : ở hiền gặp lành ; ác giả ác báo.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "5",
      "sortOrder": 4,
      "startOffset": 42,
      "endOffset": 42,
      "createdAt": "2025-09-03T02:21:49.382Z",
      "updatedAt": "2025-09-03T02:21:49.382Z",
      "targetId": "70bdd883-8685-4652-9175-3a9bb917fa58",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "8a04cfc0-c99e-4bcf-924b-c4a64f38a989",
      "content": "Cn 20,17",
      "kind": "MARK_KIND_REFERENCE",
      "label": "5@",
      "sortOrder": 4,
      "startOffset": 20,
      "endOffset": 20,
      "createdAt": "2025-09-03T02:21:49.738Z",
      "updatedAt": "2025-09-03T02:21:49.738Z",
      "targetId": "1809e347-fc92-442e-b459-c37f7645c017",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "3daed854-23a6-4e7a-92f8-a0620b5b3a90",
      "content": "Đây là một trong những đề tài của văn chương khôn ngoan (x. Tv 37,2.10.20.35.36 ; 73,19-20).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "6",
      "sortOrder": 5,
      "startOffset": 53,
      "endOffset": 53,
