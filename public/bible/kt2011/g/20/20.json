    },
    {
      "id": "49d1b78a-1d2c-4f6b-8fa0-99aa9a0ed11a",
      "content": "Ám chỉ tính kiêu căng của kẻ ác.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "7",
      "sortOrder": 6,
      "startOffset": 63,
      "endOffset": 63,
      "createdAt": "2025-09-03T02:21:49.455Z",
      "updatedAt": "2025-09-03T02:21:49.455Z",
      "targetId": "e23a9d7f-1d79-4285-ac06-1a343e2fc5a1",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "02ff089e-7ebb-48d2-85af-bd1a4538cd11",
      "content": "G 29,6",
      "kind": "MARK_KIND_REFERENCE",
      "label": "7@",
      "sortOrder": 6,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:21:49.941Z",
      "updatedAt": "2025-09-03T02:21:49.941Z",
      "targetId": "6372d519-0f5b-4499-a695-c56356075061",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "a169440b-feb0-4122-a060-579314cdb763",
      "content": "X. Tv 1,4 ; 103,16.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "8",
      "sortOrder": 7,
      "startOffset": 39,
      "endOffset": 39,
      "createdAt": "2025-09-03T02:21:49.591Z",
      "updatedAt": "2025-09-03T02:21:49.591Z",
      "targetId": "b039cfd0-a3dc-4c20-8dc0-963ebab384fe",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "815aace6-3b0d-457d-a286-6a40c13a08e3",
      "content": "G 15,29",
      "kind": "MARK_KIND_REFERENCE",
      "label": "8@",
      "sortOrder": 7,
      "startOffset": 4,
      "endOffset": 4,
      "createdAt": "2025-09-03T02:21:50.114Z",
      "updatedAt": "2025-09-03T02:21:50.114Z",
      "targetId": "f453b1a2-50c9-479f-ae5f-0b9ad53d40f1",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "a46c162e-1263-4527-acce-03de45f2ce64",
      "content": "Đời cha ăn cướp, đời con phải đền. Quy luật này cho thấy trách nhiệm liên đới trong tội ác, cũng như trong hành vi tốt.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "9",
      "sortOrder": 8,
      "startOffset": 36,
      "endOffset": 36,
      "createdAt": "2025-09-03T02:21:49.650Z",
      "updatedAt": "2025-09-03T02:21:49.650Z",
      "targetId": "9b215228-2cdf-4b91-b00d-d2cbbf5fd3b5",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "6e58e671-eecb-49df-b7d3-e1dc6853971b",
      "content": "Đnl 32,41-42; Kn 5,17-23",
      "kind": "MARK_KIND_REFERENCE",
      "label": "9@",
      "sortOrder": 8,
      "startOffset": 17,
      "endOffset": 17,
      "createdAt": "2025-09-03T02:21:50.273Z",
      "updatedAt": "2025-09-03T02:21:50.273Z",
      "targetId": "c4c60afe-4d00-4148-ae00-36a74d61f855",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "c8a6684a-4287-42ce-a4e8-2cac594257cb",
      "content": "Ám chỉ tình trạng hiện thời của ông Gióp.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "10",
      "sortOrder": 9,
      "startOffset": 30,
      "endOffset": 30,
      "createdAt": "2025-09-03T02:21:49.693Z",
      "updatedAt": "2025-09-03T02:21:49.693Z",
      "targetId": "d7516730-1290-4df5-9119-ae435b5e4aae",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "67b0ea12-9fcc-4d5f-b661-8387ab7b753b",
      "content": "G 15,21",
      "kind": "MARK_KIND_REFERENCE",
      "label": "10@",
      "sortOrder": 9,
      "startOffset": 24,
      "endOffset": 24,
      "createdAt": "2025-09-03T02:21:50.347Z",
      "updatedAt": "2025-09-03T02:21:50.347Z",
      "targetId": "83b8f598-6d1d-4aec-92bb-4428b77543f3",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "3b805b97-b208-4282-a3a6-db7aa020b1a0",
      "content": "Cc. 12-14 : sự giàu có của kẻ ác như thực phẩm biến thành chất độc trong bao tử của y (x. Cn 20,17).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "11",
      "sortOrder": 10,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:21:49.722Z",
      "updatedAt": "2025-09-03T02:21:49.722Z",
      "targetId": "1809e347-fc92-442e-b459-c37f7645c017",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "7305e6b0-2b2b-4ea1-9fab-c5a1b28e3a05",
      "content": "Tv 88,16-17",
      "kind": "MARK_KIND_REFERENCE",
      "label": "11@",
      "sortOrder": 10,
      "startOffset": 4,
      "endOffset": 4,
      "createdAt": "2025-09-03T02:21:50.376Z",
      "updatedAt": "2025-09-03T02:21:50.376Z",
      "targetId": "4ac3aec8-1024-41a5-bbe1-e0d8138f0640",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "44e47af4-8a72-4a60-b6f9-590482d60907",
      "content": "Không phải Thiên Chúa bắt kẻ ác nhả của cải bất chính, mà chính kẻ ác phải muốn nhả ra, vì những của ấy hành hạ lương tâm và gây tai hoạ cho thân xác kẻ ác nữa.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "12",
      "sortOrder": 11,
      "startOffset": 35,
      "endOffset": 35,
      "createdAt": "2025-09-03T02:21:49.854Z",
      "updatedAt": "2025-09-03T02:21:49.854Z",
      "targetId": "cd8d905e-a5db-48fd-b9b5-4a09f48477a6",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "43cd95c1-81ef-4006-8f7d-09aeb86c7139",
      "content": "G 15,34",
      "kind": "MARK_KIND_REFERENCE",
      "label": "12@",
      "sortOrder": 11,
      "startOffset": 14,
      "endOffset": 14,
      "createdAt": "2025-09-03T02:21:50.446Z",
      "updatedAt": "2025-09-03T02:21:50.446Z",
      "targetId": "3057df8c-b9e4-427e-80cc-b56ec65c1704",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "e95b9883-2abe-4313-b5a7-945ab3b1165b",
      "content": "*Lưỡi rắn* chứa nọc độc (x. Tv 140,3). Xưa nay người ta vẫn quan niệm rằng miệng lưỡi kẻ gian ác giống như lưỡi rắn. Lời nói kẻ gian ác độc địa làm hại người tốt lành. Ở đây, chính kẻ gian ác chuốc hoạ vào thân : gian ác trở thành nọc độc làm hại nó.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "13",
      "sortOrder": 12,
      "startOffset": 30,
      "endOffset": 30,
      "createdAt": "2025-09-03T02:21:49.883Z",
      "updatedAt": "2025-09-03T02:21:49.883Z",
      "targetId": "62306def-6ddb-4a05-8d90-a946c8ccb991",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "97b7b712-81ad-4a47-8f17-87cd2c90d09e",
      "content": "Cn 11,4",
      "kind": "MARK_KIND_REFERENCE",
      "label": "13@",
      "sortOrder": 12,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:21:50.504Z",
      "updatedAt": "2025-09-03T02:21:50.504Z",
      "targetId": "1649b1f0-8ebd-4a61-b09a-786056e01110",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "ac388b58-41a7-4e6a-b8f1-c518a670aac1",
      "content": "*Dầu, mật, sữa chua* là những biểu tượng của giàu sang. Ở dưới 29,6 nói đến : *sữa chua, dầu* (x. Xh 3,8.17).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "14",
      "sortOrder": 13,
      "startOffset": 36,
      "endOffset": 36,
      "createdAt": "2025-09-03T02:21:49.926Z",
      "updatedAt": "2025-09-03T02:21:49.926Z",
      "targetId": "6372d519-0f5b-4499-a695-c56356075061",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "aef6c368-7421-431b-b206-2229dd113b39",
      "content": "G 27,13; Kh 21,8",
      "kind": "MARK_KIND_REFERENCE",
      "label": "14@",
      "sortOrder": 13,
      "startOffset": 6,
      "endOffset": 6,
      "createdAt": "2025-09-03T02:21:50.562Z",
      "updatedAt": "2025-09-03T02:21:50.562Z",
      "targetId": "f347e49a-fb21-4ee5-a065-e986c7d73382",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "7539633b-07bd-4ada-8eeb-c2f4d785696f",
      "content": "Xưa kia, người ta thường trao đổi hàng hoá, sản phẩm cho nhau, vì chưa biết sử dụng đến tiền bạc thay thế sự đổi chác đó.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "15",
      "sortOrder": 14,
      "startOffset": 28,
      "endOffset": 28,
      "createdAt": "2025-09-03T02:21:50.014Z",
      "updatedAt": "2025-09-03T02:21:50.014Z",
      "targetId": "95a0712b-8c6e-4646-90fe-da9a31283233",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "ad080e0b-157c-4c29-8b8a-8ad7f77d776b",
      "content": "Có nghĩa là : “Không”. Chiếm nhà của người nghèo làm của mình.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "16",
      "sortOrder": 15,
      "startOffset": 29,
      "endOffset": 29,
      "createdAt": "2025-09-03T02:21:50.072Z",
      "updatedAt": "2025-09-03T02:21:50.072Z",
      "targetId": "58677c6d-6782-46d3-921d-44a8f465af13",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "5b96adb8-3f89-4298-8325-8272592307f5",
      "content": "Tai hoạ xảy ra bất ngờ và nhanh, nên kẻ ác không thoát khỏi.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "17",
      "sortOrder": 16,
      "startOffset": 30,
      "endOffset": 30,
      "createdAt": "2025-09-03T02:21:50.188Z",
      "updatedAt": "2025-09-03T02:21:50.188Z",
      "targetId": "7bb8f63c-7cdb-42c4-a75e-85aa9c008564",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "e85fb5d1-364b-4d9d-aadf-e2ebbcd78c04",
      "content": "Thêm vào. Nói chung, các bạn tránh không nói đến Thiên Chúa hành động qua những từ ngữ không mấy tốt đẹp.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "18",
      "sortOrder": 17,
      "startOffset": 10,
      "endOffset": 10,
      "createdAt": "2025-09-03T02:21:50.215Z",
      "updatedAt": "2025-09-03T02:21:50.215Z",
      "targetId": "eea4de13-874f-46d9-a681-81d41065a96f",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "e96b24f9-eb5b-4a9b-8ef6-47c4b3837441",
      "content": "Theo G 1,16 ; 2 V 1,12 đó là *lửa* của Thiên Chúa, tức là sét.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "19",
      "sortOrder": 18,
      "startOffset": 12,
      "endOffset": 12,
      "createdAt": "2025-09-03T02:21:50.418Z",
      "updatedAt": "2025-09-03T02:21:50.418Z",
      "targetId": "36562006-7da1-4b63-afb8-78a11ff29391",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "3539f3c5-e9f9-42be-8293-4c65cf3ef0bc",
      "content": "X. Đnl 32,1 ; Is 1,2. *Trời* có thể là đại diện tập thể cho các thần ở trên trời ; *đất* ám chỉ âm phủ.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "20",
      "sortOrder": 19,
      "startOffset": 51,
      "endOffset": 51,
      "createdAt": "2025-09-03T02:21:50.475Z",
      "updatedAt": "2025-09-03T02:21:50.475Z",
      "targetId": "a7681cef-2365-41ff-ab4f-f887272e88e3",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "dad1d108-1f29-429e-91be-19c2e341878d",
      "content": "Phần gia nghiệp của kẻ gian ác là chịu trừng phạt. Câu kết luận này cũng là lời kết tội của ông Xô-pha đối với ông Gióp.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "21",
      "sortOrder": 20,
      "startOffset": 10,
      "endOffset": 10,
      "createdAt": "2025-09-03T02:21:50.548Z",
      "updatedAt": "2025-09-03T02:21:50.548Z",
      "targetId": "f347e49a-fb21-4ee5-a065-e986c7d73382",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    }
  ],
  "headings": [
    {
      "id": "8ab1d6ae-aab9-4694-9f92-cbc38b704ac1",
      "text": "Thiên Chúa công chính không miễn trừ ai",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T02:21:49.212Z",
      "updatedAt": "2025-09-03T02:21:49.212Z",
      "verseId": "691df551-eaa3-42e8-8e08-8cdb373ac089",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    }
  ],
