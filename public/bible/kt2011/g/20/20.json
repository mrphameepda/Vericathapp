{
  "chapter": {
    "id": "f4901769-e734-4fc4-b5d9-6960d489d1c2",
    "number": 20,
    "createdAt": "2025-09-03T01:07:51.632Z",
    "updatedAt": "2025-09-03T01:07:51.632Z",
    "bookId": "1672a600-6214-4bc7-aaa4-9b99684355ac"
  },
  "verses": [
    {
      "id": "691df551-eaa3-42e8-8e08-8cdb373ac089",
      "text": "Bấy giờ, ông Xô-pha người Na-a-mát lên tiếng nói :",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:21:49.194Z",
      "updatedAt": "2025-09-03T02:21:49.194Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "c695997c-accc-483f-929c-80d40002fbc0",
      "text": "Này đây những suy nghĩ của tôi thúc đẩy tôi trả lời,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:49.274Z",
      "updatedAt": "2025-09-03T02:21:49.274Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "db06c575-17c1-4983-991b-62968a0a327d",
      "text": "tâm hồn tôi thật bồn chồn lo lắng.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:49.287Z",
      "updatedAt": "2025-09-03T02:21:49.287Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "705cfbf3-9949-465d-ac69-99bcfbddf25c",
      "text": "Người ta vừa cho tôi một bài học, lại vừa nhục mạ tôi,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:49.308Z",
      "updatedAt": "2025-09-03T02:21:49.308Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "1cfff3fa-bc17-4588-bb26-abde2daf63ee",
      "text": "chính tâm trí tôi thúc đẩy tôi trả lời.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:49.339Z",
      "updatedAt": "2025-09-03T02:21:49.339Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "fc6a4339-1b3f-4e5a-83d0-4eb2b8598f54",
      "text": "Chẳng lẽ anh không biết : thời nào cũng vậy thôi",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:49.353Z",
      "updatedAt": "2025-09-03T02:21:49.353Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "70bdd883-8685-4652-9175-3a9bb917fa58",
      "text": "kể từ khi con người được đặt trên trái đất :",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:49.367Z",
      "updatedAt": "2025-09-03T02:21:49.367Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "43052980-5b34-4e61-a8e7-5263d03c6690",
      "text": "niềm vui của ác nhân thật là ngắn ngủi,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:49.397Z",
      "updatedAt": "2025-09-03T02:21:49.397Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "900284db-e43f-49c1-8f11-c5edf3849510",
      "text": "đứa vô đạo có hân hoan sung sướng, chỉ trong chốc lát thôi ?",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:49.414Z",
      "updatedAt": "2025-09-03T02:21:49.414Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "e23a9d7f-1d79-4285-ac06-1a343e2fc5a1",
      "text": "Giả như nó vươn mình lên tới trời, và đầu có chạm đến tầng mây,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:49.441Z",
      "updatedAt": "2025-09-03T02:21:49.441Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "3641e068-cc06-4539-9bae-041d888fee19",
      "text": "thì tựa bóng ma, nó sẽ tan biến đi mãi mãi,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:49.490Z",
      "updatedAt": "2025-09-03T02:21:49.490Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "73be7b47-f8d6-4711-a9b1-7f6cfb5b7875",
      "text": "ai đã nhìn thấy nó sẽ hỏi : “Nó đâu rồi !”",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:49.504Z",
      "updatedAt": "2025-09-03T02:21:49.504Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "e6800434-4dd1-404d-a910-fad78b7631ad",
      "text": "Tựa giấc mơ, nó bay đi mà không tìm lại được,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:49.519Z",
      "updatedAt": "2025-09-03T02:21:49.519Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "2c38c1db-f0f8-40c6-b2ca-2cbfed43d2da",
      "text": "nó biến mất, khác nào một thị kiến ban đêm.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:49.548Z",
      "updatedAt": "2025-09-03T02:21:49.548Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "ee61561e-869f-4edb-8845-a5e411e5c310",
      "text": "Mắt đã từng thấy nó, nay chẳng còn thấy nữa,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:49.563Z",
      "updatedAt": "2025-09-03T02:21:49.563Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "b039cfd0-a3dc-4c20-8dc0-963ebab384fe",
      "text": "nó cũng không nhìn thấy nơi nó đã ở xưa.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:49.577Z",
      "updatedAt": "2025-09-03T02:21:49.577Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "211a78d7-d3f6-41b1-bc59-f5b339f64a47",
      "text": "Con cái nó phải đền cho những kẻ bần cùng,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:49.605Z",
      "updatedAt": "2025-09-03T02:21:49.605Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "9b215228-2cdf-4b91-b00d-d2cbbf5fd3b5",
      "text": "phải tự tay trả lại của nó đã chiếm.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:49.635Z",
      "updatedAt": "2025-09-03T02:21:49.635Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "fc145aa5-d12f-4f16-bfcf-88eb98b29b53",
      "text": "Xương cốt nó xưa đầy tràn nhựa sống,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:49.665Z",
      "updatedAt": "2025-09-03T02:21:49.665Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "d7516730-1290-4df5-9119-ae435b5e4aae",
      "text": "nay phải nằm yên trên cát bụi.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:49.679Z",
      "updatedAt": "2025-09-03T02:21:49.679Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "1809e347-fc92-442e-b459-c37f7645c017",
      "text": "Nếu trong miệng nó, gian ác đã nên như kẹo ngọt",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:49.708Z",
      "updatedAt": "2025-09-03T02:21:49.708Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "bec9716c-5977-4fa5-970f-3afc3b8bbde9",
      "text": "cho nó ngậm dưới lưỡi,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:49.752Z",
      "updatedAt": "2025-09-03T02:21:49.752Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "ddeb637c-16a9-4eb3-94c8-d8bbd0234669",
      "text": "và vì tiếc của, nó không dám bỏ đi,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:49.767Z",
      "updatedAt": "2025-09-03T02:21:49.767Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "75d1cac6-4d5e-4ee7-839c-4ef8f54a5acb",
      "text": "nên đã giữ lại trong cổ họng,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:49.782Z",
      "updatedAt": "2025-09-03T02:21:49.782Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "1d267ab1-9289-40e9-8576-2983cf6a390f",
      "text": "thì sớm muộn gì trong bụng nó thức ăn sẽ biến chất",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:49.795Z",
      "updatedAt": "2025-09-03T02:21:49.795Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "8880663c-1ec5-44de-b8d8-59ad9b4971ee",
      "text": "và trở thành nọc độc giết người.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:49.810Z",
      "updatedAt": "2025-09-03T02:21:49.810Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "884255ac-f240-49e8-8ca1-8f4b4ac4eb64",
      "text": "Của cải nó đã ngốn, ắt nó phải mửa ra,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:49.824Z",
      "updatedAt": "2025-09-03T02:21:49.824Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "cd8d905e-a5db-48fd-b9b5-4a09f48477a6",
      "text": "Thiên Chúa sẽ tống ra khỏi lòng nó.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:49.838Z",
      "updatedAt": "2025-09-03T02:21:49.838Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "62306def-6ddb-4a05-8d90-a946c8ccb991",
      "text": "Nó đã bú nọc độc, thì lưỡi rắn sẽ giết nó chết.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:49.868Z",
      "updatedAt": "2025-09-03T02:21:49.868Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "6372d519-0f5b-4499-a695-c56356075061",
      "text": "Dầu chảy thành suối, mật và sữa chua đầy thung lũng,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:49.911Z",
      "updatedAt": "2025-09-03T02:21:49.911Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "d9bdb8a6-2c02-4e77-8c02-227503669ddc",
      "text": "nó sẽ chẳng còn thấy bao giờ.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:49.956Z",
      "updatedAt": "2025-09-03T02:21:49.956Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "4abaf196-49ec-437e-8628-10a7ac5a924f",
      "text": "Kết quả bao công lao khó nhọc của nó,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:49.971Z",
      "updatedAt": "2025-09-03T02:21:49.971Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "1a98146c-42ea-4254-a143-eed262c20d5b",
      "text": "nó phải hoàn trả lại mà không được hưởng dùng ;",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:49.985Z",
      "updatedAt": "2025-09-03T02:21:49.985Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "95a0712b-8c6e-4646-90fe-da9a31283233",
      "text": "những gì nó có nhờ trao đổi,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 2,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:49.999Z",
      "updatedAt": "2025-09-03T02:21:49.999Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "0f12393f-c796-4eea-beb4-31dce93c3cbb",
      "text": "nó cũng chẳng được một chút nào.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 3,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:50.028Z",
      "updatedAt": "2025-09-03T02:21:50.028Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "4d6bc818-5293-4928-ae7c-c50576250058",
      "text": "Vì nó đã hành hạ, đã bỏ rơi những người cùng khốn,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:50.043Z",
      "updatedAt": "2025-09-03T02:21:50.043Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "58677c6d-6782-46d3-921d-44a8f465af13",
      "text": "đã chiếm đoạt nhà cửa thay vì xây dựng,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:50.057Z",
      "updatedAt": "2025-09-03T02:21:50.057Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "86c67d15-c8e9-459d-927f-af478e9d475d",
      "text": "vì khát vọng của nó chẳng bao giờ thoả mãn,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:50.086Z",
      "updatedAt": "2025-09-03T02:21:50.086Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "f453b1a2-50c9-479f-ae5f-0b9ad53d40f1",
      "text": "nên kho tàng của nó không cứu nó nổi đâu.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:50.100Z",
      "updatedAt": "2025-09-03T02:21:50.100Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "aa050bfa-7215-4aa1-a0c3-2411a25e4b07",
      "text": "Chẳng ai thoát khỏi mà không bị nó cấu xé,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:50.129Z",
      "updatedAt": "2025-09-03T02:21:50.129Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "6f381764-1963-45a7-912b-654b2867198a",
      "text": "nên nó không thể thịnh đạt lâu dài.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:50.143Z",
      "updatedAt": "2025-09-03T02:21:50.143Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "3e735475-4ea3-4769-ac04-dd093cd28c36",
      "text": "Nó đang thật sung túc thì gặp phải khốn quẫn,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:50.158Z",
      "updatedAt": "2025-09-03T02:21:50.158Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "7bb8f63c-7cdb-42c4-a75e-85aa9c008564",
      "text": "mọi khốn khổ bần cùng ập xuống trên nó.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:50.173Z",
      "updatedAt": "2025-09-03T02:21:50.173Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "eea4de13-874f-46d9-a681-81d41065a96f",
      "text": "Thiên Chúa sẵn sàng làm cho nó đầy bụng,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:50.201Z",
      "updatedAt": "2025-09-03T02:21:50.201Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "28af51b5-2943-4193-a002-1240cca49fe1",
      "text": "khi giáng xuống nó cơn thịnh nộ của Người,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:50.229Z",
      "updatedAt": "2025-09-03T02:21:50.229Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "a803723d-04fa-43d5-bfa8-1f308bce39f4",
      "text": "và cho tên bắn xuống nó như mưa.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 2,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:50.244Z",
      "updatedAt": "2025-09-03T02:21:50.244Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "c4c60afe-4d00-4148-ae00-36a74d61f855",
      "text": "Nó có thoát được vũ khí bằng sắt,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:50.258Z",
      "updatedAt": "2025-09-03T02:21:50.258Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "ccf6de88-ec7e-43bb-840f-01c8ccba75a8",
      "text": "thì sẽ bị nỏ bằng đồng nhắm bắn.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:50.287Z",
      "updatedAt": "2025-09-03T02:21:50.287Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "83633f0b-8c21-4713-992b-2cf495b99390",
      "text": "Một mũi tên cắm phập vào lưng,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:50.301Z",
      "updatedAt": "2025-09-03T02:21:50.301Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "0b1a479a-ad82-4f8b-9117-654323c61a2b",
      "text": "mũi nhọn xuyên qua gan mà vẫn chói sáng,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:50.316Z",
      "updatedAt": "2025-09-03T02:21:50.316Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "83b8f598-6d1d-4aec-92bb-4428b77543f3",
      "text": "nhưng cùng lúc, bao nỗi kinh hoàng đã đến tấn công.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 2,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:50.331Z",
      "updatedAt": "2025-09-03T02:21:50.331Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "4ac3aec8-1024-41a5-bbe1-e0d8138f0640",
      "text": "Mọi tai hoạ khủng khiếp nhất",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:50.362Z",
      "updatedAt": "2025-09-03T02:21:50.362Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "4a35a5eb-7eda-42d6-b588-1dec8226b489",
      "text": "đe doạ những kho tàng nó thu tích được.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:50.390Z",
      "updatedAt": "2025-09-03T02:21:50.390Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "36562006-7da1-4b63-afb8-78a11ff29391",
      "text": "Một ngọn lửa không ai thắp lên sẽ đốt nó,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 2,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:50.405Z",
      "updatedAt": "2025-09-03T02:21:50.405Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "3057df8c-b9e4-427e-80cc-b56ec65c1704",
      "text": "thiêu rụi hết những gì còn sót trong lều nó ở.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 3,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:50.432Z",
      "updatedAt": "2025-09-03T02:21:50.432Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "a7681cef-2365-41ff-ab4f-f887272e88e3",
      "text": "Trời phơi bày tội ác nó phạm, đất nổi lên chống nó.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:50.460Z",
      "updatedAt": "2025-09-03T02:21:50.460Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "1649b1f0-8ebd-4a61-b09a-786056e01110",
      "text": "Tài sản trong nhà nó tiêu tan và trôi đi hết cả",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:50.489Z",
      "updatedAt": "2025-09-03T02:21:50.489Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "166f31ee-a4f3-42f1-be7e-9c4f0eb7681c",
      "text": "ngày Thiên Chúa nổi trận lôi đình.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 1,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:50.519Z",
      "updatedAt": "2025-09-03T02:21:50.519Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "f347e49a-fb21-4ee5-a065-e986c7d73382",
      "text": "Đó là phần Thiên Chúa dành cho đứa ác nhân,",
      "label": "29",
      "number": 29,
      "subVerseIndex": 0,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:50.533Z",
      "updatedAt": "2025-09-03T02:21:50.533Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    },
    {
      "id": "6b28896e-516d-49d8-80de-819dd508f5f1",
      "text": "là số phận Thiên Chúa định cho nó.",
      "label": "29",
      "number": 29,
      "subVerseIndex": 1,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:21:50.577Z",
      "updatedAt": "2025-09-03T02:21:50.577Z",
      "chapterId": "f4901769-e734-4fc4-b5d9-6960d489d1c2"
    }
  ],
  "marks": [
