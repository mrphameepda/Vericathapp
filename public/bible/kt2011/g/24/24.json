    {
      "id": "d25f891f-4448-43e2-9126-e737100a8a77",
      "content": "Đó là bí mật của Thiên Chúa. Đã có Luật cảnh báo con người. Do đó, phải sống lương thiện.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 55,
      "endOffset": 55,
      "createdAt": "2025-09-03T02:22:16.140Z",
