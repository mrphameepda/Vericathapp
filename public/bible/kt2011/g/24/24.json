      "targetId": "0fa8effb-43ae-4d65-b2b9-b0445abb3d3a",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
