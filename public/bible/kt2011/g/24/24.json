{
  "chapter": {
    "id": "9b68a2f5-fe52-47f2-aca1-966bb32c44df",
    "number": 24,
    "createdAt": "2025-09-03T01:07:51.632Z",
    "updatedAt": "2025-09-03T01:07:51.632Z",
    "bookId": "1672a600-6214-4bc7-aaa4-9b99684355ac"
  },
  "verses": [
    {
      "id": "6536662b-0bae-4a0e-846b-fc2c52436cc1",
      "text": "Tại sao Đấng Toàn Năng",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:16.086Z",
      "updatedAt": "2025-09-03T02:22:16.086Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "680e5a43-37d5-41b0-b482-29b282a5ab26",
      "text": "không định trước thời gian trừng phạt,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:16.115Z",
      "updatedAt": "2025-09-03T02:22:16.115Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "0fa8effb-43ae-4d65-b2b9-b0445abb3d3a",
      "text": "và những kẻ biết Người lại không thấy ngày Người xét xử ?",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:16.127Z",
      "updatedAt": "2025-09-03T02:22:16.127Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "d97656a5-2ac9-45ec-8e79-f3d57798942a",
      "text": "Phường gian ác đẩy lui lằn ranh,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:16.155Z",
      "updatedAt": "2025-09-03T02:22:16.155Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "3d8fa8bb-f360-4f3c-9344-cdb388621fa3",
      "text": "cướp bóc người chăn lẫn đàn vật.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:16.198Z",
      "updatedAt": "2025-09-03T02:22:16.198Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "794381e7-20e8-4b8c-8c4b-9c66ad8dec38",
      "text": "Lừa của cô nhi, chúng đem đi mất,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:16.213Z",
      "updatedAt": "2025-09-03T02:22:16.213Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "c6933870-7e3b-4056-98b0-4eefa99f162d",
      "text": "bò của goá phụ, giữ làm đồ cầm.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:16.241Z",
      "updatedAt": "2025-09-03T02:22:16.241Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "fb5b9ec2-5e23-4985-912c-2c710bcefcfe",
      "text": "Chúng gạt người túng thiếu ra khỏi đường đi,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:16.270Z",
      "updatedAt": "2025-09-03T02:22:16.270Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "1ca085d0-7d70-4c1d-9c2c-fdd9c258788a",
      "text": "khiến kẻ nghèo hèn trong xứ phải cùng nhau lẩn trốn.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:16.285Z",
      "updatedAt": "2025-09-03T02:22:16.285Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "76ccd1a0-bc29-4aca-9b1f-b5452acde049",
      "text": "Những người này như lừa hoang trong sa mạc,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:16.314Z",
      "updatedAt": "2025-09-03T02:22:16.314Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "e3b63fec-e8d2-4584-b41f-d3a0045c2c61",
      "text": "họ đi kiếm công ăn việc làm,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:16.343Z",
      "updatedAt": "2025-09-03T02:22:16.343Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "5948d924-9709-49de-a459-45c8c3db7fdf",
      "text": "tìm thức ăn trong sa mạc, và tìm bánh cho lũ con thơ.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:16.358Z",
      "updatedAt": "2025-09-03T02:22:16.358Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "1dda2e21-aa94-4991-bd0e-e7796be526c6",
      "text": "Giữa đêm khuya, họ gặt lúa ngoài đồng,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:16.372Z",
      "updatedAt": "2025-09-03T02:22:16.372Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "eb7675c8-abd1-450b-9915-04707604a668",
      "text": "và mót nho trong vườn của tên gian ác.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:16.401Z",
      "updatedAt": "2025-09-03T02:22:16.401Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "ad49425f-eb8c-44ef-baff-6176c75b8b0a",
      "text": "Họ ngủ đêm, mình trần không áo mặc,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:16.507Z",
      "updatedAt": "2025-09-03T02:22:16.507Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "7a600ef8-54db-47ad-8a55-9f1031ac1507",
      "text": "trời lạnh giá mà chẳng có chăn mền.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:16.535Z",
      "updatedAt": "2025-09-03T02:22:16.535Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "961b4bdf-e54b-48d3-9525-dc903f32bd5c",
      "text": "Mưa bão miền núi làm họ ướt đẫm,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:16.550Z",
      "updatedAt": "2025-09-03T02:22:16.550Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "fbb4f5fb-a002-4cf8-9eaf-b05d82ba0c8b",
      "text": "họ phải bám vào đá, vì không chỗ trú thân.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:16.564Z",
      "updatedAt": "2025-09-03T02:22:16.564Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "f65abcec-f658-44cf-8bf4-25354bbd585f",
      "text": "Phường gian ác lôi trẻ mồ côi ra khỏi bầu sữa mẹ,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:16.578Z",
      "updatedAt": "2025-09-03T02:22:16.578Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "038441b2-5529-4da9-9ed5-4d5777270d9c",
      "text": "bắt người nghèo nộp con làm của cầm.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:16.596Z",
      "updatedAt": "2025-09-03T02:22:16.596Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "a67ed39f-3358-4f7f-bee0-7ecace07e2fb",
      "text": "Họ bước đi mình trần, không áo mặc,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:16.416Z",
      "updatedAt": "2025-09-03T02:22:16.416Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "a3b88351-3986-4d2b-b24d-1b2876edc2c1",
      "text": "đói như cào mà vẫn phải vác lúa trên vai.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:16.444Z",
      "updatedAt": "2025-09-03T02:22:16.444Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "be5dd2a9-cdb6-4d04-8d46-13bd138867bb",
      "text": "Họ ép dầu giữa hai thớt đá,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:16.470Z",
      "updatedAt": "2025-09-03T02:22:16.470Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "0ea98067-d72b-4274-8325-05e3b8decd3f",
      "text": "đạp nho trong bồn mà cổ vẫn khát khô.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:16.482Z",
      "updatedAt": "2025-09-03T02:22:16.482Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "af87241c-3d61-4d68-a222-7f4346080cd5",
      "text": "Trong thành phố, người hấp hối than van,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:16.642Z",
      "updatedAt": "2025-09-03T02:22:16.642Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "63110337-dc5d-44dc-89e4-8b72f3a4994b",
      "text": "người bị trọng thương thều thào kêu cứu,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:16.657Z",
      "updatedAt": "2025-09-03T02:22:16.657Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "42d97705-62ef-47de-babd-1962905155a7",
      "text": "nhưng Thiên Chúa chẳng đoái nhận lời họ khẩn cầu.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:16.672Z",
      "updatedAt": "2025-09-03T02:22:16.672Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "7d0f8baa-cb2f-4144-9adf-e666f170a945",
      "text": "Chúng về hùa với bọn phản lại ánh sáng,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:16.722Z",
      "updatedAt": "2025-09-03T02:22:16.722Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "734c31b4-f040-456a-b7db-daeee953d883",
      "text": "đường quang minh chính đại, chúng chẳng nhận ra,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:16.764Z",
      "updatedAt": "2025-09-03T02:22:16.764Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "ae37cb5e-316a-4787-963c-8f57bbe58d70",
      "text": "cũng không bước theo nẻo chính lộ.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:16.778Z",
      "updatedAt": "2025-09-03T02:22:16.778Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "89239dc9-e0f9-44c6-9324-68dd777703d9",
      "text": "Trời chưa rạng, kẻ sát nhân đã thức giấc,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:16.793Z",
      "updatedAt": "2025-09-03T02:22:16.793Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "a57aaf68-4e40-4f49-9653-f39522c88f6f",
      "text": "nó giết hại người túng thiếu và kẻ nghèo hèn ;",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:16.808Z",
      "updatedAt": "2025-09-03T02:22:16.808Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "d10cb941-ac29-495b-8115-4c149a83f427",
      "text": "ban đêm nó như kẻ trộm đi lảng vảng.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 2,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:16.836Z",
      "updatedAt": "2025-09-03T02:22:16.836Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "12c25906-7c4b-41f5-9a0e-6830befd6717",
      "text": "Mắt kẻ ngoại tình chờ chực đêm tối,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:16.851Z",
      "updatedAt": "2025-09-03T02:22:16.851Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "072d19fa-8cd2-473f-b437-3eb4206b8b31",
      "text": "nó tự nhủ : “Chẳng ai nhìn thấy ta !”,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:16.878Z",
      "updatedAt": "2025-09-03T02:22:16.878Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "1103ab6f-5cee-4bf6-bd7d-f931ccfa7a76",
      "text": "và nó lấy khăn che mặt.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 2,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:16.896Z",
      "updatedAt": "2025-09-03T02:22:16.896Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "2460e4f3-864f-4cf6-9ebb-c5fdbee24cea",
      "text": "Trong bóng tối, kẻ trộm đục các ngôi nhà",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:16.910Z",
      "updatedAt": "2025-09-03T02:22:16.910Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "ee4bd755-26c0-4072-af59-75d4db0fc111",
      "text": "mà ban ngày nó đã đánh dấu,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:16.925Z",
      "updatedAt": "2025-09-03T02:22:16.925Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "b899b6c4-9d7c-417c-a36e-b739bbb1d240",
      "text": "không một ai trong chúng nhận ra ánh sáng mặt trời.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 2,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:16.939Z",
      "updatedAt": "2025-09-03T02:22:16.939Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "39228faf-869a-4e0c-ad40-d47f8a224996",
      "text": "Quả thật, đối với chúng, bình minh là bóng tử thần,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:16.953Z",
      "updatedAt": "2025-09-03T02:22:16.953Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "e2cf2122-3030-49d1-a8e1-60fa42f382f2",
      "text": "vì chúng đã quá quen với bóng tử thần khủng khiếp.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:16.997Z",
      "updatedAt": "2025-09-03T02:22:16.997Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "f386b5df-5860-4f38-a623-1e830f34d268",
      "text": "Trên mặt nước, nó trôi bềnh bồng,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:17.011Z",
      "updatedAt": "2025-09-03T02:22:17.011Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "2bafa6ad-c6bb-4ad7-bd99-29d53a50a621",
      "text": "trong xứ, đất đai của nó bị nguyền rủa,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:17.040Z",
      "updatedAt": "2025-09-03T02:22:17.040Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "b0f86337-d8c5-4142-94a6-c61ca7dfdfd2",
      "text": "không một ai quay lại phía vườn nho.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 2,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:17.054Z",
      "updatedAt": "2025-09-03T02:22:17.054Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "1b769a0f-7eb9-451e-beb5-2bdb7d4fe5d4",
      "text": "Hạn hán và nóng nực hút nước của tảng băng thế nào,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:17.068Z",
      "updatedAt": "2025-09-03T02:22:17.068Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "126c9460-d3e0-44b2-b566-64af7db2b8f0",
      "text": "thì âm phủ cũng hút tội nhân như vậy.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:17.082Z",
      "updatedAt": "2025-09-03T02:22:17.082Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "692223af-1d58-44e6-948a-a1a4eb50e265",
      "text": "Người mẹ xưa kia cho nó bú, nay đã quên nó rồi,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:17.109Z",
      "updatedAt": "2025-09-03T02:22:17.109Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "48c65166-8332-4cd6-ba43-e36376a3f617",
      "text": "tên tuổi nó, người ta cũng không còn nhớ nữa.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:17.137Z",
      "updatedAt": "2025-09-03T02:22:17.137Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "87672518-50d7-4161-a55b-21d79ed0ed3f",
      "text": "Sự bất công bị bẻ gãy như một cái cây.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 2,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:17.166Z",
      "updatedAt": "2025-09-03T02:22:17.166Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "99b9bec6-599d-47ad-ac99-4e7641fd94b8",
      "text": "Nó xử tệ với người son sẻ không con cái,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:17.180Z",
      "updatedAt": "2025-09-03T02:22:17.180Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "6681e919-76f4-4f5f-9e01-a7f3c4d3dba7",
      "text": "và không tử tế với người goá bụa.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:17.195Z",
      "updatedAt": "2025-09-03T02:22:17.195Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "2dc87649-ec30-434e-a39f-463b8611b9f4",
      "text": "Nhưng Đấng dùng sức mạnh lật đổ kẻ quyền hành",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:17.225Z",
      "updatedAt": "2025-09-03T02:22:17.225Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "2de01a62-2772-4bfd-aa05-dcefa58b985c",
      "text": "nay đứng lên, không cho nó tin tưởng vào cuộc đời nữa.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:17.238Z",
      "updatedAt": "2025-09-03T02:22:17.238Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "9171e762-8c41-4e86-b51d-6069dc17c84e",
      "text": "Người để cho nó sống yên hàn,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:17.252Z",
      "updatedAt": "2025-09-03T02:22:17.252Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "3705d26e-3099-430a-9cd7-7c34f40dcc3e",
      "text": "nhưng mắt Người luôn dõi theo đường nẻo nó đi.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:17.282Z",
      "updatedAt": "2025-09-03T02:22:17.282Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "76dcca56-a418-4b17-80ba-a240cd1885a4",
      "text": "Nó được đề cao trong một thời gian ngắn,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:17.311Z",
      "updatedAt": "2025-09-03T02:22:17.311Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "37db0395-e651-4382-ba34-7ec34f48cc24",
      "text": "rồi biệt tăm không còn nữa ;",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:17.326Z",
      "updatedAt": "2025-09-03T02:22:17.326Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "3e795080-fb88-4d63-8195-2bf8ecf4c648",
      "text": "nó tàn tạ như ngọn rau bị ngắt đi, và héo khô như đầu gié lúa.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 2,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:17.357Z",
      "updatedAt": "2025-09-03T02:22:17.357Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "7156d866-a07f-45b0-932b-e29195e7618b",
      "text": "Nếu không phải như vậy,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:17.374Z",
      "updatedAt": "2025-09-03T02:22:17.374Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "175d9c6f-d056-4243-b836-4e1fc7012987",
      "text": "ai có thể nói ngược lại tôi, và cho lời tôi là vô giá trị ?",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:17.389Z",
      "updatedAt": "2025-09-03T02:22:17.389Z",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    }
  ],
