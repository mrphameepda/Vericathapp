      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "c29429b7-bdc6-4f28-8761-5b2a57a6d268",
      "content": "Đoạn này song song với 21,7-17, nhưng là tiêu cực. Đoạn trên Thiên Chúa không can thiệp trừng phạt các kẻ gian ác. Đoạn này Người không cứu vớt những kẻ bị áp bức.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 6,
      "endOffset": 6,
      "createdAt": "2025-09-03T02:22:16.169Z",
      "updatedAt": "2025-09-03T02:22:16.169Z",
      "targetId": "d97656a5-2ac9-45ec-8e79-f3d57798942a",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "cb717b93-852a-4509-a578-934d8be8d4e6",
      "content": "Đnl 15,11; Cn 28,12",
      "kind": "MARK_KIND_REFERENCE",
