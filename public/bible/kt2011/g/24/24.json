    {
      "id": "eb7044c2-edc4-4608-9e68-2929275776f0",
      "content": "Gc 5,4",
      "kind": "MARK_KIND_REFERENCE",
      "label": "4@",
      "sortOrder": 3,
      "startOffset": 24,
      "endOffset": 24,
      "createdAt": "2025-09-03T02:22:16.457Z",
      "updatedAt": "2025-09-03T02:22:16.457Z",
      "targetId": "a3b88351-3986-4d2b-b24d-1b2876edc2c1",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "c3419b21-aff7-46b2-b9e1-20ad5f6402b0",
      "content": "Những người bị áp bức bị gạt ra ngoài lề xã hội.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "5",
      "sortOrder": 4,
      "startOffset": 43,
      "endOffset": 43,
      "createdAt": "2025-09-03T02:22:16.329Z",
      "updatedAt": "2025-09-03T02:22:16.329Z",
      "targetId": "76ccd1a0-bc29-4aca-9b1f-b5452acde049",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "6cf21e4b-9b9c-42ae-855b-d04b9bc3523b",
      "content": "Đnl 24,13",
      "kind": "MARK_KIND_REFERENCE",
      "label": "5@",
      "sortOrder": 4,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:22:16.522Z",
      "updatedAt": "2025-09-03T02:22:16.522Z",
      "targetId": "ad49425f-eb8c-44ef-baff-6176c75b8b0a",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "b4897bd7-8f97-4cae-9a9e-160b8f154485",
      "content": "Đói quá, họ phải gặt trộm lúa. Đó là quyền sống của họ.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "6",
      "sortOrder": 5,
      "startOffset": 26,
      "endOffset": 26,
      "createdAt": "2025-09-03T02:22:16.387Z",
      "updatedAt": "2025-09-03T02:22:16.387Z",
      "targetId": "1dda2e21-aa94-4991-bd0e-e7796be526c6",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "5735b2e7-a56b-4c3e-a5ee-68b8c71602f4",
      "content": "Am 2,6",
      "kind": "MARK_KIND_REFERENCE",
      "label": "6@",
      "sortOrder": 5,
      "startOffset": 16,
      "endOffset": 16,
      "createdAt": "2025-09-03T02:22:16.628Z",
      "updatedAt": "2025-09-03T02:22:16.628Z",
      "targetId": "038441b2-5529-4da9-9ed5-4d5777270d9c",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "53d9688e-b3c4-4578-a936-8fb9fbc83284",
      "content": "Đưa hai câu 10 và 11 lên cho hợp với mạch văn.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "7",
      "sortOrder": 6,
      "startOffset": 2,
      "endOffset": 2,
      "createdAt": "2025-09-03T02:22:16.430Z",
      "updatedAt": "2025-09-03T02:22:16.430Z",
      "targetId": "a67ed39f-3358-4f7f-bee0-7ecace07e2fb",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "49c09a8a-ad3c-46cf-a11a-35077e096abb",
      "content": "Tv 94,5-7; Gv 4,1",
      "kind": "MARK_KIND_REFERENCE",
      "label": "7@",
      "sortOrder": 6,
      "startOffset": 17,
      "endOffset": 17,
      "createdAt": "2025-09-03T02:22:16.704Z",
      "updatedAt": "2025-09-03T02:22:16.704Z",
      "targetId": "42d97705-62ef-47de-babd-1962905155a7",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "4cfd0ad6-826d-4dac-8f05-15c44c2552c6",
      "content": "Cái khổ của người nghèo là chết đói trước đống lúa, chết khát giữa dòng suối !",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "8",
      "sortOrder": 7,
      "startOffset": 37,
      "endOffset": 37,
      "createdAt": "2025-09-03T02:22:16.495Z",
      "updatedAt": "2025-09-03T02:22:16.495Z",
      "targetId": "0ea98067-d72b-4274-8325-05e3b8decd3f",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "6b613977-5367-4ad5-881b-c5b063d46081",
      "content": "Ga 3,20; Ep 5,8-14; 1 Tx 5,4-8",
      "kind": "MARK_KIND_REFERENCE",
      "label": "8@",
      "sortOrder": 7,
      "startOffset": 21,
      "endOffset": 21,
      "createdAt": "2025-09-03T02:22:16.750Z",
      "updatedAt": "2025-09-03T02:22:16.750Z",
      "targetId": "7d0f8baa-cb2f-4144-9adf-e666f170a945",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "3b388fc0-c5c6-4b06-9943-a754fdfd3861",
      "content": "Cầm con như cầm đồ vật để cứu sống gia đình. Thật đau khổ cho cha mẹ nghèo !",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "9",
      "sortOrder": 8,
      "startOffset": 35,
      "endOffset": 35,
      "createdAt": "2025-09-03T02:22:16.614Z",
      "updatedAt": "2025-09-03T02:22:16.614Z",
      "targetId": "038441b2-5529-4da9-9ed5-4d5777270d9c",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "b1ea4270-da32-4503-8583-4395d893d83d",
      "content": "Tv 10,8-9; 37,32",
      "kind": "MARK_KIND_REFERENCE",
      "label": "9@",
      "sortOrder": 8,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:22:16.823Z",
      "updatedAt": "2025-09-03T02:22:16.823Z",
      "targetId": "a57aaf68-4e40-4f49-9653-f39522c88f6f",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "271e8383-bf7c-443b-af35-ae209cf1e124",
      "content": "Bế tắc của sách Gióp cũng như của toàn bộ Cựu Ước trước đau khổ, nghèo đói, bệnh tật. Phải đợi đến Đức Giê-su mới có câu trả lời và khai thông vấn đề đau khổ (x. Ga 9,3).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "10",
      "sortOrder": 9,
      "startOffset": 48,
      "endOffset": 48,
      "createdAt": "2025-09-03T02:22:16.690Z",
      "updatedAt": "2025-09-03T02:22:16.690Z",
      "targetId": "42d97705-62ef-47de-babd-1962905155a7",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "c99c92b2-9fed-4e05-a988-c3024e5fc56c",
      "content": "Cn 7,9-10",
      "kind": "MARK_KIND_REFERENCE",
      "label": "10@",
      "sortOrder": 9,
      "startOffset": 27,
      "endOffset": 27,
      "createdAt": "2025-09-03T02:22:16.865Z",
      "updatedAt": "2025-09-03T02:22:16.865Z",
      "targetId": "12c25906-7c4b-41f5-9a0e-6830befd6717",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "7cfa0566-c20b-4ff1-88b8-182fc6064af7",
      "content": "Cc. 13-17 : ánh sáng tượng trưng cho sự tốt lành ; bóng tối biểu thị sự xấu. Ba loại người sát nhân, ngoại tình và trộm cắp, nói chung đều ghét ánh sáng, nhưng lại thích bóng tối để hoạt động (x. Ga 3,19-20 ; Ep 5,8 ; 1 Tx 5,4). Có nhiều người cho rằng ánh sáng ở đây được hiểu về Thiên Chúa là ánh sáng cho trần gian.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "11",
      "sortOrder": 10,
      "startOffset": 5,
      "endOffset": 5,
      "createdAt": "2025-09-03T02:22:16.735Z",
      "updatedAt": "2025-09-03T02:22:16.735Z",
      "targetId": "7d0f8baa-cb2f-4144-9adf-e666f170a945",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "be41cfd1-51bd-420b-b80f-769d695099f0",
      "content": "G 38,15",
      "kind": "MARK_KIND_REFERENCE",
      "label": "11@",
      "sortOrder": 10,
      "startOffset": 25,
      "endOffset": 25,
      "createdAt": "2025-09-03T02:22:16.982Z",
      "updatedAt": "2025-09-03T02:22:16.982Z",
      "targetId": "39228faf-869a-4e0c-ad40-d47f8a224996",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "4cebf383-596e-42a6-aafc-da4a1902fbc9",
      "content": "Bóng đêm là đồng loã của kẻ xấu ; còn ánh sáng là quan toà luận tội kẻ xấu.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "12",
      "sortOrder": 11,
      "startOffset": 50,
      "endOffset": 50,
      "createdAt": "2025-09-03T02:22:16.968Z",
      "updatedAt": "2025-09-03T02:22:16.968Z",
      "targetId": "39228faf-869a-4e0c-ad40-d47f8a224996",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "e9999dfb-bb85-4990-8d5f-cae2ef8715b8",
      "content": "Tv 49,15; Is 24,22",
      "kind": "MARK_KIND_REFERENCE",
      "label": "12@",
      "sortOrder": 11,
      "startOffset": 4,
      "endOffset": 4,
      "createdAt": "2025-09-03T02:22:17.096Z",
      "updatedAt": "2025-09-03T02:22:17.096Z",
      "targetId": "126c9460-d3e0-44b2-b566-64af7db2b8f0",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "7a728d3a-45af-46a9-b25e-da3438c9ba55",
      "content": "Cc. 18-24 không hợp với mạch văn ông Gióp đang nói ở trên. Tuy nhiên, kết luận là kẻ ác cuối cùng bị trừng phạt.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "13",
      "sortOrder": 12,
      "startOffset": 4,
      "endOffset": 4,
      "createdAt": "2025-09-03T02:22:17.026Z",
      "updatedAt": "2025-09-03T02:22:17.026Z",
      "targetId": "f386b5df-5860-4f38-a623-1e830f34d268",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "7585f9ff-6b90-466c-ac41-a3aba1b1902f",
      "content": "Is 26,14",
      "kind": "MARK_KIND_REFERENCE",
      "label": "13@",
      "sortOrder": 12,
      "startOffset": 37,
      "endOffset": 37,
      "createdAt": "2025-09-03T02:22:17.151Z",
      "updatedAt": "2025-09-03T02:22:17.151Z",
      "targetId": "48c65166-8332-4cd6-ba43-e36376a3f617",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "4c8140d1-522c-43ef-8604-2cc8ae9d56de",
      "content": "Người mẹ không thể nào quên được con mình sinh ra. Ở đây tác giả nhấn mạnh tính cách pháp lý hơn là thực tế : đoạn tình mẫu tử để khỏi mang nỗi nhục có đứa con gian ác.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "14",
      "sortOrder": 13,
      "startOffset": 8,
      "endOffset": 8,
      "createdAt": "2025-09-03T02:22:17.124Z",
      "updatedAt": "2025-09-03T02:22:17.124Z",
      "targetId": "692223af-1d58-44e6-948a-a1a4eb50e265",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "07e6b2c4-cb7f-4f8f-b5c2-6fd01d4fe128",
      "content": "G 29,13",
      "kind": "MARK_KIND_REFERENCE",
      "label": "14@",
      "sortOrder": 13,
      "startOffset": 25,
      "endOffset": 25,
      "createdAt": "2025-09-03T02:22:17.210Z",
      "updatedAt": "2025-09-03T02:22:17.210Z",
      "targetId": "6681e919-76f4-4f5f-9e01-a7f3c4d3dba7",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "c1294111-4739-483f-a517-d1c60ef26fc1",
      "content": "G 21,30",
      "kind": "MARK_KIND_REFERENCE",
      "label": "15@",
      "sortOrder": 14,
      "startOffset": 16,
      "endOffset": 16,
      "createdAt": "2025-09-03T02:22:17.267Z",
      "updatedAt": "2025-09-03T02:22:17.267Z",
      "targetId": "9171e762-8c41-4e86-b51d-6069dc17c84e",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "23f4a489-0ee0-49d4-921f-2130a4cf6cc0",
      "content": "Cách ăn ở của kẻ gian ác.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "15",
      "sortOrder": 14,
      "startOffset": 45,
      "endOffset": 45,
      "createdAt": "2025-09-03T02:22:17.297Z",
      "updatedAt": "2025-09-03T02:22:17.297Z",
      "targetId": "3705d26e-3099-430a-9cd7-7c34f40dcc3e",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9b68a2f5-fe52-47f2-aca1-966bb32c44df"
    },
    {
      "id": "f996428c-322a-438c-a6a3-caf6ffd8d373",
