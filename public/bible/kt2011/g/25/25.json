{
  "chapter": {
    "id": "20bdb333-2474-499d-a732-f66233f6a528",
    "number": 25,
    "createdAt": "2025-09-03T01:07:51.632Z",
    "updatedAt": "2025-09-03T01:07:51.632Z",
    "bookId": "1672a600-6214-4bc7-aaa4-9b99684355ac"
  },
  "verses": [
    {
      "id": "1c29f8bf-9885-4d07-91c6-00ce41cb4f7f",
      "text": "Bấy giờ, ông Bin-đát người Su-ác lên tiếng nói :",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:22:23.055Z",
      "updatedAt": "2025-09-03T02:22:23.055Z",
      "chapterId": "20bdb333-2474-499d-a732-f66233f6a528"
    },
    {
      "id": "8847bf27-65a8-4a58-b2dc-dff73db3aa7c",
      "text": "Thiên Chúa nắm quyền thống trị,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:23.129Z",
      "updatedAt": "2025-09-03T02:22:23.129Z",
      "chapterId": "20bdb333-2474-499d-a732-f66233f6a528"
    },
    {
      "id": "e843601f-ddf0-4887-9674-8ef6cb2ccb60",
      "text": "Người đáng kinh đáng sợ dường nào.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:23.144Z",
      "updatedAt": "2025-09-03T02:22:23.144Z",
      "chapterId": "20bdb333-2474-499d-a732-f66233f6a528"
    },
    {
      "id": "2c61e4d8-64c9-487e-a996-1ee86611d22d",
      "text": "Người thiết lập hoà bình trên cõi trời cao.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:23.159Z",
      "updatedAt": "2025-09-03T02:22:23.159Z",
      "chapterId": "20bdb333-2474-499d-a732-f66233f6a528"
    },
    {
      "id": "a0d1467c-cf2b-4af3-a633-5c2c3ac7cb21",
      "text": "Cơ binh Người, ai đếm được hết,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:23.188Z",
      "updatedAt": "2025-09-03T02:22:23.188Z",
      "chapterId": "20bdb333-2474-499d-a732-f66233f6a528"
    },
    {
      "id": "bc6c70de-6302-4e02-86a1-1b6c413d3d1d",
      "text": "ánh sáng Người, nào ai tránh nổi ?",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:23.217Z",
      "updatedAt": "2025-09-03T02:22:23.217Z",
      "chapterId": "20bdb333-2474-499d-a732-f66233f6a528"
    },
    {
      "id": "1fd8b59d-81cf-4743-987a-90f142305551",
      "text": "Trước nhan Thiên Chúa",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:23.231Z",
      "updatedAt": "2025-09-03T02:22:23.231Z",
      "chapterId": "20bdb333-2474-499d-a732-f66233f6a528"
    },
    {
      "id": "930f0a28-01d7-41d5-9a9a-60f795acd4ad",
      "text": "phàm nhân cho mình là công chính thế nào được,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:23.259Z",
      "updatedAt": "2025-09-03T02:22:23.259Z",
      "chapterId": "20bdb333-2474-499d-a732-f66233f6a528"
    },
    {
      "id": "131e06a8-3d7a-41d8-a66c-1ab965d61d43",
      "text": "và đứa con do người phụ nữ sinh ra",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:23.289Z",
      "updatedAt": "2025-09-03T02:22:23.289Z",
      "chapterId": "20bdb333-2474-499d-a732-f66233f6a528"
    },
    {
      "id": "6e735040-0b04-4fea-86a1-019c1c57dfb1",
      "text": "làm sao dám coi mình là thanh sạch ?",
      "label": "4",
      "number": 4,
      "subVerseIndex": 3,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:23.302Z",
      "updatedAt": "2025-09-03T02:22:23.302Z",
      "chapterId": "20bdb333-2474-499d-a732-f66233f6a528"
    },
    {
      "id": "67a17562-d316-4fda-9b23-160fb8b4c5f7",
      "text": "Này, trước mắt Thiên Chúa, ngay cả ánh trăng cũng lu mờ",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:23.317Z",
      "updatedAt": "2025-09-03T02:22:23.317Z",
      "chapterId": "20bdb333-2474-499d-a732-f66233f6a528"
    },
    {
      "id": "f405daaf-f3c6-4ad1-b8b1-b0e4b36528f5",
      "text": "và tinh tú cũng không thanh sạch,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:23.331Z",
      "updatedAt": "2025-09-03T02:22:23.331Z",
      "chapterId": "20bdb333-2474-499d-a732-f66233f6a528"
    },
    {
      "id": "647f7533-cc87-495b-a9c5-aecf8788a854",
      "text": "thì phương chi người phàm chẳng qua là giòi bọ",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:23.359Z",
      "updatedAt": "2025-09-03T02:22:23.359Z",
      "chapterId": "20bdb333-2474-499d-a732-f66233f6a528"
    },
    {
      "id": "e30886ca-c0f0-44b4-b7a9-2f26d6638311",
      "text": "và con người, cũng chỉ thuộc loại sâu.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:23.374Z",
      "updatedAt": "2025-09-03T02:22:23.374Z",
      "chapterId": "20bdb333-2474-499d-a732-f66233f6a528"
    }
  ],
