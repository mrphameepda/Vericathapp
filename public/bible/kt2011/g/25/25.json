      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "20bdb333-2474-499d-a732-f66233f6a528"
    },
    {
      "id": "229d34ab-a2ed-4aca-bb1b-c08d80ed8905",
      "content": "G 4,19",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 34,
