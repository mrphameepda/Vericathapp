      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "20bdb333-2474-499d-a732-f66233f6a528"
    },
    {
      "id": "1794a28a-de20-4472-bcec-ad2013dc7046",
      "content": "Cc. 4-6 lặp lại tư tưởng của ông Ê-li-phát trong 4,17-19 ; 15,14-16.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "5",
      "sortOrder": 4,
      "startOffset": 5,
      "endOffset": 5,
      "createdAt": "2025-09-03T02:22:23.244Z",
      "updatedAt": "2025-09-03T02:22:23.244Z",
      "targetId": "1fd8b59d-81cf-4743-987a-90f142305551",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "20bdb333-2474-499d-a732-f66233f6a528"
    },
    {
      "id": "833b8fc1-6e27-4708-bfe6-5d7b690c5bd9",
      "content": "Không nói đến mặt trời ở đây, giống như trong Tv 8,3-4.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "6",
