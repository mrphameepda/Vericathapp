    },
    {
      "id": "67b05c9c-9cec-4fa5-b956-5d7370fbaedb",
      "content": "Các tinh tú.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 7,
      "endOffset": 7,
      "createdAt": "2025-09-03T02:22:23.202Z",
      "updatedAt": "2025-09-03T02:22:23.202Z",
