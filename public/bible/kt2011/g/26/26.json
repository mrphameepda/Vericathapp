    {
      "id": "e5608064-3e2f-4ecf-9269-5920ca523b59",
      "content": "Quả đất được quan niệm như một cái đĩa bằng nổi trên mặt nước và có nước bao bọc.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "11",
