      "content": "Đó là gió.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "14",
      "sortOrder": 13,
      "startOffset": 13,
      "endOffset": 13,
      "createdAt": "2025-09-03T02:22:29.145Z",
