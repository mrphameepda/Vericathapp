    },
    {
      "id": "fe8c0c5b-9fdb-4cf7-9e26-a7485a6b10c0",
      "content": "1 V 22,24",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 10,
      "endOffset": 10,
      "createdAt": "2025-09-03T02:22:28.625Z",
      "updatedAt": "2025-09-03T02:22:28.625Z",
      "targetId": "b03eb49b-9c23-4466-9aae-3dc3f3e3ab14",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9e03abca-b5cf-49d4-a620-fd7f07aa1d4c"
    },
    {
      "id": "8ae08071-0a46-4b16-bc05-8b3317c9b4fe",
      "content": "Câu trả lời thứ tám của ông Gióp. Ông châm biếm ông Bin-đát là người thiếu sức mạnh và khôn ngoan.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 22,
      "endOffset": 22,
      "createdAt": "2025-09-03T02:22:28.526Z",
      "updatedAt": "2025-09-03T02:22:28.526Z",
      "targetId": "456197c5-da4c-4798-9ae5-1135fad49fee",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9e03abca-b5cf-49d4-a620-fd7f07aa1d4c"
    },
    {
      "id": "906413a0-a220-450d-af73-d1c8470da90a",
      "content": "Tv 88,11",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:22:28.697Z",
      "updatedAt": "2025-09-03T02:22:28.697Z",
      "targetId": "4eb60e21-786d-4b0a-ad0f-46f2813a922f",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9e03abca-b5cf-49d4-a620-fd7f07aa1d4c"
    },
    {
      "id": "98501074-57e9-4d09-90dd-52eed9a5cda3",
      "content": "Cc. 5-14 : nhiều người cho rằng đặt trên môi miệng của ông Bin-đát phù hợp hơn và nối ý với 25,6. Đây là đoạn mô tả đẹp nhất về vũ trụ trong các cuộc đối thoại.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 2,
      "endOffset": 2,
      "createdAt": "2025-09-03T02:22:28.668Z",
      "updatedAt": "2025-09-03T02:22:28.668Z",
      "targetId": "4eb60e21-786d-4b0a-ad0f-46f2813a922f",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9e03abca-b5cf-49d4-a620-fd7f07aa1d4c"
    },
    {
      "id": "f3034c15-b1b1-4ba9-adfe-65af1bda3153",
      "content": "Cn 15,11",
      "kind": "MARK_KIND_REFERENCE",
      "label": "4@",
      "sortOrder": 3,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:22:28.772Z",
      "updatedAt": "2025-09-03T02:22:28.772Z",
      "targetId": "176ef641-dd10-41e5-869e-c53893a12cc5",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9e03abca-b5cf-49d4-a620-fd7f07aa1d4c"
    },
    {
      "id": "e1c27aa1-b42a-44a3-9721-1306e4fd1295",
      "content": "Các cư dân trong âm phủ. Theo vũ trụ luận Do-thái, âm phủ ở dưới vực sâu có nước.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "5",
      "sortOrder": 4,
      "startOffset": 6,
