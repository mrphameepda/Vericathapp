      "targetId": "2f14025a-07b8-4be3-8b19-e5b8ef4984e7",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9e03abca-b5cf-49d4-a620-fd7f07aa1d4c"
    },
    {
      "id": "3023dd9c-edf0-41bb-8316-4eb49bc175d0",
      "content": "English: Rahab | French: Rahav | Latin: Rahab | Origin: &#1512;&#1464;&#1492;&#1463;&#1489; | Vietnamese: Ra-háp -- quái vật hỗn mang được nhân cách hóa, -- G 9,13 ; Tv 89,11",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "13",
      "sortOrder": 12,
      "startOffset": 39,
