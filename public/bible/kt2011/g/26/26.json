{
  "chapter": {
    "id": "9e03abca-b5cf-49d4-a620-fd7f07aa1d4c",
    "number": 26,
    "createdAt": "2025-09-03T01:07:51.633Z",
    "updatedAt": "2025-09-03T01:07:51.633Z",
    "bookId": "1672a600-6214-4bc7-aaa4-9b99684355ac"
  },
  "verses": [
    {
      "id": "456197c5-da4c-4798-9ae5-1135fad49fee",
      "text": "Ông Gióp lên tiếng đáp :",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:22:28.470Z",
      "updatedAt": "2025-09-03T02:22:28.470Z",
      "chapterId": "9e03abca-b5cf-49d4-a620-fd7f07aa1d4c"
    },
    {
      "id": "72d19266-871e-4320-a324-35001b42a131",
      "text": "Quả là anh bênh vực kẻ không sức lực",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:28.540Z",
      "updatedAt": "2025-09-03T02:22:28.540Z",
      "chapterId": "9e03abca-b5cf-49d4-a620-fd7f07aa1d4c"
    },
    {
      "id": "dc7f42e6-2eae-467f-9780-6ff9d42df612",
      "text": "và cứu giúp người không mạnh mẽ.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:28.569Z",
      "updatedAt": "2025-09-03T02:22:28.569Z",
      "chapterId": "9e03abca-b5cf-49d4-a620-fd7f07aa1d4c"
    },
    {
      "id": "b18c518b-dfd3-45ee-8471-8abe2ec01d5e",
      "text": "Anh bày kế cho kẻ thiếu khôn ngoan",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:28.584Z",
      "updatedAt": "2025-09-03T02:22:28.584Z",
      "chapterId": "9e03abca-b5cf-49d4-a620-fd7f07aa1d4c"
    },
    {
      "id": "96ba4bc2-5615-4ab8-b285-ed0d08112d54",
      "text": "và không tiếc lời dạy khôn cho thiên hạ.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:28.597Z",
      "updatedAt": "2025-09-03T02:22:28.597Z",
      "chapterId": "9e03abca-b5cf-49d4-a620-fd7f07aa1d4c"
    },
    {
      "id": "b03eb49b-9c23-4466-9aae-3dc3f3e3ab14",
      "text": "Nhưng anh nói những lời ấy cho ai",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:28.611Z",
      "updatedAt": "2025-09-03T02:22:28.611Z",
      "chapterId": "9e03abca-b5cf-49d4-a620-fd7f07aa1d4c"
    },
    {
      "id": "6e86fbae-c301-4592-a4d7-7c599f9efdb7",
      "text": "và ai linh hứng cho anh nói ?",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:28.640Z",
      "updatedAt": "2025-09-03T02:22:28.640Z",
      "chapterId": "9e03abca-b5cf-49d4-a620-fd7f07aa1d4c"
    },
    {
      "id": "4eb60e21-786d-4b0a-ad0f-46f2813a922f",
      "text": "Âm hồn run rẩy trong lòng đất,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:28.653Z",
      "updatedAt": "2025-09-03T02:22:28.653Z",
      "chapterId": "9e03abca-b5cf-49d4-a620-fd7f07aa1d4c"
    },
    {
      "id": "c6d4ec6e-12e9-4df3-a17f-661f6d550aa6",
      "text": "nước và dân cư dưới nước thảy khiếp kinh.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:28.713Z",
      "updatedAt": "2025-09-03T02:22:28.713Z",
      "chapterId": "9e03abca-b5cf-49d4-a620-fd7f07aa1d4c"
    },
    {
      "id": "176ef641-dd10-41e5-869e-c53893a12cc5",
      "text": "Âm phủ phơi trần trước mặt Người,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:28.744Z",
      "updatedAt": "2025-09-03T02:22:28.744Z",
      "chapterId": "9e03abca-b5cf-49d4-a620-fd7f07aa1d4c"
    },
    {
      "id": "27bb02e8-ea7c-474b-93d4-468ff602ca4c",
      "text": "âm ty không có màn che đậy.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:28.787Z",
      "updatedAt": "2025-09-03T02:22:28.787Z",
      "chapterId": "9e03abca-b5cf-49d4-a620-fd7f07aa1d4c"
    },
    {
      "id": "81c35c2b-c727-427a-95e2-12870f351b97",
      "text": "Người trải Phương Bắc trên hư không",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:28.802Z",
      "updatedAt": "2025-09-03T02:22:28.802Z",
      "chapterId": "9e03abca-b5cf-49d4-a620-fd7f07aa1d4c"
    },
    {
      "id": "e7d32cac-641d-48bf-84b5-c94180a52019",
      "text": "và treo cõi đất trên khoảng trống.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:28.816Z",
      "updatedAt": "2025-09-03T02:22:28.816Z",
      "chapterId": "9e03abca-b5cf-49d4-a620-fd7f07aa1d4c"
    },
    {
      "id": "142055d0-54ab-4f57-9e5f-da52ba67f7d3",
      "text": "Người bao bọc nước trong đám mây,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:28.850Z",
      "updatedAt": "2025-09-03T02:22:28.850Z",
      "chapterId": "9e03abca-b5cf-49d4-a620-fd7f07aa1d4c"
    },
    {
      "id": "6c8729d0-8613-4a9a-a3c8-4b3218af1cc0",
      "text": "nhưng mây không rã tan trong nước,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:28.895Z",
      "updatedAt": "2025-09-03T02:22:28.895Z",
      "chapterId": "9e03abca-b5cf-49d4-a620-fd7f07aa1d4c"
    },
    {
      "id": "28b90549-1428-4e07-b508-e92d7fb269b4",
      "text": "Người che mặt trăng rằm, trải mây lên bao phủ.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:28.910Z",
      "updatedAt": "2025-09-03T02:22:28.910Z",
      "chapterId": "9e03abca-b5cf-49d4-a620-fd7f07aa1d4c"
    },
    {
      "id": "47118f6b-430b-4491-81f7-9f45310ea4a2",
      "text": "Trên mặt nước Người đã vạch một vòng tròn",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:28.954Z",
      "updatedAt": "2025-09-03T02:22:28.954Z",
      "chapterId": "9e03abca-b5cf-49d4-a620-fd7f07aa1d4c"
    },
    {
      "id": "5095b23b-7784-4308-b2b3-899180a9160b",
      "text": "ngay tại lằn ranh giữa ánh sáng và bóng tối.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:28.995Z",
      "updatedAt": "2025-09-03T02:22:28.995Z",
      "chapterId": "9e03abca-b5cf-49d4-a620-fd7f07aa1d4c"
    },
    {
      "id": "2f14025a-07b8-4be3-8b19-e5b8ef4984e7",
      "text": "Các cột trời nghiêng ngả lung lay,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:29.009Z",
      "updatedAt": "2025-09-03T02:22:29.009Z",
      "chapterId": "9e03abca-b5cf-49d4-a620-fd7f07aa1d4c"
    },
    {
      "id": "eb960247-54e3-4b8b-a8c2-e9bc198f0da8",
      "text": "chúng sững sờ khi Người hăm doạ.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:29.039Z",
      "updatedAt": "2025-09-03T02:22:29.039Z",
      "chapterId": "9e03abca-b5cf-49d4-a620-fd7f07aa1d4c"
    },
    {
      "id": "4808ca9f-7d4e-47a3-a566-48c8b9599f07",
      "text": "Người dùng sức mạnh chặt biển khơi,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:29.059Z",
      "updatedAt": "2025-09-03T02:22:29.059Z",
      "chapterId": "9e03abca-b5cf-49d4-a620-fd7f07aa1d4c"
    },
    {
      "id": "3e976dec-f650-4aaa-bfa0-e27bb94b11c5",
      "text": "lấy trí tuệ phanh thây thuỷ thần Ra-háp.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:29.087Z",
      "updatedAt": "2025-09-03T02:22:29.087Z",
      "chapterId": "9e03abca-b5cf-49d4-a620-fd7f07aa1d4c"
    },
    {
      "id": "ebe63816-301b-4ff8-b190-9d4a6d427dea",
      "text": "Người thở hơi làm trong sáng bầu trời,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:29.131Z",
      "updatedAt": "2025-09-03T02:22:29.131Z",
      "chapterId": "9e03abca-b5cf-49d4-a620-fd7f07aa1d4c"
    },
    {
      "id": "c3b70955-1382-4d4c-b4fe-68376693c305",
      "text": "và đưa tay xả thây con rắn chui nhủi.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:29.158Z",
      "updatedAt": "2025-09-03T02:22:29.158Z",
      "chapterId": "9e03abca-b5cf-49d4-a620-fd7f07aa1d4c"
    },
    {
      "id": "86738aa0-b4b1-4ced-994e-712aa2f66d45",
      "text": "Đó là những việc chỉ nhìn được từ bên ngoài",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:29.183Z",
      "updatedAt": "2025-09-03T02:22:29.183Z",
      "chapterId": "9e03abca-b5cf-49d4-a620-fd7f07aa1d4c"
    },
    {
      "id": "95b3b77f-a0bd-491d-81e6-2944ad417cdc",
      "text": "mà chúng ta thấy phản ánh lại cách yếu ớt,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:29.216Z",
      "updatedAt": "2025-09-03T02:22:29.216Z",
      "chapterId": "9e03abca-b5cf-49d4-a620-fd7f07aa1d4c"
    },
    {
      "id": "2097f2f6-c6aa-44c2-92d0-a0b8d2a9d4dd",
      "text": "còn sức mạnh hùng vĩ của Người, nào có ai hiểu nổi ?",
      "label": "14",
      "number": 14,
      "subVerseIndex": 2,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:29.227Z",
      "updatedAt": "2025-09-03T02:22:29.227Z",
      "chapterId": "9e03abca-b5cf-49d4-a620-fd7f07aa1d4c"
    }
  ],
