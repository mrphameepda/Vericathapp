    },
    {
      "id": "7c8dc78d-d674-4530-9b0d-684721c5e530",
      "content": "Tức là những ngọn núi được đặt ở biên giới trời và đất. Các cột trời nâng đỡ vòm trời.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "12",
      "sortOrder": 11,
      "startOffset": 12,
      "endOffset": 12,
      "createdAt": "2025-09-03T02:22:29.025Z",
