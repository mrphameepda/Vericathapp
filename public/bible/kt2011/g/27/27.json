    },
    {
      "id": "a3416f0e-b886-4ce9-8399-f16d358d3dde",
      "content": "Ông Gióp lên tiếng quả quyết và thề mình vô tội hoàn toàn (x. 27,2-6) ; ông mong ước số phận kẻ gian ác giáng xuống kẻ thù của mình (x. 27,7) ; chính các bạn của ông sẽ lãnh hậu quả về những ý kiến của mình (x. 27,11-12).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 34,
      "endOffset": 34,
      "createdAt": "2025-09-03T02:22:34.466Z",
      "updatedAt": "2025-09-03T02:22:34.466Z",
      "targetId": "c2d65971-1009-484c-8b8e-ad7d96e112dc",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "8fa01113-2710-4b73-b5fc-38aa55a2d207",
      "content": "G 17,9",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 4,
      "endOffset": 4,
      "createdAt": "2025-09-03T02:22:34.740Z",
      "updatedAt": "2025-09-03T02:22:34.740Z",
      "targetId": "1bb41331-cbae-4e38-9b25-60922550b5b7",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "9aad4984-4338-4dfc-a7c8-50aff6d226f1",
      "content": "Ông Gióp long trọng thề ; dù rằng Thiên Chúa không chấp nhận ông vô tội, ông vẫn nại đến Thiên Chúa là Đấng bênh vực ông (x. 19,25).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 20,
      "endOffset": 20,
      "createdAt": "2025-09-03T02:22:34.488Z",
      "updatedAt": "2025-09-03T02:22:34.488Z",
      "targetId": "d5756fb3-c679-4a6c-b1c5-fc05a60f521f",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
