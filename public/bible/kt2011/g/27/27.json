    },
    {
      "id": "36e6a2e3-7895-4add-9ae5-597c8faf9d13",
      "content": "G 6,10",
      "kind": "MARK_KIND_REFERENCE",
      "label": "6@",
      "sortOrder": 5,
      "startOffset": 14,
      "endOffset": 14,
