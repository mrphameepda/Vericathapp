      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "269cba67-a1ed-4495-bc09-a6266bd7bf71",
      "content": "Một lần nữa, ông Gióp quả quyết sự vẹn toàn của mình. Thiên Chúa biết rõ điều đó (1,8 ; 2,3.9). Lương tâm của ông Gióp rất trong sáng.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "7",
      "sortOrder": 6,
      "startOffset": 35,
      "endOffset": 35,
      "createdAt": "2025-09-03T02:22:34.711Z",
      "updatedAt": "2025-09-03T02:22:34.711Z",
      "targetId": "ceb0a0a7-616b-4810-82cb-806f57abb1cf",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "37598120-4182-4005-a819-4bfbe7c95e85",
      "content": "G 20,29",
      "kind": "MARK_KIND_REFERENCE",
      "label": "7@",
      "sortOrder": 6,
      "startOffset": 7,
      "endOffset": 7,
      "createdAt": "2025-09-03T02:22:35.123Z",
      "updatedAt": "2025-09-03T02:22:35.123Z",
      "targetId": "9c37166c-c36e-479f-b10d-67a4a89c34ed",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "0fdb7494-b63a-46ac-934c-5b336da34ec8",
      "content": "Cc. 8-10 cho thấy khi Thiên Chúa đã giáng phạt kẻ gian ác, có cầu nguyện cũng vô ích. Vì thế ông Gióp còn tia hy vọng, bởi ông là kẻ vẹn toàn, “vững bước theo đường công chính”.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "8",
      "sortOrder": 7,
      "startOffset": 2,
      "endOffset": 2,
      "createdAt": "2025-09-03T02:22:34.827Z",
      "updatedAt": "2025-09-03T02:22:34.827Z",
      "targetId": "698b84fb-de6e-4114-bc80-b256cc925e99",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "c852b2c1-9e24-4cb0-9130-24b9ac01be2a",
      "content": "G 18,13; Gr 15,2; Gc 5,3",
      "kind": "MARK_KIND_REFERENCE",
      "label": "8@",
      "sortOrder": 7,
      "startOffset": 24,
