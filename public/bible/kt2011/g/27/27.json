      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "bf6f1d4a-0166-40b6-8d82-c2137f8d9bb9",
      "content": "G 20,10.15",
      "kind": "MARK_KIND_REFERENCE",
      "label": "9@",
      "sortOrder": 8,
      "startOffset": 12,
      "endOffset": 12,
      "createdAt": "2025-09-03T02:22:35.296Z",
      "updatedAt": "2025-09-03T02:22:35.296Z",
      "targetId": "a2f34143-8ab5-4af9-b700-484ad0a53569",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "cf82a6c7-fa76-4c3c-a4be-b91cf4aa7c31",
      "content": "Không chịu được thái độ kênh kiệu dạy đời của các bạn, ông Gióp sẽ dựa vào kinh nghiệm khôn ngoan và nhất là ý định của Thiên Chúa để dạy cho họ bài học đích đáng.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "10",
      "sortOrder": 9,
      "startOffset": 22,
      "endOffset": 22,
      "createdAt": "2025-09-03T02:22:34.978Z",
      "updatedAt": "2025-09-03T02:22:34.978Z",
      "targetId": "3f47296d-2b32-4514-a9ee-856a58cb79b1",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "2235dea8-1553-4acd-9cb2-3e107f19900c",
      "content": "G 8,14",
      "kind": "MARK_KIND_REFERENCE",
      "label": "10@",
      "sortOrder": 9,
      "startOffset": 15,
