{
  "chapter": {
    "id": "56d9c27a-6d17-4c11-a5c4-4310feca7c52",
    "number": 27,
    "createdAt": "2025-09-03T01:07:51.633Z",
    "updatedAt": "2025-09-03T01:07:51.633Z",
    "bookId": "1672a600-6214-4bc7-aaa4-9b99684355ac"
  },
  "verses": [
    {
      "id": "c2d65971-1009-484c-8b8e-ad7d96e112dc",
      "text": "Ông Gióp tiếp tục ngâm nga như sau :",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:22:34.413Z",
      "updatedAt": "2025-09-03T02:22:34.413Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "d5756fb3-c679-4a6c-b1c5-fc05a60f521f",
      "text": "Nhân danh Thiên Chúa,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:34.477Z",
      "updatedAt": "2025-09-03T02:22:34.477Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "2b33c82e-fdf3-4a67-b070-59b8db7a7cef",
      "text": "Đấng không nhận tôi là người công chính,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:34.501Z",
      "updatedAt": "2025-09-03T02:22:34.501Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "316a5eb6-1ab3-4571-994e-12c0e07cfc54",
      "text": "và nhân danh Đấng Toàn Năng,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:34.529Z",
      "updatedAt": "2025-09-03T02:22:34.529Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "f9c8c696-e084-4f9e-b573-fad0b9b1a5d2",
      "text": "Đấng làm cho hồn tôi phải cay đắng ngậm ngùi,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 3,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:34.559Z",
      "updatedAt": "2025-09-03T02:22:34.559Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "0df79426-9468-4312-b1c9-7792859b906b",
      "text": "tôi xin thề : bao lâu tôi còn chút hơi thở,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:34.573Z",
      "updatedAt": "2025-09-03T02:22:34.573Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "b4407d3a-63be-4e9b-9a86-5322ab589345",
      "text": "bao lâu sinh khí Thiên Chúa còn ở trong tôi,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:34.623Z",
      "updatedAt": "2025-09-03T02:22:34.623Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "aeef0675-7b17-4ba2-bf9a-4ddd94844bf9",
      "text": "môi tôi sẽ không nói điều xảo trá,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:34.638Z",
      "updatedAt": "2025-09-03T02:22:34.638Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "6a6935a4-35d4-4526-b5a1-cd425e8cba18",
      "text": "và lưỡi tôi không thốt lời dối gian.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:34.652Z",
      "updatedAt": "2025-09-03T02:22:34.652Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "6411693e-77d9-492f-99a1-b0c23dd07165",
      "text": "Chẳng đời nào tôi công nhận các anh có lý !",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:34.666Z",
      "updatedAt": "2025-09-03T02:22:34.666Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "0144c7db-8a66-4b84-bcd7-65cbff2cda60",
      "text": "Cho đến khi trút hơi thở cuối cùng,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:34.682Z",
      "updatedAt": "2025-09-03T02:22:34.682Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "ceb0a0a7-616b-4810-82cb-806f57abb1cf",
      "text": "không bao giờ tôi từ bỏ sự vẹn toàn của tôi.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:34.697Z",
      "updatedAt": "2025-09-03T02:22:34.697Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "1bb41331-cbae-4e38-9b25-60922550b5b7",
      "text": "Tôi vững bước theo đường công chính, không rời bỏ,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:34.725Z",
      "updatedAt": "2025-09-03T02:22:34.725Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "88d132ed-f73d-4bd0-8f4b-38f2899822e9",
      "text": "lòng tôi không xấu hổ thẹn thùng",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:34.755Z",
      "updatedAt": "2025-09-03T02:22:34.755Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "548c1118-64f9-4c34-a406-1e1c0fc4de19",
      "text": "về bất cứ ngày nào trong đời tôi.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:34.769Z",
      "updatedAt": "2025-09-03T02:22:34.769Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "a791a74a-6665-4efe-bedb-d80e312da092",
      "text": "Ước chi kẻ thù tôi phải gánh chịu số phận tên gian ác,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:34.783Z",
      "updatedAt": "2025-09-03T02:22:34.783Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "60ec8d8b-0a6c-4d61-bee4-77d6cdd8a691",
      "text": "và đối phương tôi phải gánh chịu số phận kẻ bất công.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:34.797Z",
      "updatedAt": "2025-09-03T02:22:34.797Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "698b84fb-de6e-4114-bc80-b256cc925e99",
      "text": "Kẻ gian ác hy vọng gì khi cầu nguyện,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:34.812Z",
      "updatedAt": "2025-09-03T02:22:34.812Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "540c3c4c-693e-496a-84f1-6b94cbeda075",
      "text": "khi nâng tâm hồn lên cùng Thiên Chúa ?",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:34.855Z",
      "updatedAt": "2025-09-03T02:22:34.855Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "656a8330-8d35-4be6-83c8-6ccbc2b15a58",
      "text": "Thiên Chúa có nghe tiếng nó kêu than,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:34.869Z",
      "updatedAt": "2025-09-03T02:22:34.869Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "c06709ce-4489-4332-9764-ac1ea485f700",
      "text": "khi cơn khốn cùng ập xuống trên nó ?",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:34.883Z",
      "updatedAt": "2025-09-03T02:22:34.883Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "9c47fe87-f8e6-4bcd-99d1-b59e9aa0ceff",
      "text": "Nó có nhận Đấng Toàn Năng làm nguồn hoan lạc,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:34.898Z",
      "updatedAt": "2025-09-03T02:22:34.898Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "e228d1e8-9bcd-48a7-b0d6-e8cae072fe4b",
      "text": "có kêu cầu Thiên Chúa mọi lúc không ?",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:34.942Z",
      "updatedAt": "2025-09-03T02:22:34.942Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "3f47296d-2b32-4514-a9ee-856a58cb79b1",
      "text": "Tôi sẽ dạy cho các anh hiểu quyền năng Thiên Chúa,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:34.960Z",
      "updatedAt": "2025-09-03T02:22:34.960Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "57d7e1ce-7d09-4ce6-bb0f-edd233d05bfd",
      "text": "sẽ không giấu ý định của Đấng Toàn Năng.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:34.993Z",
      "updatedAt": "2025-09-03T02:22:34.993Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "ae9dbc2e-69b5-4525-9d2f-2577a64ee006",
      "text": "Tất cả các anh đã thấy đó,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:35.037Z",
      "updatedAt": "2025-09-03T02:22:35.037Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "14d5832c-e3ac-4727-bee2-f04f15a8304d",
      "text": "sao lại còn nói điều vô nghĩa viển vông ?",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:35.051Z",
      "updatedAt": "2025-09-03T02:22:35.051Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "9c37166c-c36e-479f-b10d-67a4a89c34ed",
      "text": "Đây là phần sở hữu Thiên Chúa dành cho quân gian ác,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:35.065Z",
      "updatedAt": "2025-09-03T02:22:35.065Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "64af7fb3-f390-44a0-a4ad-e2bb8c0f9a2d",
      "text": "và đây là gia nghiệp Đấng Toàn Năng để cho lũ bạo tàn.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:35.138Z",
      "updatedAt": "2025-09-03T02:22:35.138Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "8ad99168-8b5d-4ab8-9900-57633ad7fe28",
      "text": "Con cái nó có nhiều thì cũng chết vì gươm,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:35.166Z",
      "updatedAt": "2025-09-03T02:22:35.166Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "f87ae509-7acd-41e4-a67b-31176a4ea117",
      "text": "cháu chắt nó không được ăn thoả thích.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:35.195Z",
      "updatedAt": "2025-09-03T02:22:35.195Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "f2d9363e-cd6b-40a0-82e8-bac5fc767862",
      "text": "Những kẻ sống sót sẽ bị Tử thần vùi dập",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:35.209Z",
      "updatedAt": "2025-09-03T02:22:35.209Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "b44919ef-77bb-4019-ab66-d87efd930c80",
      "text": "mà không được các bà vợ khóc than.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:35.239Z",
      "updatedAt": "2025-09-03T02:22:35.239Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "8d2e777f-f94a-46aa-8de8-2fb97a9d5b93",
      "text": "Nó có gom bạc nhiều như cát bụi,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:35.253Z",
      "updatedAt": "2025-09-03T02:22:35.253Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "7711e480-420e-4251-9b27-5d42accecb00",
      "text": "có chất áo quần thành đống như đất sét,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:35.267Z",
      "updatedAt": "2025-09-03T02:22:35.267Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "a2f34143-8ab5-4af9-b700-484ad0a53569",
      "text": "thì cứ việc chất đi,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:35.281Z",
      "updatedAt": "2025-09-03T02:22:35.281Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "cce409fb-5512-4801-95d4-af89f94ad722",
      "text": "nhưng người công chính sẽ hưởng dùng,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:35.310Z",
      "updatedAt": "2025-09-03T02:22:35.310Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "d1595bc0-2bfd-4695-849e-c238880f0a34",
      "text": "còn bạc, người vô tội sẽ chiếm hữu.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 2,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:35.340Z",
      "updatedAt": "2025-09-03T02:22:35.340Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "bdd5336d-ce97-45ef-bebe-bb3a0350fee1",
      "text": "Nó xây nhà như nhện giăng tơ,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:35.354Z",
      "updatedAt": "2025-09-03T02:22:35.354Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "7fb72707-c3a9-4444-b2de-8a2bde9345a6",
      "text": "nó dựng lều như người canh gác.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:35.383Z",
      "updatedAt": "2025-09-03T02:22:35.383Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "962aa9b0-71ca-4b5e-afb0-969220c10a2a",
      "text": "Lúc đi ngủ, nó là người giàu, nhưng đó là lần cuối,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:35.397Z",
      "updatedAt": "2025-09-03T02:22:35.397Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "4440c180-5036-44b6-98e8-b213af9c4452",
      "text": "vì khi bừng mắt dậy, chỉ thấy mình tay không.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:35.429Z",
      "updatedAt": "2025-09-03T02:22:35.429Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "c3ac792d-8581-4e60-ad86-7bb82871fb78",
      "text": "Ban ngày kinh hoàng sợ hãi bao vây nó,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:35.442Z",
      "updatedAt": "2025-09-03T02:22:35.442Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "0c81f109-f96f-4006-8370-f9108b5ee423",
      "text": "ban đêm cơn lốc cuốn nó đi.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:35.469Z",
      "updatedAt": "2025-09-03T02:22:35.469Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "3d3a152b-c272-4c63-8bae-bcb98aa2e026",
      "text": "Ngọn gió đông thổi nó bay mất dạng,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:35.479Z",
      "updatedAt": "2025-09-03T02:22:35.479Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "179a8c97-4b69-4c5c-ba6d-82757a3bf0d9",
      "text": "bứng nó khỏi nơi ở của mình.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:35.504Z",
      "updatedAt": "2025-09-03T02:22:35.504Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "db9576b3-32e9-4363-a112-bb437c044d7b",
      "text": "Người ta quấy nhiễu nó, chẳng chút xót thương,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:35.515Z",
      "updatedAt": "2025-09-03T02:22:35.515Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "06be11b1-206b-4fe7-8b79-8fb5e1d72a49",
      "text": "khiến nó phải chạy trốn trước bàn tay hung bạo.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:35.540Z",
      "updatedAt": "2025-09-03T02:22:35.540Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "fc1f66ea-bb02-4d48-9154-ab57258114b3",
      "text": "Nhìn thấy nó, thiên hạ vỗ tay nhạo cười,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:35.555Z",
      "updatedAt": "2025-09-03T02:22:35.555Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "f5df317d-e267-4182-925a-26929c12c068",
      "text": "và huýt sáo tại khắp nơi nó ở.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:35.568Z",
      "updatedAt": "2025-09-03T02:22:35.568Z",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    }
  ],
