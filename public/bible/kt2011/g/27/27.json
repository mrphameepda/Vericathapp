      "targetId": "cce409fb-5512-4801-95d4-af89f94ad722",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "87ecc5e3-ec37-4833-ae62-9d92826102cb",
      "content": "Gió thổi từ sa mạc rất mạnh và rất độc.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "17",
      "sortOrder": 16,
      "startOffset": 13,
      "endOffset": 13,
      "createdAt": "2025-09-03T02:22:35.489Z",
      "updatedAt": "2025-09-03T02:22:35.489Z",
      "targetId": "3d3a152b-c272-4c63-8bae-bcb98aa2e026",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "51b0f4c3-418d-4f8f-9005-aa44c2421a38",
      "content": "*Vỗ tay* tỏ dấu giận dữ (x. Ds 24,10), cười nhạo (x. Ac 2,15). *Huýt sáo* tỏ ý kinh tởm (Xp 2,15), cười nhạo (x. Ed 27,36 ; Ac 2,15 ; Gr 49,7).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "18",
