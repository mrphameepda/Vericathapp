    },
    {
      "id": "9b1b93aa-07ab-4195-b0d3-6666cd0f835a",
      "content": "Ở đây nhắc lại ba cách chết vì bị trừng phạt : gươm, đói, bệnh dịch (tử thần).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "15",
      "sortOrder": 14,
      "startOffset": 41,
      "endOffset": 41,
      "createdAt": "2025-09-03T02:22:35.180Z",
      "updatedAt": "2025-09-03T02:22:35.180Z",
      "targetId": "8ad99168-8b5d-4ab8-9900-57633ad7fe28",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "56d9c27a-6d17-4c11-a5c4-4310feca7c52"
    },
    {
      "id": "e3952e0c-a78b-4755-8895-8b7d84a9f9e4",
      "content": "X. Cn 13,22.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "16",
      "sortOrder": 15,
      "startOffset": 36,
      "endOffset": 36,
      "createdAt": "2025-09-03T02:22:35.325Z",
