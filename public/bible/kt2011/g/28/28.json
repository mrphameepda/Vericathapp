{
  "chapter": {
    "id": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4",
    "number": 28,
    "createdAt": "2025-09-03T01:07:51.633Z",
    "updatedAt": "2025-09-03T01:07:51.633Z",
    "bookId": "1672a600-6214-4bc7-aaa4-9b99684355ac"
  },
  "verses": [
    {
      "id": "a1ee9284-7b7b-4462-a151-e7ab234200a0",
      "text": "Quả thật, có nơi để lấy bạc, có chỗ để luyện vàng.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:41.657Z",
      "updatedAt": "2025-09-03T02:22:41.657Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "2fe00a31-ec23-463f-ba9a-f2e8953ade8b",
      "text": "Sắt lấy ra từ đất, đá nung chảy thành đồng.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:41.764Z",
      "updatedAt": "2025-09-03T02:22:41.764Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "6d4b62ba-9fad-4d07-991f-8479c1b10730",
      "text": "Người ta xua bóng tối, đào bới cho đến cùng,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:41.822Z",
      "updatedAt": "2025-09-03T02:22:41.822Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "fcb17af1-37c4-470b-92e2-d7c4e2d1242b",
      "text": "để lấy đá từ nơi tối tăm mù mịt.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:41.837Z",
      "updatedAt": "2025-09-03T02:22:41.837Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "0c1f56dd-8f1b-46b4-9f7e-4fae6bea052d",
      "text": "Những kẻ xa lạ đào đường hầm",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:41.879Z",
      "updatedAt": "2025-09-03T02:22:41.879Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "10f6b4c5-df62-415e-b3af-e18ec9ade2c9",
      "text": "tại những nơi không người qua lại ;",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:41.907Z",
      "updatedAt": "2025-09-03T02:22:41.907Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "8351266f-74e9-4bb4-9a30-2563a22921e8",
      "text": "chúng bị treo lơ lửng, đu đưa xa cõi người phàm.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:41.922Z",
      "updatedAt": "2025-09-03T02:22:41.922Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "8e798cee-399a-4ec5-a8ed-a238522c5d48",
      "text": "Đất trước kia sản xuất ra bánh ăn,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:41.952Z",
      "updatedAt": "2025-09-03T02:22:41.952Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "c1f9060c-3f78-4822-85bc-8c9f982dfb14",
      "text": "thì nay đáy ngửa nghiêng như bị lửa đốt.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:41.980Z",
      "updatedAt": "2025-09-03T02:22:41.980Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "fde82de2-048d-4409-b849-be3adc4af3e1",
      "text": "Tại đây đá có nhiều lam ngọc và trong bụi đất có cả vàng.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:42.009Z",
      "updatedAt": "2025-09-03T02:22:42.009Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "bead32a5-33a7-4343-9264-a314edbe475c",
      "text": "Mãnh cầm không biết đường tới đó",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:42.038Z",
      "updatedAt": "2025-09-03T02:22:42.038Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "372b5f39-3a3b-4db6-bb1c-866f14f74c0d",
      "text": "và mắt kền kền cũng chẳng nhận ra.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:42.053Z",
      "updatedAt": "2025-09-03T02:22:42.053Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "6eaa0413-3607-4754-b26c-1a731b4ded1d",
      "text": "Loài mãnh thú chưa từng đặt chân đến,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:42.067Z",
      "updatedAt": "2025-09-03T02:22:42.067Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "f7cb88b7-2906-449c-b326-39729e979330",
      "text": "và sư tử con chưa qua đó bao giờ.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:42.095Z",
      "updatedAt": "2025-09-03T02:22:42.095Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "d7e3bac6-e7da-4ccc-82e4-00ee1e108be6",
      "text": "Người ta tra tay đào đá lửa, làm đảo lộn núi non tận móng nền,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:42.122Z",
      "updatedAt": "2025-09-03T02:22:42.122Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "5228d8fb-6e4d-4dcf-90ed-d35926a19b9c",
      "text": "và xẻ những đường hầm trong núi đá,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:42.151Z",
      "updatedAt": "2025-09-03T02:22:42.151Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "c2aacd6a-9a8e-4b8f-8dfc-a5dec08fe4a2",
      "text": "mắt nhìn xem mọi thứ báu vật.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:42.166Z",
      "updatedAt": "2025-09-03T02:22:42.166Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "cb8704dd-598f-4069-a013-b26a66b88b16",
      "text": "Người ta đắp đập chặn các dòng sông,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:42.180Z",
      "updatedAt": "2025-09-03T02:22:42.180Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "3eeed424-ac6f-438a-9f16-e00015fbfc67",
      "text": "và đưa ra ánh sáng những điều bí ẩn.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:42.194Z",
      "updatedAt": "2025-09-03T02:22:42.194Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "1cf6b8bb-d83b-4296-94c8-f4ea3db88719",
      "text": "Nhưng khôn ngoan từ đâu ra, và trí hiểu ở chốn nào ?",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:42.208Z",
      "updatedAt": "2025-09-03T02:22:42.208Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "4bdf0476-916b-45bb-9c54-a84eba79bd47",
      "text": "Người phàm không lượng giá được khôn ngoan,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:42.259Z",
      "updatedAt": "2025-09-03T02:22:42.259Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "fe4cf81f-2ee6-4a93-813f-4749d695e592",
      "text": "vì khôn ngoan không ở trong đất dành cho kẻ sống.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:42.288Z",
      "updatedAt": "2025-09-03T02:22:42.288Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "35670fbc-d355-44df-8474-70d4361524d0",
      "text": "Vực thẳm nói : “Tôi không chứa khôn ngoan !”",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:42.318Z",
      "updatedAt": "2025-09-03T02:22:42.318Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "3bbed956-9d61-4cf4-883e-41760cf284f6",
      "text": "Đại dương bảo : “Khôn ngoan không ở nơi tôi bao giờ !”",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:42.332Z",
      "updatedAt": "2025-09-03T02:22:42.332Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "813d77d7-f049-4970-807c-5e98ec8713b5",
      "text": "Người ta không thể lấy vàng ròng thay thế,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:42.361Z",
      "updatedAt": "2025-09-03T02:22:42.361Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "614e1ea1-86b4-4031-8565-5fb3fd3849e7",
      "text": "cũng không đem tiền rừng bạc bể mà mua.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:42.388Z",
      "updatedAt": "2025-09-03T02:22:42.388Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "8f8fe22f-4007-4528-9dde-caba61ff6ade",
      "text": "Vàng Ô-phia, mã não quý và lam ngọc",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:42.403Z",
      "updatedAt": "2025-09-03T02:22:42.403Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "f6d1833b-40d2-474a-92cc-6ac538271ce5",
      "text": "người ta không dùng để định giá khôn ngoan.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:42.433Z",
      "updatedAt": "2025-09-03T02:22:42.433Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "b24db004-429c-4317-a6ab-948bc9e8910e",
      "text": "Vàng hay thuỷ tinh không thể sánh tày,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:42.448Z",
      "updatedAt": "2025-09-03T02:22:42.448Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "055a888c-1f89-4faf-9d6f-5b649b8e7272",
      "text": "bình vàng quý cũng không đổi lấy được khôn ngoan.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:42.476Z",
      "updatedAt": "2025-09-03T02:22:42.476Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "54a421e9-044b-45ff-9f8a-4c8a1d21f663",
      "text": "So với khôn ngoan, san hô đá quý đều vô nghĩa,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:42.503Z",
      "updatedAt": "2025-09-03T02:22:42.503Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "fa80d904-0917-4292-a41a-94de6fc3809b",
      "text": "được khôn ngoan còn hơn được ngọc trai.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:42.517Z",
      "updatedAt": "2025-09-03T02:22:42.517Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "4d1661b9-7e18-4bd2-a09f-7fc5c30c7537",
      "text": "Người ta không sánh khôn ngoan với hoàng ngọc xứ Cút,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:42.532Z",
      "updatedAt": "2025-09-03T02:22:42.532Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "b47b5335-273a-452a-94ad-278db8b83208",
      "text": "cũng không đánh giá ngang hàng với vàng ròng.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:42.576Z",
      "updatedAt": "2025-09-03T02:22:42.576Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "459d19de-854d-49d8-ba33-98f54ada6a61",
      "text": "Khôn ngoan từ đâu đến, trí hiểu phát xuất từ nơi nao ?",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:42.590Z",
      "updatedAt": "2025-09-03T02:22:42.590Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "3b440fa6-dd0e-4398-b238-0a183f1be7b1",
      "text": "Khôn ngoan khuất dạng trước mắt người trần,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:42.620Z",
      "updatedAt": "2025-09-03T02:22:42.620Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "5e87ae6a-fade-43cb-a3fb-2ef83c3725ca",
      "text": "ẩn mình đi, chim trời không nhìn thấy.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:42.634Z",
      "updatedAt": "2025-09-03T02:22:42.634Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "b1fae5fc-51eb-48db-b19f-6bdc55565c71",
      "text": "Âm ty và tử thần lên tiếng bảo :",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:42.662Z",
      "updatedAt": "2025-09-03T02:22:42.662Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "c4236f7a-69b6-4a7c-924e-730ff3d4529c",
      "text": "“Tiếng tăm của khôn ngoan tai chúng tôi đã được biết.”",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:42.690Z",
      "updatedAt": "2025-09-03T02:22:42.690Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "b5c5dd0d-5cc5-4ea5-ba32-8d74df00f1be",
      "text": "Đường nẻo của khôn ngoan một mình Thiên Chúa tỏ,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:42.704Z",
      "updatedAt": "2025-09-03T02:22:42.704Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "4c8cb17c-deb5-49ce-891d-502d1a536c0f",
      "text": "chính Người biết nơi ở của khôn ngoan.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:42.748Z",
      "updatedAt": "2025-09-03T02:22:42.748Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "4a291ee5-a5b9-4d0f-a312-8a015fef1504",
      "text": "Quả thật, Người nhìn thấy tận cùng cõi đất,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:42.762Z",
      "updatedAt": "2025-09-03T02:22:42.762Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "3dc60bf1-5d32-41b0-9f12-075c7ed24df6",
      "text": "Người xem thấy mọi sự dưới vòm trời.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:42.776Z",
      "updatedAt": "2025-09-03T02:22:42.776Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "0d44bf84-932f-4028-a7ba-8ce862492c52",
      "text": "Khi Người ban sức mạnh cho gió",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:42.790Z",
      "updatedAt": "2025-09-03T02:22:42.790Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "265fced0-9a17-4156-910d-1be36548f77d",
      "text": "và định mức cho nước thuỷ triều,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:42.820Z",
      "updatedAt": "2025-09-03T02:22:42.820Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "efac6f91-83f2-4877-a55f-a11def4ee88d",
      "text": "khi Người ra luật cho mưa, vạch đường cho sấm chớp,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:42.834Z",
      "updatedAt": "2025-09-03T02:22:42.834Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "26eabf5f-1d78-449f-9c57-fb862790ec3a",
      "text": "bấy giờ Người nhìn thấy và định giá khôn ngoan,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:42.849Z",
      "updatedAt": "2025-09-03T02:22:42.849Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "837b4296-fbd4-4083-96f1-6be408add8de",
      "text": "Người thông hiểu và lại còn thấu suốt.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:42.878Z",
      "updatedAt": "2025-09-03T02:22:42.878Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "04711092-ede9-4ea7-a9ab-3f5765bd3c52",
      "text": "Rồi Người nói với con người :",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:42.892Z",
      "updatedAt": "2025-09-03T02:22:42.892Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "58dde4c5-15eb-4000-9533-d4f07535d53e",
      "text": "“Này, kính sợ Chúa Thượng, đó là khôn ngoan,",
      "label": "28",
      "number": 28,
      "subVerseIndex": 1,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:42.910Z",
      "updatedAt": "2025-09-03T02:22:42.910Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "fffc1c61-bb38-4766-8642-b330813a0f25",
      "text": "tránh xa điều ác, đó là trí hiểu.”",
      "label": "28",
      "number": 28,
      "subVerseIndex": 2,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:42.940Z",
      "updatedAt": "2025-09-03T02:22:42.940Z",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    }
  ],
  "marks": [
    {
      "id": "d61b1c52-302d-4557-adfa-4305019e5c46",
      "content": "Bài thơ này được chen vào trước cuộc đối thoại kết thúc. Chủ đề là ca tụng tính siêu việt của khôn ngoan Thiên Chúa. Loài người không thể đạt được khôn ngoan. Bởi khôn ngoan đã được nhân cách hoá (x. Cn 1,20-23 ; 2,1-22 ; 8,1-31 ; Br 3,12 – 4,4 ; Hc 1,14-27 ; 24 ; Kn 7-9). Ch. 28 chia làm ba phần (1-11 ; 13-19 ; 21-27) ; mỗi phần kết bằng một câu hỏi (28,12.20) và câu kết (28,28). Loài người có thể khám phá và tìm kiếm được các kho tàng, nhưng không tìm được khôn ngoan (28,1-11). Khôn ngoan quý giá hơn tất cả vàng bạc đá quý, nhưng không ai biết khôn ngoan xuất phát từ đâu (28,12-19). Không mắt phàm nào thấy được khôn ngoan, chỉ có mình Thiên Chúa thấy được (28,21-27).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 39,
      "endOffset": 39,
      "createdAt": "2025-09-03T02:22:41.701Z",
      "updatedAt": "2025-09-03T02:22:41.701Z",
      "targetId": "03df5b7b-e7e2-4233-9293-3211ffe24e82",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "9447e7c6-73d2-4e04-8b2f-0e272411c1fe",
      "content": "1 V 10,22",
      "kind": "MARK_KIND_REFERENCE",
      "label": "1@",
      "sortOrder": 0,
      "startOffset": 24,
      "endOffset": 24,
      "createdAt": "2025-09-03T02:22:41.749Z",
      "updatedAt": "2025-09-03T02:22:41.749Z",
      "targetId": "a1ee9284-7b7b-4462-a151-e7ab234200a0",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "4d9e1f52-f7a8-40e2-be63-a5c1ce5f7330",
      "content": "Ở Pa-lét-tin không có mỏ bạc. Bạc phải nhập khẩu từ Tác-sít (x. Gr 10,9 ; Ed 27,12).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 27,
      "endOffset": 27,
      "createdAt": "2025-09-03T02:22:41.715Z",
      "updatedAt": "2025-09-03T02:22:41.715Z",
      "targetId": "a1ee9284-7b7b-4462-a151-e7ab234200a0",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "5cdf9f6b-7e9f-44de-bd8e-62da6f386018",
      "content": "Đnl 8,9",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:22:41.808Z",
      "updatedAt": "2025-09-03T02:22:41.808Z",
      "targetId": "2fe00a31-ec23-463f-ba9a-f2e8953ade8b",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "adc1a63e-dc9e-473c-84ff-dff2805f9031",
      "content": "Vàng không có nhiều ở Pa-lét-tin, được nhập khẩu từ những vùng đất xa xôi như Ô-phia (x. Is 13,12 ; 1 V 10,11 ; 1 Sb 29,4) hoặc Sơ-va (x. 1 V 10,10).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 50,
      "endOffset": 50,
      "createdAt": "2025-09-03T02:22:41.734Z",
      "updatedAt": "2025-09-03T02:22:41.734Z",
      "targetId": "a1ee9284-7b7b-4462-a151-e7ab234200a0",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "cc85df2d-cf55-4e58-aadd-e14297ded35d",
      "content": "G 28,10",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 13,
      "endOffset": 13,
      "createdAt": "2025-09-03T02:22:41.865Z",
      "updatedAt": "2025-09-03T02:22:41.865Z",
      "targetId": "fcb17af1-37c4-470b-92e2-d7c4e2d1242b",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "5c61c50a-2128-46ae-8848-035fa3573dac",
      "content": "Từ thiên niên kỷ thứ III tCN, người ta đã biết lấy sắt từ quặng, nhưng rất ít ; mãi đến thế kỷ XIII tCN, việc lấy sắt từ quặng đã trở nên phổ biến. Người ta tìm thấy quặng mỏ trên cao nguyên phía đông thung lũng Gio-đan.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 17,
      "endOffset": 17,
      "createdAt": "2025-09-03T02:22:41.778Z",
      "updatedAt": "2025-09-03T02:22:41.778Z",
      "targetId": "2fe00a31-ec23-463f-ba9a-f2e8953ade8b",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "5cddf1c1-1897-4b16-94ca-9cc1db5645c2",
      "content": "Tv 104,14",
      "kind": "MARK_KIND_REFERENCE",
      "label": "4@",
      "sortOrder": 3,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:22:41.966Z",
      "updatedAt": "2025-09-03T02:22:41.966Z",
      "targetId": "8e798cee-399a-4ec5-a8ed-a238522c5d48",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "8738f5f2-68db-428c-b3a2-9fe9797ea70c",
      "content": "Đồng có nhiều trên thế giới và được khai thác rất sớm. Những mỏ lớn ở Sýp, Ê-đôm, bán đảo Xi-nai. Vua Sa-lô-môn đã luyện đồng ở E-xi-ô Ghe-ve.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "5",
      "sortOrder": 4,
      "startOffset": 42,
      "endOffset": 42,
      "createdAt": "2025-09-03T02:22:41.793Z",
      "updatedAt": "2025-09-03T02:22:41.793Z",
      "targetId": "2fe00a31-ec23-463f-ba9a-f2e8953ade8b",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "adb8ea00-c1b0-4ef9-ab80-2d2b455c3b92",
      "content": "G 28,16",
      "kind": "MARK_KIND_REFERENCE",
      "label": "5@",
      "sortOrder": 4,
      "startOffset": 20,
      "endOffset": 20,
      "createdAt": "2025-09-03T02:22:42.024Z",
      "updatedAt": "2025-09-03T02:22:42.024Z",
      "targetId": "fde82de2-048d-4409-b849-be3adc4af3e1",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "4c0b8d35-3e1d-45e3-9bdf-dfd18ea249e3",
      "content": "Các quặng mỏ, hoặc là đá quý.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "6",
      "sortOrder": 5,
      "startOffset": 9,
      "endOffset": 9,
      "createdAt": "2025-09-03T02:22:41.851Z",
      "updatedAt": "2025-09-03T02:22:41.851Z",
      "targetId": "fcb17af1-37c4-470b-92e2-d7c4e2d1242b",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "51c3bd14-1eb7-4b2d-a5d5-48fa8a631a1e",
      "content": "G 41,26",
      "kind": "MARK_KIND_REFERENCE",
      "label": "6@",
      "sortOrder": 5,
      "startOffset": 5,
      "endOffset": 5,
      "createdAt": "2025-09-03T02:22:42.081Z",
      "updatedAt": "2025-09-03T02:22:42.081Z",
      "targetId": "6eaa0413-3607-4754-b26c-1a731b4ded1d",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "e08394e5-c691-41e1-9ae9-da90bfd02e06",
      "content": "Không phải là người nước ngoài ; có lẽ là những tù khổ sai và những tù nhân bị kết án tử hình phải làm những việc cực nhọc này.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "7",
      "sortOrder": 6,
      "startOffset": 14,
      "endOffset": 14,
      "createdAt": "2025-09-03T02:22:41.893Z",
      "updatedAt": "2025-09-03T02:22:41.893Z",
      "targetId": "0c1f56dd-8f1b-46b4-9f7e-4fae6bea052d",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "5f7b6a3c-8b19-4e28-85fe-46d96805cced",
      "content": "Gv 7,24; Hc 1,6",
      "kind": "MARK_KIND_REFERENCE",
      "label": "7@",
      "sortOrder": 6,
      "startOffset": 6,
      "endOffset": 6,
      "createdAt": "2025-09-03T02:22:42.245Z",
      "updatedAt": "2025-09-03T02:22:42.245Z",
      "targetId": "1cf6b8bb-d83b-4296-94c8-f4ea3db88719",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "acf9a1c7-0af8-4bad-9168-5ba8541fb651",
      "content": "Ám chỉ các thợ mỏ phải treo trên dây thừng và thả xuống hầm sâu.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "8",
      "sortOrder": 7,
      "startOffset": 21,
      "endOffset": 21,
      "createdAt": "2025-09-03T02:22:41.937Z",
      "updatedAt": "2025-09-03T02:22:41.937Z",
      "targetId": "8351266f-74e9-4bb4-9a30-2563a22921e8",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "106af386-a724-4d10-8525-08548454efe6",
      "content": "Br 3,29-31",
      "kind": "MARK_KIND_REFERENCE",
      "label": "8@",
      "sortOrder": 7,
      "startOffset": 32,
      "endOffset": 32,
      "createdAt": "2025-09-03T02:22:42.273Z",
      "updatedAt": "2025-09-03T02:22:42.273Z",
      "targetId": "4bdf0476-916b-45bb-9c54-a84eba79bd47",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "c03af883-2650-4070-b1ed-e0578f5cc02d",
      "content": "Khám phá hầm mỏ là khám phá một sự kỳ diệu của trái đất. Trên mặt đất có ngũ cốc, thảo mộc, thế mà trong lòng đất những khối lửa cuồn cuộn bốc cháy, làm nung chảy các quặng kim khí.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "9",
      "sortOrder": 8,
      "startOffset": 39,
      "endOffset": 39,
      "createdAt": "2025-09-03T02:22:41.994Z",
      "updatedAt": "2025-09-03T02:22:41.994Z",
      "targetId": "c1f9060c-3f78-4822-85bc-8c9f982dfb14",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "453fe00d-94e7-41dd-8108-edea90dbaceb",
      "content": "Cn 2,4",
      "kind": "MARK_KIND_REFERENCE",
      "label": "9@",
      "sortOrder": 8,
      "startOffset": 23,
      "endOffset": 23,
      "createdAt": "2025-09-03T02:22:42.375Z",
      "updatedAt": "2025-09-03T02:22:42.375Z",
      "targetId": "813d77d7-f049-4970-807c-5e98ec8713b5",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "038eadc2-cd43-4718-ae2f-64997eadf754",
      "content": "Các hầm mỏ ở xa dân cư và cả mãnh thú nữa.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "10",
      "sortOrder": 9,
      "startOffset": 32,
      "endOffset": 32,
      "createdAt": "2025-09-03T02:22:42.109Z",
      "updatedAt": "2025-09-03T02:22:42.109Z",
      "targetId": "f7cb88b7-2906-449c-b326-39729e979330",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "c9e9ccd6-d361-44fc-8d01-c9f6229df9ad",
      "content": "Kn 7,9",
      "kind": "MARK_KIND_REFERENCE",
      "label": "10@",
      "sortOrder": 9,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:22:42.463Z",
      "updatedAt": "2025-09-03T02:22:42.463Z",
      "targetId": "b24db004-429c-4317-a6ab-948bc9e8910e",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "02dc7963-6e87-4c27-8b42-e6b883fbe6a5",
      "content": "Dị nghĩa. Có thể hiểu đá cứng khi bị đào làm toé ra lửa ; cũng có thể hiểu là thứ đá quý.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "11",
      "sortOrder": 10,
      "startOffset": 27,
      "endOffset": 27,
      "createdAt": "2025-09-03T02:22:42.137Z",
      "updatedAt": "2025-09-03T02:22:42.137Z",
      "targetId": "d7e3bac6-e7da-4ccc-82e4-00ee1e108be6",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "488741f6-74c2-4358-9680-eb1b18f56a91",
      "content": "Cn 3,15",
      "kind": "MARK_KIND_REFERENCE",
      "label": "11@",
      "sortOrder": 10,
      "startOffset": 15,
      "endOffset": 15,
      "createdAt": "2025-09-03T02:22:42.562Z",
      "updatedAt": "2025-09-03T02:22:42.562Z",
      "targetId": "4d1661b9-7e18-4bd2-a09f-7fc5c30c7537",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "50407fd4-99de-4785-8c84-cb6d76dcd239",
      "content": "*Khôn ngoan* và *trí hiểu* thường đồng nghĩa với nhau trong văn chương khôn ngoan (x. Cn 1,2 ; 4,5 ; 9,10 ; 16,16). Người ta lặn lội tới hang sâu, vực thẳm, chặn sông đào bới kho tàng quý báu, nhưng lại không biết khôn ngoan ở đâu mà tìm.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "12",
      "sortOrder": 11,
      "startOffset": 50,
      "endOffset": 50,
      "createdAt": "2025-09-03T02:22:42.224Z",
      "updatedAt": "2025-09-03T02:22:42.224Z",
      "targetId": "1cf6b8bb-d83b-4296-94c8-f4ea3db88719",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "4670b595-116c-47a4-97bb-8e72067b800c",
      "content": "G 28,12; Hc 1,6",
      "kind": "MARK_KIND_REFERENCE",
      "label": "12@",
      "sortOrder": 11,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:22:42.605Z",
      "updatedAt": "2025-09-03T02:22:42.605Z",
      "targetId": "459d19de-854d-49d8-ba33-98f54ada6a61",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "4df3ea20-73d1-46ff-9d43-8bae52f571b3",
      "content": "X. Is 38,11 ; 53,8 ; Gr 11,19 ; Ed 26,20.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "13",
      "sortOrder": 12,
      "startOffset": 48,
      "endOffset": 48,
      "createdAt": "2025-09-03T02:22:42.302Z",
      "updatedAt": "2025-09-03T02:22:42.302Z",
      "targetId": "fe4cf81f-2ee6-4a93-813f-4749d695e592",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "c8af98a2-2948-46bf-b377-e37308a2bf28",
      "content": "G 26,6",
      "kind": "MARK_KIND_REFERENCE",
      "label": "13@",
      "sortOrder": 12,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:22:42.676Z",
      "updatedAt": "2025-09-03T02:22:42.676Z",
      "targetId": "b1fae5fc-51eb-48db-b19f-6bdc55565c71",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "9a307859-99e7-43e5-adc3-790bcca4f324",
      "content": "Khôn ngoan không ở vực thẳm và đại dương ; vì thế, con người không thể tìm được khôn ngoan ở đó.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "14",
      "sortOrder": 13,
      "startOffset": 9,
      "endOffset": 9,
      "createdAt": "2025-09-03T02:22:42.346Z",
      "updatedAt": "2025-09-03T02:22:42.346Z",
      "targetId": "3bbed956-9d61-4cf4-883e-41760cf284f6",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "c911a1aa-ec1e-49d3-b76b-06c6a6fd54b3",
      "content": "Cn 2,6; Br 3,37",
      "kind": "MARK_KIND_REFERENCE",
      "label": "14@",
      "sortOrder": 13,
      "startOffset": 14,
      "endOffset": 14,
      "createdAt": "2025-09-03T02:22:42.733Z",
      "updatedAt": "2025-09-03T02:22:42.733Z",
      "targetId": "b5c5dd0d-5cc5-4ea5-ba32-8d74df00f1be",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "c69400ba-4f57-4de2-8069-f3a0000a3036",
      "content": "English: Ophir | French: Ofir | Latin: Ophir | Origin: &#1488;&#64331;&#1508;&#1460;&#1497;&#1512; | Vietnamese: Ô-phia 1 -- con ông Gióc-tan, St 10,29, 1 Sb 1,23",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "15",
      "sortOrder": 14,
      "startOffset": 11,
      "endOffset": 11,
      "createdAt": "2025-09-03T02:22:42.418Z",
      "updatedAt": "2025-09-03T02:22:42.418Z",
      "targetId": "8f8fe22f-4007-4528-9dde-caba61ff6ade",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "9ad75eec-b044-4dcc-9905-907162f8a273",
      "content": "Hc 1,8-9; Is 40,12-14",
      "kind": "MARK_KIND_REFERENCE",
      "label": "15@",
      "sortOrder": 14,
      "startOffset": 8,
      "endOffset": 8,
      "createdAt": "2025-09-03T02:22:42.864Z",
      "updatedAt": "2025-09-03T02:22:42.864Z",
      "targetId": "26eabf5f-1d78-449f-9c57-fb862790ec3a",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "497849f9-52b1-4e6a-8a57-cb71b6777e79",
      "content": "Khôn ngoan không thể được mua bán đổi chác bằng những đá quý, kim loại quý.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "16",
      "sortOrder": 15,
      "startOffset": 48,
      "endOffset": 48,
      "createdAt": "2025-09-03T02:22:42.489Z",
      "updatedAt": "2025-09-03T02:22:42.489Z",
      "targetId": "055a888c-1f89-4faf-9d6f-5b649b8e7272",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "e4551f20-0902-4aa3-af2c-659e18d34031",
      "content": "Tv 111,10; Cn 1,7",
      "kind": "MARK_KIND_REFERENCE",
      "label": "16@",
      "sortOrder": 15,
      "startOffset": 6,
      "endOffset": 6,
      "createdAt": "2025-09-03T02:22:42.925Z",
      "updatedAt": "2025-09-03T02:22:42.925Z",
      "targetId": "58dde4c5-15eb-4000-9533-d4f07535d53e",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "c25baf90-cbe9-453d-a246-50ea5e00e975",
      "content": "Đó là xứ Ê-thi-óp. So sánh khôn ngoan với đá quý thường được nói trong văn chương khôn ngoan (x. Cn 3,14-15 ; 8,10-11.19 ; Tv 19,11 ; 119,72.127 ; Kn 7,9). Xứ Ê-thi-óp cũng nổi tiếng là khôn ngoan.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "17",
      "sortOrder": 16,
      "startOffset": 52,
      "endOffset": 52,
      "createdAt": "2025-09-03T02:22:42.547Z",
      "updatedAt": "2025-09-03T02:22:42.547Z",
      "targetId": "4d1661b9-7e18-4bd2-a09f-7fc5c30c7537",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "b31b4302-bbd7-4253-a3ed-34288b46ad00",
      "content": "Tác giả khẳng định tính siêu việt của khôn ngoan.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "18",
      "sortOrder": 17,
      "startOffset": 37,
      "endOffset": 37,
      "createdAt": "2025-09-03T02:22:42.649Z",
      "updatedAt": "2025-09-03T02:22:42.649Z",
      "targetId": "5e87ae6a-fade-43cb-a3fb-2ef83c3725ca",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "b06018ea-c74a-483e-af8b-93c8b7d184fb",
      "content": "Thiên Chúa thấu suốt khôn ngoan, vì Thiên Chúa đã dùng khôn ngoan và trí hiểu mà sáng tạo trời và đất (x. Cn 3,19).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "19",
      "sortOrder": 18,
      "startOffset": 47,
      "endOffset": 47,
      "createdAt": "2025-09-03T02:22:42.718Z",
      "updatedAt": "2025-09-03T02:22:42.718Z",
      "targetId": "b5c5dd0d-5cc5-4ea5-ba32-8d74df00f1be",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "5415081c-cf9c-46ea-acc4-d74eaf17018b",
      "content": "Cc. 25-27 cho thấy mối tương quan giữa Thiên Chúa và khôn ngoan trong hành động sáng tạo và điều khiển thiên nhiên.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "20",
      "sortOrder": 19,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:22:42.805Z",
      "updatedAt": "2025-09-03T02:22:42.805Z",
      "targetId": "0d44bf84-932f-4028-a7ba-8ce862492c52",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "689e7fd4-bd44-4685-8805-8c59d32df4cd",
      "content": "Câu kết này không ăn ý với các câu trên. Tác giả đưa ra một câu khuyên nhủ đạo đức.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "21",
      "sortOrder": 20,
      "startOffset": 32,
      "endOffset": 32,
      "createdAt": "2025-09-03T02:22:42.955Z",
      "updatedAt": "2025-09-03T02:22:42.955Z",
      "targetId": "fffc1c61-bb38-4766-8642-b330813a0f25",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    }
  ],
  "headings": [
    {
      "id": "365b912b-fd4e-4af8-a87b-0cea0c19ed82",
      "text": "4. CA TỤNG KHÔN NGOAN",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T02:22:41.675Z",
      "updatedAt": "2025-09-03T02:22:41.675Z",
