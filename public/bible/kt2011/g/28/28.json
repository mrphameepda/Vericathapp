      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    },
    {
      "id": "03df5b7b-e7e2-4233-9293-3211ffe24e82",
      "text": "Khôn ngoan con người không thể đạt được",
      "level": 2,
      "sortOrder": 1,
      "createdAt": "2025-09-03T02:22:41.687Z",
      "updatedAt": "2025-09-03T02:22:41.687Z",
      "verseId": "a1ee9284-7b7b-4462-a151-e7ab234200a0",
      "chapterId": "1d6c6255-6da8-46e4-b2bc-c2ed449550d4"
    }
  ],
