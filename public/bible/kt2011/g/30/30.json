    {
      "id": "30247a9f-43cf-426c-ad21-e66a9d7e1830",
      "content": "Cc. 24-25 cho thấy ông Gióp là bạn của những người nghèo và khốn cùng.",
      "kind": "MARK_KIND_FOOTNOTE",
