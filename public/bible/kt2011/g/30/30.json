      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "38666b77-a5ec-462e-86da-4930bf0be06d",
      "content": "Thiên Chúa được so sánh với một người chiến đấu túm lấy cổ đối phương siết chặt lại.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "10",
      "sortOrder": 9,
      "startOffset": 58,
      "endOffset": 58,
      "createdAt": "2025-09-03T02:23:00.231Z",
      "updatedAt": "2025-09-03T02:23:00.231Z",
      "targetId": "92bec057-0545-4e3e-86b9-5735d9807faa",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "df637544-be91-47c4-a04d-367862580f08",
      "content": "G 6,4",
      "kind": "MARK_KIND_REFERENCE",
      "label": "11@",
      "sortOrder": 10,
      "startOffset": 0,
      "endOffset": 0,
