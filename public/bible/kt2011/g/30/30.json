    },
    {
      "id": "44109af6-f916-4a17-891a-449e710a00cc",
      "content": "*Tro* và *bụi* là hình ảnh nói lên thân phận mỏng giòn của con người.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "11",
      "sortOrder": 10,
      "startOffset": 33,
      "endOffset": 33,
      "createdAt": "2025-09-03T02:23:00.290Z",
