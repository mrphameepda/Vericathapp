      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "65b2785f-ce79-43ec-a4d8-44726948f927",
      "content": "Gió, bão biểu tượng của huỷ diệt và đe doạ.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "13",
      "sortOrder": 12,
      "startOffset": 39,
