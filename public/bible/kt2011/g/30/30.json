{
  "chapter": {
    "id": "7bc72aeb-0062-4af0-8d42-becdffe7df37",
    "number": 30,
    "createdAt": "2025-09-03T01:07:51.633Z",
    "updatedAt": "2025-09-03T01:07:51.633Z",
    "bookId": "1672a600-6214-4bc7-aaa4-9b99684355ac"
  },
  "verses": [
    {
      "id": "7a44c408-1488-4c53-91e9-37afc96bac48",
      "text": "Giờ đây, tôi bị những người ít tuổi hơn nhạo cười,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:59.414Z",
      "updatedAt": "2025-09-03T02:22:59.414Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "8d817a05-dace-46c7-a351-112e537692d7",
      "text": "cha ông họ từng bị tôi khinh dể",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:59.467Z",
      "updatedAt": "2025-09-03T02:22:59.467Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "882be73e-fa27-4a91-a65b-71a3fb608407",
      "text": "và xếp vào hạng chó canh bầy vật.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:59.479Z",
      "updatedAt": "2025-09-03T02:22:59.479Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "78e535d1-d244-4655-8200-106ed40ad978",
      "text": "Cánh tay mạnh mẽ của họ làm gì được cho tôi,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:59.508Z",
      "updatedAt": "2025-09-03T02:22:59.508Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "8368c392-61eb-4395-bd4b-bc12472b053e",
      "text": "sinh lực của họ đã tan biến mất rồi.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:59.522Z",
      "updatedAt": "2025-09-03T02:22:59.522Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "851189c1-6a26-4265-9478-5f4831111ed9",
      "text": "Kiệt lực vì túng thiếu và đói lả :",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:59.535Z",
      "updatedAt": "2025-09-03T02:22:59.535Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "bfd4e4e1-574d-404a-bfec-201d10be308d",
      "text": "họ phải gặm đất khô trong miền đất hoang tàn đổ nát.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:59.550Z",
      "updatedAt": "2025-09-03T02:22:59.550Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "dabf70b7-8d17-4cc7-a3ee-400077cf487b",
      "text": "Họ hái rau lê trong bụi rậm, đào rễ kim tước làm bánh ăn.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:59.577Z",
      "updatedAt": "2025-09-03T02:22:59.577Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "500038f7-6b92-40ae-a395-2b391cdd0382",
      "text": "Họ bị đuổi ra khỏi cộng đoàn, và bị đối xử như quân trộm cắp.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:59.620Z",
      "updatedAt": "2025-09-03T02:22:59.620Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "14be1cf6-4c62-47c1-9f87-cbe427779d7b",
      "text": "Họ phải sống ở bên bờ khe, trong các hầm đất và hốc đá.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:59.650Z",
      "updatedAt": "2025-09-03T02:22:59.650Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "91567cbb-fe38-4656-964b-23042c3acf14",
      "text": "Họ rống lên trong những bụi rậm,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:59.683Z",
      "updatedAt": "2025-09-03T02:22:59.683Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "ac717a7a-0bff-44df-865d-f892ed498d12",
      "text": "chen chúc nhau giữa các đám gai.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:59.712Z",
      "updatedAt": "2025-09-03T02:22:59.712Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "6e4803b4-c1d8-4ae3-9e44-06836c213427",
      "text": "Con cái kẻ ngu si đần độn cũng như con cái kẻ vô danh tiểu tốt",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:59.727Z",
      "updatedAt": "2025-09-03T02:22:59.727Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "6ea5b447-f338-4b38-aef2-fba9bbf37257",
      "text": "bị đánh bật khỏi quê hương xứ sở.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:59.742Z",
      "updatedAt": "2025-09-03T02:22:59.742Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "15c30ac4-7eab-4690-91f2-6b846a8ea9b5",
      "text": "Giờ đây tôi thành cớ cho họ chê cười, nên đề tài cho họ đàm tiếu.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:59.773Z",
      "updatedAt": "2025-09-03T02:22:59.773Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "1f36dc13-ba33-40ed-a104-95d4f8fc51d6",
      "text": "Họ gớm ghiếc và lánh xa tôi,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:59.816Z",
      "updatedAt": "2025-09-03T02:22:59.816Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "9e98f9a0-4590-4075-8713-00bf17881ede",
      "text": "nhổ vào mặt tôi không chút ngần ngại.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:59.830Z",
      "updatedAt": "2025-09-03T02:22:59.830Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "367a6fbc-c33d-4b99-8c6c-b15ade782eab",
      "text": "Bởi vì Thiên Chúa nới lỏng dây cung của tôi,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:59.850Z",
      "updatedAt": "2025-09-03T02:22:59.850Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "f14b6fa1-d780-49c2-bb9c-b789a2b45b8f",
      "text": "Người làm tôi bị nhục, nên họ cũng chẳng coi tôi ra gì.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:59.894Z",
      "updatedAt": "2025-09-03T02:22:59.894Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "22b2ba5d-deec-439e-b553-77c6be68dc37",
      "text": "Bên phải tôi, một đám người nổi dậy,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:59.908Z",
      "updatedAt": "2025-09-03T02:22:59.908Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "447142a6-098d-48c6-ae81-690c2738240c",
      "text": "họ làm tôi trượt chân, còn mở đường cho bất hạnh ập tới.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:59.942Z",
      "updatedAt": "2025-09-03T02:22:59.942Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "0333539b-f93f-4951-a021-a7cd0039504a",
      "text": "Họ phá huỷ con đường tôi đi để tiêu diệt tôi,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:22:59.957Z",
      "updatedAt": "2025-09-03T02:22:59.957Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "094eb552-5a46-4b69-9706-8d0a021d64c0",
      "text": "tiến đánh tôi không cần ai giúp đỡ.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:00.007Z",
      "updatedAt": "2025-09-03T02:23:00.007Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "924bfb8a-9ef8-4635-8cbf-6753f41a2bc1",
      "text": "Họ ùa vào như đi qua một lỗ hổng lớn,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:00.021Z",
      "updatedAt": "2025-09-03T02:23:00.021Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "c9598d35-8e74-4de2-a351-9cb2ec237dbb",
      "text": "băng mình qua đống đổ nát hoang tàn.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:00.034Z",
      "updatedAt": "2025-09-03T02:23:00.034Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "22410c23-f9cd-438c-bd6f-c55b035a3d97",
      "text": "Kinh hoàng lại ập xuống trên tôi,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:00.048Z",
      "updatedAt": "2025-09-03T02:23:00.048Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "18355d1f-6231-4a8b-9046-d84d3ca5b88e",
      "text": "niềm hy vọng của tôi tiêu tan như gió thoảng,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:00.071Z",
      "updatedAt": "2025-09-03T02:23:00.071Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "b683df29-aa96-4890-ae71-2069ac617f43",
      "text": "ơn cứu thoát của tôi biến mất tựa mây bay.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 2,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:00.084Z",
      "updatedAt": "2025-09-03T02:23:00.084Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "3d8d32f4-179f-47af-980a-758912c1faaa",
      "text": "Và giờ đây mạng sống tôi tàn lụi,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:00.112Z",
      "updatedAt": "2025-09-03T02:23:00.112Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "ff916991-3ad1-494b-936b-d15458a0cb79",
      "text": "những ngày khốn khổ vây bọc lấy tôi.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:00.155Z",
      "updatedAt": "2025-09-03T02:23:00.155Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "e07597a8-8298-4b4d-8483-eb57b0726074",
      "text": "Ban đêm, xương cốt tôi đau như bị chọc thủng,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:00.171Z",
      "updatedAt": "2025-09-03T02:23:00.171Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "8ec0f0a1-eba7-445f-943c-8b8bb592a0a6",
      "text": "các vết thương nhức nhối khôn nguôi.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:00.202Z",
      "updatedAt": "2025-09-03T02:23:00.202Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "92bec057-0545-4e3e-86b9-5735d9807faa",
      "text": "Người nắm lấy áo tôi thật chặt, siết vào tôi như cổ áo dài.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:00.216Z",
      "updatedAt": "2025-09-03T02:23:00.216Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "6434c951-2920-4735-82bf-03213c35dc28",
      "text": "Người quăng tôi vào đống bùn nhơ,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:00.246Z",
      "updatedAt": "2025-09-03T02:23:00.246Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "6d4d9c9e-cec4-4f41-b56f-1bf4ad37fd79",
      "text": "khiến tôi trở nên như tro như bụi.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:00.275Z",
      "updatedAt": "2025-09-03T02:23:00.275Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "60f5dd06-5eaf-4e70-a6c8-e8fbf10026ff",
      "text": "Con kêu lên Ngài, nhưng Ngài không đáp,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:00.304Z",
      "updatedAt": "2025-09-03T02:23:00.304Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "e581afdc-58ba-41a7-acf5-648fb3d9763a",
      "text": "con trình diện Ngài, nhưng Ngài chẳng lưu tâm.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:00.348Z",
      "updatedAt": "2025-09-03T02:23:00.348Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "e682a6cf-bb31-4c0d-9d82-f2aa1163317f",
      "text": "Ngài đối xử với con tàn nhẫn,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:00.363Z",
      "updatedAt": "2025-09-03T02:23:00.363Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "05912857-737b-4a19-8e71-dbc0e6b5a412",
      "text": "giương cánh tay mạnh mẽ đánh phạt con.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:00.394Z",
      "updatedAt": "2025-09-03T02:23:00.394Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "bfd431fe-fa30-4cb5-b188-a66e6ab25a7d",
      "text": "Ngài nâng con lên, cho cỡi mây đạp gió,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:00.408Z",
      "updatedAt": "2025-09-03T02:23:00.408Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "a75aab72-eb85-4e2d-8e60-37a9d42f9b49",
      "text": "làm con tan chảy trong dông tố bão bùng.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:00.421Z",
      "updatedAt": "2025-09-03T02:23:00.421Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "ae5c93f2-f6b8-4c04-829f-6276b809a2f4",
      "text": "Quả thật, con biết Ngài bắt con quay về cõi chết,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:00.449Z",
      "updatedAt": "2025-09-03T02:23:00.449Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "c4dfe9bd-d7a6-47d9-8931-506642c6ed03",
      "text": "về nhà hội ngộ của tất cả nhân sinh.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:00.479Z",
      "updatedAt": "2025-09-03T02:23:00.479Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "d749de99-0abc-413e-8527-0f7747db623c",
      "text": "Dù vậy, nào tôi đã chẳng giơ tay trợ giúp",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:00.507Z",
      "updatedAt": "2025-09-03T02:23:00.507Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "d7f41486-e049-43f7-9bc0-53abcb98325b",
      "text": "kẻ khốn cùng kêu cứu lúc lâm nguy ?",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:00.536Z",
      "updatedAt": "2025-09-03T02:23:00.536Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "ff4c9fb7-7a68-4dc8-848e-273a67da939f",
      "text": "Nào tôi đã chẳng khóc người lầm than vất vả,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:00.548Z",
      "updatedAt": "2025-09-03T02:23:00.548Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "424dee33-1019-44eb-8d83-9083e05092ca",
      "text": "chẳng động lòng thương kẻ túng nghèo ?",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:00.582Z",
      "updatedAt": "2025-09-03T02:23:00.582Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "f1692605-4e36-402f-9c50-c00e951b29bf",
      "text": "Tôi mong hạnh phúc, nhưng lại gặp bất hạnh,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:00.598Z",
      "updatedAt": "2025-09-03T02:23:00.598Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "17d4a921-1f99-4aaf-9492-b6b69416facc",
      "text": "chờ ánh sáng, lại gặp tối tăm.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:00.627Z",
      "updatedAt": "2025-09-03T02:23:00.627Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "84194454-81d9-464f-9b2c-1dcd8052ddff",
      "text": "Ruột gan tôi sôi sục không ngừng,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:00.656Z",
      "updatedAt": "2025-09-03T02:23:00.656Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "d3d10be2-1f1d-4e57-b00d-14c48837c7a3",
      "text": "những ngày khốn quẫn ập xuống trên tôi.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:00.702Z",
      "updatedAt": "2025-09-03T02:23:00.702Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "bb664510-6669-4f5a-8c0a-37a5eafd8f10",
      "text": "Tôi bước đi trong tăm tối không ánh mặt trời,",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:00.717Z",
      "updatedAt": "2025-09-03T02:23:00.717Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "e48c1035-0c29-4f5f-a398-e5e63b59ee65",
      "text": "giữa lòng đại hội, tôi đứng lên cầu cứu.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 1,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:00.747Z",
      "updatedAt": "2025-09-03T02:23:00.747Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "4cd1b022-dd7c-422b-9d44-9348e596df4c",
      "text": "Tôi trở thành anh em với chó rừng, nên bạn hữu với đà điểu.",
      "label": "29",
      "number": 29,
      "subVerseIndex": 0,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:00.761Z",
      "updatedAt": "2025-09-03T02:23:00.761Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "2c0b4631-31ed-4568-8922-d973cf77fcc4",
      "text": "Da tôi đã sạm đen, xương cốt bị thiêu trong cơn sốt.",
      "label": "30",
      "number": 30,
      "subVerseIndex": 0,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:00.790Z",
      "updatedAt": "2025-09-03T02:23:00.790Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "b55b0341-bd8f-42d4-97f4-ebf2a322d193",
      "text": "Đàn tôi văng vẳng khúc nhạc sầu, sáo tôi dìu dặt cung ai oán.",
      "label": "31",
      "number": 31,
      "subVerseIndex": 0,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:00.817Z",
      "updatedAt": "2025-09-03T02:23:00.817Z",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    }
  ],
  "marks": [
    {
      "id": "413d0184-8193-4fdd-966d-663e60668914",
      "content": "Cơn khốn cùng hiện tại của ông Gióp do ba yếu tố tạo nên. Trước hết, ông bị những kẻ ít tuổi hơn nhạo cười (30,1-15). Những kẻ này là con cháu của hạng người bị xếp vào loại ưng khuyển. Tiếp đến là chính Thiên Chúa thù nghịch với ông Gióp (30,16-23). Sau cùng, ông Gióp tuyệt vọng cô đơn vì đã bị mọi người bỏ rơi, kể cả Thiên Chúa (30,24-31).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 25,
      "endOffset": 25,
      "createdAt": "2025-09-03T02:22:59.443Z",
      "updatedAt": "2025-09-03T02:22:59.443Z",
      "targetId": "2282f7cc-2828-48eb-b745-9ce8ebee9683",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "eb9e0553-4d42-4716-bea0-4e315856ff79",
      "content": "G 16,1",
      "kind": "MARK_KIND_REFERENCE",
      "label": "1@",
      "sortOrder": 0,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:22:59.455Z",
      "updatedAt": "2025-09-03T02:22:59.455Z",
      "targetId": "7a44c408-1488-4c53-91e9-37afc96bac48",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "167f2580-877d-424b-a5d2-3342cb0c84c9",
      "content": "Kiểu nói bình dân tỏ ý khinh miệt (x. 1 Sm 17,43).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 19,
      "endOffset": 19,
      "createdAt": "2025-09-03T02:22:59.494Z",
      "updatedAt": "2025-09-03T02:22:59.494Z",
      "targetId": "882be73e-fa27-4a91-a65b-71a3fb608407",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "47df6c49-9c89-45f1-aed6-33ebae9c8a58",
      "content": "G 24,5",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 31,
      "endOffset": 31,
      "createdAt": "2025-09-03T02:22:59.563Z",
      "updatedAt": "2025-09-03T02:22:59.563Z",
      "targetId": "bfd4e4e1-574d-404a-bfec-201d10be308d",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "d68f7191-1980-4082-ab19-20a146d1482c",
      "content": "*Rau lê* là lương thực cho người nghèo đói. Còn *rễ kim tước* thường được dùng làm chất đốt hơn là làm lương thực. Khi đói quá, người ta ăn cả rễ cây cho no bụng, dù không chất dinh dưỡng.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 56,
      "endOffset": 56,
      "createdAt": "2025-09-03T02:22:59.592Z",
      "updatedAt": "2025-09-03T02:22:59.592Z",
      "targetId": "dabf70b7-8d17-4cc7-a3ee-400077cf487b",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "a0f320ad-f69f-40be-8473-3e8e122cf46b",
      "content": "G 24,24",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 7,
      "endOffset": 7,
      "createdAt": "2025-09-03T02:22:59.606Z",
      "updatedAt": "2025-09-03T02:22:59.606Z",
      "targetId": "dabf70b7-8d17-4cc7-a3ee-400077cf487b",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "9acf18ea-0c5b-4bbb-84a7-bdc084be20a3",
      "content": "Nghèo đói, theo quan niệm xưa của người Do-thái, là một điều chúc dữ. Có lẽ vì thế mà những người nghèo bị loại trừ khỏi cộng đoàn ? Nhưng như vậy trái với tinh thần của Lề Luật và lời dạy của các ngôn sứ về cách đối xử với người nghèo túng.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 28,
      "endOffset": 28,
      "createdAt": "2025-09-03T02:22:59.635Z",
      "updatedAt": "2025-09-03T02:22:59.635Z",
      "targetId": "500038f7-6b92-40ae-a395-2b391cdd0382",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "97bfc934-30d7-4c71-8474-c59496a789b2",
      "content": "Tl 6,2",
      "kind": "MARK_KIND_REFERENCE",
      "label": "4@",
      "sortOrder": 3,
      "startOffset": 48,
      "endOffset": 48,
      "createdAt": "2025-09-03T02:22:59.667Z",
      "updatedAt": "2025-09-03T02:22:59.667Z",
      "targetId": "14be1cf6-4c62-47c1-9f87-cbe427779d7b",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "48d7d539-6cfb-414c-afa1-d7aaa382f095",
      "content": "1 Sm 13,6",
      "kind": "MARK_KIND_REFERENCE",
      "label": "5@",
      "sortOrder": 4,
      "startOffset": 24,
      "endOffset": 24,
      "createdAt": "2025-09-03T02:22:59.698Z",
      "updatedAt": "2025-09-03T02:22:59.698Z",
      "targetId": "91567cbb-fe38-4656-964b-23042c3acf14",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "a1360435-a332-40e7-bf99-f7e704c1e38f",
      "content": "Hoàn cảnh khốn cùng của ông Gióp : ông bị con cháu những người ông khinh dể trả thù.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "5",
      "sortOrder": 4,
      "startOffset": 7,
      "endOffset": 7,
      "createdAt": "2025-09-03T02:22:59.788Z",
      "updatedAt": "2025-09-03T02:22:59.788Z",
      "targetId": "15c30ac4-7eab-4690-91f2-6b846a8ea9b5",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "ce4d00cc-61db-4673-a0fb-65d61ec1f8f2",
      "content": "Tl 11,2",
      "kind": "MARK_KIND_REFERENCE",
      "label": "6@",
      "sortOrder": 5,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:22:59.757Z",
      "updatedAt": "2025-09-03T02:22:59.757Z",
      "targetId": "6ea5b447-f338-4b38-aef2-fba9bbf37257",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "c1f65e20-27c8-4864-b169-7e55b1be2a6c",
      "content": "Hình ảnh cuộc chiến. Thiên Chúa đẩy ông Gióp vào đường cùng để cho ông bị sỉ nhục, không còn cách chống đỡ.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "6",
      "sortOrder": 5,
      "startOffset": 43,
      "endOffset": 43,
      "createdAt": "2025-09-03T02:22:59.865Z",
      "updatedAt": "2025-09-03T02:22:59.865Z",
      "targetId": "367a6fbc-c33d-4b99-8c6c-b15ade782eab",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "acde6a72-ef24-4151-a988-638432b6df9c",
      "content": "G 16,7-11; Tv 69,13; Ac 3,14",
      "kind": "MARK_KIND_REFERENCE",
      "label": "7@",
      "sortOrder": 6,
      "startOffset": 18,
      "endOffset": 18,
      "createdAt": "2025-09-03T02:22:59.802Z",
      "updatedAt": "2025-09-03T02:22:59.802Z",
      "targetId": "15c30ac4-7eab-4690-91f2-6b846a8ea9b5",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "652f4c9d-2a51-4396-b722-e315dc0d78c4",
      "content": "Không còn đường rút lui tất phải chết.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "7",
      "sortOrder": 6,
      "startOffset": 27,
      "endOffset": 27,
      "createdAt": "2025-09-03T02:22:59.972Z",
      "updatedAt": "2025-09-03T02:22:59.972Z",
      "targetId": "0333539b-f93f-4951-a021-a7cd0039504a",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "72fb5012-b60d-463e-bd72-58804bac90ac",
      "content": "G 29,20",
      "kind": "MARK_KIND_REFERENCE",
      "label": "8@",
      "sortOrder": 7,
      "startOffset": 27,
      "endOffset": 27,
      "createdAt": "2025-09-03T02:22:59.879Z",
      "updatedAt": "2025-09-03T02:22:59.879Z",
      "targetId": "367a6fbc-c33d-4b99-8c6c-b15ade782eab",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "8d7f39a4-9524-4220-bb9d-4025721df26c",
