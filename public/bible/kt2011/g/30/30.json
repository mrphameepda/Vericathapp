      "content": "G 33,19",
      "kind": "MARK_KIND_REFERENCE",
      "label": "13@",
      "sortOrder": 12,
      "startOffset": 9,
      "endOffset": 9,
      "createdAt": "2025-09-03T02:23:00.188Z",
      "updatedAt": "2025-09-03T02:23:00.188Z",
