      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7bc72aeb-0062-4af0-8d42-becdffe7df37"
    },
    {
      "id": "f5c94196-9306-471e-8d5b-1f6d1b80476f",
      "content": "G 16,11",
      "kind": "MARK_KIND_REFERENCE",
      "label": "10@",
      "sortOrder": 9,
      "startOffset": 31,
      "endOffset": 31,
      "createdAt": "2025-09-03T02:22:59.994Z",
