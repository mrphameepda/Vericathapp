    },
    {
      "id": "d7a5c87c-cfda-42fa-853e-4a939fa5257f",
      "content": "Cc. 20-23 : ông Gióp nói trực tiếp với Thiên Chúa. Ông không còn hy vọng sống nữa, vì Thiên Chúa bắt ông phải chết.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "12",
      "sortOrder": 11,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:23:00.319Z",
