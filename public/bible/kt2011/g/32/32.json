      "chapterId": "108ba763-a8f9-4c26-aa00-579729a3af0b"
    },
    {
      "id": "6b986779-6a70-4cee-99e4-dcaa10f3094d",
      "text": "Ông Ê-li-hu can thiệp",
      "level": 2,
      "sortOrder": 1,
      "createdAt": "2025-09-03T02:23:22.259Z",
      "updatedAt": "2025-09-03T02:23:22.259Z",
