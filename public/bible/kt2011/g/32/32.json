    },
    {
      "id": "db1f79aa-44d3-436e-94b9-ed6f8d49f294",
      "text": "Lời mở đầu",
      "level": 2,
      "sortOrder": 0,
      "createdAt": "2025-09-03T02:23:22.611Z",
      "updatedAt": "2025-09-03T02:23:22.611Z",
