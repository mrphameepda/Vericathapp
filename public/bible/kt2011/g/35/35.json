{
  "chapter": {
    "id": "7bdcabe4-650b-4500-8488-0274ed9368ce",
    "number": 35,
    "createdAt": "2025-09-03T01:07:51.633Z",
    "updatedAt": "2025-09-03T01:07:51.633Z",
    "bookId": "1672a600-6214-4bc7-aaa4-9b99684355ac"
  },
  "verses": [
    {
      "id": "9d8dfa8c-99ad-4aa9-8cf8-cf3d08f18a2d",
      "text": "Ông Ê-li-hu lại lên tiếng nói :",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:23:44.026Z",
      "updatedAt": "2025-09-03T02:23:44.026Z",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    },
    {
      "id": "ff3bec05-5e7d-49d8-a998-a84f0e8683e2",
      "text": "Ông tưởng mình chính trực hay sao",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:44.089Z",
      "updatedAt": "2025-09-03T02:23:44.089Z",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    },
    {
      "id": "9d3698be-f58e-4d0c-a1a0-904602196296",
      "text": "khi nói rằng : “Tôi công chính hơn Thiên Chúa”",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:44.103Z",
      "updatedAt": "2025-09-03T02:23:44.103Z",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    },
    {
      "id": "fd1bbeaa-c8ab-4073-9937-515bc43edb93",
      "text": "hay khi nói : “Nếu tôi không phạm tội,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:44.148Z",
      "updatedAt": "2025-09-03T02:23:44.148Z",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    },
    {
      "id": "1cbf40c5-cfb9-4c94-9ec9-8da938272bdf",
      "text": "có hệ chi đến Ngài hay ích gì cho tôi ?”",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:44.177Z",
      "updatedAt": "2025-09-03T02:23:44.177Z",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    },
    {
      "id": "cc2eb34a-e997-43e5-996e-f1edbae2d190",
      "text": "Chính tôi sẽ trả lời cho ông",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:44.207Z",
      "updatedAt": "2025-09-03T02:23:44.207Z",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    },
    {
      "id": "f10ca8aa-7c2c-437a-bc4f-d9a1ea2d1e74",
      "text": "và cho các bạn ông cùng một lúc.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:44.221Z",
      "updatedAt": "2025-09-03T02:23:44.221Z",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    },
    {
      "id": "32a25aa8-885c-420b-96bd-d85a171ce5fb",
      "text": "Hãy nhìn lên bầu trời mà ngắm xem :",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:44.250Z",
      "updatedAt": "2025-09-03T02:23:44.250Z",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    },
    {
      "id": "e3887aff-cc3f-488a-ad5e-df90109a7600",
      "text": "các tầng mây cao hơn ông biết mấy !",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:44.295Z",
      "updatedAt": "2025-09-03T02:23:44.295Z",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    },
    {
      "id": "5210d88a-2bf9-4995-87d2-30dc5f18e040",
      "text": "Giả như ông phạm tội, ông làm chi được Người,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:44.310Z",
      "updatedAt": "2025-09-03T02:23:44.310Z",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    },
    {
      "id": "90c11277-b7d1-4a2e-8bb3-6faf3a2ffeb9",
      "text": "ông gia tăng tội ác, có hại được Người không ?",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:44.353Z",
      "updatedAt": "2025-09-03T02:23:44.353Z",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    },
    {
      "id": "26847939-6e4a-4b43-8c9a-7cfdba6bab93",
      "text": "Nếu ông công chính, ông đem lại chi cho Người,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:44.367Z",
      "updatedAt": "2025-09-03T02:23:44.367Z",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    },
    {
      "id": "b3b728d0-8e0d-43a3-85fc-54f38c527c7b",
      "text": "liệu Người sẽ nhận được gì từ tay ông ?",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:44.395Z",
      "updatedAt": "2025-09-03T02:23:44.395Z",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    },
    {
      "id": "beb56e5b-6a7a-481e-9357-a2cdbb75740b",
      "text": "Tội ác của ông chỉ hại cho loài người,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:44.410Z",
      "updatedAt": "2025-09-03T02:23:44.410Z",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    },
    {
      "id": "dcc984c3-c0ac-4e27-80ff-dd6cfdb1b105",
      "text": "lòng đạo của ông chỉ lợi cho phàm nhân.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:44.441Z",
      "updatedAt": "2025-09-03T02:23:44.441Z",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    },
    {
      "id": "6a73a247-9425-483c-a4df-bfc69555a140",
      "text": "Bị ức hiếp dã man, người ta rên rỉ",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:44.469Z",
      "updatedAt": "2025-09-03T02:23:44.469Z",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    },
    {
      "id": "6939b867-1675-4e15-aa1d-5ce91a775042",
      "text": "và van xin khi bị kẻ cường quyền đàn áp.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:44.513Z",
      "updatedAt": "2025-09-03T02:23:44.513Z",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    },
    {
      "id": "e1aed3f2-0bfb-4743-a9d3-4f57b4177894",
      "text": "Nhưng chẳng ai buồn hỏi : “Thiên Chúa ở đâu rồi,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:44.526Z",
      "updatedAt": "2025-09-03T02:23:44.526Z",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    },
    {
      "id": "461a0deb-514c-4880-9aea-441d9c51f5e3",
      "text": "Người là Đấng đã tạo thành tôi,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:44.542Z",
      "updatedAt": "2025-09-03T02:23:44.542Z",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    },
    {
      "id": "35a7d245-ac46-4764-ae20-4334a4dcb35b",
      "text": "đã làm vọng lên bao ca khúc giữa đêm trường,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:44.574Z",
      "updatedAt": "2025-09-03T02:23:44.574Z",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    },
    {
      "id": "ff7113f3-bc66-415f-9629-9364bb41d2a2",
      "text": "Người là Đấng cho chúng ta hiểu biết hơn dã thú,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:44.601Z",
      "updatedAt": "2025-09-03T02:23:44.601Z",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    },
    {
      "id": "3eff277c-b913-4073-9d1d-17a4a8ec2f31",
      "text": "khôn ngoan hơn chim trời ?”",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:44.624Z",
      "updatedAt": "2025-09-03T02:23:44.624Z",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    },
    {
      "id": "afee56d0-6ede-4ab1-bdd7-044c4ee5eafa",
      "text": "Bấy giờ nghe kêu cứu, Người cũng không đáp lại,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:44.648Z",
      "updatedAt": "2025-09-03T02:23:44.648Z",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    },
    {
      "id": "7745c6e9-47c1-49e0-b02a-5f5ed57c4e5d",
      "text": "vì kẻ gian ác vẫn còn ngạo mạn kiêu căng.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:44.662Z",
      "updatedAt": "2025-09-03T02:23:44.662Z",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    },
    {
      "id": "50648b1f-22bc-41aa-9d33-dce38d0cfe4f",
      "text": "Thật là công dã tràng :",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:44.676Z",
      "updatedAt": "2025-09-03T02:23:44.676Z",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    },
    {
      "id": "499d1bdf-f7b9-43a5-9b3f-bded439ffee4",
      "text": "Thiên Chúa chẳng hề nghe, Đấng Toàn Năng không thấy.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:44.705Z",
      "updatedAt": "2025-09-03T02:23:44.705Z",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    },
    {
      "id": "c8d4fbb5-cad1-4420-b339-c303fad9317c",
      "text": "Người lại càng không trả lời ông",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:44.764Z",
      "updatedAt": "2025-09-03T02:23:44.764Z",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    },
    {
      "id": "ab90987d-cb41-4928-bc76-0458f859dea2",
      "text": "khi ông nói : ông không thấy Người,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:44.778Z",
      "updatedAt": "2025-09-03T02:23:44.778Z",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    },
    {
      "id": "61425e77-38b9-4073-a6ba-6e32c90b4173",
      "text": "và sau khi trình bày với Người vụ kiện của ông,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 2,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:44.810Z",
      "updatedAt": "2025-09-03T02:23:44.810Z",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    },
    {
      "id": "6fc86d66-3684-4e76-b30c-df4a7c7fb942",
      "text": "ông vẫn luôn chờ đợi ;",
      "label": "14",
      "number": 14,
      "subVerseIndex": 3,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:44.825Z",
      "updatedAt": "2025-09-03T02:23:44.825Z",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    },
    {
      "id": "17527af3-5bea-44e5-8309-9414b82ef407",
      "text": "hay khi ông nói : Người không vì giận mà trừng phạt,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:44.853Z",
      "updatedAt": "2025-09-03T02:23:44.853Z",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    },
    {
      "id": "448e59c8-5a3f-4aa9-9d45-fb6a111201a1",
      "text": "âu cũng là vì Người chẳng quan tâm",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:44.869Z",
      "updatedAt": "2025-09-03T02:23:44.869Z",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    },
    {
      "id": "e1d29f3c-c5a5-4b69-bbd5-3e398d02af16",
      "text": "đến tội phản trắc của loài người.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 2,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:44.898Z",
      "updatedAt": "2025-09-03T02:23:44.898Z",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    },
    {
      "id": "18e73593-afb9-44e8-a973-d43cfb41de5d",
      "text": "Tôi nghĩ rằng : ông Gióp mở miệng nói chuyện không đâu,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:44.912Z",
      "updatedAt": "2025-09-03T02:23:44.912Z",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    },
    {
      "id": "75fb7682-39af-4005-9164-92338f2463ae",
      "text": "vì thiếu hiểu biết mà dài dòng văn tự.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:44.943Z",
      "updatedAt": "2025-09-03T02:23:44.943Z",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    }
  ],
