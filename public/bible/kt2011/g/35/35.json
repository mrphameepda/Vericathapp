      "targetId": "beb56e5b-6a7a-481e-9357-a2cdbb75740b",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    },
    {
      "id": "be88f77c-6a9e-49be-8d46-ba4770fc73b2",
      "content": "Điều tốt hay điều xấu của con người chỉ ảnh hưởng trên phàm nhân, chứ không thể làm lợi hay gây hại cho Thiên Chúa.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "7",
      "sortOrder": 6,
      "startOffset": 38,
      "endOffset": 38,
      "createdAt": "2025-09-03T02:23:44.454Z",
      "updatedAt": "2025-09-03T02:23:44.454Z",
      "targetId": "dcc984c3-c0ac-4e27-80ff-dd6cfdb1b105",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    },
    {
      "id": "008b7269-c877-4649-a768-8a8c6c9193c0",
      "content": "Nói chung, không phải ông Gióp là người áp bức hay gây cản trở giúp đỡ kẻ bị áp bức.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "8",
      "sortOrder": 7,
      "startOffset": 17,
      "endOffset": 17,
      "createdAt": "2025-09-03T02:23:44.484Z",
