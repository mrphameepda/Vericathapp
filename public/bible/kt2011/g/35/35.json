      "content": "G 22,3",
      "kind": "MARK_KIND_REFERENCE",
      "label": "6@",
      "sortOrder": 5,
      "startOffset": 8,
      "endOffset": 8,
      "createdAt": "2025-09-03T02:23:44.381Z",
