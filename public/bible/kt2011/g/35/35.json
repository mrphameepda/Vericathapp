      "targetId": "32a25aa8-885c-420b-96bd-d85a171ce5fb",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    },
    {
      "id": "24ceb310-330f-4da5-9e67-f600557f250b",
      "content": "G 7,20",
      "kind": "MARK_KIND_REFERENCE",
      "label": "5@",
      "sortOrder": 4,
      "startOffset": 26,
      "endOffset": 26,
      "createdAt": "2025-09-03T02:23:44.339Z",
      "updatedAt": "2025-09-03T02:23:44.339Z",
      "targetId": "5210d88a-2bf9-4995-87d2-30dc5f18e040",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    },
    {
      "id": "ae4f4fd5-18ff-4140-bc74-ad66860d3321",
      "content": "Cc. 6-7 lặp lại ý kiến của ông Ê-li-phát (x. 22,2-4), và của ông Gióp (x. 7,20).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "6",
      "sortOrder": 5,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:23:44.324Z",
