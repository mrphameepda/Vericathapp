    },
    {
      "id": "8db16b33-1d13-4a69-8c9c-32de799b5e31",
      "content": "Gr 7,19",
      "kind": "MARK_KIND_REFERENCE",
      "label": "7@",
      "sortOrder": 6,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:23:44.426Z",
