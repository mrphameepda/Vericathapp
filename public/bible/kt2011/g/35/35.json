    },
    {
      "id": "754ec56a-d124-4307-a452-c84eccc79ed0",
      "content": "G 32,1",
      "kind": "MARK_KIND_REFERENCE",
      "label": "1@",
      "sortOrder": 0,
      "startOffset": 20,
      "endOffset": 20,
      "createdAt": "2025-09-03T02:23:44.133Z",
      "updatedAt": "2025-09-03T02:23:44.133Z",
      "targetId": "9d3698be-f58e-4d0c-a1a0-904602196296",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    },
    {
      "id": "702f726b-3f01-480c-b789-bc309fadac5e",
      "content": "Trong chương này, ông Ê-li-hu nói cho ông Gióp biết tội kiêu ngạo của ông thật quá đáng (35,2-4). Con người không thể chống chọi lại được Thiên Chúa, vì Người ngự chốn trời cao (35,5-8). Người cũng không cứu giúp những kẻ bị ức hiếp kêu cầu Người (35,9-13). Còn đối với ông Gióp, Thiên Chúa không thèm đoái hoài vụ kiện ông tố Người (35,14-16). Kết luận : ông Gióp có biện minh cho mình cũng hoài công vô ích (35,16).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 29,
      "endOffset": 29,
      "createdAt": "2025-09-03T02:23:44.075Z",
      "updatedAt": "2025-09-03T02:23:44.075Z",
      "targetId": "9d8dfa8c-99ad-4aa9-8cf8-cf3d08f18a2d",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    },
    {
      "id": "a7cf621a-ee8d-4505-a248-911bbda0161f",
      "content": "G 7,20",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:23:44.192Z",
      "updatedAt": "2025-09-03T02:23:44.192Z",
      "targetId": "1cbf40c5-cfb9-4c94-9ec9-8da938272bdf",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    },
    {
      "id": "04117e21-7c10-4225-8eaa-c2934ee084aa",
      "content": "Ông Gióp không nói như vậy. Tuy nhiên, ông vẫn chắc chắn là mình sống công chính.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 46,
      "endOffset": 46,
      "createdAt": "2025-09-03T02:23:44.118Z",
      "updatedAt": "2025-09-03T02:23:44.118Z",
      "targetId": "9d3698be-f58e-4d0c-a1a0-904602196296",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    },
    {
      "id": "acbad9c9-235f-4675-a1ce-27351df74447",
      "content": "G 32,14",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:23:44.236Z",
      "updatedAt": "2025-09-03T02:23:44.236Z",
      "targetId": "f10ca8aa-7c2c-437a-bc4f-d9a1ea2d1e74",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    },
    {
      "id": "8e30bd69-13f8-4a47-97ad-a6f034cf85d8",
      "content": "Các bạn của ông Gióp cũng như ông Ê-li-hu khẳng định ông Gióp đã phạm tội, nên bây giờ mới chịu hình phạt nặng nề.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 37,
      "endOffset": 37,
      "createdAt": "2025-09-03T02:23:44.162Z",
      "updatedAt": "2025-09-03T02:23:44.162Z",
      "targetId": "fd1bbeaa-c8ab-4073-9937-515bc43edb93",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7bdcabe4-650b-4500-8488-0274ed9368ce"
    },
    {
      "id": "6b89db6f-4450-4b95-bf9c-45a824d26bf2",
      "content": "G 11,8; 22,12",
      "kind": "MARK_KIND_REFERENCE",
      "label": "4@",
      "sortOrder": 3,
      "startOffset": 13,
      "endOffset": 13,
      "createdAt": "2025-09-03T02:23:44.280Z",
      "updatedAt": "2025-09-03T02:23:44.280Z",
