      "startOffset": 20,
      "endOffset": 20,
      "createdAt": "2025-09-03T02:23:58.750Z",
      "updatedAt": "2025-09-03T02:23:58.750Z",
      "targetId": "7e835981-3603-4716-9249-7dba4a89e0fe",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "e15a135f-fdcd-473d-8d74-a049c192fe6d",
      "content": "Hai câu 37,15-16 là câu hỏi mào đầu cho lời Thiên Chúa dạy bảo.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "9",
      "sortOrder": 8,
      "startOffset": 4,
      "endOffset": 4,
      "createdAt": "2025-09-03T02:23:58.779Z",
      "updatedAt": "2025-09-03T02:23:58.779Z",
      "targetId": "448b8f1b-a198-43dd-a08e-303d0b01e81f",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "a802bc7c-06f4-40e6-84ee-0c836445f6b9",
      "content": "St 1,6",
      "kind": "MARK_KIND_REFERENCE",
      "label": "10@",
      "sortOrder": 9,
      "startOffset": 32,
      "endOffset": 32,
      "createdAt": "2025-09-03T02:23:58.822Z",
      "updatedAt": "2025-09-03T02:23:58.822Z",
      "targetId": "af048360-e3ba-435f-8174-37a857d42bd3",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "4a023f07-92b1-4f84-b94a-16eee0319601",
      "content": "Đối với xứ Ê-đôm, sa mạc Ả-rập nằm về phía nam. Khi gió nam thổi mạnh tựa như cơn giông bão, gió đưa hơi nóng khiến người ta cảm thấy dường như quần áo mình đang mặc trở nên nóng bỏng. Gió nóng có thể làm cho người hay súc vật phải chết.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "10",
      "sortOrder": 9,
      "startOffset": 39,
      "endOffset": 39,
      "createdAt": "2025-09-03T02:23:58.866Z",
      "updatedAt": "2025-09-03T02:23:58.866Z",
      "targetId": "fa086ee1-c5ad-42ee-812b-a5ab2188b416",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "857c460a-4de3-4e56-acbe-67c463454cfa",
      "content": "Ngày xưa, gương soi là một tấm đồng được đánh bóng (x. Xh 38,8). Quan niệm vũ trụ của dân Ít-ra-en cho bầu trời là cái vòm chắc tách hai kho nước phía trên phía dưới (x. St 1,6). Trong Đnl 28,23, bầu trời vào lúc hạn hán trông như một tấm gương đồng.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "11",
      "sortOrder": 10,
      "startOffset": 32,
      "endOffset": 32,
      "createdAt": "2025-09-03T02:23:58.924Z",
      "updatedAt": "2025-09-03T02:23:58.924Z",
      "targetId": "e2403b0b-2ab2-432c-87d3-05f740b35744",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "094f41ef-da59-4faf-810b-f042c41766a2",
      "content": "Xh 24,16",
      "kind": "MARK_KIND_REFERENCE",
      "label": "11@",
      "sortOrder": 10,
      "startOffset": 15,
      "endOffset": 15,
      "createdAt": "2025-09-03T02:23:59.140Z",
      "updatedAt": "2025-09-03T02:23:59.140Z",
      "targetId": "f656592b-4a2e-4e8e-9224-57d491bb27d3",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "4bace929-22ba-45b6-b50a-cccb768db29a",
      "content": "English: Sin | French: Sin | Latin: Sin | Origin: &#1505;&#1460;&#1497;&#1503; | Vietnamese: Xin 1 -- sa mạc trong cuộc Xuất hành, Xh 16,1 ; Ds 33,11-12",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "12",
      "sortOrder": 11,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:23:58.953Z",
      "updatedAt": "2025-09-03T02:23:58.953Z",
      "targetId": "992f5ca5-b279-4516-a86e-c3bde8290941",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "1e4c4912-478c-409a-a7e2-1839c660a179",
      "content": "Is 6,5",
      "kind": "MARK_KIND_REFERENCE",
      "label": "12@",
      "sortOrder": 11,
      "startOffset": 28,
      "endOffset": 28,
      "createdAt": "2025-09-03T02:23:59.183Z",
      "updatedAt": "2025-09-03T02:23:59.183Z",
      "targetId": "7ee77ecf-c156-4df8-a50f-084de6c26310",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "f2b69e55-c44d-4a93-b96b-1a95d5f88d57",
      "content": "Dùng hình ảnh mây che khuất ánh sáng (mặt trời), tác giả ám chỉ tư tưởng nông cạn của con người không thể hiểu thấu ý định của Thiên Chúa.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "13",
      "sortOrder": 12,
      "startOffset": 22,
      "endOffset": 22,
      "createdAt": "2025-09-03T02:23:59.068Z",
      "updatedAt": "2025-09-03T02:23:59.068Z",
      "targetId": "41c53ff9-8756-49dd-b022-28aac0255abf",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "04e946ee-1046-4e84-bef7-8bc9cb8974f5",
      "content": "Ám chỉ sự xuất hiện của Thiên Chúa. Người hùng mạnh và công minh trong mọi hành động, nhưng đầy tình thương.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "14",
      "sortOrder": 13,
      "startOffset": 51,
      "endOffset": 51,
      "createdAt": "2025-09-03T02:23:59.111Z",
      "updatedAt": "2025-09-03T02:23:59.111Z",
      "targetId": "9c736be4-04c7-4480-9ce7-f50b3a47f756",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "5ff21541-bca1-4ccf-bc27-a9b1a388f7ec",
      "content": "English: El-Shaddai | French: Dieu Puissant | Latin: Deus omnipotens | Origin: &#64298;&#1463;&#1491;&#1468;&#1464;&#1497; | Vietnamese: Đấng Toàn Năng -- Xh 6,3",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "15",
      "sortOrder": 14,
      "startOffset": 23,
      "endOffset": 23,
      "createdAt": "2025-09-03T02:23:59.168Z",
      "updatedAt": "2025-09-03T02:23:59.168Z",
      "targetId": "7ee77ecf-c156-4df8-a50f-084de6c26310",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "013ced60-afc1-4451-a960-63bf5052bb93",
      "content": "Ông Ê-li-hu biến mất khỏi sách một cách đột ngột giống như khi ông xuất hiện. Người ta sẽ không nhắc tới ông trong phần kết.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "16",
      "sortOrder": 15,
      "startOffset": 34,
      "endOffset": 34,
      "createdAt": "2025-09-03T02:23:59.276Z",
      "updatedAt": "2025-09-03T02:23:59.276Z",
      "targetId": "26fb76d0-d47e-4be2-b3b6-34080dc6e5a2",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    }
  ],
