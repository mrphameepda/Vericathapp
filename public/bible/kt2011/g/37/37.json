{
  "chapter": {
    "id": "902f953c-0048-4a00-b4b5-3968a93188f1",
    "number": 37,
    "createdAt": "2025-09-03T01:07:51.633Z",
    "updatedAt": "2025-09-03T01:07:51.633Z",
    "bookId": "1672a600-6214-4bc7-aaa4-9b99684355ac"
  },
  "verses": [
    {
      "id": "baa4249b-09c6-4ec7-add0-b575ccb52a53",
      "text": "Chính vì thế mà tim tôi run lẩy bẩy,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:58.091Z",
      "updatedAt": "2025-09-03T02:23:58.091Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "f525e7fd-4fb8-43a8-8375-6311e44fc9ce",
      "text": "như thể muốn nhảy tung ra ngoài.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:58.128Z",
      "updatedAt": "2025-09-03T02:23:58.128Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "9efb3340-a62b-43fb-ac30-3fb901adb0bf",
      "text": "Hãy lắng nghe tiếng Người gầm thét",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:58.142Z",
      "updatedAt": "2025-09-03T02:23:58.142Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "581ec298-618f-44e2-b982-6dc49dceb247",
      "text": "và tiếng Người mở miệng thì thầm.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:58.172Z",
      "updatedAt": "2025-09-03T02:23:58.172Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "ee555119-0bf1-43c8-a6aa-73afa35cee9a",
      "text": "Khắp chín tầng trời, Người khiến sấm ầm vang",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:58.186Z",
      "updatedAt": "2025-09-03T02:23:58.186Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "b6b817ab-95e7-447a-9d5b-04195ce34c44",
      "text": "và cho chớp loé cả mười phương đất.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:58.200Z",
      "updatedAt": "2025-09-03T02:23:58.200Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "74c35537-98c7-4e54-b392-c83550ee594d",
      "text": "Phía sau Người, một tiếng gầm vang dội,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:58.228Z",
      "updatedAt": "2025-09-03T02:23:58.228Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "dfc51b6f-26a0-4320-a3ad-b5bc1a72e066",
      "text": "Người nổi sấm, dõng dạc oai hùng.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:58.243Z",
      "updatedAt": "2025-09-03T02:23:58.243Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "0f303a96-27a3-4122-a9df-0dc5cda546fe",
      "text": "Tiếng Người phán ra, chúng không chần chừ nữa.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:58.272Z",
      "updatedAt": "2025-09-03T02:23:58.272Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "009eb128-0290-4073-bf6a-756dfdb85fdd",
      "text": "Thiên Chúa cho nổi sấm mà loan báo những kỳ công,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:58.287Z",
      "updatedAt": "2025-09-03T02:23:58.287Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "4bdfc37c-81af-46a4-9ed2-9bf2b1c86320",
      "text": "Người thực hiện những việc lớn lao ta không hiểu thấu.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:58.316Z",
      "updatedAt": "2025-09-03T02:23:58.316Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "4c9affec-d81b-4121-8b5a-35acf1493840",
      "text": "Người ra lệnh cho tuyết : “Sa xuống đất đi !”",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:58.330Z",
      "updatedAt": "2025-09-03T02:23:58.330Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "6bdddb89-3ab1-4b65-80db-f3c18620a278",
      "text": "Rồi bảo với mưa rào : “Rơi cho nặng hạt !”",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:58.360Z",
      "updatedAt": "2025-09-03T02:23:58.360Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "28aeaf64-007a-4d35-938b-4e02c249573b",
      "text": "Người trói tay hết mọi người phàm",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:58.389Z",
      "updatedAt": "2025-09-03T02:23:58.389Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "5e0f2103-5db2-4229-91a2-d6c9a31f1020",
      "text": "để ai nấy nhận ra công trình Người thực hiện.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:58.417Z",
      "updatedAt": "2025-09-03T02:23:58.417Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "fe3521c3-dd4d-45d3-9421-1134306bb39a",
      "text": "Muông thú trở về hang, và nghỉ yên tại đó.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:58.435Z",
      "updatedAt": "2025-09-03T02:23:58.435Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "f3625863-2467-41ef-97ec-4f6cf43eb83f",
      "text": "Từ phương nam, gió lốc ào ào thổi",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:58.477Z",
      "updatedAt": "2025-09-03T02:23:58.477Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "db8b385a-875a-4db5-a254-dd19ed453a5e",
      "text": "và từ phương bắc gió lạnh tràn về.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:58.491Z",
      "updatedAt": "2025-09-03T02:23:58.491Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "9c2b3042-2fd1-4dbd-bcf1-f89eda2de67b",
      "text": "Thiên Chúa thở hơi, làm nên băng giá,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:58.505Z",
      "updatedAt": "2025-09-03T02:23:58.505Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "d7549396-0ca5-460b-9f04-54f9e441eab3",
      "text": "khiến cho mặt nước đông đặc lại.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:58.534Z",
      "updatedAt": "2025-09-03T02:23:58.534Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "b148613a-f651-49a0-84f0-3924ead65f0b",
      "text": "Người dùng hơi nước tạo thành mây,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:58.564Z",
      "updatedAt": "2025-09-03T02:23:58.564Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "e9033306-e3a5-44fa-9d61-30e81fcadbab",
      "text": "và từ mây, Người làm cho chớp loé.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:58.579Z",
      "updatedAt": "2025-09-03T02:23:58.579Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "841c3b55-f2ed-415e-b5bc-0d3e03f52b29",
      "text": "Mây lang thang, xoay đủ mọi chiều,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:58.593Z",
      "updatedAt": "2025-09-03T02:23:58.593Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "c2f5ce47-01e6-4b8f-9e3b-3e2246e48859",
      "text": "theo đúng chương trình Người hoạch định,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:58.608Z",
      "updatedAt": "2025-09-03T02:23:58.608Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "b8b28b92-1c49-45eb-bc8c-c04aa00a8f6c",
      "text": "để trên toàn cõi đất chúng thực thi mọi lệnh Người truyền.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:58.621Z",
      "updatedAt": "2025-09-03T02:23:58.621Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "34b24145-67d5-4df4-8507-c42a999a6111",
      "text": "Người sai mây đi, có khi để trừng phạt, có khi nhằm giáng phúc.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:58.649Z",
      "updatedAt": "2025-09-03T02:23:58.649Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "9d1099bf-7e6f-45ba-a11c-88bd0b3b1305",
      "text": "Này ông Gióp, xin hãy lắng tai nghe,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:58.679Z",
      "updatedAt": "2025-09-03T02:23:58.679Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "b06a89fd-3c1e-49bc-93bb-3c1a13250e59",
      "text": "bao kỳ công của Thiên Chúa,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:58.721Z",
      "updatedAt": "2025-09-03T02:23:58.721Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "7e835981-3603-4716-9249-7dba4a89e0fe",
      "text": "ông hãy đứng lên và ngắm xem cho kỹ.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 2,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:58.736Z",
      "updatedAt": "2025-09-03T02:23:58.736Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "448b8f1b-a198-43dd-a08e-303d0b01e81f",
      "text": "Liệu ông có biết Thiên Chúa xếp đặt như thế nào,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:58.764Z",
      "updatedAt": "2025-09-03T02:23:58.764Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "5d0c4493-844b-48f9-9453-3c027fad5bd4",
      "text": "Người khiến mây toả sáng làm sao ?",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:58.794Z",
      "updatedAt": "2025-09-03T02:23:58.794Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "af048360-e3ba-435f-8174-37a857d42bd3",
      "text": "Và liệu ông có biết làm sao mây lơ lửng được giữa trời,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:58.807Z",
      "updatedAt": "2025-09-03T02:23:58.807Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "12b1cfae-a3a5-429b-b6e6-f8b14cfc2746",
      "text": "há đó chẳng phải là kỳ công của bậc thầy uyên bác ?",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:58.836Z",
      "updatedAt": "2025-09-03T02:23:58.836Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "fa086ee1-c5ad-42ee-812b-a5ab2188b416",
      "text": "Này, khi xứ sở im lìm dưới ngọn gió nam,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:58.851Z",
      "updatedAt": "2025-09-03T02:23:58.851Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "bc9cfbea-0007-4ac2-81b7-806f8e3b4255",
      "text": "khiến áo quần của ông nên quá nóng,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:58.881Z",
      "updatedAt": "2025-09-03T02:23:58.881Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "e664d9ac-f239-4e73-8afc-00878789a19a",
      "text": "thì liệu ông có làm được như Người là cán cho mây dẹp lại",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:58.896Z",
      "updatedAt": "2025-09-03T02:23:58.896Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "e2403b0b-2ab2-432c-87d3-05f740b35744",
      "text": "như tấm gương bằng kim loại cứng được không ?",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:58.909Z",
      "updatedAt": "2025-09-03T02:23:58.909Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "992f5ca5-b279-4516-a86e-c3bde8290941",
      "text": "Xin chỉ cho chúng tôi thấy rõ",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:58.939Z",
      "updatedAt": "2025-09-03T02:23:58.939Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "653e9ce8-51bd-4b90-9ac5-475623a80619",
      "text": "điều chúng tôi sẽ thưa lại với Người.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:58.968Z",
      "updatedAt": "2025-09-03T02:23:58.968Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "87bd91c9-ca0b-474d-bed6-5cf55536226e",
      "text": "Thà rằng chúng tôi đừng tranh luận nữa",
      "label": "19",
      "number": 19,
      "subVerseIndex": 2,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:58.982Z",
      "updatedAt": "2025-09-03T02:23:58.982Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "8f83ff2a-c95f-49d9-9d2d-011ae5fee358",
      "text": "vì chúng tôi tối tăm mê muội quá.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 3,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:58.997Z",
      "updatedAt": "2025-09-03T02:23:58.997Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "08832e95-5c65-4133-a98b-df78041fc4ab",
      "text": "Lời tôi nói, liệu có ai thuật lại cho Người ?",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:59.010Z",
      "updatedAt": "2025-09-03T02:23:59.010Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "eae55a41-9af3-45a4-8c0a-7d837b7b9c89",
      "text": "Có ai lên tiếng nói, liệu Người có được thông báo chăng ?",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:59.024Z",
      "updatedAt": "2025-09-03T02:23:59.024Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "d8b1b9aa-6913-4f09-9df4-8efad6b984e2",
      "text": "Giờ đây, không ai nhìn thấy ánh sáng nữa",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:59.039Z",
      "updatedAt": "2025-09-03T02:23:59.039Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "41c53ff9-8756-49dd-b022-28aac0255abf",
      "text": "vì đã bị mây che khuất,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:59.054Z",
      "updatedAt": "2025-09-03T02:23:59.054Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "536d6705-b535-4a89-9e50-bec622f3f398",
      "text": "nhưng chỉ cần một cơn gió thoảng là mây bị xua tan,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 2,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:59.084Z",
      "updatedAt": "2025-09-03T02:23:59.084Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "9c736be4-04c7-4480-9ce7-f50b3a47f756",
      "text": "và từ phương bắc, xuất hiện một vừng sáng huy hoàng.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:59.097Z",
      "updatedAt": "2025-09-03T02:23:59.097Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "f656592b-4a2e-4e8e-9224-57d491bb27d3",
      "text": "Thiên Chúa đầy oai phong lẫm liệt.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:59.126Z",
      "updatedAt": "2025-09-03T02:23:59.126Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "7ee77ecf-c156-4df8-a50f-084de6c26310",
      "text": "Người là Đấng Toàn Năng, ta chẳng sao vươn tới,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:59.154Z",
      "updatedAt": "2025-09-03T02:23:59.154Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "695f1ca8-f2bc-4439-9a40-22678a1876ae",
      "text": "Người cao cả, vì Người hùng mạnh và công minh.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:59.197Z",
      "updatedAt": "2025-09-03T02:23:59.197Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "e0ded31f-3087-4904-b83a-117fb2481277",
      "text": "Người quyền năng, vì Người chính trực,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 2,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:59.209Z",
      "updatedAt": "2025-09-03T02:23:59.209Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "82eac792-6b21-4761-9261-f53307871520",
      "text": "nhưng chẳng áp bức ai.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 3,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:59.221Z",
      "updatedAt": "2025-09-03T02:23:59.221Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "a571ea95-e23b-41a4-b13e-d78c354f2f90",
      "text": "Vì thế, mọi phàm nhân đều kính sợ Người.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:59.232Z",
      "updatedAt": "2025-09-03T02:23:59.232Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "4354a21d-ecff-4c36-9e63-d9cf12705c69",
      "text": "Nhưng Người không để ý",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:59.243Z",
      "updatedAt": "2025-09-03T02:23:59.243Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    },
    {
      "id": "26fb76d0-d47e-4be2-b3b6-34080dc6e5a2",
      "text": "đến những kẻ tưởng mình khôn ngoan.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 2,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:23:59.259Z",
      "updatedAt": "2025-09-03T02:23:59.259Z",
      "chapterId": "902f953c-0048-4a00-b4b5-3968a93188f1"
    }
  ],
