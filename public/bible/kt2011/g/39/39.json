      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "dbf66d2b-87dd-4e07-b998-c1f14e6a3e93",
      "content": "X. Cn 30,18-19. Loại chim này bay bổng trên cao và làm tổ ở nơi chót vót.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "13",
      "sortOrder": 12,
      "startOffset": 37,
      "endOffset": 37,
      "createdAt": "2025-09-03T02:24:13.543Z",
