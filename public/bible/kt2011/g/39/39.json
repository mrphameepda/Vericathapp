      "content": "Ds 10,9",
      "kind": "MARK_KIND_REFERENCE",
      "label": "10@",
      "sortOrder": 9,
      "startOffset": 11,
      "endOffset": 11,
      "createdAt": "2025-09-03T02:24:13.373Z",
