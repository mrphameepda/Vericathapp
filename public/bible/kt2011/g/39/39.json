{
  "chapter": {
    "id": "177769c0-03d0-4893-ac0e-58b27b210596",
    "number": 39,
    "createdAt": "2025-09-03T01:07:51.633Z",
    "updatedAt": "2025-09-03T01:07:51.633Z",
    "bookId": "1672a600-6214-4bc7-aaa4-9b99684355ac"
  },
  "verses": [
    {
      "id": "b37cbedb-76bc-42aa-8b57-ae986012fbdd",
      "text": "Ngươi có biết mùa sơn dương sinh nở,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:12.401Z",
      "updatedAt": "2025-09-03T02:24:12.401Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "d05ba7dd-4cdb-4ba7-9c37-7caebd6e3866",
      "text": "có nhìn thấy nai mẹ đẻ con ?",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:12.459Z",
      "updatedAt": "2025-09-03T02:24:12.459Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "bbf78b86-4e03-4c27-b3a6-fa390c6ad518",
      "text": "Ngươi có biết chúng mang thai mấy tháng,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:12.474Z",
      "updatedAt": "2025-09-03T02:24:12.474Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "cab13867-4f25-4c3d-9d5a-9c127a802e67",
      "text": "và biết được mùa chúng sinh nở ?",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:12.489Z",
      "updatedAt": "2025-09-03T02:24:12.489Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "8a575351-f032-42aa-a807-2ca93349e906",
      "text": "Chúng ngồi xổm, sinh một bầy con, trút bỏ cơn đau đớn.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:12.503Z",
      "updatedAt": "2025-09-03T02:24:12.503Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "919169ab-621c-411b-a5f7-34f9c0f91ceb",
      "text": "Bầy con mạnh mẽ, lớn lên giữa đồng hoang,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:12.518Z",
      "updatedAt": "2025-09-03T02:24:12.518Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "43587e7b-792f-40d0-a7cf-43886eda53fb",
      "text": "rồi bỏ bầy, không trở về với mẹ.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:12.531Z",
      "updatedAt": "2025-09-03T02:24:12.531Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "49053c0b-ab5c-4b6e-8f90-243aaa7208e2",
      "text": "Ai đã trả tự do cho ngựa vằn,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:12.548Z",
      "updatedAt": "2025-09-03T02:24:12.548Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "41f05154-0aa9-4fbc-879b-d5f7443d3a29",
      "text": "ai đã cởi dây cột lừa hoang ?",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:12.562Z",
      "updatedAt": "2025-09-03T02:24:12.562Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "f9f04978-3efd-4475-ba79-de20c3c15bb5",
      "text": "Chính Ta ban cho nó sa mạc khô cằn làm nhà ở,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:12.610Z",
      "updatedAt": "2025-09-03T02:24:12.610Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "bfcaba68-4c99-416c-b139-10fea6976e21",
      "text": "đồng chua nước mặn làm chỗ dung thân.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:12.624Z",
      "updatedAt": "2025-09-03T02:24:12.624Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "b03c1d19-15d6-4a6c-9512-ede8f1414054",
      "text": "Nó chế nhạo nơi phố phường huyên náo,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:12.638Z",
      "updatedAt": "2025-09-03T02:24:12.638Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "01105af3-9cd6-4222-9641-38afd6cf6cd0",
      "text": "chẳng nghe lời quát tháo của người cai.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:12.651Z",
      "updatedAt": "2025-09-03T02:24:12.651Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "062b8ff0-5cc6-4ce0-bfdc-7f503be78c70",
      "text": "Nó rảo khắp núi đồi, nơi nó đang sinh sống",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:12.665Z",
      "updatedAt": "2025-09-03T02:24:12.665Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "e4bf9f66-6bc6-44a7-b7a8-e15e776d775e",
      "text": "để tìm kiếm cỏ non.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:12.680Z",
      "updatedAt": "2025-09-03T02:24:12.680Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "d27e9f8d-e6cd-4e5c-938b-72b14931b342",
      "text": "Liệu trâu rừng có muốn phục vụ ngươi,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:12.711Z",
      "updatedAt": "2025-09-03T02:24:12.711Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "7d429db4-1769-4d42-ab16-c9f1e11c3b84",
      "text": "có chịu qua đêm bên máng cỏ ngươi làm ?",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:12.740Z",
      "updatedAt": "2025-09-03T02:24:12.740Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "17c3225d-6461-46d1-a6a7-8f813c500a83",
      "text": "Liệu ngươi có buộc được dây vào cổ nó mà bắt nó đi cày,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:12.756Z",
      "updatedAt": "2025-09-03T02:24:12.756Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "c9060cc2-949e-42dd-bc06-86be84e80c55",
      "text": "và liệu nó có chịu đi theo ngươi cày bừa dưới thung lũng ?",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:12.786Z",
      "updatedAt": "2025-09-03T02:24:12.786Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "47d59d8c-2109-4321-9926-cb57fe30e4fb",
      "text": "Liệu ngươi có tin nó vì sức nó mạnh,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:12.801Z",
      "updatedAt": "2025-09-03T02:24:12.801Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "428ab648-63f8-4790-b913-cce4965e7d4d",
      "text": "để giao cho nó những công việc nặng nề ?",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:12.831Z",
      "updatedAt": "2025-09-03T02:24:12.831Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "8df8e328-dff9-4f13-b83e-237efaa1a186",
      "text": "Ngươi có nghĩ rằng nó sẽ trở lại",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:12.845Z",
      "updatedAt": "2025-09-03T02:24:12.845Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "7454e0e3-dd33-4697-9241-fdbff44114ed",
      "text": "và đem lúa về sân phơi của ngươi không ?",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:12.859Z",
      "updatedAt": "2025-09-03T02:24:12.859Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "0aa816df-3730-494c-842f-229663fdcd11",
      "text": "Cánh đà điểu vỗ nhanh, nhưng không sao sánh nổi",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:12.874Z",
      "updatedAt": "2025-09-03T02:24:12.874Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "61d63646-2eaf-4c3f-bc10-3b64aeadca2b",
      "text": "với cánh loài chim hạc, chim ưng.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:12.906Z",
      "updatedAt": "2025-09-03T02:24:12.906Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "c9aaf622-e573-4ae5-9354-fa8baf0dcfc7",
      "text": "Khi nó bỏ trứng lại trên đất,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:12.934Z",
      "updatedAt": "2025-09-03T02:24:12.934Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "fe76e139-23b9-4766-8e55-8fd87f16aaf6",
      "text": "phó mặc cho cát bụi nóng ran,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:12.949Z",
      "updatedAt": "2025-09-03T02:24:12.949Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "9d693a25-5d51-4040-9104-5b17413e0a51",
      "text": "mà quên rằng có thể có bàn chân giẫm nát,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:12.977Z",
      "updatedAt": "2025-09-03T02:24:12.977Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "7e52bfde-4121-4a65-b54d-b935faa4b801",
      "text": "hay một con thú rừng giày đạp.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:12.991Z",
      "updatedAt": "2025-09-03T02:24:12.991Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "792e988a-9100-4737-bfe7-8d6ec58311fc",
      "text": "Nó xử tệ với con, như chúng không phải là con của mình ;",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:13.007Z",
      "updatedAt": "2025-09-03T02:24:13.007Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "af443755-f38f-48ec-b26b-06d33d506ad1",
      "text": "có vất vả luống công, nó cũng không tiếc nuối.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:13.035Z",
      "updatedAt": "2025-09-03T02:24:13.035Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "6d11ca3d-b197-4ce2-97bc-c82e062b0ab3",
      "text": "Vì Thiên Chúa không chịu ban cho nó khôn ngoan,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:13.066Z",
      "updatedAt": "2025-09-03T02:24:13.066Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "b0baf0ec-08d7-408a-b039-50ab83dbdc6b",
      "text": "và không chia cho nó phần trí tuệ.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:13.096Z",
      "updatedAt": "2025-09-03T02:24:13.096Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "80422b01-9d6f-478c-a674-161aa7716d83",
      "text": "Nhưng đến hồi cất cánh tung bay,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:13.111Z",
      "updatedAt": "2025-09-03T02:24:13.111Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "739b96ab-d06d-4f43-b101-3d53603fe1ce",
      "text": "nó coi thường ngựa phi và người cưỡi.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:13.125Z",
      "updatedAt": "2025-09-03T02:24:13.125Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "2135f7b7-b31e-4324-8b90-7788c7726ff2",
      "text": "Có phải ngươi làm cho ngựa được mạnh sức",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:13.139Z",
      "updatedAt": "2025-09-03T02:24:13.139Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "41e4acf3-49bb-49f8-b332-c75b5be66a7d",
      "text": "choàng lên cổ nó một cái bờm",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:13.184Z",
      "updatedAt": "2025-09-03T02:24:13.184Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "df6f40bf-d7f7-4d4e-9714-e858de4109bf",
      "text": "làm cho nó nhảy được như châu chấu ?",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:13.199Z",
      "updatedAt": "2025-09-03T02:24:13.199Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "988afc5f-1e0d-423e-b487-0544719cedf5",
      "text": "Tiếng nó hí vang, gây kinh hoàng táng đởm.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:13.213Z",
      "updatedAt": "2025-09-03T02:24:13.213Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "29abe07e-c6ac-407d-a738-5b8ac12f2f51",
      "text": "Nó lấy chân bới đất,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:13.228Z",
      "updatedAt": "2025-09-03T02:24:13.228Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "3b40d17f-51bf-4284-ab81-cc04d0280e93",
      "text": "tự hào vì sức mạnh, nhắm phía trước lao mình,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:13.242Z",
      "updatedAt": "2025-09-03T02:24:13.242Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "24a4769c-ed36-484d-8750-d35f4d606d76",
      "text": "chẳng màng chi vũ khí.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 2,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:13.257Z",
      "updatedAt": "2025-09-03T02:24:13.257Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "a102b861-48b3-4ddd-9471-fd1fe3cbea60",
      "text": "Nó coi thường sợ hãi, bất chấp cả khiếp kinh,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:13.272Z",
      "updatedAt": "2025-09-03T02:24:13.272Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "01c8c4e8-f282-46cb-81d7-b9adebd4c4c4",
      "text": "trước mũi gươm, nhất định không lùi bước.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:13.286Z",
      "updatedAt": "2025-09-03T02:24:13.286Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "19449680-f54f-467c-8c39-86a6c3eab3ce",
      "text": "Trên đầu nó, tên bay vùn vụt, giáo và lao sáng quắc.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:13.300Z",
      "updatedAt": "2025-09-03T02:24:13.300Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "4eab0d1e-349a-4271-874e-e480b9126950",
      "text": "Giận điên lên, nó nuốt chửng không gian,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:13.316Z",
      "updatedAt": "2025-09-03T02:24:13.316Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "7d467097-efc7-4296-813c-f07a4c8b3e9d",
      "text": "nghe tiếng kèn thúc quân, nó không cầm mình nổi.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:13.358Z",
      "updatedAt": "2025-09-03T02:24:13.358Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "506d82b5-7d67-4e8f-be98-6a205e9b1377",
      "text": "Mỗi lần kèn thúc, nó kêu : A ha !",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:13.389Z",
      "updatedAt": "2025-09-03T02:24:13.389Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "69c17f03-73d0-4d2f-82cd-fd7f4bc1b13e",
      "text": "Từ đàng xa, nó đã đánh hơi được mùi chinh chiến,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:13.417Z",
      "updatedAt": "2025-09-03T02:24:13.417Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "b66a98a0-aecc-4703-beb0-ea89a4e26f26",
      "text": "nghe được tiếng tướng lãnh quát vang và tiếng hò xung trận.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 2,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:13.431Z",
      "updatedAt": "2025-09-03T02:24:13.431Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "e83acd25-6dfc-4710-82db-a9ef502fac0a",
      "text": "Có phải nhờ trí tuệ của ngươi mà bồ câu bay được,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:13.449Z",
      "updatedAt": "2025-09-03T02:24:13.449Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "933a93ab-d804-4f39-ab87-0e3491ed61ba",
      "text": "sải cánh hướng về phương nam ?",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:13.493Z",
      "updatedAt": "2025-09-03T02:24:13.493Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "e7fc0ffc-2d8d-4b4f-8a43-34faaf105563",
      "text": "Có phải vì ngươi ra lệnh mà chim bằng bay lên",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:13.528Z",
      "updatedAt": "2025-09-03T02:24:13.528Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "b58da920-d8d0-4e7f-a9f9-931e90b0b54a",
      "text": "tìm nơi cao chót vót mà làm tổ ?",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:13.558Z",
      "updatedAt": "2025-09-03T02:24:13.558Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "34c4e8fa-5cc6-41cb-a498-7a646326cf7f",
      "text": "Nó chọn hang hốc làm nơi ẩn mình",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:13.587Z",
      "updatedAt": "2025-09-03T02:24:13.587Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "6f974b00-70f4-4254-96a8-2470bbb2803c",
      "text": "và nghỉ đêm trong khe núi đá.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 1,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:13.602Z",
      "updatedAt": "2025-09-03T02:24:13.602Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "86343c55-f707-441d-ae6b-3740f51e641b",
      "text": "Từ chỏm núi cao, nó rình mồi, đôi mắt nhìn ra xa.",
      "label": "29",
      "number": 29,
      "subVerseIndex": 0,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:13.616Z",
      "updatedAt": "2025-09-03T02:24:13.616Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "add1fffc-58fa-4d7f-b160-1f466f770869",
      "text": "Bầy con của nó uống máu đến say sưa ;",
      "label": "30",
      "number": 30,
      "subVerseIndex": 0,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:13.642Z",
      "updatedAt": "2025-09-03T02:24:13.642Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "29b39861-d88b-4ccb-a4cb-90cda514296b",
      "text": "xác chết ở đâu là nó ở đó.",
      "label": "30",
      "number": 30,
      "subVerseIndex": 1,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:13.651Z",
      "updatedAt": "2025-09-03T02:24:13.651Z",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    }
  ],
  "marks": [
    {
      "id": "8acc2ecb-ffd1-4c38-aa68-85237b0627f0",
      "content": "Loài sơn dương không cần loài người giúp chúng sinh nở, nhưng Đức Chúa lại biết cả ngày tháng chúng mang thai.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 27,
      "endOffset": 27,
      "createdAt": "2025-09-03T02:24:12.429Z",
      "updatedAt": "2025-09-03T02:24:12.429Z",
      "targetId": "b37cbedb-76bc-42aa-8b57-ae986012fbdd",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "5396a956-4521-45f7-ad34-4a0b05474dab",
      "content": "Tv 104,18",
      "kind": "MARK_KIND_REFERENCE",
      "label": "1@",
      "sortOrder": 0,
      "startOffset": 18,
      "endOffset": 18,
      "createdAt": "2025-09-03T02:24:12.444Z",
      "updatedAt": "2025-09-03T02:24:12.444Z",
      "targetId": "b37cbedb-76bc-42aa-8b57-ae986012fbdd",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "31dd0adf-b3f7-4ec3-bee0-d6cdc2a233f5",
      "content": "Giống *lừa hoang* được Chúa nuôi dưỡng, sống rất thoải mái.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 27,
      "endOffset": 27,
      "createdAt": "2025-09-03T02:24:12.577Z",
      "updatedAt": "2025-09-03T02:24:12.577Z",
      "targetId": "41f05154-0aa9-4fbc-879b-d5f7443d3a29",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "3bab7466-4633-434f-96ba-879582b32c7c",
      "content": "G 11,12; St 16,12; Gr 2,24; Hs 8,9",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 18,
      "endOffset": 18,
      "createdAt": "2025-09-03T02:24:12.592Z",
      "updatedAt": "2025-09-03T02:24:12.592Z",
      "targetId": "41f05154-0aa9-4fbc-879b-d5f7443d3a29",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "bfc90080-2847-4fcd-bc85-c63a76e12cb5",
      "content": "G 6,5",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 12,
      "endOffset": 12,
      "createdAt": "2025-09-03T02:24:12.695Z",
      "updatedAt": "2025-09-03T02:24:12.695Z",
      "targetId": "e4bf9f66-6bc6-44a7-b7a8-e15e776d775e",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "689e48a9-dc63-4cdd-af05-4c79b466f3c3",
      "content": "*Trâu rừng* rất dữ, vì thế người ta khó thuần hoá nó để dùng vào công việc cày bừa đồng áng. Có người cho rằng đây là loại trâu gọi là “rimu”, rất khoẻ và hung dữ.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 14,
      "endOffset": 14,
      "createdAt": "2025-09-03T02:24:12.726Z",
      "updatedAt": "2025-09-03T02:24:12.726Z",
      "targetId": "d27e9f8d-e6cd-4e5c-938b-72b14931b342",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "53c24e17-4705-47af-b0bf-70f6613d42cd",
      "content": "X. Cn 14,4.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 4,
      "endOffset": 4,
      "createdAt": "2025-09-03T02:24:12.771Z",
      "updatedAt": "2025-09-03T02:24:12.771Z",
      "targetId": "17c3225d-6461-46d1-a6a7-8f813c500a83",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "cddab182-bb77-448b-91b5-01eed390577f",
      "content": "Ds 23,22; Đnl 33,17; Tv 92,11",
      "kind": "MARK_KIND_REFERENCE",
      "label": "4@",
      "sortOrder": 3,
      "startOffset": 24,
      "endOffset": 24,
      "createdAt": "2025-09-03T02:24:12.815Z",
      "updatedAt": "2025-09-03T02:24:12.815Z",
      "targetId": "47d59d8c-2109-4321-9926-cb57fe30e4fb",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "306beb9d-9b23-4a90-809b-c3f6723a0769",
      "content": "*Cánh đà điểu* ngắn nhỏ, nhưng lại có bộ lông đẹp. Đà điểu không bay cao được như các loài chim khác.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "5",
      "sortOrder": 4,
      "startOffset": 12,
      "endOffset": 12,
      "createdAt": "2025-09-03T02:24:12.889Z",
      "updatedAt": "2025-09-03T02:24:12.889Z",
      "targetId": "0aa816df-3730-494c-842f-229663fdcd11",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "7bf15270-5361-425b-b5d6-47de6fe29d57",
      "content": "Gr 8,7",
      "kind": "MARK_KIND_REFERENCE",
      "label": "5@",
      "sortOrder": 4,
      "startOffset": 14,
      "endOffset": 14,
      "createdAt": "2025-09-03T02:24:12.920Z",
      "updatedAt": "2025-09-03T02:24:12.920Z",
      "targetId": "61d63646-2eaf-4c3f-bc10-3b64aeadca2b",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "87c3fef9-e99f-4cff-af59-4ee209333ec5",
      "content": "Thực ra, đà điểu không bỏ ổ. Con trống con mái thay nhau ấp trứng : con trống ấp trứng chiều tối và đêm, vì màu lông của nó tối nên khó nhìn thấy hơn con mái. Đà điểu đẻ nhiều trứng, nên phải giấu trứng ở ngoài tổ. Khi ấp, nó chia ra ba phần, chỉ ấp một phần thôi.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "6",
      "sortOrder": 5,
      "startOffset": 28,
      "endOffset": 28,
      "createdAt": "2025-09-03T02:24:12.963Z",
      "updatedAt": "2025-09-03T02:24:12.963Z",
      "targetId": "fe76e139-23b9-4766-8e55-8fd87f16aaf6",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "60f314d2-b463-4401-808d-a5801d6ee555",
      "content": "Ac 4,3",
      "kind": "MARK_KIND_REFERENCE",
      "label": "6@",
      "sortOrder": 5,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:24:13.021Z",
      "updatedAt": "2025-09-03T02:24:13.021Z",
      "targetId": "792e988a-9100-4737-bfe7-8d6ec58311fc",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "5a14a597-bc86-41fb-98c5-252b4582e1e4",
      "content": "G 10,3",
      "kind": "MARK_KIND_REFERENCE",
      "label": "7@",
      "sortOrder": 6,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:24:13.050Z",
      "updatedAt": "2025-09-03T02:24:13.050Z",
      "targetId": "af443755-f38f-48ec-b26b-06d33d506ad1",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "6e49e040-6204-4acf-8d48-4776df0eb850",
      "content": "Khi gặp nguy hiểm, đà điểu giấu đầu trong bụi rậm, để lộ phần thân ra ngoài. Có người cho rằng như thế là khôn ngoan, vì nó biết giấu để bảo vệ phần yếu nhất của mình. Dầu nó khờ dại, nhưng lại được Thiên Chúa chăm sóc và cho chạy nhanh hơn ngựa phi.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "7",
      "sortOrder": 6,
      "startOffset": 46,
      "endOffset": 46,
      "createdAt": "2025-09-03T02:24:13.081Z",
      "updatedAt": "2025-09-03T02:24:13.081Z",
      "targetId": "6d11ca3d-b197-4ce2-97bc-c82e062b0ab3",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "cbd35b88-e873-409d-9e4c-efd66d6f43a1",
      "content": "Đây là ngựa chiến. Thời xưa ở Cận Đông, người ta dùng lừa để chở đồ, bò để cày, la hay lừa để cỡi, ngựa để đánh giặc hay săn bắn. Trước hết ngựa dùng để kéo xe (song mã), đến thế kỷ VIII tCN mới dùng cho kỵ binh, mãi về sau mới làm ngựa chiến. Đoạn văn này mô tả con ngựa chiến lâm trận thật tuyệt vời, thật linh động.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "8",
      "sortOrder": 7,
      "startOffset": 26,
      "endOffset": 26,
      "createdAt": "2025-09-03T02:24:13.154Z",
      "updatedAt": "2025-09-03T02:24:13.154Z",
      "targetId": "2135f7b7-b31e-4324-8b90-7788c7726ff2",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "cb3f656d-c910-4739-9636-a6cb0845ff26",
      "content": "Tv 33,17; 147,10",
      "kind": "MARK_KIND_REFERENCE",
      "label": "8@",
      "sortOrder": 7,
      "startOffset": 22,
      "endOffset": 22,
      "createdAt": "2025-09-03T02:24:13.168Z",
      "updatedAt": "2025-09-03T02:24:13.168Z",
      "targetId": "2135f7b7-b31e-4324-8b90-7788c7726ff2",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "d27907b4-6c18-406f-8ad7-4a728d1de2af",
      "content": "Ám chỉ ngựa phóng nhanh vùn vụt như rút ngắn khoảng cách lại.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "9",
      "sortOrder": 8,
      "startOffset": 39,
      "endOffset": 39,
      "createdAt": "2025-09-03T02:24:13.330Z",
      "updatedAt": "2025-09-03T02:24:13.330Z",
      "targetId": "4eab0d1e-349a-4271-874e-e480b9126950",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "4b317486-7639-4bc1-b5fa-36187cff422c",
      "content": "Dcr 6,7",
      "kind": "MARK_KIND_REFERENCE",
