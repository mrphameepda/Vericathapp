      "content": "Gr 49,16; Ôv 4",
      "kind": "MARK_KIND_REFERENCE",
      "label": "12@",
      "sortOrder": 11,
      "startOffset": 4,
      "endOffset": 4,
      "createdAt": "2025-09-03T02:24:13.572Z",
