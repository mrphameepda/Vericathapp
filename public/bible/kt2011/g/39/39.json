      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "b4f31c65-6bcd-40fa-b12e-690503b4906f",
      "content": "Tiếng kêu diễn tả niềm vui (x. Is 44,16 ; Ed 25,3).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "10",
      "sortOrder": 9,
      "startOffset": 31,
      "endOffset": 31,
      "createdAt": "2025-09-03T02:24:13.404Z",
      "updatedAt": "2025-09-03T02:24:13.404Z",
      "targetId": "506d82b5-7d67-4e8f-be98-6a205e9b1377",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "12b54854-6067-46a6-8c76-47696ad29dbf",
      "content": "Có nhiều bản dịch là chim ưng, chim ó.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "11",
      "sortOrder": 10,
      "startOffset": 39,
      "endOffset": 39,
      "createdAt": "2025-09-03T02:24:13.464Z",
      "updatedAt": "2025-09-03T02:24:13.464Z",
      "targetId": "e83acd25-6dfc-4710-82db-a9ef502fac0a",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "b18888b2-683f-4f58-9a55-e94f388c0657",
      "content": "Gr 8,7",
      "kind": "MARK_KIND_REFERENCE",
      "label": "11@",
      "sortOrder": 10,
      "startOffset": 33,
      "endOffset": 33,
      "createdAt": "2025-09-03T02:24:13.478Z",
      "updatedAt": "2025-09-03T02:24:13.478Z",
      "targetId": "e83acd25-6dfc-4710-82db-a9ef502fac0a",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "177769c0-03d0-4893-ac0e-58b27b210596"
    },
    {
      "id": "fe4152ea-300c-4bc6-816f-7085f46b5f4f",
      "content": "Mùa đông, chim ở phương bắc bay về phương nam để tránh cái lạnh (x. Gr 8,7). Cũng có thể hiểu là gió nam (x. Tv 78,26 ; Dc 4,16).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "12",
      "sortOrder": 11,
      "startOffset": 28,
      "endOffset": 28,
      "createdAt": "2025-09-03T02:24:13.507Z",
      "updatedAt": "2025-09-03T02:24:13.507Z",
