{
  "chapter": {
    "id": "fc2cf0f4-6658-4f02-9269-9a432524bf9b",
    "number": 41,
    "createdAt": "2025-09-03T01:07:51.633Z",
    "updatedAt": "2025-09-03T01:07:51.633Z",
    "bookId": "1672a600-6214-4bc7-aaa4-9b99684355ac"
  },
  "verses": [
    {
      "id": "83d5aeb9-634e-4974-b34b-20ca0be1c15b",
      "text": "Này, hy vọng thắng nó chỉ là ảo mộng,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:26.246Z",
      "updatedAt": "2025-09-03T02:24:26.246Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "9436fc6b-e09e-469c-a60b-7e8c875233d5",
      "text": "chỉ thấy nó thôi là đã rụng rời,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:26.277Z",
      "updatedAt": "2025-09-03T02:24:26.277Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "9e5afc9a-6121-4fc8-9ad1-81342b0931cd",
      "text": "chẳng ai gan đến độ khiêu khích nó,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:26.289Z",
      "updatedAt": "2025-09-03T02:24:26.289Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "5dabb062-cfaa-47ad-a142-146728464558",
      "text": "đối diện với nó, chẳng ai đứng vững.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:26.302Z",
      "updatedAt": "2025-09-03T02:24:26.302Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "3b49daed-5a08-4856-b0dd-aaa7551c736c",
      "text": "Ai đến gần nó mà yên lành được ?",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:26.315Z",
      "updatedAt": "2025-09-03T02:24:26.315Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "29ceb033-500b-4aae-8616-aa4c7291c7fe",
      "text": "Dưới gầm trời này, không có một ai !",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:26.330Z",
      "updatedAt": "2025-09-03T02:24:26.330Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "a24d5871-848a-41a3-b1ba-7e8417b38e0c",
      "text": "Các phần chi thể của nó, Ta không nói đến làm sao được !",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:26.358Z",
      "updatedAt": "2025-09-03T02:24:26.358Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "af905de6-c6ee-407b-ad33-47ea8d21fae1",
      "text": "Sức mạnh vô song của nó, Ta sẽ kể ra.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:26.372Z",
      "updatedAt": "2025-09-03T02:24:26.372Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "62f5aee4-1d53-4641-9c2b-dd89e84ca4c1",
      "text": "Vạt áo trước của nó, ai dám vén lên,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:26.387Z",
      "updatedAt": "2025-09-03T02:24:26.387Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "50372acd-865a-4259-b806-5334308b17bb",
      "text": "áo giáp kép của nó, ai đã chui vào ?",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:26.417Z",
      "updatedAt": "2025-09-03T02:24:26.417Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "3f6c2885-e610-4dc4-9ea3-c3bc3037454c",
      "text": "Hàm của nó, ai đã mở ra ?",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:26.431Z",
      "updatedAt": "2025-09-03T02:24:26.431Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "06906b74-9dbc-4713-93b8-d142f422a033",
      "text": "Chung quanh răng nó, toàn là kinh hãi.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:26.445Z",
      "updatedAt": "2025-09-03T02:24:26.445Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "759bf3f8-19ba-4656-9f55-cd97ea7fb9af",
      "text": "Lưng của nó tựa lớp lớp khiên che,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:26.473Z",
      "updatedAt": "2025-09-03T02:24:26.473Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "cbc0bfe5-d7c8-4283-ab61-2d3b2123f49e",
      "text": "dính chặt vào nhau như được đóng ấn.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:26.518Z",
      "updatedAt": "2025-09-03T02:24:26.518Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "d5f50201-4332-4e0f-ab52-c386bda6ef09",
      "text": "Chúng xếp khít vào nhau, khiến gió không sao lọt qua nổi.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:26.532Z",
      "updatedAt": "2025-09-03T02:24:26.532Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "aa97dca9-a2a5-4c56-9573-6013fb80c3a1",
      "text": "Chúng dính chặt vào nhau, thành một khối không thể tách rời.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:26.550Z",
      "updatedAt": "2025-09-03T02:24:26.550Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "d83d630d-a8b3-45ce-b357-e24f9ae87128",
      "text": "Nó hắt hơi khiến toả ra ánh sáng,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:26.564Z",
      "updatedAt": "2025-09-03T02:24:26.564Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "76a143df-9a34-45f7-95b3-c18ac2630ac3",
      "text": "mắt nó tựa ánh bình minh rạng ngời.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:26.614Z",
      "updatedAt": "2025-09-03T02:24:26.614Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "698628ed-19aa-474e-93af-1668ea3960e2",
      "text": "Miệng nó phóng ra những ngọn đuốc,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:26.628Z",
      "updatedAt": "2025-09-03T02:24:26.628Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "4ae47718-6766-44a4-ae0e-19fc114d69d5",
      "text": "phun muôn ngàn tia lửa.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:26.656Z",
      "updatedAt": "2025-09-03T02:24:26.656Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "c4c7f835-9306-4ef1-ace8-fd1618843a93",
      "text": "Từ lỗ mũi, khói bốc lên ngùn ngụt,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:26.669Z",
      "updatedAt": "2025-09-03T02:24:26.669Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "f6dd1d90-2c6d-474c-a703-99dd43367858",
      "text": "như chảo sôi sùng sục trên lò.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:26.697Z",
      "updatedAt": "2025-09-03T02:24:26.697Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "e8eff181-ecfd-4596-aca9-a47cc84b9bc1",
      "text": "Hơi thở của nó đốt than đỏ rực,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:26.711Z",
      "updatedAt": "2025-09-03T02:24:26.711Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "6305036b-297b-44f4-91ee-1dd1bc4e883c",
      "text": "lửa hồng từ miệng nó bốc lên.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:26.727Z",
      "updatedAt": "2025-09-03T02:24:26.727Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "1f527c90-e24c-4185-991b-d5bc2ae3982c",
      "text": "Sức mạnh nó tụ lại nơi cổ,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:26.755Z",
      "updatedAt": "2025-09-03T02:24:26.755Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "ab5bf78a-cccb-4ed1-85a1-6ecbf2098bc2",
      "text": "kinh hoàng đi trước nó mở đường.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:26.784Z",
      "updatedAt": "2025-09-03T02:24:26.784Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "19583ec6-a7e8-40d4-8b7e-2efe7bf2f437",
      "text": "Thịt yếm nó dính lại với nhau,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:26.798Z",
      "updatedAt": "2025-09-03T02:24:26.798Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "4a3e8e99-19d4-4ab0-ae3a-57dfbfe9bbf9",
      "text": "nên rắn chắc, không sao lay chuyển.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:26.814Z",
      "updatedAt": "2025-09-03T02:24:26.814Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "1dc5a20e-9d39-40fc-9150-92b00c66f2a5",
      "text": "Tim nó cứng như đá, chắc như phần dưới thớt cối xay.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:26.829Z",
      "updatedAt": "2025-09-03T02:24:26.829Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "81654525-598d-4679-82a1-e175ed44f4c6",
      "text": "Nó đứng lên, người hùng cũng run sợ, sóng cồn phải rút lui.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:26.857Z",
      "updatedAt": "2025-09-03T02:24:26.857Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "fe429e63-016a-4d11-baa1-19ab0dd70aae",
      "text": "Có đâm trúng nó, lưỡi gươm cũng không xuyên thủng được,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:26.885Z",
      "updatedAt": "2025-09-03T02:24:26.885Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "70ee250f-0bc5-46c3-b1f4-1b55db781819",
      "text": "mũi giáo, mũi lao hay mũi tên cũng thế.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:26.915Z",
      "updatedAt": "2025-09-03T02:24:26.915Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "55038fe8-7228-4b14-8f76-099db04b2788",
      "text": "Nó coi sắt như rơm, coi đồng như gỗ mục,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:26.930Z",
      "updatedAt": "2025-09-03T02:24:26.930Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "afabefe0-5e34-4914-9c49-72823115c2d0",
      "text": "gặp cung nỏ cũng không chạy trốn,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:26.945Z",
      "updatedAt": "2025-09-03T02:24:26.945Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "924cf900-7a8f-40f4-809e-dcd6101cf867",
      "text": "coi đá phóng như thể cọng rơm.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:26.958Z",
      "updatedAt": "2025-09-03T02:24:26.958Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "4a1bc629-9d0d-4b18-ac6e-7c54ae1fb920",
      "text": "Đối với nó, côn trượng chẳng khác gì rơm rạ,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:26.972Z",
      "updatedAt": "2025-09-03T02:24:26.972Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "90a04505-2108-4607-ab0d-e6ad7282770c",
      "text": "tiếng lao rít chỉ khiến nó mỉm cười.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:26.986Z",
      "updatedAt": "2025-09-03T02:24:26.986Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "75cecaa3-3848-434d-9107-e907568deab3",
      "text": "Dưới bụng nó là những mảnh sành nhọn,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:27Z",
      "updatedAt": "2025-09-03T02:24:27Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "ce36c707-1d83-480f-bf48-68a6ece33eef",
      "text": "trên đất bùn, nó duỗi dài như một cái trục lăn.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:27.014Z",
      "updatedAt": "2025-09-03T02:24:27.014Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "d4c8540f-04c8-4478-b919-d69d639d6817",
      "text": "Nó khiến vực sâu sôi lên như nồi nước,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:27.044Z",
      "updatedAt": "2025-09-03T02:24:27.044Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "e116f20d-e044-4849-b3ab-8eb72e34a66b",
      "text": "làm cho biển cả nên như lò đốt hương.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:27.086Z",
      "updatedAt": "2025-09-03T02:24:27.086Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "fd1e7869-8573-4213-b5f6-a09bd0961bb6",
      "text": "Nó để lại phía sau một luồng ánh sáng,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:27.100Z",
      "updatedAt": "2025-09-03T02:24:27.100Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "47c52d89-5c31-49c8-814b-7459a7c4b3ae",
      "text": "biến vực sâu thành mái đầu bạc.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:27.114Z",
      "updatedAt": "2025-09-03T02:24:27.114Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "4400bb04-1600-41ac-83e3-f2b78f9eb8ce",
      "text": "Trên cõi đất này, nó có một không hai,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:27.129Z",
      "updatedAt": "2025-09-03T02:24:27.129Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "f82c9f66-3a04-4342-beea-4f89bb24f8ed",
      "text": "bẩm sinh nó không hề biết sợ.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:27.157Z",
      "updatedAt": "2025-09-03T02:24:27.157Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "9917e11b-269d-449e-a0c3-8c29b9a73a42",
      "text": "Nó coi khinh những con vật khổng lồ,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:27.171Z",
      "updatedAt": "2025-09-03T02:24:27.171Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "84af3246-1669-4247-93d6-95029304bdef",
      "text": "nó là vua của muôn loài ác thú.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:27.186Z",
      "updatedAt": "2025-09-03T02:24:27.186Z",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    }
  ],
  "marks": [
    {
      "id": "abb9eeb3-ac61-41bd-b4b8-e3c33c57ce72",
      "content": "Cc. 41,1-3 nói đến tính hung dữ của con Giao Long. Đó lại là thụ tạo của Thiên Chúa, được Người săn sóc và thương yêu.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:24:26.266Z",
      "updatedAt": "2025-09-03T02:24:26.266Z",
      "targetId": "83d5aeb9-634e-4974-b34b-20ca0be1c15b",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "3c6a5cb0-a2ba-4a11-8489-04bee0a28549",
      "content": "Rm 11,35",
      "kind": "MARK_KIND_REFERENCE",
      "label": "1@",
      "sortOrder": 0,
      "startOffset": 19,
      "endOffset": 19,
      "createdAt": "2025-09-03T02:24:26.344Z",
      "updatedAt": "2025-09-03T02:24:26.344Z",
      "targetId": "29ceb033-500b-4aae-8616-aa4c7291c7fe",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "d964bbf8-b711-42bd-b202-b6f241d3cb51",
      "content": "*Vạt áo trước* là vảy bụng ; *áo giáp kép* là bộ da sần sùi của con Giao Long.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 12,
      "endOffset": 12,
      "createdAt": "2025-09-03T02:24:26.401Z",
      "updatedAt": "2025-09-03T02:24:26.401Z",
      "targetId": "62f5aee4-1d53-4641-9c2b-dd89e84ca4c1",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "131775a2-0676-4cfe-893f-74723735d990",
      "content": "G 15,26",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 24,
      "endOffset": 24,
      "createdAt": "2025-09-03T02:24:26.504Z",
      "updatedAt": "2025-09-03T02:24:26.504Z",
      "targetId": "759bf3f8-19ba-4656-9f55-cd97ea7fb9af",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "5253ff05-915f-47ec-b459-6af26fd018c3",
      "content": "Răng con Giao Long nhọn hoắt, trông thật đáng sợ.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 16,
      "endOffset": 16,
      "createdAt": "2025-09-03T02:24:26.459Z",
      "updatedAt": "2025-09-03T02:24:26.459Z",
      "targetId": "06906b74-9dbc-4713-93b8-d142f422a033",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "44673b1a-0c24-47e2-9eea-49a6f19b705d",
      "content": "G 3,9; Kh 9,17",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 24,
      "endOffset": 24,
      "createdAt": "2025-09-03T02:24:26.592Z",
      "updatedAt": "2025-09-03T02:24:26.592Z",
      "targetId": "d83d630d-a8b3-45ce-b357-e24f9ae87128",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "d0af6fa3-3d4c-45cf-a40e-047e4e94d5b6",
      "content": "Cc. 7-9 mô tả cái lưng của con Giao Long có khả năng chống lại mọi thứ khí giới tấn công.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 33,
      "endOffset": 33,
      "createdAt": "2025-09-03T02:24:26.488Z",
      "updatedAt": "2025-09-03T02:24:26.488Z",
      "targetId": "759bf3f8-19ba-4656-9f55-cd97ea7fb9af",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "21dcd17e-9124-43b1-82d9-30aa08f95afa",
      "content": "Tv 18,9",
      "kind": "MARK_KIND_REFERENCE",
      "label": "4@",
      "sortOrder": 3,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:24:26.741Z",
      "updatedAt": "2025-09-03T02:24:26.741Z",
      "targetId": "6305036b-297b-44f4-91ee-1dd1bc4e883c",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "2e4bae86-c66b-4720-883c-3f78493b0dc7",
      "content": "Có lẽ khi lội nước, con vật táp nước, phun ra trông giống luồng ánh sáng. Mắt con vật đỏ nhìn qua làn nước.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "5",
      "sortOrder": 4,
      "startOffset": 32,
      "endOffset": 32,
      "createdAt": "2025-09-03T02:24:26.578Z",
      "updatedAt": "2025-09-03T02:24:26.578Z",
      "targetId": "d83d630d-a8b3-45ce-b357-e24f9ae87128",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "952326ea-92fc-4292-9658-c180b84bff68",
      "content": "Ed 29,3",
      "kind": "MARK_KIND_REFERENCE",
      "label": "5@",
      "sortOrder": 4,
      "startOffset": 17,
      "endOffset": 17,
      "createdAt": "2025-09-03T02:24:27.030Z",
      "updatedAt": "2025-09-03T02:24:27.030Z",
      "targetId": "ce36c707-1d83-480f-bf48-68a6ece33eef",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "b468448a-1dfb-4933-9997-3d64cde53d52",
      "content": "Cc. 11-13 mô tả con Giao Long thở, miệng nó phun nước trên mặt sông, hồ.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "6",
      "sortOrder": 5,
      "startOffset": 5,
      "endOffset": 5,
      "createdAt": "2025-09-03T02:24:26.642Z",
      "updatedAt": "2025-09-03T02:24:26.642Z",
      "targetId": "698628ed-19aa-474e-93af-1668ea3960e2",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "5ac42706-fbb0-43ac-b5ec-5e132f2bb0f4",
      "content": "Ed 32,2",
      "kind": "MARK_KIND_REFERENCE",
      "label": "6@",
      "sortOrder": 5,
      "startOffset": 17,
      "endOffset": 17,
      "createdAt": "2025-09-03T02:24:27.072Z",
      "updatedAt": "2025-09-03T02:24:27.072Z",
      "targetId": "d4c8540f-04c8-4478-b919-d69d639d6817",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "9e7ab23d-b692-40bd-9005-ebd7e825b329",
      "content": "X. 2 Sm 22,9 ; Tv 18,9 nói đến cuộc thần hiện của Đức Chúa.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "7",
      "sortOrder": 6,
      "startOffset": 33,
      "endOffset": 33,
      "createdAt": "2025-09-03T02:24:26.683Z",
      "updatedAt": "2025-09-03T02:24:26.683Z",
      "targetId": "c4c7f835-9306-4ef1-ace8-fd1618843a93",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "045364bb-be1e-48ce-8b71-34b7d4754c49",
      "content": "Phần ngực to lớn của Giao Long.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "8",
      "sortOrder": 7,
      "startOffset": 25,
      "endOffset": 25,
      "createdAt": "2025-09-03T02:24:26.769Z",
      "updatedAt": "2025-09-03T02:24:26.769Z",
      "targetId": "1f527c90-e24c-4185-991b-d5bc2ae3982c",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "834a82c7-22a6-43cb-aa56-4df1b5672aae",
      "content": "Tim đá nghịch với tim thịt (x. Ed 11,19 ; 36,26).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "9",
      "sortOrder": 8,
      "startOffset": 18,
      "endOffset": 18,
      "createdAt": "2025-09-03T02:24:26.844Z",
      "updatedAt": "2025-09-03T02:24:26.844Z",
      "targetId": "1dc5a20e-9d39-40fc-9150-92b00c66f2a5",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "967a5a7c-209b-4ae1-9694-7f417627e525",
      "content": "Có lẽ là đại dương. Kiểu nói thái quá.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "10",
      "sortOrder": 9,
      "startOffset": 23,
      "endOffset": 23,
      "createdAt": "2025-09-03T02:24:26.871Z",
      "updatedAt": "2025-09-03T02:24:26.871Z",
      "targetId": "81654525-598d-4679-82a1-e175ed44f4c6",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "9709ce14-3620-4a9f-9adf-d01887fc3d99",
      "content": "Cc. 18-21 cho thấy con Giao Long rất khoẻ ; không một thứ vũ khí nào có thể làm hại nó.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "11",
      "sortOrder": 10,
      "startOffset": 15,
      "endOffset": 15,
      "createdAt": "2025-09-03T02:24:26.901Z",
      "updatedAt": "2025-09-03T02:24:26.901Z",
      "targetId": "fe429e63-016a-4d11-baa1-19ab0dd70aae",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "7b495287-2d63-48b0-a235-f801ac3e8dff",
      "content": "Nơi ở của con Giao Long.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "12",
      "sortOrder": 11,
      "startOffset": 16,
      "endOffset": 16,
      "createdAt": "2025-09-03T02:24:27.057Z",
      "updatedAt": "2025-09-03T02:24:27.057Z",
      "targetId": "d4c8540f-04c8-4478-b919-d69d639d6817",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    },
    {
      "id": "eededf61-f704-49d5-95b0-ea2194a54546",
      "content": "Con Giao Long là một con vật đáng sợ, trổi vượt hơn tất cả mọi loài vật, ngoài tầm chế ngự của loài người.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "13",
      "sortOrder": 12,
      "startOffset": 16,
      "endOffset": 16,
      "createdAt": "2025-09-03T02:24:27.144Z",
      "updatedAt": "2025-09-03T02:24:27.144Z",
      "targetId": "4400bb04-1600-41ac-83e3-f2b78f9eb8ce",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "fc2cf0f4-6658-4f02-9269-9a432524bf9b"
    }
  ],
