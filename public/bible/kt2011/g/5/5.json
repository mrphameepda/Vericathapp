{
  "chapter": {
    "id": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a",
    "number": 5,
    "createdAt": "2025-09-03T01:07:51.632Z",
    "updatedAt": "2025-09-03T01:07:51.632Z",
    "bookId": "1672a600-6214-4bc7-aaa4-9b99684355ac"
  },
  "verses": [
    {
      "id": "62838ab3-5976-473d-b663-96e9d37bde1a",
      "text": "Anh cứ gọi xem ! Liệu có ai trả lời anh chăng ?",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:13.610Z",
      "updatedAt": "2025-09-03T02:20:13.610Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "01719556-575f-44b4-b9dd-207078dcf898",
      "text": "Trong số các thánh, anh hướng về vị nào ?",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:13.628Z",
      "updatedAt": "2025-09-03T02:20:13.628Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "c5b1a19c-4309-4452-b2c3-62652d9edb5d",
      "text": "Quả thật, nỗi sầu khổ làm người điên phải chết",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:13.665Z",
      "updatedAt": "2025-09-03T02:20:13.665Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "642076ee-bfda-46f9-b8c1-661dc2ef13bb",
      "text": "và giận hờn làm kẻ dại phải tiêu vong.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:13.692Z",
      "updatedAt": "2025-09-03T02:20:13.692Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "7eff9c1a-6545-4709-8fe1-6e0e1757e03d",
      "text": "Chính tôi, tôi đã thấy người điên mọc rễ,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:13.703Z",
      "updatedAt": "2025-09-03T02:20:13.703Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "607f0fa5-54e9-46ee-b6bf-6ba5e4fe78e8",
      "text": "và lập tức tôi đã nguyền rủa nơi nó ở.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:13.728Z",
      "updatedAt": "2025-09-03T02:20:13.728Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "c3473f32-550c-4b64-9dda-b061616162e3",
      "text": "Chớ gì con cái nó không còn chỗ tựa nương,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:13.738Z",
      "updatedAt": "2025-09-03T02:20:13.738Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "d8746411-d08a-491c-8250-339bfa87d855",
      "text": "bị chà đạp nơi cổng thành, không được ai giải thoát.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:13.749Z",
      "updatedAt": "2025-09-03T02:20:13.749Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "700c152c-3dc3-45ba-8ef5-835906e00132",
      "text": "Cái gì nó gặt được, chớ gì người đói ăn mất,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:13.785Z",
      "updatedAt": "2025-09-03T02:20:13.785Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "6506f272-6c84-4ca9-8bae-4f8a99e71e2d",
      "text": "người ta cứ lấy, bất kể hàng rào gai,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:13.795Z",
      "updatedAt": "2025-09-03T02:20:13.795Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "dd6434be-aee1-4487-8595-01fa2f23aaa9",
      "text": "và tài sản chúng, chớ gì những kẻ khát nuốt trửng.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:13.805Z",
      "updatedAt": "2025-09-03T02:20:13.805Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "00b00141-5335-4974-993c-28361403bd9a",
      "text": "Quả thật, nỗi bất hạnh chẳng phải từ lòng đất chui lên,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:13.815Z",
      "updatedAt": "2025-09-03T02:20:13.815Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "e547bd65-dda4-41fb-bbc2-a7c01edff0b1",
      "text": "và khổ đau cũng chẳng mọc lên từ mặt đất.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:13.825Z",
      "updatedAt": "2025-09-03T02:20:13.825Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "f2612845-80e4-4a4c-8f4e-3e01e3c78107",
      "text": "Quả thật, con người sinh ra để mà chịu khổ,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:13.855Z",
      "updatedAt": "2025-09-03T02:20:13.855Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "4ce27421-ce6e-41ee-b252-b7b6100883c7",
      "text": "cũng như những tia chớp loé lửa trên cao.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:13.865Z",
      "updatedAt": "2025-09-03T02:20:13.865Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "1a720701-e696-4b34-bfd4-ee483d04ebb9",
      "text": "Phần tôi, tôi sẽ thỉnh cầu Thiên Chúa,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:13.875Z",
      "updatedAt": "2025-09-03T02:20:13.875Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "ee666174-cd26-495a-9c9c-f8ee4ce1e5fc",
      "text": "sẽ trình bày với Thiên Chúa vụ án của tôi.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:13.886Z",
      "updatedAt": "2025-09-03T02:20:13.886Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "4b258bf4-7c93-4780-9674-72dd7634fc78",
      "text": "Người làm ra những điều vĩ đại khôn dò khôn thấu,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:13.909Z",
      "updatedAt": "2025-09-03T02:20:13.909Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "8895a56f-6ceb-49fd-a0b3-2ebd000c91ff",
      "text": "và những điều kỳ diệu vô vàn vô kể.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:13.950Z",
      "updatedAt": "2025-09-03T02:20:13.950Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "108c57e5-bfd4-4203-a18a-6b473c97fb16",
      "text": "Người khiến mưa rơi trên mặt đất",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:13.965Z",
      "updatedAt": "2025-09-03T02:20:13.965Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "bc36638f-2801-4e3d-9023-01cd8fc7a4c1",
      "text": "và đổ tràn nước xuống nương đồng.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:13.977Z",
      "updatedAt": "2025-09-03T02:20:13.977Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "2c58ca5e-7020-442c-bada-b20d501110f3",
      "text": "Kẻ mọn hèn, Người cất nhắc lên,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:13.998Z",
      "updatedAt": "2025-09-03T02:20:13.998Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "587e1ea3-1c41-4496-b17a-2557c3345e2e",
      "text": "kẻ phiền muộn, Người đặt ở nơi cao an toàn.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:14.018Z",
      "updatedAt": "2025-09-03T02:20:14.018Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "4bd72ba4-efe1-4c94-a818-4cad9d2ca968",
      "text": "Mưu đồ của hạng tinh khôn, Người phá vỡ,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:14.038Z",
      "updatedAt": "2025-09-03T02:20:14.038Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "9dd25875-1815-43b4-9f36-6fba537ec4ff",
      "text": "khiến tay chúng chẳng làm nên công trạng gì.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:14.058Z",
      "updatedAt": "2025-09-03T02:20:14.058Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "f9faf3af-c6cc-4c57-84ac-a0e6d4350566",
      "text": "Người bắt kẻ khôn ngoan",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:14.079Z",
      "updatedAt": "2025-09-03T02:20:14.079Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "3e4fa2a6-1958-48da-9f14-7c2f14f3eaa3",
      "text": "bằng chính những xảo kế của chúng,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:14.099Z",
      "updatedAt": "2025-09-03T02:20:14.099Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "cc59a733-a083-436d-96ad-f105fca7da4b",
      "text": "và đi trước mưu toan của phường quỷ quyệt.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:14.109Z",
      "updatedAt": "2025-09-03T02:20:14.109Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "434021d4-ee0d-4cb3-9800-6ddb185d0514",
      "text": "Giữa ban ngày, chúng rơi vào bóng tối,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:14.119Z",
      "updatedAt": "2025-09-03T02:20:14.119Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "1dd7ed65-7297-48d2-9e5c-efc7c0d8b062",
      "text": "ngay chính ngọ, chúng mò mẫm như lần bước trong đêm.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:14.140Z",
      "updatedAt": "2025-09-03T02:20:14.140Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "912e7889-864b-4826-bb9d-3ad277c70735",
      "text": "Người cứu kẻ yếu hèn",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:14.163Z",
      "updatedAt": "2025-09-03T02:20:14.163Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "30c8f324-47eb-4af2-a2fa-051a5a1c8569",
      "text": "khỏi lưỡi gươm, khỏi tay người quyền thế.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:14.173Z",
      "updatedAt": "2025-09-03T02:20:14.173Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "411dd868-540b-407f-91fb-f20527203ae4",
      "text": "Bấy giờ kẻ nghèo khó lại bừng lên niềm hy vọng,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:14.184Z",
      "updatedAt": "2025-09-03T02:20:14.184Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "8436826a-853e-4bd0-af58-c0a6ee48a1b5",
      "text": "và phường tội lỗi chẳng còn dám hé môi.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:14.194Z",
      "updatedAt": "2025-09-03T02:20:14.194Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "379ce8fb-8231-4aa7-8d2a-702a47acd43d",
      "text": "Phúc thay người được Thiên Chúa sửa trị !",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:14.217Z",
      "updatedAt": "2025-09-03T02:20:14.217Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "276fe619-721a-4036-8619-eab0ecdf731a",
      "text": "Chớ coi thường giáo huấn của Đấng Toàn Năng.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:14.240Z",
      "updatedAt": "2025-09-03T02:20:14.240Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "80f04d14-43b9-42a1-9873-14d3d51b43c9",
      "text": "Người gây thương tích, cũng chính Người băng bó,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:14.292Z",
      "updatedAt": "2025-09-03T02:20:14.292Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "ebe72087-5183-4b59-b5d4-d60aa840a6b3",
      "text": "đánh bầm dập xong, lại ra tay chữa lành.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:14.312Z",
      "updatedAt": "2025-09-03T02:20:14.312Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "f324d68a-0405-4116-a1a3-29bb2bb6ad58",
      "text": "Sáu lần Người giải thoát anh khỏi cơn khốn quẫn,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:14.323Z",
      "updatedAt": "2025-09-03T02:20:14.323Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "74cb5659-f9a4-4dc1-b144-a6114d9c6abe",
      "text": "đến lần thứ bảy, tai hoạ không sao hại được anh.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:14.333Z",
      "updatedAt": "2025-09-03T02:20:14.333Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "70fff9e0-fa5d-4bb0-8de8-eae8d5687a99",
      "text": "Người cứu anh khỏi chết trong thời đói kém,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:14.354Z",
      "updatedAt": "2025-09-03T02:20:14.354Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "feb3ccf0-60ad-425f-afa3-fffe1e84e336",
      "text": "khỏi lưỡi gươm sát hại trong buổi binh đao.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:14.375Z",
      "updatedAt": "2025-09-03T02:20:14.375Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "ecc5d022-1e3c-4c51-a6d6-6e6fead3ece9",
      "text": "Anh sẽ được chở che khi bị lăng nhục,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:14.386Z",
      "updatedAt": "2025-09-03T02:20:14.386Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "be25115a-541d-43bc-b973-683c5a5d1f2e",
      "text": "tai hoạ có đến, anh cũng chẳng sợ chi.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:14.406Z",
      "updatedAt": "2025-09-03T02:20:14.406Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "368abde8-b5cb-44c0-8a33-4abee5e9561f",
      "text": "Tai ương đói kém chỉ khiến anh bật cười,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:14.417Z",
      "updatedAt": "2025-09-03T02:20:14.417Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "fee20e57-2c74-4505-904d-afdf033eef81",
      "text": "thú vật rừng hoang chẳng làm anh sợ hãi.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:14.428Z",
      "updatedAt": "2025-09-03T02:20:14.428Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "04bfd5a6-e779-43e5-aedb-3361b8e3db5e",
      "text": "Bởi vì anh giao ước cả với đá ngoài đồng,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:14.439Z",
      "updatedAt": "2025-09-03T02:20:14.439Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "214ae76a-a39b-4a4e-a1a9-88440b7be6a2",
      "text": "và thú rừng sẽ cùng anh chung sống.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:14.473Z",
      "updatedAt": "2025-09-03T02:20:14.473Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "4c6b74ee-b942-4582-a08e-8ca58b03cc71",
      "text": "Anh sẽ hưởng bình an tại nơi anh cư ngụ,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:14.500Z",
      "updatedAt": "2025-09-03T02:20:14.500Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "5eb573a3-0784-47a9-9235-6b9336b9777d",
      "text": "kiểm điểm đàn vật, chẳng thấy thiếu con nào.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:14.514Z",
      "updatedAt": "2025-09-03T02:20:14.514Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "a888a168-76b9-4bb7-a316-4dbcbd8c84de",
      "text": "Anh sẽ thấy con đàn cháu đống,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:14.557Z",
      "updatedAt": "2025-09-03T02:20:14.557Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "fc0fc303-6ba1-4e21-99f7-ef5cefa4e25b",
      "text": "hậu duệ anh đông đúc như cỏ mọc ngoài đồng.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:14.571Z",
      "updatedAt": "2025-09-03T02:20:14.571Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "94ea658a-a85d-429e-9973-e76f2d302583",
      "text": "Anh xuống mồ khi tuổi già mà còn tráng kiện",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:14.600Z",
      "updatedAt": "2025-09-03T02:20:14.600Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "ff41e399-fc8c-4ab4-bd47-f11731c8eb9a",
      "text": "như lúa chín ngày mùa được đem đến sân phơi.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:14.615Z",
      "updatedAt": "2025-09-03T02:20:14.615Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "42e765dd-1c4e-4d4d-81d8-da900c806ef1",
      "text": "Đó là điều chúng tôi đã tìm tòi kỹ lưỡng,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:14.643Z",
      "updatedAt": "2025-09-03T02:20:14.643Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "bfe1fbf1-fd9b-49bb-b2c2-a6f903769653",
      "text": "sự thật là như thế :",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:14.673Z",
      "updatedAt": "2025-09-03T02:20:14.673Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "ab6b4201-aaac-4386-bfe3-e02e36c47568",
      "text": "xin anh nghe và rút tỉa điều lợi ích cho mình.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 2,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:14.687Z",
      "updatedAt": "2025-09-03T02:20:14.687Z",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    }
  ],
  "marks": [
    {
      "id": "1e4d5467-d13e-4438-a620-6f52c13a208b",
      "content": "Các thụ tạo linh thiêng như các tôi tớ và thiên sứ của Thiên Chúa. Các vị này cũng được nói đến trong (x. Dcr 14,5 ; Đn 4,10.14.20 ; 8,13 ; Tv 89,7). Ông Ê-li-phát chế nhạo ông Gióp tìm một người cầu bầu bên Thiên Chúa. Nhưng nếu các thiên sứ còn bị phạt, thì lấy ai mà bào chữa cho tình trạng vô tội của mình.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 18,
      "endOffset": 18,
      "createdAt": "2025-09-03T02:20:13.646Z",
      "updatedAt": "2025-09-03T02:20:13.646Z",
      "targetId": "01719556-575f-44b4-b9dd-207078dcf898",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "c446e77a-b72c-48de-a689-6986949e2589",
      "content": "Tv 127,5",
      "kind": "MARK_KIND_REFERENCE",
      "label": "1@",
      "sortOrder": 0,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:20:13.774Z",
      "updatedAt": "2025-09-03T02:20:13.774Z",
      "targetId": "d8746411-d08a-491c-8250-339bfa87d855",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "5a9ae505-8b9e-40c0-bf1e-61dbc7c934dc",
      "content": "*Kẻ điên* ám chỉ người tội lỗi. Tài sản và con cái của *kẻ điên* (người tội lỗi) chỉ là ảo tưởng và nhất thời.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 36,
      "endOffset": 36,
      "createdAt": "2025-09-03T02:20:13.681Z",
      "updatedAt": "2025-09-03T02:20:13.681Z",
      "targetId": "c5b1a19c-4309-4452-b2c3-62652d9edb5d",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "d30f8151-0481-46b5-8d05-db2553d6fef0",
      "content": "G 15,35; St 3,17-19",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:20:13.845Z",
      "updatedAt": "2025-09-03T02:20:13.845Z",
      "targetId": "e547bd65-dda4-41fb-bbc2-a7c01edff0b1",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "895cdeb3-806a-46c2-8003-75fd7b82e19d",
      "content": "*Cây* và *rễ* thường được dùng trong Gióp (8,16 ; 14,7-9 ; 15,32 ; 18,16 ; 19,10 ; 24,20), cũng như trong Cựu Ước nói chung (Tv 1,3 ; 52,10 ; 92,13 ; Cn 12,3.12 ; Is 5,24 ; Hs 9,16 ; 2 V 19,30).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 40,
      "endOffset": 40,
      "createdAt": "2025-09-03T02:20:13.714Z",
      "updatedAt": "2025-09-03T02:20:13.714Z",
      "targetId": "7eff9c1a-6545-4709-8fe1-6e0e1757e03d",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "a1520421-ca0b-4c38-bb19-f9f802a630c0",
      "content": "G 9,10; Hc 43,32",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:20:13.937Z",
      "updatedAt": "2025-09-03T02:20:13.937Z",
      "targetId": "4b258bf4-7c93-4780-9674-72dd7634fc78",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "9de15d68-0c44-4866-bf0f-fb68958e2545",
      "content": "*Cổng thành* là trung tâm hành chính. Ở đó, người ta xử kiện, tranh tụng, bàn thảo những vấn đề luật pháp và những công việc khác (x. St 23,10.18 ; Đnl 21,18-21 ; 22,13-21 ; R 4,1-11 ; 1 V 22,10 ; 2 V 7,1 ; Am 5,15). Một người không có gia đình hay người bảo trợ giúp đỡ thì không nhận được nhiều lợi thế ở cổng thành.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 25,
      "endOffset": 25,
      "createdAt": "2025-09-03T02:20:13.763Z",
      "updatedAt": "2025-09-03T02:20:13.763Z",
      "targetId": "d8746411-d08a-491c-8250-339bfa87d855",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "a0ced42d-7808-4fd6-9461-614fd9762a74",
      "content": "1 Sm 2,7-8; Tv 75,7-8",
      "kind": "MARK_KIND_REFERENCE",
      "label": "4@",
      "sortOrder": 3,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:20:14.008Z",
      "updatedAt": "2025-09-03T02:20:14.008Z",
      "targetId": "2c58ca5e-7020-442c-bada-b20d501110f3",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "8ae57184-5cf2-4fb9-8893-e5d147159828",
      "content": "Kẻ tội lỗi phải gánh chịu hậu quả tội mình làm, đó là đau khổ.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "5",
      "sortOrder": 4,
      "startOffset": 40,
      "endOffset": 40,
      "createdAt": "2025-09-03T02:20:13.835Z",
      "updatedAt": "2025-09-03T02:20:13.835Z",
      "targetId": "e547bd65-dda4-41fb-bbc2-a7c01edff0b1",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "d4f3231f-f9bb-40a5-8df2-a1ec8ad1bb5d",
      "content": "G 12,23-25",
      "kind": "MARK_KIND_REFERENCE",
      "label": "5@",
      "sortOrder": 4,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:20:14.048Z",
      "updatedAt": "2025-09-03T02:20:14.048Z",
      "targetId": "4bd72ba4-efe1-4c94-a818-4cad9d2ca968",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "df7728f9-4371-429a-8a24-dfad462a0449",
      "content": "Ông Ê-li-phát như muốn đứng ra kiện Thiên Chúa : ông Gióp không nhận mình có tội, tại sao ông lại bị Thiên Chúa trừng phạt ?",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "6",
      "sortOrder": 5,
      "startOffset": 41,
      "endOffset": 41,
      "createdAt": "2025-09-03T02:20:13.897Z",
      "updatedAt": "2025-09-03T02:20:13.897Z",
      "targetId": "ee666174-cd26-495a-9c9c-f8ee4ce1e5fc",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "78a219f2-903a-48cd-b3f6-393bb00ecaef",
      "content": "1 Cr 3,19",
      "kind": "MARK_KIND_REFERENCE",
      "label": "6@",
      "sortOrder": 5,
      "startOffset": 10,
      "endOffset": 10,
      "createdAt": "2025-09-03T02:20:14.089Z",
      "updatedAt": "2025-09-03T02:20:14.089Z",
      "targetId": "f9faf3af-c6cc-4c57-84ac-a0e6d4350566",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "7c9cbdbf-56d4-4c44-b3e7-c8c95fe5c5a6",
      "content": "Cc. 9-18 : tác giả lấy lại tư tưởng quen thuộc trong thánh vịnh, và các ngôn sứ. Đây là vinh tụng ca : về công trình sáng tạo cc. 9-10, về tình thương đối với những kẻ nghèo, hèn mọn cc. 11.15-16, về việc thưởng phạt công minh cc. 12-14, về mục đích việc sửa dạy cc. 17-18.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "7",
      "sortOrder": 6,
