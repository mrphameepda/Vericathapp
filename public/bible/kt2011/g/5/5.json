    },
    {
      "id": "868cecf1-758f-48b9-8505-517b244170ca",
      "content": "Đau khổ là một hình thức giáo huấn của Thiên Chúa.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "13",
      "sortOrder": 12,
      "startOffset": 24,
      "endOffset": 24,
      "createdAt": "2025-09-03T02:20:14.250Z",
      "updatedAt": "2025-09-03T02:20:14.250Z",
      "targetId": "276fe619-721a-4036-8619-eab0ecdf731a",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "486e2de2-6853-4350-9ff1-a608592a4071",
      "content": "Đnl 29,4.11; Tv 128,3",
      "kind": "MARK_KIND_REFERENCE",
      "label": "13@",
      "sortOrder": 12,
      "startOffset": 10,
      "endOffset": 10,
      "createdAt": "2025-09-03T02:20:14.543Z",
      "updatedAt": "2025-09-03T02:20:14.543Z",
      "targetId": "5eb573a3-0784-47a9-9235-6b9336b9777d",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "717b411a-aef1-4002-aca2-8f1af2bd7c85",
      "content": "English: El-Shaddai | French: Dieu Puissant | Latin: Deus omnipotens | Origin: &#64298;&#1463;&#1491;&#1468;&#1464;&#1497; | Vietnamese: Đấng Toàn Năng -- Xh 6,3",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "14",
      "sortOrder": 13,
      "startOffset": 43,
      "endOffset": 43,
      "createdAt": "2025-09-03T02:20:14.260Z",
      "updatedAt": "2025-09-03T02:20:14.260Z",
      "targetId": "276fe619-721a-4036-8619-eab0ecdf731a",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "1ebfb5ae-4a7a-4470-8189-2ccab099f6b6",
      "content": "Danh xưng này của Thiên Chúa thường được LXX và PT sử dụng.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "15",
      "sortOrder": 14,
      "startOffset": 43,
      "endOffset": 43,
      "createdAt": "2025-09-03T02:20:14.271Z",
      "updatedAt": "2025-09-03T02:20:14.271Z",
      "targetId": "276fe619-721a-4036-8619-eab0ecdf731a",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "7217dd26-04ed-4dc9-813a-ef47326e030a",
      "content": "Số bảy chỉ tính trọn vẹn, đầy đủ, có nghĩa : gặp rất nhiều tai hoạ mà ông Gióp vẫn bình an. Có người cho rằng cc. 20-22 nói đến bảy hoạn nạn : chết, đói kém, gươm, binh đao, lăng nhục, tai hoạ, thú vật rừng hoang.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "16",
      "sortOrder": 15,
      "startOffset": 15,
      "endOffset": 15,
      "createdAt": "2025-09-03T02:20:14.344Z",
      "updatedAt": "2025-09-03T02:20:14.344Z",
      "targetId": "74cb5659-f9a4-4dc1-b144-a6114d9c6abe",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "44a8fec3-5009-41c8-ad00-e866d4f29b46",
      "content": "Cc. 23-26 mô tả hạnh phúc của người công chính.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "17",
      "sortOrder": 16,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:20:14.450Z",
      "updatedAt": "2025-09-03T02:20:14.450Z",
      "targetId": "04bfd5a6-e779-43e5-aedb-3361b8e3db5e",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "7597a0bc-87a5-483f-8a58-998e0ff42de3",
      "content": "Có lẽ đây là những thổ thần ? Lv 17,5-7 nói đến dâng cả lễ vật có đổ máu.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "18",
      "sortOrder": 17,
      "startOffset": 40,
      "endOffset": 40,
      "createdAt": "2025-09-03T02:20:14.461Z",
      "updatedAt": "2025-09-03T02:20:14.461Z",
      "targetId": "04bfd5a6-e779-43e5-aedb-3361b8e3db5e",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "92b53298-6737-4130-b9ba-66a3a565ea9b",
      "content": "X. Is 11,6-8 ; Hs 2,20 : tức là thời của Đấng Mê-si-a. Hạnh phúc đầu tiên đối với thiên nhiên.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "19",
      "sortOrder": 18,
      "startOffset": 34,
      "endOffset": 34,
      "createdAt": "2025-09-03T02:20:14.486Z",
      "updatedAt": "2025-09-03T02:20:14.486Z",
      "targetId": "214ae76a-a39b-4a4e-a1a9-88440b7be6a2",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "d96d2b1e-f198-40b6-87a4-9423b18176ff",
      "content": "Hạnh phúc thứ hai : bầy vật đông đảo.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "20",
      "sortOrder": 19,
      "startOffset": 43,
      "endOffset": 43,
      "createdAt": "2025-09-03T02:20:14.529Z",
      "updatedAt": "2025-09-03T02:20:14.529Z",
      "targetId": "5eb573a3-0784-47a9-9235-6b9336b9777d",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "c7d4286d-f473-402c-a303-2dcbb80cfd84",
      "content": "Hạnh phúc thứ ba : con đàn cháu đống (x. Tv 127,3 ; 144,12).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "21",
      "sortOrder": 20,
      "startOffset": 42,
      "endOffset": 42,
      "createdAt": "2025-09-03T02:20:14.586Z",
      "updatedAt": "2025-09-03T02:20:14.586Z",
      "targetId": "fc0fc303-6ba1-4e21-99f7-ef5cefa4e25b",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "3ccace51-54a7-4087-935d-4694fa177481",
      "content": "Hạnh phúc sau cùng : tuổi già trọn vẹn. Sống lâu trường thọ.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "22",
      "sortOrder": 21,
      "startOffset": 43,
      "endOffset": 43,
      "createdAt": "2025-09-03T02:20:14.629Z",
      "updatedAt": "2025-09-03T02:20:14.629Z",
      "targetId": "ff41e399-fc8c-4ab4-bd47-f11731c8eb9a",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    },
    {
      "id": "e6d5e112-459d-4423-ab06-ef7dca657e82",
      "content": "Ông Ê-li-phát tóm tắt : nhờ kinh nghiệm (truyền thống) và mặc khải (thị kiến) ông đề cao Thiên Chúa công minh khi xét xử. Kẻ gian ác phải chịu phạt. Nhưng ông Ê-li-phát không nhận ra chính Xa-tan gây đau khổ cho ông Gióp, chứ không phải Thiên Chúa.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "23",
      "sortOrder": 22,
      "startOffset": 40,
      "endOffset": 40,
      "createdAt": "2025-09-03T02:20:14.658Z",
      "updatedAt": "2025-09-03T02:20:14.658Z",
      "targetId": "42e765dd-1c4e-4d4d-81d8-da900c806ef1",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "cfb1671b-7dcf-46c7-bb2a-d2a18de75b5a"
    }
  ],
