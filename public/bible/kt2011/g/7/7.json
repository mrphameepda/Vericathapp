    },
    {
      "id": "ece7d87d-1352-435e-a99f-c238114fdbea",
      "content": "Bệnh của ông Gióp đã kéo dài một thời gian khá lâu.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "5",
      "sortOrder": 4,
      "startOffset": 40,
      "endOffset": 40,
      "createdAt": "2025-09-03T02:20:27.327Z",
      "updatedAt": "2025-09-03T02:20:27.327Z",
      "targetId": "59d6b053-1e8b-47ec-af94-983ee459b442",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "113c82ea-1700-4a56-8f34-9ce60fd130a6",
      "content": "Tv 78,39; 89,48",
      "kind": "MARK_KIND_REFERENCE",
      "label": "5@",
      "sortOrder": 4,
      "startOffset": 23,
      "endOffset": 23,
      "createdAt": "2025-09-03T02:20:27.521Z",
      "updatedAt": "2025-09-03T02:20:27.521Z",
      "targetId": "32eeac20-5b16-4faf-9c70-a57de8d23752",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "4745c87a-09d2-48ce-991e-9c449e352f25",
      "content": "Cơn bệnh hành hạ triền miên, khiến ông Gióp không thể ngủ yên, hoặc không ngủ được. Đêm thật dài !",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "6",
      "sortOrder": 5,
      "startOffset": 42,
      "endOffset": 42,
      "createdAt": "2025-09-03T02:20:27.362Z",
