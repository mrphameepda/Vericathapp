{
  "chapter": {
    "id": "9f063526-b4e0-47fe-a483-b279839fd8f9",
    "number": 7,
    "createdAt": "2025-09-03T01:07:51.632Z",
    "updatedAt": "2025-09-03T01:07:51.632Z",
    "bookId": "1672a600-6214-4bc7-aaa4-9b99684355ac"
  },
  "verses": [
    {
      "id": "bc66b30f-6336-41bb-b6e1-192f071d0b8a",
      "text": "Cuộc sống con người nơi dương thế",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:27.126Z",
      "updatedAt": "2025-09-03T02:20:27.126Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "e283035f-f632-4fdb-b995-5e7c1187f31d",
      "text": "chẳng phải là thời khổ dịch sao ?",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:27.139Z",
      "updatedAt": "2025-09-03T02:20:27.139Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "b69962ea-c67f-4913-9959-247c503442ba",
      "text": "Và chuỗi ngày lao lung vất vả",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:27.190Z",
      "updatedAt": "2025-09-03T02:20:27.190Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "7d3a4690-b424-40bc-9924-bb7f15c21650",
      "text": "đâu khác gì đời kẻ làm thuê ?",
      "label": "1",
      "number": 1,
      "subVerseIndex": 3,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:27.209Z",
      "updatedAt": "2025-09-03T02:20:27.209Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "870f281f-f73f-4e1e-8892-f7b5e686e470",
      "text": "Tựa người nô lệ mong bóng mát,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:27.243Z",
      "updatedAt": "2025-09-03T02:20:27.243Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "de479222-06e7-40dd-a23e-f3a5872e8034",
      "text": "như kẻ làm thuê đợi tiền công,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:27.275Z",
      "updatedAt": "2025-09-03T02:20:27.275Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "59d6b053-1e8b-47ec-af94-983ee459b442",
      "text": "cũng thế, gia tài của tôi là những tháng vô vọng,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:27.308Z",
      "updatedAt": "2025-09-03T02:20:27.308Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "1fbec6dd-c90d-45da-971d-84d0cd5327df",
      "text": "số phận của tôi là những đêm đau khổ ê chề.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:27.350Z",
      "updatedAt": "2025-09-03T02:20:27.350Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "bda2f2a0-3e2a-47c7-a574-b9a88ba9e782",
      "text": "Vừa nằm xuống, tôi đã nhủ thầm : “Khi nào trời sáng ?”",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:27.372Z",
      "updatedAt": "2025-09-03T02:20:27.372Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "21a91c22-6664-46b2-b0b3-e1e62a4b1071",
      "text": "Mới thức dậy, tôi liền tự hỏi : “Bao giờ chiều buông ?”",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:27.392Z",
      "updatedAt": "2025-09-03T02:20:27.392Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "5f760f0a-c3bc-4581-a59e-dd06a79c6f16",
      "text": "Mãi tới lúc hoàng hôn, tôi chìm trong mê sảng.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:27.403Z",
      "updatedAt": "2025-09-03T02:20:27.403Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "f39dd062-96e8-4390-b898-5e18afac06f8",
      "text": "Thịt tôi chai ra, giòi bọ lúc nhúc,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:27.415Z",
      "updatedAt": "2025-09-03T02:20:27.415Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "123eabc0-d1b5-4c42-b5d3-b713d89b84f0",
      "text": "da tôi nứt nẻ, máu mủ đầm đìa.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:27.425Z",
      "updatedAt": "2025-09-03T02:20:27.425Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "2353a4e9-6169-4145-95b1-1981ac8f1ade",
      "text": "Ngày đời tôi thấm thoát hơn cả thoi đưa,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:27.445Z",
      "updatedAt": "2025-09-03T02:20:27.445Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "0418d35e-cd21-4591-ac6a-1225b22745bb",
      "text": "và chấm dứt, không một tia hy vọng.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:27.475Z",
      "updatedAt": "2025-09-03T02:20:27.475Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "32eeac20-5b16-4faf-9c70-a57de8d23752",
      "text": "Lạy ĐỨC CHÚA, xin Ngài nhớ cho,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:27.485Z",
      "updatedAt": "2025-09-03T02:20:27.485Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "87a72628-3e2e-4b32-87f4-4d7704824cb2",
      "text": "cuộc đời con chỉ là hơi thở,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:27.531Z",
      "updatedAt": "2025-09-03T02:20:27.531Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "e9c26ed6-bf4d-49f1-94fc-93608fc549e6",
      "text": "mắt con sẽ chẳng thấy hạnh phúc bao giờ.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:27.552Z",
      "updatedAt": "2025-09-03T02:20:27.552Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "6f97d327-0caa-498c-8bab-d6a83b1e0ad5",
      "text": "Những đôi mắt từng nhìn thấy con chẳng nhận ra con nữa,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:27.563Z",
      "updatedAt": "2025-09-03T02:20:27.563Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "04c26a3e-0235-4c53-aada-beea0c3b9d2a",
      "text": "nhưng nếu Ngài đưa mắt nhìn con, thì con sẽ chẳng còn.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:27.588Z",
      "updatedAt": "2025-09-03T02:20:27.588Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "b42f934d-6563-4cfc-9b93-a69fd19a85a8",
      "text": "Ví tựa mây tan, ví tựa mây bay,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:27.603Z",
      "updatedAt": "2025-09-03T02:20:27.603Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "c3dbecc8-b629-4aea-8eae-dcc8b3367958",
      "text": "ai xuống âm phủ rồi, chẳng còn lên được nữa !",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:27.626Z",
      "updatedAt": "2025-09-03T02:20:27.626Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "e7c6e772-dc03-44eb-9fd8-c1f1f323e118",
      "text": "Nó chẳng trở về mái nhà xưa,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:27.647Z",
      "updatedAt": "2025-09-03T02:20:27.647Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "e318c132-0943-46c2-abef-178bc1baf4ab",
      "text": "nơi nó đã ở hết nhận ra nó rồi.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:27.669Z",
      "updatedAt": "2025-09-03T02:20:27.669Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "a90eaf16-2cf9-4248-8162-5d684809a2a3",
      "text": "Chính vì thế, con sẽ không ngậm miệng,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:27.681Z",
      "updatedAt": "2025-09-03T02:20:27.681Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "9c295d27-0ede-4dad-8efe-0e2a80e34cc4",
      "text": "con sẽ nói ra khi tâm thần sầu não,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:27.694Z",
      "updatedAt": "2025-09-03T02:20:27.694Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "1c6b6a22-7870-45d7-ac19-a78652b24653",
      "text": "sẽ than thở lúc con tim cay đắng.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:27.709Z",
      "updatedAt": "2025-09-03T02:20:27.709Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "930a6c76-7f1b-4a14-817c-3f75c495ea45",
      "text": "Con đâu có phải là biển cả hay thuỷ quái dị hình,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:27.724Z",
      "updatedAt": "2025-09-03T02:20:27.724Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "3a03e4ac-cb27-4164-a0a4-7c8ab09df0c1",
      "text": "khiến Ngài phải cho người canh gác ?",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:27.751Z",
      "updatedAt": "2025-09-03T02:20:27.751Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "4364c745-e881-4946-b21a-18b0b9c73cf3",
      "text": "Nếu con nói : “Giường con nằm sẽ an ủi con,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:27.764Z",
      "updatedAt": "2025-09-03T02:20:27.764Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "a6bb164c-dbcc-411a-935d-1b94d854a61a",
      "text": "nơi con ngủ sẽ làm dịu đi tiếng con than thở”,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:27.786Z",
      "updatedAt": "2025-09-03T02:20:27.786Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "3664016e-e7a5-4107-9cf4-8e570ff41e77",
      "text": "thì khi ấy, Ngài sẽ làm con kinh hoàng vì giấc mộng,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:27.796Z",
      "updatedAt": "2025-09-03T02:20:27.796Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "683b7a9c-d2e0-430c-a323-3864eb77031c",
      "text": "làm con hoảng sợ vì thị kiến.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:27.806Z",
      "updatedAt": "2025-09-03T02:20:27.806Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "90f8bf15-c360-4ec8-b8cd-5ba8ef784519",
      "text": "Chẳng thà bị treo cổ, chẳng thà phải chết",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:27.820Z",
      "updatedAt": "2025-09-03T02:20:27.820Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "df17545c-e439-43db-95af-f18133045db7",
      "text": "hơn là sống lây lất, da bọc xương.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:27.840Z",
      "updatedAt": "2025-09-03T02:20:27.840Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "e78be4da-8694-4968-98cf-259ba4d69b8b",
      "text": "Con chẳng thiết tha gì, con đâu có sống mãi,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:27.860Z",
      "updatedAt": "2025-09-03T02:20:27.860Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "aca677cd-d7af-4d31-b8bc-714c45b0018d",
      "text": "xin cứ để mặc con, vì đời con chỉ là hơi thở.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:27.871Z",
      "updatedAt": "2025-09-03T02:20:27.871Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "d4bf7454-2dab-4856-b27a-e7b8b90b1e38",
      "text": "Con người là gì để Ngài phải coi trọng, để Ngài phải lưu tâm,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:27.901Z",
      "updatedAt": "2025-09-03T02:20:27.901Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "a67f546a-0fb2-43a9-b822-faed56efe8c2",
      "text": "để sáng nào Ngài cũng phải thăm viếng,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:27.931Z",
      "updatedAt": "2025-09-03T02:20:27.931Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "401da581-2f53-4488-9941-aa67af311b04",
      "text": "để mỗi lúc Ngài lại phải xét soi ?",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:27.941Z",
      "updatedAt": "2025-09-03T02:20:27.941Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "7d48124a-74f6-4def-b5e7-b0dc45998732",
      "text": "Đến bao giờ Ngài mới ngoảnh mặt đi",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:27.963Z",
      "updatedAt": "2025-09-03T02:20:27.963Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "4a68484d-60f8-4c26-896e-62b1efe061a7",
      "text": "để con yên thân nuốt trôi nước miếng ?",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:27.976Z",
      "updatedAt": "2025-09-03T02:20:27.976Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "0a075334-b274-42e0-983e-b708471b551d",
      "text": "Con phạm tội có hề chi đến Ngài,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:27.986Z",
      "updatedAt": "2025-09-03T02:20:27.986Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "e740ad70-0d44-4bda-a1e8-134cc8b0cc41",
      "text": "lạy Đấng dò xét phàm nhân ?",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:28.006Z",
      "updatedAt": "2025-09-03T02:20:28.006Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "3c62bbc0-6a3c-4298-a909-e64fc589ac7a",
      "text": "Sao Ngài cứ đặt con làm bia để bắn ?",
      "label": "20",
      "number": 20,
      "subVerseIndex": 2,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:28.017Z",
      "updatedAt": "2025-09-03T02:20:28.017Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "2c0f771b-9760-43ae-ba93-91be87721971",
      "text": "Phải chăng con đã nên gánh nặng cho Ngài ?",
      "label": "20",
      "number": 20,
      "subVerseIndex": 3,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:28.039Z",
      "updatedAt": "2025-09-03T02:20:28.039Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "cfb7eed6-0175-41c2-9544-227c14fa404c",
      "text": "Chẳng lẽ Ngài không xoá được tội ác của con,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:28.049Z",
      "updatedAt": "2025-09-03T02:20:28.049Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "42ae02c4-e63f-47a6-921e-10f0cc344016",
      "text": "không bỏ qua được lỗi lầm con phạm ?",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:28.071Z",
      "updatedAt": "2025-09-03T02:20:28.071Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "de9125a0-55db-4723-a5f5-c026c47e8665",
      "text": "Vì chỉ ít nữa thôi, con sẽ ngủ vùi trong cát bụi.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 2,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:28.091Z",
      "updatedAt": "2025-09-03T02:20:28.091Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "1cd71c2d-f0a3-4f96-ba82-e6599a83e44b",
      "text": "Ngài có tìm cũng chẳng thấy con đâu.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 3,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:28.102Z",
      "updatedAt": "2025-09-03T02:20:28.102Z",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    }
  ],
  "marks": [
    {
      "id": "85cfd289-57bf-4804-9efd-4d019c5b3752",
      "content": "ds : *quân dịch*. Đời sống của người thi hành nhiệm vụ quân sự rất cực khổ x. Is 40,2. Cuộc sống của người lính đôi khi bị coi như cuộc đời một nô lệ (x. Lc 7,8), làm việc quần quật suốt ngày theo lệnh cấp trên.",
      "kind": "MARK_KIND_FOOTNOTE",
