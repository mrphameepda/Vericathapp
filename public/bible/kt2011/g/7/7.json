    {
      "id": "57f76a2a-663e-49fe-9274-751c2d369da7",
      "content": "Câu này giải thích lý do của những tháng vô vọng : *những đêm đau khổ*.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "7",
      "sortOrder": 6,
      "startOffset": 29,
      "endOffset": 29,
      "createdAt": "2025-09-03T02:20:27.435Z",
