    },
    {
      "id": "5cf1fcfd-1d70-4b14-bc69-54e186588d29",
      "content": "Is 38,12",
      "kind": "MARK_KIND_REFERENCE",
      "label": "4@",
      "sortOrder": 3,
      "startOffset": 31,
      "endOffset": 31,
      "createdAt": "2025-09-03T02:20:27.466Z",
