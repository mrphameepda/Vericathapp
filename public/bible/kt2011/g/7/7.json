      "targetId": "401da581-2f53-4488-9941-aa67af311b04",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "d36011d0-700e-4bc9-99dc-e50d94c82e74",
      "content": "Các bạn hữu, kể cả người vợ thân thương.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "12",
      "sortOrder": 11,
      "startOffset": 32,
      "endOffset": 32,
      "createdAt": "2025-09-03T02:20:27.575Z",
      "updatedAt": "2025-09-03T02:20:27.575Z",
      "targetId": "6f97d327-0caa-498c-8bab-d6a83b1e0ad5",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "10ed3e04-fdd1-4bf6-b0dd-da5e0c839f9c",
      "content": "G 35,3",
      "kind": "MARK_KIND_REFERENCE",
      "label": "12@",
      "sortOrder": 11,
      "startOffset": 4,
      "endOffset": 4,
      "createdAt": "2025-09-03T02:20:27.996Z",
      "updatedAt": "2025-09-03T02:20:27.996Z",
      "targetId": "0a075334-b274-42e0-983e-b708471b551d",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "1958bc20-0abe-44ab-bcc4-f28190ca9570",
      "content": "Quan niệm xưa cho rằng âm phủ là nơi ở của kẻ chết.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "13",
      "sortOrder": 12,
      "startOffset": 43,
      "endOffset": 43,
      "createdAt": "2025-09-03T02:20:27.637Z",
      "updatedAt": "2025-09-03T02:20:27.637Z",
      "targetId": "c3dbecc8-b629-4aea-8eae-dcc8b3367958",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "b1cfc7d9-05a8-4c09-9f26-1632b4c568e5",
      "content": "G 10,14",
      "kind": "MARK_KIND_REFERENCE",
      "label": "13@",
      "sortOrder": 12,
      "startOffset": 20,
      "endOffset": 20,
      "createdAt": "2025-09-03T02:20:28.060Z",
      "updatedAt": "2025-09-03T02:20:28.060Z",
      "targetId": "cfb7eed6-0175-41c2-9544-227c14fa404c",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "f23893c7-56be-45bd-a56c-1691ff38f9c9",
      "content": "Ám chỉ thân xác.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "14",
      "sortOrder": 13,
      "startOffset": 27,
      "endOffset": 27,
      "createdAt": "2025-09-03T02:20:27.658Z",
      "updatedAt": "2025-09-03T02:20:27.658Z",
      "targetId": "e7c6e772-dc03-44eb-9fd8-c1f1f323e118",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "8784754a-d617-4bb6-8c43-4eab040e4523",
      "content": "Cc. 13-15 chất vấn Thiên Chúa : Người dùng giấc mộng và thị kiến để tỏ cho ông Ê-li-phát biết kẻ có tội bị trừng phạt. Vậy trường hợp của ông Gióp thì sao ?",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "15",
      "sortOrder": 14,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:20:27.775Z",
      "updatedAt": "2025-09-03T02:20:27.775Z",
      "targetId": "4364c745-e881-4946-b21a-18b0b9c73cf3",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "bc9a86c6-3c3e-43f5-86f4-24dfb08f9517",
      "content": "Ông Gióp không có quyền lựa chọn số phận của mình.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "16",
      "sortOrder": 15,
      "startOffset": 33,
      "endOffset": 33,
      "createdAt": "2025-09-03T02:20:27.850Z",
      "updatedAt": "2025-09-03T02:20:27.850Z",
      "targetId": "df17545c-e439-43db-95af-f18133045db7",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "940d2cc6-78bd-4646-94e6-ac22aa0fb809",
      "content": "X. Is 57,13.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "17",
      "sortOrder": 16,
      "startOffset": 44,
      "endOffset": 44,
      "createdAt": "2025-09-03T02:20:27.881Z",
      "updatedAt": "2025-09-03T02:20:27.881Z",
      "targetId": "aca677cd-d7af-4d31-b8bc-714c45b0018d",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "8febc533-411c-43da-98b8-6f5323a6a104",
      "content": "Cc. 17.18 : châm biếm. Ông Gióp chỉ xin Chúa để ông yên. Sự hiện diện của Chúa, đối với ông, không còn là tình phụ tử, lòng nhân hậu, yêu mến, nhưng Chúa trở nên như kẻ thù, như người áp bức.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "18",
      "sortOrder": 17,
      "startOffset": 9,
      "endOffset": 9,
      "createdAt": "2025-09-03T02:20:27.911Z",
      "updatedAt": "2025-09-03T02:20:27.911Z",
      "targetId": "d4bf7454-2dab-4856-b27a-e7b8b90b1e38",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "8688e914-b976-4b8b-acc4-5604b6a1ce9c",
      "content": "LXX : *Ngài dò xét tâm hồn con người*.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "19",
      "sortOrder": 18,
      "startOffset": 34,
      "endOffset": 34,
      "createdAt": "2025-09-03T02:20:28.027Z",
      "updatedAt": "2025-09-03T02:20:28.027Z",
      "targetId": "3c62bbc0-6a3c-4298-a909-e64fc589ac7a",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "2f1f8795-5a21-4239-8689-7abebd98f3d2",
      "content": "Có lẽ 7,21a phải đọc liền với 7,20a. Ông Gióp hỏi Thiên Chúa : giả sử ông phạm tội, sao Chúa không tha thứ cho ông ?",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "20",
      "sortOrder": 19,
      "startOffset": 36,
      "endOffset": 36,
      "createdAt": "2025-09-03T02:20:28.081Z",
      "updatedAt": "2025-09-03T02:20:28.081Z",
      "targetId": "42ae02c4-e63f-47a6-921e-10f0cc344016",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    },
    {
      "id": "8508b005-775f-4649-99ea-dd3f50eea88b",
      "content": "Những lời cuối cùng này cho thấy ông Gióp không còn hy vọng được Thiên Chúa tha mạng cho mình.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "21",
      "sortOrder": 20,
      "startOffset": 36,
      "endOffset": 36,
      "createdAt": "2025-09-03T02:20:28.115Z",
      "updatedAt": "2025-09-03T02:20:28.115Z",
      "targetId": "1cd71c2d-f0a3-4f96-ba82-e6599a83e44b",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9f063526-b4e0-47fe-a483-b279839fd8f9"
    }
