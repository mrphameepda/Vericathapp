    },
    {
      "id": "60356fe7-12bf-4f50-bee1-e9e862a7b03a",
      "content": "Đnl 4,32; 32,7; Hc 8,9",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 4,
      "endOffset": 4,
      "createdAt": "2025-09-03T02:20:34.072Z",
      "updatedAt": "2025-09-03T02:20:34.072Z",
      "targetId": "e41f7b52-1474-4e1b-a3c4-b32ece481cda",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "61dc6620-a77e-486f-aabd-f751235cf94f",
      "content": "Ông Bin-đát trẻ hơn, tâm hồn hẹp hòi hơn, kém lịch sự hơn ông Ê-li-phát. Vì thế, khi ông Gióp phàn nàn Thiên Chúa không đoái đến thân phận mình, ông đã lên tiếng chống lại ông Gióp. Trước hết, theo truyền thống, ông cho rằng ông Gióp và con cái ông Gióp đã đắc tội với Chúa, nên mới chịu hình phạt (8,2-7). Dựa vào kinh nghiệm tiền nhân và vào thế giá những phán đoán của họ, ông quả quyết : những kẻ quên Thiên Chúa sớm muộn cũng không tránh khỏi hình phạt (8,8-19). Nhưng cuối cùng, ông lạc quan tin tưởng ông Gióp sẽ thoát nạn (8,20-22).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 47,
      "endOffset": 47,
      "createdAt": "2025-09-03T02:20:33.797Z",
      "updatedAt": "2025-09-03T02:20:33.797Z",
      "targetId": "79874b84-3239-4d5f-a80f-26da9cb340a7",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "820bad16-1842-412b-aec6-488b8101d518",
      "content": "Tv 37,1-2; Cn 10,28",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 6,
      "endOffset": 6,
      "createdAt": "2025-09-03T02:20:34.223Z",
      "updatedAt": "2025-09-03T02:20:34.223Z",
      "targetId": "2c38f2b4-1e54-4c60-a4fc-239bb3bc595e",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "cceabfb4-f4dd-4d5e-a498-24eef262b0d1",
      "content": "Cc. 2-3 mở đầu hỏi theo quy cách hùng biện và dựa vào lời ông Gióp, ông Bin-đát tập trung vào vấn đề Thiên Chúa công bình.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:20:33.820Z",
      "updatedAt": "2025-09-03T02:20:33.820Z",
      "targetId": "7db93c6a-3aa4-4854-9edd-aa3192d68f28",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "5aecb30b-5920-4c10-9d83-c44888e78fbb",
      "content": "Mt 7,26-27",
      "kind": "MARK_KIND_REFERENCE",
      "label": "4@",
      "sortOrder": 3,
      "startOffset": 22,
      "endOffset": 22,
      "createdAt": "2025-09-03T02:20:34.301Z",
      "updatedAt": "2025-09-03T02:20:34.301Z",
      "targetId": "2a6563e0-5c9b-48ff-b125-380bf3ef878a",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "88356a5b-8367-42a2-bb1c-15f87db41926",
      "content": "English: El-Shaddai | French: Dieu Puissant | Latin: Deus omnipotens | Origin: &#64298;&#1463;&#1491;&#1468;&#1464;&#1497; | Vietnamese: Đấng Toàn Năng -- Xh 6,3",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "5",
      "sortOrder": 4,
      "startOffset": 25,
      "endOffset": 25,
      "createdAt": "2025-09-03T02:20:33.872Z",
      "updatedAt": "2025-09-03T02:20:33.872Z",
      "targetId": "7661cb76-f9ab-4188-8b22-5a4c924dcf95",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "d28af211-a9a2-4579-8127-24c268e198e5",
      "content": "G 7,10",
      "kind": "MARK_KIND_REFERENCE",
      "label": "5@",
      "sortOrder": 4,
      "startOffset": 35,
      "endOffset": 35,
      "createdAt": "2025-09-03T02:20:34.363Z",
      "updatedAt": "2025-09-03T02:20:34.363Z",
      "targetId": "02ce8a08-a0e1-4671-b7af-2af47e81636b",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "406aa20c-fbb8-4d34-b841-5c8540ceafb4",
      "content": "X. 1,5. Ông Gióp đã không loại trừ giả thuyết con cái đắc tội với Đức Chúa. Nhưng ở đây ông Bin-đát nhấn mạnh đến giáo thuyết thưởng phạt cá nhân (x. Gr 31,29-30) và nhất là Ed 18,2-4.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "6",
      "sortOrder": 5,
      "startOffset": 42,
      "endOffset": 42,
      "createdAt": "2025-09-03T02:20:33.926Z",
      "updatedAt": "2025-09-03T02:20:33.926Z",
      "targetId": "7c409dc3-03fb-4003-9e81-3cfb5fe74595",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "24f7e160-2aab-472e-8f37-c970393e17c3",
      "content": "Tv 6,11; Cn 14,11",
      "kind": "MARK_KIND_REFERENCE",
      "label": "6@",
      "sortOrder": 5,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:20:34.504Z",
      "updatedAt": "2025-09-03T02:20:34.504Z",
      "targetId": "7f9296de-cc69-4fff-a728-5bc72b1aaab6",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "be744a8d-4694-4bae-bc2a-242b1dd0561f",
      "content": "Cc. 5-7. Giả sử ông Gióp vô tội, ông cứ nài xin Thiên Chúa, và Người sẽ phục hồi tình trạng hạnh phúc xưa kia cho ông.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "7",
      "sortOrder": 6,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:20:33.952Z",
      "updatedAt": "2025-09-03T02:20:33.952Z",
      "targetId": "70444cba-f2d2-4e35-9a98-438a4ced614c",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "cad6dc07-f039-4e13-865c-7d641e54a08c",
      "content": "English: El-Shaddai | French: Dieu Puissant | Latin: Deus omnipotens | Origin: &#64298;&#1463;&#1491;&#1468;&#1464;&#1497; | Vietnamese: Đấng Toàn Năng -- Xh 6,3",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "8",
      "sortOrder": 7,
      "startOffset": 31,
      "endOffset": 31,
      "createdAt": "2025-09-03T02:20:33.972Z",
      "updatedAt": "2025-09-03T02:20:33.972Z",
      "targetId": "21792828-5081-4571-9a4e-3526509f5253",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "6edf09d5-68cf-47ce-84da-2f743f3d0811",
      "content": "Nại đến tiền nhân và kinh nghiệm của họ là hình thức văn chương khôn ngoan quen dùng x. Đnl 32,7.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "9",
      "sortOrder": 8,
      "startOffset": 24,
      "endOffset": 24,
      "createdAt": "2025-09-03T02:20:34.062Z",
      "updatedAt": "2025-09-03T02:20:34.062Z",
      "targetId": "e41f7b52-1474-4e1b-a3c4-b32ece481cda",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "18ddae4b-2275-4dee-9deb-4ea7965a9b74",
      "content": "Cuộc đời vắn vỏi, mau qua là đề tài chung của văn chương khôn ngoan (x. Tv 90,9-10 ; 102,3.11 ; Gv 8,13 ; Kn 2,5 ; 5,9).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "10",
      "sortOrder": 9,
      "startOffset": 22,
      "endOffset": 22,
      "createdAt": "2025-09-03T02:20:34.123Z",
      "updatedAt": "2025-09-03T02:20:34.123Z",
      "targetId": "34d6d0dc-8715-436a-8aa7-2d07741d81ae",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "9ec53a84-fd8c-43b2-b003-07556db43863",
      "content": "Một thể loại văn chương rất được các bậc thầy dạy khôn ngoan ưa thích (x. Hc 39,3).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "11",
      "sortOrder": 10,
      "startOffset": 49,
      "endOffset": 49,
      "createdAt": "2025-09-03T02:20:34.153Z",
      "updatedAt": "2025-09-03T02:20:34.153Z",
      "targetId": "bb7f7853-0ce2-4fbb-98fa-05cdb679af65",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "08fe257c-6bcf-468b-a545-57897cb6d356",
      "content": "Cc. 11-13 so sánh số phận kẻ gian ác với cây lau cây sậy.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "12",
      "sortOrder": 11,
      "startOffset": 2,
      "endOffset": 2,
      "createdAt": "2025-09-03T02:20:34.173Z",
      "updatedAt": "2025-09-03T02:20:34.173Z",
      "targetId": "412448cc-ac31-48b3-8377-5290c9fd2c7f",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "c9dc55c3-d081-47c5-a4ab-31ab01a67ea6",
      "content": "Cc. 14-19. Có lẽ phải đọc theo thứ tự này : 14-15.18.16-17.19 mới dễ hiểu và mạch lạc. Như cây trồng ở vườn, kẻ gian ác có thể bị nhổ và bị tận diệt trong chốc lát.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "13",
      "sortOrder": 12,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:20:34.256Z",
      "updatedAt": "2025-09-03T02:20:34.256Z",
      "targetId": "59eeb0c4-ac34-4b21-8a8b-7b58bfb0c74e",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "a4a15f38-8eb3-4ec2-8a73-8d452bcf7446",
      "content": "*Chỉ treo mành, màng nhện* là hình ảnh cuộc đời mỏng dòn, mong manh.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "14",
      "sortOrder": 13,
      "startOffset": 41,
      "endOffset": 41,
      "createdAt": "2025-09-03T02:20:34.280Z",
      "updatedAt": "2025-09-03T02:20:34.280Z",
      "targetId": "f9d1bb9f-fafc-444b-9f5c-6acb05406074",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "c8824177-7ede-4f5d-bcc9-15166f931f01",
      "content": "Khó hiểu. Châm biếm.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "15",
      "sortOrder": 14,
      "startOffset": 34,
      "endOffset": 34,
      "createdAt": "2025-09-03T02:20:34.410Z",
      "updatedAt": "2025-09-03T02:20:34.410Z",
