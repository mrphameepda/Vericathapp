{
  "chapter": {
    "id": "54acff03-2e43-4a0f-8b59-709450370a1c",
    "number": 8,
    "createdAt": "2025-09-03T01:07:51.632Z",
    "updatedAt": "2025-09-03T01:07:51.632Z",
    "bookId": "1672a600-6214-4bc7-aaa4-9b99684355ac"
  },
  "verses": [
    {
      "id": "79874b84-3239-4d5f-a80f-26da9cb340a7",
      "text": "Bấy giờ ông Bin-đát, người Su-ác, lên tiếng nói :",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:20:33.756Z",
      "updatedAt": "2025-09-03T02:20:33.756Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "7db93c6a-3aa4-4854-9edd-aa3192d68f28",
      "text": "Đến bao giờ anh còn phát ngôn kiểu đó,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:33.811Z",
      "updatedAt": "2025-09-03T02:20:33.811Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "e6137717-9679-41b4-b740-f3b0515921c9",
      "text": "còn ăn nói ào ào tựa cơn gió mạnh ?",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:33.830Z",
      "updatedAt": "2025-09-03T02:20:33.830Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "370ffa8a-2a81-43cc-9e6b-b7780bc7a607",
      "text": "Phải chăng Thiên Chúa bẻ quặt công minh ?",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:33.841Z",
      "updatedAt": "2025-09-03T02:20:33.841Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "7661cb76-f9ab-4188-8b22-5a4c924dcf95",
      "text": "Phải chăng Đấng Toàn Năng uốn cong chính trực ?",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:33.862Z",
      "updatedAt": "2025-09-03T02:20:33.862Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "891a5124-c161-4415-88ae-218d0e1f4f59",
      "text": "Con cái anh mà đắc tội với Người,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:33.884Z",
      "updatedAt": "2025-09-03T02:20:33.884Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "cf9f4263-f856-4373-b981-bd621bee8968",
      "text": "Người bắt chúng phải gánh",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:33.898Z",
      "updatedAt": "2025-09-03T02:20:33.898Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "7c409dc3-03fb-4003-9e81-3cfb5fe74595",
      "text": "những hậu quả do tội ác chính mình đã phạm.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:33.912Z",
      "updatedAt": "2025-09-03T02:20:33.912Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "70444cba-f2d2-4e35-9a98-438a4ced614c",
      "text": "Nếu anh hăm hở kiếm tìm Thiên Chúa,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:33.940Z",
      "updatedAt": "2025-09-03T02:20:33.940Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "21792828-5081-4571-9a4e-3526509f5253",
      "text": "nếu anh cầu khẩn Đấng Toàn Năng,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:33.962Z",
      "updatedAt": "2025-09-03T02:20:33.962Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "b688a785-b6e4-47a9-97cc-c429b5938417",
      "text": "nếu anh trong sạch và ngay thẳng,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:33.983Z",
      "updatedAt": "2025-09-03T02:20:33.983Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "2ac8f4fe-1812-4c7d-8092-f7d3dcb1861b",
      "text": "ngay từ bây giờ, Người sẽ chở che anh,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:33.993Z",
      "updatedAt": "2025-09-03T02:20:33.993Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "543910b2-a130-4c04-bd77-7ec0a21abbce",
      "text": "Người sẽ hoàn trả lại cho anh",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:34.004Z",
      "updatedAt": "2025-09-03T02:20:34.004Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "0e517b04-a597-4ed0-9f07-04d5c8ddc249",
      "text": "địa vị của một người công chính.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 3,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:34.015Z",
      "updatedAt": "2025-09-03T02:20:34.015Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "a14529d3-8b3b-4fe6-a10c-966f373734a7",
      "text": "Tình trạng xưa của anh sẽ chẳng là gì cả",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:34.025Z",
      "updatedAt": "2025-09-03T02:20:34.025Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "e77ecb07-7ef4-4172-9896-c7c1e21ce8ec",
      "text": "so với tương lai rực rỡ huy hoàng.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:34.042Z",
      "updatedAt": "2025-09-03T02:20:34.042Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "e41f7b52-1474-4e1b-a3c4-b32ece481cda",
      "text": "Anh cứ hỏi thế hệ đã qua,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:34.052Z",
      "updatedAt": "2025-09-03T02:20:34.052Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "ae25cc09-a6f9-4616-934e-b2e0e20bd76a",
      "text": "kinh nghiệm cha ông, hãy gẫm suy cho kỹ.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:34.083Z",
      "updatedAt": "2025-09-03T02:20:34.083Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "41ac5b73-85d4-46f3-a096-a93c09706efb",
      "text": "Là đám hậu sinh, chúng ta chẳng biết gì,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:34.093Z",
      "updatedAt": "2025-09-03T02:20:34.093Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "9993b35a-b9cc-4e71-8073-755e9db40662",
      "text": "cuộc đời chúng ta trên dương thế",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:34.103Z",
      "updatedAt": "2025-09-03T02:20:34.103Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "34d6d0dc-8715-436a-8aa7-2d07741d81ae",
      "text": "chẳng khác gì bóng câu.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:34.113Z",
      "updatedAt": "2025-09-03T02:20:34.113Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "7c9ad8c5-80bc-4efe-a1fd-b18bf22d35d4",
      "text": "Nhưng các ngài sẽ dạy cho anh biết, sẽ nói cho anh hay,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:34.133Z",
      "updatedAt": "2025-09-03T02:20:34.133Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "bb7f7853-0ce2-4fbb-98fa-05cdb679af65",
      "text": "các ngài đã diễn tả kinh nghiệm qua câu châm ngôn này :",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:34.143Z",
      "updatedAt": "2025-09-03T02:20:34.143Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "412448cc-ac31-48b3-8377-5290c9fd2c7f",
      "text": "“Ở bên ngoài đầm, đay mọc được chăng ?",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:34.163Z",
      "updatedAt": "2025-09-03T02:20:34.163Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "89128000-7c43-4b07-ab87-cfa99cf83248",
      "text": "Chỗ không có nước, sậy nào vươn nổi ?",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:34.183Z",
      "updatedAt": "2025-09-03T02:20:34.183Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "1f5b8895-c979-4114-aca5-7fc037353a98",
      "text": "Khi hãy còn non được cắt đem về,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:34.193Z",
      "updatedAt": "2025-09-03T02:20:34.193Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "cca9db4c-d3e4-457b-b0fc-a7273bef13f3",
      "text": "nó đã ra khô héo trước mọi thứ cỏ.”",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:34.203Z",
      "updatedAt": "2025-09-03T02:20:34.203Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "2c38f2b4-1e54-4c60-a4fc-239bb3bc595e",
      "text": "Đó là số phận của mọi kẻ lãng quên Thiên Chúa,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:34.213Z",
      "updatedAt": "2025-09-03T02:20:34.213Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "ff88805d-798d-4708-b8db-9277f5c041f8",
      "text": "niềm hy vọng của phường gian ác cũng tiêu tan như vậy.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:34.234Z",
      "updatedAt": "2025-09-03T02:20:34.234Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "59eeb0c4-ac34-4b21-8a8b-7b58bfb0c74e",
      "text": "Nơi tin tưởng của nó như sợi chỉ treo mành,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:34.244Z",
      "updatedAt": "2025-09-03T02:20:34.244Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "f9d1bb9f-fafc-444b-9f5c-6acb05406074",
      "text": "chỗ an toàn của nó khác chi tấm màng nhện.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:34.266Z",
      "updatedAt": "2025-09-03T02:20:34.266Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "2a6563e0-5c9b-48ff-b125-380bf3ef878a",
      "text": "Nó dựa vào nhà, nhưng nhà không vững,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:34.291Z",
      "updatedAt": "2025-09-03T02:20:34.291Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "9ac9023e-f18b-4fa5-b2de-72aa3b405d15",
      "text": "nó bám vào nhà, nhưng nhà lung lay.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:34.311Z",
      "updatedAt": "2025-09-03T02:20:34.311Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "e0f0ada4-e37c-448a-bf85-048b61ac38cd",
      "text": "Dưới ánh mặt trời, nó tràn trề nhựa sống,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:34.321Z",
      "updatedAt": "2025-09-03T02:20:34.321Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "26892fad-4da3-49d8-8f11-9642acd3b4c1",
      "text": "và đâm chồi nẩy lộc toả khắp thửa vườn.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:34.331Z",
      "updatedAt": "2025-09-03T02:20:34.331Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "83267860-8af6-4392-8880-a1c1f398d7de",
      "text": "Rễ nó chằng chịt quanh đá tảng, ăn sâu vào khe đá.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:34.342Z",
      "updatedAt": "2025-09-03T02:20:34.342Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "02ce8a08-a0e1-4671-b7af-2af47e81636b",
      "text": "Nhưng nếu người ta bứng nó đi khỏi chỗ nó ở,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:34.352Z",
      "updatedAt": "2025-09-03T02:20:34.352Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "1a392b92-db32-4a50-b434-88827d221a86",
      "text": "thì nơi nó ở cũng chối bỏ nó :",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:34.376Z",
      "updatedAt": "2025-09-03T02:20:34.376Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "56651a1e-59b3-4f52-9459-ca7b95d66afb",
      "text": "“Có bao giờ tôi thấy anh đâu !”",
      "label": "18",
      "number": 18,
      "subVerseIndex": 2,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:34.390Z",
      "updatedAt": "2025-09-03T02:20:34.390Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "411c94f2-d743-4ff3-8b28-6f62a7edc932",
      "text": "Đường nó đi, sung sướng như vậy đó !",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:34.400Z",
      "updatedAt": "2025-09-03T02:20:34.400Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "cdc3f9b1-a304-4acf-8849-c9d7f0133762",
      "text": "Từ bụi đất một mầm khác mọc lên.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:34.423Z",
      "updatedAt": "2025-09-03T02:20:34.423Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "1040e0f3-0bf3-4072-b39f-0cb62123ae54",
      "text": "Này, Thiên Chúa chẳng loại bỏ con người toàn vẹn,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:34.435Z",
      "updatedAt": "2025-09-03T02:20:34.435Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "fd57548a-cc79-46b4-b91b-7438e2bb931c",
      "text": "chẳng tiếp tay cho phường gian ác.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:34.456Z",
      "updatedAt": "2025-09-03T02:20:34.456Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "718af781-b3ba-417d-92d1-2827129a1ee4",
      "text": "Người sẽ lại cho miệng anh rộn rã tiếng cười,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:34.467Z",
      "updatedAt": "2025-09-03T02:20:34.467Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "3864cc00-2219-4506-aaf9-1cd7df67f4d9",
      "text": "và môi anh vang khúc hoan ca.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:34.478Z",
      "updatedAt": "2025-09-03T02:20:34.478Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "7f9296de-cc69-4fff-a728-5bc72b1aaab6",
      "text": "Kẻ thù ghét anh phải thẹn thùng xấu hổ,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:34.489Z",
      "updatedAt": "2025-09-03T02:20:34.489Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    },
    {
      "id": "d5341d91-2990-47b2-80f7-a1522ac2c4dc",
      "text": "nơi ở của phường gian ác cũng chẳng còn.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:20:34.518Z",
      "updatedAt": "2025-09-03T02:20:34.518Z",
      "chapterId": "54acff03-2e43-4a0f-8b59-709450370a1c"
    }
  ],
  "marks": [
