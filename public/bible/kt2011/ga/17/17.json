      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "91aee63e-9be5-4701-a5e8-e5d0432b799e"
    },
    {
      "id": "690ec73e-815d-4b1a-9e6b-874c6953ab3a",
      "content": "Ga 10,36; 20,21",
