      "targetId": "cc38ae8e-17c6-4591-a1b2-a680fd35b89b",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "37617641-474c-41c9-9530-8f90c6ce23d1"
    },
    {
      "id": "6fcbfae8-069e-4784-a378-c2cfeafd702a",
