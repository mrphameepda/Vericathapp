    {
      "id": "920d32d4-c40e-4fdf-a09d-25205243ea73",
      "content": "Is 5,11",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 13,
