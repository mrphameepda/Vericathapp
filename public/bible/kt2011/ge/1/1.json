{
  "chapter": {
    "id": "60aae8b7-e81d-4575-92dd-35a399fed131",
    "number": 1,
    "createdAt": "2025-09-03T01:07:51.753Z",
    "updatedAt": "2025-09-03T01:07:51.753Z",
    "bookId": "cbbe2624-0cdc-4c0f-914b-7c5be4464639"
  },
  "verses": [
    {
      "id": "5447f008-1e23-4e59-9df6-56dd3aa05939",
      "text": "Lời ĐỨC CHÚA ngỏ với ông Giô-en, con ông Pơ-thu-ên.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T03:22:13.456Z",
      "updatedAt": "2025-09-03T03:22:13.456Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "f26119e9-03b8-4b3f-a524-103871692b02",
      "text": "Hỡi các kỳ mục, hãy nghe những điều này,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:13.531Z",
      "updatedAt": "2025-09-03T03:22:13.531Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "66cd05b9-2fe4-45b8-a595-5f671757beaa",
      "text": "tất cả cư dân trong xứ, hãy lắng nghe !",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:13.600Z",
      "updatedAt": "2025-09-03T03:22:13.600Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "65900f29-6823-40e0-82f5-81fb744412ab",
      "text": "Đã bao giờ xảy ra như thế trong thời của các ngươi",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:13.614Z",
      "updatedAt": "2025-09-03T03:22:13.614Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "140fcf95-0308-4ea6-ada4-ef4d3ba6d449",
      "text": "hay trong thời tổ tiên các ngươi chưa ?",
      "label": "2",
      "number": 2,
      "subVerseIndex": 3,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:13.628Z",
      "updatedAt": "2025-09-03T03:22:13.628Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "553a4834-9739-478e-af7a-0307da1d3068",
      "text": "Hãy kể lại cho con cái các ngươi những điều này,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:13.642Z",
      "updatedAt": "2025-09-03T03:22:13.642Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "4b65bdf0-dd30-4e54-951e-2a0f5f774496",
      "text": "rồi con cái các ngươi kể cho con cái chúng,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:13.656Z",
      "updatedAt": "2025-09-03T03:22:13.656Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "8e7bf267-0fdf-4a8f-b294-d0759be039c9",
      "text": "con cái chúng kể cho thế hệ sau.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:13.671Z",
      "updatedAt": "2025-09-03T03:22:13.671Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "ba249f81-e7ca-4282-87d6-c2d58d7ad1c7",
      "text": "Thứ gì châu chấu bỏ lại thì hoàng trùng ăn.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:13.685Z",
      "updatedAt": "2025-09-03T03:22:13.685Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "8467efa4-68e7-402a-b20a-a0c9ba7d4770",
      "text": "Thứ gì hoàng trùng bỏ lại thì cào cào ăn.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:13.734Z",
      "updatedAt": "2025-09-03T03:22:13.734Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "6d20b0e2-dbf2-4548-9935-1296247c2204",
      "text": "Thứ gì cào cào bỏ lại thì sạt sành ăn.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:13.749Z",
      "updatedAt": "2025-09-03T03:22:13.749Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "fa6b5509-ca14-43bb-9af4-bfab2ebb8d58",
      "text": "Hỡi những kẻ say sưa, hãy tỉnh dậy và than khóc.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:13.763Z",
      "updatedAt": "2025-09-03T03:22:13.763Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "b4eeb74b-9448-4606-973d-087d69eedd46",
      "text": "Hết mọi tay bợm rượu, rú lên đi vì chẳng còn nước nho nữa :",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:13.806Z",
      "updatedAt": "2025-09-03T03:22:13.806Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "49b0df58-30f5-4c9c-a7ca-7c48c4e9f4c3",
      "text": "nước nho kề miệng đã bị giựt mất rồi !",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:13.819Z",
      "updatedAt": "2025-09-03T03:22:13.819Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "44bcc14b-76f7-46db-9865-9f499abe584a",
      "text": "Quả thật, một dân nước uy hùng đông đảo",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:13.851Z",
      "updatedAt": "2025-09-03T03:22:13.851Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "a186fb93-3e42-4026-8257-9dc1d4acb594",
      "text": "đã xông lên đánh phá đất của Ta.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:13.879Z",
      "updatedAt": "2025-09-03T03:22:13.879Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "02745e2e-0978-4fba-8ca0-5a6334dc668b",
      "text": "Răng chúng là răng chúa sơn lâm,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:13.893Z",
      "updatedAt": "2025-09-03T03:22:13.893Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "a91602c9-ef7a-4cb7-8e2d-5d6ff52a7407",
      "text": "nanh chúng là nanh sư tử cái.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 3,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:13.921Z",
      "updatedAt": "2025-09-03T03:22:13.921Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "f092bfd3-4468-4203-acb6-7bf6f0157d55",
      "text": "Vườn nho của Ta, chúng biến nên chốn hoang tàn,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:13.935Z",
      "updatedAt": "2025-09-03T03:22:13.935Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "c2f7a5b4-3ddb-4e2c-bc93-f60c02909e7a",
      "text": "cây vả của Ta, chúng làm thành đống củi vụn.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:13.963Z",
      "updatedAt": "2025-09-03T03:22:13.963Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "c57b1277-9e3f-4283-99b8-45a611c71296",
      "text": "Chúng tước sạch vỏ, hạ đổ thân cây, bóc cành trắng hếu.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:13.977Z",
      "updatedAt": "2025-09-03T03:22:13.977Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "14cfa580-925d-4eee-ad2f-8dd209ed3813",
      "text": "Rên siết đi nào, tựa trinh nữ mặc áo vải thô",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:13.991Z",
      "updatedAt": "2025-09-03T03:22:13.991Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "981232c1-4fd1-4703-9976-c80e8721b611",
      "text": "khóc thương chồng sắp cưới thuở thanh xuân !",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:14.034Z",
      "updatedAt": "2025-09-03T03:22:14.034Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "6ea45856-6456-4d02-9f4c-f7d6a2409d3a",
      "text": "Nơi Nhà ĐỨC CHÚA, lễ hiến dâng và lễ tưới rượu",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:14.064Z",
      "updatedAt": "2025-09-03T03:22:14.064Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "0137f53d-5f1a-4586-b3a8-0c5abc1d7779",
      "text": "chẳng được cử hành nữa.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:14.105Z",
      "updatedAt": "2025-09-03T03:22:14.105Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "66de1fcc-2f89-4883-aaed-46e6d446e0de",
      "text": "Hàng tư tế, bề tôi của ĐỨC CHÚA, đang u sầu như thể chịu tang.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:14.119Z",
      "updatedAt": "2025-09-03T03:22:14.119Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "2c0f1fad-6294-4c27-a709-c67387cbc177",
      "text": "Đồng ruộng bị tàn phá,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:14.161Z",
      "updatedAt": "2025-09-03T03:22:14.161Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "fe9d5a6c-cf6c-4692-b4a0-edbc70f30449",
      "text": "đất đai cũng u sầu như thể chịu tang,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:14.176Z",
      "updatedAt": "2025-09-03T03:22:14.176Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "b0e901d9-b3b0-4d55-b129-540040ee1850",
      "text": "vì lúa mì bị tàn phá,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:14.190Z",
      "updatedAt": "2025-09-03T03:22:14.190Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "fb5a9f3f-6749-4237-aeb3-3a510480be83",
      "text": "rượu mới đã cạn khô, dầu tươi chẳng còn nữa.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 3,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:14.203Z",
      "updatedAt": "2025-09-03T03:22:14.203Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "7962f349-327e-4b51-9269-5bd6d26196a0",
      "text": "Hỡi nhà nông, hãy thẹn thùng xấu hổ,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:14.218Z",
      "updatedAt": "2025-09-03T03:22:14.218Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "109b3dd0-f39b-43c4-9b53-7abdc85a215b",
      "text": "kẻ trồng nho, hãy rú lên nào, tiếc cho lúa miến, lúa mạch,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:14.232Z",
      "updatedAt": "2025-09-03T03:22:14.232Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "0ad75187-0d73-4963-8509-3f91317c878c",
      "text": "vì đồng ruộng chẳng còn gì để gặt hái.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:14.246Z",
      "updatedAt": "2025-09-03T03:22:14.246Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "3d8d3101-2e00-44b8-bc70-771bd3868955",
      "text": "Nho cằn cỗi, vả héo tàn, cả lựu, cả chà là lẫn táo,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:14.260Z",
      "updatedAt": "2025-09-03T03:22:14.260Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "05e8fac4-84ab-42b2-b5fa-4c390a1b2dd7",
      "text": "mọi cây cối ngoài đồng đã chết khô.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:14.274Z",
      "updatedAt": "2025-09-03T03:22:14.274Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "1735298c-9fbc-45b1-b597-3b7a2407ded9",
      "text": "Thế là đã cạn hết niềm vui của con cái loài người.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:14.304Z",
      "updatedAt": "2025-09-03T03:22:14.304Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "a34beaf9-979a-4dd4-a52e-52e410ab11d7",
      "text": "Hỡi các tư tế, hãy mặc áo vải thô mà than van kêu khóc !",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:14.333Z",
      "updatedAt": "2025-09-03T03:22:14.333Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "4d6a9c2a-d9e7-444a-8504-84147a9081d3",
      "text": "Rú lên đi, hỡi những người phục vụ bàn thờ !",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:14.374Z",
      "updatedAt": "2025-09-03T03:22:14.374Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "fdaeb4ae-0b16-4dd3-af4c-49641196aeaa",
      "text": "Hãy đến, mặc áo vải thô mà thức suốt đêm,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:14.388Z",
      "updatedAt": "2025-09-03T03:22:14.388Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "15f9fd93-649b-498e-a04a-c9f90b7070a8",
      "text": "hỡi những người phục vụ Thiên Chúa,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 3,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:14.402Z",
      "updatedAt": "2025-09-03T03:22:14.402Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "efe53cdb-e7f9-4999-bc58-2cff1b312717",
      "text": "vì lễ hiến dâng và lễ tưới rượu",
      "label": "13",
      "number": 13,
      "subVerseIndex": 4,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:14.417Z",
      "updatedAt": "2025-09-03T03:22:14.417Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "dc7b20a8-9890-4735-a106-ec09560be02e",
      "text": "đã bị cấm cử hành nơi Nhà Thiên Chúa.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 5,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:14.445Z",
      "updatedAt": "2025-09-03T03:22:14.445Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "7725f19d-edd9-4416-8f0c-597489b910ee",
      "text": "Hãy ra lệnh giữ chay thánh, công bố mở cuộc họp long trọng,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:14.459Z",
      "updatedAt": "2025-09-03T03:22:14.459Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "8dd7a6b7-d4d0-4957-8e2d-3f8089c7dc17",
      "text": "triệu tập các cụ già và toàn thể cư dân trong xứ",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:14.487Z",
      "updatedAt": "2025-09-03T03:22:14.487Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "8c2e2f88-5546-4f5a-950d-50be546395b5",
      "text": "tại Nhà ĐỨC CHÚA, Thiên Chúa các ngươi.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 2,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:14.501Z",
      "updatedAt": "2025-09-03T03:22:14.501Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "63d8a01a-11ce-4bbf-a08e-8ffd9beadd9e",
      "text": "Hãy kêu lên ĐỨC CHÚA.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 3,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:14.532Z",
      "updatedAt": "2025-09-03T03:22:14.532Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "25c6e391-f82f-4eae-aab2-e50a519f1a0d",
      "text": "Ôi, ngày đáng sợ thay ! Ngày của ĐỨC CHÚA quả đã gần kề !",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:14.561Z",
      "updatedAt": "2025-09-03T03:22:14.561Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "18a9c2be-5c62-4f4e-a7da-cc78eb03a8b9",
      "text": "Ngày sẽ đến tựa cơn tàn phá do lệnh Đấng Toàn Năng.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:14.631Z",
      "updatedAt": "2025-09-03T03:22:14.631Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "c39d8ff6-0516-4532-9da9-aa4b0b8b1700",
      "text": "Lương thực đã chẳng bị cất xa tầm mắt chúng ta,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:14.659Z",
      "updatedAt": "2025-09-03T03:22:14.659Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "11b71574-4385-422f-a1ff-3cab01fdfb64",
      "text": "niềm vui mừng hoan lạc",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:14.673Z",
      "updatedAt": "2025-09-03T03:22:14.673Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "ec902aa7-080d-4b25-bce4-263741dcb6f2",
      "text": "đã chẳng bị cất khỏi nhà Thiên Chúa rồi đó sao ?",
      "label": "16",
      "number": 16,
      "subVerseIndex": 2,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:14.688Z",
      "updatedAt": "2025-09-03T03:22:14.688Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "62f9316f-df59-445d-a1b9-a9129ae47adc",
      "text": "Hạt gieo vãi đã chết khô dưới những tảng đất ;",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:14.702Z",
      "updatedAt": "2025-09-03T03:22:14.702Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "1dc9338d-bc3d-4c99-9297-33902c0ddca8",
      "text": "kho lẫm tan hoang, vựa lúa sụp đổ, bởi lúa mì đã cạn.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:14.716Z",
      "updatedAt": "2025-09-03T03:22:14.716Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "01fa473e-e3e8-4b49-9df3-12762b11e6ac",
      "text": "Đàn vật rên siết thảm thương, bò bê tán loạn,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:14.729Z",
      "updatedAt": "2025-09-03T03:22:14.729Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "3c23fede-0641-4138-8f4f-c86121535c10",
      "text": "vì không còn cỏ ăn.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:14.755Z",
      "updatedAt": "2025-09-03T03:22:14.755Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "1f7bd978-70db-46d7-acee-e203c9cd674d",
      "text": "Cả đàn cừu cũng bị chung tai hoạ.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 2,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:14.767Z",
      "updatedAt": "2025-09-03T03:22:14.767Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "6fce3447-b05c-4b0a-9f29-516dda0f674c",
      "text": "Lạy ĐỨC CHÚA, con kêu lên Ngài,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:14.780Z",
      "updatedAt": "2025-09-03T03:22:14.780Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "c9abf90a-f5c4-496a-b434-322c1d5ed620",
      "text": "vì lửa hồng đã thiêu hết bãi cỏ trong hoang địa,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:14.809Z",
      "updatedAt": "2025-09-03T03:22:14.809Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "ceae30f7-cd91-49c0-b311-b194dc573bc8",
      "text": "và ngọn lửa đã đốt sạch cây cối ngoài đồng.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 2,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:14.836Z",
      "updatedAt": "2025-09-03T03:22:14.836Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "201194b2-e6d3-4995-bc31-1383ac52ee79",
      "text": "Ngay cả loài dã thú cũng khát mong hướng về Ngài,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:14.850Z",
      "updatedAt": "2025-09-03T03:22:14.850Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "5efd2296-b684-4e07-a01b-cef992fe116b",
      "text": "vì suối nước đã cạn khô",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:14.864Z",
      "updatedAt": "2025-09-03T03:22:14.864Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "af201b5f-4e9c-441e-b927-260ce1972707",
      "text": "và lửa hồng đã thiêu hết bãi cỏ trong hoang địa.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 2,
      "paragraphNumber": 61,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:14.879Z",
      "updatedAt": "2025-09-03T03:22:14.879Z",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    }
  ],
