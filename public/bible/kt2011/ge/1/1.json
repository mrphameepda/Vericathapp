      "updatedAt": "2025-09-03T03:22:13.777Z",
      "targetId": "fa6b5509-ca14-43bb-9af4-bfab2ebb8d58",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "0110ee7d-3003-4b6a-a419-15276d377b89",
      "content": "Kh 9,8",
      "kind": "MARK_KIND_REFERENCE",
      "label": "5@",
      "sortOrder": 4,
      "startOffset": 14,
      "endOffset": 14,
      "createdAt": "2025-09-03T03:22:13.907Z",
      "updatedAt": "2025-09-03T03:22:13.907Z",
