    },
    {
      "id": "76734df1-72a0-477c-b202-d45cd0cfb797",
      "text": "I. NẠN CHÂU CHẤU",
      "level": 2,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:22:13.545Z",
      "updatedAt": "2025-09-03T03:22:13.545Z",
      "verseId": "f26119e9-03b8-4b3f-a524-103871692b02",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "4275f809-ed60-41d5-a73c-a8da1d3d47e1",
      "text": "Kêu gọi sám hối và cầu nguyện",
      "level": 3,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:22:14.347Z",
      "updatedAt": "2025-09-03T03:22:14.347Z",
      "verseId": "a34beaf9-979a-4dd4-a52e-52e410ab11d7",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "062ee48e-f23f-4ef2-871d-87c468b14fe1",
      "text": "TỰA ĐỀ",
      "level": 2,
      "sortOrder": 1,
      "createdAt": "2025-09-03T03:22:13.489Z",
      "updatedAt": "2025-09-03T03:22:13.489Z",
      "verseId": "5447f008-1e23-4e59-9df6-56dd3aa05939",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "11b848be-49cf-4d1b-94dc-ddaaee94f45c",
      "text": "1. TOÀN DÂN SÁM HỐI VÀ CẦU KHẨN",
      "level": 2,
      "sortOrder": 1,
      "createdAt": "2025-09-03T03:22:13.573Z",
      "updatedAt": "2025-09-03T03:22:13.573Z",
      "verseId": "f26119e9-03b8-4b3f-a524-103871692b02",
      "chapterId": "60aae8b7-e81d-4575-92dd-35a399fed131"
    },
    {
      "id": "5ee08361-b029-43d7-a43b-5453ec839702",
      "text": "Than vãn vì đất nước hoang tàn",
      "level": 3,
      "sortOrder": 2,
      "createdAt": "2025-09-03T03:22:13.586Z",
      "updatedAt": "2025-09-03T03:22:13.586Z",
