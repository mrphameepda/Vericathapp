{
  "chapter": {
    "id": "3215cdaf-74c7-44f7-ad48-1bc6896e85e3",
    "number": 3,
    "createdAt": "2025-09-03T01:07:51.753Z",
    "updatedAt": "2025-09-03T01:07:51.753Z",
    "bookId": "cbbe2624-0cdc-4c0f-914b-7c5be4464639"
  },
  "verses": [
    {
      "id": "f3b041c6-05c4-4b49-a1e5-a5ede8fb372e",
      "text": "“Sau đó, Ta sẽ đổ thần khí Ta trên hết thảy người phàm.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:28.230Z",
      "updatedAt": "2025-09-03T03:22:28.230Z",
      "chapterId": "3215cdaf-74c7-44f7-ad48-1bc6896e85e3"
    },
    {
      "id": "171e0460-0e27-40f9-b79f-f0a8354758ee",
      "text": "Con trai con gái các ngươi sẽ trở thành ngôn sứ,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:28.328Z",
      "updatedAt": "2025-09-03T03:22:28.328Z",
      "chapterId": "3215cdaf-74c7-44f7-ad48-1bc6896e85e3"
    },
    {
      "id": "a89c25ea-ac4f-43a8-8d95-9722fdba19f9",
      "text": "người già được báo mộng, thanh niên thấy thị kiến.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:28.342Z",
      "updatedAt": "2025-09-03T03:22:28.342Z",
      "chapterId": "3215cdaf-74c7-44f7-ad48-1bc6896e85e3"
    },
    {
      "id": "28c6e28a-8e92-4771-942a-ef25f88da784",
      "text": "Trong những ngày đó, Ta cũng sẽ đổ thần khí Ta",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:28.371Z",
      "updatedAt": "2025-09-03T03:22:28.371Z",
      "chapterId": "3215cdaf-74c7-44f7-ad48-1bc6896e85e3"
    },
    {
      "id": "9281fbb4-f889-4ff1-9d8d-cdec5a9de16f",
      "text": "trên tôi nam tớ nữ.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:28.385Z",
      "updatedAt": "2025-09-03T03:22:28.385Z",
      "chapterId": "3215cdaf-74c7-44f7-ad48-1bc6896e85e3"
    },
    {
      "id": "664f0e4f-cb37-413e-977e-b5adc2446651",
      "text": "Ở dưới đất cũng như trên trời,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:28.399Z",
      "updatedAt": "2025-09-03T03:22:28.399Z",
      "chapterId": "3215cdaf-74c7-44f7-ad48-1bc6896e85e3"
    },
    {
      "id": "3fd673d7-b701-489b-ae0d-e5617a4a806b",
      "text": "Ta sẽ cho xuất hiện nhiều điềm lạ là máu, lửa và cột khói.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:28.413Z",
      "updatedAt": "2025-09-03T03:22:28.413Z",
      "chapterId": "3215cdaf-74c7-44f7-ad48-1bc6896e85e3"
    },
    {
      "id": "7723e4cc-5901-48f3-954d-ef4571f42d15",
      "text": "Mặt trời sẽ trở nên tối tăm, mặt trăng hoá thành máu,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:28.427Z",
      "updatedAt": "2025-09-03T03:22:28.427Z",
      "chapterId": "3215cdaf-74c7-44f7-ad48-1bc6896e85e3"
    },
    {
      "id": "12cd6be4-23d2-42f3-b7a0-91f2d98e60ab",
      "text": "trước khi Ngày của ĐỨC CHÚA xuất hiện,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:28.456Z",
      "updatedAt": "2025-09-03T03:22:28.456Z",
      "chapterId": "3215cdaf-74c7-44f7-ad48-1bc6896e85e3"
    },
    {
      "id": "c0e965fd-8c85-4039-b696-64d48fb6bb82",
      "text": "Ngày vĩ đại, kinh hoàng.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:28.498Z",
      "updatedAt": "2025-09-03T03:22:28.498Z",
      "chapterId": "3215cdaf-74c7-44f7-ad48-1bc6896e85e3"
    },
    {
      "id": "4e65b4a9-6df8-4c30-b792-84116d58d5de",
      "text": "Bấy giờ, hết những ai kêu cầu danh ĐỨC CHÚA sẽ được ơn cứu độ,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:28.527Z",
      "updatedAt": "2025-09-03T03:22:28.527Z",
      "chapterId": "3215cdaf-74c7-44f7-ad48-1bc6896e85e3"
    },
    {
      "id": "31cc8e48-468b-4f6d-84c3-24fb1a7ec510",
      "text": "vì trên núi Xi-on và tại Giê-ru-sa-lem",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:28.571Z",
      "updatedAt": "2025-09-03T03:22:28.571Z",
      "chapterId": "3215cdaf-74c7-44f7-ad48-1bc6896e85e3"
    },
    {
      "id": "a28343b5-6b12-4a7a-8597-7e321a99c19b",
      "text": "sẽ có những người được thoát nạn như lời ĐỨC CHÚA đã phán.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:28.626Z",
      "updatedAt": "2025-09-03T03:22:28.626Z",
      "chapterId": "3215cdaf-74c7-44f7-ad48-1bc6896e85e3"
    },
    {
      "id": "b253f344-8c0d-43de-998d-9beb83753302",
      "text": "Và sẽ có những người được ĐỨC CHÚA kêu gọi",
      "label": "5",
      "number": 5,
      "subVerseIndex": 3,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:28.671Z",
      "updatedAt": "2025-09-03T03:22:28.671Z",
      "chapterId": "3215cdaf-74c7-44f7-ad48-1bc6896e85e3"
    },
    {
      "id": "2e08f102-4958-4402-9fec-dbb52fb7985d",
      "text": "trong số những kẻ còn sống sót.”",
      "label": "5",
      "number": 5,
      "subVerseIndex": 4,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:28.698Z",
      "updatedAt": "2025-09-03T03:22:28.698Z",
      "chapterId": "3215cdaf-74c7-44f7-ad48-1bc6896e85e3"
    }
  ],
