{
  "chapter": {
    "id": "4effea38-3707-40c3-909c-d5f41bd2059d",
    "number": 2,
    "createdAt": "2025-09-03T01:07:51.819Z",
    "updatedAt": "2025-09-03T01:07:51.819Z",
    "bookId": "f11ee69d-213d-467d-a756-8f464d78172b"
  },
  "verses": [
    {
      "id": "4a7f3e2e-55f4-4dd5-bce7-0cd4717ca044",
      "text": "ĐỨC CHÚA khiến một con cá lớn nuốt ông Giô-na. Ông Giô-na ở trong bụng cá ba ngày ba đêm.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T03:24:21.713Z",
      "updatedAt": "2025-09-03T03:24:21.713Z",
      "chapterId": "4effea38-3707-40c3-909c-d5f41bd2059d"
    },
    {
      "id": "cf9ad5b8-2361-432b-a3b2-cc0e2efae9f3",
      "text": "Từ trong bụng cá, ông Giô-na cầu nguyện cùng ĐỨC CHÚA, Thiên Chúa của ông.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 1,
      "isPoetry": false,
      "createdAt": "2025-09-03T03:24:21.851Z",
      "updatedAt": "2025-09-03T03:24:21.851Z",
      "chapterId": "4effea38-3707-40c3-909c-d5f41bd2059d"
    },
    {
      "id": "f719249b-55b1-40c4-8d6a-521806ffea92",
      "text": "Ông nói :",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 2,
      "isPoetry": false,
      "createdAt": "2025-09-03T03:24:21.893Z",
      "updatedAt": "2025-09-03T03:24:21.893Z",
      "chapterId": "4effea38-3707-40c3-909c-d5f41bd2059d"
    },
    {
      "id": "d7e3da41-1857-4e69-8aa9-13a414f0ac5c",
      "text": "Từ cảnh ngặt nghèo,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:24:21.922Z",
      "updatedAt": "2025-09-03T03:24:21.922Z",
      "chapterId": "4effea38-3707-40c3-909c-d5f41bd2059d"
    },
    {
      "id": "30d32b26-ff42-46b9-9ea8-5f58ea9b797a",
      "text": "tôi kêu lên ĐỨC CHÚA,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:24:21.950Z",
      "updatedAt": "2025-09-03T03:24:21.950Z",
      "chapterId": "4effea38-3707-40c3-909c-d5f41bd2059d"
    },
    {
      "id": "906dbbed-c128-481c-b50e-a2fd05ef9b74",
      "text": "Người đã thương đáp lời.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 3,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:24:21.978Z",
      "updatedAt": "2025-09-03T03:24:21.978Z",
      "chapterId": "4effea38-3707-40c3-909c-d5f41bd2059d"
    },
    {
      "id": "576212a8-fda9-428c-87ad-87593181bdd8",
      "text": "Lạy Chúa,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 4,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:24:21.992Z",
      "updatedAt": "2025-09-03T03:24:21.992Z",
      "chapterId": "4effea38-3707-40c3-909c-d5f41bd2059d"
    },
    {
      "id": "f30c3a05-24ed-444d-b405-d48008faf263",
      "text": "từ lòng âm phủ, con cầu cứu,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 5,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:24:22.006Z",
      "updatedAt": "2025-09-03T03:24:22.006Z",
      "chapterId": "4effea38-3707-40c3-909c-d5f41bd2059d"
    },
    {
      "id": "ab364142-3dc4-4acd-b502-a8cba23180cc",
      "text": "Ngài đã nghe tiếng con.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 6,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:24:22.047Z",
      "updatedAt": "2025-09-03T03:24:22.047Z",
      "chapterId": "4effea38-3707-40c3-909c-d5f41bd2059d"
    },
    {
      "id": "e63d53ad-19f4-4320-8b3f-29d213f904dc",
      "text": "Ngài đã ném con vào vực sâu,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:24:22.061Z",
      "updatedAt": "2025-09-03T03:24:22.061Z",
      "chapterId": "4effea38-3707-40c3-909c-d5f41bd2059d"
    },
    {
      "id": "2408f850-26aa-4f63-acc9-767e5d9d9d71",
      "text": "giữa lòng biển,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:24:22.088Z",
      "updatedAt": "2025-09-03T03:24:22.088Z",
      "chapterId": "4effea38-3707-40c3-909c-d5f41bd2059d"
    },
    {
      "id": "1dfbf34f-6854-4432-8849-e0c443c7e106",
      "text": "làn nước mênh mông vây bọc con,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:24:22.102Z",
      "updatedAt": "2025-09-03T03:24:22.102Z",
      "chapterId": "4effea38-3707-40c3-909c-d5f41bd2059d"
    },
    {
      "id": "7ff14e99-d254-41c5-b520-decb21bbbfcc",
      "text": "sóng cồn theo nước cuốn,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 3,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:24:22.116Z",
      "updatedAt": "2025-09-03T03:24:22.116Z",
      "chapterId": "4effea38-3707-40c3-909c-d5f41bd2059d"
    },
    {
      "id": "71c24a7a-bf2a-4c2f-9803-12f598babc19",
      "text": "Ngài để cho tràn ngập thân này.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 4,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:24:22.144Z",
      "updatedAt": "2025-09-03T03:24:22.144Z",
      "chapterId": "4effea38-3707-40c3-909c-d5f41bd2059d"
    },
    {
      "id": "e0e5eff0-66ee-43bd-a788-eb1ee8a64deb",
      "text": "Con đã nói : “Con bị đuổi đi",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:24:22.157Z",
      "updatedAt": "2025-09-03T03:24:22.157Z",
      "chapterId": "4effea38-3707-40c3-909c-d5f41bd2059d"
    },
    {
      "id": "fd9d8f92-b98c-4991-9693-042c923557fe",
      "text": "khuất mắt Chúa rồi !",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:24:22.171Z",
      "updatedAt": "2025-09-03T03:24:22.171Z",
      "chapterId": "4effea38-3707-40c3-909c-d5f41bd2059d"
    },
    {
      "id": "070ed652-3240-413c-ab0b-edf06ee32b25",
      "text": "Nhưng con vẫn hướng nhìn về",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:24:22.200Z",
      "updatedAt": "2025-09-03T03:24:22.200Z",
      "chapterId": "4effea38-3707-40c3-909c-d5f41bd2059d"
    },
    {
      "id": "925c3fba-ec7b-4db4-bd28-193ced64d779",
      "text": "thánh điện của Chúa.”",
      "label": "5",
      "number": 5,
      "subVerseIndex": 3,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:24:22.242Z",
      "updatedAt": "2025-09-03T03:24:22.242Z",
      "chapterId": "4effea38-3707-40c3-909c-d5f41bd2059d"
    },
    {
      "id": "a8c2aa3e-70fd-4b08-bd82-fa387c07de1f",
      "text": "Nước bủa vây con đến cổ,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:24:22.270Z",
      "updatedAt": "2025-09-03T03:24:22.270Z",
      "chapterId": "4effea38-3707-40c3-909c-d5f41bd2059d"
    },
    {
      "id": "2190bc64-ed9b-4693-b415-6a2d9db8e7a2",
      "text": "vực thẳm vây bọc con,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:24:22.312Z",
      "updatedAt": "2025-09-03T03:24:22.312Z",
      "chapterId": "4effea38-3707-40c3-909c-d5f41bd2059d"
    },
    {
      "id": "829cf5d7-24c0-4b08-982a-1e11aef1fdda",
      "text": "trên đầu con,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:24:22.326Z",
      "updatedAt": "2025-09-03T03:24:22.326Z",
      "chapterId": "4effea38-3707-40c3-909c-d5f41bd2059d"
    },
    {
      "id": "6e36529c-1b9e-4da7-a5b3-1a7ef36cb012",
      "text": "rong rêu quấn chằng chịt.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 3,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:24:22.340Z",
      "updatedAt": "2025-09-03T03:24:22.340Z",
      "chapterId": "4effea38-3707-40c3-909c-d5f41bd2059d"
    },
    {
      "id": "27b70ddf-b20c-4b91-9a2a-693ccc71c3a5",
      "text": "Con đã xuống",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:24:22.357Z",
      "updatedAt": "2025-09-03T03:24:22.357Z",
      "chapterId": "4effea38-3707-40c3-909c-d5f41bd2059d"
    },
    {
      "id": "fcc631a5-fee5-4662-86f0-d970265ca9c7",
      "text": "tận nền móng núi non,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:24:22.371Z",
      "updatedAt": "2025-09-03T03:24:22.371Z",
      "chapterId": "4effea38-3707-40c3-909c-d5f41bd2059d"
    },
    {
      "id": "e5728b07-e974-488c-871d-dbd85e3e526d",
      "text": "cửa lòng đất",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:24:22.398Z",
      "updatedAt": "2025-09-03T03:24:22.398Z",
      "chapterId": "4effea38-3707-40c3-909c-d5f41bd2059d"
    },
    {
      "id": "9c925cd4-a06a-43c9-880c-268a1c728ddd",
      "text": "đã cài then nhốt con mãi mãi.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 3,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:24:22.412Z",
      "updatedAt": "2025-09-03T03:24:22.412Z",
      "chapterId": "4effea38-3707-40c3-909c-d5f41bd2059d"
    },
    {
      "id": "39132609-2084-47b4-b60f-675e8f4f71a4",
      "text": "Nhưng Ngài đã đưa sự sống",
      "label": "7",
      "number": 7,
      "subVerseIndex": 4,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:24:22.426Z",
      "updatedAt": "2025-09-03T03:24:22.426Z",
      "chapterId": "4effea38-3707-40c3-909c-d5f41bd2059d"
    },
    {
      "id": "c9c208be-2e27-4102-af6c-23c3a72ade05",
      "text": "của con lên khỏi huyệt,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 5,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:24:22.439Z",
      "updatedAt": "2025-09-03T03:24:22.439Z",
      "chapterId": "4effea38-3707-40c3-909c-d5f41bd2059d"
    },
    {
      "id": "4d88bde9-f6fc-466b-89e8-9c623d49b91c",
      "text": "lạy ĐỨC CHÚA",
      "label": "7",
      "number": 7,
      "subVerseIndex": 6,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:24:22.467Z",
      "updatedAt": "2025-09-03T03:24:22.467Z",
      "chapterId": "4effea38-3707-40c3-909c-d5f41bd2059d"
    },
    {
      "id": "a08e8a02-b5a8-4704-9210-ae0683de0fb4",
      "text": "là Thiên Chúa của con.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 7,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:24:22.494Z",
      "updatedAt": "2025-09-03T03:24:22.494Z",
      "chapterId": "4effea38-3707-40c3-909c-d5f41bd2059d"
    },
    {
      "id": "7b0a3b4a-6e0c-4a28-a73c-7bec965cbb05",
      "text": "Khi mạng sống con hầu tàn,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:24:22.508Z",
      "updatedAt": "2025-09-03T03:24:22.508Z",
      "chapterId": "4effea38-3707-40c3-909c-d5f41bd2059d"
    },
    {
      "id": "5dc48810-1a70-4c90-a97c-c9e39d16509d",
      "text": "con đã nhớ đến ĐỨC CHÚA",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:24:22.535Z",
      "updatedAt": "2025-09-03T03:24:22.535Z",
      "chapterId": "4effea38-3707-40c3-909c-d5f41bd2059d"
    },
    {
      "id": "a68588d3-96d3-4efc-8bdc-b69b1d6d13f3",
      "text": "và lời cầu nguyện của con",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:24:22.565Z",
      "updatedAt": "2025-09-03T03:24:22.565Z",
      "chapterId": "4effea38-3707-40c3-909c-d5f41bd2059d"
    },
    {
      "id": "bca6d0ae-ee61-4e03-b533-e2750209f5cc",
      "text": "đã tới Ngài,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 3,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:24:22.585Z",
      "updatedAt": "2025-09-03T03:24:22.585Z",
      "chapterId": "4effea38-3707-40c3-909c-d5f41bd2059d"
    },
    {
      "id": "43d7385a-aaf6-424d-ac3f-85689b16940e",
      "text": "tới đền thánh của Ngài.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 4,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:24:22.598Z",
      "updatedAt": "2025-09-03T03:24:22.598Z",
      "chapterId": "4effea38-3707-40c3-909c-d5f41bd2059d"
    },
    {
      "id": "05c396ca-355f-4970-9622-df6d37a5c5ad",
      "text": "Bọn thờ thần hư ảo, chớ gì chúng",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:24:22.625Z",
      "updatedAt": "2025-09-03T03:24:22.625Z",
      "chapterId": "4effea38-3707-40c3-909c-d5f41bd2059d"
    },
    {
      "id": "d21334c7-ed2f-4d26-b81d-91d769bf853b",
      "text": "bỏ điều chúng vẫn tôn sùng.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:24:22.653Z",
      "updatedAt": "2025-09-03T03:24:22.653Z",
      "chapterId": "4effea38-3707-40c3-909c-d5f41bd2059d"
    },
    {
      "id": "c35de00a-f800-4020-82b6-d2110a3ec742",
      "text": "Phần con, giữa tiếng hát tạ ơn,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:24:22.681Z",
      "updatedAt": "2025-09-03T03:24:22.681Z",
      "chapterId": "4effea38-3707-40c3-909c-d5f41bd2059d"
    },
    {
      "id": "5f191ea9-bcc7-43eb-8f7f-dc8dc386f152",
      "text": "con sẽ tiến dâng Ngài hy lễ ;",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:24:22.695Z",
      "updatedAt": "2025-09-03T03:24:22.695Z",
      "chapterId": "4effea38-3707-40c3-909c-d5f41bd2059d"
    },
    {
      "id": "5795eb21-a385-462e-8c49-29e126007eff",
      "text": "con xin giữ trọn",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
