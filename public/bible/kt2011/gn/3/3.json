    {
      "id": "d52301e2-5590-400d-bc2e-44b051935a70",
      "content": "*Tin vào Thiên Chúa* : kiểu nói đã sử dụng trong St 15,6 để nói về lòng tin của ông Áp-ra-ham và nhờ đó ông được kể là người công chính.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "16",
      "sortOrder": 15,
      "startOffset": 17,
      "endOffset": 17,
      "createdAt": "2025-09-03T03:24:34.804Z",
      "updatedAt": "2025-09-03T03:24:34.804Z",
      "targetId": "5529819e-6e98-49f5-8d10-9c2f6ffacd0e",
