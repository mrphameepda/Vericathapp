    {
      "id": "aa204611-c9a6-4a85-98c6-c9b5ed480765",
      "content": "Dân Ni-ni-vê mau mắn tin vào Thiên Chúa và bày tỏ lòng thống hối.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "14",
