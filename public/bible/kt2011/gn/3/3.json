      "chapterId": "7632ba20-cb9f-46ff-bb48-611f9f050d8a"
    },
    {
      "id": "97d7a73c-61c3-4484-aa75-79ab5deafb44",
      "content": "English: Niniveh | French: Ninive | Latin: Ninive | Origin: &#1504;&#1460;&#1497;&#1504;&#1456;&#1493;&#1461;&#1492; | Vietnamese: Ni-ni-vê 1 -- thủ đô của At-sua, Gn 1,2tt ; Xp 2,13",
