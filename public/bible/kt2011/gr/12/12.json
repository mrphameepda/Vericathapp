{
  "chapter": {
    "id": "8ead43cf-b0f9-4840-afcc-c12b2a99413b",
    "number": 12,
    "createdAt": "2025-09-03T01:07:51.715Z",
    "updatedAt": "2025-09-03T01:07:51.715Z",
    "bookId": "c92e7a81-cffb-41b9-b0fa-6fe19669410a"
  },
  "verses": [
    {
      "id": "c180e6f5-06d5-4b93-a9d3-19680d728b02",
      "text": "Lạy ĐỨC CHÚA, Ngài quả là chính trực,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:05:05.817Z",
      "updatedAt": "2025-09-03T03:05:05.817Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "498c2028-2bdd-44e9-be5b-9e2fa4c44b3e",
      "text": "con đâu dám tranh luận với Ngài,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:05:05.888Z",
      "updatedAt": "2025-09-03T03:05:05.888Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "2914a6cb-cd2b-448d-8c11-121bc33b0aab",
      "text": "nhưng chỉ xin thưa về một vài phán quyết :",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:05:05.901Z",
      "updatedAt": "2025-09-03T03:05:05.901Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "f8755e87-b602-456d-a898-d04d344a2451",
      "text": "Tại sao kẻ gian ác thịnh đạt trên đường đời,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 3,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:05:05.913Z",
      "updatedAt": "2025-09-03T03:05:05.913Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "8041fda7-f377-4a93-a797-108cc1b529ef",
      "text": "tại sao mọi quân phản bội cứ bình an vô sự ?",
      "label": "1",
      "number": 1,
      "subVerseIndex": 4,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:05:05.941Z",
      "updatedAt": "2025-09-03T03:05:05.941Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "96e446f0-b2f2-41c4-8657-7fdf3c42a44a",
      "text": "Ngài trồng chúng, chúng liền bén rễ,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:05:05.955Z",
      "updatedAt": "2025-09-03T03:05:05.955Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "04ea4d0c-f459-4649-9b6a-b6c0eecc29cc",
      "text": "chúng phát triển rồi sinh hoa trái.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:05:05.969Z",
      "updatedAt": "2025-09-03T03:05:05.969Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "ea0a839d-25bb-4e1d-b4f9-a47247a77f27",
      "text": "Môi miệng chúng tuy kêu cầu Ngài, nhưng lòng dạ thì lại ở xa.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:05:05.983Z",
      "updatedAt": "2025-09-03T03:05:05.983Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "0cdcd93b-acec-4328-b82c-9ca46c657727",
      "text": "Lạy ĐỨC CHÚA, Ngài biết con và Ngài thấy rõ,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:05:06.010Z",
      "updatedAt": "2025-09-03T03:05:06.010Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "18f6c702-aad6-45f5-a24a-0ea30d7b3308",
      "text": "Ngài dò xét lòng con, lòng con ở bên Ngài.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:05:06.039Z",
      "updatedAt": "2025-09-03T03:05:06.039Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "71f99fb7-7260-4d1b-8136-09e4942b1697",
      "text": "Xin tách biệt quân gian ác, như tách chiên để đưa tới lò sát sinh.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:05:06.062Z",
      "updatedAt": "2025-09-03T03:05:06.062Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "03b28b9d-cec9-438d-9588-f1f3f8191815",
      "text": "Xin dành riêng chúng ra chờ ngày tàn sát.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 3,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:05:06.098Z",
      "updatedAt": "2025-09-03T03:05:06.098Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "c829b603-3208-4953-a49f-d032860d3490",
      "text": "Cho đến bao giờ xứ sở còn tang tóc,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:05:06.146Z",
      "updatedAt": "2025-09-03T03:05:06.146Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "eba1ff0c-c363-4c53-8c78-4f2ea606429c",
      "text": "và cỏ rả ngoài đồng còn héo khô ?",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:05:06.174Z",
      "updatedAt": "2025-09-03T03:05:06.174Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "64e23ed2-d43e-4bab-9c9d-457519ccc915",
      "text": "Vì tội ác của dân cư trong xứ",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:05:06.189Z",
      "updatedAt": "2025-09-03T03:05:06.189Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "ca4dc8dd-aadf-4ddf-aee7-4fc25a86e955",
      "text": "mà thú vật và chim muông đều biến sạch.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 3,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:05:06.217Z",
      "updatedAt": "2025-09-03T03:05:06.217Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "a80a5c39-4fd0-489d-9353-3a536231edfa",
      "text": "Chúng nói : “Người không thấy các đường nẻo của tôi.”",
      "label": "4",
      "number": 4,
      "subVerseIndex": 4,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:05:06.245Z",
      "updatedAt": "2025-09-03T03:05:06.245Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "eaa1b915-f1dd-46b4-9500-7468c046ad8e",
      "text": "Ngươi chạy với người đi bộ mà còn nhọc mệt,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:05:06.259Z",
      "updatedAt": "2025-09-03T03:05:06.259Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "5607df99-d4fc-4aff-8adf-10d394a1a9d9",
      "text": "thì chạy đua với ngựa làm sao ?",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:05:06.287Z",
      "updatedAt": "2025-09-03T03:05:06.287Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "db527ff5-5153-49a7-ac4c-29f1a18fd931",
      "text": "Nếu ngươi chỉ thấy an tâm trong một xứ thái bình,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:05:06.301Z",
      "updatedAt": "2025-09-03T03:05:06.301Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "dff336ff-5bc4-4174-abfc-559f7d8f2e07",
      "text": "thì trong bụi rậm sông Gio-đan, an tâm làm sao được ?",
      "label": "5",
      "number": 5,
      "subVerseIndex": 3,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:05:06.334Z",
      "updatedAt": "2025-09-03T03:05:06.334Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "cdef6680-b989-480b-81b0-415bc7127434",
      "text": "Phải, ngay cả anh em ngươi và nhà cha ngươi, chính chúng cũng phản bội ngươi ; sau lưng ngươi, chính chúng nặng lời chỉ trích ngươi : đừng tin chúng khi chúng nói ngon nói ngọt với ngươi.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T03:05:06.376Z",
      "updatedAt": "2025-09-03T03:05:06.376Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "1deffc29-702c-4bce-a7bf-71beb9912ceb",
      "text": "Nhà của Ta, Ta đã bỏ rơi, cơ nghiệp của Ta, Ta cũng vứt bỏ ;",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:05:06.420Z",
      "updatedAt": "2025-09-03T03:05:06.420Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "88e99546-126a-4d1c-a762-f8392612c28e",
      "text": "kẻ lòng Ta yêu mến, Ta đã trao vào tay thù địch.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:05:06.482Z",
      "updatedAt": "2025-09-03T03:05:06.482Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "9f7c1c3a-2dc6-4308-97f4-afbe56c619c0",
      "text": "Cơ nghiệp của Ta đã xử với Ta",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:05:06.496Z",
      "updatedAt": "2025-09-03T03:05:06.496Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "2ab0b08e-0e01-4ab4-851d-0646a0f336e5",
      "text": "như một con sư tử trong rừng ;",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:05:06.509Z",
      "updatedAt": "2025-09-03T03:05:06.509Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "a9f4e687-11d5-4850-ba32-5359a0fc61dc",
      "text": "nó rống lên chống Ta, vì vậy Ta ghét nó.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:05:06.524Z",
      "updatedAt": "2025-09-03T03:05:06.524Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "7119b23d-1747-4f20-ba42-aefba4aec18d",
      "text": "Cơ nghiệp của Ta có phải là một con chim sặc sỡ",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:05:06.540Z",
      "updatedAt": "2025-09-03T03:05:06.540Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "950e7d15-12a8-4f05-af8a-d64f07fda022",
      "text": "cho mãnh cầm vây quanh ?",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:05:06.554Z",
      "updatedAt": "2025-09-03T03:05:06.554Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "abe586c9-d9cf-4360-86ec-f9bcabf88256",
      "text": "Hỡi tất cả thú vật ngoài đồng,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:05:06.600Z",
      "updatedAt": "2025-09-03T03:05:06.600Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "cbdab020-d439-4b85-a66a-39a5e662dfb8",
      "text": "hãy đến, tập trung lại, đến mà ăn thịt con chim đó.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 3,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:05:06.613Z",
      "updatedAt": "2025-09-03T03:05:06.613Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "e15eb52f-28df-4e9c-a80a-d98fd024a94c",
      "text": "Vườn nho của Ta, nhiều kẻ chăn chiên đến phá hoại,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:05:06.641Z",
      "updatedAt": "2025-09-03T03:05:06.641Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "0c5f73a5-aa95-4224-8355-6b5ff3324267",
      "text": "thửa đất của Ta, chúng giày xéo.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:05:06.670Z",
      "updatedAt": "2025-09-03T03:05:06.670Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "722e4738-e98a-4784-97fb-36173f97e615",
      "text": "Thửa đất yêu quý của Ta, chúng biến thành sa mạc cằn cỗi,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:05:06.684Z",
      "updatedAt": "2025-09-03T03:05:06.684Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "66191365-3257-4ac2-ac7d-d4f8ceaa0486",
      "text": "chúng biến thành nơi cằn cỗi hoang vu.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:05:06.712Z",
      "updatedAt": "2025-09-03T03:05:06.712Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "27a0f1a8-568c-4c05-8a4b-c112fe5b769e",
      "text": "Trước mặt Ta, thửa đất ấy trông tang thương cằn cỗi.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:05:06.726Z",
      "updatedAt": "2025-09-03T03:05:06.726Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "b28c74a7-9515-4749-a97f-667604af4de3",
      "text": "Cả xứ ra cằn cỗi vì không người để tâm.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:05:06.741Z",
      "updatedAt": "2025-09-03T03:05:06.741Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "6482f5bc-81f3-4961-ac66-c279f8deacf2",
      "text": "Trên khắp các đồi hoang trong sa mạc, quân phá hoại kéo đến,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:05:06.769Z",
      "updatedAt": "2025-09-03T03:05:06.769Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "1d836345-b008-47d2-a69f-f1ebb29b33bd",
      "text": "vì ĐỨC CHÚA cầm gươm tiễu trừ từ đầu xứ đến cuối xứ ;",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:05:06.796Z",
      "updatedAt": "2025-09-03T03:05:06.796Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "fd94ce19-7790-4da0-89a0-17913e57b36b",
      "text": "không một xác phàm nào được bình an.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:05:06.839Z",
      "updatedAt": "2025-09-03T03:05:06.839Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "6ac8afe8-9126-4a1b-8bc2-eb5fef88c584",
      "text": "Chúng gieo lúa mì, nhưng lại gặt gai góc,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:05:06.867Z",
      "updatedAt": "2025-09-03T03:05:06.867Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "8fe558e9-1d47-4620-9f9c-de7c4d1cf958",
      "text": "rã rời mệt mỏi mà chẳng lợi lộc chi.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:05:06.882Z",
      "updatedAt": "2025-09-03T03:05:06.882Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "6acd2b2c-56b1-4531-8b33-813ff8d7cf9a",
      "text": "Hãy xấu hổ về những gì các ngươi gặt hái",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:05:06.896Z",
      "updatedAt": "2025-09-03T03:05:06.896Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "3c0f9bb6-d790-4898-a3a5-a3dc23785bcf",
      "text": "vì lửa giận của ĐỨC CHÚA bừng bừng.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 3,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:05:06.910Z",
      "updatedAt": "2025-09-03T03:05:06.910Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "ebf065a2-b6fc-4855-98f7-ffafcda39c16",
      "text": "ĐỨC CHÚA phán như sau : Tất cả những kẻ láng giềng xấu xa của Ta, những kẻ làm hại cơ nghiệp mà Ta đã ban cho dân Ta là Ít-ra-en làm sở hữu. Này Ta sắp bứng chúng ra khỏi đất đai của chúng, cả nhà Giu-đa, Ta cũng sẽ bứng ra khỏi xứ sở chúng.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T03:05:06.952Z",
      "updatedAt": "2025-09-03T03:05:06.952Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "23d2132e-fe86-4f90-b919-af9e10b10cca",
      "text": "Nhưng sau khi đã bứng rồi, Ta sẽ lại đem lòng chạnh thương chúng và cho chúng trở về, ai nấy về phần gia nghiệp, về phần đất của mình.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 1,
      "isPoetry": false,
      "createdAt": "2025-09-03T03:05:07.054Z",
      "updatedAt": "2025-09-03T03:05:07.054Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "f4e67225-36e9-46de-829b-fe64d54f5870",
      "text": "Nếu chúng chuyên cần học hỏi đường lối của dân Ta, lấy danh Ta mà thề “có ĐỨC CHÚA hằng sống”, theo cách chúng đã dạy dân Ta lấy danh Ba-an mà thề, thì chúng sẽ được nhập cư giữa dân Ta.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 2,
      "isPoetry": false,
      "createdAt": "2025-09-03T03:05:07.098Z",
      "updatedAt": "2025-09-03T03:05:07.098Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    },
    {
      "id": "c72b3109-e08f-4f81-904b-f5c4bb3b1dae",
      "text": "Nhưng nếu chúng không nghe, thì Ta sẽ bứng dân tộc ấy ; Ta sẽ bứng đi và tiêu diệt nó. Sấm ngôn của ĐỨC CHÚA.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 3,
      "isPoetry": false,
      "createdAt": "2025-09-03T03:05:07.170Z",
      "updatedAt": "2025-09-03T03:05:07.170Z",
      "chapterId": "8ead43cf-b0f9-4840-afcc-c12b2a99413b"
    }
  ],
  "marks": [
    {
      "id": "f64dd275-856e-4ef0-a49c-31dfd0817373",
      "content": "Ngôn sứ đối thoại với Đức Chúa kiểu sách khôn ngoan. Lần đầu tiên trong Cựu Ước vấn đề hạnh phúc của kẻ gian ác được đặt ra. Sau này các sách khôn ngoan, nhất là Gióp sẽ đề cập khá nhiều đến đề tài này. Những nhận xét chung chung của Giê-rê-mi-a ở đây có thể đưa về những hoàn cảnh khác nhau trong đời ông, nên không xác định rõ được thời gian công bố. Có điều hơi lạ là những lời ta thán về hạnh phúc của kẻ gian ác như thế này lại đi liền sau lời Chúa báo cho ông Giê-rê-mi-a biết thù địch của ông sắp bị trừng phạt (11,21-23).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 24,
      "endOffset": 24,
      "createdAt": "2025-09-03T03:05:05.845Z",
