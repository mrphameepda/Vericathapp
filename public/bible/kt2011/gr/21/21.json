  "headings": [
    {
      "id": "34c82e19-613a-4169-8901-342dac9c0ea5",
      "text": "3. CÁC SẤM NGÔN, ĐẶC BIỆT SẤM NGÔN SAU TRIỀU ĐẠI VUA GIÔ-GIA-KIM",
      "level": 1,
      "sortOrder": 0,
