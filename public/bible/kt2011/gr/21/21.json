    },
    {
      "id": "e8a81414-dd83-4172-8f2b-0f1bb67e4708",
      "text": "Câu trả lời cho phái đoàn của vua Xít-ki-gia-hu",
      "level": 2,
      "sortOrder": 1,
      "createdAt": "2025-09-03T03:06:28.194Z",
