    {
      "id": "c32deda7-d1d6-426c-9f45-416fae19633e",
      "content": "Gr 18,1",
      "kind": "MARK_KIND_REFERENCE",
      "label": "1@",
      "sortOrder": 0,
      "startOffset": 7,
      "endOffset": 7,
      "createdAt": "2025-09-03T03:06:28.302Z",
      "updatedAt": "2025-09-03T03:06:28.302Z",
      "targetId": "53157345-760f-4910-91eb-f1fc3f0d7594",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "75fea782-4278-4aca-979f-b836aee2e1b9"
    },
    {
      "id": "b6aae01a-52bd-4ea6-a256-8642fa11563a",
      "content": "Hoàn cảnh chung quanh trình thuật này hoàn toàn khác với môi trường của các chương trước. Vua Giơ-hô-gia-kim, người thường có thái độ hiềm khích và khinh rẻ đối với ngôn sứ Giê-rê-mi-a không còn nữa. Giơ-hô-gia-khin lên kế vị nhưng rồi bị Na-bu-cô-đô-nô-xo truất phế. Mát-tan-gia, chú của vua, được đặt lên thay thế, đổi tên là Xít-ki-gia-hu. Biến cố năm 598 đã cho thấy lời đe doạ của Giê-rê-mi-a ứng nghiệm phần nào, khiến những cố vấn của vua tỏ ra tin cẩn ngôn sứ hơn, mặc dầu người ta vẫn theo một đường lối chính trị dựa vào ngoại bang. Dầu sao thì lúc hữu sự, vua và triều đình vẫn nhờ Giê-rê-mi-a thỉnh ý Chúa cho họ. Phái đoàn được nói tới trong trình thuật này xảy ra vào năm 588. Trình thuật được đặt ở đây có lẽ để làm nổi bật thái độ đối nghịch của hai nhân vật cùng mang tên Pát-khua, ở đây và ở 20,1.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 47,
      "endOffset": 47,
      "createdAt": "2025-09-03T03:06:28.215Z",
      "updatedAt": "2025-09-03T03:06:28.215Z",
      "targetId": "e8a81414-dd83-4172-8f2b-0f1bb67e4708",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "75fea782-4278-4aca-979f-b836aee2e1b9"
    },
    {
      "id": "ae0dbe12-efd8-45bd-8611-1d7946fecf8d",
      "content": "Gr 37,7; 2 V 22,13",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 9,
      "endOffset": 9,
      "createdAt": "2025-09-03T03:06:28.405Z",
      "updatedAt": "2025-09-03T03:06:28.405Z",
      "targetId": "007cad80-d46c-4bc2-90c4-67ea69ad0f20",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "75fea782-4278-4aca-979f-b836aee2e1b9"
    },
    {
      "id": "e7ee0ebd-ee04-40da-9f16-201788252c7a",
      "content": "English: Yahweh | French: SEIGNEUR | Latin: Dominus | Origin: &#1497;&#1456;&#1492;&#64331;&#1464;&#1492; | Vietnamese: ĐỨC CHÚA -- Danh của Thiên Chúa Ít-ra-en, St 2,4...",
