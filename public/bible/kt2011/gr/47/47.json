{
  "chapter": {
    "id": "53b83ff7-5f27-4e23-8186-0a48cb395c53",
    "number": 47,
    "createdAt": "2025-09-03T01:07:51.715Z",
    "updatedAt": "2025-09-03T01:07:51.715Z",
    "bookId": "c92e7a81-cffb-41b9-b0fa-6fe19669410a"
  },
  "verses": [
    {
      "id": "4dcdaf26-178c-4d19-ae61-5b6af9141324",
      "text": "Có lời ĐỨC CHÚA phán với ngôn sứ Giê-rê-mi-a về người Phi-li-tinh trước khi Pha-ra-ô đánh Ga-da.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T03:10:15.022Z",
      "updatedAt": "2025-09-03T03:10:15.022Z",
      "chapterId": "53b83ff7-5f27-4e23-8186-0a48cb395c53"
    },
    {
      "id": "cce49ae7-ab1e-46b8-a1ad-0d0930b3175d",
      "text": "ĐỨC CHÚA phán thế này :",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:10:15.155Z",
      "updatedAt": "2025-09-03T03:10:15.155Z",
      "chapterId": "53b83ff7-5f27-4e23-8186-0a48cb395c53"
    },
    {
      "id": "163d3242-3a6f-4845-8834-58d8bf493f5a",
      "text": "Này đây nước dâng lên từ phương bắc,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:10:15.181Z",
      "updatedAt": "2025-09-03T03:10:15.181Z",
      "chapterId": "53b83ff7-5f27-4e23-8186-0a48cb395c53"
    },
    {
      "id": "16e83b20-9f48-4c68-83ca-e8ac378cebbf",
      "text": "biến thành thác lũ chảy lan tràn,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:10:15.195Z",
      "updatedAt": "2025-09-03T03:10:15.195Z",
      "chapterId": "53b83ff7-5f27-4e23-8186-0a48cb395c53"
    },
    {
      "id": "9c0850ed-e89f-4f89-a557-2c9283c2580a",
      "text": "tràn ngập khắp xứ sở và mọi vật trong đó,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 3,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:10:15.224Z",
      "updatedAt": "2025-09-03T03:10:15.224Z",
      "chapterId": "53b83ff7-5f27-4e23-8186-0a48cb395c53"
    },
    {
      "id": "a561b7b8-b9b2-491c-ba15-e089087df709",
      "text": "tràn ngập cả thành thị lẫn cư dân.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 4,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:10:15.238Z",
      "updatedAt": "2025-09-03T03:10:15.238Z",
      "chapterId": "53b83ff7-5f27-4e23-8186-0a48cb395c53"
    },
    {
      "id": "00e69f3b-4501-4847-994c-c36cd522497b",
      "text": "Thiên hạ kêu la inh ỏi, mọi cư dân trong xứ đều khóc rú lên.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 5,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:10:15.252Z",
      "updatedAt": "2025-09-03T03:10:15.252Z",
      "chapterId": "53b83ff7-5f27-4e23-8186-0a48cb395c53"
    },
    {
      "id": "3044d94f-d38f-459b-afcf-2e03b9865dca",
      "text": "Tiếng vó ngựa lộp cộp, tiếng chiến xa vang rền,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:10:15.266Z",
      "updatedAt": "2025-09-03T03:10:15.266Z",
      "chapterId": "53b83ff7-5f27-4e23-8186-0a48cb395c53"
    },
    {
      "id": "32610aca-85a2-4436-b721-7fe255e61803",
      "text": "tiếng bánh xe ầm ĩ, khiến người cha, hai tay bủn rủn,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:10:15.308Z",
      "updatedAt": "2025-09-03T03:10:15.308Z",
      "chapterId": "53b83ff7-5f27-4e23-8186-0a48cb395c53"
    },
    {
      "id": "2cf21b0f-2149-44cb-8068-92459d5c25dd",
      "text": "chẳng còn màng đến con.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:10:15.322Z",
      "updatedAt": "2025-09-03T03:10:15.322Z",
      "chapterId": "53b83ff7-5f27-4e23-8186-0a48cb395c53"
    },
    {
      "id": "aa95ef80-d5c6-4357-a82a-3fd25a6ab3fc",
      "text": "Bởi vì Ngày ấy đến tiêu diệt mọi người Phi-li-tinh,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:10:15.340Z",
      "updatedAt": "2025-09-03T03:10:15.340Z",
      "chapterId": "53b83ff7-5f27-4e23-8186-0a48cb395c53"
    },
    {
      "id": "8fe0dc97-0299-4170-a3b9-46bf047c6361",
      "text": "khiến cả Tia lẫn Xi-đôn",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:10:15.368Z",
      "updatedAt": "2025-09-03T03:10:15.368Z",
      "chapterId": "53b83ff7-5f27-4e23-8186-0a48cb395c53"
    },
    {
      "id": "f341edf8-08d3-4b57-a143-296091aa340d",
      "text": "không còn sót lại ai để tiếp cứu.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:10:15.404Z",
      "updatedAt": "2025-09-03T03:10:15.404Z",
      "chapterId": "53b83ff7-5f27-4e23-8186-0a48cb395c53"
    },
    {
      "id": "a2653e30-75bf-4fc1-90d9-14ba010a2209",
      "text": "Phải, ĐỨC CHÚA tiêu diệt người Phi-li-tinh,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 3,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:10:15.416Z",
      "updatedAt": "2025-09-03T03:10:15.416Z",
      "chapterId": "53b83ff7-5f27-4e23-8186-0a48cb395c53"
    },
    {
      "id": "6a31eb13-14f1-4f59-bdb9-fc406157b897",
      "text": "là cư dân đảo Cáp-to còn sót lại.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 4,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:10:15.448Z",
      "updatedAt": "2025-09-03T03:10:15.448Z",
      "chapterId": "53b83ff7-5f27-4e23-8186-0a48cb395c53"
    },
    {
      "id": "fda464db-4a2a-4e99-ad54-656938fcec3b",
      "text": "Ga-da đã cạo đầu xuống tóc, Át-cơ-lôn cũng bị tiêu tan.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:10:15.481Z",
      "updatedAt": "2025-09-03T03:10:15.481Z",
      "chapterId": "53b83ff7-5f27-4e23-8186-0a48cb395c53"
    },
    {
      "id": "42be2bad-f99a-46df-98ce-c5e0a2036e9e",
      "text": "Này ngươi, hỡi phần dân còn lại",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:10:15.519Z",
      "updatedAt": "2025-09-03T03:10:15.519Z",
      "chapterId": "53b83ff7-5f27-4e23-8186-0a48cb395c53"
    },
    {
      "id": "fbca08b5-2e0f-4cd2-a552-133eab35fa07",
      "text": "đang sống trong thung lũng của chúng,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:10:15.532Z",
      "updatedAt": "2025-09-03T03:10:15.532Z",
      "chapterId": "53b83ff7-5f27-4e23-8186-0a48cb395c53"
    },
    {
      "id": "bec372e7-b315-4360-9d47-b177c46755d7",
      "text": "cho đến bao giờ ngươi sẽ rạch mình ?",
      "label": "5",
      "number": 5,
      "subVerseIndex": 3,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:10:15.547Z",
      "updatedAt": "2025-09-03T03:10:15.547Z",
      "chapterId": "53b83ff7-5f27-4e23-8186-0a48cb395c53"
    },
    {
      "id": "b57251a3-1c1d-495f-8b83-1d9f7ce03c8e",
      "text": "Ôi, gươm của ĐỨC CHÚA,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:10:15.575Z",
      "updatedAt": "2025-09-03T03:10:15.575Z",
      "chapterId": "53b83ff7-5f27-4e23-8186-0a48cb395c53"
    },
    {
      "id": "06e23a17-b4e4-43f2-886b-0dba2ddac85e",
      "text": "ngươi không được nghỉ ngơi mãi đến bao giờ ?",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:10:15.617Z",
      "updatedAt": "2025-09-03T03:10:15.617Z",
      "chapterId": "53b83ff7-5f27-4e23-8186-0a48cb395c53"
    },
    {
      "id": "a000e5f2-1bcc-4539-b51f-dbaef233adbd",
      "text": "Hãy lại rút vào bao, ở yên, ngưng lại !",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:10:15.631Z",
      "updatedAt": "2025-09-03T03:10:15.631Z",
      "chapterId": "53b83ff7-5f27-4e23-8186-0a48cb395c53"
    },
    {
      "id": "6798dfa7-c805-462f-85e1-df00bcab9548",
      "text": "Ngươi nghỉ sao được, khi ĐỨC CHÚA còn ra lệnh truyền ?",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:10:15.645Z",
      "updatedAt": "2025-09-03T03:10:15.645Z",
      "chapterId": "53b83ff7-5f27-4e23-8186-0a48cb395c53"
    },
    {
      "id": "6f87804f-f74e-46eb-97f6-e82e94a7d061",
      "text": "Át-cơ-lôn và vùng duyên hải, đó là nơi Người đã định cho nó.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:10:15.668Z",
      "updatedAt": "2025-09-03T03:10:15.668Z",
      "chapterId": "53b83ff7-5f27-4e23-8186-0a48cb395c53"
    }
  ],
