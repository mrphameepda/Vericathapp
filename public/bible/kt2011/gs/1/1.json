  "headings": [
    {
      "id": "c635ed96-132c-436b-9b25-255d6ceba6b2",
      "text": "SÁCH GIÔ-SUÊ",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T01:31:54.272Z",
      "updatedAt": "2025-09-03T01:31:54.272Z",
      "verseId": "9320da8c-31db-456e-84ad-cfabea7e8cd4",
      "chapterId": "904dcdd3-9927-4f5d-9778-6fd499fc29eb"
    },
    {
      "id": "94b2229d-286e-4e8a-b718-42d02e462a7c",
      "text": "Trung tín với Lề Luật : điều kiện để được Thiên Chúa phù trợ",
      "level": 3,
      "sortOrder": 0,
      "createdAt": "2025-09-03T01:31:54.853Z",
      "updatedAt": "2025-09-03T01:31:54.853Z",
      "verseId": "f7ca2b24-460f-42e7-b5c6-529a80bffb8c",
      "chapterId": "904dcdd3-9927-4f5d-9778-6fd499fc29eb"
    },
    {
      "id": "c69d3b58-b08d-469c-b516-7f7c7c211c05",
      "text": "Các chi tộc bên kia sông Gio-đan tiếp tay",
      "level": 3,
      "sortOrder": 0,
      "createdAt": "2025-09-03T01:31:55.020Z",
      "updatedAt": "2025-09-03T01:31:55.020Z",
      "verseId": "5fc7c45e-d382-4f6f-b02e-21c48dd3dc77",
      "chapterId": "904dcdd3-9927-4f5d-9778-6fd499fc29eb"
    },
    {
      "id": "6856537a-4757-446a-92f1-6a8ff24dd80b",
      "text": "I. CHIẾM ĐẤT HỨA",
      "level": 2,
      "sortOrder": 1,
      "createdAt": "2025-09-03T01:31:54.290Z",
      "updatedAt": "2025-09-03T01:31:54.290Z",
      "verseId": "9320da8c-31db-456e-84ad-cfabea7e8cd4",
      "chapterId": "904dcdd3-9927-4f5d-9778-6fd499fc29eb"
    },
    {
      "id": "532fc33d-fad7-4878-9b3d-496926a2eeb5",
      "text": "1. CHUẨN BỊ",
      "level": 2,
      "sortOrder": 2,
      "createdAt": "2025-09-03T01:31:54.307Z",
      "updatedAt": "2025-09-03T01:31:54.307Z",
      "verseId": "9320da8c-31db-456e-84ad-cfabea7e8cd4",
      "chapterId": "904dcdd3-9927-4f5d-9778-6fd499fc29eb"
    },
    {
      "id": "606fdf5e-b382-45a1-94b5-4f9570bc4c7e",
      "text": "Mời gọi qua Đất Hứa",
      "level": 3,
      "sortOrder": 3,
      "createdAt": "2025-09-03T01:31:54.326Z",
      "updatedAt": "2025-09-03T01:31:54.326Z",
      "verseId": "9320da8c-31db-456e-84ad-cfabea7e8cd4",
      "chapterId": "904dcdd3-9927-4f5d-9778-6fd499fc29eb"
    }
  ],
