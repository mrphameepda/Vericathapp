    {
      "id": "7bd7120f-982e-4afb-b47e-e46f29be1ac0",
      "text": "và tiền bạc đáp ứng mọi nhu cầu.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 2,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:44:41.096Z",
      "updatedAt": "2025-09-03T02:44:41.096Z",
      "chapterId": "de97b5de-b25f-4715-84f9-0eb683c4cb04"
    },
    {
      "id": "cb4dbf41-bc7d-4aa1-9fe5-8532c9ecc1f4",
      "text": "Dù chỉ là trong tư tưởng,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:44:41.130Z",
      "updatedAt": "2025-09-03T02:44:41.130Z",
      "chapterId": "de97b5de-b25f-4715-84f9-0eb683c4cb04"
    },
    {
      "id": "84ee56df-2d93-44fc-94bb-7207bb7ae739",
      "text": "bạn cũng đừng nguyền rủa nhà vua ;",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:44:41.144Z",
      "updatedAt": "2025-09-03T02:44:41.144Z",
      "chapterId": "de97b5de-b25f-4715-84f9-0eb683c4cb04"
    },
    {
      "id": "974e0958-db60-4f63-a019-f67a77135525",
      "text": "dù là trong phòng ngủ, cũng chớ nguyền rủa người giàu có,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 2,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:44:41.173Z",
      "updatedAt": "2025-09-03T02:44:41.173Z",
      "chapterId": "de97b5de-b25f-4715-84f9-0eb683c4cb04"
    },
    {
      "id": "fc692326-eaac-4084-8a94-fa37d7bb1dea",
      "text": "vì chim trời có thể đưa tiếng đi thật xa,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 3,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:44:41.201Z",
      "updatedAt": "2025-09-03T02:44:41.201Z",
      "chapterId": "de97b5de-b25f-4715-84f9-0eb683c4cb04"
    },
    {
      "id": "d766a8b9-7cec-471d-805a-a678b7af878f",
      "text": "và loài có cánh sẽ đem lời thuật lại.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 4,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:44:41.215Z",
      "updatedAt": "2025-09-03T02:44:41.215Z",
