{
  "chapter": {
    "id": "de97b5de-b25f-4715-84f9-0eb683c4cb04",
    "number": 10,
    "createdAt": "2025-09-03T01:07:51.672Z",
    "updatedAt": "2025-09-03T01:07:51.672Z",
    "bookId": "928428e4-542d-4c2d-9d7f-bfd03531667e"
  },
  "verses": [
    {
      "id": "8b4ee9b2-75e0-4c6d-9580-40726c4fad7c",
      "text": "Một con ruồi chết làm thối cả bình dầu thơm ;",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:44:40.122Z",
      "updatedAt": "2025-09-03T02:44:40.122Z",
      "chapterId": "de97b5de-b25f-4715-84f9-0eb683c4cb04"
    },
    {
      "id": "c04c7c4f-eaa7-42b0-a962-883ed9a8ec2a",
      "text": "một chút ngu si gây phương hại",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:44:40.187Z",
      "updatedAt": "2025-09-03T02:44:40.187Z",
      "chapterId": "de97b5de-b25f-4715-84f9-0eb683c4cb04"
    },
    {
      "id": "52ff501b-1211-417c-b56d-d609743e4776",
      "text": "cho cả khôn ngoan và danh giá.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:44:40.200Z",
      "updatedAt": "2025-09-03T02:44:40.200Z",
      "chapterId": "de97b5de-b25f-4715-84f9-0eb683c4cb04"
    },
    {
      "id": "38b5dd66-6c08-4d0f-9684-e10f3275d5a4",
      "text": "Lòng người khôn hướng theo lẽ phải,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:44:40.228Z",
      "updatedAt": "2025-09-03T02:44:40.228Z",
      "chapterId": "de97b5de-b25f-4715-84f9-0eb683c4cb04"
    },
    {
      "id": "76c7bc12-f1a4-4022-8f00-246fb64d4559",
      "text": "tâm người dại ngả về đường trái.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:44:40.256Z",
      "updatedAt": "2025-09-03T02:44:40.256Z",
      "chapterId": "de97b5de-b25f-4715-84f9-0eb683c4cb04"
    },
    {
      "id": "7e7d3f49-9aaa-47e8-99d4-08c251985e9f",
      "text": "Cả ngoài đường, đứa ngu cũng vẫn khờ khạo, nó đi bảo với mọi người chính mình là thằng ngu.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:44:40.283Z",
      "updatedAt": "2025-09-03T02:44:40.283Z",
      "chapterId": "de97b5de-b25f-4715-84f9-0eb683c4cb04"
    },
    {
      "id": "9d4569fa-9b4a-47b7-88ee-e0863d3743c0",
      "text": "Nếu người trên có đùng đùng nổi giận, bạn cũng chớ bỏ đi, vì thái độ bình tĩnh giúp tránh được biết bao lỗi lầm.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:44:40.312Z",
      "updatedAt": "2025-09-03T02:44:40.312Z",
      "chapterId": "de97b5de-b25f-4715-84f9-0eb683c4cb04"
    },
    {
      "id": "58b53f22-c149-457c-8d4a-ce6e7c007fef",
      "text": "Tôi cũng thấy một mối hoạ dưới ánh mặt trời, một sai lầm mà người lãnh đạo không nhận ra.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:44:40.381Z",
      "updatedAt": "2025-09-03T02:44:40.381Z",
      "chapterId": "de97b5de-b25f-4715-84f9-0eb683c4cb04"
    },
    {
      "id": "a2da321f-de07-4ed0-b86e-545d3aac564f",
      "text": "Đó là : đứa ngu si được nâng lên địa vị rất cao sang, còn người phú quý lại ở vị trí thấp hèn.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:44:40.422Z",
      "updatedAt": "2025-09-03T02:44:40.422Z",
      "chapterId": "de97b5de-b25f-4715-84f9-0eb683c4cb04"
    },
    {
      "id": "3bb0be82-0cb4-4e72-b168-b4c2a2f338bf",
      "text": "Tôi thấy hạng đầy tớ chễm chệ trên lưng ngựa, trong khi bậc quan quyền phải đi bộ như hạng đầy tớ.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 1,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:44:40.451Z",
      "updatedAt": "2025-09-03T02:44:40.451Z",
      "chapterId": "de97b5de-b25f-4715-84f9-0eb683c4cb04"
    },
    {
      "id": "f44888ad-5a92-4d6f-ad82-c62560a4b3a6",
      "text": "Người đào hố có thể rơi xuống hố,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:44:40.478Z",
      "updatedAt": "2025-09-03T02:44:40.478Z",
      "chapterId": "de97b5de-b25f-4715-84f9-0eb683c4cb04"
    },
    {
      "id": "836f9a3b-767c-4901-940e-cc5d511780d1",
      "text": "kẻ phá tường e bị rắn cắn cho,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:44:40.506Z",
      "updatedAt": "2025-09-03T02:44:40.506Z",
      "chapterId": "de97b5de-b25f-4715-84f9-0eb683c4cb04"
    },
    {
      "id": "815724f0-d6e0-44d5-ab7c-9f55cb361805",
      "text": "người lấy đá có ngày bị thương tích,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:44:40.534Z",
      "updatedAt": "2025-09-03T02:44:40.534Z",
      "chapterId": "de97b5de-b25f-4715-84f9-0eb683c4cb04"
    },
    {
      "id": "d150ab59-7992-4cfb-84b2-fe50e1116f7f",
      "text": "kẻ đốn cây chắc sẽ gặp hiểm nguy.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:44:40.562Z",
      "updatedAt": "2025-09-03T02:44:40.562Z",
      "chapterId": "de97b5de-b25f-4715-84f9-0eb683c4cb04"
    },
    {
      "id": "44377397-88a6-48dd-bc81-2eafd105a75d",
      "text": "Lưỡi dao đã cùn mà không biết mài cho bén, thì phải dùng sức gấp đôi ; nhưng khôn ngoan hiểu biết thì thật có lợi.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:44:40.576Z",
      "updatedAt": "2025-09-03T02:44:40.576Z",
      "chapterId": "de97b5de-b25f-4715-84f9-0eb683c4cb04"
    },
    {
      "id": "cad8a3ae-5254-4d82-88d7-f5b611437f60",
      "text": "Làm thầy dụ rắn mà không đủ cao tay, để cho rắn cắn, thì nào được lợi lộc gì !",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:44:40.620Z",
      "updatedAt": "2025-09-03T02:44:40.620Z",
      "chapterId": "de97b5de-b25f-4715-84f9-0eb683c4cb04"
    },
    {
      "id": "059ee5d0-28cc-4e19-bb59-86f7f5b169d6",
      "text": "Miệng người khôn thốt ra lời đáng mến ;",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:44:40.666Z",
      "updatedAt": "2025-09-03T02:44:40.666Z",
      "chapterId": "de97b5de-b25f-4715-84f9-0eb683c4cb04"
    },
    {
      "id": "ab3f4000-6ee7-4fe6-ac3b-9e678ee7080a",
      "text": "môi kẻ dại làm nó phải diệt vong,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:44:40.689Z",
      "updatedAt": "2025-09-03T02:44:40.689Z",
      "chapterId": "de97b5de-b25f-4715-84f9-0eb683c4cb04"
    },
    {
      "id": "8a9a0130-f0b2-450d-8876-e97fe9a05a81",
      "text": "nó mở đầu câu chuyện với những lời ngu xuẩn,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:44:40.714Z",
      "updatedAt": "2025-09-03T02:44:40.714Z",
      "chapterId": "de97b5de-b25f-4715-84f9-0eb683c4cb04"
    },
    {
      "id": "eab939d0-e0da-439d-8b6c-18eac0943470",
      "text": "và kết thúc bằng những lời gian ác ngông cuồng ;",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:44:40.742Z",
      "updatedAt": "2025-09-03T02:44:40.742Z",
      "chapterId": "de97b5de-b25f-4715-84f9-0eb683c4cb04"
    },
    {
      "id": "12385218-1dd5-427a-bd25-890a95d83d65",
      "text": "nó toàn nói chuyện huyên thuyên.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:44:40.755Z",
      "updatedAt": "2025-09-03T02:44:40.755Z",
      "chapterId": "de97b5de-b25f-4715-84f9-0eb683c4cb04"
    },
    {
      "id": "daf9e260-9ee1-4a44-908a-3eb22bf01774",
      "text": "Con người đâu biết được điều gì sẽ xảy đến,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:44:40.787Z",
      "updatedAt": "2025-09-03T02:44:40.787Z",
      "chapterId": "de97b5de-b25f-4715-84f9-0eb683c4cb04"
    },
    {
      "id": "33adf576-c860-421d-b5e2-ec68c420b382",
      "text": "và ai tỏ cho nó hay sẽ có chuyện gì sau khi nó chết ?",
      "label": "14",
      "number": 14,
      "subVerseIndex": 2,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:44:40.801Z",
      "updatedAt": "2025-09-03T02:44:40.801Z",
      "chapterId": "de97b5de-b25f-4715-84f9-0eb683c4cb04"
    },
    {
      "id": "aec3b899-c4cf-45e8-9dea-888f817f4b3a",
      "text": "Người ngu làm việc đầu tắt mặt tối,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:44:40.828Z",
      "updatedAt": "2025-09-03T02:44:40.828Z",
      "chapterId": "de97b5de-b25f-4715-84f9-0eb683c4cb04"
    },
    {
      "id": "ecd5fe26-0289-4e18-b782-b621fc7d0cef",
      "text": "đi lên thành phố, cũng chẳng biết đường.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:44:40.855Z",
      "updatedAt": "2025-09-03T02:44:40.855Z",
      "chapterId": "de97b5de-b25f-4715-84f9-0eb683c4cb04"
    },
    {
      "id": "c724efc4-2831-4da4-a699-ebcb783e1764",
      "text": "Khốn cho ngươi, hỡi đất nước",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:44:40.884Z",
      "updatedAt": "2025-09-03T02:44:40.884Z",
      "chapterId": "de97b5de-b25f-4715-84f9-0eb683c4cb04"
    },
    {
      "id": "dd8e45e6-e818-4b06-931b-56722a5b148a",
      "text": "có vua cai trị là một thằng nhãi con,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:44:40.899Z",
      "updatedAt": "2025-09-03T02:44:40.899Z",
      "chapterId": "de97b5de-b25f-4715-84f9-0eb683c4cb04"
    },
    {
      "id": "c735bfef-b134-40f6-a5ac-1a7ed33d3942",
      "text": "có người lãnh đạo là những đứa mới sáng ra đã lo chè chén.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 2,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:44:40.912Z",
      "updatedAt": "2025-09-03T02:44:40.912Z",
      "chapterId": "de97b5de-b25f-4715-84f9-0eb683c4cb04"
    },
    {
      "id": "8cba6837-90cc-4da1-b1d3-2acdbcdd1aae",
      "text": "Phúc cho ngươi, hỡi đất nước",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:44:40.926Z",
      "updatedAt": "2025-09-03T02:44:40.926Z",
      "chapterId": "de97b5de-b25f-4715-84f9-0eb683c4cb04"
    },
    {
      "id": "4f0df0f8-d8eb-41f2-ab71-1211af90ee6c",
      "text": "có vua cai trị là con nhà quyền quý,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:44:40.940Z",
      "updatedAt": "2025-09-03T02:44:40.940Z",
      "chapterId": "de97b5de-b25f-4715-84f9-0eb683c4cb04"
    },
    {
      "id": "f46cb5a2-37d1-4aef-91b0-9460b91a1b94",
      "text": "có người lãnh đạo là những kẻ ăn uống có giờ có giấc,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 2,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:44:40.954Z",
      "updatedAt": "2025-09-03T02:44:40.954Z",
      "chapterId": "de97b5de-b25f-4715-84f9-0eb683c4cb04"
    },
    {
      "id": "6138c279-2c17-4b32-8c0d-4ac05ba57c01",
      "text": "cốt sao cho khoẻ mạnh,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 3,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:44:40.982Z",
      "updatedAt": "2025-09-03T02:44:40.982Z",
      "chapterId": "de97b5de-b25f-4715-84f9-0eb683c4cb04"
    },
    {
      "id": "0f624c27-0766-4ca8-a898-d78cb014e8b0",
      "text": "chứ không nhằm chè chén say sưa.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 4,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:44:40.999Z",
      "updatedAt": "2025-09-03T02:44:40.999Z",
      "chapterId": "de97b5de-b25f-4715-84f9-0eb683c4cb04"
    },
    {
      "id": "4c0e3f35-8a2d-4ee0-96b2-90d8bf827973",
      "text": "Lười lĩnh biếng nhác thì cột xiêu,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:44:41.013Z",
      "updatedAt": "2025-09-03T02:44:41.013Z",
      "chapterId": "de97b5de-b25f-4715-84f9-0eb683c4cb04"
    },
    {
      "id": "f8c9dbcd-acda-4dc1-a39c-a9f264f5a69d",
      "text": "bàn tay uể oải thì nhà dột.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:44:41.041Z",
      "updatedAt": "2025-09-03T02:44:41.041Z",
      "chapterId": "de97b5de-b25f-4715-84f9-0eb683c4cb04"
    },
    {
      "id": "72bc7e46-fe3f-40b7-b23a-e69c0d7b0aeb",
      "text": "Muốn mua vui thì cứ tiệc tùng,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:44:41.054Z",
      "updatedAt": "2025-09-03T02:44:41.054Z",
      "chapterId": "de97b5de-b25f-4715-84f9-0eb683c4cb04"
    },
    {
      "id": "37211650-6e01-48c9-ada7-d4ef1d3384ed",
      "text": "rượu sẽ làm cho đời thêm vui tươi phấn khởi,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:44:41.068Z",
      "updatedAt": "2025-09-03T02:44:41.068Z",
