{
  "chapter": {
    "id": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5",
    "number": 1,
    "createdAt": "2025-09-03T01:07:51.705Z",
    "updatedAt": "2025-09-03T01:07:51.705Z",
    "bookId": "5c66a463-0bfa-46b7-9af1-3766a8779b73"
  },
  "verses": [
    {
      "id": "056844e9-8a64-405f-861f-bcf204d1892a",
      "text": "Tất cả sự khôn ngoan đều phát xuất từ Đức Chúa,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:31.642Z",
      "updatedAt": "2025-09-03T02:48:31.642Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "2bfbb771-dfde-4820-bfc6-f5449e5b4d3e",
      "text": "và khôn ngoan vẫn ở với Người đến muôn đời.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:31.715Z",
      "updatedAt": "2025-09-03T02:48:31.715Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "0e7f913f-5c84-452a-9df8-a4cdc6acaf5a",
      "text": "Cát biển, giọt mưa và tháng ngày của vĩnh cửu,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:31.741Z",
      "updatedAt": "2025-09-03T02:48:31.741Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "0103eb21-7f2b-4e34-a4f3-f608c673b902",
      "text": "ai đếm được cho hết ?",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:31.755Z",
      "updatedAt": "2025-09-03T02:48:31.755Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "3860d7a3-5728-4abc-ac3b-bba89ef41dc1",
      "text": "Trời cao, đất rộng, vực sâu và sự khôn ngoan, ai dò cho thấu ?",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:31.769Z",
      "updatedAt": "2025-09-03T02:48:31.769Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "49253d86-11a7-409e-b0dc-b9321b585b48",
      "text": "Khôn ngoan đã được tác thành trước vạn vật,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:31.783Z",
      "updatedAt": "2025-09-03T02:48:31.783Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "9d4ed62c-0fae-4d05-9f50-37aa6b2b30b3",
      "text": "sự hiểu biết anh minh đã có tự muôn đời.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:31.825Z",
      "updatedAt": "2025-09-03T02:48:31.825Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "c6bfef3a-a45b-424f-9e44-d9edd6a5e5c8",
      "text": "Gốc rễ của khôn ngoan đã được mặc khải cho ai ?",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:31.853Z",
      "updatedAt": "2025-09-03T02:48:31.853Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "2707852a-d830-46c6-aab9-f5d227ca6f3a",
      "text": "Và những công trình kỳ diệu của khôn ngoan, ai nào biết rõ ?",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:31.895Z",
      "updatedAt": "2025-09-03T02:48:31.895Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "61aaeeeb-7813-44bc-9392-da785291f22e",
      "text": "Chỉ có một Đấng khôn ngoan rất đáng sợ,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:31.922Z",
      "updatedAt": "2025-09-03T02:48:31.922Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "e83011f9-2017-411b-8a47-bfd010de56ea",
      "text": "ngự trên ngai của Người.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:31.936Z",
      "updatedAt": "2025-09-03T02:48:31.936Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "0aea50d8-0e72-4b9c-89a7-6c4f0c1ddc6c",
      "text": "Đó chính là Đức Chúa.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:31.950Z",
      "updatedAt": "2025-09-03T02:48:31.950Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "b660251c-a85b-43c6-b061-7e77b9df0462",
      "text": "Người đã tạo dựng, đã thấy, đã đếm",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:31.979Z",
      "updatedAt": "2025-09-03T02:48:31.979Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "db1b0b18-5e7f-4414-9e15-684eea60a86c",
      "text": "và làm cho khôn ngoan nổi bật",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.005Z",
      "updatedAt": "2025-09-03T02:48:32.005Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "bd7cf550-db32-4f4d-a469-396190869ec3",
      "text": "trên mọi công trình,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 3,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:48:32.023Z",
      "updatedAt": "2025-09-03T02:48:32.023Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "2c677aff-fc45-48d6-9afa-073314f39988",
      "text": "nơi mọi phàm nhân,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 1,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.036Z",
      "updatedAt": "2025-09-03T02:48:32.036Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "3329ee71-606b-40a1-b9b9-4226027922b7",
      "text": "theo lòng quảng đại của Người,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.061Z",
      "updatedAt": "2025-09-03T02:48:32.061Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "7f641e22-68b6-46df-a94c-e4604c2f4d17",
      "text": "và Người đã rộng ban khôn ngoan cho những ai yêu mến Người.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.073Z",
      "updatedAt": "2025-09-03T02:48:32.073Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "e0e1b74c-6787-48c7-b2d7-8f9630739ec8",
      "text": "Kính sợ Đức Chúa đem lại vinh quang và tự hào",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.085Z",
      "updatedAt": "2025-09-03T02:48:32.085Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "d04d2792-17c7-4408-a98e-31e54067bc31",
      "text": "hân hoan và phấn khởi.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.135Z",
      "updatedAt": "2025-09-03T02:48:32.135Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "0c15b8ca-c1c4-476d-a760-b168f6a88b27",
      "text": "Kính sợ Đức Chúa khiến tâm hồn sung sướng,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.148Z",
      "updatedAt": "2025-09-03T02:48:32.148Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "6df1d9b6-379f-463d-a5ff-1711dadc12ef",
      "text": "cho con người được hoan hỷ mừng vui",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.162Z",
      "updatedAt": "2025-09-03T02:48:32.162Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "4813dfb6-efbb-4da5-a798-aed463a74700",
      "text": "và an khang trường thọ.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.176Z",
      "updatedAt": "2025-09-03T02:48:32.176Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "aebbe4f0-4111-4b4b-a4fd-f0e205badb73",
      "text": "Ai kính sợ Đức Chúa sẽ thấy cuộc đời kết thúc tốt đẹp,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.203Z",
      "updatedAt": "2025-09-03T02:48:32.203Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "011cf813-742a-485a-b30e-01adb77e0191",
      "text": "ngày lâm chung họ sẽ được hưởng phúc lành.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.216Z",
      "updatedAt": "2025-09-03T02:48:32.216Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "b1c27221-ff7b-4a44-8953-930bff8f5328",
      "text": "Bước đầu của khôn ngoan là kính sợ Đức Chúa,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.243Z",
      "updatedAt": "2025-09-03T02:48:32.243Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "b8fd4545-9039-456b-80bc-d0cb31fff3f9",
      "text": "ngay từ lúc thành hình trong lòng mẹ,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.258Z",
      "updatedAt": "2025-09-03T02:48:32.258Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "784788fa-94d1-45e6-a4f9-6b504a71a3a0",
      "text": "các tín hữu đã được ơn khôn ngoan.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 2,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.271Z",
      "updatedAt": "2025-09-03T02:48:32.271Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "7d595b51-53b1-48bd-87a9-7d9c5f074f94",
      "text": "Giữa nhân gian, khôn ngoan xây tổ làm nền móng vĩnh cửu,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.285Z",
      "updatedAt": "2025-09-03T02:48:32.285Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "e4d67f84-6f26-4743-8c34-768c0dd199ac",
      "text": "và tin tưởng vào con cái loài người.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.299Z",
      "updatedAt": "2025-09-03T02:48:32.299Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "962f2dfa-8b67-4483-84cd-1856c56cec08",
      "text": "Sự viên mãn của khôn ngoan là kính sợ Đức Chúa.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.313Z",
      "updatedAt": "2025-09-03T02:48:32.313Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "e80febdf-4a94-4f1f-a7d7-56c1d3b3eafc",
      "text": "Khôn ngoan lấy hoa trái của mình làm cho họ say sưa,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.327Z",
      "updatedAt": "2025-09-03T02:48:32.327Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "561143f5-496f-449d-a519-0d52a40b3086",
      "text": "lấy bảo vật của mình chất đầy nhà cửa họ,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.355Z",
      "updatedAt": "2025-09-03T02:48:32.355Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "d8cfd1e6-96ec-42db-87ff-4330fd7318b1",
      "text": "đem sản phẩm của mình đổ đầy kho lẫm.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.368Z",
      "updatedAt": "2025-09-03T02:48:32.368Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "18995856-bf72-4827-afb4-930790533172",
      "text": "Lòng kính sợ Đức Chúa là tuyệt đỉnh của khôn ngoan,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.402Z",
      "updatedAt": "2025-09-03T02:48:32.402Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "605f5eea-1b0a-413b-98d1-6b9f2e70b951",
      "text": "mang lại bình an và sức khoẻ dồi dào.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.416Z",
      "updatedAt": "2025-09-03T02:48:32.416Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "f8399c36-2161-42c7-8084-eb67294b5349",
      "text": "Đức Chúa đã thấy và đã đếm khôn ngoan,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.430Z",
      "updatedAt": "2025-09-03T02:48:32.430Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "9fc19fd4-23c5-4e43-983c-34ec62daa656",
      "text": "Người đổ mưa am tường và hiểu biết của trí tuệ,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.457Z",
      "updatedAt": "2025-09-03T02:48:32.457Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "f7fe8833-5ff8-4767-978a-35101d425a68",
      "text": "nâng cao vinh dự của những kẻ gắn bó với khôn ngoan.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 2,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.471Z",
      "updatedAt": "2025-09-03T02:48:32.471Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "763a3641-f804-4e35-8ae7-70e9ca91cd16",
      "text": "Gốc rễ của khôn ngoan là kính sợ Đức Chúa,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.485Z",
      "updatedAt": "2025-09-03T02:48:32.485Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "1c73d078-9bcd-4482-9b38-4dd8a55cc629",
      "text": "cành lá của khôn ngoan là cuộc đời trường thọ.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.512Z",
      "updatedAt": "2025-09-03T02:48:32.512Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "f45fabb5-87d5-4f88-afc3-d995f1d46024",
      "text": "Giận dữ vô lý không thể coi là phải lẽ được,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.560Z",
      "updatedAt": "2025-09-03T02:48:32.560Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "7c364e95-08c5-483d-bc87-cf731d117db9",
      "text": "vì giận dữ kéo theo sự sụp đổ của con người.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.587Z",
      "updatedAt": "2025-09-03T02:48:32.587Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "958a3abc-aa01-4f34-af41-58c8964949b3",
      "text": "Ai kiên trì chịu đựng một thời gian,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.632Z",
      "updatedAt": "2025-09-03T02:48:32.632Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "01925b65-3bc4-4d26-bdb4-98cdd2dc19d2",
      "text": "thì cuối cùng niềm vui sẽ bừng lên cho người ấy.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.647Z",
      "updatedAt": "2025-09-03T02:48:32.647Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "11690828-59c9-4b73-9cb5-d0280cdee9b9",
      "text": "Ai làm thinh không nói một thời gian,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.661Z",
      "updatedAt": "2025-09-03T02:48:32.661Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "41488293-945d-44ba-b7c2-fc8721cefca6",
      "text": "thì thiên hạ sẽ mở miệng khen là sáng suốt.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.675Z",
      "updatedAt": "2025-09-03T02:48:32.675Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "e6ee6245-cfdc-48bb-b1d5-fdbd3f2917ad",
      "text": "Trong các kho tàng của khôn ngoan,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.690Z",
      "updatedAt": "2025-09-03T02:48:32.690Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "c82f9d29-d5a9-4e94-b837-5b0cc1bfecc3",
      "text": "có nhiều ẩn dụ thâm thuý,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.717Z",
      "updatedAt": "2025-09-03T02:48:32.717Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "f996f208-7210-4cb8-8b5e-f6dcd2cb4c72",
      "text": "nhưng đối với người tội lỗi,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 2,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.731Z",
      "updatedAt": "2025-09-03T02:48:32.731Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "8c0e4a9e-b31a-4e82-8dc9-8d2a26ebf78b",
      "text": "tôn thờ Thiên Chúa lại là điều ghê tởm.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 3,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.745Z",
      "updatedAt": "2025-09-03T02:48:32.745Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "0633d8ca-b63f-40dc-bfd2-ae4110d202e7",
      "text": "Nếu con mộ mến khôn ngoan,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.759Z",
      "updatedAt": "2025-09-03T02:48:32.759Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "a0c8374a-ee2e-4fb2-b617-6cfb80e4fe8f",
      "text": "thì hãy tuân giữ các điều răn,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.773Z",
      "updatedAt": "2025-09-03T02:48:32.773Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "6475faeb-5444-430e-8006-9c3db345257f",
      "text": "và Đức Chúa sẽ ban cho con ơn ấy.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 2,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.805Z",
      "updatedAt": "2025-09-03T02:48:32.805Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "2e4de7c8-4eaa-42d2-b3ae-d4b33852f73d",
      "text": "Vì lòng kính sợ Đức Chúa là trường dạy khôn ngoan,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.819Z",
      "updatedAt": "2025-09-03T02:48:32.819Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "b5bfeb6e-557d-4939-9910-2f3db8d320fe",
      "text": "và điều Người ưa thích là tín thành và nhân hậu.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.848Z",
      "updatedAt": "2025-09-03T02:48:32.848Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "eea18906-7b2b-4175-98a7-6d5b1e9eb53b",
      "text": "Đừng ngang bướng không kính sợ Đức Chúa,",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.862Z",
      "updatedAt": "2025-09-03T02:48:32.862Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "b7e36895-ee81-4692-8f10-92ea088a6e73",
      "text": "cũng đừng đem lòng chim dạ cá mà đến với Người.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 1,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.876Z",
      "updatedAt": "2025-09-03T02:48:32.876Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "a48a410d-0477-4607-8ff5-305ef50f33ba",
      "text": "Đừng giả hình trước mặt người ta",
      "label": "29",
      "number": 29,
      "subVerseIndex": 0,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.903Z",
      "updatedAt": "2025-09-03T02:48:32.903Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "a6b43292-ca88-47c7-82c6-114e76949904",
      "text": "và hãy giữ gìn trong lời ăn tiếng nói.",
      "label": "29",
      "number": 29,
      "subVerseIndex": 1,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.932Z",
      "updatedAt": "2025-09-03T02:48:32.932Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "3be3c0ad-9f0a-4320-b12f-a60d365d1771",
      "text": "Đừng tự cao tự đại, kẻo ngã",
      "label": "30",
      "number": 30,
      "subVerseIndex": 0,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.947Z",
      "updatedAt": "2025-09-03T02:48:32.947Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "432c1e9b-7226-4e18-ab78-c74962b67df1",
      "text": "mà chuốc lấy tủi hổ vào thân.",
      "label": "30",
      "number": 30,
      "subVerseIndex": 1,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.961Z",
      "updatedAt": "2025-09-03T02:48:32.961Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "50b06c46-9a19-476a-a89c-c59e05a9c30a",
      "text": "Đức Chúa sẽ phơi bày những bí ẩn của con,",
      "label": "30",
      "number": 30,
      "subVerseIndex": 2,
      "paragraphNumber": 61,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.975Z",
      "updatedAt": "2025-09-03T02:48:32.975Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "646995df-388c-4c54-8669-3c6defe52271",
      "text": "và hạ bệ con giữa nơi công hội,",
      "label": "30",
      "number": 30,
      "subVerseIndex": 3,
      "paragraphNumber": 62,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:32.990Z",
      "updatedAt": "2025-09-03T02:48:32.990Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "21066e3b-98a2-4ee4-9c00-bea74bde4856",
      "text": "vì con không bước đi trên đường kính sợ Đức Chúa,",
      "label": "30",
      "number": 30,
      "subVerseIndex": 4,
      "paragraphNumber": 63,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:33.016Z",
      "updatedAt": "2025-09-03T02:48:33.016Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "328d35b0-542d-43d7-83f7-74ebb3ac5868",
      "text": "và lòng con đầy những mưu gian.",
      "label": "30",
      "number": 30,
      "subVerseIndex": 5,
      "paragraphNumber": 64,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:33.028Z",
      "updatedAt": "2025-09-03T02:48:33.028Z",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    }
  ],
  "marks": [
    {
      "id": "4107d6aa-4868-4314-86f5-1aa658d44c66",
      "content": "Chương này trình bày cũng những đề tài ở đầu sách Châm ngôn với một số những khác biệt.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
