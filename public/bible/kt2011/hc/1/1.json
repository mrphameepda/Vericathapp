      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "19373635-a60c-4ad4-be18-9c7968f063c7",
      "content": "Cn 2,6",
      "kind": "MARK_KIND_REFERENCE",
      "label": "1@",
      "sortOrder": 0,
      "startOffset": 10,
      "endOffset": 10,
      "createdAt": "2025-09-03T02:48:31.704Z",
      "updatedAt": "2025-09-03T02:48:31.704Z",
      "targetId": "056844e9-8a64-405f-861f-bcf204d1892a",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "914e96c5-a15e-485e-ae8e-a81ae6c6b198",
      "content": "Tên “Gia-vê” trong LXX thường được dịch bằng “Chúa” (Kurios trong Hy-lạp). Dịch giả Hc rất hay dịch như thế. Hoạ hiếm lắm ông mới sử dụng từ “Thiên Chúa”.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 46,
      "endOffset": 46,
      "createdAt": "2025-09-03T02:48:31.693Z",
      "updatedAt": "2025-09-03T02:48:31.693Z",
      "targetId": "056844e9-8a64-405f-861f-bcf204d1892a",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "86c3f7bb-d868-4972-9779-52353ceee653",
      "content": "Kn 9,4",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 18,
      "endOffset": 18,
      "createdAt": "2025-09-03T02:48:31.727Z",
      "updatedAt": "2025-09-03T02:48:31.727Z",
      "targetId": "2bfbb771-dfde-4820-bfc6-f5449e5b4d3e",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "ab821c10-f1f8-4ab8-b473-94909f56ee1a",
      "content": "Khôn ngoan có trước vạn vật là một đề tài thường thấy trong các sách Giáo Huấn : G 28,12-23 ; Cn 8,22-31 ; Br 3,20-32.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 42,
      "endOffset": 42,
      "createdAt": "2025-09-03T02:48:31.797Z",
      "updatedAt": "2025-09-03T02:48:31.797Z",
      "targetId": "49253d86-11a7-409e-b0dc-b9321b585b48",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "c688ddcc-96f1-457e-97ec-52d6d44745a0",
      "content": "Hc 24,8.9",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 19,
      "endOffset": 19,
      "createdAt": "2025-09-03T02:48:31.811Z",
      "updatedAt": "2025-09-03T02:48:31.811Z",
      "targetId": "49253d86-11a7-409e-b0dc-b9321b585b48",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7e4697d4-678d-4eea-8b1c-853ab9eb46b5"
    },
    {
      "id": "32c9010d-6bd2-4f5e-a6a1-c12b72faf3e3",
      "content": "Việc ghi số câu đã được thực hiện theo một bản văn La-tinh dài hơn bản văn Hy-lạp. Do đó bản dịch của chúng tôi cũng thiếu những câu đã được thêm vào đó, cho dù những câu ấy có trong một số thủ bản Hy-lạp, gọi là Hy-lạp 248. Chúng tôi để những câu thêm này ở phần chú thích. C.5 : “Nguồn mạch khôn ngoan là lời Thiên Chúa trên cõi trời. Đường đi nước bước của khôn ngoan là các luật lệ muôn đời.”",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:48:31.839Z",
