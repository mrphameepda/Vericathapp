    },
    {
      "id": "933e744a-7ec4-4e9e-9a1f-f025ff9232cf",
      "content": "Cn 29,22",
      "kind": "MARK_KIND_REFERENCE",
      "label": "13@",
      "sortOrder": 12,
      "startOffset": 3,
