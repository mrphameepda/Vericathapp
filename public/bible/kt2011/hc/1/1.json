    },
    {
      "id": "e672c819-4202-4d2c-b3e8-f2bc8e8bda04",
      "content": "Người ta vẫn nói : cả giận mất khôn.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "12",
      "sortOrder": 11,
      "startOffset": 43,
