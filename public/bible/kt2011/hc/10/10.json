    },
    {
      "id": "decfc6a3-f841-4c17-8d71-21990e725784",
      "content": "Dịch phòng theo Hy-lạp. HR không có nghĩa gì vì bị hư truyền. Trong văn mạch, đại ý câu này cũng như nói : con người xác đất vật hèn.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 38,
      "endOffset": 38,
      "createdAt": "2025-09-03T02:49:33.539Z",
      "updatedAt": "2025-09-03T02:49:33.539Z",
      "targetId": "50b1e0e4-58ea-4e2d-964b-3c6d9b8684c6",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "6df5e9fd-9bba-4037-ac1b-321f51f51b06",
      "content": "Is 11,2-5; Rm 13,1",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:49:33.345Z",
      "updatedAt": "2025-09-03T02:49:33.345Z",
      "targetId": "03846187-fdf3-4bbd-9985-6f323ceb9cb3",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "230238f4-ba63-4387-916e-9462d95ebe79",
      "content": "“Tiền mất tật mang.” Con người sống là phải chết, nên tìm thầy chạy thuốc mấy cũng vô ích. X. HR : *Thầy lang buồn vì cơn bệnh ngắn ngủi.* Theo đó thì bệnh nhân chết, hay là khỏi bệnh ? Nghĩa không rõ. X. Hc 38 về thái độ đối với thầy thuốc.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 45,
      "endOffset": 45,
      "createdAt": "2025-09-03T02:49:33.581Z",
      "updatedAt": "2025-09-03T02:49:33.581Z",
      "targetId": "61a2e217-7180-43c3-9a19-321198295878",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "092d4511-44cc-4380-af62-8e84b926bc44",
      "content": "Lv 19,18; Mt 5,21-24; 18,21-22",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 9,
      "endOffset": 9,
      "createdAt": "2025-09-03T02:49:33.413Z",
      "updatedAt": "2025-09-03T02:49:33.413Z",
      "targetId": "4530abdc-3b70-4c5e-9f62-e1fbaf0d7988",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "f12c3673-c9e1-4171-888c-2da0a1da83e5",
      "content": "Hẳn là tác giả nghĩ tới những cuộc trừng phạt điển hình trong lịch sử thánh, như trong vụ tháp Ba-ben (St 11,1-9), các tai ương Ai-cập (Xh 7-11), quân Át-sua tan rã (2 V 19,35), Ni-ni-vê bị tàn phá (năm 612 tCN) và Ba-by-lon sụp đổ (năm 539 tCN), v.v...",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 43,
      "endOffset": 43,
      "createdAt": "2025-09-03T02:49:33.729Z",
      "updatedAt": "2025-09-03T02:49:33.729Z",
      "targetId": "b69c9a6d-15e1-427c-b457-cf83af8be1a0",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "6ead1494-5808-43c8-b052-072f3d14f3ed",
      "content": "Hc 17,32; St 2,7; 18,27",
      "kind": "MARK_KIND_REFERENCE",
      "label": "4@",
      "sortOrder": 3,
      "startOffset": 8,
      "endOffset": 8,
      "createdAt": "2025-09-03T02:49:33.511Z",
