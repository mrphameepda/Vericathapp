    {
      "id": "f751cdf4-1683-4ebd-934f-b657783fa097",
      "content": "Có những thủ bản Hy-lạp thêm : *Kính sợ Đức Chúa là bắt đầu được (Người) chấp nhận, còn bắt đầu bị (Người) ruồng bỏ là sự cứng lòng và kiêu ngạo*.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "5",
      "sortOrder": 4,
      "startOffset": 30,
      "endOffset": 30,
      "createdAt": "2025-09-03T02:49:34.116Z",
