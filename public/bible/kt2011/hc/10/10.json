{
  "chapter": {
    "id": "479e914b-57f2-4cf3-8be6-1a310f50a1f2",
    "number": 10,
    "createdAt": "2025-09-03T01:07:51.705Z",
    "updatedAt": "2025-09-03T01:07:51.705Z",
    "bookId": "5c66a463-0bfa-46b7-9af1-3766a8779b73"
  },
  "verses": [
    {
      "id": "48df8e57-86b3-4d22-aa0a-02c07f10fa03",
      "text": "Thủ lãnh khôn ngoan thì giáo dục dân mình,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.158Z",
      "updatedAt": "2025-09-03T02:49:33.158Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "58161d3d-3708-43c2-a6ec-7025407c0c6a",
      "text": "và uy thế của người thông minh thật là vững chắc.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.186Z",
      "updatedAt": "2025-09-03T02:49:33.186Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "7b4e3b0c-f15d-4662-9f64-961837177cb9",
      "text": "Thủ lãnh dân thế nào,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.197Z",
      "updatedAt": "2025-09-03T02:49:33.197Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "442bf912-59f5-4857-b5de-d73c6223668e",
      "text": "các viên chức thừa hành cũng thế,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.208Z",
      "updatedAt": "2025-09-03T02:49:33.208Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "f9b9f032-6e08-4e78-ac7d-4e5d81e9e4d1",
      "text": "người đứng đầu một thành làm sao,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.219Z",
      "updatedAt": "2025-09-03T02:49:33.219Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "d175186d-ce07-4fed-aba9-5a06770dd805",
      "text": "toàn thể dân cư cũng vậy.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 3,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.232Z",
      "updatedAt": "2025-09-03T02:49:33.232Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "35932237-608d-45ea-9e8e-d4c31a4868a2",
      "text": "Một ông vua dốt nát làm cho dân nước phải suy vong,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.247Z",
      "updatedAt": "2025-09-03T02:49:33.247Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "16bcb1d7-293b-49b5-8a91-54e61d41ea92",
      "text": "một thành hưng thịnh",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.261Z",
      "updatedAt": "2025-09-03T02:49:33.261Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "b4ab6ba1-b220-47a2-879f-37c87d05fda7",
      "text": "là nhờ trí thông minh của các nhà cầm quyền.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.274Z",
      "updatedAt": "2025-09-03T02:49:33.274Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "fd162a68-de18-4014-b982-78a4d029ba34",
      "text": "Quyền bính trên địa cầu nằm trong tay Đức Chúa,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.288Z",
      "updatedAt": "2025-09-03T02:49:33.288Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "faa663dd-f127-4fca-8c7b-039681fe8154",
      "text": "khi đến thời đến buổi, Người sẽ cho xuất hiện kẻ hiền tài.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.317Z",
      "updatedAt": "2025-09-03T02:49:33.317Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "03846187-fdf3-4bbd-9985-6f323ceb9cb3",
      "text": "Sự nghiệp của con người nằm trong tay Đức Chúa,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.331Z",
      "updatedAt": "2025-09-03T02:49:33.331Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "a6155f5b-8a16-47f8-bc10-1fb6f12e07f4",
      "text": "vì chính Người làm cho kẻ sĩ được nở mặt nở mày.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.358Z",
      "updatedAt": "2025-09-03T02:49:33.358Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "231387b1-b71a-4bfe-9b39-30b3f6f78427",
      "text": "Khi gặp những chuyện bất công,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.372Z",
      "updatedAt": "2025-09-03T02:49:33.372Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "4530abdc-3b70-4c5e-9f62-e1fbaf0d7988",
      "text": "con đừng oán hờn người thân cận,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.398Z",
      "updatedAt": "2025-09-03T02:49:33.398Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "d9d8f205-d30e-4d13-8cc0-dcb383637dd7",
      "text": "cũng đừng làm bất cứ điều gì trong cơn giận dữ.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.427Z",
      "updatedAt": "2025-09-03T02:49:33.427Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "3ab9d202-556e-48bc-a789-c43109ae3d97",
      "text": "Đức Chúa và người phàm đều chê ghét tính kiêu căng,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.441Z",
      "updatedAt": "2025-09-03T02:49:33.441Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "8b3a55dc-5439-4196-82be-3fcf7e7c0806",
      "text": "đều coi gian tà là khả ố.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.455Z",
      "updatedAt": "2025-09-03T02:49:33.455Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "e2e515a4-6efe-46f8-af4e-6db2cfe64430",
      "text": "Quyền bá chủ chuyển từ dân này sang dân nọ,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.469Z",
      "updatedAt": "2025-09-03T02:49:33.469Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "557ccc04-fe1d-48cf-b846-786a6d1e8632",
      "text": "do bất công, bạo lực và tiền tài.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.483Z",
      "updatedAt": "2025-09-03T02:49:33.483Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "36b8965c-533e-4c08-89ff-62c468d29e77",
      "text": "Làm sao tro bụi lại dám kiêu căng,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.497Z",
      "updatedAt": "2025-09-03T02:49:33.497Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "50b1e0e4-58ea-4e2d-964b-3c6d9b8684c6",
      "text": "vì ngay khi còn sống, nó đã bị xổ ruột ?",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.524Z",
      "updatedAt": "2025-09-03T02:49:33.524Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "1797dc32-bc4a-41a1-8137-79902954af0d",
      "text": "Cơn bệnh kéo dài, giễu cợt cả thầy thuốc,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.553Z",
      "updatedAt": "2025-09-03T02:49:33.553Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "61a2e217-7180-43c3-9a19-321198295878",
      "text": "kẻ nay xưng hùng xưng bá, mai đã theo tử thần.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.567Z",
      "updatedAt": "2025-09-03T02:49:33.567Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "cb082b9e-a004-4ad5-a61b-b59fffba2b3b",
      "text": "Khi chết, gia tài người ta thừa hưởng",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.595Z",
      "updatedAt": "2025-09-03T02:49:33.595Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "cb0c2f21-e1a0-4c91-9735-5fa3ce81e4a2",
      "text": "là côn trùng, sâu bọ và rắn rết.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.609Z",
      "updatedAt": "2025-09-03T02:49:33.609Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "61c78f31-58eb-445d-b527-97bbe9017580",
      "text": "Con người bắt đầu kiêu căng khi lìa xa Đức Chúa,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.639Z",
      "updatedAt": "2025-09-03T02:49:33.639Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "885b1c46-a792-4893-8e2b-c01d439b7b7b",
      "text": "khi lòng nó lìa xa Đấng Tạo Thành.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.667Z",
      "updatedAt": "2025-09-03T02:49:33.667Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "86d77334-9290-468b-a5aa-a4c0f1aef677",
      "text": "Vì đầu mối của kiêu căng là tội lỗi,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.686Z",
      "updatedAt": "2025-09-03T02:49:33.686Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "b89770b0-034d-4fe5-8460-c7635c1a40c8",
      "text": "và kẻ quen thói kiêu căng thì rắc gieo ghê tởm ;",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.702Z",
      "updatedAt": "2025-09-03T02:49:33.702Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "b69c9a6d-15e1-427c-b457-cf83af8be1a0",
      "text": "vì thế Đức Chúa đã gửi đến những gian truân,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.719Z",
      "updatedAt": "2025-09-03T02:49:33.719Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "f5ec5723-91f0-48a0-88ab-e2b15bbddf0d",
      "text": "và tiêu diệt chúng hoàn toàn.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 3,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.740Z",
      "updatedAt": "2025-09-03T02:49:33.740Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "87ca8c82-094b-4966-b023-37f04640559d",
      "text": "Đức Chúa hạ bệ những ai quyền thế,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.750Z",
      "updatedAt": "2025-09-03T02:49:33.750Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "24f5a110-83ad-4cb1-946b-b8904d0566fa",
      "text": "và đặt kẻ hiền lành ngồi lên thay.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.772Z",
      "updatedAt": "2025-09-03T02:49:33.772Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "0a8d1a7f-89d9-4f08-84d9-422e0d44de64",
      "text": "Đức Chúa đã bứng rễ các dân ngoại,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.783Z",
      "updatedAt": "2025-09-03T02:49:33.783Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "5ee9c414-9611-46d9-b206-cffcffd0a7c1",
      "text": "và đem trồng vào đó kẻ khiêm nhường.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.808Z",
      "updatedAt": "2025-09-03T02:49:33.808Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "bb7b7cf6-c280-4726-b322-6e049dabd6f2",
      "text": "Lãnh thổ của chư dân, Đức Chúa đã đảo lộn,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.836Z",
      "updatedAt": "2025-09-03T02:49:33.836Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "e87c37a7-f361-4b1a-920c-df477345fa4c",
      "text": "và phá huỷ đến tận nền trái đất.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.865Z",
      "updatedAt": "2025-09-03T02:49:33.865Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "e440445f-0fd8-4a03-9fc3-e68743c78ea7",
      "text": "Người đã loại chúng ra khỏi cõi đời và huỷ diệt chúng,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.878Z",
      "updatedAt": "2025-09-03T02:49:33.878Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "545d1975-53a4-4462-8d12-179f96356997",
      "text": "đã xoá sạch chúng khỏi ký ức người đời.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.892Z",
      "updatedAt": "2025-09-03T02:49:33.892Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "286c44be-3c84-4216-baf0-d2b9aec66b6d",
      "text": "Con người được dựng nên không phải để kiêu ngạo,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.906Z",
      "updatedAt": "2025-09-03T02:49:33.906Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "dc521c35-f199-465f-8818-63cc88855b98",
      "text": "con cái của đàn bà được sinh ra không phải để giận dữ.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.920Z",
      "updatedAt": "2025-09-03T02:49:33.920Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "01a77a54-b86b-493e-93f7-4a9cc2dcdff3",
      "text": "Nòi giống nào đáng trọng ?",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.934Z",
      "updatedAt": "2025-09-03T02:49:33.934Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "95c61a64-4358-4c34-9dd5-90fc1f876520",
      "text": "Thưa nòi giống con người.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.976Z",
      "updatedAt": "2025-09-03T02:49:33.976Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "84fd07e7-d03f-4254-b94f-2fd6458dcae4",
      "text": "Nòi giống nào đáng trọng ?",
      "label": "19",
      "number": 19,
      "subVerseIndex": 2,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:33.990Z",
      "updatedAt": "2025-09-03T02:49:33.990Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "c2ea6867-47bc-4efb-ba7e-5afc82e9db28",
      "text": "Thưa những người kính sợ Đức Chúa.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 3,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:34.003Z",
      "updatedAt": "2025-09-03T02:49:34.003Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "ff143828-1427-4d79-b660-d7d44fbc0cfb",
      "text": "Nòi giống nào đáng khinh ?",
      "label": "19",
      "number": 19,
      "subVerseIndex": 4,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:34.018Z",
      "updatedAt": "2025-09-03T02:49:34.018Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "09c26b35-f4f4-4e5e-9b91-21218099cbce",
      "text": "Thưa nòi giống con người.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 5,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:34.031Z",
      "updatedAt": "2025-09-03T02:49:34.031Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "e6ac82bb-365b-4ea6-8dfb-518628bc3933",
      "text": "Nòi giống nào đáng khinh ?",
      "label": "19",
      "number": 19,
      "subVerseIndex": 6,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:34.045Z",
      "updatedAt": "2025-09-03T02:49:34.045Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "f65b8bf7-377b-40e4-b36f-a7226c6d3078",
      "text": "Thưa những kẻ vi phạm các điều răn.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 7,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:34.059Z",
      "updatedAt": "2025-09-03T02:49:34.059Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "a5ce65f3-b48d-4452-8412-0750977dd87b",
      "text": "Thủ lãnh thì đáng trọng giữa anh em,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:34.073Z",
      "updatedAt": "2025-09-03T02:49:34.073Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "95a1faa6-6df1-45f9-a635-7278ad90dc97",
      "text": "còn những ai kính sợ Đức Chúa",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:34.090Z",
      "updatedAt": "2025-09-03T02:49:34.090Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "df910d07-014b-471a-a554-7e9d54fbab03",
      "text": "thì đáng trọng trước mặt Người.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 2,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:34.103Z",
      "updatedAt": "2025-09-03T02:49:34.103Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "e4d4e459-585b-4695-96ae-43e857505c57",
      "text": "Kẻ giàu, người sang cũng như kẻ nghèo :",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:34.129Z",
      "updatedAt": "2025-09-03T02:49:34.129Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "a6a4153a-aaee-49dc-a30a-cffe4cdb7a05",
      "text": "niềm hãnh diện của tất cả là kính sợ Đức Chúa.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:34.141Z",
      "updatedAt": "2025-09-03T02:49:34.141Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "ef34fc5d-411d-427e-ae78-f1fa0fcf3ffc",
      "text": "Khinh dể một người nghèo thông minh là không phải lẽ,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:34.166Z",
      "updatedAt": "2025-09-03T02:49:34.166Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "277428d0-ce49-4238-9a43-e73e82a04cce",
      "text": "tôn vinh một người tội lỗi là điều chẳng nên.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:34.178Z",
      "updatedAt": "2025-09-03T02:49:34.178Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "0445e558-c2b4-482a-b7bd-20cf1e4cebb5",
      "text": "Người làm lớn, nhà lãnh đạo, vị nắm quyền đều được tôn vinh,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:34.191Z",
      "updatedAt": "2025-09-03T02:49:34.191Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "fa2d71af-dede-4d85-8061-4fdd6f7dcd08",
      "text": "nhưng không ai trong các vị đó lớn hơn người kính sợ Đức Chúa.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:34.203Z",
      "updatedAt": "2025-09-03T02:49:34.203Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "e17bd486-4568-4db0-85c9-babc90bb28c0",
      "text": "Nô bộc mà khôn ngoan thì được cả người tự do (cũng) phục vụ,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:34.216Z",
      "updatedAt": "2025-09-03T02:49:34.216Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "163dbf98-5ebb-4f60-a25e-8955cfb4bee5",
      "text": "người hiểu biết thì không lẩm bẩm kêu ca.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:34.258Z",
      "updatedAt": "2025-09-03T02:49:34.258Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "3893a524-97a5-432f-97d1-d96f547596c1",
      "text": "Đừng khôn xảo, khi làm công việc của con,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 61,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:34.285Z",
      "updatedAt": "2025-09-03T02:49:34.285Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "44c10b32-3286-405b-a324-268bbd635a78",
      "text": "cũng đừng sĩ diện, khi con phải nghèo túng.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 62,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:34.327Z",
      "updatedAt": "2025-09-03T02:49:34.327Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "dd0e83f1-39db-4947-b837-02dd22b0029c",
      "text": "Làm việc và được đầy đủ dư dật,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 63,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:34.341Z",
      "updatedAt": "2025-09-03T02:49:34.341Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "8291dc7e-2cea-4c49-a5ca-396f21344d48",
      "text": "thì vẫn hơn lang thang khoác lác mà đói ăn.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 64,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:34.354Z",
      "updatedAt": "2025-09-03T02:49:34.354Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "11afaf4a-ff96-46cd-a065-0bfe959efcf0",
      "text": "Con ơi, hãy tự hào một cách khiêm tốn,",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 65,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:34.382Z",
      "updatedAt": "2025-09-03T02:49:34.382Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "a2b3a8c9-e4e6-4f17-89ed-5f0afc6f6645",
      "text": "và tự trọng đúng với giá trị của con.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 1,
      "paragraphNumber": 66,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:34.411Z",
      "updatedAt": "2025-09-03T02:49:34.411Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "f4f2e90b-6c24-4631-823c-e8765be42f85",
      "text": "Người phạm tội hại đến bản thân,",
      "label": "29",
      "number": 29,
      "subVerseIndex": 0,
      "paragraphNumber": 67,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:34.425Z",
      "updatedAt": "2025-09-03T02:49:34.425Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "1e478308-9a3c-41a6-a898-7bc91e569769",
      "text": "ai bảo nó là công chính được ?",
      "label": "29",
      "number": 29,
      "subVerseIndex": 1,
      "paragraphNumber": 68,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:34.439Z",
      "updatedAt": "2025-09-03T02:49:34.439Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "075f187b-2d38-4214-8e5d-b7008c6b9e3a",
      "text": "Nào ai tôn trọng được kẻ khinh chính mình ?",
      "label": "29",
      "number": 29,
      "subVerseIndex": 2,
      "paragraphNumber": 69,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:34.454Z",
      "updatedAt": "2025-09-03T02:49:34.454Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "cc8cdef0-a8ed-421b-a4d9-a2dd7f8e6752",
      "text": "Kẻ nghèo được tôn trọng là nhờ sự hiểu biết,",
      "label": "30",
      "number": 30,
      "subVerseIndex": 0,
      "paragraphNumber": 70,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:34.468Z",
      "updatedAt": "2025-09-03T02:49:34.468Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "df065924-b66b-418d-9af4-fc95691a58d3",
      "text": "người giàu được tôn trọng là vì tài sản của họ.",
      "label": "30",
      "number": 30,
      "subVerseIndex": 1,
      "paragraphNumber": 71,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:34.496Z",
      "updatedAt": "2025-09-03T02:49:34.496Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "cc3ba5db-5850-406a-8788-c726aa6fde77",
      "text": "Còn nghèo mà đã được trọng,",
      "label": "31",
      "number": 31,
      "subVerseIndex": 0,
      "paragraphNumber": 72,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:34.510Z",
      "updatedAt": "2025-09-03T02:49:34.510Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "dbd4adea-9a33-4f03-a19e-a8d42f61ba6e",
      "text": "thì khi giàu sẽ được trọng biết bao ?",
      "label": "31",
      "number": 31,
      "subVerseIndex": 1,
      "paragraphNumber": 73,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:34.524Z",
      "updatedAt": "2025-09-03T02:49:34.524Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "89d908f5-cc40-4af8-8d1b-da6bc8976c7b",
      "text": "Đang giàu mà đã bị khinh,",
      "label": "31",
      "number": 31,
      "subVerseIndex": 2,
      "paragraphNumber": 74,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:34.538Z",
      "updatedAt": "2025-09-03T02:49:34.538Z",
      "chapterId": "479e914b-57f2-4cf3-8be6-1a310f50a1f2"
    },
    {
      "id": "65defd97-24d4-4555-bc9b-50b69c7e0189",
      "text": "thì khi nghèo còn bị khinh biết mấy ?",
      "label": "31",
      "number": 31,
      "subVerseIndex": 3,
      "paragraphNumber": 75,
