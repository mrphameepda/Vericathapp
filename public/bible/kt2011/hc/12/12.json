      "updatedAt": "2025-09-03T02:49:46.273Z",
      "targetId": "bb5b34b0-d4f0-4fec-a99b-b4da4af20d46",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "fa74721a-98f0-4032-8598-b50322537f52",
      "content": "Mt 5,45; Lc 6,35",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 23,
      "endOffset": 23,
      "createdAt": "2025-09-03T02:49:46.512Z",
      "updatedAt": "2025-09-03T02:49:46.512Z",
      "targetId": "acf4b63e-1f6a-42ad-928a-63ddf2ce3c28",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "0b7a4350-b92c-4491-bb39-29f90fa46536",
      "content": "HR : *Làm việc thiện cho kẻ dữ thì chẳng lợi lộc gì ; đó cũng chẳng phải là một việc thiện nữa*.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 36,
      "endOffset": 36,
      "createdAt": "2025-09-03T02:49:46.330Z",
      "updatedAt": "2025-09-03T02:49:46.330Z",
      "targetId": "c75bb1a6-262e-4a23-86b1-2767bd618d03",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "f8587cf9-0ed6-4625-b0de-abb81e26a941",
      "content": "Hc 6,5-17",
      "kind": "MARK_KIND_REFERENCE",
      "label": "4@",
      "sortOrder": 3,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:49:46.567Z",
      "updatedAt": "2025-09-03T02:49:46.567Z",
      "targetId": "93e277f5-2ffb-4e19-a409-ae39c1d41ef8",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "2cd228a5-78ca-40d4-b96e-ef4cacea05f3",
      "content": "LT thêm : “Vì kẻ gian ác và người tội lỗi, Thiên Chúa sẽ giáng phạt, chờ ngày giáng phạt chúng. 5 Hãy cho người tốt, và đừng tiếp đón kẻ tội lỗi.” Nhưng, đối lại, hãy xem Mt 5,43-48 ; Lc 6,27-36 ; Rm 12,20. Thánh Âu-tinh giải thích : “Hãy cho người tội lỗi, không phải vì họ tội lỗi, nhưng vì họ là người.”",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "5",
      "sortOrder": 4,
      "startOffset": 50,
      "endOffset": 50,
      "createdAt": "2025-09-03T02:49:46.358Z",
      "updatedAt": "2025-09-03T02:49:46.358Z",
      "targetId": "1a8a6117-6861-4b66-b831-17ba94c5a0d4",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "b3dd0cae-f9e4-4a45-8325-2a5febdc216a",
      "content": "Cn 17,17; 19,4",
      "kind": "MARK_KIND_REFERENCE",
      "label": "5@",
      "sortOrder": 4,
      "startOffset": 38,
      "endOffset": 38,
      "createdAt": "2025-09-03T02:49:46.581Z",
      "updatedAt": "2025-09-03T02:49:46.581Z",
      "targetId": "16c2e68f-825c-4898-81c8-f962e6621448",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "e7ed39b8-7c65-4359-969f-c1a698347eb9",
      "content": "English: Most High | French: Très-Haut | Latin: Altissimus | Origin: &#1506;&#1462;&#1500;&#1456;&#1497;&#64331;&#1503; -- &#933;&#968;&#953;&#963;&#964;&#959;&#962; | Vietnamese: Đấng Tối Cao -- được dùng như tên riêng của Thiên Chúa thật, -- Is 14,14 ; Tv 91,1.9 ; Lc 1,32",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "6",
      "sortOrder": 5,
      "startOffset": 21,
      "endOffset": 21,
      "createdAt": "2025-09-03T02:49:46.470Z",
      "updatedAt": "2025-09-03T02:49:46.470Z",
      "targetId": "b9d5881b-8cbd-4bec-a5d0-a37365967d0d",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "7d6ebcc2-929f-47cd-aca6-78e5eb8a714b",
      "content": "Cn 26,24-26",
      "kind": "MARK_KIND_REFERENCE",
      "label": "6@",
      "sortOrder": 5,
      "startOffset": 21,
      "endOffset": 21,
      "createdAt": "2025-09-03T02:49:46.664Z",
      "updatedAt": "2025-09-03T02:49:46.664Z",
      "targetId": "70421331-d394-45ad-8da4-b3097cf2449b",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "e063f38c-dc88-437c-b8df-1d1c1f092971",
      "content": "Một số thủ bản thêm : “Người canh chừng chúng cho tới ngày chúng bị trừng phạt.” Tuy nhiên, xem lời Chúa Giê-su nói khác, ở Mt 5,4.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "7",
      "sortOrder": 6,
      "startOffset": 42,
      "endOffset": 42,
      "createdAt": "2025-09-03T02:49:46.498Z",
      "updatedAt": "2025-09-03T02:49:46.498Z",
      "targetId": "acf4b63e-1f6a-42ad-928a-63ddf2ce3c28",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "46e56a26-f703-4009-8093-50b5b7ff96e3",
      "content": "Cn 26,24-26; Gr 9,7",
      "kind": "MARK_KIND_REFERENCE",
      "label": "7@",
      "sortOrder": 6,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:49:46.978Z",
      "updatedAt": "2025-09-03T02:49:46.978Z",
      "targetId": "6f4768f6-8588-498d-bb1a-44c389ef9a8f",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "d25ac5f7-7395-47a5-98ba-1c222854099a",
      "content": "HR : *Kẻ ghét nó cũng là bạn của nó*.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "8",
      "sortOrder": 7,
      "startOffset": 44,
      "endOffset": 44,
      "createdAt": "2025-09-03T02:49:46.623Z",
      "updatedAt": "2025-09-03T02:49:46.623Z",
      "targetId": "b4448ce4-1251-4cda-9bea-4e67ee86abe1",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "335d24ac-14d0-481b-956f-acc8d26fda3d",
      "content": "Đại ý tác giả khuyên không nên dựa trên mặt ngoài : dù được che đậy thì trước sau gì sự độc ác của kẻ thù cũng lộ ra khi nó tác hại.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "9",
      "sortOrder": 8,
      "startOffset": 29,
      "endOffset": 29,
      "createdAt": "2025-09-03T02:49:46.705Z",
      "updatedAt": "2025-09-03T02:49:46.705Z",
      "targetId": "feec9b25-c68a-4271-8088-f498afa36338",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "854c675d-d67c-4e33-9b59-2f070edbf7b1",
      "content": "HR : *Hãy đối xử với nó như với kẻ tiết lộ một bí mật ; nó sẽ không hại được con ; hãy biết : ghen tuông mang lại hậu quả nào*.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "10",
      "sortOrder": 9,
      "startOffset": 38,
      "endOffset": 38,
      "createdAt": "2025-09-03T02:49:46.776Z",
      "updatedAt": "2025-09-03T02:49:46.776Z",
      "targetId": "fb2ac112-bfce-4f4e-9255-832aa43d645d",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "ed005f20-1bd3-43e2-ac7c-8924993f32ff",
      "content": "Thái độ đắc thắng và chế giễu : Tv 22,8 ; 109,25 ; Gr 18,16 ; Ed 25,6 ; Nk 3,19 ; Ac 2,15 ; G 16,4 ; x. Mt 27,39. *Để lộ chân tướng*, ds : *đổi bộ mặt*, nghĩa là thiện cảm trước đó chỉ là nguỵ tạo và giả dối.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "11",
      "sortOrder": 10,
      "startOffset": 41,
      "endOffset": 41,
      "createdAt": "2025-09-03T02:49:47.089Z",
      "updatedAt": "2025-09-03T02:49:47.089Z",
      "targetId": "0e0492a1-2fae-4ddf-829a-55f5de16704b",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    }
  ],
  "headings": [
    {
      "id": "db514065-0786-4e5f-ba48-1cd2b8e61b09",
      "text": "Làm ơn làm phúc",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T02:49:46.177Z",
      "updatedAt": "2025-09-03T02:49:46.177Z",
