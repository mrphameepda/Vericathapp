{
  "chapter": {
    "id": "88e74c8a-16da-4185-9758-b8a5115f1e43",
    "number": 12,
    "createdAt": "2025-09-03T01:07:51.705Z",
    "updatedAt": "2025-09-03T01:07:51.705Z",
    "bookId": "5c66a463-0bfa-46b7-9af1-3766a8779b73"
  },
  "verses": [
    {
      "id": "6ab4ce54-225d-4858-b467-de9dad20e48f",
      "text": "Nếu con làm việc thiện, thì hãy biết con làm cho ai,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:46.159Z",
      "updatedAt": "2025-09-03T02:49:46.159Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "6b96660d-dcee-4458-9b75-1240c04683f3",
      "text": "và con ở hiền thì sẽ gặp lành.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:46.220Z",
      "updatedAt": "2025-09-03T02:49:46.220Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "2cf29deb-9525-42c5-b2cc-5e65f5146a64",
      "text": "Hãy làm việc thiện cho người đạo hạnh,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:46.231Z",
      "updatedAt": "2025-09-03T02:49:46.231Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "b28b8488-7140-4af5-93c3-9a99b316e262",
      "text": "con sẽ được đền đáp,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:46.245Z",
      "updatedAt": "2025-09-03T02:49:46.245Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "bb5b34b0-d4f0-4fec-a99b-b4da4af20d46",
      "text": "nếu không do người ấy, thì cũng do Đấng Tối Cao.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:46.259Z",
      "updatedAt": "2025-09-03T02:49:46.259Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "ad6f1f20-3961-4dc6-bfe8-25f7406e78cf",
      "text": "Sẽ chẳng có chi may lành cho kẻ ngoan cố trong điều ác,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:46.301Z",
      "updatedAt": "2025-09-03T02:49:46.301Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "c75bb1a6-262e-4a23-86b1-2767bd618d03",
      "text": "cho kẻ không thích làm việc từ thiện.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:46.315Z",
      "updatedAt": "2025-09-03T02:49:46.315Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "1a8a6117-6861-4b66-b831-17ba94c5a0d4",
      "text": "Hãy cho người đạo hạnh, nhưng đừng giúp kẻ tội lỗi.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:46.343Z",
      "updatedAt": "2025-09-03T02:49:46.343Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "c4c1164a-41a3-4a02-b73e-4a9c4caad6f3",
      "text": "Hãy xử tốt với người khiêm tốn,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:46.372Z",
      "updatedAt": "2025-09-03T02:49:46.372Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "262034dd-38a2-4eb5-b77f-6bc5184688a4",
      "text": "và đừng ủng hộ quân vô đạo,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:46.385Z",
      "updatedAt": "2025-09-03T02:49:46.385Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "b2658e70-cc99-4e6f-93f0-666dae2d3edd",
      "text": "hãy khước từ, đừng cung cấp bánh ăn cho nó,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:46.399Z",
      "updatedAt": "2025-09-03T02:49:46.399Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "67f28199-92cb-4f1d-9419-e6b8934a6b00",
      "text": "kẻo nó được đàng chân lân đàng đầu ;",
      "label": "5",
      "number": 5,
      "subVerseIndex": 3,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:46.413Z",
      "updatedAt": "2025-09-03T02:49:46.413Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "4a67898c-e0a5-47c1-8c81-893711d24d45",
      "text": "con sẽ gặp hoạn nạn gấp đôi",
      "label": "5",
      "number": 5,
      "subVerseIndex": 4,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:46.427Z",
      "updatedAt": "2025-09-03T02:49:46.427Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "bb25730d-8a14-4c59-8321-1625dcd337ad",
      "text": "đối lại tất cả những việc lành con đã làm cho nó.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 5,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:46.442Z",
      "updatedAt": "2025-09-03T02:49:46.442Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "b9d5881b-8cbd-4bec-a5d0-a37365967d0d",
      "text": "Vì chính Đấng Tối Cao cũng gớm ghét phường tội lỗi,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:46.456Z",
      "updatedAt": "2025-09-03T02:49:46.456Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "acf4b63e-1f6a-42ad-928a-63ddf2ce3c28",
      "text": "Người sẽ trừng phạt để trả oán quân vô đạo.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:46.484Z",
      "updatedAt": "2025-09-03T02:49:46.484Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "ef4701bc-9e51-4127-8fe3-5fedead8d7a9",
      "text": "Hãy cho người tốt, nhưng đừng giúp kẻ tội lỗi.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:46.526Z",
      "updatedAt": "2025-09-03T02:49:46.526Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "16c2e68f-825c-4898-81c8-f962e6621448",
      "text": "Lúc gặp may, không nhận ra được ai là bạn,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:46.540Z",
      "updatedAt": "2025-09-03T02:49:46.540Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "d1fe9590-0bf2-493e-ad0c-db70d9b75f5a",
      "text": "khi lâm nạn, chẳng giấu nổi ai là thù.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:46.595Z",
      "updatedAt": "2025-09-03T02:49:46.595Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "b4448ce4-1251-4cda-9bea-4e67ee86abe1",
      "text": "Khi con người gặp may thì kẻ thù nó buồn khổ,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:46.609Z",
      "updatedAt": "2025-09-03T02:49:46.609Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "723a136e-2a56-4f87-b282-49970d1e49ef",
      "text": "lúc nó lâm nạn thì bạn hữu cũng tránh xa.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:46.636Z",
      "updatedAt": "2025-09-03T02:49:46.636Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "70421331-d394-45ad-8da4-b3097cf2449b",
      "text": "Đừng bao giờ tin vào thù địch ;",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:46.650Z",
      "updatedAt": "2025-09-03T02:49:46.650Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "f55086ca-adc7-4a99-a73b-da60293b942b",
      "text": "vì như đồng ten sét thế nào,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:46.677Z",
      "updatedAt": "2025-09-03T02:49:46.677Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "feec9b25-c68a-4271-8088-f498afa36338",
      "text": "thì sự độc ác của nó cũng vậy.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:46.692Z",
      "updatedAt": "2025-09-03T02:49:46.692Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "c5663843-7b69-48c4-8bf7-7efbbbd27ba0",
      "text": "Nếu nó tự hạ và đi đứng khúm núm,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:46.721Z",
      "updatedAt": "2025-09-03T02:49:46.721Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "68ee0187-5ca0-4df8-ba83-8a26d0a12bdc",
      "text": "thì con phải cảnh giác và coi chừng ;",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:46.734Z",
      "updatedAt": "2025-09-03T02:49:46.734Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "5b4b424e-6a8e-4bbd-b90e-58c4f2db04e0",
      "text": "hãy đối xử với nó như người lau gương,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:46.748Z",
      "updatedAt": "2025-09-03T02:49:46.748Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "fb2ac112-bfce-4f4e-9255-832aa43d645d",
      "text": "và biết rằng rốt cuộc nó sẽ bị lật tẩy.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 3,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:46.762Z",
      "updatedAt": "2025-09-03T02:49:46.762Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "96278586-acc5-4897-8b36-c5589ab7b9f0",
      "text": "Đừng để nó đứng cạnh con,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:46.790Z",
      "updatedAt": "2025-09-03T02:49:46.790Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "9d73757f-3d52-49db-a5d5-37288a63d869",
      "text": "kẻo nó lật nhào con rồi chiếm lấy chỗ ;",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:46.804Z",
      "updatedAt": "2025-09-03T02:49:46.804Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "52d81907-4b10-4c12-8f6b-3cb103e4e5aa",
      "text": "đừng đặt nó ngồi bên phải con,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:46.818Z",
      "updatedAt": "2025-09-03T02:49:46.818Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "e789f25a-b085-475a-a059-8b3483ab08ba",
      "text": "kẻo ghế của con, nó sẽ tìm cách chiếm đoạt.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 3,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:46.832Z",
      "updatedAt": "2025-09-03T02:49:46.832Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "6b7f556b-c113-4e1d-af00-52286126d8c3",
      "text": "Cuối cùng con sẽ hiểu lời ta,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 4,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:46.845Z",
      "updatedAt": "2025-09-03T02:49:46.845Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "4e344314-759a-494f-a6e7-1cab434e2779",
      "text": "và sẽ nuối tiếc những điều ta đã nói.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 5,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:46.865Z",
      "updatedAt": "2025-09-03T02:49:46.865Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "48225092-4f41-47cc-a1b5-1f36a82a03f4",
      "text": "Ai nào thương kẻ dụ rắn mà bị rắn cắn,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:46.879Z",
      "updatedAt": "2025-09-03T02:49:46.879Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "57a5aa1e-c7a4-46f1-8a31-56d53dbea4f3",
      "text": "ai nào xót mọi kẻ đến gần thú dữ đâu ?",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:46.893Z",
      "updatedAt": "2025-09-03T02:49:46.893Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "2729b7d4-5e2c-4d30-9600-eaa1df5e7779",
      "text": "Kẻ đồng hành với người tội lỗi,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:46.907Z",
      "updatedAt": "2025-09-03T02:49:46.907Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "c2547a53-1265-47e7-a113-171f54645262",
      "text": "và tham gia vào các tội của nó cũng vậy.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:46.922Z",
      "updatedAt": "2025-09-03T02:49:46.922Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "98a5bf0c-cfef-4814-a812-eda83adc70fe",
      "text": "Nó ở với con một giờ,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:46.936Z",
      "updatedAt": "2025-09-03T02:49:46.936Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "4c506bcd-cf9c-4e39-9b32-cef156c8bc4d",
      "text": "nhưng khi con chao đảo, nó sẽ không nán lại với con.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:46.949Z",
      "updatedAt": "2025-09-03T02:49:46.949Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "6f4768f6-8588-498d-bb1a-44c389ef9a8f",
      "text": "Kẻ thù, ngoài miệng thì ngọt xớt,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:46.963Z",
      "updatedAt": "2025-09-03T02:49:46.963Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "bbafe35b-cece-4ab1-bb8e-8f59802c0706",
      "text": "nhưng trong lòng lại tính xô con xuống vực sâu.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:46.992Z",
      "updatedAt": "2025-09-03T02:49:46.992Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "200ce868-56e6-4abd-a869-e68ad8bac6e9",
      "text": "Mắt kẻ thù cũng rưng rưng đẫm lệ,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 2,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:47.005Z",
      "updatedAt": "2025-09-03T02:49:47.005Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "817cbddc-d83c-4dbd-945c-708836671137",
      "text": "nhưng nếu gặp cơ hội, nó không thôi khát máu.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 3,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:47.019Z",
      "updatedAt": "2025-09-03T02:49:47.019Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "1cacd02a-ef46-40c0-b36f-93f32f80c4d3",
      "text": "Lúc lâm nạn, con sẽ thấy nó ở sẵn đó trước con rồi,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:47.033Z",
      "updatedAt": "2025-09-03T02:49:47.033Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "17f254dd-3627-43c7-a6f3-5db7a0d7c278",
      "text": "làm như giúp đỡ, nhưng kỳ thực lại hất cẳng con.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:47.047Z",
      "updatedAt": "2025-09-03T02:49:47.047Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "2022f691-e0bf-4031-b224-1adab5eea119",
      "text": "Nó sẽ lắc đầu vỗ tay,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:47.061Z",
      "updatedAt": "2025-09-03T02:49:47.061Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "0e0492a1-2fae-4ddf-829a-55f5de16704b",
      "text": "nói về con đủ điều mà để lộ chân tướng nó.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:47.075Z",
      "updatedAt": "2025-09-03T02:49:47.075Z",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    }
  ],
  "marks": [
    {
      "id": "c40119a3-8d55-41b8-91f7-359c4c93f843",
      "content": "Tinh thần biện phân ông Ben Xi-ra đưa ra ở đây là cần thiết, vì đạo Do-thái đang trải qua thời kỳ khủng hoảng : muốn thoát vòng kiềm toả của trào lưu Hy-lạp hoá để sống còn, người Do-thái phải cự tuyệt mọi chuyện thích nghi với đối phương.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 15,
      "endOffset": 15,
      "createdAt": "2025-09-03T02:49:46.188Z",
      "updatedAt": "2025-09-03T02:49:46.188Z",
      "targetId": "db514065-0786-4e5f-ba48-1cd2b8e61b09",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "f3d665c9-7b67-4760-93cf-efcfdf916b72",
      "content": "Mt 5,43-48; Lc 14,12-14",
      "kind": "MARK_KIND_REFERENCE",
      "label": "1@",
      "sortOrder": 0,
      "startOffset": 8,
      "endOffset": 8,
      "createdAt": "2025-09-03T02:49:46.209Z",
      "updatedAt": "2025-09-03T02:49:46.209Z",
      "targetId": "6ab4ce54-225d-4858-b467-de9dad20e48f",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "8a35b038-e0ae-4818-96db-1829633289e9",
      "content": "HR : *Nếu con làm điều ác cho kẻ làm việc thiện, thì con sẽ làm việc thiện cho ai ?*",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 51,
      "endOffset": 51,
      "createdAt": "2025-09-03T02:49:46.198Z",
      "updatedAt": "2025-09-03T02:49:46.198Z",
      "targetId": "6ab4ce54-225d-4858-b467-de9dad20e48f",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "96e7d41c-9ac7-4b4b-93dc-f731d2421c89",
      "content": "Đnl 14,29",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 32,
      "endOffset": 32,
      "createdAt": "2025-09-03T02:49:46.288Z",
      "updatedAt": "2025-09-03T02:49:46.288Z",
      "targetId": "bb5b34b0-d4f0-4fec-a99b-b4da4af20d46",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "88e74c8a-16da-4185-9758-b8a5115f1e43"
    },
    {
      "id": "8d2104b4-164c-4498-b966-71bf97c8dcc9",
      "content": "English: Most High | French: Très-Haut | Latin: Altissimus | Origin: &#1506;&#1462;&#1500;&#1456;&#1497;&#64331;&#1503; -- &#933;&#968;&#953;&#963;&#964;&#959;&#962; | Vietnamese: Đấng Tối Cao -- được dùng như tên riêng của Thiên Chúa thật, -- Is 14,14 ; Tv 91,1.9 ; Lc 1,32",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
