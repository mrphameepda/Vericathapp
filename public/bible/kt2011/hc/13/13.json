{
  "chapter": {
    "id": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b",
    "number": 13,
    "createdAt": "2025-09-03T01:07:51.705Z",
    "updatedAt": "2025-09-03T01:07:51.705Z",
    "bookId": "5c66a463-0bfa-46b7-9af1-3766a8779b73"
  },
  "verses": [
    {
      "id": "520f644e-03d7-4e2c-ae6e-7b2530530d42",
      "text": "Đụng vào nhựa thì sẽ dính,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:52.300Z",
      "updatedAt": "2025-09-03T02:49:52.300Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "ccdaa2cb-c63a-408f-9d6f-213d410b7d64",
      "text": "chơi với người kiêu ngạo thì sẽ giống như y.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:52.330Z",
      "updatedAt": "2025-09-03T02:49:52.330Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "d0726f1c-f484-4406-a795-3b3ef3510381",
      "text": "Gánh nặng quá sức con, con đừng mang lấy,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:52.341Z",
      "updatedAt": "2025-09-03T02:49:52.341Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "2a5dbe83-9785-4f2e-8f96-e4ae478de4f1",
      "text": "đừng đi lại với kẻ quyền thế và giàu có hơn con.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:52.352Z",
      "updatedAt": "2025-09-03T02:49:52.352Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "e1343f51-b63a-49a2-a3b0-57fd233006a4",
      "text": "Lọ sành để chung với bình đồng sao được ?",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:52.363Z",
      "updatedAt": "2025-09-03T02:49:52.363Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "3e5b5c8e-ec94-4081-bf4c-83aef18d3472",
      "text": "Chạm nhau là lọ sành tan vỡ.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 3,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:52.376Z",
      "updatedAt": "2025-09-03T02:49:52.376Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "6c60176a-7b55-4112-b8c2-8da3e384a6c7",
      "text": "Người giàu vừa ăn cướp vừa la làng,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:52.405Z",
      "updatedAt": "2025-09-03T02:49:52.405Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "e905f4a8-880a-4fa5-8841-9ecddd6fb4d4",
      "text": "còn người nghèo bị thiệt thì lại phải năn nỉ.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:52.419Z",
      "updatedAt": "2025-09-03T02:49:52.419Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "abbb64b7-5b84-4a1d-8e97-565af0bcb72c",
      "text": "Nếu con có ích cho nó, nó sẽ dùng con,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:52.447Z",
      "updatedAt": "2025-09-03T02:49:52.447Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "b59007f9-58fc-42c2-95ca-f1300d0fd944",
      "text": "nhưng sẽ bỏ rơi con, nếu con sa cơ thất thế.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:52.461Z",
      "updatedAt": "2025-09-03T02:49:52.461Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "110ec637-93b5-43b4-b173-e03418ca37d8",
      "text": "Con có của, nó sẽ sống với con,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:52.475Z",
      "updatedAt": "2025-09-03T02:49:52.475Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "4aee17de-9e5a-4ab9-baaa-aff61aa53bfd",
      "text": "và bóc lột con không chút quản ngại.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:52.489Z",
      "updatedAt": "2025-09-03T02:49:52.489Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "f1418766-dda2-4b75-89b0-42ac716b663c",
      "text": "Khi cần, nó sẽ dỗ ngọt con,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:52.502Z",
      "updatedAt": "2025-09-03T02:49:52.502Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "78cfde32-d665-4bd0-a183-6b2fea89d191",
      "text": "nó tươi cười với con để làm con hy vọng,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:52.517Z",
      "updatedAt": "2025-09-03T02:49:52.517Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "4dba42b6-8485-4329-ab22-f4761bb3e78e",
      "text": "nó nói ngon nói ngọt và bảo : “Anh cần gì không ?”",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:52.531Z",
      "updatedAt": "2025-09-03T02:49:52.531Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "941efa41-1fc2-4da4-9888-8a0e7f0b4fee",
      "text": "Nó bày tiệc làm con xấu hổ để bóc lột con đến cùng kiệt,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:52.546Z",
      "updatedAt": "2025-09-03T02:49:52.546Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "07da25d2-c91a-4331-8450-fecb17734bd6",
      "text": "rốt cuộc nó sẽ chế nhạo con ;",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:52.587Z",
      "updatedAt": "2025-09-03T02:49:52.587Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "3f24f26f-8a70-4323-8e92-eb10446b535b",
      "text": "rồi sau đó, hễ thấy con là nó làm ngơ, và lắc đầu khinh dể.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:52.601Z",
      "updatedAt": "2025-09-03T02:49:52.601Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "4af72724-ea17-43af-8992-0a3013f78a7d",
      "text": "Coi chừng chớ để người ta dụ dỗ con,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:52.614Z",
      "updatedAt": "2025-09-03T02:49:52.614Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "49dd735b-7218-4fa3-8680-4f2ea3e2cbea",
      "text": "kẻo vì dại khờ mà con bị nhục.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:52.629Z",
      "updatedAt": "2025-09-03T02:49:52.629Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "a0a43bb0-9ca8-4588-b884-67f41db5a2de",
      "text": "Khi người quyền thế mời gọi con, con hãy lẩn đi,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:52.656Z",
      "updatedAt": "2025-09-03T02:49:52.656Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "cb5b1756-8285-47ce-a4c7-d0aecdc01876",
      "text": "như thế, người ta càng mời mọc con hơn nữa.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:52.670Z",
      "updatedAt": "2025-09-03T02:49:52.670Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "71b854b4-1dd2-4638-8713-bea4b7f351c7",
      "text": "Đừng vồ vập, kẻo bị tống cổ ra,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:52.684Z",
      "updatedAt": "2025-09-03T02:49:52.684Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "8d2ae479-8511-439a-bdfe-c52bfb6ca0a6",
      "text": "cũng đừng đứng xa, kẻo bị quên mất.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:52.698Z",
      "updatedAt": "2025-09-03T02:49:52.698Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "dc86babe-df37-4afb-88a4-6e42bba0fba5",
      "text": "Đừng hòng ăn nói với họ như kẻ ngang hàng,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:52.726Z",
      "updatedAt": "2025-09-03T02:49:52.726Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "cfff3aae-8179-4bf1-a9a6-20035745679c",
      "text": "cũng đừng tin những lời lẽ ba hoa của họ ;",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:52.739Z",
      "updatedAt": "2025-09-03T02:49:52.739Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "89fbf3d2-9aa1-46d6-adcc-61183abe8ae7",
      "text": "vì họ nói nhiều là có ý thử con,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:52.753Z",
      "updatedAt": "2025-09-03T02:49:52.753Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "27913488-eb4c-47cf-8c26-20df4cc58fa3",
      "text": "và giả bộ tươi cười với con là để dò xét.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 3,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:52.768Z",
      "updatedAt": "2025-09-03T02:49:52.768Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "3f383ac1-15f8-4962-b7ec-e3250b660741",
      "text": "Ai không giữ kín lời tâm sự của người khác, đó là kẻ tàn nhẫn,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:52.782Z",
      "updatedAt": "2025-09-03T02:49:52.782Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "15a21531-3455-47ad-a641-e2cf6ff6fb25",
      "text": "có ai bị hành hạ hay xiềng xích, nó cũng chẳng quan tâm.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:52.796Z",
      "updatedAt": "2025-09-03T02:49:52.796Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "62127d27-658a-4002-87fd-42f505cdf8d9",
      "text": "Hãy cẩn thận, hãy hết sức coi chừng,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:52.809Z",
      "updatedAt": "2025-09-03T02:49:52.809Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "b37c4983-261e-474f-9fcd-1c4423156b98",
      "text": "vì con đang đồng hành với sự suy vong rồi đó.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:52.823Z",
      "updatedAt": "2025-09-03T02:49:52.823Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "3c813a8f-e599-4d82-b6f9-008f597104cc",
      "text": "Sinh vật nào cũng ưa thích đồng loại của mình,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:52.851Z",
      "updatedAt": "2025-09-03T02:49:52.851Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "31542c0e-b6aa-4f27-a8ba-7e103451670a",
      "text": "và người nào cũng ưa thích người thân cận.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:52.865Z",
      "updatedAt": "2025-09-03T02:49:52.865Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "3062f9d0-60a0-408c-8792-78552e7b3775",
      "text": "Xác thịt nào thì kết hợp theo giống đó,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:52.879Z",
      "updatedAt": "2025-09-03T02:49:52.879Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "7388e016-4c91-442d-b4f1-c93f44af8489",
      "text": "và con người thì gắn bó với đồng loại của mình.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:52.893Z",
      "updatedAt": "2025-09-03T02:49:52.893Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "38f21d5e-8fca-4b59-99de-51cf167a71d0",
      "text": "Sói sống chung với chiên sao được ?",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:52.907Z",
      "updatedAt": "2025-09-03T02:49:52.907Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "d501fd10-100b-4c3b-bcaf-42ef5794b47f",
      "text": "Kẻ tội lỗi với người đạo hạnh cũng thế.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:52.934Z",
      "updatedAt": "2025-09-03T02:49:52.934Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "a74c474f-ba3e-40b4-93e2-e7fb58eaf4c4",
      "text": "Hoà bình sao được giữa chó rừng và chó nhà ?",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:52.948Z",
      "updatedAt": "2025-09-03T02:49:52.948Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "6010e219-2ad5-45d6-9384-e185db2dd8e3",
      "text": "Và hoà bình sao được giữa kẻ giàu sang với người lam lũ ?",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:52.963Z",
      "updatedAt": "2025-09-03T02:49:52.963Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "73173013-e7e4-4e87-b11f-3982640efb69",
      "text": "Lừa hoang trong sa mạc là mồi cho sư tử,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:52.991Z",
      "updatedAt": "2025-09-03T02:49:52.991Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "770af146-2e0e-44c6-b3a6-6463e3277ff9",
      "text": "cũng vậy, kẻ nghèo túng là mồi cho bọn giàu sang.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:53.009Z",
      "updatedAt": "2025-09-03T02:49:53.009Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "9d065ec4-e67e-4399-8628-f1d93db55c20",
      "text": "Đối với kẻ kiêu ngạo thì thấp hèn là điều ghê tởm,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:53.022Z",
      "updatedAt": "2025-09-03T02:49:53.022Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "0a797598-2134-42dd-86f7-ae1e4ee22b09",
      "text": "cũng vậy, đối với người giàu có thì kẻ nghèo là đồ gớm ghê.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:53.036Z",
      "updatedAt": "2025-09-03T02:49:53.036Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "bb4e16a7-218d-49ba-ae95-9231c8f1409c",
      "text": "Người giàu trượt chân thì được bạn bè nâng đỡ,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:53.050Z",
      "updatedAt": "2025-09-03T02:49:53.050Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "4cb7a231-b8ca-4fd0-8915-72ef96b86801",
      "text": "còn kẻ nghèo mà ngã thì bị bạn hữu bỏ rơi.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:53.079Z",
      "updatedAt": "2025-09-03T02:49:53.079Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "3426c33c-c10f-42be-934a-3ab1eb1cb1cb",
      "text": "Người giàu mà có lỡ, thì nhiều người cứu gỡ cho,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:53.113Z",
      "updatedAt": "2025-09-03T02:49:53.113Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "81d918fb-3634-48b2-88f7-51009178b96a",
      "text": "có nói bậy, người ta cũng cho là phải.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:53.140Z",
      "updatedAt": "2025-09-03T02:49:53.140Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "0b9f7ce3-86a7-4b10-b5fb-bccccf261053",
      "text": "Kẻ nghèo có lỡ, thì người ta chê trách,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 2,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:53.152Z",
      "updatedAt": "2025-09-03T02:49:53.152Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "094b69a3-6b73-4907-a54f-acb5193dbb02",
      "text": "có nói hay, thiên hạ cũng chẳng kể vào đâu.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 3,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:53.164Z",
      "updatedAt": "2025-09-03T02:49:53.164Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "f60a4087-1dba-4ab0-9ebe-e148833631e2",
      "text": "Người giàu lên tiếng thì mọi người im lặng,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:53.175Z",
      "updatedAt": "2025-09-03T02:49:53.175Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "fae42122-8f8d-472c-a66f-a4e0e8f62efe",
      "text": "người ta đưa lời của nó lên tận chín tầng mây ;",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:53.193Z",
      "updatedAt": "2025-09-03T02:49:53.193Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "ea64d2f4-7fcd-4e15-9140-a4a1b3ff95b2",
      "text": "khi kẻ nghèo lên tiếng thì họ bảo : “Ai vậy ?”",
      "label": "23",
      "number": 23,
      "subVerseIndex": 2,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:53.206Z",
      "updatedAt": "2025-09-03T02:49:53.206Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "0eaa6308-e3d0-4658-9ae7-86baf10d3066",
      "text": "Nếu nó vấp, họ sẽ xô cho té nhào.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 3,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:53.220Z",
      "updatedAt": "2025-09-03T02:49:53.220Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "d3844ccc-0432-41d8-a14a-11186a3bce11",
      "text": "Giàu là tốt nếu không mắc tội,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:53.234Z",
      "updatedAt": "2025-09-03T02:49:53.234Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "eca1389b-25ed-423d-9e31-c69322fe91fe",
      "text": "nhưng theo lời kẻ vô đạo thì nghèo là xấu.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:53.249Z",
      "updatedAt": "2025-09-03T02:49:53.249Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "3600f69d-73f5-42ea-8a73-3bf4b869f8f5",
      "text": "Lòng người làm thay đổi nét mặt,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:53.276Z",
      "updatedAt": "2025-09-03T02:49:53.276Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "ab1d678b-d2c5-4643-a708-4c53ef136d6c",
      "text": "để lộ ra cái tốt hay cái xấu.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:53.304Z",
      "updatedAt": "2025-09-03T02:49:53.304Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "22fa4d6b-21d8-43e0-a9b2-f3e974067c3b",
      "text": "Nét mặt vui tươi là dấu chỉ một tâm hồn hạnh phúc.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:53.318Z",
      "updatedAt": "2025-09-03T02:49:53.318Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "2c0156ea-49b8-4b5d-af52-c6e8ba50044f",
      "text": "Phải lao tâm khổ tứ lắm mới làm được các dụ ngôn.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:53.332Z",
      "updatedAt": "2025-09-03T02:49:53.332Z",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    }
  ],
  "marks": [
    {
      "id": "692bf572-d7cd-45f2-9459-42dd97e9c730",
      "content": "Hình ảnh so sánh cổ điển đã có từ nhà văn ngụ ngôn Ésope Hy-lạp (thế kỷ VII-VI tCN). HR thêm : “Mà tại sao người giàu lại liên kết với kẻ nghèo ?”",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 27,
      "endOffset": 27,
      "createdAt": "2025-09-03T02:49:52.391Z",
      "updatedAt": "2025-09-03T02:49:52.391Z",
      "targetId": "3e5b5c8e-ec94-4081-bf4c-83aef18d3472",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "63723f01-2b09-4b80-9fb0-312da00ca442",
      "content": "Cn 18,23",
      "kind": "MARK_KIND_REFERENCE",
      "label": "1@",
      "sortOrder": 0,
      "startOffset": 4,
      "endOffset": 4,
      "createdAt": "2025-09-03T02:49:52.433Z",
      "updatedAt": "2025-09-03T02:49:52.433Z",
      "targetId": "e905f4a8-880a-4fa5-8841-9ecddd6fb4d4",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "1be0a01a-7bff-4acf-9e76-b9a3b310ce1c",
      "content": "HR : *Bao lâu còn có lợi thì nó coi con chẳng ra gì ; đôi ba lần nó tỏ lòng quý chuộng con*.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 26,
      "endOffset": 26,
      "createdAt": "2025-09-03T02:49:52.560Z",
      "updatedAt": "2025-09-03T02:49:52.560Z",
      "targetId": "941efa41-1fc2-4da4-9888-8a0e7f0b4fee",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "9546865d-0a31-4495-ada0-ae8d5103c440",
      "content": "Cn 23,1-3",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:49:52.573Z",
      "updatedAt": "2025-09-03T02:49:52.573Z",
      "targetId": "941efa41-1fc2-4da4-9888-8a0e7f0b4fee",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "1ddf8c63-e998-43ae-98cc-085ce8dade91",
      "content": "HR : *Coi chừng chớ quá hoảng hốt ; đừng giống như những kẻ khờ dại*. Câu này cũng có thể đi với khúc trên.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 29,
      "endOffset": 29,
      "createdAt": "2025-09-03T02:49:52.642Z",
      "updatedAt": "2025-09-03T02:49:52.642Z",
      "targetId": "49dd735b-7218-4fa3-8680-4f2ea3e2cbea",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "445a9874-aabd-4c16-97f0-55f429f00d16",
      "content": "Cn 19,4-7",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 6,
      "endOffset": 6,
      "createdAt": "2025-09-03T02:49:53.064Z",
      "updatedAt": "2025-09-03T02:49:53.064Z",
      "targetId": "bb4e16a7-218d-49ba-ae95-9231c8f1409c",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "e9297e4a-66aa-44d7-be27-55fa39b4933a",
      "content": "Thái độ trung dung được cân nhắc cẩn thận ; nhưng lời khuyên của ông Ben Xi-ra không phải là không hóm hỉnh. Người ta có thể đối chiếu lời ông với lời Chúa nói ở Lc 14,8-10. Tuy nhiên, hai bên khác nhau về cả nội dung lẫn lý do hành động.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 34,
      "endOffset": 34,
      "createdAt": "2025-09-03T02:49:52.712Z",
      "updatedAt": "2025-09-03T02:49:52.712Z",
      "targetId": "8d2ae479-8511-439a-bdfe-c52bfb6ca0a6",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "d9e655f4-7e15-4c02-869b-2ecfd3cafd7a",
      "content": "Cn 14,20",
      "kind": "MARK_KIND_REFERENCE",
      "label": "4@",
      "sortOrder": 3,
      "startOffset": 6,
      "endOffset": 6,
      "createdAt": "2025-09-03T02:49:53.127Z",
      "updatedAt": "2025-09-03T02:49:53.127Z",
      "targetId": "3426c33c-c10f-42be-934a-3ab1eb1cb1cb",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "59490412-da8a-4dff-8ad8-55b2f016b350",
      "content": "HR : *Đừng đồng hành với kẻ vũ phu*. Một số thủ bản thêm c.14 “Khi con nghe biết điều đó trong giấc ngủ, con hãy thức dậy ; suốt đời hãy kính mến Đức Chúa và hãy kêu cầu Người để được cứu độ.”",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "5",
      "sortOrder": 4,
      "startOffset": 44,
      "endOffset": 44,
      "createdAt": "2025-09-03T02:49:52.837Z",
      "updatedAt": "2025-09-03T02:49:52.837Z",
      "targetId": "b37c4983-261e-474f-9fcd-1c4423156b98",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "6e39f97c-0436-4bcd-b581-8a0e1e5b794d",
      "content": "Cn 15,13",
      "kind": "MARK_KIND_REFERENCE",
      "label": "5@",
      "sortOrder": 4,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:49:53.291Z",
      "updatedAt": "2025-09-03T02:49:53.291Z",
      "targetId": "3600f69d-73f5-42ea-8a73-3bf4b869f8f5",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "bda7e6dc-aed9-478b-bd09-0b3170734685",
      "content": "Hình ảnh quen thuộc. Nhưng theo Is 11,6 một trong những dấu của thời thiên sai là chiên và sói sống chung với nhau. X. Mt 10,16.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "6",
      "sortOrder": 5,
      "startOffset": 35,
      "endOffset": 35,
      "createdAt": "2025-09-03T02:49:52.921Z",
      "updatedAt": "2025-09-03T02:49:52.921Z",
      "targetId": "38f21d5e-8fca-4b59-99de-51cf167a71d0",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "5c78f0c6-765f-4486-91c9-86ab689f23f8",
      "content": "Ông Ben Xi-ra cho rằng sở dĩ chỉ nên giao lưu với người đồng trang đồng lứa là vì sự hài hoà trong thiên nhiên đòi như thế. Nói cách khác : đó là lệnh của Tạo Hoá. Dầu sao thì giàu có không bị lên án tuyệt đối ; tác giả chỉ muốn ngăn không để cho người nghèo bị mê hoặc và chà đạp bởi kẻ giàu.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "7",
      "sortOrder": 6,
      "startOffset": 55,
      "endOffset": 55,
      "createdAt": "2025-09-03T02:49:52.977Z",
      "updatedAt": "2025-09-03T02:49:52.977Z",
      "targetId": "6010e219-2ad5-45d6-9384-e185db2dd8e3",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "ec1543d1-666f-47c9-bef3-5b4b43e15198",
      "content": "*Trượt chân* có lẽ hiểu nghĩa bóng về *lỡ lời* (HR : *nói*) có lẽ hợp văn mạch hơn (x. 14,1 tt).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "8",
      "sortOrder": 7,
      "startOffset": 41,
      "endOffset": 41,
      "createdAt": "2025-09-03T02:49:53.092Z",
      "updatedAt": "2025-09-03T02:49:53.092Z",
      "targetId": "4cb7a231-b8ca-4fd0-8915-72ef96b86801",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "1b28f6ce-1941-431d-9906-4217e7eccdb4",
      "content": "Câu này xem ra đính chính những câu trên : không phải cứ người giàu là xấu, cũng chẳng phải người nghèo nào cũng tốt cả.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "9",
      "sortOrder": 8,
      "startOffset": 41,
      "endOffset": 41,
      "createdAt": "2025-09-03T02:49:53.262Z",
      "updatedAt": "2025-09-03T02:49:53.262Z",
      "targetId": "eca1389b-25ed-423d-9e31-c69322fe91fe",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    },
    {
      "id": "5b800852-33be-4b3e-aa9f-fb0d42c421f2",
      "content": "Theo cả Hy-lạp lẫn Híp-ri, ý nghĩa câu này không rõ, và mạch lạc với câu trên thế nào cũng chẳng xác định được.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "10",
      "sortOrder": 9,
      "startOffset": 48,
      "endOffset": 48,
      "createdAt": "2025-09-03T02:49:53.349Z",
      "updatedAt": "2025-09-03T02:49:53.349Z",
      "targetId": "2c0156ea-49b8-4b5d-af52-c6e8ba50044f",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "5c6eacf5-70f7-4255-b89a-8c2456f6b04b"
    }
  ],
