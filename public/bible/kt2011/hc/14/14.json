{
  "chapter": {
    "id": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a",
    "number": 14,
    "createdAt": "2025-09-03T01:07:51.705Z",
    "updatedAt": "2025-09-03T01:07:51.705Z",
    "bookId": "5c66a463-0bfa-46b7-9af1-3766a8779b73"
  },
  "verses": [
    {
      "id": "4a8ee699-70ae-455c-abaa-149f0e873015",
      "text": "Phúc thay kẻ không ăn nói lỡ lầm,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:58.824Z",
      "updatedAt": "2025-09-03T02:49:58.824Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "96963992-f70a-4640-a8a8-5a1711ae75ef",
      "text": "và không phải khổ vì hối hận.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:58.876Z",
      "updatedAt": "2025-09-03T02:49:58.876Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "f3126489-3d69-4262-9036-36b5ff551fee",
      "text": "Phúc thay ai không bị lương tâm cắn rứt,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:58.888Z",
      "updatedAt": "2025-09-03T02:49:58.888Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "f971031a-d072-466a-bbf6-39c1aae79c1e",
      "text": "và kẻ không rơi vào thất vọng.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:58.901Z",
      "updatedAt": "2025-09-03T02:49:58.901Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "50b6375a-3eb0-4ce9-8ab0-146d7dc704b0",
      "text": "Của cải không lợi gì cho kẻ tiểu nhân,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:58.915Z",
      "updatedAt": "2025-09-03T02:49:58.915Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "d815dd93-b63f-4dd0-8fe8-c354ee5a6c8f",
      "text": "đối với con người đố kỵ, thì tài sản để làm gì ?",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:58.956Z",
      "updatedAt": "2025-09-03T02:49:58.956Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "dd787ef3-2b2a-462b-aa2e-119cef84b8ee",
      "text": "Tích luỹ mà vong thân là tích luỹ cho kẻ khác,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:58.969Z",
      "updatedAt": "2025-09-03T02:49:58.969Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "24851a3b-f281-420f-b593-f9970e5132ae",
      "text": "người khác sẽ hưởng dùng của cải nó thu gom.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:58.997Z",
      "updatedAt": "2025-09-03T02:49:58.997Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "fb946e43-5660-43aa-9aca-daf380594ff4",
      "text": "Xấu với bản thân thì tốt với ai được ?",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.011Z",
      "updatedAt": "2025-09-03T02:49:59.011Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "60730113-3523-4025-8c07-d6579b57039b",
      "text": "Ngay cả với tài sản của mình, nó cũng không được hưởng.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.025Z",
      "updatedAt": "2025-09-03T02:49:59.025Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "64c808f1-5d91-4c66-98d2-ef18f31704ac",
      "text": "Không ai tệ hơn kẻ làm hại chính mình,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.038Z",
      "updatedAt": "2025-09-03T02:49:59.038Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "22eab7c8-5c13-4a92-8d63-bcc150c2a114",
      "text": "và đó là công trả cho sự gian ác của nó.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.076Z",
      "updatedAt": "2025-09-03T02:49:59.076Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "60d7c4bd-0bee-42ac-b8dc-fe6a07db60ac",
      "text": "Nó có làm điều tốt, thì chẳng qua vì vô tình,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.090Z",
      "updatedAt": "2025-09-03T02:49:59.090Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "cbc6b5dd-80ff-471f-a470-f01df02a9347",
      "text": "cuối cùng nó cũng để lộ ra sự gian ác của nó.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.104Z",
      "updatedAt": "2025-09-03T02:49:59.104Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "e0e4fe05-459f-42f3-b753-cbfeb6983786",
      "text": "Ai nhìn với con mắt đố kỵ là người xấu,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.118Z",
      "updatedAt": "2025-09-03T02:49:59.118Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "90535eb4-cff7-44bc-8f1a-ae73653a1ed1",
      "text": "nó ngoảnh mặt đi và khinh dể thiên hạ.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.135Z",
      "updatedAt": "2025-09-03T02:49:59.135Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "7d19122f-7c38-4629-aea9-70dd18d49057",
      "text": "Kẻ có mắt tham lam thì không bằng lòng với phận mình,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.162Z",
      "updatedAt": "2025-09-03T02:49:59.162Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "4fc4277c-ba24-4566-b5ad-42ed1ae7b68b",
      "text": "và keo kiệt làm cho tâm hồn ra cằn cỗi.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.190Z",
      "updatedAt": "2025-09-03T02:49:59.190Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "2330301d-27d9-4f5b-acbe-6b5b39074dae",
      "text": "Kẻ có mắt xấu xa thì keo kiệt về miếng ăn,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.218Z",
      "updatedAt": "2025-09-03T02:49:59.218Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "8bb06f31-d612-4dc1-a912-df15342b3522",
      "text": "và trên bàn ăn, trông thật sơ sài.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.232Z",
      "updatedAt": "2025-09-03T02:49:59.232Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "5b58c2d3-6dc0-4043-9d09-72e22abf80af",
      "text": "Con ơi, nếu có của, hãy làm cho đời con được tốt đẹp,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.260Z",
      "updatedAt": "2025-09-03T02:49:59.260Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "2509cb19-4a8e-4981-92c5-4f64cf327a0f",
      "text": "và tiến dâng lễ vật lên Đức Chúa sao cho xứng.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.275Z",
      "updatedAt": "2025-09-03T02:49:59.275Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "cee47cb5-1625-44a1-a89c-e1e2b9f9402e",
      "text": "Hãy nhớ rằng cái chết không trì hoãn đâu,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.288Z",
      "updatedAt": "2025-09-03T02:49:59.288Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "f77a8f22-8131-4ba0-b9e8-1185b889d2cd",
      "text": "và ngày hẹn của âm phủ, con nào có biết !",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.302Z",
      "updatedAt": "2025-09-03T02:49:59.302Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "85e35ca6-4351-4ebe-b4a7-1fde532e5f70",
      "text": "Trước khi chết, hãy làm ơn cho thân hữu,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.344Z",
      "updatedAt": "2025-09-03T02:49:59.344Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "e78073c5-3f1c-401c-a041-faa70269d022",
      "text": "và rộng rãi với họ theo khả năng của con.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.357Z",
      "updatedAt": "2025-09-03T02:49:59.357Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "dfb974c2-4956-4947-ab4b-d13ef7f5bd34",
      "text": "Đừng từ chối không hưởng một ngày vui,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.371Z",
      "updatedAt": "2025-09-03T02:49:59.371Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "5f370b15-e009-4751-8e73-d388a7c817b8",
      "text": "hoài bão của con, đừng để cho phần nào trôi đi mất.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.399Z",
      "updatedAt": "2025-09-03T02:49:59.399Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "5844f621-36f4-4ace-b2a1-e35933e39bd9",
      "text": "Nào con không để lại công khó của con cho người khác,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.414Z",
      "updatedAt": "2025-09-03T02:49:59.414Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "b556d618-0eab-4679-9e05-6c89e95f0094",
      "text": "và mồ hôi nước mắt của con",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.428Z",
      "updatedAt": "2025-09-03T02:49:59.428Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "95894819-e429-4ced-b6fa-8f3081959ca4",
      "text": "cho người ta bắt thăm chia chác đó sao ?",
      "label": "15",
      "number": 15,
      "subVerseIndex": 2,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.442Z",
      "updatedAt": "2025-09-03T02:49:59.442Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "e20cd8f0-621c-4b84-9fa3-ab0925ba24fb",
      "text": "Hãy cho và nhận, hãy làm cho tâm hồn mình khuây khoả,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.459Z",
      "updatedAt": "2025-09-03T02:49:59.459Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "3e8b9909-89eb-48e5-89b0-826dc4c8c7c2",
      "text": "vì trong âm phủ, còn tìm đâu ra khoái lạc !",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.473Z",
      "updatedAt": "2025-09-03T02:49:59.473Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "f83e36f3-e0e1-45ad-bdea-35a3f8ad16e2",
      "text": "Mọi xác phàm như chiếc áo, thảy đều mòn hao,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.515Z",
      "updatedAt": "2025-09-03T02:49:59.515Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "0a672ba3-c042-49f3-bd38-ab18ea74295a",
      "text": "vì quy luật muôn đời là : chắc chắn con sẽ phải chết.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.529Z",
      "updatedAt": "2025-09-03T02:49:59.529Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "16a58b54-26ec-4695-84f1-0905ddb6208c",
      "text": "Như cành lá trên cây rậm rạp : lá rụng xuống, lá lại mọc ra,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.543Z",
      "updatedAt": "2025-09-03T02:49:59.543Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "44130578-7114-40bf-9485-8677c934da2d",
      "text": "thì các thế hệ người phàm cũng vậy :",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.557Z",
      "updatedAt": "2025-09-03T02:49:59.557Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "d5145ec3-5d2f-4e8d-b081-42ae157574fa",
      "text": "lớp kết thúc, lớp lại sinh ra.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 2,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.585Z",
      "updatedAt": "2025-09-03T02:49:59.585Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "34a30066-f1aa-4acd-bbc4-526c434ed714",
      "text": "Mọi công trình phải hư nát đều tiêu tan hết thảy,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.599Z",
      "updatedAt": "2025-09-03T02:49:59.599Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "943431d1-797b-4bf5-b356-77a7154adc54",
      "text": "và tác giả của chúng cũng theo chúng ra đi.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.627Z",
      "updatedAt": "2025-09-03T02:49:59.627Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "3d251eab-9794-4bca-9f90-380ef9b1ce6e",
      "text": "Phúc thay kẻ nghiền ngẫm khôn ngoan,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.655Z",
      "updatedAt": "2025-09-03T02:49:59.655Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "0e47a781-c2b8-4b00-a84c-46bb9766e781",
      "text": "và biết dùng trí khôn mà suy luận.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.696Z",
      "updatedAt": "2025-09-03T02:49:59.696Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "90da6d2d-ce3d-432f-8b59-c920cb9a8da4",
      "text": "Phúc thay kẻ để tâm suy nghĩ về đường lối của khôn ngoan,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.710Z",
      "updatedAt": "2025-09-03T02:49:59.710Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "432899b8-0577-4d72-bd03-9b5e2b4caca5",
      "text": "và hiểu được các bí nhiệm của đức ấy.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.723Z",
      "updatedAt": "2025-09-03T02:49:59.723Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "34121997-cbf5-4907-8f23-5ac1df1aec55",
      "text": "Như một thợ săn, người ấy theo vết của khôn ngoan,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.752Z",
      "updatedAt": "2025-09-03T02:49:59.752Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "30334a84-febc-41a6-b578-7058946c1ca3",
      "text": "và trên đường của khôn ngoan, nó rình chờ.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.766Z",
      "updatedAt": "2025-09-03T02:49:59.766Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "9c1bf629-2924-48c0-846c-9db5e8a0492b",
      "text": "Nó nhìn vào cửa sổ của khôn ngoan,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.781Z",
      "updatedAt": "2025-09-03T02:49:59.781Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "5dcf73da-9b02-45ed-b9c9-f4a7268bbf25",
      "text": "và lắng nghe bên cửa ra vào.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.794Z",
      "updatedAt": "2025-09-03T02:49:59.794Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "6895f44f-e4ba-4814-99a6-e4680efc0934",
      "text": "Nó ở sát nhà của khôn ngoan,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.808Z",
      "updatedAt": "2025-09-03T02:49:59.808Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "a846c4bc-b6a3-4079-9d98-2130fc04ccf3",
      "text": "và đóng đinh vào tường.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.822Z",
      "updatedAt": "2025-09-03T02:49:59.822Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "f5d8f1b9-1371-4cd0-953d-94fe5e52e406",
      "text": "Nó dựng lều dưới cánh tay của khôn ngoan,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.850Z",
      "updatedAt": "2025-09-03T02:49:59.850Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "ca607c1e-bb8a-4ae4-82ff-c226b7c11a87",
      "text": "và sẽ được ở nơi hạnh phúc.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.864Z",
      "updatedAt": "2025-09-03T02:49:59.864Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "6160c05c-ce44-432a-ac6a-7f097607bb1f",
      "text": "Nó sẽ đặt con cái dưới sự che chở của khôn ngoan,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.878Z",
      "updatedAt": "2025-09-03T02:49:59.878Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "70715a7e-6f32-4cf5-a44c-754affa4d4b8",
      "text": "và dưới tán lá của khôn ngoan, nó sẽ trú ẩn.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.891Z",
      "updatedAt": "2025-09-03T02:49:59.891Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "ee00f80c-b148-4c21-a688-1f3d03fbe204",
      "text": "Dưới bóng của khôn ngoan, nó không bị nóng bức,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.905Z",
      "updatedAt": "2025-09-03T02:49:59.905Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "455bbc23-56fa-41be-b40c-2136df90d208",
      "text": "và trong vinh quang của khôn ngoan, nó sẽ cư ngụ.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:59.919Z",
      "updatedAt": "2025-09-03T02:49:59.919Z",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    }
  ],
  "marks": [
    {
      "id": "b0d7a943-465a-402c-a6a7-1435ad32b6a3",
      "content": "Nhiều Thánh vịnh, như Tv 1 ; 32 ; 41 ; 119 ; 128 cũng đề cao hạnh phúc của những tâm hồn trong sạch đối lại với những kẻ người đời cho là “hạnh phúc”. Ở đây, sau khi cho thấy nguy cơ do của cải gây ra, tác giả Hc chủ trương chỉ người lương thiện mới hạnh phúc thật. Như thế các mối phúc của Tin Mừng đã được báo trước phần nào (x. Mt 5,1-12).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 32,
      "endOffset": 32,
      "createdAt": "2025-09-03T02:49:58.855Z",
      "updatedAt": "2025-09-03T02:49:58.855Z",
      "targetId": "4a8ee699-70ae-455c-abaa-149f0e873015",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "5ddd447a-8dae-4363-bcd1-bf9f3d253d1d",
      "content": "Hc 19,16; 25,8",
      "kind": "MARK_KIND_REFERENCE",
