    },
    {
      "id": "626e2214-0c91-4372-aa75-5111e65d59a4",
      "content": "Gv 5,9; 6,2",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 9,
      "endOffset": 9,
      "createdAt": "2025-09-03T02:49:58.942Z",
      "updatedAt": "2025-09-03T02:49:58.942Z",
      "targetId": "1a0c1d54-19d6-4410-a694-506d3b4dab89",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "72856a27-45e6-4216-9534-041b8b9ac12b",
      "content": "Đố kỵ với người khác vì tham lam ích kỷ. Ngoảnh mặt đi để khỏi phải giúp đỡ người ta.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 37,
      "endOffset": 37,
      "createdAt": "2025-09-03T02:49:59.149Z",
      "updatedAt": "2025-09-03T02:49:59.149Z",
      "targetId": "90535eb4-cff7-44bc-8f1a-ae73653a1ed1",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "779e39f2-0ea5-487f-ac1f-a1b6d51f7908",
      "content": "G 27,16-17; Cn 13,22; Lc 12,16-21",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:49:58.983Z",
      "updatedAt": "2025-09-03T02:49:58.983Z",
      "targetId": "dd787ef3-2b2a-462b-aa2e-119cef84b8ee",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "7ad888fa-981d-43e2-b5ef-0890d16f140e",
      "content": "HR : *Kẻ lấy phần của người khác thì mất phần mình*, nghĩa là mất cả chì lẫn chài. Như vậy ý của bản văn HR có khác với bản Hy-lạp.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 38,
      "endOffset": 38,
      "createdAt": "2025-09-03T02:49:59.204Z",
      "updatedAt": "2025-09-03T02:49:59.204Z",
      "targetId": "4fc4277c-ba24-4566-b5ad-42ed1ae7b68b",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "1cc82a43-4f67-49db-9033-871356fda14a",
      "content": "Cn 11,17",
      "kind": "MARK_KIND_REFERENCE",
      "label": "4@",
      "sortOrder": 3,
      "startOffset": 19,
      "endOffset": 19,
      "createdAt": "2025-09-03T02:49:59.062Z",
      "updatedAt": "2025-09-03T02:49:59.062Z",
      "targetId": "64c808f1-5d91-4c66-98d2-ef18f31704ac",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "6635eb1f-68ce-480e-b4de-255f3979f51a",
      "content": "*Mắt xấu xa* là dịch sát chữ Híp-ri. Ý nói về kẻ tham lam keo kiệt thì bủn xỉn trong chuyện ăn uống. HR thêm : “Con mắt tốt, gia tăng bánh, và từ nguồn khô cạn làm cho nước trào lên trên bàn ăn.”",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 33,
      "endOffset": 33,
      "createdAt": "2025-09-03T02:49:59.246Z",
      "updatedAt": "2025-09-03T02:49:59.246Z",
      "targetId": "8bb06f31-d612-4dc1-a912-df15342b3522",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "2b3a8fee-eabd-437b-8b9f-4a5234a4c110",
      "content": "Kn 6,23",
      "kind": "MARK_KIND_REFERENCE",
      "label": "5@",
      "sortOrder": 4,
      "startOffset": 6,
      "endOffset": 6,
      "createdAt": "2025-09-03T02:49:59.176Z",
      "updatedAt": "2025-09-03T02:49:59.176Z",
      "targetId": "7d19122f-7c38-4629-aea9-70dd18d49057",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "f20f3bcf-2cfb-4b51-bd02-2322ce4ad166",
      "content": "*Ngày hẹn của âm phủ* : ngày ấn định cho người ta phải chết (x. Is 28,15.18).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "5",
      "sortOrder": 4,
      "startOffset": 41,
      "endOffset": 41,
      "createdAt": "2025-09-03T02:49:59.316Z",
      "updatedAt": "2025-09-03T02:49:59.316Z",
      "targetId": "f77a8f22-8131-4ba0-b9e8-1185b889d2cd",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "f0fdeacf-614b-4de0-aac3-ff162a7a3f70",
      "content": "Ds 16,33",
      "kind": "MARK_KIND_REFERENCE",
      "label": "6@",
      "sortOrder": 5,
      "startOffset": 16,
      "endOffset": 16,
      "createdAt": "2025-09-03T02:49:59.330Z",
      "updatedAt": "2025-09-03T02:49:59.330Z",
      "targetId": "f77a8f22-8131-4ba0-b9e8-1185b889d2cd",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "c7447629-d2b7-4ce0-9583-8f4bb05d0716",
      "content": "Theo quan niệm cổ truyền, con người xuống cõi âm ty không còn sinh hoạt gì nữa, nên chẳng vui chẳng khổ.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "6",
      "sortOrder": 5,
      "startOffset": 41,
      "endOffset": 41,
      "createdAt": "2025-09-03T02:49:59.487Z",
      "updatedAt": "2025-09-03T02:49:59.487Z",
      "targetId": "3e8b9909-89eb-48e5-89b0-826dc4c8c7c2",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "48c2e88c-e75e-410c-81be-a406d2f5fed4",
      "content": "Gv 2,24",
      "kind": "MARK_KIND_REFERENCE",
      "label": "7@",
      "sortOrder": 6,
      "startOffset": 19,
      "endOffset": 19,
      "createdAt": "2025-09-03T02:49:59.385Z",
      "updatedAt": "2025-09-03T02:49:59.385Z",
      "targetId": "dfb974c2-4956-4947-ab4b-d13ef7f5bd34",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "b06e3f12-b481-426b-b66e-35e1c2566465",
      "content": "HR : *Mọi việc con người làm đều hư nát, và công trình tay nó sẽ đi theo nó* đến chỗ hư nát. Tư tưởng này làm cho tác giả sách Gv ngạc nhiên và vấp ngã, thì ở đây ông Ben Xi-ra chỉ coi là bài học để dè chừng.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "7",
      "sortOrder": 6,
      "startOffset": 42,
      "endOffset": 42,
      "createdAt": "2025-09-03T02:49:59.641Z",
      "updatedAt": "2025-09-03T02:49:59.641Z",
      "targetId": "943431d1-797b-4bf5-b356-77a7154adc54",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "a3bad7cb-df20-485a-9fcf-895e4bcc835d",
      "content": "Gv 9,10",
      "kind": "MARK_KIND_REFERENCE",
      "label": "8@",
      "sortOrder": 7,
      "startOffset": 9,
      "endOffset": 9,
      "createdAt": "2025-09-03T02:49:59.501Z",
      "updatedAt": "2025-09-03T02:49:59.501Z",
      "targetId": "3e8b9909-89eb-48e5-89b0-826dc4c8c7c2",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "74550e31-57b6-4079-a607-1e045f576bfd",
      "content": "Trong khi Tv 119 (nhất là cc. 15.23.148) nói về hạnh phúc do suy gẫm Luật Chúa, thì ở đây nhấn đến việc tìm kiếm khôn ngoan qua các châm ngôn và ngạn ngữ.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "8",
      "sortOrder": 7,
      "startOffset": 36,
      "endOffset": 36,
      "createdAt": "2025-09-03T02:49:59.738Z",
      "updatedAt": "2025-09-03T02:49:59.738Z",
      "targetId": "432899b8-0577-4d72-bd03-9b5e2b4caca5",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "470c53e2-7dc2-4257-84f2-c1d824817d08",
      "content": "Gv 1,4",
      "kind": "MARK_KIND_REFERENCE",
      "label": "9@",
      "sortOrder": 8,
      "startOffset": 8,
      "endOffset": 8,
      "createdAt": "2025-09-03T02:49:59.571Z",
      "updatedAt": "2025-09-03T02:49:59.571Z",
      "targetId": "44130578-7114-40bf-9485-8677c934da2d",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "b79e6a48-f0ee-4853-b3d6-93027c83776b",
      "content": "Để dựng lều sát cạnh khôn ngoan. Hình ảnh có thể làm ta liên tưởng đến việc Lời của Thiên Chúa cắm lều giữa chúng ta (x. Ga 1,14).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "9",
      "sortOrder": 8,
      "startOffset": 22,
      "endOffset": 22,
      "createdAt": "2025-09-03T02:49:59.836Z",
      "updatedAt": "2025-09-03T02:49:59.836Z",
      "targetId": "a846c4bc-b6a3-4079-9d98-2130fc04ccf3",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "db5d679d-ef01-4eb1-bbbd-c1e2a7ebc282",
      "content": "Gv 9,6",
      "kind": "MARK_KIND_REFERENCE",
      "label": "10@",
      "sortOrder": 9,
      "startOffset": 31,
      "endOffset": 31,
      "createdAt": "2025-09-03T02:49:59.613Z",
      "updatedAt": "2025-09-03T02:49:59.613Z",
      "targetId": "34a30066-f1aa-4acd-bbc4-526c434ed714",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ff7bdd24-c137-4ab8-9234-970e6c97ad2a"
    },
    {
      "id": "81aa7c5a-44de-487f-ba4d-8448c24d0247",
      "content": "*Trong vinh quang* (HR : *Dưới sự che chở*) có lẽ ám chỉ đám mây (š•Kinà) biểu hiệu sự Thiên Chúa hiện diện, được nói tới trong các tác phẩm của các thầy Ráp-bi (x. Xh 16,10 ; 24,16 ; Ed 1,28).",
