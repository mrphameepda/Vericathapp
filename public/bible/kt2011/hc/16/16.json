      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "c64ed242-9e33-4cd0-8dd5-0da83a823989",
      "content": "Ds 11,1; 16,1-30",
      "kind": "MARK_KIND_REFERENCE",
      "label": "4@",
      "sortOrder": 3,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:50:12.844Z",
      "updatedAt": "2025-09-03T02:50:12.844Z",
      "targetId": "0cbaf97c-57cb-4a0c-8436-82eb538feffa",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "28de7e2d-3023-43f5-af36-8c09989b47e1",
      "content": "Có ý nói đến dân cư Ca-na-an xưa, nổi tiếng về những việc phụng tự phồn thực ghê tởm của họ (x. Xh 23,33 ; 34,11-16 ; Đnl 7,11-12 ; Ds 33,51-56).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 41,
      "endOffset": 41,
      "createdAt": "2025-09-03T02:50:13.017Z",
      "updatedAt": "2025-09-03T02:50:13.017Z",
      "targetId": "eeec7dd5-829a-4f14-b65f-1209eaa599a1",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "af0d42f5-52ef-4ab0-aeba-ab12e5a79f38",
      "content": "St 6,1-7",
      "kind": "MARK_KIND_REFERENCE",
      "label": "5@",
      "sortOrder": 4,
      "startOffset": 30,
      "endOffset": 30,
      "createdAt": "2025-09-03T02:50:12.901Z",
      "updatedAt": "2025-09-03T02:50:12.901Z",
      "targetId": "aee64aac-48dd-4f93-b016-acfac1c77e4c",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "4e707019-908f-4347-ab70-cd3053ad6e11",
      "content": "HR : *Ai thi hành công chính, thì được lãnh lương*.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "5",
      "sortOrder": 4,
      "startOffset": 40,
      "endOffset": 40,
      "createdAt": "2025-09-03T02:50:13.225Z",
      "updatedAt": "2025-09-03T02:50:13.225Z",
      "targetId": "e848b801-a675-472b-838a-e37c3bfe6769",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "c8457871-aa17-471a-b233-6629ea5a9124",
      "content": "St 19,1-29",
      "kind": "MARK_KIND_REFERENCE",
      "label": "6@",
      "sortOrder": 5,
      "startOffset": 42,
      "endOffset": 42,
      "createdAt": "2025-09-03T02:50:12.957Z",
      "updatedAt": "2025-09-03T02:50:12.957Z",
      "targetId": "1cd8f8e8-e947-4c9e-a2ff-7e9615be6feb",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "b48c0ac3-049a-4572-a692-6e644877d86b",
      "content": "Một số thủ bản thêm : “15 Thiên Chúa làm cho Pha-ra-ô ra cứng lòng để ông không nhận biết Người, ngõ hầu dưới gầm trời người ta biết các hành động của Người. 16 Lòng thương xót của Chúa được biểu lộ cho tất cả tạo thành, và Người phân chia ánh sáng và bóng tối của Người cho con người.”",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "6",
      "sortOrder": 5,
      "startOffset": 47,
      "endOffset": 47,
      "createdAt": "2025-09-03T02:50:13.250Z",
      "updatedAt": "2025-09-03T02:50:13.250Z",
      "targetId": "bf68a7d5-2c7e-4da1-aa28-bce3fc21450c",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "0f0ac72c-f337-41bd-a000-cb1ee0f98e0c",
      "content": "Hc 46,8; Xh 12,37",
      "kind": "MARK_KIND_REFERENCE",
      "label": "7@",
      "sortOrder": 6,
      "startOffset": 9,
      "endOffset": 9,
      "createdAt": "2025-09-03T02:50:13.045Z",
      "updatedAt": "2025-09-03T02:50:13.045Z",
      "targetId": "bcb35416-abe5-411d-816b-b3aa41ce2d24",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "c36af12c-9ac4-45b5-aead-632231cfb546",
      "content": "Thời nguyên thuỷ, hai ông A-đam và Ca-in đã tìm cách núp ẩn khuất mắt Thiên Chúa (St 3,10 ; 4,9).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "7",
      "sortOrder": 6,
      "startOffset": 50,
      "endOffset": 50,
      "createdAt": "2025-09-03T02:50:13.344Z",
      "updatedAt": "2025-09-03T02:50:13.344Z",
      "targetId": "b9c24124-83e0-4800-9669-ab15fb5cac57",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "6f5246a5-077b-474e-ae48-2025600c79f7",
      "content": "Hc 5,6",
      "kind": "MARK_KIND_REFERENCE",
      "label": "8@",
      "sortOrder": 7,
      "startOffset": 10,
      "endOffset": 10,
      "createdAt": "2025-09-03T02:50:13.130Z",
      "updatedAt": "2025-09-03T02:50:13.130Z",
      "targetId": "4110789d-af76-4f41-9133-5b10e2811111",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "00231a14-21e8-4a1d-98e8-2b0084fc6490",
      "content": "Không ai thoát khỏi cuộc viếng thăm uy nghi và đáng sợ của Thiên Chúa, nên phải luôn luôn sẵn sàng. Một số thủ bản Hy-lạp thêm : “Cả hoàn vũ đã được tạo dựng và đang hiện hữu là do ý Người muốn.”",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "8",
      "sortOrder": 7,
      "startOffset": 56,
      "endOffset": 56,
      "createdAt": "2025-09-03T02:50:13.390Z",
      "updatedAt": "2025-09-03T02:50:13.390Z",
      "targetId": "7bc8e0ef-ee63-4cc8-bada-15395b9e0051",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "13101ef1-62c6-4381-b589-d6a5ccec43b2",
      "content": "Xh 34,6-7",
      "kind": "MARK_KIND_REFERENCE",
      "label": "9@",
      "sortOrder": 8,
      "startOffset": 6,
      "endOffset": 6,
      "createdAt": "2025-09-03T02:50:13.161Z",
      "updatedAt": "2025-09-03T02:50:13.161Z",
      "targetId": "02e40944-cccf-464d-82d5-9de4bad1f6b0",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "7b1ccb41-73c3-4afa-bc03-3262485612db",
      "content": "*Ngày hẹn* (ds : *giao ước* x. 14,12). Người đặt vấn nạn xem ra muốn nói : việc thưởng phạt chưa xảy ra và không chắc có xảy ra không ? Một số thủ bản Hy-lạp thêm : “Và cuối cùng sẽ xảy ra việc xét xử mọi sự.”",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "9",
      "sortOrder": 8,
      "startOffset": 48,
      "endOffset": 48,
      "createdAt": "2025-09-03T02:50:13.547Z",
      "updatedAt": "2025-09-03T02:50:13.547Z",
      "targetId": "a287ed95-915d-44cb-99e0-1363627b10b2",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "db8870ef-7fe4-4ab4-9a0f-b8cd5d39d1fc",
      "content": "Tv 139,7-12; Gr 23,24; Am 9,2-3",
      "kind": "MARK_KIND_REFERENCE",
      "label": "10@",
      "sortOrder": 9,
      "startOffset": 19,
      "endOffset": 19,
      "createdAt": "2025-09-03T02:50:13.290Z",
      "updatedAt": "2025-09-03T02:50:13.290Z",
      "targetId": "c6329957-8292-4a20-b19b-cfd20a205ce3",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "9cbcd6c4-e6f5-4f9f-8da2-69e3452f79fe",
      "content": "Không phải đức khôn ngoan tiếp tục nói, mà là tác giả.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "10",
      "sortOrder": 9,
      "startOffset": 25,
      "endOffset": 25,
      "createdAt": "2025-09-03T02:50:13.631Z",
      "updatedAt": "2025-09-03T02:50:13.631Z",
      "targetId": "805b834e-2c1a-4ebb-81e4-65f7990fec4d",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "3e73081b-fafd-4f7d-a681-2aa433e79410",
      "content": "G 37,1-7; Tv 18,8",
      "kind": "MARK_KIND_REFERENCE",
      "label": "11@",
      "sortOrder": 10,
      "startOffset": 10,
      "endOffset": 10,
      "createdAt": "2025-09-03T02:50:13.431Z",
      "updatedAt": "2025-09-03T02:50:13.431Z",
      "targetId": "27b23c71-e6a8-4037-b70f-06eb3dcff20d",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "0026a565-db66-4773-887e-f8928ab25b13",
      "content": "*Theo quyết định* theo Hy-lạp. HR : *Khi tạo dựng*.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "11",
      "sortOrder": 10,
      "startOffset": 45,
      "endOffset": 45,
      "createdAt": "2025-09-03T02:50:13.713Z",
      "updatedAt": "2025-09-03T02:50:13.713Z",
      "targetId": "2920d9d3-60da-4b68-a7f3-b634da9134b0",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "f4fe485a-4c1b-4cf1-a211-5df7c67446e8",
      "content": "Rm 11,33",
      "kind": "MARK_KIND_REFERENCE",
      "label": "12@",
      "sortOrder": 11,
      "startOffset": 29,
      "endOffset": 29,
      "createdAt": "2025-09-03T02:50:13.504Z",
      "updatedAt": "2025-09-03T02:50:13.504Z",
      "targetId": "63edf342-efa8-422f-a315-e9370c03aa4e",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "f3afd5f4-a707-4b16-95c7-16f3ec07fe22",
      "content": "Ý nói đến sự vận chuyển đều đặn của các tinh tú trên trời theo như Thiên Chúa đã quy định (x. Tv 104,19 ; 148,5-6).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "12",
      "sortOrder": 11,
      "startOffset": 47,
      "endOffset": 47,
      "createdAt": "2025-09-03T02:50:13.850Z",
