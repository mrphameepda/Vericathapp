    },
    {
      "id": "44947976-2ee2-4746-ab86-76d576160411",
      "content": "English: Lot | French: Loth | Latin: Lot | Origin: &#1500;&#64331;&#1496; | Vietnamese: Lót -- St 11,27.31",
      "kind": "MARK_KIND_FOOTNOTE",
