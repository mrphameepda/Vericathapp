{
  "chapter": {
    "id": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7",
    "number": 16,
    "createdAt": "2025-09-03T01:07:51.705Z",
    "updatedAt": "2025-09-03T01:07:51.705Z",
    "bookId": "5c66a463-0bfa-46b7-9af1-3766a8779b73"
  },
  "verses": [
    {
      "id": "18e3f93e-d39c-4f9d-be66-441c59b5893f",
      "text": "Con đàn cháu đống mà vô dụng, con đừng ham,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:12.600Z",
      "updatedAt": "2025-09-03T02:50:12.600Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "fe4a9a0e-7f3d-45f5-a1f7-d797c34d5cf4",
      "text": "cũng đừng vui vì lũ con bất nhân bất nghĩa.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:12.632Z",
      "updatedAt": "2025-09-03T02:50:12.632Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "92da7650-d121-4a7d-870f-633d63ea6859",
      "text": "Chúng có đông đảo mấy, con cũng đừng vui,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:12.642Z",
      "updatedAt": "2025-09-03T02:50:12.642Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "a2cfd855-8fea-47ec-a2cd-aaf76f66bdfb",
      "text": "nếu chúng không có lòng kính sợ Đức Chúa.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:12.653Z",
      "updatedAt": "2025-09-03T02:50:12.653Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "7c52796b-445c-4f6b-8093-47163fcf5724",
      "text": "Chúng có làm nên sự nghiệp ở đời, con đừng tin tưởng,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:12.664Z",
      "updatedAt": "2025-09-03T02:50:12.664Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "58fc0132-f871-4473-b0ad-78277980207e",
      "text": "có đông con nhiều cháu, con cũng chớ trông nhờ ;",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:12.675Z",
      "updatedAt": "2025-09-03T02:50:12.675Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "8ff90b2a-8adc-47ed-8fb2-7073d831d938",
      "text": "vì cả ngàn cũng không bằng một",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:12.689Z",
      "updatedAt": "2025-09-03T02:50:12.689Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "16fbdfdf-ef36-4fae-9c1e-ee8c3b952b4b",
      "text": "và chết mà không con còn hơn có những người con bất nghĩa.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 3,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:12.702Z",
      "updatedAt": "2025-09-03T02:50:12.702Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "9ec8c1e6-17a4-4b6f-b8b0-61e3291cfea8",
      "text": "Nhờ một người thông minh sáng suốt",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:12.746Z",
      "updatedAt": "2025-09-03T02:50:12.746Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "81b80606-1f90-4b28-8b48-69804aa60cc2",
      "text": "mà một thành đông đúc dân cư,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:12.759Z",
      "updatedAt": "2025-09-03T02:50:12.759Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "9696d288-2181-4dd4-9963-0ac377d40ef8",
      "text": "còn giống nòi chẳng kể chi luân thường đạo lý sẽ bị tuyệt diệt.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:12.773Z",
      "updatedAt": "2025-09-03T02:50:12.773Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "36e9550c-b4ce-4333-873e-52b0035edfff",
      "text": "Mắt tôi đã thấy nhiều điều như thế,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:12.816Z",
      "updatedAt": "2025-09-03T02:50:12.816Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "0cbaf97c-57cb-4a0c-8436-82eb538feffa",
      "text": "và tai tôi còn nghe những điều dữ dội hơn.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:12.830Z",
      "updatedAt": "2025-09-03T02:50:12.830Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "eb6bb8ea-0304-441e-9ce8-e8edab5b5ec2",
      "text": "Lửa bừng cháy thiêu đốt đám hội quân tội lỗi,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:12.858Z",
      "updatedAt": "2025-09-03T02:50:12.858Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "c1ddcd6e-ac0f-48b3-944a-734e6db1edf8",
      "text": "cơn Thịnh Nộ bốc lên trừng phạt nòi bất tuân ;",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:12.872Z",
      "updatedAt": "2025-09-03T02:50:12.872Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "aee64aac-48dd-4f93-b016-acfac1c77e4c",
      "text": "vì Người đã không tha cho bọn khổng lồ thuở trước,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:12.886Z",
      "updatedAt": "2025-09-03T02:50:12.886Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "7731e2a7-9d42-4bcb-a500-7a8fb9ac1e47",
      "text": "những kẻ cậy sức mình mà phản loạn.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:12.916Z",
      "updatedAt": "2025-09-03T02:50:12.916Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "1cd8f8e8-e947-4c9e-a2ff-7e9615be6feb",
      "text": "Người đã chẳng buông tha những kẻ cho ông Lót ở nhờ,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:12.929Z",
      "updatedAt": "2025-09-03T02:50:12.929Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "80f82075-1b7a-4add-82f2-6c24046f0d97",
      "text": "những kẻ Người gớm ghét vì chúng kiêu ngạo.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:12.972Z",
      "updatedAt": "2025-09-03T02:50:12.972Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "eb3f63f1-03fb-4817-b86c-06a54e71c844",
      "text": "Người không xót thương giống nòi mang án diệt vong,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:12.985Z",
      "updatedAt": "2025-09-03T02:50:12.985Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "eeec7dd5-829a-4f14-b65f-1209eaa599a1",
      "text": "những kẻ bị loại trừ vì tội lỗi của chúng,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:12.999Z",
      "updatedAt": "2025-09-03T02:50:12.999Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "bcb35416-abe5-411d-816b-b3aa41ce2d24",
      "text": "cũng như sáu trăm ngàn bộ binh,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.031Z",
      "updatedAt": "2025-09-03T02:50:13.031Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "cdde006c-d84b-47b5-b8c6-141afea91aa3",
      "text": "những kẻ cứng lòng cùng nhau cấu kết.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.058Z",
      "updatedAt": "2025-09-03T02:50:13.058Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "0a48e45c-bf05-4f8e-97c5-c1018bfdc728",
      "text": "Dầu chỉ có một người cứng cổ không bị phạt,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.072Z",
      "updatedAt": "2025-09-03T02:50:13.072Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "4c2d75a7-b7c2-4455-a370-9a04b660b558",
      "text": "thì đó cũng là điều lạ lùng ;",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.086Z",
      "updatedAt": "2025-09-03T02:50:13.086Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "1d1ea200-9aab-48ef-9a07-d42a45bf7b07",
      "text": "vì Người thương xót, Người cũng nổi cơn thịnh nộ,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.101Z",
      "updatedAt": "2025-09-03T02:50:13.101Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "4110789d-af76-4f41-9133-5b10e2811111",
      "text": "rộng lòng tha thứ, nhưng cũng trút cơn lôi đình.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 3,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.115Z",
      "updatedAt": "2025-09-03T02:50:13.115Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "02e40944-cccf-464d-82d5-9de4bad1f6b0",
      "text": "Người thương xót bao nhiêu, thì cũng hạch tội bấy nhiêu :",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.144Z",
      "updatedAt": "2025-09-03T02:50:13.144Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "6077529f-d421-4314-aecb-a4ae10f57da9",
      "text": "Người xét xử ai nấy tuỳ theo việc họ làm.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.177Z",
      "updatedAt": "2025-09-03T02:50:13.177Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "35f1487a-23d8-4f09-85da-665fc76d2af4",
      "text": "Kẻ tội lỗi không thoát nổi với của gian đã cướp,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.189Z",
      "updatedAt": "2025-09-03T02:50:13.189Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "c97b6d46-023d-44db-8400-554318ad40ed",
      "text": "và người đạo hạnh kiên nhẫn đợi chờ sẽ chẳng luống công.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.201Z",
      "updatedAt": "2025-09-03T02:50:13.201Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "e848b801-a675-472b-838a-e37c3bfe6769",
      "text": "Việc bố thí nào cũng được Chúa ân thưởng,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.213Z",
      "updatedAt": "2025-09-03T02:50:13.213Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "bf68a7d5-2c7e-4da1-aa28-bce3fc21450c",
      "text": "và mỗi người cứ theo việc mình làm mà lãnh nhận.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.237Z",
      "updatedAt": "2025-09-03T02:50:13.237Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "c6329957-8292-4a20-b19b-cfd20a205ce3",
      "text": "Đừng nói : “Tôi sẽ núp ẩn không cho Đức Chúa thấy !",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.264Z",
      "updatedAt": "2025-09-03T02:50:13.264Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "9aa2cf8f-79c7-46a7-8d06-52e7ae14bb02",
      "text": "Từ chốn cao xanh, ai nào nhớ đến tôi ?",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.303Z",
      "updatedAt": "2025-09-03T02:50:13.303Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "c960f431-503c-441f-8850-043895c19548",
      "text": "Giữa đám đông dân chúng, chẳng ai nhận ra tôi,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 2,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.317Z",
      "updatedAt": "2025-09-03T02:50:13.317Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "b9c24124-83e0-4800-9669-ab15fb5cac57",
      "text": "vì tôi là gì giữa cõi tạo thành bao la bát ngát ?”",
      "label": "17",
      "number": 17,
      "subVerseIndex": 3,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.330Z",
      "updatedAt": "2025-09-03T02:50:13.330Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "ff92d347-5bf3-472b-898e-6fee0e8c46ce",
      "text": "Kìa, trời cao thẳm trùng trùng điệp điệp,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.363Z",
      "updatedAt": "2025-09-03T02:50:13.363Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "7bc8e0ef-ee63-4cc8-bada-15395b9e0051",
      "text": "vực sâu và trái đất rung chuyển khi Người đến viếng thăm ;",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.377Z",
      "updatedAt": "2025-09-03T02:50:13.377Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "2367fbe6-9256-4977-9441-51f0175d5849",
      "text": "đồng thời khi Người nhìn núi non và nền trái đất,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.404Z",
      "updatedAt": "2025-09-03T02:50:13.404Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "27b23c71-e6a8-4037-b70f-06eb3dcff20d",
      "text": "chúng đều run rẩy kinh hoàng.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.417Z",
      "updatedAt": "2025-09-03T02:50:13.417Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "82742597-5be7-4a04-9781-58c4bd12f45e",
      "text": "Vậy mà người ta chẳng để tâm nghĩ tới những điều ấy,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.445Z",
      "updatedAt": "2025-09-03T02:50:13.445Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "0b129da5-1264-44bc-85c2-96c5e9a73c09",
      "text": "ai nào suy tưởng về đường lối của Người ?",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.459Z",
      "updatedAt": "2025-09-03T02:50:13.459Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "80013f68-18a7-4a1c-9ce3-9f05afc580ce",
      "text": "Bão táp, con người không nhìn thấy,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.476Z",
      "updatedAt": "2025-09-03T02:50:13.476Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "63edf342-efa8-422f-a315-e9370c03aa4e",
      "text": "đa số các việc Người làm đều bí ẩn.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.490Z",
      "updatedAt": "2025-09-03T02:50:13.490Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "a3cdaa17-4708-403c-b627-2e7ec1ec82e6",
      "text": "“Việc xét xử công minh, có ai công bố đâu ?",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.518Z",
      "updatedAt": "2025-09-03T02:50:13.518Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "a287ed95-915d-44cb-99e0-1363627b10b2",
      "text": "Ai chờ đợi việc ấy ? Vì còn lâu mới đến ngày hẹn.”",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.533Z",
      "updatedAt": "2025-09-03T02:50:13.533Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "672747d1-706a-4200-af4a-7ea9218462dc",
      "text": "Người thiếu hiểu biết thì nghĩ những điều như thế,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.560Z",
      "updatedAt": "2025-09-03T02:50:13.560Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "df670a90-5390-4c07-b315-2bb86c76da77",
      "text": "kẻ điên dại và lầm lạc nghĩ toàn chuyện ngu si.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.574Z",
      "updatedAt": "2025-09-03T02:50:13.574Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "6ac2c6a8-01fd-4f5e-9f18-bca1c3532d63",
      "text": "Con ơi, hãy nghe ta, hãy học cho biết,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.589Z",
      "updatedAt": "2025-09-03T02:50:13.589Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "805b834e-2c1a-4ebb-81e4-65f7990fec4d",
      "text": "và để tâm suy nghĩ lời ta.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.616Z",
      "updatedAt": "2025-09-03T02:50:13.616Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "ae8ec69a-7e24-4ced-a336-cd371f1da1f2",
      "text": "Ta sẽ tuần tự trình bày kiến thức,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.658Z",
      "updatedAt": "2025-09-03T02:50:13.658Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "0f372b57-822b-4447-842d-9ff337e231a8",
      "text": "và công bố sự hiểu biết một cách tinh tường.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.672Z",
      "updatedAt": "2025-09-03T02:50:13.672Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "684e8159-ade6-4869-9169-0e5db5e86b4e",
      "text": "Theo quyết định của Đức Chúa,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.686Z",
      "updatedAt": "2025-09-03T02:50:13.686Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "2920d9d3-60da-4b68-a7f3-b634da9134b0",
      "text": "các công trình của Người đã có từ nguyên thuỷ,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.699Z",
      "updatedAt": "2025-09-03T02:50:13.699Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "c118dc38-90cb-4aaf-b96e-ea6a6e654826",
      "text": "và khi làm ra chúng, Người phân thành từng loại.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 2,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.741Z",
      "updatedAt": "2025-09-03T02:50:13.741Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "43292b63-4507-484b-86c8-bfc3d49154ea",
      "text": "Những công trình ấy, Người xếp đặt theo trật tự muôn đời,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.756Z",
      "updatedAt": "2025-09-03T02:50:13.756Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "6c12b404-f058-4b7c-a6ae-1c2cd4bf22d1",
      "text": "từ thuở ban đầu cho đến các thế hệ về sau.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.783Z",
      "updatedAt": "2025-09-03T02:50:13.783Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "e382c01d-8352-4fe4-b189-a83e8deb35d5",
      "text": "Chúng không phải đói cũng không biết mệt,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 2,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.805Z",
      "updatedAt": "2025-09-03T02:50:13.805Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "ab5b0d66-9cf6-4265-8b03-f75ae1c53603",
      "text": "và chẳng bao giờ bỏ lơ công việc chúng phải làm.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 3,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.816Z",
      "updatedAt": "2025-09-03T02:50:13.816Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "05de842a-3471-4cbe-b518-8eca4097028b",
      "text": "Vật này không đụng vào vật khác,",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.827Z",
      "updatedAt": "2025-09-03T02:50:13.827Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "cd3cdaf3-aab8-4b45-aff9-85636f4c0d9d",
      "text": "và cho đến vạn đại, chúng không cưỡng lời Người.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 1,
      "paragraphNumber": 61,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.838Z",
      "updatedAt": "2025-09-03T02:50:13.838Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "313b0f7b-8860-424c-844c-05b910c05251",
      "text": "Sau đó, Đức Chúa nhìn xem trái đất,",
      "label": "29",
      "number": 29,
      "subVerseIndex": 0,
      "paragraphNumber": 62,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.863Z",
      "updatedAt": "2025-09-03T02:50:13.863Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "d0d368b0-4271-4359-aea8-e59116b51927",
      "text": "và ban cho nó đầy dẫy mọi ơn lành.",
      "label": "29",
      "number": 29,
      "subVerseIndex": 1,
      "paragraphNumber": 63,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.877Z",
      "updatedAt": "2025-09-03T02:50:13.877Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "260c1ce1-158b-42be-829f-f17fa317ebe9",
      "text": "Người làm cho sinh vật lan tràn mặt đất,",
      "label": "30",
      "number": 30,
      "subVerseIndex": 0,
      "paragraphNumber": 64,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.890Z",
      "updatedAt": "2025-09-03T02:50:13.890Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    },
    {
      "id": "4200c9d9-a9fd-4f61-bc02-2303f1d2676d",
      "text": "và chúng sẽ phải trở về đất.",
      "label": "30",
      "number": 30,
      "subVerseIndex": 1,
      "paragraphNumber": 65,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:13.918Z",
      "updatedAt": "2025-09-03T02:50:13.918Z",
      "chapterId": "8c9e767d-4d14-46a3-8225-585b0c0cc6d7"
    }
  ],
  "marks": [
    {
      "id": "33a61fdc-b05f-4cae-9965-526cc36754f8",
      "content": "Cn 17,21; 19,13",
      "kind": "MARK_KIND_REFERENCE",
      "label": "1@",
      "sortOrder": 0,
      "startOffset": 21,
