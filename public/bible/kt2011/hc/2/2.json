{
  "chapter": {
    "id": "08d38635-cae3-4cdf-bbb3-792b48f2f858",
    "number": 2,
    "createdAt": "2025-09-03T01:07:51.705Z",
    "updatedAt": "2025-09-03T01:07:51.705Z",
    "bookId": "5c66a463-0bfa-46b7-9af1-3766a8779b73"
  },
  "verses": [
    {
      "id": "1d471479-45ee-4a42-8227-b71f1529da59",
      "text": "Con ơi, nếu con muốn dấn thân phụng sự Đức Chúa,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:38.077Z",
      "updatedAt": "2025-09-03T02:48:38.077Z",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
    {
      "id": "8bc0fec0-663b-442d-8d73-01664c3a4e37",
      "text": "thì con hãy chuẩn bị tâm hồn để đón chịu thử thách.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:38.119Z",
      "updatedAt": "2025-09-03T02:48:38.119Z",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
    {
      "id": "d4cc669c-bbd2-4ecb-ae6c-088213ace720",
      "text": "Hãy giữ lòng cho ngay thẳng và cứ kiên trì,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:38.142Z",
      "updatedAt": "2025-09-03T02:48:38.142Z",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
    {
      "id": "d5ec1494-eb4c-4b08-83ff-7e1d014b6e36",
      "text": "đừng bấn loạn khi con gặp khốn khổ.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:38.155Z",
      "updatedAt": "2025-09-03T02:48:38.155Z",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
    {
      "id": "ef8a2b2c-9fcc-41c4-b770-5c137f049d2c",
      "text": "Hãy bám lấy Người chứ đừng lìa bỏ,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:38.169Z",
      "updatedAt": "2025-09-03T02:48:38.169Z",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
    {
      "id": "828c1c3d-1438-45c7-8083-8a723783bd2f",
      "text": "để cuối đời, con được cất nhắc lên.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:38.184Z",
      "updatedAt": "2025-09-03T02:48:38.184Z",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
    {
      "id": "044be609-8a17-47d8-b43c-b7cddf0219f6",
      "text": "Mọi chuyện xảy đến cho con, con hãy chấp nhận,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:38.198Z",
      "updatedAt": "2025-09-03T02:48:38.198Z",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
    {
      "id": "d6c967aa-7ca8-4e1b-b9d8-7dd945b03d57",
      "text": "và trải qua bao thăng trầm, con hãy cứ kiên nhẫn.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:38.211Z",
      "updatedAt": "2025-09-03T02:48:38.211Z",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
    {
      "id": "9bb0070a-a587-49b2-a230-43d4db34f9f1",
      "text": "Vì vàng phải được tôi luyện trong lửa,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:38.225Z",
      "updatedAt": "2025-09-03T02:48:38.225Z",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
    {
      "id": "300dad55-1fe4-410a-b2d4-82b6eb00f4fa",
      "text": "còn những người sáng giá",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:38.239Z",
      "updatedAt": "2025-09-03T02:48:38.239Z",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
    {
      "id": "b027f16d-7b67-4e02-8e9b-ba851176c568",
      "text": "thì phải được thử trong lò ô nhục.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:38.253Z",
      "updatedAt": "2025-09-03T02:48:38.253Z",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
    {
      "id": "8066a394-e23b-4f38-b2a9-f50eede6eb71",
      "text": "Hãy tin vào Người, thì Người sẽ nâng đỡ con.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:38.267Z",
      "updatedAt": "2025-09-03T02:48:38.267Z",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
    {
      "id": "f6969ad3-bd3e-41e9-8935-b22673348af8",
      "text": "Đường con đi, hãy giữ cho ngay thẳng và trông cậy vào Người.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:38.296Z",
      "updatedAt": "2025-09-03T02:48:38.296Z",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
    {
      "id": "34c2e3fe-b418-4b1a-bf33-51b0c809930b",
      "text": "Hỡi ai kính sợ Đức Chúa,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:38.309Z",
      "updatedAt": "2025-09-03T02:48:38.309Z",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
    {
      "id": "8adbd411-c3cc-4622-9591-66444b0f5ae0",
      "text": "hãy trông đợi lòng lân tuất của Người,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:38.323Z",
      "updatedAt": "2025-09-03T02:48:38.323Z",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
    {
      "id": "52e7d4d1-ab75-46c1-8ad7-60a55815cf4e",
      "text": "đừng lìa xa Người kẻo ngã.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:38.337Z",
      "updatedAt": "2025-09-03T02:48:38.337Z",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
    {
      "id": "76dfb922-9a8f-4079-8fb8-324478d89403",
      "text": "Hỡi ai kính sợ Đức Chúa, hãy tin vào Người,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:38.352Z",
      "updatedAt": "2025-09-03T02:48:38.352Z",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
    {
      "id": "9e9b12e3-8a08-43f7-a867-8323c7423a7f",
      "text": "và các bạn sẽ không mất phần thưởng đâu.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:38.366Z",
      "updatedAt": "2025-09-03T02:48:38.366Z",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
    {
      "id": "94aa2272-d7bc-4518-bca2-a72dcd2daae7",
      "text": "Hỡi ai kính sợ Đức Chúa, hãy đợi trông ơn lành,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:38.380Z",
      "updatedAt": "2025-09-03T02:48:38.380Z",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
    {
      "id": "b4d9770a-5035-4fc2-9746-cac9acf6cc00",
      "text": "niềm vui khôn cùng và lòng thương xót.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:38.397Z",
      "updatedAt": "2025-09-03T02:48:38.397Z",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
    {
      "id": "18b756e7-6f5e-4319-b681-72f3a91c5dda",
      "text": "Hãy nhìn lại các thế hệ ban đầu mà xem :",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:38.411Z",
      "updatedAt": "2025-09-03T02:48:38.411Z",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
    {
      "id": "75069d82-8b4a-4b2a-9bbf-281bf51bd9e3",
      "text": "nào có ai tin vào Đức Chúa mà bị hổ thẹn bao giờ ?",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:38.425Z",
      "updatedAt": "2025-09-03T02:48:38.425Z",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
    {
      "id": "f28a8bb8-7d5c-494d-853e-3adfce06bf30",
      "text": "Hay có ai bền tâm kính sợ Người mà bị bỏ rơi ?",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:38.440Z",
      "updatedAt": "2025-09-03T02:48:38.440Z",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
    {
      "id": "f64268a0-f6fa-4323-8232-70c31898cc72",
      "text": "Hoặc có ai kêu cầu Người mà bị Người khinh dể ?",
      "label": "10",
      "number": 10,
      "subVerseIndex": 3,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:38.467Z",
      "updatedAt": "2025-09-03T02:48:38.467Z",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
    {
      "id": "1015f0cf-a6d3-4cd1-a513-5ab679d48ab7",
      "text": "Vì Đức Chúa là Đấng nhân từ và hay thương xót :",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:38.481Z",
      "updatedAt": "2025-09-03T02:48:38.481Z",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
    {
      "id": "f2ee476a-a0d6-485a-bcdc-e5384e8854cb",
      "text": "Người thứ tha tội lỗi và cứu vớt trong lúc gian truân.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:38.509Z",
      "updatedAt": "2025-09-03T02:48:38.509Z",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
    {
      "id": "d66c64dc-bc2e-42b9-bc03-1ad0ef419a25",
      "text": "Khốn thay những tâm hồn hèn nhát, những bàn tay rã rời,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:38.523Z",
      "updatedAt": "2025-09-03T02:48:38.523Z",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
    {
      "id": "3a9285f2-98fa-41e0-9660-7d5ab56ba155",
      "text": "và người tội lỗi lập lờ nước đôi.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:38.537Z",
      "updatedAt": "2025-09-03T02:48:38.537Z",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
    {
      "id": "1eed9e5b-ed6c-458a-9d9b-866e608de213",
      "text": "Khốn thay quả tim nao núng vì không tin tưởng :",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:38.565Z",
      "updatedAt": "2025-09-03T02:48:38.565Z",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
    {
      "id": "7653f546-291a-40e7-8053-5565d9255c10",
      "text": "chính vì vậy nó không được chở che.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:38.579Z",
      "updatedAt": "2025-09-03T02:48:38.579Z",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
    {
      "id": "788d1efe-ff1b-49ed-ba16-3726da984fd0",
      "text": "Khốn cho các ngươi, những kẻ mất kiên nhẫn,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:38.593Z",
      "updatedAt": "2025-09-03T02:48:38.593Z",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
    {
      "id": "c1fde002-d501-43f8-a704-b586de3d1aea",
      "text": "các ngươi sẽ làm gì khi Đức Chúa đến thăm ?",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:38.607Z",
      "updatedAt": "2025-09-03T02:48:38.607Z",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
    {
      "id": "c1638aaf-e686-40bb-be93-c83b6d233285",
      "text": "Những ai kính sợ Đức Chúa",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:38.620Z",
      "updatedAt": "2025-09-03T02:48:38.620Z",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
    {
      "id": "50b11a35-b23d-427f-ac68-f42c65e9ab7a",
      "text": "thì không ngang bướng bất tuân lời Người dạy,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:38.634Z",
      "updatedAt": "2025-09-03T02:48:38.634Z",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
    {
      "id": "a4289d1c-3add-4da4-9bcb-dd81c4055149",
      "text": "và những ai kính mến Người thì giữ vững đường lối của Người.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 2,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:38.648Z",
      "updatedAt": "2025-09-03T02:48:38.648Z",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
    {
      "id": "8a035e63-2c77-4c82-b175-69577bc4d4af",
      "text": "Những ai kính sợ Đức Chúa thì tìm điều Người ưa thích,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:38.676Z",
      "updatedAt": "2025-09-03T02:48:38.676Z",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
    {
      "id": "8abfcdba-ba4e-4626-972a-efc2a6fb76e8",
      "text": "và những ai kính mến Người thì no thoả Lề Luật.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:38.689Z",
      "updatedAt": "2025-09-03T02:48:38.689Z",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
    {
      "id": "30041203-7b46-49b9-b744-ec431637a9d1",
      "text": "Những ai kính sợ Đức Chúa thì chuẩn bị tâm hồn,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:38.717Z",
      "updatedAt": "2025-09-03T02:48:38.717Z",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
    {
      "id": "60d835c6-4ebf-4d92-a365-b44a92719d84",
      "text": "và hạ mình xuống trước mặt Người.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:38.731Z",
      "updatedAt": "2025-09-03T02:48:38.731Z",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
    {
      "id": "ffd062ad-d278-42dc-8ea9-93d56c1eb9f2",
      "text": "Chúng ta hãy phó mình trong tay Đức Chúa,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:38.746Z",
      "updatedAt": "2025-09-03T02:48:38.746Z",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
    {
      "id": "8d1b44b4-fcfa-4b12-aac2-d53ec86a1e90",
      "text": "chứ đừng phó mình trong tay phàm nhân,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:38.773Z",
      "updatedAt": "2025-09-03T02:48:38.773Z",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
    {
      "id": "2f327da9-9069-4712-b55e-25d2cf6a9e5a",
      "text": "bởi vì Người cao cả thế nào",
      "label": "18",
      "number": 18,
      "subVerseIndex": 2,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:38.787Z",
      "updatedAt": "2025-09-03T02:48:38.787Z",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
    {
      "id": "9a689708-0baa-4292-bf7b-1cfb33041229",
      "text": "thì cũng lân tuất như vậy.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 3,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:38.801Z",
      "updatedAt": "2025-09-03T02:48:38.801Z",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    }
  ],
  "marks": [
    {
      "id": "3f834f76-dc24-469a-baac-083884885618",
      "content": "Đề tài muôn thuở thường thấy trong Cựu Ước, nhất là trong các Tv. Nhưng hoàn cảnh cụ thể của những lời khuyên trong chương này là vào đầu thế kỷ II tCN, trước khi xảy ra cuộc khủng bố người Do-thái của vua An-ti-ô-khô Ê-pi-pha-nê (2 Mcb 1,2-4.12-15).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 43,
      "endOffset": 43,
      "createdAt": "2025-09-03T02:48:38.105Z",
      "updatedAt": "2025-09-03T02:48:38.105Z",
      "targetId": "ad1aacf4-cbb8-4d67-8c6e-96b8514199e6",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
