    },
    {
      "id": "8e4fe2c4-5ded-40f1-9ad8-68a952a3ccbf",
      "content": "Tác giả muốn kêu gọi phải có lập trường cương quyết và kiên trì phục vụ Thiên Chúa trong cơn bách hại. Ông lên án bội giáo và thái độ xu thời (x. 2 Mcb 6,21-28).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 32,
      "endOffset": 32,
      "createdAt": "2025-09-03T02:48:38.551Z",
      "updatedAt": "2025-09-03T02:48:38.551Z",
      "targetId": "3a9285f2-98fa-41e0-9660-7d5ab56ba155",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
    {
      "id": "af8a79f7-66ee-4d62-adbb-3d310f11e2ee",
      "content": "G 4,7; Tv 22,5-6; 37,25",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 10,
      "endOffset": 10,
      "createdAt": "2025-09-03T02:48:38.453Z",
      "updatedAt": "2025-09-03T02:48:38.453Z",
      "targetId": "f28a8bb8-7d5c-494d-853e-3adfce06bf30",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "08d38635-cae3-4cdf-bbb3-792b48f2f858"
    },
    {
      "id": "5441f949-29d6-46d1-a4b6-963c673b5f4f",
      "content": "Yêu thương và tuân phục không tương phản, nhưng hoà hợp. Yêu không tìm lợi ; có đợi trông phần thưởng chỉ là chuyện phụ. Đây là thái độ tiêu biểu của Hc, nhưng không phải không có trong tư tưởng Do-thái. Trong “Pi-a-kê A-bốt” 1,3 có câu : “Đừng như những nô lệ phục vụ chủ để được thưởng. Hãy như những nô lệ phục vụ chủ mà không nghĩ đến phần thưởng.”",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 46,
      "endOffset": 46,
      "createdAt": "2025-09-03T02:48:38.703Z",
