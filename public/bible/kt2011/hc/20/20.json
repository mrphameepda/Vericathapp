{
  "chapter": {
    "id": "33916c52-cfb2-475c-8f96-682294b01059",
    "number": 20,
    "createdAt": "2025-09-03T01:07:51.705Z",
    "updatedAt": "2025-09-03T01:07:51.705Z",
    "bookId": "5c66a463-0bfa-46b7-9af1-3766a8779b73"
  },
  "verses": [
    {
      "id": "2b0d86df-28b6-462d-82ff-1554eca456a2",
      "text": "Có lời trách mắng không đúng lúc,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:43.381Z",
      "updatedAt": "2025-09-03T02:50:43.381Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "b2704078-753b-405a-a955-b93031898268",
      "text": "có kẻ thinh lặng mà lại biết điều.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:43.409Z",
      "updatedAt": "2025-09-03T02:50:43.409Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "7bb27832-ab9a-4153-b51a-c7228c217b94",
      "text": "Thà trách mắng còn hơn giận dữ.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:43.431Z",
      "updatedAt": "2025-09-03T02:50:43.431Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "ec858636-0163-452f-8898-9fa67cf81254",
      "text": "Người thú tội thì tránh được bao hệ luỵ.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:43.443Z",
      "updatedAt": "2025-09-03T02:50:43.443Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "6d00956a-90fa-44b6-bfae-621283d65045",
      "text": "Kẻ dùng bạo lực mà thi hành lẽ phải,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:43.456Z",
      "updatedAt": "2025-09-03T02:50:43.456Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "3467fe25-56e2-438f-933d-a444a9f0e98e",
      "text": "chẳng khác nào hoạn quan muốn hại đời con gái.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:43.471Z",
      "updatedAt": "2025-09-03T02:50:43.471Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "375a3abf-e3be-47b5-addd-78e834faeb2c",
      "text": "Có kẻ thinh lặng mà được kể là khôn ngoan,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:43.513Z",
      "updatedAt": "2025-09-03T02:50:43.513Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "e01de235-1988-487f-b2e0-cba4fba86256",
      "text": "còn kẻ ba hoa thì đáng ghét.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:43.539Z",
      "updatedAt": "2025-09-03T02:50:43.539Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "da83d8a6-48ee-4514-b633-510a44581130",
      "text": "Có kẻ thinh lặng vì chẳng biết nói chi,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:43.553Z",
      "updatedAt": "2025-09-03T02:50:43.553Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "81ff284d-2b57-4184-b0c5-5457e228c0d7",
      "text": "có kẻ thinh lặng để chờ thời.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:43.567Z",
      "updatedAt": "2025-09-03T02:50:43.567Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "108bbea1-ddb8-46ae-9f90-c40fbcfee881",
      "text": "Người khôn ngoan biết thinh lặng chờ dịp tốt,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:43.595Z",
      "updatedAt": "2025-09-03T02:50:43.595Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "58524bce-68bb-4f7d-b92e-84177bbe5be1",
      "text": "còn kẻ bép xép, dại khờ lại bỏ lỡ cơ may.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:43.610Z",
      "updatedAt": "2025-09-03T02:50:43.610Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "4d6a01d3-b17e-4938-9731-a606243eab60",
      "text": "Kẻ nhiều lời sẽ bị chán ghét,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:43.624Z",
      "updatedAt": "2025-09-03T02:50:43.624Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "89a820e3-c50d-4cf0-9b5c-018e3dd276d3",
      "text": "người hiếu thắng thì bị khinh chê.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:43.638Z",
      "updatedAt": "2025-09-03T02:50:43.638Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "a586d0e0-4a8b-4035-8c08-0a7b46e7bddc",
      "text": "Có khi lâm nạn lại thành công,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:43.666Z",
      "updatedAt": "2025-09-03T02:50:43.666Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "0cae645c-6d7a-4c27-ada3-89bc5382b6d3",
      "text": "gặp may mà hoá thiệt thòi.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:43.692Z",
      "updatedAt": "2025-09-03T02:50:43.692Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "6913722f-a108-4419-a1c5-a50299227cf9",
      "text": "Có lúc cho đi mà con không được lợi,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:43.706Z",
      "updatedAt": "2025-09-03T02:50:43.706Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "0c2b8546-aec8-45be-ab04-e136a1f53d44",
      "text": "có lúc cho đi lại được trả gấp đôi.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:43.721Z",
      "updatedAt": "2025-09-03T02:50:43.721Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "9a2dbaaa-af70-44c6-8ef4-dc3914448355",
      "text": "Đôi khi vinh quang đem lại nhục nhã,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:43.734Z",
      "updatedAt": "2025-09-03T02:50:43.734Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "0f9b4f09-92c4-469e-a445-106f374d7b74",
      "text": "kẻ thấp hèn lại được ngẩng đầu hiên ngang.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:43.748Z",
      "updatedAt": "2025-09-03T02:50:43.748Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "9a968571-787a-4042-a31b-828d05d00377",
      "text": "Có kẻ sắm nhiều mà tốn ít,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:43.789Z",
      "updatedAt": "2025-09-03T02:50:43.789Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "dc39f95c-a1a9-48de-9352-ec23e253cb5c",
      "text": "nhưng thật ra phải trả gấp bảy lần.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:43.803Z",
      "updatedAt": "2025-09-03T02:50:43.803Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "c4fdf00e-5711-43f6-b886-25de85e0da9a",
      "text": "Người khôn ngoan nói ít cũng gây được thiện cảm,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:43.817Z",
      "updatedAt": "2025-09-03T02:50:43.817Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "f99b745a-3623-4998-8af9-25e79db98526",
      "text": "lời hoa mỹ của kẻ ngu đần chỉ là thứ đổ đi.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:43.831Z",
      "updatedAt": "2025-09-03T02:50:43.831Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "9233074b-bba6-4565-8e32-7314eef90d5e",
      "text": "Ích gì cho con quà biếu của đứa khờ dại :",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:43.845Z",
      "updatedAt": "2025-09-03T02:50:43.845Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "10c4bdba-6e80-4dd4-a719-d5b54f0d7d6a",
      "text": "nó biếu một mà trông được mười.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:43.859Z",
      "updatedAt": "2025-09-03T02:50:43.859Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "6d4b9ba2-ced1-41dc-9ac1-f4f0798a0969",
      "text": "Nó cho thì ít, trách mắng thì nhiều,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:43.887Z",
      "updatedAt": "2025-09-03T02:50:43.887Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "28251e0d-f968-4931-bb75-fe818982d923",
      "text": "miệng oang oang như thằng mõ,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:43.900Z",
      "updatedAt": "2025-09-03T02:50:43.900Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "bed2fb32-84ec-4ea8-87e2-08a9ef2cb15c",
      "text": "hôm nay cho mượn, ngày mai đã đòi.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 2,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:43.914Z",
      "updatedAt": "2025-09-03T02:50:43.914Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "3bd0d0d6-afe5-4a42-ac08-187ca57be289",
      "text": "Người như vậy thật đáng ghét.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 3,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:43.928Z",
      "updatedAt": "2025-09-03T02:50:43.928Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "d3752780-de28-4094-bc95-14015f9a50c6",
      "text": "Kẻ ngu đần nói : “Chẳng có ai thân thiết với tôi,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:43.942Z",
      "updatedAt": "2025-09-03T02:50:43.942Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "b3058edc-eba0-4e95-8c1b-ce35c2aa9446",
      "text": "việc nghĩa tôi làm, chẳng ai biết đến !”",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:43.956Z",
      "updatedAt": "2025-09-03T02:50:43.956Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "81e9e460-3431-4272-81d1-08fb50eab26e",
      "text": "Chịu ơn nó toàn những quân mạt hạng,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:43.970Z",
      "updatedAt": "2025-09-03T02:50:43.970Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "984714ea-b9b5-4cc3-80e8-456f7d438e84",
      "text": "biết bao lần chúng cười nhạo nó !",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:43.983Z",
      "updatedAt": "2025-09-03T02:50:43.983Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "dae8c990-4129-4aec-b1c3-bd4afa9f6c60",
      "text": "Sẩy chân còn hơn lỡ miệng,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:44.011Z",
      "updatedAt": "2025-09-03T02:50:44.011Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "5c19c49d-9cf8-4745-87ea-7faa85c49920",
      "text": "những kẻ gian ác cũng sụp đổ nhanh như thế.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:44.038Z",
      "updatedAt": "2025-09-03T02:50:44.038Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "7c85830c-cae6-4aa5-bc33-fa9672f46a3e",
      "text": "Người thô lỗ thì giống như câu chuyện không hợp thời,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:44.052Z",
      "updatedAt": "2025-09-03T02:50:44.052Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "09421a78-32e9-4bdd-abaa-d807e5605985",
      "text": "kẻ dốt nát cứ kể đi kể lại.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:44.067Z",
      "updatedAt": "2025-09-03T02:50:44.067Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "28dbb9f2-882c-4b04-8300-d4f6a7cfe2e4",
      "text": "Kẻ ngu đần không nói được dụ ngôn,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:44.103Z",
      "updatedAt": "2025-09-03T02:50:44.103Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "641e4e6e-339d-4c34-90bc-ac38eedcea1f",
      "text": "vì lúc phải nói, nó lại chẳng nói.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:44.131Z",
      "updatedAt": "2025-09-03T02:50:44.131Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "21dda49b-36db-4cdf-99dc-f45e7878d15a",
      "text": "Do túng thiếu, có kẻ tránh được tội,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:44.144Z",
      "updatedAt": "2025-09-03T02:50:44.144Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "d98a78a8-3c77-4e10-a980-ed4ae7f48c10",
      "text": "và không bị ray rứt lúc nghỉ ngơi.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:44.158Z",
      "updatedAt": "2025-09-03T02:50:44.158Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "8aaf039a-215d-4f7c-948b-7bb49001c20f",
      "text": "Có người tiêu vong vì xấu hổ,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:44.186Z",
      "updatedAt": "2025-09-03T02:50:44.186Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "443ed35b-f4ea-4dd5-a4c9-2dd2d8a01b51",
      "text": "nó tiêu vong vì nể mặt đứa khờ.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:44.214Z",
      "updatedAt": "2025-09-03T02:50:44.214Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "78f66a58-3e09-4d0a-9e59-3585f51cf454",
      "text": "Có kẻ vì xấu hổ mà hứa hẹn với bạn hữu,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:44.226Z",
      "updatedAt": "2025-09-03T02:50:44.226Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "f6ed5e4a-6cc8-4497-8208-107ebd5dbbf5",
      "text": "bỗng dưng biến người ấy thành kẻ thù.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:44.238Z",
      "updatedAt": "2025-09-03T02:50:44.238Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "34851655-bf16-4dbc-b741-8c9b2e7fd431",
      "text": "Nơi con người, nói dối là điều đê tiện xấu xa,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:44.250Z",
      "updatedAt": "2025-09-03T02:50:44.250Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "776d543b-0d51-4639-82c0-4a82ff191969",
      "text": "kẻ dốt nát cứ luôn mồm nói dối.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:44.286Z",
      "updatedAt": "2025-09-03T02:50:44.286Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "b65b30f0-a3f2-4964-b885-e73804d41c44",
      "text": "Trộm cắp còn đỡ hơn nói dối,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:44.299Z",
      "updatedAt": "2025-09-03T02:50:44.299Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "19099316-5adf-432e-86a5-42aaeb91187d",
      "text": "nhưng cả hai đều chuốc lấy hư vong.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:44.312Z",
      "updatedAt": "2025-09-03T02:50:44.312Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "7f7dd1c7-5168-47c8-9e6b-97f5d3f8b35e",
      "text": "Kẻ quen nói dối là kẻ vô liêm sỉ,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:44.325Z",
      "updatedAt": "2025-09-03T02:50:44.325Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "ff096945-e7a4-40a5-8ccd-b3968e5b754b",
      "text": "nỗi nhục không bao giờ rời xa nó.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:44.352Z",
      "updatedAt": "2025-09-03T02:50:44.352Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "bae1c475-56b8-4bdb-b063-d5317a68eca8",
      "text": "Kẻ ăn nói khôn ngoan được người khác kính nể,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:44.365Z",
      "updatedAt": "2025-09-03T02:50:44.365Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "ceec3c52-c989-486c-b0aa-826a53f75531",
      "text": "người cư xử chín chắn được bậc quyền cao trọng dụng.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:44.391Z",
      "updatedAt": "2025-09-03T02:50:44.391Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "b129a916-ef51-49f1-9504-90c617025268",
      "text": "Người làm ruộng thu lúa đầy bồ,",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:44.418Z",
      "updatedAt": "2025-09-03T02:50:44.418Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "1cef3969-26cd-492d-9a32-b40a33ec572f",
      "text": "kẻ đẹp lòng các bậc quyền cao, dù có lỗi lầm, cũng được tha thứ.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 1,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:44.431Z",
      "updatedAt": "2025-09-03T02:50:44.431Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "0ab6be54-880d-4e10-8120-13b1d33875a8",
      "text": "Bổng lộc và quà cáp làm mờ mắt bậc khôn ngoan,",
      "label": "29",
      "number": 29,
      "subVerseIndex": 0,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:44.457Z",
      "updatedAt": "2025-09-03T02:50:44.457Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "91c4f7ea-5ba7-4759-b255-b3e5ea5df8f4",
      "text": "khiến miệng họ mắc quai, không còn dám khiển trách.",
      "label": "29",
      "number": 29,
      "subVerseIndex": 1,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:44.484Z",
      "updatedAt": "2025-09-03T02:50:44.484Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "4eb05c84-3ec9-43e8-a9f2-fe9dddeb3f9b",
      "text": "Khôn ngoan bị che giấu, kho tàng bị chôn vùi :",
      "label": "30",
      "number": 30,
      "subVerseIndex": 0,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:44.497Z",
      "updatedAt": "2025-09-03T02:50:44.497Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "861761f7-e14a-4520-9185-8df291dccc01",
      "text": "cả hai nào có ích chi ?",
      "label": "30",
      "number": 30,
      "subVerseIndex": 1,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:44.527Z",
      "updatedAt": "2025-09-03T02:50:44.527Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "0ea27f81-9dff-4771-bf77-e3406be6551b",
      "text": "Người che giấu sự đần độn",
      "label": "31",
      "number": 31,
      "subVerseIndex": 0,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:44.540Z",
      "updatedAt": "2025-09-03T02:50:44.540Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "b2c8e96f-e4d4-4b6d-aa56-8285b49a306b",
      "text": "vẫn hơn kẻ che giấu sự khôn ngoan.",
      "label": "31",
      "number": 31,
      "subVerseIndex": 1,
      "paragraphNumber": 61,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:44.554Z",
      "updatedAt": "2025-09-03T02:50:44.554Z",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    }
  ],
  "marks": [
    {
      "id": "037f7649-d45d-471c-adee-962ca30c8682",
      "content": "Lấy lại để tài ở 19,13-17 về việc khuyên nhủ bạn bè như việc cần thiết và hữu ích ; nhưng ở đây nhấn mạnh rằng việc ấy phải được thực hiện một cách ý thức và khôn ngoan.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 33,
      "endOffset": 33,
      "createdAt": "2025-09-03T02:50:43.420Z",
      "updatedAt": "2025-09-03T02:50:43.420Z",
      "targetId": "b2704078-753b-405a-a955-b93031898268",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "06daf406-451d-4817-b479-11c0b40ee0a0",
      "content": "Hc 30,20",
      "kind": "MARK_KIND_REFERENCE",
      "label": "1@",
      "sortOrder": 0,
      "startOffset": 15,
      "endOffset": 15,
      "createdAt": "2025-09-03T02:50:43.499Z",
      "updatedAt": "2025-09-03T02:50:43.499Z",
      "targetId": "3467fe25-56e2-438f-933d-a444a9f0e98e",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "7143c8f4-a053-4316-9ba9-1170bd9926c3",
      "content": "Thật là vô ích khi muốn dùng vũ lực ép người ta thi hành đạo đức.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 45,
      "endOffset": 45,
      "createdAt": "2025-09-03T02:50:43.485Z",
      "updatedAt": "2025-09-03T02:50:43.485Z",
      "targetId": "3467fe25-56e2-438f-933d-a444a9f0e98e",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "59bb3af2-db40-472e-b53b-a67c083dcbff",
      "content": "Cn 17,28",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 6,
      "endOffset": 6,
      "createdAt": "2025-09-03T02:50:43.526Z",
      "updatedAt": "2025-09-03T02:50:43.526Z",
      "targetId": "375a3abf-e3be-47b5-addd-78e834faeb2c",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "134d9d2e-b586-46f9-8de2-52e3a0b49d7f",
      "content": "Biết thì thưa thốt, không biết thì dựa cột mà nghe. Tác giả Hc cho hiểu rằng im lặng nguyên nó không hẳn là bằng chứng của khôn ngoan.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 28,
      "endOffset": 28,
      "createdAt": "2025-09-03T02:50:43.581Z",
      "updatedAt": "2025-09-03T02:50:43.581Z",
      "targetId": "81ff284d-2b57-4184-b0c5-5457e228c0d7",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "cdf4075a-adc4-4f59-af2c-8e099fbc72d3",
      "content": "Lc 1,52",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:50:43.776Z",
      "updatedAt": "2025-09-03T02:50:43.776Z",
      "targetId": "0f9b4f09-92c4-469e-a445-106f374d7b74",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "4a5f62c8-fed3-4c8e-a6d3-49ac337a5ecd",
      "content": "Tức là kẻ nói nhiều để tỏ mình có thế. Có thể ở đây bản Hy-lạp dịch từ Híp-ri mäšal (đáng lẽ phải hiểu là *châm ngôn*) thành *áp đặt* ; bản văn nguyên thuỷ muốn nói : kẻ quá dè sẻn lời nói cũng như kẻ nhiều lời đều đáng ghét như nhau.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 16,
      "endOffset": 16,
      "createdAt": "2025-09-03T02:50:43.652Z",
      "updatedAt": "2025-09-03T02:50:43.652Z",
      "targetId": "89a820e3-c50d-4cf0-9b5c-018e3dd276d3",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "684f55b7-aace-46f3-9a6e-91e2c3f8e328",
      "content": "Cn 26,7-9",
      "kind": "MARK_KIND_REFERENCE",
      "label": "4@",
      "sortOrder": 3,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:50:44.117Z",
      "updatedAt": "2025-09-03T02:50:44.117Z",
      "targetId": "28dbb9f2-882c-4b04-8300-d4f6a7cfe2e4",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "9ff40c1f-d466-4063-8ce6-d324d0fc9cd5",
      "content": "Ý tưởng là lật ngược hoàn cảnh đối lập nhau, x. 1 Sm 2,4-9 ; Tv 75,8 ; 113,7-9 ; Lc 1,51-53.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "5",
      "sortOrder": 4,
      "startOffset": 41,
      "endOffset": 41,
      "createdAt": "2025-09-03T02:50:43.762Z",
      "updatedAt": "2025-09-03T02:50:43.762Z",
      "targetId": "0f9b4f09-92c4-469e-a445-106f374d7b74",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "47e7c777-cbea-4d30-8490-758f7643e021",
      "content": "Hc 4,21",
      "kind": "MARK_KIND_REFERENCE",
      "label": "5@",
      "sortOrder": 4,
      "startOffset": 22,
      "endOffset": 22,
      "createdAt": "2025-09-03T02:50:44.200Z",
      "updatedAt": "2025-09-03T02:50:44.200Z",
      "targetId": "8aaf039a-215d-4f7c-948b-7bb49001c20f",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "d40d6850-db19-416a-9fd5-a3c0fc1448b8",
      "content": "ds : *vì mắt nó có nhiều, chứ không phải một*. Ý câu này không phải là “bỏ con săn sắt bắt con cá sộp”, nhưng là : kẻ ti tiện biếu xén bạn cái gì thì hắn cho là lớn lắm, và hắn có hậu ý chờ bạn đáp lại. “Được mười” kiểu nói Việt Nam ; HL : *nhiều* ; LT : *gấp bảy*. Từ *khờ dại* trong câu này xem ra dịch hơi yếu.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "6",
      "sortOrder": 5,
      "startOffset": 30,
      "endOffset": 30,
      "createdAt": "2025-09-03T02:50:43.873Z",
      "updatedAt": "2025-09-03T02:50:43.873Z",
      "targetId": "10c4bdba-6e80-4dd4-a719-d5b54f0d7d6a",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "bb4ee690-922a-43b4-942e-d3f0740090ac",
      "content": "Cn 13,5",
      "kind": "MARK_KIND_REFERENCE",
      "label": "6@",
      "sortOrder": 5,
      "startOffset": 26,
      "endOffset": 26,
      "createdAt": "2025-09-03T02:50:44.273Z",
      "updatedAt": "2025-09-03T02:50:44.273Z",
      "targetId": "34851655-bf16-4dbc-b741-8c9b2e7fd431",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "d898165a-7602-412e-a8bb-8f941b3bd350",
      "content": "*Chịu ơn ... mạt hạng* : ds : *Những kẻ ăn bánh của nó đều ăn nói không ra gì* về nó. Có lẽ câu này là nhận xét của tác giả về lời nói ở c.16 : ngay cả những người đồng bàn với kẻ “ngu đần” cũng chế giễu hắn về thái độ ngu xuẩn của hắn về sự hào hiệp.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "7",
      "sortOrder": 6,
      "startOffset": 31,
      "endOffset": 31,
      "createdAt": "2025-09-03T02:50:43.997Z",
      "updatedAt": "2025-09-03T02:50:43.997Z",
      "targetId": "984714ea-b9b5-4cc3-80e8-456f7d438e84",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "9e8c8dd7-6b9f-47ab-a02a-15c049ec5872",
      "content": "Cn 12,22",
      "kind": "MARK_KIND_REFERENCE",
      "label": "7@",
      "sortOrder": 6,
      "startOffset": 8,
      "endOffset": 8,
      "createdAt": "2025-09-03T02:50:44.339Z",
      "updatedAt": "2025-09-03T02:50:44.339Z",
      "targetId": "7f7dd1c7-5168-47c8-9e6b-97f5d3f8b35e",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "ab0f3383-3621-4c81-9cfa-be46635e9ea7",
      "content": "ds : *Người vô duyên thì như huyền thoại không hợp thời, luôn luôn trong miệng những kẻ thất học*. Có lẽ bản Xy-ri diễn ý nguyên bản Híp-ri rõ hơn : “Lời nói không hợp thời thì như đuôi cừu không muối” ; dân sành ăn rất thích món đuôi cừu.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "8",
      "sortOrder": 7,
      "startOffset": 26,
      "endOffset": 26,
      "createdAt": "2025-09-03T02:50:44.089Z",
      "updatedAt": "2025-09-03T02:50:44.089Z",
      "targetId": "09421a78-32e9-4bdd-abaa-d807e5605985",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "5024b12e-7ebe-492b-b0e9-f9b647cdb2e6",
      "content": "Cn 14,35",
      "kind": "MARK_KIND_REFERENCE",
      "label": "8@",
      "sortOrder": 7,
      "startOffset": 16,
      "endOffset": 16,
      "createdAt": "2025-09-03T02:50:44.444Z",
      "updatedAt": "2025-09-03T02:50:44.444Z",
      "targetId": "1cef3969-26cd-492d-9a32-b40a33ec572f",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "4ec4cf6f-4fd3-4921-a15b-0585c3f6b331",
      "content": "Tình trạng nghèo có thể giữ cho người ta khỏi một số nguy hiểm, vì buộc họ nhất thiết phải làm điều tốt. Tuy nhiên, người nghèo cũng dễ tiêu vong hơn vì xấu hổ không dám đương đầu với kẻ ngu dốt (c.22), hoặc hứa những điều bất khả thi (c.23).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "9",
      "sortOrder": 8,
      "startOffset": 33,
      "endOffset": 33,
      "createdAt": "2025-09-03T02:50:44.172Z",
      "updatedAt": "2025-09-03T02:50:44.172Z",
      "targetId": "d98a78a8-3c77-4e10-a980-ed4ae7f48c10",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "6428af07-0643-4058-af83-cae1cc41a6fb",
      "content": "Cn 17,8; 18,16; 21,14",
      "kind": "MARK_KIND_REFERENCE",
      "label": "9@",
      "sortOrder": 8,
      "startOffset": 12,
      "endOffset": 12,
      "createdAt": "2025-09-03T02:50:44.470Z",
      "updatedAt": "2025-09-03T02:50:44.470Z",
      "targetId": "0ab6be54-880d-4e10-8120-13b1d33875a8",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "d8b41e2f-52bb-4d2d-943f-caa85439f71b",
      "content": "Người khôn ngoan trước tiên biết xử trí thế nào để thành công trên đời, nhất là để được những người cấp trên tín nhiệm.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "10",
      "sortOrder": 9,
      "startOffset": 51,
      "endOffset": 51,
      "createdAt": "2025-09-03T02:50:44.404Z",
      "updatedAt": "2025-09-03T02:50:44.404Z",
      "targetId": "ceec3c52-c989-486c-b0aa-826a53f75531",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "6aae7a0b-ae75-481d-b78f-e29d554b6fcb",
      "content": "Hc 41,14-15; Mt 5,14-16",
      "kind": "MARK_KIND_REFERENCE",
      "label": "10@",
      "sortOrder": 9,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:50:44.510Z",
      "updatedAt": "2025-09-03T02:50:44.510Z",
      "targetId": "4eb05c84-3ec9-43e8-a9f2-fe9dddeb3f9b",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "6dd754b8-dd47-4a3a-9735-1f41847301f4",
      "content": "Bản chất của khôn ngoan là phải sáng chói để dẫn lối cho người đời ; ẩn khuất đi là sai trệch căn tính đó, x. Mt 5,14-16. Một bản Hy-lạp thêm “kiên trì tìm kiếm Chúa không nao núng thì hơn là hướng dẫn lấy đời mình một cách bừa bãi”.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "11",
      "sortOrder": 10,
      "startOffset": 33,
      "endOffset": 33,
      "createdAt": "2025-09-03T02:50:44.567Z",
      "updatedAt": "2025-09-03T02:50:44.567Z",
      "targetId": "b2c8e96f-e4d4-4b6d-aa56-8285b49a306b",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    }
  ],
  "headings": [
    {
      "id": "d7715fc5-5b4c-48a8-b38a-d66eec659987",
      "text": "Nên nói hay làm thinh",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T02:50:43.399Z",
      "updatedAt": "2025-09-03T02:50:43.399Z",
      "verseId": "2b0d86df-28b6-462d-82ff-1554eca456a2",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "9fe08a15-7687-4cc2-887b-e632f4dc1068",
      "text": "Những điều nghịch lý",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T02:50:43.679Z",
      "updatedAt": "2025-09-03T02:50:43.679Z",
      "verseId": "a586d0e0-4a8b-4035-8c08-0a7b46e7bddc",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "b6f3b7ae-2046-4735-a966-f023b3b4038b",
      "text": "Tránh ăn nói vụng về",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T02:50:44.025Z",
      "updatedAt": "2025-09-03T02:50:44.025Z",
      "verseId": "dae8c990-4129-4aec-b1c3-bd4afa9f6c60",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "53b863d0-d5db-4a43-822b-e36839fb2e7b",
      "text": "Gian dối",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T02:50:44.262Z",
      "updatedAt": "2025-09-03T02:50:44.262Z",
      "verseId": "34851655-bf16-4dbc-b741-8c9b2e7fd431",
      "chapterId": "33916c52-cfb2-475c-8f96-682294b01059"
    },
    {
      "id": "e905eb0c-37f1-47ee-bb79-87d772e9dd70",
      "text": "Về sự khôn ngoan",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T02:50:44.378Z",
      "updatedAt": "2025-09-03T02:50:44.378Z",
