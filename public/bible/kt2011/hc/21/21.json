{
  "chapter": {
    "id": "84cef9fc-1315-4215-af18-7ec2661b0da8",
    "number": 21,
    "createdAt": "2025-09-03T01:07:51.705Z",
    "updatedAt": "2025-09-03T01:07:51.705Z",
    "bookId": "5c66a463-0bfa-46b7-9af1-3766a8779b73"
  },
  "verses": [
    {
      "id": "3a520ee0-70e2-40f0-a0b0-ed12b49f6de6",
      "text": "Con ơi, đã trót phạm tội thì đừng phạm nữa !",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:51.695Z",
      "updatedAt": "2025-09-03T02:50:51.695Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "9eb66a36-941d-4a1a-9bea-618c92001999",
      "text": "Hãy xin ơn tha thứ những tội con đã phạm.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:51.724Z",
      "updatedAt": "2025-09-03T02:50:51.724Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "6630f37e-9f08-4e5c-a0ff-25d9f88c5d6f",
      "text": "Con hãy tránh tội như tránh rắn,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:51.734Z",
      "updatedAt": "2025-09-03T02:50:51.734Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "7407d7c1-aab3-4177-8f03-f0e0223306d0",
      "text": "vì nếu con tới gần, nó sẽ cắn con.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:51.745Z",
      "updatedAt": "2025-09-03T02:50:51.745Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "b7dcf81b-4277-49a0-a0e9-04bb01607512",
      "text": "Răng nó khác nào răng sư tử",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:51.767Z",
      "updatedAt": "2025-09-03T02:50:51.767Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "01e50f08-0210-418d-a2d0-41a2ef6186c9",
      "text": "cướp mạng sống con người.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 3,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:51.779Z",
      "updatedAt": "2025-09-03T02:50:51.779Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "00758de2-3ade-4734-8578-3362981b4c43",
      "text": "Vi phạm Lề Luật bao giờ cũng là gươm hai lưỡi,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:51.792Z",
      "updatedAt": "2025-09-03T02:50:51.792Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "1627e3f9-bccc-4fbd-8683-dd0572d54376",
      "text": "gây ra vết thương không tài nào chữa trị.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:51.820Z",
      "updatedAt": "2025-09-03T02:50:51.820Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "ab3179c3-6454-48ff-bba2-3da80e51cef8",
      "text": "Kinh hoàng và bạo lực làm tài sản tiêu tan,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:51.834Z",
      "updatedAt": "2025-09-03T02:50:51.834Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "5163bb79-ec65-49c7-bf3d-ab02a1925abe",
      "text": "nhà cửa đứa kiêu căng cũng bị tiêu tan như thế.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:51.861Z",
      "updatedAt": "2025-09-03T02:50:51.861Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "a6a5ecdc-91fb-475b-93fb-aaa479d76850",
      "text": "Kẻ nghèo vừa mở miệng cầu khẩn là Chúa lắng tai nghe :",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:51.875Z",
      "updatedAt": "2025-09-03T02:50:51.875Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "fff4e541-18fa-4050-b03b-4a57cfcee500",
      "text": "Người xét xử ngay, không trì hoãn.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:51.896Z",
      "updatedAt": "2025-09-03T02:50:51.896Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "7e16ffb1-1b2f-4a41-97f7-12567a2ab58c",
      "text": "Ai ghét bỏ lời khiển trách là bước theo đường quân tội lỗi,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:51.910Z",
      "updatedAt": "2025-09-03T02:50:51.910Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "d1b7cf39-a76f-49d4-bd1d-b11f31b906d8",
      "text": "ai kính sợ Đức Chúa thì thật lòng trở lại.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:51.937Z",
      "updatedAt": "2025-09-03T02:50:51.937Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "b3f5e25a-7328-4b4a-8af5-24412f7237f8",
      "text": "Người khéo ăn khéo nói thì nổi tiếng khắp nơi,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:51.951Z",
      "updatedAt": "2025-09-03T02:50:51.951Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "274ef575-2b0c-4f0c-a76e-5e9ca0d1028f",
      "text": "nhưng ai tinh ý sẽ biết ngay hắn sơ hở chỗ nào.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:51.965Z",
      "updatedAt": "2025-09-03T02:50:51.965Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "c0f7f598-1ea3-4090-b107-51eefb5a4242",
      "text": "Kẻ lấy tiền người khác xây nhà mình ở,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:51.979Z",
      "updatedAt": "2025-09-03T02:50:51.979Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "829348c3-7932-4764-bdc7-57781c8781f9",
      "text": "cũng giống như người chất đá làm mộ chôn mình.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:51.993Z",
      "updatedAt": "2025-09-03T02:50:51.993Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "921d72b2-286d-4125-9cd3-622e2912e5b3",
      "text": "Đám hội lũ phi pháp tựa như đống sợi vụn,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:52.020Z",
      "updatedAt": "2025-09-03T02:50:52.020Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "a03e76d4-fae0-4b21-9292-2d28cd76b6cf",
      "text": "rốt cuộc chỉ làm mồi cho lửa mà thôi.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:52.048Z",
      "updatedAt": "2025-09-03T02:50:52.048Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "f32ff734-6801-447b-b998-804dca8e0c6f",
      "text": "Đường nẻo quân tội lỗi thì phẳng phiu, không sỏi đá,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:52.062Z",
      "updatedAt": "2025-09-03T02:50:52.062Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "3b29d2bc-c40e-4347-912f-622224286c7a",
      "text": "nhưng cuối đường là hố sâu âm phủ.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:52.089Z",
      "updatedAt": "2025-09-03T02:50:52.089Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "2e015a1e-426e-4ec2-95ac-ba038843d9a5",
      "text": "Ai tuân giữ Lề Luật sẽ điều khiển được tâm tư,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:52.117Z",
      "updatedAt": "2025-09-03T02:50:52.117Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "e029d65f-25f1-4232-a07c-9dd1bf88f5e1",
      "text": "khôn ngoan là hết lòng kính sợ Đức Chúa.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:52.171Z",
      "updatedAt": "2025-09-03T02:50:52.171Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "80f0dace-04b6-4ff1-b06f-f6b9e150482c",
      "text": "Người không lanh lợi chẳng học hành gì được,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:52.185Z",
      "updatedAt": "2025-09-03T02:50:52.185Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "7fce8d1e-2f60-48c4-84cb-4f7d663e6816",
      "text": "nhưng có thứ lanh lợi gây nhiều đắng cay.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:52.199Z",
      "updatedAt": "2025-09-03T02:50:52.199Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "6d512230-2086-4033-94fa-62ef7c632822",
      "text": "Kiến thức của bậc khôn ngoan tràn trề như nước lũ",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:52.227Z",
      "updatedAt": "2025-09-03T02:50:52.227Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "815e48db-e7b0-4ebc-bf09-e7edc381df9f",
      "text": "và lời khuyên của họ như nguồn suối tuôn trào.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:52.255Z",
      "updatedAt": "2025-09-03T02:50:52.255Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "828f0995-333b-445e-8112-e5f5cbcc1382",
      "text": "Lòng dạ kẻ ngu đần như chiếc bình rạn nứt",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:52.300Z",
      "updatedAt": "2025-09-03T02:50:52.300Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "0f7e6d52-3bf4-43c6-b9b0-5c4d8af196ed",
      "text": "chẳng giữ được một kiến thức nào.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:52.315Z",
      "updatedAt": "2025-09-03T02:50:52.315Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "80bfd8ff-4e5c-4149-bf47-9ad087d6a37c",
      "text": "Nghe một lời lẽ khôn ngoan,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:52.328Z",
      "updatedAt": "2025-09-03T02:50:52.328Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "d54b937a-730d-45ae-82e3-56f237c0e98d",
      "text": "người am hiểu tán thưởng và góp thêm ý kiến,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:52.342Z",
      "updatedAt": "2025-09-03T02:50:52.342Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "c98efc52-e91e-4f35-919b-64ceb826687e",
      "text": "còn kẻ sa đoạ thì bực mình và bỏ lại sau lưng.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 2,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:52.356Z",
      "updatedAt": "2025-09-03T02:50:52.356Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "fb5dbea5-63ec-4cd8-9bd8-57740c70aeee",
      "text": "Lời lẽ kẻ ngu tựa hành lý nặng nề,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:52.376Z",
      "updatedAt": "2025-09-03T02:50:52.376Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "84276332-944e-402a-b84b-92411d21b8b5",
      "text": "còn miệng người thông minh nói ra lời duyên dáng.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:52.390Z",
      "updatedAt": "2025-09-03T02:50:52.390Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "aa3012f4-1a0f-4292-8bc1-3658b2e2b45d",
      "text": "Trong đại hội, người sáng suốt được yêu cầu phát biểu,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:52.404Z",
      "updatedAt": "2025-09-03T02:50:52.404Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "45ce0a2a-d0ff-453d-9aa7-02aa7709867f",
      "text": "lời họ nói được người ta để tâm suy nghĩ.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:52.418Z",
      "updatedAt": "2025-09-03T02:50:52.418Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "29330e0a-bc02-4100-8403-841793930ad9",
      "text": "Khôn ngoan đối với đứa ngu tựa ngôi nhà đổ nát,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:52.432Z",
      "updatedAt": "2025-09-03T02:50:52.432Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "cd9b6b54-91b5-48d7-9cbd-61a374b2eefc",
      "text": "kiến thức của kẻ dốt là một mớ ý tưởng lộn xộn.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:52.446Z",
      "updatedAt": "2025-09-03T02:50:52.446Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "2a6fac43-d0a7-488f-9631-97e7f2a2a4c8",
      "text": "Với người ngốc, giáo dục ví như xiềng cùm chân,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:52.461Z",
      "updatedAt": "2025-09-03T02:50:52.461Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "ae35f048-320d-4653-afe5-9aa2a1019d6a",
      "text": "như còng khoá tay phải.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:52.474Z",
      "updatedAt": "2025-09-03T02:50:52.474Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "4245fba5-b398-46bc-b8ab-c95c7ef0a0f7",
      "text": "Người ngu cười hô hố,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:52.488Z",
      "updatedAt": "2025-09-03T02:50:52.488Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "8c8fb542-b9de-4652-b4c1-5a0f5263f70a",
      "text": "còn người sáng trí hoạ mới mỉm cười.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:52.502Z",
      "updatedAt": "2025-09-03T02:50:52.502Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "6cb7660b-f834-4137-b5c9-6bacc0b2431e",
      "text": "Với người khôn, giáo dục ví như vàng trang sức,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:52.516Z",
      "updatedAt": "2025-09-03T02:50:52.516Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "8604ddc3-2341-455b-bdd1-597e3b01eca0",
      "text": "như xuyến trên tay phải.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:52.530Z",
      "updatedAt": "2025-09-03T02:50:52.530Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "8f9a2485-da85-4974-acf6-07d5dd2f9a9e",
      "text": "Tới nhà ai, kẻ ngu xồng xộc bước vào,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:52.558Z",
      "updatedAt": "2025-09-03T02:50:52.558Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "5f62fc21-c6db-409a-8402-1fd308822d51",
      "text": "còn người từng trải thì ngập ngừng e ngại.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:52.575Z",
      "updatedAt": "2025-09-03T02:50:52.575Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "61a6e49a-d066-4ec1-8bfd-0c98c3922e85",
      "text": "Kẻ khờ đứng nhìn qua cửa,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:52.603Z",
      "updatedAt": "2025-09-03T02:50:52.603Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "d1739b14-309d-43a9-ba2a-1d718742eafd",
      "text": "còn người có giáo dục đứng lại bên ngoài.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:52.618Z",
      "updatedAt": "2025-09-03T02:50:52.618Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "875bf9a5-870c-4a23-96c7-7ad5d7be35f5",
      "text": "Đứng nghe ngoài cửa là kẻ thiếu giáo dục,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:52.633Z",
      "updatedAt": "2025-09-03T02:50:52.633Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "99fa6a3f-e977-484c-9e16-483d95703ff1",
      "text": "còn người khôn coi đó là điều nhục nhã ê chề.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:52.646Z",
      "updatedAt": "2025-09-03T02:50:52.646Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "6f256342-ccf4-4c17-8b73-41ecb928ad03",
      "text": "Đứa bẻm mép nói năng bừa bãi,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:52.660Z",
      "updatedAt": "2025-09-03T02:50:52.660Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "4b0f57f4-3967-40bb-b5b0-54d3ff0a7040",
      "text": "còn người khôn ăn nói chừng mực.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:52.688Z",
      "updatedAt": "2025-09-03T02:50:52.688Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "075c3b9c-429f-4f4b-b959-d19a98cab8cd",
      "text": "Kẻ ngu đần nói trước nghĩ sau,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:52.703Z",
      "updatedAt": "2025-09-03T02:50:52.703Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "bb3e75b6-c29c-4a6b-ae9a-c3c212d6569c",
      "text": "người khôn ngoan nghĩ rồi mới nói.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:52.716Z",
      "updatedAt": "2025-09-03T02:50:52.716Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "6399b90c-1808-423e-b058-47be3d59675c",
      "text": "Kẻ vô đạo nguyền rủa Xa-tan,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:52.744Z",
      "updatedAt": "2025-09-03T02:50:52.744Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "a1053592-c50a-4f2d-93ca-520306be1d6f",
      "text": "thật ra là nguyền rủa chính mình.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:52.794Z",
      "updatedAt": "2025-09-03T02:50:52.794Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "ef6c913d-228a-460d-8b01-d3ac63513393",
      "text": "Đứa hay mách lẻo bôi nhọ chính bản thân,",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:52.807Z",
      "updatedAt": "2025-09-03T02:50:52.807Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "64eb092f-8383-49d6-bcdb-36f183d1d7c4",
      "text": "và bị hàng xóm láng giềng ghét bỏ.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 1,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:50:52.821Z",
      "updatedAt": "2025-09-03T02:50:52.821Z",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    }
  ],
  "marks": [
    {
      "id": "74505741-7c1f-456e-bcd3-9617b35a3127",
      "content": "Tác giả dùng nhiều hình ảnh cụ thể minh hoạ nguy cơ tội đem đến cho con người : *rắn* (St 3,1 ; Cn 23,32), *sư tử* (Hc 27,10 ; Ge 1,6 ; 1 Pr 5,8), *gươm hai lưỡi* sắc bén mà ông hay nói đến (22,21 ; 26,28 ; 39,30 ; 40,9 ; 46,2 ; Cn 5,4 ; Tv 149,6).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 33,
      "endOffset": 33,
      "createdAt": "2025-09-03T02:50:51.756Z",
      "updatedAt": "2025-09-03T02:50:51.756Z",
      "targetId": "7407d7c1-aab3-4177-8f03-f0e0223306d0",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "e031afb7-6d4e-44a8-81a9-ad929aca3b7e",
      "content": "Cn 5,4",
      "kind": "MARK_KIND_REFERENCE",
      "label": "1@",
      "sortOrder": 0,
      "startOffset": 32,
      "endOffset": 32,
      "createdAt": "2025-09-03T02:50:51.806Z",
      "updatedAt": "2025-09-03T02:50:51.806Z",
      "targetId": "00758de2-3ade-4734-8578-3362981b4c43",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "b4bac4cd-714e-4be8-8907-8ea1d2507483",
      "content": "*Kinh hoàng* : từ Hy-lạp, xuất hiện duy nhất ở đây, hàm ý vừa ngạc nhiên vừa sợ hãi gây nên bởi của cải được trưng bày một cách lộ liễu.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 10,
      "endOffset": 10,
      "createdAt": "2025-09-03T02:50:51.847Z",
      "updatedAt": "2025-09-03T02:50:51.847Z",
      "targetId": "ab3179c3-6454-48ff-bba2-3da80e51cef8",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "6739945a-0ee4-4da5-95a1-79768eefd266",
      "content": "Cn 12,1",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:50:51.923Z",
      "updatedAt": "2025-09-03T02:50:51.923Z",
      "targetId": "7e16ffb1-1b2f-4a41-97f7-12567a2ab58c",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "2a6b28d9-3078-4c78-8640-b93f57034d76",
      "content": "Hình ảnh dễ hiểu. Thế nhưng thay vì *làm mộ chôn mình*, có bản viết *cho mùa đông*, có lẽ ngụ ý rằng : lượm đá thay vì củi cho mùa đông là công cốc ; của cải bất lương chẳng bảo đảm gì cho con người lúc con người gặp khó khăn.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 45,
      "endOffset": 45,
      "createdAt": "2025-09-03T02:50:52.006Z",
      "updatedAt": "2025-09-03T02:50:52.006Z",
      "targetId": "829348c3-7932-4764-bdc7-57781c8781f9",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "070761a8-38a9-4fd2-8b28-654eb69ee869",
      "content": "Hc 16,6",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:50:52.034Z",
      "updatedAt": "2025-09-03T02:50:52.034Z",
      "targetId": "921d72b2-286d-4125-9cd3-622e2912e5b3",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "6516ab24-e620-4699-a2d2-22110eb5bbb4",
      "content": "Mt 7,13",
      "kind": "MARK_KIND_REFERENCE",
      "label": "4@",
      "sortOrder": 3,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:50:52.076Z",
      "updatedAt": "2025-09-03T02:50:52.076Z",
      "targetId": "f32ff734-6801-447b-b998-804dca8e0c6f",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "423edc00-e8ff-43e7-8996-f9ded131f711",
      "content": "Rõ ràng là tác giả tin có thưởng phạt cá nhân (x. 2,10 ; 9,12 ; 11,26-27 ; 12,3). Thường thường thì ông Ben Xi-ra chỉ nói đến cuộc đời hiện tại thôi (chết yểu, chết phũ phàng, v.v... như Is 38,10.17 ; Tv 9,14 ; 30,4 ; 107,18-19) ; nhưng ở đây có thể ông còn muốn nói sự trừng phạt đời sau trong âm phủ một cách nào đó chăng ? Dầu sao thì bản La-tinh cũng hiểu theo nghĩa này : “Nhưng cuối cùng là hoả ngục, tối tăm và cực khổ.”",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 33,
      "endOffset": 33,
      "createdAt": "2025-09-03T02:50:52.103Z",
      "updatedAt": "2025-09-03T02:50:52.103Z",
      "targetId": "3b29d2bc-c40e-4347-912f-622224286c7a",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "cd4447ad-b3a3-4302-b0ca-95fb7825cd1b",
      "content": "X. 15,14+ ; 17,31 ; 37,3 ss.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "5",
      "sortOrder": 4,
      "startOffset": 45,
      "endOffset": 45,
      "createdAt": "2025-09-03T02:50:52.143Z",
      "updatedAt": "2025-09-03T02:50:52.143Z",
      "targetId": "2e015a1e-426e-4ec2-95ac-ba038843d9a5",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "666bea76-dc99-45a9-8e74-0c61ee461293",
      "content": "St 4,7",
      "kind": "MARK_KIND_REFERENCE",
      "label": "5@",
      "sortOrder": 4,
      "startOffset": 23,
      "endOffset": 23,
      "createdAt": "2025-09-03T02:50:52.157Z",
      "updatedAt": "2025-09-03T02:50:52.157Z",
      "targetId": "2e015a1e-426e-4ec2-95ac-ba038843d9a5",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "d2b31b96-a1b4-4693-8bc6-ca2ad8962289",
      "content": "*Lanh lợi* theo khả năng tự nhiên, có thể tốt, có thể xấu tuỳ trường hợp (xem *khôn khéo* ở 19,23 ; *thông minh* ở 37,19 cùng một từ Hy-lạp *panourgos*).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "6",
      "sortOrder": 5,
      "startOffset": 40,
      "endOffset": 40,
      "createdAt": "2025-09-03T02:50:52.214Z",
      "updatedAt": "2025-09-03T02:50:52.214Z",
      "targetId": "7fce8d1e-2f60-48c4-84cb-4f7d663e6816",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "40a7c185-61ff-40ba-b667-32bb68058e43",
      "content": "Cn 13,14; 18,4",
      "kind": "MARK_KIND_REFERENCE",
      "label": "6@",
      "sortOrder": 5,
      "startOffset": 25,
      "endOffset": 25,
      "createdAt": "2025-09-03T02:50:52.287Z",
      "updatedAt": "2025-09-03T02:50:52.287Z",
      "targetId": "815e48db-e7b0-4ebc-bf09-e7edc381df9f",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "c476c25b-b81d-4891-997a-e084b030a82b",
      "content": "*Nước lũ* : trong Hy-lạp từ này được dùng để nói đến *hồng thuỷ* (St 7,17-18). Nhưng *hồng thuỷ* không phải lúc nào cũng là hình ảnh trừng phạt ; ở đây nó mang nghĩa tích cực và có thể tượng trưng phúc lành của Thiên Chúa, như ở Hc 39,22.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "7",
      "sortOrder": 6,
      "startOffset": 49,
      "endOffset": 49,
      "createdAt": "2025-09-03T02:50:52.241Z",
      "updatedAt": "2025-09-03T02:50:52.241Z",
      "targetId": "6d512230-2086-4033-94fa-62ef7c632822",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "a5037e6f-e074-4b7b-aa6b-302acaac678d",
      "content": "*Suối tuôn trào* ý nói đến sự dồi dào luôn luôn trào lên ; đối lại với hình ảnh nước trong bể. Ngược lại là “lòng dạ kẻ ngu đần như bể nước rạn nứt” (c.14a theo bản Xy-ri).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "8",
      "sortOrder": 7,
      "startOffset": 45,
      "endOffset": 45,
      "createdAt": "2025-09-03T02:50:52.273Z",
      "updatedAt": "2025-09-03T02:50:52.273Z",
      "targetId": "815e48db-e7b0-4ebc-bf09-e7edc381df9f",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "3168bd15-250e-49d3-8f39-dfc5d35ce6bd",
      "content": "C.21 này phải đi liền c.19 với ý tưởng đối nghịch nhau. Còn c.20 có lẽ phải đặt trước c.25 mới hợp.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "9",
      "sortOrder": 8,
      "startOffset": 23,
      "endOffset": 23,
      "createdAt": "2025-09-03T02:50:52.544Z",
      "updatedAt": "2025-09-03T02:50:52.544Z",
      "targetId": "8604ddc3-2341-455b-bdd1-597e3b01eca0",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "1953a5d6-d496-43e0-972f-6cb83cf71b93",
      "content": "*Ngập ngừng e ngại*, ds : *thẹn thùng phải giáp mặt*.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "10",
      "sortOrder": 9,
      "startOffset": 41,
      "endOffset": 41,
      "createdAt": "2025-09-03T02:50:52.589Z",
      "updatedAt": "2025-09-03T02:50:52.589Z",
      "targetId": "5f62fc21-c6db-409a-8402-1fd308822d51",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "39d271a3-817c-4e21-a3d2-9487d1c10868",
      "content": "*Bừa bãi* : có thể hiểu là nói ngược nói xuôi, hoặc nói lại điều người khác nói chẳng liên quan gì tới mình, nói một cách vô ý thức. Trái lại người khôn thì đắn đo cân nhắc lời nói của mình.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "11",
      "sortOrder": 10,
      "startOffset": 28,
      "endOffset": 28,
      "createdAt": "2025-09-03T02:50:52.674Z",
      "updatedAt": "2025-09-03T02:50:52.674Z",
      "targetId": "6f256342-ccf4-4c17-8b73-41ecb928ad03",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "dbd1cba4-c524-49f1-90be-1a891146b041",
      "content": "ds : *Trái tim những kẻ ngu đần nằm nơi miệng chúng, còn miệng của những người khôn thì ở trong trái tim họ*.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "12",
      "sortOrder": 11,
      "startOffset": 33,
      "endOffset": 33,
      "createdAt": "2025-09-03T02:50:52.730Z",
      "updatedAt": "2025-09-03T02:50:52.730Z",
      "targetId": "bb3e75b6-c29c-4a6b-ae9a-c3c212d6569c",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "09577058-b26b-4795-87b4-c9f0f6990931",
      "content": "English: Satan | French: Satan | Latin: Satan | Origin: &#64299;&#1464;&#1496;&#1464;&#1503; -- &#931;&#945;&#964;&#945;&#957;&#945;&#962; | Vietnamese: Xa-tan -- ma quỷ, G 1,6 ; 1 Sb 21,1 ; Mt 4,10",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "13",
      "sortOrder": 12,
      "startOffset": 27,
      "endOffset": 27,
      "createdAt": "2025-09-03T02:50:52.759Z",
      "updatedAt": "2025-09-03T02:50:52.759Z",
      "targetId": "6399b90c-1808-423e-b058-47be3d59675c",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    },
    {
      "id": "f5f7c9ef-0d8f-4dfb-8fa5-48db80bb79aa",
      "content": "*Xa-tan* nguyên nghĩa Híp-ri là *thù địch*, sau mới trở thành tên riêng một chủ thể ác hiểm luôn đối nghịch với con người, tức là ma quỷ. Mặc dù thời ông Ben Xi-ra, Xa-tan đã có nghĩa tên riêng (x. G 1-2 ; 1 Sb 21,1 so với 2 Sm 24,1), nhưng hình như ở đây tác giả vẫn hiểu theo nguyên nghĩa. Như vậy *thù địch* của kẻ vô đạo hiểu là một người Híp-ri, và theo lời Thiên Chúa hứa với tổ phụ Áp-ra-ham ở St 12,3 thì kẻ vô đạo nguyền rủa tín hữu của Thiên Chúa là chuốc vào thân lời nguyền rủa của chính mình.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "14",
      "sortOrder": 13,
      "startOffset": 27,
      "endOffset": 27,
      "createdAt": "2025-09-03T02:50:52.773Z",
      "updatedAt": "2025-09-03T02:50:52.773Z",
      "targetId": "6399b90c-1808-423e-b058-47be3d59675c",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "84cef9fc-1315-4215-af18-7ec2661b0da8"
    }
  ],
