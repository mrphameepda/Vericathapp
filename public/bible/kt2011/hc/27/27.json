{
  "chapter": {
    "id": "24271a6e-0380-4525-ae79-f4f839595913",
    "number": 27,
    "createdAt": "2025-09-03T01:07:51.705Z",
    "updatedAt": "2025-09-03T01:07:51.705Z",
    "bookId": "5c66a463-0bfa-46b7-9af1-3766a8779b73"
  },
  "verses": [
    {
      "id": "1c270582-ecf6-400f-83be-3dec1d11ba1b",
      "text": "Vì ham lợi mà nhiều người mắc lỗi,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:43.751Z",
      "updatedAt": "2025-09-03T02:51:43.751Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "01136757-ca0e-48af-82cc-8e8c3e62b365",
      "text": "mải làm giàu, người ta cứ ngoảnh mặt làm ngơ.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:43.772Z",
      "updatedAt": "2025-09-03T02:51:43.772Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "7a2a1c8f-4e84-42c9-8830-360f5dc17dc4",
      "text": "Chiếc cọc cắm sâu vào kẽ đá,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:43.793Z",
      "updatedAt": "2025-09-03T02:51:43.793Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "ced87c81-73f4-4a7d-954f-4e5313019242",
      "text": "tội lỗi cũng ăn sâu vào việc mua đi bán lại.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:43.804Z",
      "updatedAt": "2025-09-03T02:51:43.804Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "854f9a01-e91f-4a30-8c5f-097b244e22c8",
      "text": "Ai không bền lòng kính sợ Đức Chúa,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:43.827Z",
      "updatedAt": "2025-09-03T02:51:43.827Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "8070dc91-6739-4f7c-964e-dc0f5faa94ff",
      "text": "cửa nhà người đó sẽ sớm bị sụp đổ.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:43.841Z",
      "updatedAt": "2025-09-03T02:51:43.841Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "904ac1aa-6c6b-4182-8d44-6accd1fde182",
      "text": "Sàng rồi, trấu ở lại sàng,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:43.855Z",
      "updatedAt": "2025-09-03T02:51:43.855Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "1ce376b8-5256-4839-82df-6b940a38dc0b",
      "text": "nói ra, cái dở rõ ràng thấy ngay.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:43.883Z",
      "updatedAt": "2025-09-03T02:51:43.883Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "2f3451b5-2766-4b04-80e9-06087ccb2d6e",
      "text": "Có thử lửa mới biết bình thợ gốm,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:43.897Z",
      "updatedAt": "2025-09-03T02:51:43.897Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "4a1375ef-f0f9-4517-a01b-9a649f0cba48",
      "text": "nghe chuyện trò, biết ai rởm ai hay.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:43.911Z",
      "updatedAt": "2025-09-03T02:51:43.911Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "f40fa501-c5ce-42f6-9a1f-b6f7bc7bb7dd",
      "text": "Xem quả thì biết vườn cây,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:43.924Z",
      "updatedAt": "2025-09-03T02:51:43.924Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "3b9e7043-85f4-436f-a3a5-f5cc491d9682",
      "text": "nghe lời miệng nói biết ngay lòng người.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:43.950Z",
      "updatedAt": "2025-09-03T02:51:43.950Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "7a64db15-5bc6-4015-a0cd-9acfb4779a03",
      "text": "Chớ vội khen, khi người chưa lên tiếng :",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:43.961Z",
      "updatedAt": "2025-09-03T02:51:43.961Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "1d3efce5-3b59-4ecb-92b4-b62c078595b1",
      "text": "muốn biết người, phải nghe miệng nói năng.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:43.972Z",
      "updatedAt": "2025-09-03T02:51:43.972Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "920018ce-fa2f-4fdf-9c52-f1dbd9c0ad10",
      "text": "Theo đuổi sự công chính, rồi ra con sẽ đạt,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:43.984Z",
      "updatedAt": "2025-09-03T02:51:43.984Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "1b19ece4-feb9-4924-ba6a-92c0cbf1d966",
      "text": "con sẽ mặc lấy nó như tấm áo huy hoàng.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.008Z",
      "updatedAt": "2025-09-03T02:51:44.008Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "bb9d1730-9f6c-4802-ade3-a30a6ff07611",
      "text": "Chim cùng loại tìm đậu chung một chỗ,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.020Z",
      "updatedAt": "2025-09-03T02:51:44.020Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "7ad44729-1fd0-4eef-8b33-b4422cd6ba66",
      "text": "sự thật tìm về với những kẻ chân thật.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.037Z",
      "updatedAt": "2025-09-03T02:51:44.037Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "db6bdd22-dda9-499e-b96a-ce819f8763fd",
      "text": "Sư tử rình mồi,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.051Z",
      "updatedAt": "2025-09-03T02:51:44.051Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "855cff76-db71-48d8-885a-3f220c74905b",
      "text": "tội lỗi cũng rình rập những kẻ làm điều bất chính.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.065Z",
      "updatedAt": "2025-09-03T02:51:44.065Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "d64a589c-e003-431b-8982-ba47f1e555c4",
      "text": "Người đạo hạnh luôn ăn nói khôn ngoan,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.079Z",
      "updatedAt": "2025-09-03T02:51:44.079Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "2059c6c8-39e8-4678-867e-71bc94287259",
      "text": "kẻ dại khờ thì như mặt trăng hay thay đổi.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.093Z",
      "updatedAt": "2025-09-03T02:51:44.093Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "1f72d00c-b899-425a-9c1b-f4fb34c79689",
      "text": "Với kẻ ngu si, con đừng mất thì giờ,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.107Z",
      "updatedAt": "2025-09-03T02:51:44.107Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "bcfae75b-e7b7-4c5f-b281-a7ffcc157d2b",
      "text": "với người hiểu biết, con hãy rán ngồi lại.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.141Z",
      "updatedAt": "2025-09-03T02:51:44.141Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "07ede337-b803-42db-bcb3-7d28c98fb703",
      "text": "Bọn đần độn nói ra là gây bực tức,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.155Z",
      "updatedAt": "2025-09-03T02:51:44.155Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "2ceabffc-1793-49da-8cdc-17ef4da2a271",
      "text": "chúng phá lên cười giữa thú vui tội lỗi.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.183Z",
      "updatedAt": "2025-09-03T02:51:44.183Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "a347408e-4600-482b-9745-83101407cf60",
      "text": "Kẻ hay thề mở miệng là người ta dựng tóc gáy,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.197Z",
      "updatedAt": "2025-09-03T02:51:44.197Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "ae7d7c40-b2bc-4b32-af7c-d9eefde86e1a",
      "text": "nghe chúng cãi cọ là phải bịt tai.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.225Z",
      "updatedAt": "2025-09-03T02:51:44.225Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "f656ec47-3a7e-4db7-93c8-d1388375a949",
      "text": "Bọn kiêu ngạo cãi nhau là đổ máu,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.239Z",
      "updatedAt": "2025-09-03T02:51:44.239Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "c7dd5f78-8c72-4fb0-accf-9975f7506b8b",
      "text": "chẳng ai nghe nổi lời chúng nhục mạ nhau.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.253Z",
      "updatedAt": "2025-09-03T02:51:44.253Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "d3787644-f2f8-4d56-a8da-2f4875692fc5",
      "text": "Tiết lộ bí mật thì chẳng còn ai tin,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.266Z",
      "updatedAt": "2025-09-03T02:51:44.266Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "b091be68-263f-49af-a497-a67fae2d103e",
      "text": "và không kiếm được bạn tâm tình nữa.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.294Z",
      "updatedAt": "2025-09-03T02:51:44.294Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "b6eae1b4-642c-41c2-9910-3f550ea9832a",
      "text": "Hãy tha thiết với bạn bè và hết lòng trung tín,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.320Z",
      "updatedAt": "2025-09-03T02:51:44.320Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "30c5068e-5d41-4ec0-bb37-e7642ef3bc01",
      "text": "nhưng nếu đã tiết lộ bí mật của ai,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.332Z",
      "updatedAt": "2025-09-03T02:51:44.332Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "17e020e0-3412-4e16-85ac-bf5a3fe0543e",
      "text": "thì đừng chạy theo họ nữa.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 2,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.343Z",
      "updatedAt": "2025-09-03T02:51:44.343Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "c2dede86-6c2b-43c1-a5e2-6c5079651ec9",
      "text": "Vì, như ai đó mất đi kẻ mình để cho chết,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.354Z",
      "updatedAt": "2025-09-03T02:51:44.354Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "4bca0d30-a252-4f96-a78e-3a61eb638613",
      "text": "con cũng đánh mất tình bạn của người thân.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.379Z",
      "updatedAt": "2025-09-03T02:51:44.379Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "55f57727-7e85-4e3a-8665-9f4af68a065e",
      "text": "Chim trong tay, con để bay vụt mất,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.392Z",
      "updatedAt": "2025-09-03T02:51:44.392Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "ab54dd2f-c1f8-470f-ae30-6dea2f7fe376",
      "text": "để mất người thân, con chẳng gặp lại đâu.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.405Z",
      "updatedAt": "2025-09-03T02:51:44.405Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "2d4f7606-7207-42b5-84d3-9187cd8c5bf1",
      "text": "Đừng chạy theo họ : họ xa quá rồi,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.418Z",
      "updatedAt": "2025-09-03T02:51:44.418Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "da2f0095-826e-45e0-86d6-7371c56529c5",
      "text": "họ thoát được con như sơn dương thoát bẫy.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.431Z",
      "updatedAt": "2025-09-03T02:51:44.431Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "63030eba-3f30-49f4-b2a0-40b4e1932100",
      "text": "Vết thương có thể băng bó, lăng nhục có thể bỏ qua,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.445Z",
      "updatedAt": "2025-09-03T02:51:44.445Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "f4245588-52d0-44cf-a69c-85b284468d78",
      "text": "chứ tiết lộ bí mật rồi thì chẳng còn chi hy vọng.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.459Z",
      "updatedAt": "2025-09-03T02:51:44.459Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "9f54df6b-f51b-4aea-b94a-c385bc7c0e76",
      "text": "Kẻ nháy mắt thì mưu đồ điều xấu xa,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.473Z",
      "updatedAt": "2025-09-03T02:51:44.473Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "458d53b5-194a-466d-b703-94866f24b1d4",
      "text": "và không ai làm cho nó bỏ được.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.514Z",
      "updatedAt": "2025-09-03T02:51:44.514Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "14418948-398c-4331-80dc-1cc34f0287f6",
      "text": "Trước mắt con, nó nói năng ngọt xớt,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.543Z",
      "updatedAt": "2025-09-03T02:51:44.543Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "98c10a30-327f-47e6-bce3-bc77256beebf",
      "text": "sững sờ kinh ngạc trước từng lời của con,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.557Z",
      "updatedAt": "2025-09-03T02:51:44.557Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "2dd2665c-3d1c-45a6-bb8c-810f9ad9d065",
      "text": "nhưng sau lưng, nó đổi cung đổi giọng,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 2,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.571Z",
      "updatedAt": "2025-09-03T02:51:44.571Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "c158d948-f1bb-4dc0-ad04-03882501aa8d",
      "text": "biến lời con thành những điều gai chướng.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 3,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.585Z",
      "updatedAt": "2025-09-03T02:51:44.585Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "1eadef09-98fe-4598-8784-009d7fa61d79",
      "text": "Tôi vốn ghét nhiều điều,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.613Z",
      "updatedAt": "2025-09-03T02:51:44.613Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "9a0be39b-0204-497d-b13f-afc56d666710",
      "text": "nhưng chẳng ghét chi bằng hạng người đó",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.627Z",
      "updatedAt": "2025-09-03T02:51:44.627Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "d5cbcf0e-c5a1-4eb1-ba85-941d2ae04d59",
      "text": "và Đức Chúa cũng sẽ ghét nữa.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 2,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.641Z",
      "updatedAt": "2025-09-03T02:51:44.641Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "9362a75c-1bc2-49c0-8a40-e929a332e369",
      "text": "Tung đá lên cao, đá sẽ rớt xuống đầu mình.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.656Z",
      "updatedAt": "2025-09-03T02:51:44.656Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "682df716-e49f-4938-87e7-fc82564af5cd",
      "text": "Đánh lén người, sẽ bị người đánh lại đau hơn.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.676Z",
      "updatedAt": "2025-09-03T02:51:44.676Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "23b83f26-caa9-4b58-b2fc-d0364420e88b",
      "text": "Ai đào hố sẽ sa xuống hố,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.704Z",
      "updatedAt": "2025-09-03T02:51:44.704Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "926a6a5a-60f5-4962-bef5-7748400c2939",
      "text": "kẻ gài bẫy sẽ mắc vào bẫy.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.732Z",
      "updatedAt": "2025-09-03T02:51:44.732Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "a0f20d4d-dc88-4de2-abf6-fd7e4078cbb3",
      "text": "Ai làm điều xấu sẽ bị cái xấu đè bẹp",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.746Z",
      "updatedAt": "2025-09-03T02:51:44.746Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "7d9675ed-c2b7-41c7-b93d-3db166e205a6",
      "text": "mà chẳng biết cái xấu đến từ đâu.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.760Z",
      "updatedAt": "2025-09-03T02:51:44.760Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "f94e82d9-894d-4651-ae65-5e53ec89d8c4",
      "text": "Kẻ kiêu căng chuyên nhục mạ, châm biếm,",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.774Z",
      "updatedAt": "2025-09-03T02:51:44.774Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "07368be2-b09b-40b5-b9ab-7e23c05c1b60",
      "text": "nhưng luôn có nguy cơ bị báo thù",
      "label": "28",
      "number": 28,
      "subVerseIndex": 1,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.788Z",
      "updatedAt": "2025-09-03T02:51:44.788Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "c6cd3477-8fe7-42db-82b5-95d516330c9b",
      "text": "như con mồi luôn bị sư tử rình rập.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 2,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.803Z",
      "updatedAt": "2025-09-03T02:51:44.803Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "564f776b-0434-4fff-b2d7-34fc61210d38",
      "text": "Ai thấy kẻ lành vấp ngã mà vui mừng,",
      "label": "29",
      "number": 29,
      "subVerseIndex": 0,
      "paragraphNumber": 61,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.817Z",
      "updatedAt": "2025-09-03T02:51:44.817Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "56a4488f-af79-4f9d-ad68-8f1bee1ed014",
      "text": "người đó sẽ sa bẫy,",
      "label": "29",
      "number": 29,
      "subVerseIndex": 1,
      "paragraphNumber": 62,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.831Z",
      "updatedAt": "2025-09-03T02:51:44.831Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "cca7f722-77df-494c-b042-294b9298c360",
      "text": "sẽ bị đau khổ giày vò ngay khi còn sống.",
      "label": "29",
      "number": 29,
      "subVerseIndex": 2,
      "paragraphNumber": 63,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.845Z",
      "updatedAt": "2025-09-03T02:51:44.845Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "9b5c753c-74c9-441e-ae2d-e5e1734cc56b",
      "text": "Oán hờn và giận dữ là những điều ghê tởm,",
      "label": "30",
      "number": 30,
      "subVerseIndex": 0,
      "paragraphNumber": 64,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.873Z",
      "updatedAt": "2025-09-03T02:51:44.873Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "2005b8a3-99b0-41d9-bd87-67c246b03591",
      "text": "về chuyện đó kẻ tội lỗi có biệt tài.",
      "label": "30",
      "number": 30,
      "subVerseIndex": 1,
      "paragraphNumber": 65,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:44.900Z",
      "updatedAt": "2025-09-03T02:51:44.900Z",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    }
  ],
  "marks": [
    {
      "id": "f744d13d-65d8-4924-81eb-51488aceef36",
      "content": "*Ngoảnh mặt làm ngơ* : đối với Thiên Chúa, để tự do sử dụng những phương tiện bất chính kiếm cho thật nhiều tiền ; đối với người nghèo để khỏi phải cảm thương giúp đỡ (x. 4,5 ; Cn 28,27).",
      "kind": "MARK_KIND_FOOTNOTE",
