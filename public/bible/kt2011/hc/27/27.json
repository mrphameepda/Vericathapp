      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "24271a6e-0380-4525-ae79-f4f839595913"
    },
    {
      "id": "76178240-9110-4243-981d-0766c394e6af",
      "content": "Hc 22,22",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 19,
      "endOffset": 19,
      "createdAt": "2025-09-03T02:51:44.308Z",
      "updatedAt": "2025-09-03T02:51:44.308Z",
      "targetId": "b091be68-263f-49af-a497-a67fae2d103e",
      "targetType": "MARK_TARGET_TYPE_VERSE",
