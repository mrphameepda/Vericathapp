      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "4ec6eab1-8646-4a22-b536-2341e3ac9157",
      "content": "Người giàu có và kẻ khoẻ mạnh thường dễ buông theo những cuộc tranh luận cãi vã quá đáng. Hai vế c.10cd song song đồng nghĩa với nhau.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
