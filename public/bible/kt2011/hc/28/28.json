{
  "chapter": {
    "id": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8",
    "number": 28,
    "createdAt": "2025-09-03T01:07:51.705Z",
    "updatedAt": "2025-09-03T01:07:51.705Z",
    "bookId": "5c66a463-0bfa-46b7-9af1-3766a8779b73"
  },
  "verses": [
    {
      "id": "806c48e7-81a6-47e4-b22f-14dcc749510f",
      "text": "Kẻ báo thù sẽ chuốc lấy báo thù của Đức Chúa,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:50.628Z",
      "updatedAt": "2025-09-03T02:51:50.628Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "ade8d24d-a37a-41cf-9a17-1a3fbe576eba",
      "text": "tội lỗi nó, Người xem xét từng ly.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:50.648Z",
      "updatedAt": "2025-09-03T02:51:50.648Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "28e5dbb9-8827-4979-b6aa-c693e6bc3888",
      "text": "Hãy bỏ qua điều sai trái cho kẻ khác,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:50.659Z",
      "updatedAt": "2025-09-03T02:51:50.659Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "8f3091c2-a7cd-41c2-b18a-70a85f73f6d4",
      "text": "thì khi bạn cầu khẩn, tội lỗi bạn sẽ được tha.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:50.681Z",
      "updatedAt": "2025-09-03T02:51:50.681Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "da730f25-980d-4b51-ad10-c6d84e410290",
      "text": "Người với người cứ nuôi lòng hờn giận,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:50.692Z",
      "updatedAt": "2025-09-03T02:51:50.692Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "caa0a9f9-01ad-484b-83bb-67b495295cbb",
      "text": "thế mà lại xin Đức Chúa chữa lành !",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:50.708Z",
      "updatedAt": "2025-09-03T02:51:50.708Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "44156e47-d8d4-4893-a084-20ffe6aa472b",
      "text": "Nó chẳng biết thương người đồng loại,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:50.736Z",
      "updatedAt": "2025-09-03T02:51:50.736Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "b66aec42-7723-4664-aa96-1cbe8d8fd97d",
      "text": "mà lại dám xin tha tội cho mình !",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:50.764Z",
      "updatedAt": "2025-09-03T02:51:50.764Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "57621e8f-6e42-4a38-b0db-fc233412575e",
      "text": "Nó chỉ là người phàm mà để tâm thù hận,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:50.778Z",
      "updatedAt": "2025-09-03T02:51:50.778Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "1e734f27-53f7-4548-86f0-f7d579582fa0",
      "text": "thì ai sẽ xin tha tội cho nó ?",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:50.806Z",
      "updatedAt": "2025-09-03T02:51:50.806Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "79eaa47f-2f48-4501-9b51-c00899e2cfaf",
      "text": "Hãy nhớ đến ngày tận số",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:50.821Z",
      "updatedAt": "2025-09-03T02:51:50.821Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "345e9496-180f-43ad-bd99-9e1485776121",
      "text": "mà chấm dứt hận thù,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:50.849Z",
      "updatedAt": "2025-09-03T02:51:50.849Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "1e206004-f789-43e2-a30a-71dd6781e221",
      "text": "nhớ mình sẽ phải hao mòn và phải chết",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:50.863Z",
      "updatedAt": "2025-09-03T02:51:50.863Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "83d86149-978f-41ca-b7df-19b92a995d36",
      "text": "mà trung thành giữ các điều răn.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 3,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:50.877Z",
      "updatedAt": "2025-09-03T02:51:50.877Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "5c841984-244e-4aee-81c4-8f22590adbe9",
      "text": "Hãy nhớ đến các điều răn",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:50.891Z",
      "updatedAt": "2025-09-03T02:51:50.891Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "01d0f730-4f8b-4121-a0f5-79366815c194",
      "text": "mà đừng oán hờn kẻ khác,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:50.905Z",
      "updatedAt": "2025-09-03T02:51:50.905Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "a456878c-1d4e-4eb2-9756-fe3ccf332da3",
      "text": "nhớ đến giao ước của Đấng Tối Cao",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:50.934Z",
      "updatedAt": "2025-09-03T02:51:50.934Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "06fbaccf-d9a3-45b9-8356-5221e20bb41b",
      "text": "mà không chấp nhất điều lầm lỗi.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 3,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:50.963Z",
      "updatedAt": "2025-09-03T02:51:50.963Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "f6d088e3-edf9-4e72-80fc-d08cbfdee245",
      "text": "Tránh đôi co, con sẽ bớt phạm tội,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:50.980Z",
      "updatedAt": "2025-09-03T02:51:50.980Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "e700bbaa-5131-4f22-a007-70b83c4091d4",
      "text": "vì người hung hăng thì hay gây gổ.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.022Z",
      "updatedAt": "2025-09-03T02:51:51.022Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "016fdf27-15fe-4488-84fb-e001a851590a",
      "text": "Người tội lỗi làm cho bè bạn nên bất hoà,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.036Z",
      "updatedAt": "2025-09-03T02:51:51.036Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "a715ddc3-ce7b-49b3-acd5-afec9a667299",
      "text": "gây chia rẽ giữa những người hoà thuận.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.051Z",
      "updatedAt": "2025-09-03T02:51:51.051Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "1ce2c07b-dc9d-416b-b39c-8041a4d15293",
      "text": "Củi khô thì lửa bốc, càng nóng càng cãi hăng,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.064Z",
      "updatedAt": "2025-09-03T02:51:51.064Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "77f7951a-734c-4a92-a1a6-9cbd24562506",
      "text": "càng khoẻ càng nóng tính, càng giàu càng dễ giận.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.100Z",
      "updatedAt": "2025-09-03T02:51:51.100Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "2047dddf-e885-4cd1-8227-7f5818b623b5",
      "text": "Tự nhiên gây gổ là châm mồi cho lửa,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.128Z",
      "updatedAt": "2025-09-03T02:51:51.128Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "efbdee11-68d9-4e6d-b847-809df26b4af9",
      "text": "khi không giành giật là gây chuyện đổ máu.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.142Z",
      "updatedAt": "2025-09-03T02:51:51.142Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "3376e27f-152f-4d4a-898d-a2e02ac4ca29",
      "text": "Thổi vào tàn lửa, lửa sẽ bùng lên,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.156Z",
      "updatedAt": "2025-09-03T02:51:51.156Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "9f7c7ccb-3309-4696-b140-b08e2468fe2f",
      "text": "nhổ lên nó, nó sẽ tắt ngúm.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.171Z",
      "updatedAt": "2025-09-03T02:51:51.171Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "921fb658-69c1-41de-a542-bef6cd073a7c",
      "text": "Tất cả đều do miệng của con.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.185Z",
      "updatedAt": "2025-09-03T02:51:51.185Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "d2e29b10-d57b-450d-888e-0cb96af9dad2",
      "text": "Đáng nguyền rủa thay kẻ nói xấu, nói hành, kẻ nói lời hai ý,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.214Z",
      "updatedAt": "2025-09-03T02:51:51.214Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "78b8f3cb-1f70-45da-8998-2cf6c106a8f9",
      "text": "gây chia rẽ giữa bao người đang hoà thuận.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.255Z",
      "updatedAt": "2025-09-03T02:51:51.255Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "7ce6d9c3-5bfc-4f6b-9f7e-db7f0cd18883",
      "text": "Còn có kẻ nói một lời ba bốn ý :",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.283Z",
      "updatedAt": "2025-09-03T02:51:51.283Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "560abbc8-d637-4bc5-b743-eea9e98b8019",
      "text": "chính vì nó mà bao nhiêu người phải chao đảo,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.311Z",
      "updatedAt": "2025-09-03T02:51:51.311Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "47f66e7f-c9b1-41e6-a825-d51b331989ee",
      "text": "lưu lạc từ nước nọ tới nước kia.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 2,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.324Z",
      "updatedAt": "2025-09-03T02:51:51.324Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "acde0778-d2da-4982-b8d5-701fbe7768ea",
      "text": "Cũng vì nó mà các thành trì kiên cố phải sụp đổ,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 3,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.335Z",
      "updatedAt": "2025-09-03T02:51:51.335Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "69930ff8-db22-4a7e-baa9-5477fbb4af1a",
      "text": "nhà cửa những người quyền quý phải tan hoang.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 4,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.347Z",
      "updatedAt": "2025-09-03T02:51:51.347Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "c14424be-b92e-454c-9ebd-b0720cf5a90d",
      "text": "Kẻ nói một lời ba bốn ý",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.358Z",
      "updatedAt": "2025-09-03T02:51:51.358Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "de6b820d-3495-4c68-9c12-cedaba1324fb",
      "text": "còn làm bao nhiêu người vợ đảm đang bị chồng bỏ,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.369Z",
      "updatedAt": "2025-09-03T02:51:51.369Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "00106807-bf57-481f-b492-734e0b56f7e4",
      "text": "không được hưởng công lao khó nhọc của mình.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 2,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.382Z",
      "updatedAt": "2025-09-03T02:51:51.382Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "5a89911c-a195-4cc8-9fd7-23f3ae98643f",
      "text": "Ai nghe theo nó sẽ không được nghỉ ngơi,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.395Z",
      "updatedAt": "2025-09-03T02:51:51.395Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "745a0b2b-a537-48d2-9296-e074a17739cd",
      "text": "không được sống yên hàn.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.410Z",
      "updatedAt": "2025-09-03T02:51:51.410Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "fb4a529b-7b92-474d-a59e-6656149d0255",
      "text": "Đòn vọt làm thân thể bầm tím,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.424Z",
      "updatedAt": "2025-09-03T02:51:51.424Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "8fc3af49-37cc-4687-8d26-a21b0d4c139f",
      "text": "nhưng cái lưỡi làm dập gẫy cả xương.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.438Z",
      "updatedAt": "2025-09-03T02:51:51.438Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "33321b82-bbd1-422e-83a0-dad64024158f",
      "text": "Có nhiều kẻ gục ngã vì lưỡi kiếm,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.467Z",
      "updatedAt": "2025-09-03T02:51:51.467Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "ddc84835-4388-41c5-9b68-38a74b35d5ee",
      "text": "nhưng làm sao sánh được",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.482Z",
      "updatedAt": "2025-09-03T02:51:51.482Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "211e28bd-253c-47fe-843e-5b08db386ac2",
      "text": "với những kẻ gục ngã vì lưỡi người ?",
      "label": "18",
      "number": 18,
      "subVerseIndex": 2,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.496Z",
      "updatedAt": "2025-09-03T02:51:51.496Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "48032a0a-a92a-46dd-9059-97e3f6dd3390",
      "text": "Phúc thay ai ẩn mình xa cái lưỡi,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.516Z",
      "updatedAt": "2025-09-03T02:51:51.516Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "b711bae3-d610-4a75-8538-fa5ad93470a4",
      "text": "không gặp phải lúc nó nổi lôi đình,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.548Z",
      "updatedAt": "2025-09-03T02:51:51.548Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "830329d1-40ba-465a-ab40-89d8968a4723",
      "text": "không phải kéo lê cái ách của nó,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 2,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.562Z",
      "updatedAt": "2025-09-03T02:51:51.562Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "e45a4a58-961d-4869-95f3-c420e942da3e",
      "text": "không bị nó trói buộc bằng xiềng xích gông cùm.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 3,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.577Z",
      "updatedAt": "2025-09-03T02:51:51.577Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "55d29052-b78c-4524-b7ac-aa83307c203b",
      "text": "Vì ách của cái lưỡi là ách sắt,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.591Z",
      "updatedAt": "2025-09-03T02:51:51.591Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "05dd627b-b582-495e-9046-9547a9fa8e69",
      "text": "và xiềng của nó là xiềng đồng.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.605Z",
      "updatedAt": "2025-09-03T02:51:51.605Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "cc443f89-f4b1-4ee7-91f2-acdffbfb28a4",
      "text": "Thật là thê thảm, cái chết nó gây ra,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.619Z",
      "updatedAt": "2025-09-03T02:51:51.619Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "f0e31b78-86ab-4216-9aca-5a75f2e9a604",
      "text": "nhưng vào âm phủ còn hơn chịu đựng nó.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.633Z",
      "updatedAt": "2025-09-03T02:51:51.633Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "87d8b218-75d1-4170-8acb-9d551a1f352e",
      "text": "Chỉ có người đạo đức là nó chẳng làm chi được,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.647Z",
      "updatedAt": "2025-09-03T02:51:51.647Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "cbed11da-4bdd-42ec-9334-88b5b28dd31a",
      "text": "nó cũng không thiêu đốt được họ trong lửa của nó.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.661Z",
      "updatedAt": "2025-09-03T02:51:51.661Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "a806bde2-226f-4018-b70c-707cc0ee06c4",
      "text": "Còn những kẻ xa lìa Đức Chúa sẽ bị nó nuốt chửng",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.690Z",
      "updatedAt": "2025-09-03T02:51:51.690Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "2bf616d7-419c-47fe-8831-4fc22228815b",
      "text": "và thiêu đốt không ngơi.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.704Z",
      "updatedAt": "2025-09-03T02:51:51.704Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "0e27ce79-9171-459a-b75d-8033f49fe624",
      "text": "Như con sư tử, nó nhảy chồm lên họ,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 2,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.718Z",
      "updatedAt": "2025-09-03T02:51:51.718Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "37392208-a270-46c8-9ccc-62a32a448cc0",
      "text": "như con báo, nó xé họ nát thây.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 3,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.731Z",
      "updatedAt": "2025-09-03T02:51:51.731Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "67db94e3-a484-4b5c-b739-439d18c77356",
      "text": "Này, nhà cửa ruộng vườn, hãy lấy gai rào lại,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.742Z",
      "updatedAt": "2025-09-03T02:51:51.742Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "c66c1cfd-a682-4ab9-a850-f1555e9432c9",
      "text": "bạc vàng của con, hãy cột cho thật chắc.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 61,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.754Z",
      "updatedAt": "2025-09-03T02:51:51.754Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "01fa38ef-1570-4df9-ad53-793be202e0a0",
      "text": "Ăn nói thì phải cân nhắc đắn đo,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 62,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.767Z",
      "updatedAt": "2025-09-03T02:51:51.767Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "469c9d73-1df9-413a-afb5-9a4b594c97a7",
      "text": "miệng con phải như là cửa có khoá.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 63,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.780Z",
      "updatedAt": "2025-09-03T02:51:51.780Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "06893269-fda8-43e8-923d-5044eaf9ac90",
      "text": "Hãy ý tứ, đừng để lỡ lời,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 64,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.808Z",
      "updatedAt": "2025-09-03T02:51:51.808Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    },
    {
      "id": "231c5390-cb8d-4be4-b4f5-705a5b4da81f",
      "text": "kẻo vấp ngã trước kẻ rình rập con.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 65,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:51.836Z",
      "updatedAt": "2025-09-03T02:51:51.836Z",
      "chapterId": "59e46d9c-4a18-46fe-a2ee-81643d37c6b8"
    }
  ],
