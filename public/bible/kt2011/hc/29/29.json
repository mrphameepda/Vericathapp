{
  "chapter": {
    "id": "84d5743a-a41c-48ac-8e5f-5c86149625fa",
    "number": 29,
    "createdAt": "2025-09-03T01:07:51.705Z",
    "updatedAt": "2025-09-03T01:07:51.705Z",
    "bookId": "5c66a463-0bfa-46b7-9af1-3766a8779b73"
  },
  "verses": [
    {
      "id": "d6ead88c-d55d-4da3-96a8-ccc9dc86fbda",
      "text": "Kẻ thương người thì biết cho vay mượn,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:58.363Z",
      "updatedAt": "2025-09-03T02:51:58.363Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "fc95d200-8292-4879-9ae6-7f216108622b",
      "text": "tiếp tay với người là tuân giữ điều răn.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:58.404Z",
      "updatedAt": "2025-09-03T02:51:58.404Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "11c00fea-f9df-48c0-8b0c-e4413066a3b6",
      "text": "Khi người ta cần, con hãy cho vay mượn,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:58.415Z",
      "updatedAt": "2025-09-03T02:51:58.415Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "055353fd-dd56-492d-a16b-34cda79027a1",
      "text": "khi con vay mượn, hãy trả đúng hạn kỳ.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:58.427Z",
      "updatedAt": "2025-09-03T02:51:58.427Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "f0357370-f525-4df2-b565-90994633e7c4",
      "text": "Hãy giữ lời và trung tín luôn luôn,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:58.440Z",
      "updatedAt": "2025-09-03T02:51:58.440Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "d0e51bb4-9c7b-4686-9805-ff31c99f238d",
      "text": "thì bất cứ lúc nào cần điều chi, con cũng sẽ được.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:58.454Z",
      "updatedAt": "2025-09-03T02:51:58.454Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "2d65ba29-17eb-496b-877b-c09e058d4fcf",
      "text": "Nhiều người coi của vay mượn như của nhặt ngoài đường,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:58.468Z",
      "updatedAt": "2025-09-03T02:51:58.468Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "d09cd6e5-ceb5-4c76-b0a4-ed287e743362",
      "text": "khiến ai giúp họ cũng buồn phiền chán nản.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:58.497Z",
      "updatedAt": "2025-09-03T02:51:58.497Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "eab72432-d1d6-44a9-8d13-1243afd94edb",
      "text": "Trước khi nhận, họ hôn tay chủ nợ,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:58.512Z",
      "updatedAt": "2025-09-03T02:51:58.512Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "058c4d68-13bd-40cb-a62f-14f6f29a290c",
      "text": "nói ngon nói ngọt về của cải người ta,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:58.526Z",
      "updatedAt": "2025-09-03T02:51:58.526Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "ef9c08b6-2497-49be-9b8b-dd29894d536b",
      "text": "nhưng đến hạn trả thì lại khất lần,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:58.541Z",
      "updatedAt": "2025-09-03T02:51:58.541Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "5e90f7c1-fe24-4f7f-9b60-70f742515efa",
      "text": "thay vì trả, chỉ buông lời than tiếc",
      "label": "5",
      "number": 5,
      "subVerseIndex": 3,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:58.554Z",
      "updatedAt": "2025-09-03T02:51:58.554Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "b4002559-7de5-4249-9c80-fa8abe542ba4",
      "text": "và còn đổ thừa cho hoàn cảnh.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 4,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:58.570Z",
      "updatedAt": "2025-09-03T02:51:58.570Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "b435e719-5129-4bb5-b7d7-e86336ca6271",
      "text": "Họ có sức trả phân nửa đã là may,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:58.595Z",
      "updatedAt": "2025-09-03T02:51:58.595Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "822227ed-b750-467e-ae41-4f0d60d3eb87",
      "text": "và chủ nợ coi như đã nhặt được của ngoài đường.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:58.609Z",
      "updatedAt": "2025-09-03T02:51:58.609Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "a8e2e684-3981-42fb-a7c9-1f4448169739",
      "text": "Còn không thì chủ nợ mất toi tiền bạc,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:58.622Z",
      "updatedAt": "2025-09-03T02:51:58.622Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "3defc4dc-f25d-4572-9c88-53f540f93ef1",
      "text": "và vô cớ lại có thêm một kẻ thù,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 3,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:58.638Z",
      "updatedAt": "2025-09-03T02:51:58.638Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "41140505-e4af-49ee-abd5-afa98530adef",
      "text": "chỉ lăng mạ chửi bới thay vì trả nợ,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 4,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:58.652Z",
      "updatedAt": "2025-09-03T02:51:58.652Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "ec5d9b34-331c-4bd3-80c7-9704eff60258",
      "text": "chỉ khinh khi thay vì tôn kính.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 5,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:58.666Z",
      "updatedAt": "2025-09-03T02:51:58.666Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "fa2b0881-4890-47ea-9ab2-fb4a4c85eaf8",
      "text": "Nhiều người không cho vay",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:58.680Z",
      "updatedAt": "2025-09-03T02:51:58.680Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "294a4508-83a1-4d91-8fb0-ed07dee81ffc",
      "text": "chẳng phải vì ác độc, nhưng chỉ vì sợ bị bóc lột vô cớ.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:58.694Z",
      "updatedAt": "2025-09-03T02:51:58.694Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "35c5fcb7-12c6-481b-86c1-37b3060c1aac",
      "text": "Tuy nhiên, hãy rộng lượng với kẻ nghèo hèn,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:58.710Z",
      "updatedAt": "2025-09-03T02:51:58.710Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "61a27b68-da85-484d-b590-3b3affdc6e78",
      "text": "đừng chần chừ khi phải bố thí.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:58.751Z",
      "updatedAt": "2025-09-03T02:51:58.751Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "66b9be10-8133-4d1d-8334-7139155de3c4",
      "text": "Theo luật dạy, con hãy đón tiếp kẻ khó nghèo,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:58.779Z",
      "updatedAt": "2025-09-03T02:51:58.779Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "f1f5f01b-22d4-425b-9f07-1fa493f8f58c",
      "text": "vì họ túng quẫn, đừng để họ ra về tay trắng.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:58.793Z",
      "updatedAt": "2025-09-03T02:51:58.793Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "5f863445-0259-40c7-8f2e-4ce64534dc5b",
      "text": "Hãy bỏ tiền ra giúp người anh em bạn hữu,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:58.807Z",
      "updatedAt": "2025-09-03T02:51:58.807Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "b7277748-00b5-48e3-bb3a-ce533ac6f813",
      "text": "đừng đem chôn dưới đá kẻo nó hư đi.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:58.822Z",
      "updatedAt": "2025-09-03T02:51:58.822Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "87e4d685-af0f-4b24-b942-95da02424cce",
      "text": "Hãy theo lệnh Đấng Tối Cao mà sử dụng của cải,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:58.836Z",
      "updatedAt": "2025-09-03T02:51:58.836Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "b1d43fc3-2d8f-46b0-ae84-2b4c1bb3d879",
      "text": "việc đó còn ích lợi cho con hơn cả vàng.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:58.880Z",
      "updatedAt": "2025-09-03T02:51:58.880Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "a00ba6d6-7c00-4ad9-a034-b64a86478a15",
      "text": "Rộng tay bố thí là con chất đầy kho lẫm,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:58.894Z",
      "updatedAt": "2025-09-03T02:51:58.894Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "f1a51760-e89c-46ce-80c4-7a064951948d",
      "text": "và con sẽ thoát mọi nỗi gian nguy.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:58.922Z",
      "updatedAt": "2025-09-03T02:51:58.922Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "194bad29-8136-440a-a8ea-fe49418ea773",
      "text": "Của bố thí sẽ nên vũ khí giúp con chống địch thù",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:58.950Z",
      "updatedAt": "2025-09-03T02:51:58.950Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "56eeef15-3e3b-4039-943f-a9960059a89b",
      "text": "lợi hại hơn cả khiên dầy giáo nhọn.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:58.978Z",
      "updatedAt": "2025-09-03T02:51:58.978Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "3967eeac-cd56-4ba6-aacf-7cd957606db0",
      "text": "Người tốt bụng đứng ra bảo lãnh cho kẻ khác,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:58.994Z",
      "updatedAt": "2025-09-03T02:51:58.994Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "4d667890-ed50-4447-99aa-889b7a7afc85",
      "text": "kẻ mất liêm sỉ mới bỏ mặc người ta.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:59.054Z",
      "updatedAt": "2025-09-03T02:51:59.054Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "567a55b1-8c3b-430b-806b-3b303120ec20",
      "text": "Đừng quên ơn người bảo lãnh cho con",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:59.072Z",
      "updatedAt": "2025-09-03T02:51:59.072Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "0ca5e3b8-86e4-4693-a8df-081aa6bd96bf",
      "text": "bởi người ấy đã vì con mà thí mạng.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:59.086Z",
      "updatedAt": "2025-09-03T02:51:59.086Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "ed335522-ef51-47cd-9c11-8d28d0bb3fb7",
      "text": "Ân huệ người bảo lãnh, kẻ tội lỗi không đếm xỉa gì ;",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:59.101Z",
      "updatedAt": "2025-09-03T02:51:59.101Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "fd5c84bb-f41f-4b4e-b523-0e1c912deb63",
      "text": "người đã cứu mạng mình, đứa vô ơn không buồn nghĩ tới.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:59.114Z",
      "updatedAt": "2025-09-03T02:51:59.114Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "69588c04-2288-4d4b-b29e-d05e156931be",
      "text": "Vì đứng ra bảo lãnh, nhiều người giàu có mất hết gia tài,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:59.129Z",
      "updatedAt": "2025-09-03T02:51:59.129Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "670c5bc8-919c-467f-8fe8-f3bbb0cf480f",
      "text": "và chao đảo như gặp sóng lớn ngoài biển khơi.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:59.143Z",
      "updatedAt": "2025-09-03T02:51:59.143Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "8542982a-2767-4837-9d1c-11bffe2b6ed2",
      "text": "Cũng vì đứng ra bảo lãnh",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:59.160Z",
      "updatedAt": "2025-09-03T02:51:59.160Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "c50e41ab-3cb0-4947-b909-e476a403adc5",
      "text": "mà nhiều người quyền thế phải lưu vong",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:59.173Z",
      "updatedAt": "2025-09-03T02:51:59.173Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "4bb338e8-e526-4df9-abc9-35457b3b7138",
      "text": "và phiêu bạt giữa những dân xa lạ.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 2,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:59.186Z",
      "updatedAt": "2025-09-03T02:51:59.186Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "3a93604f-4930-4e1a-aea5-3ee648da5571",
      "text": "Kẻ tội lỗi đánh liều bảo lãnh",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:59.197Z",
      "updatedAt": "2025-09-03T02:51:59.197Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "5a5c0cd4-8965-4a52-ba9d-6af9e50270ab",
      "text": "mong kiếm chác lợi lộc ít nhiều",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:59.210Z",
      "updatedAt": "2025-09-03T02:51:59.210Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "8cb6dabb-5082-4c37-a41e-83ef4bd2ddea",
      "text": "là liều mình lãnh lấy án phạt.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 2,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:59.223Z",
      "updatedAt": "2025-09-03T02:51:59.223Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "ee84a08b-9f8b-4222-b576-7cdb42fc42f9",
      "text": "Hãy nâng đỡ kẻ khác tuỳ sức con,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:59.250Z",
      "updatedAt": "2025-09-03T02:51:59.250Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "bfeb0d1c-3e5d-4df9-bb72-69cd56b773cd",
      "text": "nhưng cẩn thận giữ mình kẻo ngã.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:59.263Z",
      "updatedAt": "2025-09-03T02:51:59.263Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "4cf27d62-9bbe-4cc8-a158-17fc2bc2abf9",
      "text": "Cuộc sống đòi tối thiểu phải có",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:59.292Z",
      "updatedAt": "2025-09-03T02:51:59.292Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "eca77f84-9d1b-4868-9d02-ff897416cff2",
      "text": "nước uống, cơm ăn, áo mặc",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:59.322Z",
      "updatedAt": "2025-09-03T02:51:59.322Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "a99f0fb8-075f-4ba5-8e00-17fbc8cd6e72",
      "text": "và một căn nhà để nương thân.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 2,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:59.337Z",
      "updatedAt": "2025-09-03T02:51:59.337Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "5eab49f8-ed5f-4a54-b28b-a29048fd1725",
      "text": "Sống nghèo dưới mái tranh của mình",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:59.370Z",
      "updatedAt": "2025-09-03T02:51:59.370Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "6dbca2bd-6a7a-4e8e-9472-0e45dca94985",
      "text": "còn hơn ăn sang mà đi ở nhờ người khác.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:59.386Z",
      "updatedAt": "2025-09-03T02:51:59.386Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "caa789e4-34a7-4e5d-b233-fa1d52979ae9",
      "text": "Có nhiều có ít, con cũng hãy bằng lòng,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:59.399Z",
      "updatedAt": "2025-09-03T02:51:59.399Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "f0c053a3-4e54-452e-8e40-06b8e0aef558",
      "text": "để khỏi phải nghe người ta trách là đồ ăn bám.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:59.413Z",
      "updatedAt": "2025-09-03T02:51:59.413Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "cb595975-b76a-4add-919c-a895facc35d7",
      "text": "Ở nhờ hết người này đến người nọ,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:59.442Z",
      "updatedAt": "2025-09-03T02:51:59.442Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "e985e5ba-c3ea-47d4-a2ad-a6643f96cbb8",
      "text": "cuộc sống của con sẽ thật đáng buồn,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:59.456Z",
      "updatedAt": "2025-09-03T02:51:59.456Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "9f2c924f-8a0d-4dec-babf-fa50affbca4b",
      "text": "vì ở đậu nhà người ta, con chẳng dám hé miệng.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 2,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:59.470Z",
      "updatedAt": "2025-09-03T02:51:59.470Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "fbd0cea2-eeff-4a16-a6cd-47ac6f3daef7",
      "text": "Con phải hầu bàn và tiếp rượu cho khách",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:59.484Z",
      "updatedAt": "2025-09-03T02:51:59.484Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "894b82f7-873a-42ae-b543-b942786d2044",
      "text": "mà chẳng ai thèm cám ơn.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:59.499Z",
      "updatedAt": "2025-09-03T02:51:59.499Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "709600e0-ec0e-421a-9b19-667298c901d7",
      "text": "Và chua chát nhất là phải nghe những lời này :",
      "label": "25",
      "number": 25,
      "subVerseIndex": 2,
      "paragraphNumber": 61,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:59.512Z",
      "updatedAt": "2025-09-03T02:51:59.512Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "9c1d6142-29d0-4465-9a29-2d5638399afd",
      "text": "“Lại đây sắp bàn đi, đồ ăn bám !",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 62,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:59.528Z",
      "updatedAt": "2025-09-03T02:51:59.528Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "909accde-b07c-4650-9e73-6a4808fe2d8f",
      "text": "Cầm gì vậy, đưa ta một miếng coi !”",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 63,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:59.542Z",
      "updatedAt": "2025-09-03T02:51:59.542Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "d4a29e95-2754-4983-9b4e-998f45ee499c",
      "text": "– “Đi đi, đồ ăn bám,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 64,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:59.556Z",
      "updatedAt": "2025-09-03T02:51:59.556Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "d5e560f2-f638-43c9-8f8d-14806aa5651e",
      "text": "để cho khách quý ghé thăm.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 65,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:59.570Z",
      "updatedAt": "2025-09-03T02:51:59.570Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "c1c446bd-2395-4d89-9889-d567fe1cb975",
      "text": "Anh của ta sắp đến, ta cần một căn phòng.”",
      "label": "27",
      "number": 27,
      "subVerseIndex": 2,
      "paragraphNumber": 66,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:59.583Z",
      "updatedAt": "2025-09-03T02:51:59.583Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "1b38ae34-c25a-4b43-9941-c5cface3a3d9",
      "text": "Người hiểu biết đau lòng, vì bị phiền trách là đồ ở đậu,",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 67,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:59.597Z",
      "updatedAt": "2025-09-03T02:51:59.597Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "210787ca-a571-4af2-9326-64c3bc4fd250",
      "text": "hoặc bị mắng nhiếc là đứa nợ nần.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 1,
      "paragraphNumber": 68,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:51:59.611Z",
      "updatedAt": "2025-09-03T02:51:59.611Z",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    }
  ],
  "marks": [
    {
      "id": "9d74f3d1-dbc7-43ce-8ef5-4b5f55bc320e",
      "content": "Ở đây không hiểu về cho vay lấy lời, nhưng về luật buộc phải cho mượn không lời giữa người Ít-ra-en với nhau (Xh 22,24 ; Lv 25,35-36 ; Đnl 15,7-11 ; x. Mt 5,42 ; Tv 37,21.26). Thi hành việc bác ái này đối với người anh em có nhu cầu là ký quỹ có lời.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 12,
      "endOffset": 12,
      "createdAt": "2025-09-03T02:51:58.393Z",
      "updatedAt": "2025-09-03T02:51:58.393Z",
      "targetId": "d8730f04-dd1c-419e-870f-97c35fe1c520",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "66f91732-d89d-4f43-b335-7697562b5850",
      "content": "Hc 8,12",
      "kind": "MARK_KIND_REFERENCE",
      "label": "1@",
      "sortOrder": 0,
      "startOffset": 20,
      "endOffset": 20,
      "createdAt": "2025-09-03T02:51:58.483Z",
      "updatedAt": "2025-09-03T02:51:58.483Z",
      "targetId": "2d65ba29-17eb-496b-877b-c09e058d4fcf",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "40e2d29b-c02d-4f4b-bdb8-62a7d2fecb3c",
      "content": "*Đổ thừa cho hoàn cảnh* cũng có thể đọc là : *và xin khất thêm thời gian nữa sẽ trả*.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 28,
      "endOffset": 28,
      "createdAt": "2025-09-03T02:51:58.582Z",
      "updatedAt": "2025-09-03T02:51:58.582Z",
      "targetId": "b4002559-7de5-4249-9c80-fa8abe542ba4",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "e1e9ae20-5d2c-4d07-9cb4-6829dc0785b8",
      "content": "Hc 3,30–4,10; 7,32-36; Đnl 15,11; Tb 12,8-9; Mt 6,19-21; 19,21",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:51:58.737Z",
      "updatedAt": "2025-09-03T02:51:58.737Z",
      "targetId": "c32f7d50-3cab-4d94-bf90-a64404ebc5f2",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
    },
    {
      "id": "ca3ead48-6129-4756-be9d-68571370b3b9",
      "content": "Về bố thí x. 3,30 – 4,5. Nhiều người ngại bỏ tiền ra cho người khác vì những lý do tác giả đưa ra ở trên, nhưng có những động lực còn cao trọng hơn thúc đẩy lòng quảng đại đối với người nghèo.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 29,
      "endOffset": 29,
      "createdAt": "2025-09-03T02:51:58.765Z",
      "updatedAt": "2025-09-03T02:51:58.765Z",
      "targetId": "61a27b68-da85-484d-b590-3b3affdc6e78",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "84d5743a-a41c-48ac-8e5f-5c86149625fa"
