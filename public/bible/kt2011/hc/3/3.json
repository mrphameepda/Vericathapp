      "targetId": "162acf0b-ad81-49fd-90a2-aadb1272ecfc",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "c99d5d3a-a669-4de8-a188-711c51d20c89",
      "content": "Xh 21,17",
      "kind": "MARK_KIND_REFERENCE",
      "label": "8@",
      "sortOrder": 7,
      "startOffset": 37,
      "endOffset": 37,
      "createdAt": "2025-09-03T02:48:44.969Z",
      "updatedAt": "2025-09-03T02:48:44.969Z",
