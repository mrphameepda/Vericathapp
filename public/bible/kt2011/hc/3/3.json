    },
    {
      "id": "03f8e4d8-0c84-4b74-a0b8-4a5c970a53eb",
      "content": "St 27,27 tt; 48,15-20; 49,3-29; Đnl 33,1-25",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:48:44.632Z",
      "updatedAt": "2025-09-03T02:48:44.632Z",
      "targetId": "0016d614-d3c4-4f31-b440-9458e265e3c7",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "500338da-4bb5-4c84-84b9-d74c272c4f32",
      "content": "*Người hào phóng*, ds theo HR : *người tặng quà*. Cũng có thể dịch : *Con sẽ được mến yêu bởi kẻ đẹp lòng (Thiên Chúa)*.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 43,
      "endOffset": 43,
      "createdAt": "2025-09-03T02:48:45.024Z",
      "updatedAt": "2025-09-03T02:48:45.024Z",
      "targetId": "6613fb1d-a3d4-464c-bd06-fa43aa0136d9",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "7dd7ab73-dfde-4d3a-9a93-22899c7f00ed",
      "content": "Cn 17,6",
      "kind": "MARK_KIND_REFERENCE",
      "label": "4@",
      "sortOrder": 3,
      "startOffset": 28,
      "endOffset": 28,
      "createdAt": "2025-09-03T02:48:44.733Z",
      "updatedAt": "2025-09-03T02:48:44.733Z",
      "targetId": "2e8d3916-2ee2-4361-9650-e91c6db04d8d",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "950b01ef-2272-46dc-b289-5ed510f72efa",
      "content": "Có những thủ bản thêm *Nhiều kẻ cao ngạo và vinh sang, nhưng Người mặc khải bí mật cho những kẻ nghèo hèn* (x. Mt 11,25).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 38,
      "endOffset": 38,
      "createdAt": "2025-09-03T02:48:45.073Z",
      "updatedAt": "2025-09-03T02:48:45.073Z",
      "targetId": "37d7fcac-4847-4bcc-8570-790846a9fcfb",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "6d5ad0a0-3a04-41a3-8000-f7964783424b",
      "content": "Mt 15,4-6",
      "kind": "MARK_KIND_REFERENCE",
      "label": "5@",
      "sortOrder": 4,
      "startOffset": 12,
      "endOffset": 12,
      "createdAt": "2025-09-03T02:48:44.788Z",
      "updatedAt": "2025-09-03T02:48:44.788Z",
      "targetId": "af118169-7472-4c9a-a5e1-3ac073db885a",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "0ce80846-e657-45e9-b834-11f7c388bc7a",
      "content": "Một cách nhấn mạnh việc Thiên Chúa chiếu cố tới người hèn mọn. HR : *Vì lòng lân tuất của Thiên Chúa thì lớn lao và Người mặc khải bí mật cho kẻ nghèo hèn*, nói lên một tư tưởng quen thuộc hơn trong Cựu Ước, là : Thiên Chúa ban ân sủng dư dầy cho ai tự hạ (Cn 3,34 ; Tv 25,14 ; x. Lc 1,52).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "5",
      "sortOrder": 4,
      "startOffset": 43,
      "endOffset": 43,
      "createdAt": "2025-09-03T02:48:45.115Z",
      "updatedAt": "2025-09-03T02:48:45.115Z",
      "targetId": "8443b4e7-22a8-42f9-8856-3e4eb9c79f2c",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "a0dddd49-d011-4c91-8ec6-74088c06b650",
      "content": "Cn 19,26",
      "kind": "MARK_KIND_REFERENCE",
      "label": "6@",
      "sortOrder": 5,
      "startOffset": 38,
      "endOffset": 38,
      "createdAt": "2025-09-03T02:48:44.816Z",
      "updatedAt": "2025-09-03T02:48:44.816Z",
      "targetId": "e91a2b6c-223a-4530-bb6a-0363a871658f",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "82459f82-06a1-4bb2-bbf5-9ea8ce6d8bdf",
      "content": "*Xét tới*, ds theo HR : *tìm tòi*. Tác giả muốn ám chỉ tới chuyện triết học Hy-lạp thời ấy đã bắt đầu gây ảnh hưởng đối với người Do-thái. Tò mò về văn hoá ngoại nhập có thể tác hại đến đức tin.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "6",
      "sortOrder": 5,
      "startOffset": 41,
      "endOffset": 41,
      "createdAt": "2025-09-03T02:48:45.184Z",
      "updatedAt": "2025-09-03T02:48:45.184Z",
      "targetId": "df49f061-5974-4540-88f3-6ab5feaef7dc",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "e93ccdc7-506b-49df-a45a-97c5b2a0168c",
      "content": "Cn 19,26; 30,17",
      "kind": "MARK_KIND_REFERENCE",
      "label": "7@",
      "sortOrder": 6,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:48:44.942Z",
      "updatedAt": "2025-09-03T02:48:44.942Z",
      "targetId": "58c2e0ed-204f-425d-8f38-a44f53a1c320",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "16bc2dad-dbb2-499c-b431-9a1a36c2255a",
      "content": "Cũng có thể dịch : *... những việc dư thừa* theo HL.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "7",
      "sortOrder": 6,
      "startOffset": 40,
      "endOffset": 40,
      "createdAt": "2025-09-03T02:48:45.247Z",
