    },
    {
      "id": "85c9dcf7-8f87-4fa0-a104-7aa4afe081d5",
      "content": "Có những thủ bản thêm : “7a Kẻ kính sợ Đức Chúa thì tôn kính cha mình.”",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 43,
      "endOffset": 43,
      "createdAt": "2025-09-03T02:48:44.520Z",
      "updatedAt": "2025-09-03T02:48:44.520Z",
      "targetId": "fa7f9864-057f-4580-b446-adf2edfa3885",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "2e0f1d40-9666-4d3f-bd13-804474711814",
      "content": "*Chủ nhân* theo Hy-lạp ; có lẽ *Chúa* hay hơn.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 20,
      "endOffset": 20,
      "createdAt": "2025-09-03T02:48:44.562Z",
      "updatedAt": "2025-09-03T02:48:44.562Z",
      "targetId": "e62c1b24-3195-4c8f-83b6-135370547d95",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
