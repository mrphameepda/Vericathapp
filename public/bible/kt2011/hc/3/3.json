{
  "chapter": {
    "id": "bc76422c-da51-4752-8824-82ca77f00664",
    "number": 3,
    "createdAt": "2025-09-03T01:07:51.705Z",
    "updatedAt": "2025-09-03T01:07:51.705Z",
    "bookId": "5c66a463-0bfa-46b7-9af1-3766a8779b73"
  },
  "verses": [
    {
      "id": "23e5404f-9e0d-4154-be01-8243663c32b3",
      "text": "Hỡi các con, hãy nghe cha đây,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:44.352Z",
      "updatedAt": "2025-09-03T02:48:44.352Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "7a4468a7-5d7c-42b8-adb2-71698f7afc19",
      "text": "và làm thế nào để các con được cứu độ.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:44.391Z",
      "updatedAt": "2025-09-03T02:48:44.391Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "6f2a70cb-b604-48e4-a74e-48931487d077",
      "text": "Đức Chúa làm cho người cha được vẻ vang vì con cái,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:44.403Z",
      "updatedAt": "2025-09-03T02:48:44.403Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "78443160-3788-4837-9ea0-9ef07b980b05",
      "text": "cho người mẹ thêm uy quyền đối với các con.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:44.414Z",
      "updatedAt": "2025-09-03T02:48:44.414Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "13dfde0b-618c-47ec-a5dc-a66d3d80b71e",
      "text": "Ai thờ cha thì bù đắp lỗi lầm,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:44.428Z",
      "updatedAt": "2025-09-03T02:48:44.428Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "49a0997d-cf82-48c2-97b8-8c02f42e8dde",
      "text": "ai kính mẹ thì tích trữ kho báu.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:44.445Z",
      "updatedAt": "2025-09-03T02:48:44.445Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "bf00dfa7-48c0-4e66-9d58-9918d28298a0",
      "text": "Ai thờ cha sẽ được vui mừng vì con cái,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:44.462Z",
      "updatedAt": "2025-09-03T02:48:44.462Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "045a4181-1b78-4b6a-b27e-7852c2f591cf",
      "text": "khi cầu nguyện, họ sẽ được lắng nghe.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:44.476Z",
      "updatedAt": "2025-09-03T02:48:44.476Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "e3571966-77af-4d7d-8b48-3941d8fbef27",
      "text": "Ai tôn vinh cha sẽ được trường thọ,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:44.490Z",
      "updatedAt": "2025-09-03T02:48:44.490Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "fa7f9864-057f-4580-b446-adf2edfa3885",
      "text": "ai vâng lệnh Đức Chúa sẽ làm cho mẹ an lòng.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:44.505Z",
      "updatedAt": "2025-09-03T02:48:44.505Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "8e9eb568-453c-4e0e-a0bb-8809bb9e528f",
      "text": "Người đó phục vụ các bậc sinh thành",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:44.534Z",
      "updatedAt": "2025-09-03T02:48:44.534Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "e62c1b24-3195-4c8f-83b6-135370547d95",
      "text": "như phục vụ chủ nhân.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:44.548Z",
      "updatedAt": "2025-09-03T02:48:44.548Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "daa9828c-47f3-4086-a157-eeb889c4553d",
      "text": "Hãy thảo kính cha con bằng lời nói việc làm,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:44.576Z",
      "updatedAt": "2025-09-03T02:48:44.576Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "790c224c-fb38-41fd-a229-07a1a46f106c",
      "text": "để nhờ người mà con được chúc phúc.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:44.604Z",
      "updatedAt": "2025-09-03T02:48:44.604Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "0016d614-d3c4-4f31-b440-9458e265e3c7",
      "text": "Vì phúc lành của người cha",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:44.618Z",
      "updatedAt": "2025-09-03T02:48:44.618Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "a3b69773-a784-4cc0-a997-a40e3e410ba1",
      "text": "làm cho cửa nhà con cái bền vững,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:44.645Z",
      "updatedAt": "2025-09-03T02:48:44.645Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "11bba1ea-47cb-4d22-87ba-8c44f1efa829",
      "text": "lời nguyền rủa của người mẹ",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:44.659Z",
      "updatedAt": "2025-09-03T02:48:44.659Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "d323395b-e6c2-48bc-a4e0-9cf79b6bfb58",
      "text": "làm cho trốc rễ bật nền.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 3,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:44.673Z",
      "updatedAt": "2025-09-03T02:48:44.673Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "bb73e19a-3084-47c3-9b36-7be821130552",
      "text": "Chớ vênh vang khi cha con phải tủi nhục,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:44.690Z",
      "updatedAt": "2025-09-03T02:48:44.690Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "6973ba23-abaa-4d9b-ad7e-392877da0739",
      "text": "vì nỗi tủi nhục đó chẳng vinh dự gì cho con.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:44.704Z",
      "updatedAt": "2025-09-03T02:48:44.704Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "2e8d3916-2ee2-4361-9650-e91c6db04d8d",
      "text": "Quả thật, người ta chỉ được vẻ vang",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:44.719Z",
      "updatedAt": "2025-09-03T02:48:44.719Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "c2bd44c2-3e7d-4443-a4b3-97ff7a1b7341",
      "text": "lúc cha mình được tôn kính ;",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:44.746Z",
      "updatedAt": "2025-09-03T02:48:44.746Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "c5ca629b-b307-42c1-afde-8aaa8d3bbef1",
      "text": "và con cái phải ô nhục khi mẹ mình bị khinh chê.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:44.761Z",
      "updatedAt": "2025-09-03T02:48:44.761Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "af118169-7472-4c9a-a5e1-3ac073db885a",
      "text": "Con ơi, hãy săn sóc cha con, khi người đến tuổi già ;",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:44.775Z",
      "updatedAt": "2025-09-03T02:48:44.775Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "e91a2b6c-223a-4530-bb6a-0363a871658f",
      "text": "bao lâu người còn sống, chớ làm người buồn tủi.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:44.802Z",
      "updatedAt": "2025-09-03T02:48:44.802Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "2584243d-5529-4dd8-9832-8143173f9d74",
      "text": "Người có lú lẫn, con cũng phải cảm thông,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:44.830Z",
      "updatedAt": "2025-09-03T02:48:44.830Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "b5cedd0b-0418-4114-b778-5fb477c43262",
      "text": "chớ cậy mình sung sức mà khinh dể người.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:44.844Z",
      "updatedAt": "2025-09-03T02:48:44.844Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "2e501c17-e929-4e5c-8135-c985c18199fb",
      "text": "Vì lòng hiếu nghĩa đối với cha sẽ không bị quên lãng,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:44.858Z",
      "updatedAt": "2025-09-03T02:48:44.858Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "353f20bf-29b1-48e2-b11c-c02620809d83",
      "text": "và sẽ đền bù tội lỗi cho con.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:44.872Z",
      "updatedAt": "2025-09-03T02:48:44.872Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "d4020368-931d-4f9f-908a-a2c41f96f24f",
      "text": "Thiên Chúa sẽ nhớ đến con, ngày con gặp khốn khó,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:44.885Z",
      "updatedAt": "2025-09-03T02:48:44.885Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "3c42588a-6fee-4910-a8ea-6129e686a194",
      "text": "và các tội con sẽ biến tan",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:44.899Z",
      "updatedAt": "2025-09-03T02:48:44.899Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "76a36cd2-c732-4f42-a616-63b5ca8fcbc8",
      "text": "như sương muối biến tan lúc đẹp trời.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 2,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:44.913Z",
      "updatedAt": "2025-09-03T02:48:44.913Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "58c2e0ed-204f-425d-8f38-a44f53a1c320",
      "text": "Ai bỏ rơi cha mình thì khác nào kẻ lộng ngôn,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:44.927Z",
      "updatedAt": "2025-09-03T02:48:44.927Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "f92c7d0a-35c5-4e47-bf8b-29365688ba0b",
      "text": "ai chọc giận mẹ mình, sẽ bị Đức Chúa nguyền rủa.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:44.955Z",
      "updatedAt": "2025-09-03T02:48:44.955Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "82f7c4e9-a5b9-414e-a493-1459bbe5e24d",
      "text": "Con ơi, hãy hoàn thành việc của con một cách nhũn nhặn,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:44.983Z",
      "updatedAt": "2025-09-03T02:48:44.983Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "6613fb1d-a3d4-464c-bd06-fa43aa0136d9",
      "text": "thì con sẽ được mến yêu hơn người hào phóng.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:45.010Z",
      "updatedAt": "2025-09-03T02:48:45.010Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "967a9d0c-eed1-430b-8367-b569ab266268",
      "text": "Càng làm lớn, con càng phải tự hạ,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:45.037Z",
      "updatedAt": "2025-09-03T02:48:45.037Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "37d7fcac-4847-4bcc-8570-790846a9fcfb",
      "text": "như thế, con sẽ được đẹp lòng Đức Chúa.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:45.061Z",
      "updatedAt": "2025-09-03T02:48:45.061Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "7c3c4895-43c9-49d5-8d8b-9a7cedeb1af7",
      "text": "Vì quyền năng Đức Chúa thì lớn lao :",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:45.087Z",
      "updatedAt": "2025-09-03T02:48:45.087Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "8443b4e7-22a8-42f9-8856-3e4eb9c79f2c",
      "text": "Người được tôn vinh nơi các kẻ khiêm nhường.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:45.101Z",
      "updatedAt": "2025-09-03T02:48:45.101Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "4d9f6381-ff48-4c0f-8cb8-af07f76eab04",
      "text": "Đừng tìm những điều khó quá đối với con,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:45.142Z",
      "updatedAt": "2025-09-03T02:48:45.142Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "df49f061-5974-4540-88f3-6ab5feaef7dc",
      "text": "những điều vượt sức con, con đừng xét tới.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:45.170Z",
      "updatedAt": "2025-09-03T02:48:45.170Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "64f07155-e949-4241-9ac5-54b6d0525159",
      "text": "Những gì đã ấn định cho con, con hãy suy cho kỹ,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:45.212Z",
      "updatedAt": "2025-09-03T02:48:45.212Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "af250e51-bc08-4aa9-b5a2-035c12f98dae",
      "text": "cần chi phải hiếu kỳ !",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:45.225Z",
      "updatedAt": "2025-09-03T02:48:45.225Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "162acf0b-ad81-49fd-90a2-aadb1272ecfc",
      "text": "Đừng dây mình vào những việc quá sức con,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:45.236Z",
      "updatedAt": "2025-09-03T02:48:45.236Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "3128a05e-4ed0-4e06-89ba-4ac6ef472f7d",
      "text": "vì những điều con trông thấy",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:45.258Z",
      "updatedAt": "2025-09-03T02:48:45.258Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "52e18bfe-1ab5-441b-9b5f-b44885720110",
      "text": "đã vượt quá trí hiểu của loài người.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 2,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:45.269Z",
      "updatedAt": "2025-09-03T02:48:45.269Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "51109e2e-c9b6-4f7d-b259-356d48ab3e59",
      "text": "Nhiều người mắc sai lầm vì ý kiến riêng của họ,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:45.280Z",
      "updatedAt": "2025-09-03T02:48:45.280Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "5c045f56-8d3e-4dba-b565-474624904e18",
      "text": "ý nghĩ xấu làm cho suy nghĩ của họ đảo điên.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:45.291Z",
      "updatedAt": "2025-09-03T02:48:45.291Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "df105aff-e462-42be-90e7-a7ca47d1c747",
      "text": "Kẻ lòng chai dạ đá cuối đời sẽ gặp bất hạnh,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:45.315Z",
      "updatedAt": "2025-09-03T02:48:45.315Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "e68feba2-8f49-4867-b11a-03edec9a2ef0",
      "text": "người thích nguy hiểm sẽ phải chết vì hiểm nguy.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:45.355Z",
      "updatedAt": "2025-09-03T02:48:45.355Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "1865eea0-96ff-43a6-bcb8-d3a38eff7a8c",
      "text": "Kẻ lòng chai dạ đá sẽ bị ngàn nỗi ưu phiền đè nặng,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:45.383Z",
      "updatedAt": "2025-09-03T02:48:45.383Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "6e64e90e-969e-4010-8b77-eb471b4cc42e",
      "text": "người tội lỗi cứ chồng chất tội này lên tội kia.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:45.410Z",
      "updatedAt": "2025-09-03T02:48:45.410Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "2d2d2cbb-4c8e-4b73-9f85-64426a97b2bc",
      "text": "Kẻ kiêu ngạo lâm cảnh khốn cùng thì vô phương cứu chữa,",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:45.423Z",
      "updatedAt": "2025-09-03T02:48:45.423Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "cb9f4124-26c5-4d1e-afb0-1ed3386278e7",
      "text": "vì sự xấu xa đã ăn sâu mọc rễ trong nó.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 1,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:45.444Z",
      "updatedAt": "2025-09-03T02:48:45.444Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "4944177b-636e-4869-a3bf-0dba6e41a342",
      "text": "Người sáng trí để tâm nghiên cứu các ẩn dụ,",
      "label": "29",
      "number": 29,
      "subVerseIndex": 0,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:45.458Z",
      "updatedAt": "2025-09-03T02:48:45.458Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "80134424-fee8-47d1-be85-d45149f9bbc1",
      "text": "kẻ khôn ngoan ao ước có tai thính để nghe.",
      "label": "29",
      "number": 29,
      "subVerseIndex": 1,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:45.472Z",
      "updatedAt": "2025-09-03T02:48:45.472Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "e25472c3-4469-4011-b213-ab9ba31613e8",
      "text": "Nước dập tắt lửa hồng, bố thí đền bù tội lỗi.",
      "label": "30",
      "number": 30,
      "subVerseIndex": 0,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:45.486Z",
      "updatedAt": "2025-09-03T02:48:45.486Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "67479e10-0698-4262-a8e0-2682f8ab891a",
      "text": "Ai đền ơn đáp nghĩa là biết lo xa,",
      "label": "31",
      "number": 31,
      "subVerseIndex": 0,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:45.555Z",
      "updatedAt": "2025-09-03T02:48:45.555Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    },
    {
      "id": "0d3a2b18-72e1-4f4b-b37a-76e2b5afa4ac",
      "text": "lúc sa cơ, người ấy sẽ tìm được nơi nương tựa.",
      "label": "31",
      "number": 31,
      "subVerseIndex": 1,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:45.583Z",
      "updatedAt": "2025-09-03T02:48:45.583Z",
      "chapterId": "bc76422c-da51-4752-8824-82ca77f00664"
    }
  ],
  "marks": [
    {
