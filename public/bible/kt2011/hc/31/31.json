{
  "chapter": {
    "id": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5",
    "number": 31,
    "createdAt": "2025-09-03T01:07:51.705Z",
    "updatedAt": "2025-09-03T01:07:51.705Z",
    "bookId": "5c66a463-0bfa-46b7-9af1-3766a8779b73"
  },
  "verses": [
    {
      "id": "dc179828-b885-40bf-bce8-b84ad656105f",
      "text": "Thức đêm vì của cải làm hao mòn thân xác,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:10.958Z",
      "updatedAt": "2025-09-03T02:52:10.958Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "8b9d2637-ffc2-453f-8781-97f056a7a4b2",
      "text": "bận tâm về nó sẽ mất giấc ngủ ngon.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:10.989Z",
      "updatedAt": "2025-09-03T02:52:10.989Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "a5e11026-ca30-473a-b8db-ba49a7bddfab",
      "text": "Bận tâm vì sinh kế cũng không sao chợp mắt,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11Z",
      "updatedAt": "2025-09-03T02:52:11Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "ac2ea855-e524-49d0-8302-682ec9cf5572",
      "text": "lâm cơn bệnh nặng là mất giấc ngủ ngon.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.023Z",
      "updatedAt": "2025-09-03T02:52:11.023Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "9ab9688e-3281-4cf6-846a-33e81493ce98",
      "text": "Người giàu vất vả thì của cải gia tăng,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.035Z",
      "updatedAt": "2025-09-03T02:52:11.035Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "3b3c1188-2cd2-4716-9c4b-d8f62eba3021",
      "text": "ngưng làm việc là đi tìm lạc thú.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.048Z",
      "updatedAt": "2025-09-03T02:52:11.048Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "b8c95154-a421-4a8d-907b-da338680008e",
      "text": "Người nghèo vất vả vẫn thiếu hụt miếng ăn,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.062Z",
      "updatedAt": "2025-09-03T02:52:11.062Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "4919de35-2e9b-482b-8b92-9d14a1488f44",
      "text": "ngưng làm việc là bần cùng thiếu thốn.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.076Z",
      "updatedAt": "2025-09-03T02:52:11.076Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "f82d505e-7ab9-459f-99c5-d31a82914b9e",
      "text": "Đã ham tiền không sao công chính được,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.090Z",
      "updatedAt": "2025-09-03T02:52:11.090Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "01d90d7a-d7d7-4bd7-b909-23245bfe21bf",
      "text": "chạy theo lợi lộc ắt sẽ lỗi lầm.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.118Z",
      "updatedAt": "2025-09-03T02:52:11.118Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "8b172015-2828-4983-89c9-af21d008a050",
      "text": "Bạc tiền khiến cho bao người sa ngã,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.132Z",
      "updatedAt": "2025-09-03T02:52:11.132Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "5b0d6c9e-8740-4f80-90e5-d50a409f57fc",
      "text": "thế nào cũng đưa họ đến hư vong.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.148Z",
      "updatedAt": "2025-09-03T02:52:11.148Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "f2a34822-436c-4f74-b6a9-deb79eb57ed5",
      "text": "Nó là cái bẫy cho ai say mê nó,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.185Z",
      "updatedAt": "2025-09-03T02:52:11.185Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "d1d48f6e-359b-4605-82af-55893c6d6d81",
      "text": "hết mọi kẻ ngu si sẽ sa vào.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.228Z",
      "updatedAt": "2025-09-03T02:52:11.228Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "1b1c0bc3-de16-41fc-862f-eebc84978936",
      "text": "Phúc thay ai giàu có mà vô tội,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.242Z",
      "updatedAt": "2025-09-03T02:52:11.242Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "e32cf86d-f750-4393-bd47-e464415979fc",
      "text": "không chạy theo của cải, tiền tài.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.257Z",
      "updatedAt": "2025-09-03T02:52:11.257Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "d704629d-aa19-4400-ba70-03f218311c15",
      "text": "Người đó là ai để chúng ta khen là có phúc,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.285Z",
      "updatedAt": "2025-09-03T02:52:11.285Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "b9e475db-f8db-4026-adce-f012e9783b1b",
      "text": "vì trong dân mình người đó khiến cho bao người thán phục ?",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.300Z",
      "updatedAt": "2025-09-03T02:52:11.300Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "1973b0bd-6891-43d2-91ef-4dda2dc802c4",
      "text": "Ai đã trải qua thử thách đó và nên hoàn hảo ?",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.315Z",
      "updatedAt": "2025-09-03T02:52:11.315Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "44711d24-351a-4243-9b42-3ce9b9244c98",
      "text": "Người ấy có lý do để tự hào.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.328Z",
      "updatedAt": "2025-09-03T02:52:11.328Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "e5f4dec5-c7d0-49cb-88eb-e2572402e0e3",
      "text": "Ai có thể phạm lỗi mà không phạm lỗi",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.343Z",
      "updatedAt": "2025-09-03T02:52:11.343Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "5f16aa78-e147-4bb5-a700-fc7319510f8c",
      "text": "có thể làm điều ác mà đã không làm ?",
      "label": "10",
      "number": 10,
      "subVerseIndex": 3,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.356Z",
      "updatedAt": "2025-09-03T02:52:11.356Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "c72cab0b-616b-40e4-8e27-8b949e19338a",
      "text": "Của cải người ấy sẽ tồn tại,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.368Z",
      "updatedAt": "2025-09-03T02:52:11.368Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "96caad7d-4db4-4646-866b-4a74757c413b",
      "text": "công đức người ấy sẽ được cộng đoàn tán dương.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.381Z",
      "updatedAt": "2025-09-03T02:52:11.381Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "2ad0e7cc-a571-48ba-8b3b-e0e0e559a7fb",
      "text": "Khi ngồi trước mâm cao cỗ đầy, đừng hả họng thốt lên :",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.409Z",
      "updatedAt": "2025-09-03T02:52:11.409Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "5c721372-3af9-4da7-a559-05534d77cc34",
      "text": "“Chà ! Thịnh soạn quá !”",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.453Z",
      "updatedAt": "2025-09-03T02:52:11.453Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "2b92c86d-0560-4ce2-8519-73c696c2629f",
      "text": "Hãy nhớ rằng : mắt hau háu là điều chẳng hay.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.467Z",
      "updatedAt": "2025-09-03T02:52:11.467Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "fd38b57a-16b1-43b7-a495-888022afe3f4",
      "text": "Có thụ tạo nào tệ hơn con mắt ?",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.482Z",
      "updatedAt": "2025-09-03T02:52:11.482Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "aafef809-52c0-483b-89e7-73c20748a614",
      "text": "Gặp chi nó cũng phát khóc (vì thèm).",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.495Z",
      "updatedAt": "2025-09-03T02:52:11.495Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "7e2d7876-0854-462d-9e46-e4bf36dd7093",
      "text": "Miếng người khác đã nhằm, con đừng đưa tay tới,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.524Z",
      "updatedAt": "2025-09-03T02:52:11.524Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "d416b44a-84d3-4c11-b93c-a492b45b81d0",
      "text": "đừng giành với họ trên cùng một đĩa.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.538Z",
      "updatedAt": "2025-09-03T02:52:11.538Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "982a4d51-f1e9-495f-bc5f-73e2480a79f1",
      "text": "Hãy suy bụng ta mà nghĩ ra bụng người,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.551Z",
      "updatedAt": "2025-09-03T02:52:11.551Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "4e210367-4ebb-4fe2-a67f-5dabbbad9e72",
      "text": "làm việc gì cũng phải đắn đo cân nhắc.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.566Z",
      "updatedAt": "2025-09-03T02:52:11.566Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "e1613e16-9178-4730-8f77-8c76bdfea695",
      "text": "Những món đã dọn ra,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.581Z",
      "updatedAt": "2025-09-03T02:52:11.581Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "f92b8e6d-dc17-4196-8cb6-aab3de3a6bce",
      "text": "hãy ăn làm sao cho xứng một con người,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.595Z",
      "updatedAt": "2025-09-03T02:52:11.595Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "d5b8b94f-fec8-471d-a8c5-11f393265e78",
      "text": "đừng nhai nhồm nhoàm kẻo bị khinh chê.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 2,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.610Z",
      "updatedAt": "2025-09-03T02:52:11.610Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "46802f7f-593d-45f4-9fe0-c197ccd702eb",
      "text": "Hãy tỏ ra có giáo dục mà buông đũa trước.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.624Z",
      "updatedAt": "2025-09-03T02:52:11.624Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "7721039f-ded7-4fba-8ce2-8590a981825f",
      "text": "Đừng háu ăn kẻo người ta bực mình.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.638Z",
      "updatedAt": "2025-09-03T02:52:11.638Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "d0c5d1d4-30a8-4e25-bb0c-f8a52112214c",
      "text": "Chung mâm với nhiều người, con đừng cầm đũa trước.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.653Z",
      "updatedAt": "2025-09-03T02:52:11.653Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "5b3664a2-2ccf-4833-a7bb-fe691f406759",
      "text": "Người có giáo dục thì chút ít cũng vừa,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.667Z",
      "updatedAt": "2025-09-03T02:52:11.667Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "85258cf5-1dd2-451b-a59c-3cea77322479",
      "text": "trên giường nằm sẽ không tức bụng.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.696Z",
      "updatedAt": "2025-09-03T02:52:11.696Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "7c740d0e-0680-45ef-8697-aa3792624617",
      "text": "Ăn chừng mực sẽ ngủ thoải mái,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.710Z",
      "updatedAt": "2025-09-03T02:52:11.710Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "5a82f8ad-bbd9-4023-a0e0-fa1cd6da6b5e",
      "text": "thức dậy sớm, tâm hồn được thảnh thơi ;",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.724Z",
      "updatedAt": "2025-09-03T02:52:11.724Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "060784e4-400b-447e-a513-d5ac6366fb4e",
      "text": "kẻ ăn uống quá độ thì mất ngủ đã đành,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 2,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.738Z",
      "updatedAt": "2025-09-03T02:52:11.738Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "d2bd7579-b06b-41fa-bdda-d628233bcbd6",
      "text": "mà còn bị thượng thổ hạ tả.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 3,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.752Z",
      "updatedAt": "2025-09-03T02:52:11.752Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "e3281146-1116-4836-bc0c-029f15e285cf",
      "text": "Nếu đã bị ép phải ăn,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.767Z",
      "updatedAt": "2025-09-03T02:52:11.767Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "c325668e-da55-4dc2-a8ec-e980d8024dc0",
      "text": "hãy đứng lên ra ngoài mà ói, con sẽ thấy dễ chịu.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.781Z",
      "updatedAt": "2025-09-03T02:52:11.781Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "7a29b9f3-b382-44bb-96f2-0a1a09cd9ed7",
      "text": "Con ơi, hãy nghe ta, chớ có khinh thường,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.810Z",
      "updatedAt": "2025-09-03T02:52:11.810Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "0badc59f-59d4-4613-9ac7-8a9e90e139d1",
      "text": "sau này con sẽ thấy là ta nói đúng :",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.824Z",
      "updatedAt": "2025-09-03T02:52:11.824Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "0df07fe8-f932-49db-8ac2-6d2b98a2bb07",
      "text": "Trong mọi việc con làm, hãy giữ chừng giữ mực,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 2,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.838Z",
      "updatedAt": "2025-09-03T02:52:11.838Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "99024127-cc95-43ce-b46b-71693b9d3114",
      "text": "thì chẳng bệnh tật nào chạm tới con.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 3,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.866Z",
      "updatedAt": "2025-09-03T02:52:11.866Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "eef60b22-f224-4150-a3b3-2b33bc178956",
      "text": "Chủ nhà hào hoa, người người ca tụng,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.880Z",
      "updatedAt": "2025-09-03T02:52:11.880Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "cdfb4fb1-1e4d-4989-a7a2-2a5adbb87c56",
      "text": "thiên hạ còn kể mãi về lòng tốt của ông.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.895Z",
      "updatedAt": "2025-09-03T02:52:11.895Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "a58b9b5d-deb6-4b6f-9ade-4c20fcaf1028",
      "text": "Chủ nhà sẻn so, cả làng đàm tiếu,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.909Z",
      "updatedAt": "2025-09-03T02:52:11.909Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "29ca21d4-454d-4679-810f-04b10ac9c7d3",
      "text": "thiên hạ có kể về sự hẹp hòi đó thì cũng phải thôi.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.922Z",
      "updatedAt": "2025-09-03T02:52:11.922Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "568b159f-847a-4a86-84bc-5dc1bd8b089b",
      "text": "Khi uống rượu, đừng lên mặt anh hùng,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.938Z",
      "updatedAt": "2025-09-03T02:52:11.938Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "042a9a74-acb8-41e9-af05-1292af6775e3",
      "text": "vì rượu đã làm cho lắm kẻ ra thân tàn ma dại.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.979Z",
      "updatedAt": "2025-09-03T02:52:11.979Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "5eb413f3-a555-44ce-b49d-451722c2a56c",
      "text": "Như lửa thử độ bền của thép,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:11.993Z",
      "updatedAt": "2025-09-03T02:52:11.993Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "c9108db3-cef7-4472-8867-3a40948de373",
      "text": "rượu cũng thử lòng người",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:12.008Z",
      "updatedAt": "2025-09-03T02:52:12.008Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "85e729a1-dcb3-4c47-99eb-5ea362ce7aca",
      "text": "trong cuộc đọ sức anh hùng lưu linh.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 2,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:12.021Z",
      "updatedAt": "2025-09-03T02:52:12.021Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "2fa227cf-6ea6-49bd-aa3c-69340e4491fa",
      "text": "Rượu đem lại cho con người sức sống,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:12.035Z",
      "updatedAt": "2025-09-03T02:52:12.035Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "8ea101fa-0aad-4470-ba9e-9c61d2237a0b",
      "text": "nếu biết uống có chừng có mực.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 61,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:12.049Z",
      "updatedAt": "2025-09-03T02:52:12.049Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "9fb36fec-77e0-453e-b744-f9d99768c9a5",
      "text": "Sống không có rượu thì sống làm chi ?",
      "label": "27",
      "number": 27,
      "subVerseIndex": 2,
      "paragraphNumber": 62,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:12.063Z",
      "updatedAt": "2025-09-03T02:52:12.063Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "2bac6cfc-5dc2-40dd-a6b5-aa2a004e3486",
      "text": "Rượu đã được tạo thành cho người ta phấn khởi.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 3,
      "paragraphNumber": 63,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:12.078Z",
      "updatedAt": "2025-09-03T02:52:12.078Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "3313f9b8-f4e0-4dd9-ba67-49ad2d9f0379",
      "text": "Tâm hồn sung sướng, lòng dạ hân hoan,",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 64,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:12.106Z",
      "updatedAt": "2025-09-03T02:52:12.106Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "cd20c6d1-8a9f-4add-bbac-b0765405b458",
      "text": "nếu uống rượu đúng thời đúng mức.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 1,
      "paragraphNumber": 65,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:12.134Z",
      "updatedAt": "2025-09-03T02:52:12.134Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "7577e320-aab1-4d74-8406-1c3b4c02a597",
      "text": "Thật cay đắng cho tâm hồn",
      "label": "29",
      "number": 29,
      "subVerseIndex": 0,
      "paragraphNumber": 66,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:12.163Z",
      "updatedAt": "2025-09-03T02:52:12.163Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "9dfdc1e7-53e5-47b6-b074-19cf84eb990b",
      "text": "khi quá chén vì bị nói khích và ngã quỵ.",
      "label": "29",
      "number": 29,
      "subVerseIndex": 1,
      "paragraphNumber": 67,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:12.178Z",
      "updatedAt": "2025-09-03T02:52:12.178Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "88a67c17-68ab-48bd-9cec-8decdc03db1c",
      "text": "Ma men khiến đứa ngu nổi khùng mà chuốc hoạ vào thân :",
      "label": "30",
      "number": 30,
      "subVerseIndex": 0,
      "paragraphNumber": 68,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:12.206Z",
      "updatedAt": "2025-09-03T02:52:12.206Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "84bd2b02-e589-4fa9-b9b2-9b287af2a3a9",
      "text": "sức lực tiêu hao, mình mang thương tích.",
      "label": "30",
      "number": 30,
      "subVerseIndex": 1,
      "paragraphNumber": 69,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:12.219Z",
      "updatedAt": "2025-09-03T02:52:12.219Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "6498c47b-9114-4c79-b918-378001b5ec67",
      "text": "Trong tiệc rượu, đừng khiêu khích kẻ đồng bàn,",
      "label": "31",
      "number": 31,
      "subVerseIndex": 0,
      "paragraphNumber": 70,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:12.235Z",
      "updatedAt": "2025-09-03T02:52:12.235Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "d2c89409-baf6-4a5c-9a86-7ddb66ed4b39",
      "text": "đừng hạ nhục nó lúc nó đang vui nhộn,",
      "label": "31",
      "number": 31,
      "subVerseIndex": 1,
      "paragraphNumber": 71,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:12.253Z",
      "updatedAt": "2025-09-03T02:52:12.253Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "8ae1bb54-8f6b-4e43-80d1-ae3a6eb29d84",
      "text": "đừng buông lời trách móc,",
      "label": "31",
      "number": 31,
      "subVerseIndex": 2,
      "paragraphNumber": 72,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:12.267Z",
      "updatedAt": "2025-09-03T02:52:12.267Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "6a7f7d33-0b29-44af-9c62-ab7fa3323b2d",
      "text": "cũng đừng đòi nợ nó kẻo nó nổi sùng.",
      "label": "31",
      "number": 31,
      "subVerseIndex": 3,
      "paragraphNumber": 73,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:12.280Z",
      "updatedAt": "2025-09-03T02:52:12.280Z",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    }
  ],
  "marks": [
    {
      "id": "78184175-36de-4945-ae62-7e9506620460",
      "content": "Các bản dịch hơi lấn cấn ở chỗ này : *Bận tâm của lúc thức ngăn không cho chợp mắt* ; *Bận tâm cả ngày chẳng sao ngủ được* ; *Bận tâm của lúc thức kêu gọi (ru ?) giấc ngủ*.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 42,
      "endOffset": 42,
      "createdAt": "2025-09-03T02:52:11.011Z",
      "updatedAt": "2025-09-03T02:52:11.011Z",
      "targetId": "a5e11026-ca30-473a-b8db-ba49a7bddfab",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "994a9bb4-d80e-4ecd-910a-b08f749522e3",
      "content": "Cn 28,20",
      "kind": "MARK_KIND_REFERENCE",
      "label": "1@",
      "sortOrder": 0,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:52:11.105Z",
      "updatedAt": "2025-09-03T02:52:11.105Z",
      "targetId": "f82d505e-7ab9-459f-99c5-d31a82914b9e",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "a01071e6-41d2-43e7-8331-e8aee52f3961",
      "content": "HR : *Nhiều người là nạn nhân của vàng bạc, và tin tưởng vào châu báu, họ không thoát khỏi nỗi bất hạnh, cũng chẳng được cứu thoát trong ngày thịnh nộ*.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 31,
      "endOffset": 31,
      "createdAt": "2025-09-03T02:52:11.162Z",
      "updatedAt": "2025-09-03T02:52:11.162Z",
      "targetId": "5b0d6c9e-8740-4f80-90e5-d50a409f57fc",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "5ff41e0c-357f-4b2b-a9b5-cd74201e913b",
      "content": "Cn 23,1-3.6-8",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:52:11.440Z",
      "updatedAt": "2025-09-03T02:52:11.440Z",
      "targetId": "b43c0a2b-bc43-4702-b0e8-ff920cb8a399",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "af3bcaa7-2e69-4b49-b33f-c3a8040c1371",
      "content": "*Cái bẫy*, ds : *khúc gỗ cho vấp*. Ý nói về vàng bạc, nhưng tác giả lại liên tưởng tới tượng thần người ta thờ (x. Mt 6,24).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 13,
      "endOffset": 13,
      "createdAt": "2025-09-03T02:52:11.200Z",
      "updatedAt": "2025-09-03T02:52:11.200Z",
      "targetId": "f2a34822-436c-4f74-b6a9-deb79eb57ed5",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "43b40539-620e-4e81-882b-86d26b0c151f",
      "content": "Cn 13,25",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:52:11.682Z",
      "updatedAt": "2025-09-03T02:52:11.682Z",
      "targetId": "5b3664a2-2ccf-4833-a7bb-fe691f406759",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "bd48702e-24db-49f7-b7e9-57dc0fe78fab",
      "content": "*Say mê nó*, cũng có bản : *tế lễ cho nó*. HR : *cho kẻ dại dột*.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 30,
      "endOffset": 30,
      "createdAt": "2025-09-03T02:52:11.215Z",
      "updatedAt": "2025-09-03T02:52:11.215Z",
      "targetId": "f2a34822-436c-4f74-b6a9-deb79eb57ed5",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "09bed200-10c0-4cab-a0e0-93b282a21d44",
      "content": "Cn 20,1; 23,20-21.29-35; 31,4-7; Is 5,22; 28,1-4",
      "kind": "MARK_KIND_REFERENCE",
      "label": "4@",
      "sortOrder": 3,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:52:11.965Z",
      "updatedAt": "2025-09-03T02:52:11.965Z",
      "targetId": "e20549bf-73e9-4ccf-893f-e65b2681736e",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "4dd780da-fc9d-440b-8c2d-130f98938c61",
      "content": "*Tiền tài* : từ Híp-ri gốc A-ram là mam-mon thường thấy trong các tác phẩm của các Ráp-bi, x. Mt 6,24 ; Lc 16,9.11.13.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "5",
      "sortOrder": 4,
      "startOffset": 33,
      "endOffset": 33,
      "createdAt": "2025-09-03T02:52:11.271Z",
      "updatedAt": "2025-09-03T02:52:11.271Z",
      "targetId": "e32cf86d-f750-4393-bd47-e464415979fc",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "8a9893ff-0ed5-4ea9-9fb0-717a1b9025e3",
      "content": "Tv 104,15",
      "kind": "MARK_KIND_REFERENCE",
      "label": "5@",
      "sortOrder": 4,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:52:12.092Z",
      "updatedAt": "2025-09-03T02:52:12.092Z",
      "targetId": "2bac6cfc-5dc2-40dd-a6b5-aa2a004e3486",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "33584fd9-62c9-495b-9c73-ded1d6de11b9",
      "content": "Câu này ám chỉ thói quen công bố trong các hội đường tên tuổi những ân nhân của cộng đoàn. Có lẽ trong Mt 6,2 Chúa Ki-tô cũng nhắc đến thói quen này, nhưng theo một ý nghĩa khác.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "6",
      "sortOrder": 5,
      "startOffset": 45,
      "endOffset": 45,
      "createdAt": "2025-09-03T02:52:11.395Z",
      "updatedAt": "2025-09-03T02:52:11.395Z",
      "targetId": "96caad7d-4db4-4646-866b-4a74757c413b",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "bf7a7d42-dbb3-4ac3-92d3-426425bdbf9f",
      "content": "Tl 9,13",
      "kind": "MARK_KIND_REFERENCE",
      "label": "6@",
      "sortOrder": 5,
      "startOffset": 28,
      "endOffset": 28,
      "createdAt": "2025-09-03T02:52:12.121Z",
      "updatedAt": "2025-09-03T02:52:12.121Z",
      "targetId": "3313f9b8-f4e0-4dd9-ba67-49ad2d9f0379",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "7798df98-2165-492f-865a-17b7ff6717f3",
      "content": "Con mắt được coi như tham lam nhất (“No bụng đói con mắt”), nó không bao giờ thoả mãn, bởi thế nó cũng là nguồn gốc sinh ra tội lỗi (x. Ds 15,39 ; G 31,7). *Nó phát khóc* vì không có được tất cả những gì nó ham muốn, và vì ghen với người khác về những gì họ có. *Vì thèm* được thêm vào cho rõ nghĩa.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "7",
      "sortOrder": 6,
      "startOffset": 35,
      "endOffset": 35,
      "createdAt": "2025-09-03T02:52:11.510Z",
      "updatedAt": "2025-09-03T02:52:11.510Z",
      "targetId": "aafef809-52c0-483b-89e7-73c20748a614",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "9c81cf75-f4df-4649-a6b6-80470ce62e06",
      "content": "1 Tm 5,23",
      "kind": "MARK_KIND_REFERENCE",
      "label": "7@",
      "sortOrder": 6,
      "startOffset": 14,
      "endOffset": 14,
      "createdAt": "2025-09-03T02:52:12.149Z",
      "updatedAt": "2025-09-03T02:52:12.149Z",
      "targetId": "cd20c6d1-8a9f-4add-bbac-b0765405b458",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "2f4ec200-02c3-42b0-ab4c-e1cd5a5f5cfe",
      "content": "Ông Ben Xi-ra rất thực tế. Lỡ ăn uống quá độ thì thà ói ra, chẳng thà bị ốm. Đây không phải là trường hợp những người Rô-ma giàu có ăn no rồi dùng thuốc gây nôn để ói ra, sau đó tiếp tục ăn.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "8",
      "sortOrder": 7,
      "startOffset": 27,
      "endOffset": 27,
      "createdAt": "2025-09-03T02:52:11.796Z",
      "updatedAt": "2025-09-03T02:52:11.796Z",
      "targetId": "c325668e-da55-4dc2-a8ec-e980d8024dc0",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "c388f8b0-d38d-4d86-867d-67de71c1158b",
      "content": "*Giữ chừng mực*, HL *mau mắn*. Có lẽ nghĩa này hợp hơn, vì nói về công việc thì siêng năng, mau mắn là cần thiết.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "9",
      "sortOrder": 8,
      "startOffset": 45,
      "endOffset": 45,
      "createdAt": "2025-09-03T02:52:11.851Z",
      "updatedAt": "2025-09-03T02:52:11.851Z",
      "targetId": "0df07fe8-f932-49db-8ac2-6d2b98a2bb07",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    },
    {
      "id": "a2353382-40ed-4816-9ce2-7dd656592c1a",
      "content": "HR : *Thật là nhức óc, đắng cay và xấu hổ, khi uống rượu mà cãi cọ và giận dữ*.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "10",
      "sortOrder": 9,
      "startOffset": 39,
      "endOffset": 39,
      "createdAt": "2025-09-03T02:52:12.192Z",
      "updatedAt": "2025-09-03T02:52:12.192Z",
      "targetId": "9dfdc1e7-53e5-47b6-b074-19cf84eb990b",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "b68b1db7-fa1e-4469-87b9-d5b83723e1e5"
    }
  ],
