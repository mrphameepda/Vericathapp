{
  "chapter": {
    "id": "f44766e0-c891-4dc8-b817-34378c8ba37a",
    "number": 35,
    "createdAt": "2025-09-03T01:07:51.705Z",
    "updatedAt": "2025-09-03T01:07:51.705Z",
    "bookId": "5c66a463-0bfa-46b7-9af1-3766a8779b73"
  },
  "verses": [
    {
      "id": "6d5d5606-f888-433d-ad81-28b1f5e986ba",
      "text": "Tuân giữ Lề Luật là làm cho lễ phẩm thêm phong phú.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.008Z",
      "updatedAt": "2025-09-03T02:52:38.008Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "01bb9955-ded9-4370-8131-da2d2b63e8b1",
      "text": "Gắn bó với lệnh truyền là dâng lễ kỳ an.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.051Z",
      "updatedAt": "2025-09-03T02:52:38.051Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "54d0c8ce-5035-447d-9ffb-ffa154bb0428",
      "text": "Tỏ lòng biết ơn là dâng bột tinh hảo,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.074Z",
      "updatedAt": "2025-09-03T02:52:38.074Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "01e75cfb-e813-4f5e-8901-3b8cdd502435",
      "text": "làm việc bố thí là dâng lễ ngợi khen.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.097Z",
      "updatedAt": "2025-09-03T02:52:38.097Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "45e9e537-d412-4a72-a105-7138886257e6",
      "text": "Từ bỏ gian tà thì đẹp lòng Đức Chúa,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.111Z",
      "updatedAt": "2025-09-03T02:52:38.111Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "7469a23a-3ee6-4948-8f76-a1fedd6cb892",
      "text": "chấm dứt bất công là dâng lễ đền tội.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.125Z",
      "updatedAt": "2025-09-03T02:52:38.125Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "b8541dc8-225b-4cd1-ab8b-ebf9dae1f967",
      "text": "Tuy vậy, đừng đến trước nhan Đức Chúa tay không,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.140Z",
      "updatedAt": "2025-09-03T02:52:38.140Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "273d4e4d-4cf4-4cf9-9ae4-676f3885f0b8",
      "text": "vì tất cả những gì phải dâng đều do lệnh truyền.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.154Z",
      "updatedAt": "2025-09-03T02:52:38.154Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "1d457a2f-be8c-4eec-8697-b1cdd8a567b5",
      "text": "Lễ phẩm của người công chính như mỡ đổ trên bàn thờ",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.168Z",
      "updatedAt": "2025-09-03T02:52:38.168Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "a4a03cd4-cd6f-4388-ba3a-5b03a1e5bc52",
      "text": "xông mùi thơm ngào ngạt trước Đấng Tối Cao.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.198Z",
      "updatedAt": "2025-09-03T02:52:38.198Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "62f0e30b-d14a-4e60-9c46-d69cbdfa9179",
      "text": "Hy lễ của người công chính được chấp nhận,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.226Z",
      "updatedAt": "2025-09-03T02:52:38.226Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "8607cde4-5f63-4038-87c3-4200c3e2bde7",
      "text": "và phần kỷ vật sẽ không bị lãng quên.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.254Z",
      "updatedAt": "2025-09-03T02:52:38.254Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "eb55e009-7d26-40ac-b8bb-253d3f468827",
      "text": "Hãy tôn vinh Đức Chúa với tấm lòng quảng đại,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.275Z",
      "updatedAt": "2025-09-03T02:52:38.275Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "5114b7fc-6977-4d8e-bfd5-96952255f007",
      "text": "đừng bớt xén của đầu mùa tay con làm ra.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.290Z",
      "updatedAt": "2025-09-03T02:52:38.290Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "9529f8be-b935-410c-9458-d13dda288363",
      "text": "Dâng cúng chi, cũng phải giữ nét mặt tươi cười ;",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.304Z",
      "updatedAt": "2025-09-03T02:52:38.304Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "c7e925c4-af1d-4ed5-93bb-b9ea6149e1ad",
      "text": "dâng hiến của thập phân, hãy hân hoan vui vẻ.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.318Z",
      "updatedAt": "2025-09-03T02:52:38.318Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "56de8d08-5548-479e-91a5-c5b873b8c1da",
      "text": "Với tấm lòng quảng đại, hãy dâng hiến Đấng Tối Cao",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.346Z",
      "updatedAt": "2025-09-03T02:52:38.346Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "60d2aca2-eef8-4d86-bed5-7cb5ed173c18",
      "text": "tuỳ theo những gì Người ban tặng",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.374Z",
      "updatedAt": "2025-09-03T02:52:38.374Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "7e1c6d6d-9d94-4d4b-ba91-6ede33344b76",
      "text": "và tuỳ theo khả năng con có.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.388Z",
      "updatedAt": "2025-09-03T02:52:38.388Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "4d72065c-9184-4d90-856d-25610181c4a7",
      "text": "Vì Đức Chúa là Đấng thưởng công,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.413Z",
      "updatedAt": "2025-09-03T02:52:38.413Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "63c328b9-f35d-46d6-9ddc-400c63f2712a",
      "text": "sẽ trả lại cho con gấp bảy lần.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.423Z",
      "updatedAt": "2025-09-03T02:52:38.423Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "12556897-96b1-498f-b0af-94f6613f4425",
      "text": "Đừng hối lộ, Người chẳng nhận đâu.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.434Z",
      "updatedAt": "2025-09-03T02:52:38.434Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "be18cdb8-9dce-4737-b4c1-56d749b4e99e",
      "text": "Đừng ỷ vào hy lễ bất chính.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.457Z",
      "updatedAt": "2025-09-03T02:52:38.457Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "27bfe78c-8eee-4c8b-8190-b0c549ccaa3d",
      "text": "Vì Đức Chúa là Đấng xét xử,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.474Z",
      "updatedAt": "2025-09-03T02:52:38.474Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "a4136676-7b1d-4af6-8fe4-ba93d757c6e3",
      "text": "Người chẳng thiên vị ai.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.488Z",
      "updatedAt": "2025-09-03T02:52:38.488Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "811a33fb-5f47-47b0-ac31-6bb5073ea4ad",
      "text": "Người không vị nể mà làm hại kẻ nghèo hèn,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.516Z",
      "updatedAt": "2025-09-03T02:52:38.516Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "bfacdd82-ee67-46ef-925d-c98fab0e4871",
      "text": "nhưng nghe lời kêu xin của người bị áp bức.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.558Z",
      "updatedAt": "2025-09-03T02:52:38.558Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "4bb01411-63ce-495e-8ee3-b6b196f0432c",
      "text": "Người không coi thường lời khấn nguyện của kẻ mồ côi,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.572Z",
      "updatedAt": "2025-09-03T02:52:38.572Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "70ace1a5-46f8-4e9a-a5f9-a77beffc70d9",
      "text": "hay tiếng than van của người goá bụa.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.602Z",
      "updatedAt": "2025-09-03T02:52:38.602Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "9f8b27f9-921e-45c0-beac-0b277fc232a3",
      "text": "Nước mắt quả phụ lại không giàn giụa trên gò má,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.616Z",
      "updatedAt": "2025-09-03T02:52:38.616Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "b9ad48fd-c2b6-409f-8337-de5f22dbd887",
      "text": "và tiếng bà kêu lại chẳng cáo tội kẻ làm bà phải khóc sao ?",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.644Z",
      "updatedAt": "2025-09-03T02:52:38.644Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "4282152b-05db-481b-9f63-131147ce86f8",
      "text": "Kẻ phục vụ Đức Chúa theo ý Người sẽ được Người chấp nhận,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.658Z",
      "updatedAt": "2025-09-03T02:52:38.658Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "2ef43c4d-c6ea-450c-9ec2-74df2cf1007e",
      "text": "lời họ kêu xin sẽ vọng tới các tầng mây.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.688Z",
      "updatedAt": "2025-09-03T02:52:38.688Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "a3c53e36-232d-4efb-ba20-813b36ed1b70",
      "text": "Lời nguyện của người nghèo vượt ngàn mây thẳm.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.716Z",
      "updatedAt": "2025-09-03T02:52:38.716Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "1d9f6030-7ad6-4c7f-9f9f-762125065b54",
      "text": "Lời nguyện chưa tới đích, họ chưa an lòng.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.730Z",
      "updatedAt": "2025-09-03T02:52:38.730Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "56d873dc-c87c-4405-bb31-2d3b91acfd3a",
      "text": "Họ sẽ không rời đi bao lâu Đấng Tối Cao chưa đoái nhìn,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.745Z",
      "updatedAt": "2025-09-03T02:52:38.745Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "906cba5a-af64-423f-b85a-0d7f49316d0f",
      "text": "chưa xét xử cho người chính trực và thi hành công lý.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.773Z",
      "updatedAt": "2025-09-03T02:52:38.773Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "5ea0eb1c-cca7-4c99-a38c-c2bc0dd864c8",
      "text": "Đức Chúa không trì hoãn,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.787Z",
      "updatedAt": "2025-09-03T02:52:38.787Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "99bbfce3-abe0-4715-8fef-a2b409cf39cb",
      "text": "không bắt họ đợi lâu.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.800Z",
      "updatedAt": "2025-09-03T02:52:38.800Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "7d43a1e9-ace0-42b9-acee-8b7f8d230886",
      "text": "Sẽ đến lúc Người đập gãy lưng bọn tàn ác,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.815Z",
      "updatedAt": "2025-09-03T02:52:38.815Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "b80e144b-a3da-4296-b249-cdba4d7f4bc2",
      "text": "và báo oán chư dân.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.829Z",
      "updatedAt": "2025-09-03T02:52:38.829Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "6a9fb5fe-c258-4dbd-a6d3-764d92ec4c65",
      "text": "Sẽ đến lúc Người tiễu trừ lũ ngạo ngược,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.843Z",
      "updatedAt": "2025-09-03T02:52:38.843Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "70c29c14-58dd-4a6e-bbb6-b2f8588451e3",
      "text": "đập tan vương trượng bọn ác nhân.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.857Z",
      "updatedAt": "2025-09-03T02:52:38.857Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "f351118e-1a6c-4b36-82b5-f14a1963a894",
      "text": "Sẽ đến lúc Người trả cho ai nấy theo việc họ làm,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.870Z",
      "updatedAt": "2025-09-03T02:52:38.870Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "9e4d7fcf-5ce5-4fee-8bd2-c476ac0d782c",
      "text": "và xét xử hành động của người ta theo ý hướng của họ.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.886Z",
      "updatedAt": "2025-09-03T02:52:38.886Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "286c1518-addf-4cd5-bbfd-316d497fe368",
      "text": "Sẽ đến lúc Người phân xử cho dân Người,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.899Z",
      "updatedAt": "2025-09-03T02:52:38.899Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "21e4352e-6c9c-4d43-922c-5e5422b4dd21",
      "text": "khiến họ vui mừng vì được Người thương xót.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.919Z",
      "updatedAt": "2025-09-03T02:52:38.919Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "799cd6f1-d30f-480d-95a9-0a94de077b8b",
      "text": "Đẹp thay lòng thương xót của Người giữa buổi gian truân,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.933Z",
      "updatedAt": "2025-09-03T02:52:38.933Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "55b990aa-0317-42d5-bba7-b5fad0b813cd",
      "text": "khác chi mây trời đổ mưa thời nắng hạn !",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:38.946Z",
      "updatedAt": "2025-09-03T02:52:38.946Z",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    }
  ],
  "marks": [
    {
      "id": "1a7fc69e-29a7-4951-8bb0-69119bb3c315",
      "content": "Ông Ben Xi-ra vừa là người trọng nghi thức, rất gắn bó với phụng tự, vừa là nhà luân lý luôn quan tâm tới việc tuân giữ Lề Luật. Hai khuynh hướng này được dung hợp nhau ở đây : đối với ông thi hành Lề Luật là thờ phượng Thiên Chúa.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 16,
      "endOffset": 16,
      "createdAt": "2025-09-03T02:52:38.040Z",
      "updatedAt": "2025-09-03T02:52:38.040Z",
      "targetId": "07fc8535-2713-4fde-b944-f4125666895f",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "8add1210-9bb9-403e-bc52-9a27284e4681",
      "content": "Lv 2,1-3",
      "kind": "MARK_KIND_REFERENCE",
      "label": "1@",
      "sortOrder": 0,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:52:38.240Z",
      "updatedAt": "2025-09-03T02:52:38.240Z",
      "targetId": "62f0e30b-d14a-4e60-9c46-d69cbdfa9179",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "eed0fbc1-9cda-4d6c-adc6-f2ceddb784c6",
      "content": "*Lễ kỳ an* cũng gọi là *Lễ hiệp thông*, hoặc *Lễ giao ước* (x. Lv 3), gồm một phần (mỡ) đốt dâng cho Thiên Chúa, phần thứ hai dành cho các tư tế và phần thứ ba (còn lại) cho người dâng lễ và bà con thân thuộc.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 39,
      "endOffset": 39,
      "createdAt": "2025-09-03T02:52:38.062Z",
      "updatedAt": "2025-09-03T02:52:38.062Z",
      "targetId": "01bb9955-ded9-4370-8131-da2d2b63e8b1",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "29044448-f066-42df-a25f-71d1e714fef3",
      "content": "Đnl 12,6; 14,23; 26,12-15",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 10,
      "endOffset": 10,
      "createdAt": "2025-09-03T02:52:38.332Z",
      "updatedAt": "2025-09-03T02:52:38.332Z",
      "targetId": "c7e925c4-af1d-4ed5-93bb-b9ea6149e1ad",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "d71811d3-b01f-4bb6-a7e5-9b7e79a29f18",
      "content": "*Lòng biết ơn* hiểu về lòng bác ái (BJ) song song với việc bố thí ở vế sau, hoặc hiểu về việc tạ ơn Thiên Chúa.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 15,
      "endOffset": 15,
      "createdAt": "2025-09-03T02:52:38.085Z",
      "updatedAt": "2025-09-03T02:52:38.085Z",
      "targetId": "54d0c8ce-5035-447d-9ffb-ffa154bb0428",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "d53db8ac-91ef-4321-ba57-fc1cce48f641",
      "content": "Đnl 10,17; G 34,19",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 6,
      "endOffset": 6,
      "createdAt": "2025-09-03T02:52:38.545Z",
      "updatedAt": "2025-09-03T02:52:38.545Z",
      "targetId": "811a33fb-5f47-47b0-ac31-6bb5073ea4ad",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "e3fd7083-9cde-44c3-a8c2-af403b8c19eb",
      "content": "*Mỡ* là phần quý nhất trong lễ vật, phải đốt dâng kính Thiên Chúa (x. Lv 3,14-17).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 51,
      "endOffset": 51,
      "createdAt": "2025-09-03T02:52:38.182Z",
      "updatedAt": "2025-09-03T02:52:38.182Z",
      "targetId": "1d457a2f-be8c-4eec-8697-b1cdd8a567b5",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "17e4a9ee-2e0c-427d-95c2-3c87d0d4ebb1",
      "content": "Xh 22,21-23; Cn 23,10-11",
      "kind": "MARK_KIND_REFERENCE",
      "label": "4@",
      "sortOrder": 3,
      "startOffset": 46,
      "endOffset": 46,
      "createdAt": "2025-09-03T02:52:38.587Z",
      "updatedAt": "2025-09-03T02:52:38.587Z",
      "targetId": "4bb01411-63ce-495e-8ee3-b6b196f0432c",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "f288ecae-8c75-407c-8c0f-2fb93eb670e6",
      "content": "English: Most High | French: Très-Haut | Latin: Altissimus | Origin: &#1506;&#1462;&#1500;&#1456;&#1497;&#64331;&#1503; -- &#933;&#968;&#953;&#963;&#964;&#959;&#962; | Vietnamese: Đấng Tối Cao -- được dùng như tên riêng của Thiên Chúa thật, -- Is 14,14 ; Tv 91,1.9 ; Lc 1,32",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "5",
      "sortOrder": 4,
      "startOffset": 42,
      "endOffset": 42,
      "createdAt": "2025-09-03T02:52:38.212Z",
      "updatedAt": "2025-09-03T02:52:38.212Z",
      "targetId": "a4a03cd4-cd6f-4388-ba3a-5b03a1e5bc52",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "1b37db55-42f1-42b1-931c-74528d5f59cb",
      "content": "English: Most High | French: Très-Haut | Latin: Altissimus | Origin: &#1506;&#1462;&#1500;&#1456;&#1497;&#64331;&#1503; -- &#933;&#968;&#953;&#963;&#964;&#959;&#962; | Vietnamese: Đấng Tối Cao -- được dùng như tên riêng của Thiên Chúa thật, -- Is 14,14 ; Tv 91,1.9 ; Lc 1,32",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "6",
      "sortOrder": 5,
      "startOffset": 50,
      "endOffset": 50,
      "createdAt": "2025-09-03T02:52:38.360Z",
      "updatedAt": "2025-09-03T02:52:38.360Z",
      "targetId": "56de8d08-5548-479e-91a5-c5b873b8c1da",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "2e213740-701a-4410-b683-52298160434c",
      "content": "ds : *như mắt con thấy là tốt, theo tay con gặp được*. HR thêm vào bên lề : *Ai cho kẻ nghèo là cho Thiên Chúa mượn ; ai sẽ trả lại người ấy, nếu không phải là Chúa ?* (x. Cn 19,17).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "7",
      "sortOrder": 6,
      "startOffset": 27,
      "endOffset": 27,
      "createdAt": "2025-09-03T02:52:38.402Z",
      "updatedAt": "2025-09-03T02:52:38.402Z",
      "targetId": "7e1c6d6d-9d94-4d4b-ba91-6ede33344b76",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "facf1c80-32c1-4a2b-b6f4-7f16ffb1b019",
      "content": "ds : *Đối với Người thì vinh quang bề mặt chẳng là gì*.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "8",
      "sortOrder": 7,
      "startOffset": 23,
      "endOffset": 23,
      "createdAt": "2025-09-03T02:52:38.502Z",
      "updatedAt": "2025-09-03T02:52:38.502Z",
      "targetId": "a4136676-7b1d-4af6-8fe4-ba93d757c6e3",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "42b14a29-6b79-4acf-842a-88cb98923c09",
      "content": "Thiên Chúa vẫn mang danh hiệu là Đấng bảo trợ cô nhi, quả phụ và kẻ nghèo hèn. Người nghe tiếng kêu oán và thi hành công lý cho họ ; x. Xh 22,21-22 ; Cn 22,22-23 ; 23,10-11.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "9",
      "sortOrder": 8,
      "startOffset": 41,
      "endOffset": 41,
      "createdAt": "2025-09-03T02:52:38.531Z",
      "updatedAt": "2025-09-03T02:52:38.531Z",
      "targetId": "811a33fb-5f47-47b0-ac31-6bb5073ea4ad",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "95404117-5948-4688-bead-536a45face29",
      "content": "English: Water Gate | French: Eaux (Porte des) | Latin: Aquarum (porta) | Origin: &#1492;&#1463;&#1502;&#1468;&#1464;&#1497;&#1477;&#1501; &#8206;(&#64298;&#1463;&#1506;&#1463;&#1512;&#1470;) | Vietnamese: Nước (cửa) -- Nkm 8,1.3",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "10",
      "sortOrder": 9,
      "startOffset": 4,
      "endOffset": 4,
      "createdAt": "2025-09-03T02:52:38.630Z",
      "updatedAt": "2025-09-03T02:52:38.630Z",
      "targetId": "9f8b27f9-921e-45c0-beac-0b277fc232a3",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "16fb29b6-a846-403f-aa88-4c14e88b9f20",
      "content": "Bản văn chỉ nói trống : *Ai phục vụ trong sự vui lòng*, cho nên cũng có thể hiểu về phục vụ tha nhân ; chữ *vui lòng* cũng hiểu được về tha nhân, hoặc về người phục vụ.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "11",
      "sortOrder": 10,
      "startOffset": 32,
      "endOffset": 32,
      "createdAt": "2025-09-03T02:52:38.674Z",
      "updatedAt": "2025-09-03T02:52:38.674Z",
      "targetId": "4282152b-05db-481b-9f63-131147ce86f8",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
    {
      "id": "48045379-d0bf-4710-9ec4-08cd525e5f52",
      "content": "*Các tầng mây* là nơi Thiên Chúa ngự (x. Tv 68,35 ; 104,3 ; v.v...).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "12",
      "sortOrder": 11,
      "startOffset": 39,
      "endOffset": 39,
      "createdAt": "2025-09-03T02:52:38.702Z",
      "updatedAt": "2025-09-03T02:52:38.702Z",
      "targetId": "2ef43c4d-c6ea-450c-9ec2-74df2cf1007e",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f44766e0-c891-4dc8-b817-34378c8ba37a"
    },
