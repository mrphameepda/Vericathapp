{
  "chapter": {
    "id": "c33303cd-2573-4c32-bdd5-854f92abc464",
    "number": 37,
    "createdAt": "2025-09-03T01:07:51.705Z",
    "updatedAt": "2025-09-03T01:07:51.705Z",
    "bookId": "5c66a463-0bfa-46b7-9af1-3766a8779b73"
  },
  "verses": [
    {
      "id": "9946bae3-2963-4f0c-91a6-75f7019688ff",
      "text": "Bạn bè nào chẳng nói : “Đây cũng chỗ thân thiết mà !”",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.058Z",
      "updatedAt": "2025-09-03T02:52:51.058Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "1f03fde2-955a-4e0d-bf8a-b0e33a6d328c",
      "text": "Nhưng có người chỉ mang danh là bạn.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.116Z",
      "updatedAt": "2025-09-03T02:52:51.116Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "ceace614-7f86-44fe-b400-7a02421292bc",
      "text": "Không buồn chết được sao",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.129Z",
      "updatedAt": "2025-09-03T02:52:51.129Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "8dcd4ba5-3e6a-4eea-8b75-04e9b1b5f69e",
      "text": "khi bạn bè thân hữu lại hoá nên thù địch ?",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.140Z",
      "updatedAt": "2025-09-03T02:52:51.140Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "78cdd905-c4e6-43c0-b4d8-d00dff6ddb71",
      "text": "Ôi, xu hướng xấu xa,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.153Z",
      "updatedAt": "2025-09-03T02:52:51.153Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "547f4e83-802e-4c1f-83c6-b6c5570030b1",
      "text": "ngươi được hình thành theo khuôn mẫu nào",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.196Z",
      "updatedAt": "2025-09-03T02:52:51.196Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "08dd8fc0-3cce-4e72-bb3a-513173f87cd5",
      "text": "mà gieo rắc lừa bịp khắp dương gian như thế ?",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.224Z",
      "updatedAt": "2025-09-03T02:52:51.224Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "a2e5e230-008f-41e2-a952-d6357c69df5d",
      "text": "Có kẻ mừng rỡ khi thấy bạn vui,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.238Z",
      "updatedAt": "2025-09-03T02:52:51.238Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "b262b79f-8aec-43b0-8877-7ea4e9fe0f13",
      "text": "nhưng lúc bạn gặp khó khăn thì liền trở mặt.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.253Z",
      "updatedAt": "2025-09-03T02:52:51.253Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "c8cdf26d-0e8d-4238-b0c4-e4258889b8e1",
      "text": "Có người thấy miếng ăn thì cùng bạn chịu khó,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.269Z",
      "updatedAt": "2025-09-03T02:52:51.269Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "5bd6cb85-8ddb-4790-b091-31b9a065b674",
      "text": "nhưng khi phải chiến đấu thì chỉ biết phòng thân.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.296Z",
      "updatedAt": "2025-09-03T02:52:51.296Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "40ba4c86-2148-4187-ba56-e9a4f00b59f5",
      "text": "Tự thâm tâm, chớ quên bạn hữu,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.310Z",
      "updatedAt": "2025-09-03T02:52:51.310Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "72bf0fe8-4096-4f0e-b64a-d3b7520a3fce",
      "text": "lúc giàu có, cũng đừng làm ngơ.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.324Z",
      "updatedAt": "2025-09-03T02:52:51.324Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "b57ed3f0-133c-4690-a2e3-41bbd504625d",
      "text": "Cố vấn nào cũng đưa ra ý kiến,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.366Z",
      "updatedAt": "2025-09-03T02:52:51.366Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "50da17d2-cc54-44a9-a671-28dba74f7ce7",
      "text": "nhưng có người góp ý vì lợi ích riêng tư.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.416Z",
      "updatedAt": "2025-09-03T02:52:51.416Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "a6f62f4e-46b4-4133-b620-766e6616c208",
      "text": "Hãy thận trọng với người chuyên góp ý :",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.429Z",
      "updatedAt": "2025-09-03T02:52:51.429Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "33f59273-5600-4edf-91b9-6195bea4c6e9",
      "text": "trước tiên cần biết hắn muốn gì,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.441Z",
      "updatedAt": "2025-09-03T02:52:51.441Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "22d00fc5-ff84-4c4f-bd15-ab6622a216ee",
      "text": "– hắn góp ý chẳng qua vì tư lợi –",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.453Z",
      "updatedAt": "2025-09-03T02:52:51.453Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "d726dc74-d956-47b4-a036-fff85be36cc4",
      "text": "đừng để cho hắn lợi dụng con.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 3,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.465Z",
      "updatedAt": "2025-09-03T02:52:51.465Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "d75d2853-aa1d-48f4-9c4e-f0c5ff15be3a",
      "text": "Hắn bảo : “Anh đi đúng đường rồi đó !”",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.477Z",
      "updatedAt": "2025-09-03T02:52:51.477Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "9a6278e0-b0ac-48e0-ae1b-d1ce10ffd4ea",
      "text": "rồi chỉ đứng xa xa mà nhìn,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.491Z",
      "updatedAt": "2025-09-03T02:52:51.491Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "20b02790-b24c-4e81-9f3c-14c8592c4308",
      "text": "xem chuyện gì xảy đến cho con.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.504Z",
      "updatedAt": "2025-09-03T02:52:51.504Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "70ee8b7b-6994-4e5e-bfd9-9a632039e8d4",
      "text": "Đừng hỏi ý kẻ nhìn con bằng đôi mắt ngờ vực,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.519Z",
      "updatedAt": "2025-09-03T02:52:51.519Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "425ffb9a-3887-4d71-b43f-ca88be6eaf05",
      "text": "chớ tiết lộ dự tính cho kẻ ganh đua với con.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.533Z",
      "updatedAt": "2025-09-03T02:52:51.533Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "aa3a0f57-c14e-4a67-b3de-2c1b42d806ff",
      "text": "Đừng hỏi ý phụ nữ về tình địch của họ,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.547Z",
      "updatedAt": "2025-09-03T02:52:51.547Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "c1b45f8f-918c-4563-8136-4165af3e0699",
      "text": "người nhát đảm về việc chinh chiến,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.578Z",
      "updatedAt": "2025-09-03T02:52:51.578Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "32656407-aa02-4951-8b5e-53bb3a52220e",
      "text": "nhà buôn về việc mua, người mua về việc bán.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.593Z",
      "updatedAt": "2025-09-03T02:52:51.593Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "628d9f11-5529-4206-a0af-5ae634340b21",
      "text": "Chớ hỏi ý kẻ hay phân bì về việc cám ơn,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 3,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.621Z",
      "updatedAt": "2025-09-03T02:52:51.621Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "83d9c3fa-a45e-4c54-8d91-d50d8263a0b8",
      "text": "đứa bất nhân về việc làm phúc,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 4,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.635Z",
      "updatedAt": "2025-09-03T02:52:51.635Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "d21a54bc-981b-43a8-b214-4e3e8fa834d6",
      "text": "tên biếng nhác về bất cứ việc gì,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 5,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.649Z",
      "updatedAt": "2025-09-03T02:52:51.649Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "98b396dd-ce3b-4468-a82e-82ae5dc11f12",
      "text": "người làm thuê theo hạn kỳ về ngày hết hạn,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 6,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.663Z",
      "updatedAt": "2025-09-03T02:52:51.663Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "e70fb3e4-290a-4280-8f2e-ad0d6f42fb6f",
      "text": "một đứa ở ươn lười về một công việc lớn.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 7,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.677Z",
      "updatedAt": "2025-09-03T02:52:51.677Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "5326910b-54c2-4f4c-8ba0-bec2b7a2c75f",
      "text": "Đừng hỏi ý những hạng người như trên về bất cứ chuyện gì.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 8,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.691Z",
      "updatedAt": "2025-09-03T02:52:51.691Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "a7e78655-f375-402b-80de-c3a40997256c",
      "text": "Nhưng hãy năng đến với một người đạo đức,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.706Z",
      "updatedAt": "2025-09-03T02:52:51.706Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "97b440ed-03e5-4818-b669-7188bf66fb6d",
      "text": "người con biết là vẫn tuân giữ lệnh truyền,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.750Z",
      "updatedAt": "2025-09-03T02:52:51.750Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "2807f10d-9d39-4a2b-98d3-14d7dc6e76eb",
      "text": "người tâm đầu ý hợp với con, biết cảm thông khi con lầm lỡ.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.764Z",
      "updatedAt": "2025-09-03T02:52:51.764Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "a2bf4525-2f8f-45fe-8f35-c0a96c96461e",
      "text": "Rồi con cứ bụng bảo dạ mà làm,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.778Z",
      "updatedAt": "2025-09-03T02:52:51.778Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "bbff090f-2b0d-499f-9e75-9028ab81aa27",
      "text": "vì chẳng còn ai đáng tin hơn.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.793Z",
      "updatedAt": "2025-09-03T02:52:51.793Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "a862d76f-63af-4869-9d81-b4de75146261",
      "text": "Nhiều khi tâm hồn báo cho con người biết rõ,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.807Z",
      "updatedAt": "2025-09-03T02:52:51.807Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "6dd69401-bfed-4865-bd88-26112efeea59",
      "text": "hơn cả bảy người đứng gác trên trạm cao.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.821Z",
      "updatedAt": "2025-09-03T02:52:51.821Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "9095d64e-aff8-41c0-b958-3a6864c8df34",
      "text": "Nhưng quan trọng hơn hết :",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.850Z",
      "updatedAt": "2025-09-03T02:52:51.850Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "a0650f01-c115-418d-bb62-d0c60fc4302c",
      "text": "con hãy cầu xin Đấng Tối Cao dẫn con đi theo đường chân lý.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.864Z",
      "updatedAt": "2025-09-03T02:52:51.864Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "e8ebc177-95ba-43fa-b438-9b04687206eb",
      "text": "Bắt đầu làm việc là phải suy nghĩ,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.910Z",
      "updatedAt": "2025-09-03T02:52:51.910Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "5c249c85-224e-4749-a648-449c4ccd3fd8",
      "text": "trước khi thi hành thì phải đắn đo.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.954Z",
      "updatedAt": "2025-09-03T02:52:51.954Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "5bc51501-c8d4-4ba2-bbd9-f843eadf706c",
      "text": "Từ tâm não mà tư tưởng phát sinh",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.966Z",
      "updatedAt": "2025-09-03T02:52:51.966Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "38e8370d-fc19-4918-958c-0000b8eff716",
      "text": "hướng về bốn lãnh vực :",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:51.980Z",
      "updatedAt": "2025-09-03T02:52:51.980Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "d7233bd8-a542-4259-9ef0-84d65db11557",
      "text": "thiện với ác, sinh với tử,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:52.008Z",
      "updatedAt": "2025-09-03T02:52:52.008Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "75328a90-2249-4c36-ac79-f8457a18d78e",
      "text": "nhưng cả bốn luôn bị cái lưỡi chi phối.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:52.022Z",
      "updatedAt": "2025-09-03T02:52:52.022Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "3e91f47c-b142-4de9-bcd7-602851bbf5ac",
      "text": "Có người dạy thiên hạ thì thông minh,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:52.050Z",
      "updatedAt": "2025-09-03T02:52:52.050Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "ef10fae0-cf6a-4500-83a2-530b5b0b018c",
      "text": "nhưng vô tích sự đối với chính mình.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:52.065Z",
      "updatedAt": "2025-09-03T02:52:52.065Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "f4ac4501-1f31-4012-92aa-54189949d63b",
      "text": "Kẻ hay lý sự thì bị chê ghét,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:52.079Z",
      "updatedAt": "2025-09-03T02:52:52.079Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "92bb6644-2e86-426e-a493-b7c5f722b8c3",
      "text": "người như thế chỉ chết đói mà thôi.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:52.107Z",
      "updatedAt": "2025-09-03T02:52:52.107Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "958b3b82-9449-47bc-8e14-446f83d45b56",
      "text": "Quả thật, nó không được Đức Chúa ban ân sủng,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:52.134Z",
      "updatedAt": "2025-09-03T02:52:52.134Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "dfa6cec6-4e89-4b95-b68a-4d427da7540c",
      "text": "vì nó chẳng khôn ngoan chút nào.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:52.148Z",
      "updatedAt": "2025-09-03T02:52:52.148Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "dc8917e6-4247-46e2-9f74-d7ada642c0fd",
      "text": "Có kẻ khôn, nhưng chỉ để tìm lợi cho mình,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:52.162Z",
      "updatedAt": "2025-09-03T02:52:52.162Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "25e7cce6-c8af-49a0-a365-93619df0ba62",
      "text": "vì hiểu biết của nó chỉ mang lại lợi ích cho bản thân.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:52.190Z",
      "updatedAt": "2025-09-03T02:52:52.190Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "3c9e337d-403f-4c31-943f-b28b42a62a50",
      "text": "Người khôn thật chỉ vẽ cho dân,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:52.219Z",
      "updatedAt": "2025-09-03T02:52:52.219Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "f31ae79d-cdf4-40be-bfd3-9377c81131b6",
      "text": "hoa quả kiến thức của người đó rất là đáng tin cậy.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:52.234Z",
      "updatedAt": "2025-09-03T02:52:52.234Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "a613cf12-eca5-409b-a0ef-a9326c66f8cd",
      "text": "Người khôn ngoan hưởng phúc lộc đầy tràn,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:52.262Z",
      "updatedAt": "2025-09-03T02:52:52.262Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "0817c96c-76cb-460e-9b48-3898dc45db24",
      "text": "ai thấy họ cũng khen là có phúc.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:52.277Z",
      "updatedAt": "2025-09-03T02:52:52.277Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "264f2b20-f7c5-4d61-a975-38035aa0fbc5",
      "text": "Ngày đời của mỗi người đều có số, có hạn,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:52.292Z",
      "updatedAt": "2025-09-03T02:52:52.292Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "e31ad5b7-0684-44ad-8bea-b300d5aea0c8",
      "text": "chỉ ngày của Ít-ra-en mới vô số, vô cùng.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 61,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:52.305Z",
      "updatedAt": "2025-09-03T02:52:52.305Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "b83e38c7-ea0e-4ad1-b46b-6a86a58ba5b7",
      "text": "Người khôn ngoan thì được dân tín nhiệm,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 62,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:52.334Z",
      "updatedAt": "2025-09-03T02:52:52.334Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "de0315be-7a09-4a92-a8a4-298bd4aa3e8d",
      "text": "và danh thơm tồn tại đến muôn đời.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 63,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:52.363Z",
      "updatedAt": "2025-09-03T02:52:52.363Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "aec37eee-2b92-4977-af9f-4d80d8f46fa9",
      "text": "Con ơi, trong cuộc sống, hãy lượng lấy sức mình,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 64,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:52.377Z",
      "updatedAt": "2025-09-03T02:52:52.377Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "291406bc-ebc0-4fe0-9d19-dc158e265e35",
      "text": "thấy gì có hại, con chớ chiều theo.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 65,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:52.407Z",
      "updatedAt": "2025-09-03T02:52:52.407Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "8a2f4a10-649f-47b9-93b7-085fca10a81d",
      "text": "Vì không phải mọi sự đều hợp với mọi người,",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 66,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:52.421Z",
      "updatedAt": "2025-09-03T02:52:52.421Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "243727a5-483a-4bdc-9404-471dd7a81988",
      "text": "đâu phải cái gì ai ai cũng thích.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 1,
      "paragraphNumber": 67,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:52.445Z",
      "updatedAt": "2025-09-03T02:52:52.445Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "c9664a16-798d-429c-9e67-13d4bbaf314c",
      "text": "Khi dự tiệc vui, chớ ăn uống vô độ,",
      "label": "29",
      "number": 29,
      "subVerseIndex": 0,
      "paragraphNumber": 68,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:52.458Z",
      "updatedAt": "2025-09-03T02:52:52.458Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "38b51664-3e22-4282-a509-96be5780ef31",
      "text": "đừng hễ thấy miếng ăn là sấn vào,",
      "label": "29",
      "number": 29,
      "subVerseIndex": 1,
      "paragraphNumber": 69,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:52.470Z",
      "updatedAt": "2025-09-03T02:52:52.470Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "1c0e6993-04a4-44d4-a4fe-d3116b2870e0",
      "text": "vì tham thực cực thân,",
      "label": "30",
      "number": 30,
      "subVerseIndex": 0,
      "paragraphNumber": 70,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:52.486Z",
      "updatedAt": "2025-09-03T02:52:52.486Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "4b6f0a8f-2572-453c-b4ba-6dc94353b4d8",
      "text": "ăn quá nhiều sinh bội thực.",
      "label": "30",
      "number": 30,
      "subVerseIndex": 1,
      "paragraphNumber": 71,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:52.503Z",
      "updatedAt": "2025-09-03T02:52:52.503Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "4a97f94c-8f80-443a-8655-1ee8ad7ffca3",
      "text": "Lắm người thiệt mạng vì mê ăn mê uống,",
      "label": "31",
      "number": 31,
      "subVerseIndex": 0,
      "paragraphNumber": 72,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:52.517Z",
      "updatedAt": "2025-09-03T02:52:52.517Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "1570f46b-426e-4483-bb2b-8b2c215c6541",
      "text": "còn ai cẩn thận thì được sống lâu.",
      "label": "31",
      "number": 31,
      "subVerseIndex": 1,
      "paragraphNumber": 73,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:52:52.533Z",
      "updatedAt": "2025-09-03T02:52:52.533Z",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    }
  ],
  "marks": [
    {
      "id": "0ff77aa0-2636-4dca-a9af-1799b837e821",
      "content": "Hc 6,5-17",
      "kind": "MARK_KIND_REFERENCE",
      "label": "1@",
      "sortOrder": 0,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:52:51.089Z",
      "updatedAt": "2025-09-03T02:52:51.089Z",
      "targetId": "d8e8a30e-01b6-4030-bd67-650b9ad185f9",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "afa2d8a5-3277-46eb-ad15-e7f5e2fa6f2c",
      "content": "X. 15,14+ ở đấy *xu hướng, bản năng* chưa phải là xấu. Còn ở đây, nó thúc đẩy người ta làm điều xấu là lừa đảo bạn hữu. Tuy nhiên, vẫn có thể hiểu theo nghĩa *ý định* xấu của kẻ phỉnh gạt bạn. X. 17,31 ; 21,11.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 19,
      "endOffset": 19,
      "createdAt": "2025-09-03T02:52:51.168Z",
      "updatedAt": "2025-09-03T02:52:51.168Z",
      "targetId": "78cdd905-c4e6-43c0-b4d8-d00dff6ddb71",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "c33303cd-2573-4c32-bdd5-854f92abc464"
    },
    {
      "id": "9506a6fc-4e09-4a0c-b41a-5f17b3b09d64",
      "content": "Cn 20,6",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 33,
      "endOffset": 33,
      "createdAt": "2025-09-03T02:52:51.099Z",
      "updatedAt": "2025-09-03T02:52:51.099Z",
      "targetId": "9946bae3-2963-4f0c-91a6-75f7019688ff",
