{
  "chapter": {
    "id": "11bf7758-a0d6-467c-bc7c-a98fd04c6934",
    "number": 4,
    "createdAt": "2025-09-03T01:07:51.705Z",
    "updatedAt": "2025-09-03T01:07:51.705Z",
    "bookId": "5c66a463-0bfa-46b7-9af1-3766a8779b73"
  },
  "verses": [
    {
      "id": "ea5e825f-e337-42df-9246-a5a2f1fb8a05",
      "text": "Con ơi,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:50.881Z",
      "updatedAt": "2025-09-03T02:48:50.881Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "d77359a5-d309-436b-ae2a-b282a174670c",
      "text": "đừng tước đoạt miếng cơm manh áo của người nghèo,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:50.902Z",
      "updatedAt": "2025-09-03T02:48:50.902Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "1b1239bf-eb9a-4d04-88fc-6458de1043b3",
      "text": "đừng để kẻ khốn cùng luống công chờ đợi.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:50.912Z",
      "updatedAt": "2025-09-03T02:48:50.912Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "b1cd7dd4-c934-4353-b211-b94f319e3689",
      "text": "Đừng làm cho kẻ đói phải buồn tủi,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:50.923Z",
      "updatedAt": "2025-09-03T02:48:50.923Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "79d4fa10-8971-432f-bdbc-7df9a883888c",
      "text": "đừng chọc tức ai khi họ phải ngặt nghèo.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:50.936Z",
      "updatedAt": "2025-09-03T02:48:50.936Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "71e66784-a794-4067-8e03-28ede815d2ad",
      "text": "Một tâm hồn đang bực bội, con đừng làm khổ thêm,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:50.950Z",
      "updatedAt": "2025-09-03T02:48:50.950Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "6268e6fc-8222-4250-af73-32bbe8918180",
      "text": "đừng bắt kẻ túng thiếu đợi lâu mới được con giúp đỡ.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:50.964Z",
      "updatedAt": "2025-09-03T02:48:50.964Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "04778617-b15d-4e46-b45d-72d9817f2e8e",
      "text": "Kẻ khốn khổ nài xin, con đừng từ chối,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:50.994Z",
      "updatedAt": "2025-09-03T02:48:50.994Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "29db8a20-1c61-473a-9c14-e794d4dd7462",
      "text": "gặp người nghèo, con đừng ngoảnh mặt đi.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.008Z",
      "updatedAt": "2025-09-03T02:48:51.008Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "1c164eb8-8b44-4d3e-8d3f-c858847f42a5",
      "text": "Đừng làm ngơ không nhìn đến kẻ thiếu thốn,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.038Z",
      "updatedAt": "2025-09-03T02:48:51.038Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "0e0c5133-68e4-4dc0-84be-caa40c122c89",
      "text": "kẻo nên cớ cho người ta nguyền rủa con.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.050Z",
      "updatedAt": "2025-09-03T02:48:51.050Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "b640a1fa-1084-4e29-a4dd-7af24d0b52fd",
      "text": "Ai cay đắng trong lòng mà nguyền rủa con,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.061Z",
      "updatedAt": "2025-09-03T02:48:51.061Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "5a58770c-f776-46b4-884e-6db3894d41ce",
      "text": "thì Đấng tạo thành ra nó sẽ nghe lời nó thỉnh nguyện.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.075Z",
      "updatedAt": "2025-09-03T02:48:51.075Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "72bc58d6-7fed-4d88-a219-d8119564d71f",
      "text": "Hãy làm cho công hội mến thương con,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.108Z",
      "updatedAt": "2025-09-03T02:48:51.108Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "e4b66828-b8ff-45a3-9aa9-2cecb2700107",
      "text": "và tỏ lòng kính trọng người làm lớn.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.123Z",
      "updatedAt": "2025-09-03T02:48:51.123Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "c78a701a-1914-40c0-812e-5e81507f5faf",
      "text": "Hãy lắng nghe kẻ nghèo, và nhã nhặn chào lại họ.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.138Z",
      "updatedAt": "2025-09-03T02:48:51.138Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "c8663e26-e5cf-48e6-a177-0c6a7a2112a4",
      "text": "Hãy giải thoát người bị áp bức khỏi tay phường áp bức,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.150Z",
      "updatedAt": "2025-09-03T02:48:51.150Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "08153ece-b61b-4141-b2b3-15f494852fa7",
      "text": "đừng hèn nhát khi con phải xét xử.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.173Z",
      "updatedAt": "2025-09-03T02:48:51.173Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "56b31e3c-ac73-4c2d-9bca-3e855508603d",
      "text": "Đối với trẻ mồ côi, con hãy xử như một người cha,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.184Z",
      "updatedAt": "2025-09-03T02:48:51.184Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "3b789d3e-e59a-4421-90cc-7505dcd0b526",
      "text": "và với mẹ của chúng, hãy xử như một người chồng ;",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.210Z",
      "updatedAt": "2025-09-03T02:48:51.210Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "f1b82612-dbd7-49ac-a4c2-d207144cbeda",
      "text": "được vậy, con sẽ nên như người con của Đấng Tối Cao,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.252Z",
      "updatedAt": "2025-09-03T02:48:51.252Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "07db654e-7227-4217-8147-b65b0cb8f729",
      "text": "và Người sẽ thương con hơn cả mẹ của con nữa.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 3,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.296Z",
      "updatedAt": "2025-09-03T02:48:51.296Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "bf139b38-3786-4958-aa79-d91392445581",
      "text": "Khôn ngoan làm cho con cái mình nên cao trọng,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.326Z",
      "updatedAt": "2025-09-03T02:48:51.326Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "4913f26f-5efe-449d-aa87-c3c008ea2d70",
      "text": "và săn sóc những ai kiếm tìm mình.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.374Z",
      "updatedAt": "2025-09-03T02:48:51.374Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "e615a383-5586-4f70-8d96-6445ed0bd321",
      "text": "Ai yêu khôn ngoan là yêu sự sống,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.388Z",
      "updatedAt": "2025-09-03T02:48:51.388Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "a9a35a76-8241-4b07-8853-4a07566f937d",
      "text": "ai sớm tìm kiếm khôn ngoan sẽ tràn trề hoan lạc.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.401Z",
      "updatedAt": "2025-09-03T02:48:51.401Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "e2afbd04-b90e-41c6-99c5-637c83966e9b",
      "text": "Người nắm được khôn ngoan",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.417Z",
      "updatedAt": "2025-09-03T02:48:51.417Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "bfd8feb4-ecca-4855-8d6b-ecd60619fb51",
      "text": "sẽ được vinh quang làm gia nghiệp,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.431Z",
      "updatedAt": "2025-09-03T02:48:51.431Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "b5b6ec85-3430-4753-b207-5bce624966b4",
      "text": "đi tới đâu, họ cũng được Đức Chúa ban phúc lành.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.445Z",
      "updatedAt": "2025-09-03T02:48:51.445Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "6d01c0c5-2b16-4a0a-875c-188ad10c2d65",
      "text": "Ai phụng sự khôn ngoan thì cũng phụng thờ Đấng Thánh,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.459Z",
      "updatedAt": "2025-09-03T02:48:51.459Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "c5cb2742-be07-4337-8f71-29ac598b2d29",
      "text": "và ai yêu mến khôn ngoan thì được Đức Chúa mến yêu.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.473Z",
      "updatedAt": "2025-09-03T02:48:51.473Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "ac2ad989-4621-4df3-ba99-5792c9810c65",
      "text": "Người nghe theo khôn ngoan, thì xét xử chư dân,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.502Z",
      "updatedAt": "2025-09-03T02:48:51.502Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "9b71bdf9-f7db-480a-8211-2ccc4e4f97ad",
      "text": "ai gắn bó với khôn ngoan sẽ định cư yên hàn.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.516Z",
      "updatedAt": "2025-09-03T02:48:51.516Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "1682be6a-44a4-4d76-b7e3-583b495e7db9",
      "text": "Ai tin tưởng vào khôn ngoan,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.530Z",
      "updatedAt": "2025-09-03T02:48:51.530Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "32db2478-770c-4ea1-a819-d8c845acabab",
      "text": "sẽ được khôn ngoan làm gia nghiệp",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.545Z",
      "updatedAt": "2025-09-03T02:48:51.545Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "f146dab7-1d1a-46f8-b9f5-105011de376e",
      "text": "và dòng dõi họ cũng sẽ được thừa hưởng.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 2,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.559Z",
      "updatedAt": "2025-09-03T02:48:51.559Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "c4650216-5b76-42c9-b2c9-45f35a48278d",
      "text": "Vì ban đầu, khôn ngoan sẽ đồng hành với họ",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.573Z",
      "updatedAt": "2025-09-03T02:48:51.573Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "c0119136-6853-4259-a923-9937d1d51eb9",
      "text": "qua nẻo đường quanh co,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.601Z",
      "updatedAt": "2025-09-03T02:48:51.601Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "fd31b067-e791-48b3-9136-15c334c13233",
      "text": "giáng xuống trên họ hãi hùng run rẩy,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 2,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.616Z",
      "updatedAt": "2025-09-03T02:48:51.616Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "1fb02f5c-9b19-485d-87c0-d7e1763dd8a1",
      "text": "và dùng kỷ luật của mình mà tôi luyện",
      "label": "17",
      "number": 17,
      "subVerseIndex": 3,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.630Z",
      "updatedAt": "2025-09-03T02:48:51.630Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "376d746c-06fc-4e46-92b9-e73c21f6c7cf",
      "text": "bao lâu chưa tin tưởng họ được ;",
      "label": "17",
      "number": 17,
      "subVerseIndex": 4,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.645Z",
      "updatedAt": "2025-09-03T02:48:51.645Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "1fed33ce-e9c6-4492-9d02-9767a12fccc4",
      "text": "rồi lại thử thách họ qua những phán quyết của mình.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 5,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.659Z",
      "updatedAt": "2025-09-03T02:48:51.659Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "7e31aa64-6b7c-4625-b3e1-4055b0591082",
      "text": "Sau đó, khôn ngoan sẽ trở lại với họ trên con đường thẳng,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.672Z",
      "updatedAt": "2025-09-03T02:48:51.672Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "b8f1b68c-9634-40e5-860f-bc05bb3887cc",
      "text": "khiến họ được mừng vui,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.686Z",
      "updatedAt": "2025-09-03T02:48:51.686Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "68b1a65c-9b1d-4a9d-9e47-b34858d9acd8",
      "text": "và khôn ngoan mặc khải cho họ những bí nhiệm của mình.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 2,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.700Z",
      "updatedAt": "2025-09-03T02:48:51.700Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "9f622d39-39fb-4a7f-9775-1b9c395349a1",
      "text": "Nếu người ấy lầm lạc thì khôn ngoan sẽ bỏ rơi họ,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.727Z",
      "updatedAt": "2025-09-03T02:48:51.727Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "2323e781-f16b-4297-b196-bfdd06c17970",
      "text": "và để mặc cho họ sụp đổ.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.741Z",
      "updatedAt": "2025-09-03T02:48:51.741Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "aa0d162b-e1e9-492f-ab15-89a113f7167a",
      "text": "Hãy để ý tới thời cuộc và lo tránh điều xấu,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.768Z",
      "updatedAt": "2025-09-03T02:48:51.768Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "19ec3fe8-c994-4c0e-b99e-4e915ef3d813",
      "text": "và đừng chuốc lấy nhục vào thân.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.813Z",
      "updatedAt": "2025-09-03T02:48:51.813Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "e91e7cae-1308-4eb5-ac82-6dd6a6548d04",
      "text": "Vì có cái nhục đưa đến tội lỗi,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.827Z",
      "updatedAt": "2025-09-03T02:48:51.827Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "21422362-4c8e-4b37-99cd-cdcf79f0cba3",
      "text": "và cũng có cái nhục là vinh quang và ân sủng.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.854Z",
      "updatedAt": "2025-09-03T02:48:51.854Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "76d8ceb8-307c-40ad-8467-3dc32e4a3a7a",
      "text": "Đừng vị nể ai đến phải thiệt thân,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.868Z",
      "updatedAt": "2025-09-03T02:48:51.868Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "80f901ac-c9b6-4d14-b539-9f96ea64ef3d",
      "text": "cũng đừng vì bị nhục mà để cho mình sụp đổ.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.882Z",
      "updatedAt": "2025-09-03T02:48:51.882Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "e382bfd0-0e07-435a-8e51-ae12e35c92ed",
      "text": "Đừng ngại lên tiếng khi cần thiết,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.896Z",
      "updatedAt": "2025-09-03T02:48:51.896Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "5169fb31-cd6a-4552-a2d3-d54fca214f3f",
      "text": "vì nhờ lời nói mà người ta biết được ai khôn ngoan,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.923Z",
      "updatedAt": "2025-09-03T02:48:51.923Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "9fa9247d-937a-4cd1-ac12-6bd5d6eb890e",
      "text": "do phát biểu mà biết được trình độ học vấn.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.937Z",
      "updatedAt": "2025-09-03T02:48:51.937Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "a8e13243-ed2e-402e-8c89-9edd07426671",
      "text": "Đừng nói trái sự thật,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.952Z",
      "updatedAt": "2025-09-03T02:48:51.952Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "ac423eb7-3221-4825-be22-c19c8f356e6e",
      "text": "và phải biết xấu hổ vì sự thiếu học của con.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.965Z",
      "updatedAt": "2025-09-03T02:48:51.965Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "673bc202-69f7-40fa-91da-0d9a3ffd6663",
      "text": "Đừng hổ thẹn xưng thú tội lỗi mình,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:51.980Z",
      "updatedAt": "2025-09-03T02:48:51.980Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "cc843a50-beb6-4adc-bc12-530986876e02",
      "text": "đừng ngăn chặn dòng sông đang chảy.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:52.006Z",
      "updatedAt": "2025-09-03T02:48:52.006Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "7a2dcdc6-2587-441a-80cf-155290f82278",
      "text": "Đừng cúi rạp trước kẻ ngu đần,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:52.029Z",
      "updatedAt": "2025-09-03T02:48:52.029Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "a642a7eb-3f6e-4813-a381-fdc4774a75c3",
      "text": "cũng đừng thiên vị người quyền thế.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 61,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:52.040Z",
      "updatedAt": "2025-09-03T02:48:52.040Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "a95d55db-e46b-40f3-8cbf-022623127b64",
      "text": "Dù phải chết, con hãy phấn đấu cho sự thật,",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 62,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:52.051Z",
      "updatedAt": "2025-09-03T02:48:52.051Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "3737b42f-56df-4680-86d6-060c80ee653a",
      "text": "và Đức Chúa là Thiên Chúa sẽ bênh vực con.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 1,
      "paragraphNumber": 63,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:52.080Z",
      "updatedAt": "2025-09-03T02:48:52.080Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "6109bfe1-02d0-489a-9c0a-0b55639e7e81",
      "text": "Đừng ăn càn nói bậy,",
      "label": "29",
      "number": 29,
      "subVerseIndex": 0,
      "paragraphNumber": 64,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:52.094Z",
      "updatedAt": "2025-09-03T02:48:52.094Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "966b39a2-f91c-42e7-9c88-95f939ae4c4f",
      "text": "chớ nhu nhược trễ nải trong công việc của con.",
      "label": "29",
      "number": 29,
      "subVerseIndex": 1,
      "paragraphNumber": 65,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:52.122Z",
      "updatedAt": "2025-09-03T02:48:52.122Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "ebf5b8f1-5dfb-4e37-b2d6-dde5f83a65a2",
      "text": "Đừng như sư tử trong gia đình,",
      "label": "30",
      "number": 30,
      "subVerseIndex": 0,
      "paragraphNumber": 66,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:52.135Z",
      "updatedAt": "2025-09-03T02:48:52.135Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "25355c53-4a33-4939-999d-a454eb5c4caf",
      "text": "mà lại nhút nhát giữa gia nhân.",
      "label": "30",
      "number": 30,
      "subVerseIndex": 1,
      "paragraphNumber": 67,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:52.163Z",
      "updatedAt": "2025-09-03T02:48:52.163Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "ac7452bb-7984-410f-a6fe-cf9ef92c6629",
      "text": "Đừng xoè tay ra nhận, rồi nắm lại khi phải cho đi.",
      "label": "31",
      "number": 31,
      "subVerseIndex": 0,
      "paragraphNumber": 68,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:48:52.176Z",
      "updatedAt": "2025-09-03T02:48:52.176Z",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    }
  ],
