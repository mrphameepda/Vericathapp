    {
      "id": "e76b4731-b944-438e-b472-17b1f215058d",
      "content": "Cũng như ở Cn 1,23-25 ; 8,12-21 ; 9,1-6, ở đây đức khôn ngoan được nhân cách hoá. *Con cái* của khôn ngoan là những ai tìm hiểu và thi hành đức khôn ngoan (x. Lc 7,35). Ý tưởng nòng cốt ở đây là khôn ngoan được thông ban cho các môn sinh theo một đường lối giáo dục chặt chẽ.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 26,
      "endOffset": 26,
      "createdAt": "2025-09-03T02:48:51.360Z",
      "updatedAt": "2025-09-03T02:48:51.360Z",
      "targetId": "702df0b8-c305-41d7-b736-1d117bca6f87",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "3f9cc1d1-0911-45df-b48a-93ce3702cf52",
      "content": "G 29,12.17",
      "kind": "MARK_KIND_REFERENCE",
      "label": "4@",
      "sortOrder": 3,
      "startOffset": 4,
      "endOffset": 4,
      "createdAt": "2025-09-03T02:48:51.161Z",
      "updatedAt": "2025-09-03T02:48:51.161Z",
      "targetId": "c8663e26-e5cf-48e6-a177-0c6a7a2112a4",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "a23daedf-3bc3-43c0-bc02-fdd6d0800f23",
      "content": "Trong HR, cc. 15-19 là lời của khôn ngoan nói, tương tự như trong Cn 1,22 tt ; 8,1 tt.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 23,
      "endOffset": 23,
      "createdAt": "2025-09-03T02:48:51.755Z",
      "updatedAt": "2025-09-03T02:48:51.755Z",
      "targetId": "2323e781-f16b-4297-b196-bfdd06c17970",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "5abfbd7f-af6a-4d13-8ca4-a39dd864734a",
      "content": "Xh 22,21",
      "kind": "MARK_KIND_REFERENCE",
      "label": "5@",
      "sortOrder": 4,
      "startOffset": 12,
      "endOffset": 12,
      "createdAt": "2025-09-03T02:48:51.196Z",
      "updatedAt": "2025-09-03T02:48:51.196Z",
      "targetId": "56b31e3c-ac73-4c2d-9bca-3e855508603d",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "0f3f6875-c535-4f50-93cc-7cefc4445556",
      "content": "Có thể ở đây tác giả muốn khơi lại lời kêu gọi chống lại việc chạy theo nếp sống Hy-lạp (x. 3,17-28) theo đó người Do-thái có thể bị cám dỗ che giấu đức tin và đời sống đạo của mình. Nếu vậy thì *sự thật* (c.25) chính là truyền thống tôn giáo của dân tộc (x. 1 Mcb 1,12-15 ; 2 Mcb 4,11-16).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "5",
      "sortOrder": 4,
      "startOffset": 13,
      "endOffset": 13,
      "createdAt": "2025-09-03T02:48:51.800Z",
      "updatedAt": "2025-09-03T02:48:51.800Z",
      "targetId": "3bdd5036-bb8f-4b32-b2e2-fa8840183f09",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "4a4a2ede-6136-4559-8a85-313df8e7ca1e",
      "content": "Tv 41,2-4",
      "kind": "MARK_KIND_REFERENCE",
      "label": "6@",
      "sortOrder": 5,
      "startOffset": 7,
      "endOffset": 7,
      "createdAt": "2025-09-03T02:48:51.238Z",
      "updatedAt": "2025-09-03T02:48:51.238Z",
      "targetId": "3b789d3e-e59a-4421-90cc-7505dcd0b526",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "a0baa99a-7bfb-4b2a-9566-b24f6e0112ef",
      "content": "*Khi cần thiết*, ds : *trong thời cứu độ*, nghĩa là khi lời nói *sự thật* quyết định ơn cứu độ con. Một số thủ bản thêm : “Đừng che giấu sự khôn ngoan của con.”",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "6",
      "sortOrder": 5,
      "startOffset": 33,
      "endOffset": 33,
      "createdAt": "2025-09-03T02:48:51.909Z",
      "updatedAt": "2025-09-03T02:48:51.909Z",
      "targetId": "e382bfd0-0e07-435a-8e51-ae12e35c92ed",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "685cb294-f2bf-4d22-92cd-6de695366a56",
      "content": "Lc 6,35",
      "kind": "MARK_KIND_REFERENCE",
      "label": "7@",
      "sortOrder": 6,
      "startOffset": 31,
      "endOffset": 31,
      "createdAt": "2025-09-03T02:48:51.282Z",
      "updatedAt": "2025-09-03T02:48:51.282Z",
      "targetId": "f1b82612-dbd7-49ac-a4c2-d207144cbeda",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "7d598e16-a02a-4d5b-bad0-79969ed31be5",
      "content": "Vế này đi với vế trên, ngụ ý rằng tội đã phạm nó rành rành ra đó ; che giấu đi chẳng khác nào muốn chặn dòng sông đang chảy. Việc xưng thú tội lỗi trước mặt Thiên Chúa là đề tài tương đối quen thuộc trong Cựu Ước : Lv 5,5 ; Ds 5,7 ; 2 Sm 12,13 ; 1 V 21,27 ; Tv 38,2.5-6 ; 51,6 ; v.v...).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "7",
      "sortOrder": 6,
      "startOffset": 34,
      "endOffset": 34,
      "createdAt": "2025-09-03T02:48:52.019Z",
      "updatedAt": "2025-09-03T02:48:52.019Z",
      "targetId": "cc843a50-beb6-4adc-bc12-530986876e02",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "832566d1-3434-4c66-aa63-41e69a495de6",
      "content": "Is 49,15; Ga 14,21.23",
      "kind": "MARK_KIND_REFERENCE",
      "label": "8@",
      "sortOrder": 7,
      "startOffset": 12,
      "endOffset": 12,
      "createdAt": "2025-09-03T02:48:51.313Z",
      "updatedAt": "2025-09-03T02:48:51.313Z",
      "targetId": "07db654e-7227-4217-8147-b65b0cb8f729",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
    {
      "id": "ad521e81-4d4b-4122-a071-620745b610ef",
      "content": "Nghĩa không rõ lắm. Thay vì *sư tử*, HR : *chó*. Hai vế của câu có thể song đối đồng nghĩa, thay vì tương phản nhau.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "8",
      "sortOrder": 7,
      "startOffset": 14,
      "endOffset": 14,
      "createdAt": "2025-09-03T02:48:52.149Z",
      "updatedAt": "2025-09-03T02:48:52.149Z",
      "targetId": "ebf5b8f1-5dfb-4e37-b2d6-dde5f83a65a2",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "11bf7758-a0d6-467c-bc7c-a98fd04c6934"
    },
