{
  "chapter": {
    "id": "cc15c952-183f-40dd-967e-e7b297769569",
    "number": 40,
    "createdAt": "2025-09-03T01:07:51.705Z",
    "updatedAt": "2025-09-03T01:07:51.705Z",
    "bookId": "5c66a463-0bfa-46b7-9af1-3766a8779b73"
  },
  "verses": [
    {
      "id": "0a90c381-2cb3-4d67-8cfd-603d697ca430",
      "text": "Kể từ khi từ lòng mẹ sinh ra",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:13.765Z",
      "updatedAt": "2025-09-03T02:53:13.765Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "e965d1a8-3569-4813-ba0b-da73de243d11",
      "text": "cho đến lúc trở về lòng đất mẹ,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:13.804Z",
      "updatedAt": "2025-09-03T02:53:13.804Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "b692ffff-0144-451b-a9b2-3a7f6f7922d2",
      "text": "mang thân phận con người,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:13.828Z",
      "updatedAt": "2025-09-03T02:53:13.828Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "63e53873-003c-49fa-8619-33ce8fcc2069",
      "text": "ai cũng canh cánh bên lòng một nỗi lo,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 3,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:13.857Z",
      "updatedAt": "2025-09-03T02:53:13.857Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "270b6ddf-a8b9-4692-b698-2d647f17b3ba",
      "text": "là con cháu A-đam, nợ phong trần đương nhiên phải trả.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 4,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:13.871Z",
      "updatedAt": "2025-09-03T02:53:13.871Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "3c918cc1-5967-41f7-8a9e-3a044ff872fc",
      "text": "Điều không ngừng ám ảnh khiến lòng người sợ hãi âu lo",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:13.900Z",
      "updatedAt": "2025-09-03T02:53:13.900Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "5d9eaba8-b3c5-4f26-bea9-7937ae3d83e8",
      "text": "là cứ phải nghĩ rằng mình đang chờ chết.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:13.915Z",
      "updatedAt": "2025-09-03T02:53:13.915Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "8188685f-1241-4cf2-89d1-e8365c0310ad",
      "text": "Từ bậc vua chúa trên ngai vinh hiển",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:13.929Z",
      "updatedAt": "2025-09-03T02:53:13.929Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "41aaf1cd-8431-4258-87f4-46edb2d80a6a",
      "text": "đến kẻ cùng đinh chân lấm tay bùn,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:13.942Z",
      "updatedAt": "2025-09-03T02:53:13.942Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "2e5749bf-30e1-4260-a33e-e9e3b6c21bb7",
      "text": "từ người cân đai áo mão đến kẻ khố rách áo ôm,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:13.957Z",
      "updatedAt": "2025-09-03T02:53:13.957Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "95728b85-518f-4de9-a105-9fb581e77416",
      "text": "ai cũng đều giận dữ, ghen tuông,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:13.987Z",
      "updatedAt": "2025-09-03T02:53:13.987Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "06844923-bb17-4855-a40d-2bbe95da0134",
      "text": "đều băn khoăn, lo lắng, rồi sự chết, rồi hận thù cãi cọ.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.001Z",
      "updatedAt": "2025-09-03T02:53:14.001Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "8489c11c-6017-4f1d-8c45-13b86f922abb",
      "text": "Lúc nghỉ ngơi trên giường,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.015Z",
      "updatedAt": "2025-09-03T02:53:14.015Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "48bdd595-d4f7-4a86-9842-b56a6f225693",
      "text": "giấc ngủ ban đêm lại khơi lên những ý nghĩ khác.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.029Z",
      "updatedAt": "2025-09-03T02:53:14.029Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "c57cbaba-d621-410e-a840-adf335d97a83",
      "text": "Vừa mới nghỉ –có nghỉ cũng như không–,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.072Z",
      "updatedAt": "2025-09-03T02:53:14.072Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "55fa4a16-6cc9-4fc2-a8ab-eb93df5b318c",
      "text": "mà trong giấc mộng, y như giữa ban ngày,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.086Z",
      "updatedAt": "2025-09-03T02:53:14.086Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "26463ceb-3f95-4b16-bed1-df9e5f56c254",
      "text": "người ta hốt hoảng trước cảnh mình nhìn thấy,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.115Z",
      "updatedAt": "2025-09-03T02:53:14.115Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "dd1e4775-f435-4c25-935d-c94a763fa9b1",
      "text": "chẳng khác chi kẻ trốn khỏi chiến trường.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 3,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.128Z",
      "updatedAt": "2025-09-03T02:53:14.128Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "2ed376b9-6bf0-4914-a73c-155bdc418859",
      "text": "Đến lúc thoát thân, người ta thức dậy,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.143Z",
      "updatedAt": "2025-09-03T02:53:14.143Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "e8cd3611-ae8c-496f-9012-028ea2cc687a",
      "text": "và ngạc nhiên vì đã sợ hãi không đâu.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.157Z",
      "updatedAt": "2025-09-03T02:53:14.157Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "69d55473-d309-4843-8804-88a66700a6f7",
      "text": "Mọi xác phàm, từ người đến vật,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.171Z",
      "updatedAt": "2025-09-03T02:53:14.171Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "6a7f3a83-b4c5-43d2-8ddb-ba15fb7f41fa",
      "text": "–nhưng quân tội lỗi thì gấp bảy lần–, không làm sao tránh khỏi :",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.185Z",
      "updatedAt": "2025-09-03T02:53:14.185Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "d3f51751-30d6-41d3-b1a2-a47830f5e74c",
      "text": "chết chóc và đổ máu, cãi cọ và đâm chém,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.198Z",
      "updatedAt": "2025-09-03T02:53:14.198Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "d063e112-0bf2-487d-aab0-e50664433624",
      "text": "hoạn nạn, đói kém, đổ nát, tai ương.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.214Z",
      "updatedAt": "2025-09-03T02:53:14.214Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "c6c49ee3-75d1-41ec-9744-5f8c33ac6233",
      "text": "Tất cả những thứ đó đã được tạo nên cho quân vô đạo,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.227Z",
      "updatedAt": "2025-09-03T02:53:14.227Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "98e29be8-040a-4f9c-8195-4df9856e842c",
      "text": "chỉ vì tội chúng mà nạn hồng thuỷ đã xảy ra.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.255Z",
      "updatedAt": "2025-09-03T02:53:14.255Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "8ef2a008-247b-4804-9e4e-1b0245c1f1b9",
      "text": "Tất cả những gì từ đất mà ra sẽ trở về đất,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.270Z",
      "updatedAt": "2025-09-03T02:53:14.270Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "1a8e9a8a-a036-4a7e-bf54-1022fb7e0c36",
      "text": "còn những gì từ nước mà có lại quay về biển.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.297Z",
      "updatedAt": "2025-09-03T02:53:14.297Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "e721d978-9c33-4a29-99b4-af6e66ee5e47",
      "text": "Hối lộ và bất công rồi ra sẽ biến mất,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.325Z",
      "updatedAt": "2025-09-03T02:53:14.325Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "5e42aca8-fe53-4b16-803c-4a2decf24141",
      "text": "nhưng lòng trung tín sẽ tồn tại muôn đời.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.354Z",
      "updatedAt": "2025-09-03T02:53:14.354Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "c88f4eef-4c7a-4845-a326-6dbde413e84d",
      "text": "Tài sản quân bất chính sẽ như dòng suối cạn,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.368Z",
      "updatedAt": "2025-09-03T02:53:14.368Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "f684cc5d-95ab-480d-a50e-0e37fa7b1475",
      "text": "sẽ như sấm nổ giữa cơn mưa.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.382Z",
      "updatedAt": "2025-09-03T02:53:14.382Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "5dfdf756-7286-4884-a1d5-45b9cf204b0f",
      "text": "Người rộng tay làm phúc ắt sẽ được vui mừng ;",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.396Z",
      "updatedAt": "2025-09-03T02:53:14.396Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "4519c22e-015e-4fa2-bdfa-69bb71dee633",
      "text": "kẻ ngoảnh mặt làm ngơ sẽ tiêu vong vì bị người bỏ mặc.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.410Z",
      "updatedAt": "2025-09-03T02:53:14.410Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "6100ee31-532e-41b1-b13d-6f29633c0312",
      "text": "Con cháu bọn bất lương sẽ như cây không chồi,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.439Z",
      "updatedAt": "2025-09-03T02:53:14.439Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "8bde180a-edbd-4a6e-8e04-60d8b6d94381",
      "text": "như rễ không sạch bám trên đá cứng.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.467Z",
      "updatedAt": "2025-09-03T02:53:14.467Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "273657f8-3910-47ef-89c6-b1b3327c903e",
      "text": "Cây lau mọc nhan nhản bên mọi dòng nước và bờ sông",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.478Z",
      "updatedAt": "2025-09-03T02:53:14.478Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "d5b27e2c-a5f7-4f4a-9459-19df1ce2d701",
      "text": "sẽ bị bứng đầu tiên trước mọi cây cỏ khác.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.502Z",
      "updatedAt": "2025-09-03T02:53:14.502Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "efce4902-f479-45b9-a0b4-e73243ad6818",
      "text": "Lòng nhân nghĩa như địa đàng đầy dư phúc lộc,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.526Z",
      "updatedAt": "2025-09-03T02:53:14.526Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "15d84f4c-618b-4372-a06a-6cb13247d3cf",
      "text": "việc bố thí sẽ tồn tại muôn đời.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.554Z",
      "updatedAt": "2025-09-03T02:53:14.554Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "ad1b18ce-87db-487c-b8d8-3227e8401925",
      "text": "Sống không lệ thuộc và có được việc làm thì quả là dễ chịu,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.568Z",
      "updatedAt": "2025-09-03T02:53:14.568Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "02d75ffd-eac4-4274-adc0-1958061a9e1b",
      "text": "nhưng tìm được kho tàng còn may mắn hơn nữa.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.583Z",
      "updatedAt": "2025-09-03T02:53:14.583Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "3ed44981-28d3-4480-b774-318daa8a9b9a",
      "text": "Người sinh con cũng như kẻ xây thành",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.597Z",
      "updatedAt": "2025-09-03T02:53:14.597Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "494f7ff7-d4f9-4cfe-bcc5-035e6bf469c8",
      "text": "đều để lại danh thơm cho hậu thế,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.611Z",
      "updatedAt": "2025-09-03T02:53:14.611Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "9dcb6970-33a7-40a7-97af-7cd30a2b4cf5",
      "text": "nhưng người vợ hiền còn đáng quý hơn.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 2,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.639Z",
      "updatedAt": "2025-09-03T02:53:14.639Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "f50f47be-0b51-4b3d-bd2c-a815a5fd9e1d",
      "text": "Rượu và nhạc khiến lòng người phấn khởi,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.660Z",
      "updatedAt": "2025-09-03T02:53:14.660Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "d5976868-b6e0-46a4-b981-1a64d4de6822",
      "text": "nhưng lòng mến đức khôn ngoan vẫn đáng quý hơn.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.673Z",
      "updatedAt": "2025-09-03T02:53:14.673Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "acc3c49d-80cd-488c-a2f4-77e0aec558d2",
      "text": "Tiếng sáo, tiếng đàn khiến giọng hát du dương,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.701Z",
      "updatedAt": "2025-09-03T02:53:14.701Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "032c8559-d00e-44d4-b8e4-558c085e2d4a",
      "text": "nhưng lời nói dịu dàng còn êm tai hơn nữa.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.715Z",
      "updatedAt": "2025-09-03T02:53:14.715Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "65d2c64a-ccce-4df0-ade7-98f717638780",
      "text": "Vẻ đẹp và duyên dáng làm người ta thích nhìn,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.730Z",
      "updatedAt": "2025-09-03T02:53:14.730Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "fec0a9dd-a37b-411d-bd47-a8265992f083",
      "text": "nhưng cánh đồng xanh mướt còn đáng nhìn hơn.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.744Z",
      "updatedAt": "2025-09-03T02:53:14.744Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "43ec72cd-b1f7-4b98-9c58-d3b5e67ee8a5",
      "text": "Bạn bè thân hữu gặp nhau có lúc,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.758Z",
      "updatedAt": "2025-09-03T02:53:14.758Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "1f6973e1-71e6-45f5-a33c-c1c43ea5567b",
      "text": "sao như vợ chồng chung sống bên nhau.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.772Z",
      "updatedAt": "2025-09-03T02:53:14.772Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "0eefb982-ec27-4a56-976e-de56661d6444",
      "text": "Có anh có em là để giúp nhau khi hoạn nạn,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.787Z",
      "updatedAt": "2025-09-03T02:53:14.787Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "a76498b6-1020-4c03-9d9e-f6800dfc6153",
      "text": "nhưng của bố thí còn trợ giúp đắc lực hơn.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.816Z",
      "updatedAt": "2025-09-03T02:53:14.816Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "c6e434a0-db1c-4971-82b1-a7af113467be",
      "text": "Có bạc, có vàng là an tâm vững chí,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.829Z",
      "updatedAt": "2025-09-03T02:53:14.829Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "c8eecf0e-7f91-43fd-9c06-03d604706fed",
      "text": "nhưng được người góp ý còn quý giá hơn.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.843Z",
      "updatedAt": "2025-09-03T02:53:14.843Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "105c0f87-140d-47ac-9630-982744d96c1e",
      "text": "Giàu sang và sức mạnh khiến người ta tin tưởng,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.858Z",
      "updatedAt": "2025-09-03T02:53:14.858Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "c11e47b3-59e9-4e25-ad52-b8114a291b97",
      "text": "nhưng lòng kính sợ Đức Chúa còn trổi vượt hơn.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.872Z",
      "updatedAt": "2025-09-03T02:53:14.872Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "3afdfd5e-2e55-4767-b1a1-1b4a95dd53ff",
      "text": "Có lòng kính sợ Đức Chúa thì chẳng thiếu gì.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 2,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.885Z",
      "updatedAt": "2025-09-03T02:53:14.885Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "b4c9c317-b169-4ef7-8687-b7ceda7bd6c6",
      "text": "Kính sợ Chúa rồi, không cần phải cầu cứu ai nữa.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 3,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.905Z",
      "updatedAt": "2025-09-03T02:53:14.905Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "80e2ff4c-055f-43d6-96a9-5cd944181112",
      "text": "Lòng kính sợ Đức Chúa như địa đàng đầy dư phúc lộc,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 61,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.921Z",
      "updatedAt": "2025-09-03T02:53:14.921Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "be0c1e0d-5df4-4b7a-b31f-68560a27a876",
      "text": "che chở phù trì hơn mọi thứ vinh quang.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 62,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.949Z",
      "updatedAt": "2025-09-03T02:53:14.949Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "497e9aa7-8c9c-4420-be30-2c8376caec97",
      "text": "Con ơi, đừng đi ăn xin để sống :",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 63,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.963Z",
      "updatedAt": "2025-09-03T02:53:14.963Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "bd5d6e3c-8d70-4ad4-a874-bb1451d12f63",
      "text": "thà chết còn hơn !",
      "label": "28",
      "number": 28,
      "subVerseIndex": 1,
      "paragraphNumber": 64,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:14.992Z",
      "updatedAt": "2025-09-03T02:53:14.992Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "cd78f303-f61f-44e2-b66c-a585f6a6cab1",
      "text": "Kẻ nhìn trộm mâm người khác,",
      "label": "29",
      "number": 29,
      "subVerseIndex": 0,
      "paragraphNumber": 65,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:15.006Z",
      "updatedAt": "2025-09-03T02:53:15.006Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "57e990e2-f374-48e3-af4a-fd5a4bb88217",
      "text": "có sống cũng kể như chẳng sống ra người.",
      "label": "29",
      "number": 29,
      "subVerseIndex": 1,
      "paragraphNumber": 66,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:15.023Z",
      "updatedAt": "2025-09-03T02:53:15.023Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "d5cdd273-37ff-4dc8-b80b-aa6031d52e36",
      "text": "Vì đứa ăn bám làm mình ra nhơ nhớp ;",
      "label": "29",
      "number": 29,
      "subVerseIndex": 2,
      "paragraphNumber": 67,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:15.036Z",
      "updatedAt": "2025-09-03T02:53:15.036Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "40d03f3c-da26-4727-8268-2e342e4231d3",
      "text": "còn người hiểu biết và có giáo dục",
      "label": "29",
      "number": 29,
      "subVerseIndex": 3,
      "paragraphNumber": 68,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:15.050Z",
      "updatedAt": "2025-09-03T02:53:15.050Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "98e1f770-7c40-4286-8c18-5083ade4b82a",
      "text": "thì sẽ không xử sự như thế.",
      "label": "29",
      "number": 29,
      "subVerseIndex": 4,
      "paragraphNumber": 69,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:15.065Z",
      "updatedAt": "2025-09-03T02:53:15.065Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "b270b7c1-8799-45a3-8f0f-d89a56969518",
      "text": "Miệng đứa ăn xin ngọt như mía lùi,",
      "label": "30",
      "number": 30,
      "subVerseIndex": 0,
      "paragraphNumber": 70,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:15.079Z",
      "updatedAt": "2025-09-03T02:53:15.079Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    },
    {
      "id": "63a7bc6e-de1d-4a3e-a34d-e0b8bcf9b776",
      "text": "nhưng tâm địa hắn thì như lò lửa.",
      "label": "30",
      "number": 30,
      "subVerseIndex": 1,
      "paragraphNumber": 71,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:15.107Z",
      "updatedAt": "2025-09-03T02:53:15.107Z",
      "chapterId": "cc15c952-183f-40dd-967e-e7b297769569"
    }
  ],
  "marks": [
    {
      "id": "bef67875-5014-40ed-98ce-1a02d6c62e68",
      "content": "Mục này về kiếp khổ chung của nhân loại tương phản với chương trên. Không phải tư tưởng của tác giả Hc thiếu mạch lạc. Kiếp khổ này chẳng qua chỉ là hậu quả của tội lỗi con người đã phạm (c.10).",
      "kind": "MARK_KIND_FOOTNOTE",
