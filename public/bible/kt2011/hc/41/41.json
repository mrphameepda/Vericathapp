    },
    {
      "id": "0eee224b-1732-49c7-835d-78ec32a65bd2",
      "content": "ds : *không một lời trách móc về đời sống* (của con). Ý muốn nói : mọi người đều kết thúc nơi âm phủ, nên chẳng ai trách ai vì đã sống lâu trên trần gian.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 40,
      "endOffset": 40,
      "createdAt": "2025-09-03T02:53:20.983Z",
