      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "48cf6011-f18c-4918-94ad-2bff8f776c52",
      "content": "Cn 22,1; Gv 7,1",
      "kind": "MARK_KIND_REFERENCE",
