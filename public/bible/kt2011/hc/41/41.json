    },
    {
      "id": "24d2e85e-18c1-4175-87b0-b67ea74e0916",
      "content": "Gv 9,10",
      "kind": "MARK_KIND_REFERENCE",
      "label": "4@",
      "sortOrder": 3,
      "startOffset": 10,
      "endOffset": 10,
      "createdAt": "2025-09-03T02:53:20.997Z",
