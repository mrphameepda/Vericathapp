{
  "chapter": {
    "id": "885ce99e-c590-4855-ac36-6ee35cea0fbc",
    "number": 41,
    "createdAt": "2025-09-03T01:07:51.705Z",
    "updatedAt": "2025-09-03T01:07:51.705Z",
    "bookId": "5c66a463-0bfa-46b7-9af1-3766a8779b73"
  },
  "verses": [
    {
      "id": "bcb34706-06ba-45e0-b531-523860db94d5",
      "text": "Hỡi tử thần, nhớ đến ngươi thật là cay đắng",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:20.653Z",
      "updatedAt": "2025-09-03T02:53:20.653Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "4293fcad-a890-442c-af2c-5136f574140a",
      "text": "đối với ai đang an hưởng tài sản của mình,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:20.686Z",
      "updatedAt": "2025-09-03T02:53:20.686Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "fd8d8fc9-9263-40e2-ab9c-a7396f1f7bf8",
      "text": "đối với người không phải âu lo,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:20.700Z",
      "updatedAt": "2025-09-03T02:53:20.700Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "493c6b5c-851a-456d-9142-630a59460e49",
      "text": "người thành công trong hết mọi việc,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 3,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:20.714Z",
      "updatedAt": "2025-09-03T02:53:20.714Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "7ab7ad20-5401-4d8d-9fb3-eeefd8703393",
      "text": "người còn khoẻ mạnh để hưởng thú vui.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 4,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:20.728Z",
      "updatedAt": "2025-09-03T02:53:20.728Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "26395800-0354-480b-8fef-080924e7921d",
      "text": "Hỡi tử thần, phán quyết của ngươi hay thật",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:20.757Z",
      "updatedAt": "2025-09-03T02:53:20.757Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "e95f4ec8-b688-47d7-a892-3ed96fb8693f",
      "text": "đối với kẻ bần cùng, với người thiếu sức khoẻ,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:20.772Z",
      "updatedAt": "2025-09-03T02:53:20.772Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "4b167f6e-ebf5-46ae-a759-6c3598150676",
      "text": "với người già nua tuổi tác, lo lắng trăm chiều,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:20.799Z",
      "updatedAt": "2025-09-03T02:53:20.799Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "020c8e3a-e733-4e00-9d09-f4f39b41dd59",
      "text": "với người tuyệt vọng, không còn kiên nhẫn nữa.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 3,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:20.813Z",
      "updatedAt": "2025-09-03T02:53:20.813Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "4503ae9e-c2a5-4e05-a276-08232b6df5e4",
      "text": "Con đừng sợ án chết.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:20.827Z",
      "updatedAt": "2025-09-03T02:53:20.827Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "4b2ab1fc-2253-43a0-8c42-65e0b92a7cb7",
      "text": "Hãy nhớ rằng : có những kẻ đã đi trước con,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:20.841Z",
      "updatedAt": "2025-09-03T02:53:20.841Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "58aa12aa-391b-41b4-bea2-407b59da0821",
      "text": "và sẽ có những người theo sau.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:20.854Z",
      "updatedAt": "2025-09-03T02:53:20.854Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "86ba75f3-25d7-4684-9785-5394c3201d54",
      "text": "Đó là điều Đức Chúa quyết định cho hết mọi người phàm.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:20.869Z",
      "updatedAt": "2025-09-03T02:53:20.869Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "838784c7-044e-4424-82b6-2638d77341b1",
      "text": "Tại sao cưỡng lại điều Đấng Tối Cao đã muốn ?",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:20.897Z",
      "updatedAt": "2025-09-03T02:53:20.897Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "05025a45-4e8c-4a23-9f60-a4740ec865a7",
      "text": "Dù người ta sống được mười năm, trăm năm,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:20.926Z",
      "updatedAt": "2025-09-03T02:53:20.926Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "975ac0e5-a1dc-4afc-bc2d-b38a9f0ea3c3",
      "text": "hay cả ngàn đi nữa,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 3,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:20.955Z",
      "updatedAt": "2025-09-03T02:53:20.955Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "6569723e-2902-42f5-a272-761958a40bb0",
      "text": "thì trong âm phủ, chẳng ai trách móc đâu.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 4,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:20.969Z",
      "updatedAt": "2025-09-03T02:53:20.969Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "1ae57d42-004e-4955-9ee8-f6526872b909",
      "text": "Con cái phường tội lỗi thành đám con ghê tởm,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.011Z",
      "updatedAt": "2025-09-03T02:53:21.011Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "f2fcf385-2803-4214-b752-b8108a868587",
      "text": "thường đi lại với lũ ác nhân.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.038Z",
      "updatedAt": "2025-09-03T02:53:21.038Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "403918ac-e484-40a8-8f9f-bef2fcbc9c0f",
      "text": "Gia nghiệp con cái phường tội lỗi thế nào cũng tiêu tan.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.052Z",
      "updatedAt": "2025-09-03T02:53:21.052Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "d9f5ccaa-06c7-45c0-b7c3-2984454ceb1a",
      "text": "Nỗi ô nhục của chúng sẽ kéo dài qua đời con đời cháu.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.066Z",
      "updatedAt": "2025-09-03T02:53:21.066Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "127f4f48-0ad3-468a-89e4-b70d2348a2ba",
      "text": "Cha bất nhân bị con trách móc,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.080Z",
      "updatedAt": "2025-09-03T02:53:21.080Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "8adc2484-247b-40d7-9b01-a956c691cb7e",
      "text": "vì con chịu nhục là lỗi tại cha.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.094Z",
      "updatedAt": "2025-09-03T02:53:21.094Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "dec5d353-b35d-4645-af4d-c9dec8345154",
      "text": "Khốn cho các ngươi, hỡi phường gian ác,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.107Z",
      "updatedAt": "2025-09-03T02:53:21.107Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "fffe48eb-f96b-43f9-90f1-5303f09b8a68",
      "text": "vì đã bỏ luật Thiên Chúa Tối Cao.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.123Z",
      "updatedAt": "2025-09-03T02:53:21.123Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "24455def-975d-4d6a-aa8c-d30c72aef4ae",
      "text": "Các ngươi có sinh ra, thì chỉ sinh ra để bị nguyền rủa ;",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.137Z",
      "updatedAt": "2025-09-03T02:53:21.137Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "5827d788-2d89-4f39-b4ac-c38467d67bf9",
      "text": "đến khi các ngươi chết, thì phần của các ngươi",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.151Z",
      "updatedAt": "2025-09-03T02:53:21.151Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "683a951a-dde3-4f9a-a4be-72a9ddd1565e",
      "text": "chỉ là lời nguyền rủa.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.165Z",
      "updatedAt": "2025-09-03T02:53:21.165Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "a75da054-e0b4-4a54-bb17-30ef89b447d8",
      "text": "Tất cả những gì từ đất mà ra sẽ lại về với đất.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.193Z",
      "updatedAt": "2025-09-03T02:53:21.193Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "89ade6a0-b62f-45e1-80df-9cc3fb1a0416",
      "text": "Số phận bọn ác nhân cũng vậy :",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.221Z",
      "updatedAt": "2025-09-03T02:53:21.221Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "49692073-2493-49f5-8fed-284dd539e8fa",
      "text": "hết bị nguyền rủa sẽ bị diệt vong.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.235Z",
      "updatedAt": "2025-09-03T02:53:21.235Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "44bb4eca-5ae9-4c30-9884-274697750f96",
      "text": "Thân xác con người chỉ là phù vân,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.249Z",
      "updatedAt": "2025-09-03T02:53:21.249Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "df6680d9-0ae7-4f56-aa0f-03fec50ddaa0",
      "text": "nhưng danh thơm tiếng tốt chẳng bao giờ mai một.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.263Z",
      "updatedAt": "2025-09-03T02:53:21.263Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "fb847cbf-1f3c-4bc1-bed6-d4e5f7b8d2cd",
      "text": "Hãy lo sao cho con được danh thơm tiếng tốt,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.291Z",
      "updatedAt": "2025-09-03T02:53:21.291Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "b8c78e9d-b791-4aec-9b92-a6e1fd70d65e",
      "text": "vì hơn cả ngàn vạn kho vàng, tiếng tăm sẽ còn mãi.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.320Z",
      "updatedAt": "2025-09-03T02:53:21.320Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "ede3f858-29e0-4278-89fa-100d23fb2961",
      "text": "Hạnh phúc đến đâu, đời người cũng có hạn,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.348Z",
      "updatedAt": "2025-09-03T02:53:21.348Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "fb012d62-364e-45e7-8693-bed1feb9697d",
      "text": "nhưng danh thơm tiếng tốt sẽ tồn tại muôn đời.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.365Z",
      "updatedAt": "2025-09-03T02:53:21.365Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "83fae350-8a86-4cb3-8ef9-4ce694df242f",
      "text": "Các con ơi, cứ an tâm mà giữ lời giáo huấn.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.378Z",
      "updatedAt": "2025-09-03T02:53:21.378Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "35a96f7f-f92b-4170-9a3f-b7f84d1c2aa8",
      "text": "Khôn ngoan bị che giấu, kho tàng bị chôn vùi,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.407Z",
      "updatedAt": "2025-09-03T02:53:21.407Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "e76576f9-ca28-4eb4-a1cd-8c7ed567919f",
      "text": "cả hai nào có ích chi ?",
      "label": "14",
      "number": 14,
      "subVerseIndex": 2,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.435Z",
      "updatedAt": "2025-09-03T02:53:21.435Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "93fdb2b6-057d-4775-92db-ddd4eed374d2",
      "text": "Người che giấu sự đần độn",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.450Z",
      "updatedAt": "2025-09-03T02:53:21.450Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "78453149-f92e-459c-9a7c-8e2ea213843a",
      "text": "vẫn hơn kẻ che giấu sự khôn ngoan.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.464Z",
      "updatedAt": "2025-09-03T02:53:21.464Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "346a6c7b-4290-4cc9-ae5e-29264507d96f",
      "text": "Vậy ta nói con nghe điều gì đáng xấu hổ :",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.478Z",
      "updatedAt": "2025-09-03T02:53:21.478Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "9f406df6-dee6-43a8-94da-d23599c6efe7",
      "text": "e thẹn vì bất cứ chuyện chi, quả là điều không tốt.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.491Z",
      "updatedAt": "2025-09-03T02:53:21.491Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "046b86d1-ba31-4149-bba4-7cf5a4dfd41e",
      "text": "Có phải hết mọi người đánh giá đúng hết mọi chuyện đâu !",
      "label": "16",
      "number": 16,
      "subVerseIndex": 2,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.503Z",
      "updatedAt": "2025-09-03T02:53:21.503Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "ae51bcda-56dd-4ff4-a66c-4606c5278a09",
      "text": "Con phải biết thẹn thùng xấu hổ",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.519Z",
      "updatedAt": "2025-09-03T02:53:21.519Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "6acaf895-20ec-4fc0-8a7c-2779f0938362",
      "text": "trước mặt cha mẹ, vì chuyện dâm ô,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.536Z",
      "updatedAt": "2025-09-03T02:53:21.536Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "96056637-9a7c-44d6-a073-bb57583d94ce",
      "text": "trước mặt người quyền cao chức trọng vì những lời dối trá,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 2,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.550Z",
      "updatedAt": "2025-09-03T02:53:21.550Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "fc38f161-7355-4a7d-bc21-0667f09fb181",
      "text": "trước mặt những ai cầm quyền xét xử vì hành vi phạm pháp,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.564Z",
      "updatedAt": "2025-09-03T02:53:21.564Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "3fc14e4a-6c81-4a7d-9cd4-ed130c2e6384",
      "text": "trước mặt cộng đồng, trước mặt toàn dân vì lối sống vô đạo,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.578Z",
      "updatedAt": "2025-09-03T02:53:21.578Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "cac19f8e-1372-40fe-a124-a95271cfdfcf",
      "text": "trước mặt các bạn bè thân hữu",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.593Z",
      "updatedAt": "2025-09-03T02:53:21.593Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "577296ce-523f-4138-a94e-ca4311243c07",
      "text": "vì những chuyện bất nghĩa, bất nhân,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.607Z",
      "updatedAt": "2025-09-03T02:53:21.607Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "a6c39e02-7fd7-477a-9684-187a69a29163",
      "text": "trước những người cùng xóm cùng làng",
      "label": "19",
      "number": 19,
      "subVerseIndex": 2,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.622Z",
      "updatedAt": "2025-09-03T02:53:21.622Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "c3ae9cff-a2ec-4340-a7d5-7ac3b0e36116",
      "text": "vì những chuyện trộm cắp.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 3,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.636Z",
      "updatedAt": "2025-09-03T02:53:21.636Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "af114a3d-22b4-4ab6-b79e-5d7387329fe2",
      "text": "Con phải biết thẹn thùng xấu hổ",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.650Z",
      "updatedAt": "2025-09-03T02:53:21.650Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "c4e109f1-8a1c-4a09-9aa4-cb0bf2583cc9",
      "text": "vì không giữ lời thề nguyền cam kết,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.664Z",
      "updatedAt": "2025-09-03T02:53:21.664Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "1621feba-855e-45df-9f8c-8e0a05277aa3",
      "text": "hay đã giơ tay xin bánh mà ăn,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 2,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.678Z",
      "updatedAt": "2025-09-03T02:53:21.678Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "751b575f-1f8d-4231-84f7-6ec90077b2dc",
      "text": "vì lăng nhục khi nhận hoặc cho,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.705Z",
      "updatedAt": "2025-09-03T02:53:21.705Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "3eaedc61-ec3f-4fe4-8b38-d8520e4eb2d2",
      "text": "hay làm thinh trước những ai chào hỏi,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.719Z",
      "updatedAt": "2025-09-03T02:53:21.719Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "15475840-1294-4211-ac79-6286e0c54baf",
      "text": "vì gặp gái bán dâm mà nhìn chòng chọc,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.735Z",
      "updatedAt": "2025-09-03T02:53:21.735Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "bcb48396-7869-4147-b6c2-4e476c9e99b9",
      "text": "hay gặp họ hàng thân thích mà ngoảnh mặt đi,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.749Z",
      "updatedAt": "2025-09-03T02:53:21.749Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "31f97531-1529-45dd-b8f4-868131a00d57",
      "text": "vì chiếm của, chiếm quà người ta,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 61,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.762Z",
      "updatedAt": "2025-09-03T02:53:21.762Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "3a9ec47a-e7bb-4492-8b7c-b053532f7587",
      "text": "hay mải mê nhìn phụ nữ có chồng,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 62,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.776Z",
      "updatedAt": "2025-09-03T02:53:21.776Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "fddecb2b-8a57-4974-97d2-c432d5e1b249",
      "text": "vì săn đón đầy tớ gái người ta",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 63,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.805Z",
      "updatedAt": "2025-09-03T02:53:21.805Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "7e15f006-6efd-46b2-91b7-77dafd5f5987",
      "text": "– tới gần giường cô ấy làm gì ! –",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 64,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.820Z",
      "updatedAt": "2025-09-03T02:53:21.820Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "85610e65-fd76-4495-84aa-6c375944c830",
      "text": "Con phải biết thẹn thùng xấu hổ",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 65,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.833Z",
      "updatedAt": "2025-09-03T02:53:21.833Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "8dba88f1-0ff1-44fc-b562-3c642c14ed92",
      "text": "vì làm nhục bạn bè",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 66,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.847Z",
      "updatedAt": "2025-09-03T02:53:21.847Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "7c45189e-dca0-4d25-b4e5-c312f9a37381",
      "text": "– đã cho người ta thì đừng làm nhục ! –",
      "label": "25",
      "number": 25,
      "subVerseIndex": 2,
      "paragraphNumber": 67,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.861Z",
      "updatedAt": "2025-09-03T02:53:21.861Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "e3fb64bd-2970-423a-bbd7-0312fe302107",
      "text": "vì học lại cho người khác điều đã nghe,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 68,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.876Z",
      "updatedAt": "2025-09-03T02:53:21.876Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "e8131a68-3a73-48e1-b4c3-3c6cf110c651",
      "text": "hay tiết lộ những điều bí mật.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 69,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.890Z",
      "updatedAt": "2025-09-03T02:53:21.890Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "666044ae-d578-4921-93ff-d6d737e387ce",
      "text": "Có vậy con mới biết",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 70,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.904Z",
      "updatedAt": "2025-09-03T02:53:21.904Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "b711f5db-70cb-449f-99c9-502545e5a2d8",
      "text": "thế nào là xấu hổ thật",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 71,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.918Z",
      "updatedAt": "2025-09-03T02:53:21.918Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    },
    {
      "id": "86c58e70-3705-4072-ab0e-299454dfe9de",
      "text": "và sẽ gây được thiện cảm với mọi người.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 2,
      "paragraphNumber": 72,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:21.932Z",
      "updatedAt": "2025-09-03T02:53:21.932Z",
      "chapterId": "885ce99e-c590-4855-ac36-6ee35cea0fbc"
    }
  ],
