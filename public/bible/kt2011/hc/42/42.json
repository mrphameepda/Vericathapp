{
  "chapter": {
    "id": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c",
    "number": 42,
    "createdAt": "2025-09-03T01:07:51.705Z",
    "updatedAt": "2025-09-03T01:07:51.705Z",
    "bookId": "5c66a463-0bfa-46b7-9af1-3766a8779b73"
  },
  "verses": [
    {
      "id": "a5181789-d9eb-4562-9203-4126875aa01a",
      "text": "Còn về những chuyện sau đây, con đừng xấu hổ,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:27.235Z",
      "updatedAt": "2025-09-03T02:53:27.235Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "b413bbfe-bf7b-4c87-b061-1b00c416fe6a",
      "text": "cũng đừng vì nể ai mà phạm tội :",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:27.255Z",
      "updatedAt": "2025-09-03T02:53:27.255Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "7dd77859-71c1-45ca-b9fa-eb5795d06e2f",
      "text": "Con đừng xấu hổ vì lề luật của Đấng Tối Cao",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:27.277Z",
      "updatedAt": "2025-09-03T02:53:27.277Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "ef3a4928-1cbe-4fe1-bfd8-06789c824175",
      "text": "và giao ước của Người,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:27.305Z",
      "updatedAt": "2025-09-03T02:53:27.305Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "8a4290fb-be0d-4b32-810a-64162a56a073",
      "text": "hay vì phán quyết công minh dành cho người ngoại giáo,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:27.325Z",
      "updatedAt": "2025-09-03T02:53:27.325Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "313cf7f9-1c3e-4e05-a62a-d73a07578285",
      "text": "vì sòng phẳng với bè bạn và kẻ đồng hành,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:27.353Z",
      "updatedAt": "2025-09-03T02:53:27.353Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "3d4098fc-0165-49dc-9ac6-a04e722288bf",
      "text": "hay phân chia gia tài cho bè bạn,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:27.371Z",
      "updatedAt": "2025-09-03T02:53:27.371Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "4ee24fd0-e421-401d-b1d0-c83f108e543c",
      "text": "vì cân đong sao cho chính xác",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:27.385Z",
      "updatedAt": "2025-09-03T02:53:27.385Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "7e91f362-8288-406f-b684-3c0adbf4c121",
      "text": "hay vì thu lợi ít hay nhiều,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:27.398Z",
      "updatedAt": "2025-09-03T02:53:27.398Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "197afa1a-3850-4ce1-9a2a-0b764f2e973b",
      "text": "vì lợi lộc do nghề buôn bán,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:27.412Z",
      "updatedAt": "2025-09-03T02:53:27.412Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "0d5a5bc3-66dc-4936-af85-4704c5c46b47",
      "text": "vì phải nghiêm khắc khi giáo dục con",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:27.440Z",
      "updatedAt": "2025-09-03T02:53:27.440Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "6eb12703-2dba-4392-a0d0-aa9ca65a24f4",
      "text": "hay trừng phạt nặng nề tên đầy tớ hư hỏng.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:27.468Z",
      "updatedAt": "2025-09-03T02:53:27.468Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "a000f307-aa15-4eba-a61b-d8dc37b06103",
      "text": "Gặp đàn bà tọc mạch, cần đóng ấn niêm phong,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:27.495Z",
      "updatedAt": "2025-09-03T02:53:27.495Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "3c8d34fa-cc6e-4af9-be2a-3a6c861c034e",
      "text": "ở đâu có lắm người tắt mắt, phải khoá sao cho chặt.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:27.509Z",
      "updatedAt": "2025-09-03T02:53:27.509Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "7b01d95b-761d-48b3-8ef9-372fefb45085",
      "text": "Trao cái gì, phải cân phải đếm,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:27.523Z",
      "updatedAt": "2025-09-03T02:53:27.523Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "8344e689-cb2a-42ae-92a7-470e72ce9e47",
      "text": "xuất hay nhập, đều phải có giấy tờ.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:27.537Z",
      "updatedAt": "2025-09-03T02:53:27.537Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "93554ed5-2aa2-41e4-bd41-08384dc97a05",
      "text": "Con đừng xấu hổ khi phải dạy dỗ đứa ngu, đứa ngốc,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:27.551Z",
      "updatedAt": "2025-09-03T02:53:27.551Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "c90dfadd-1bff-425d-bd1d-b5218d0efc8c",
      "text": "và ông già mà còn cãi lộn với thanh niên.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:27.579Z",
      "updatedAt": "2025-09-03T02:53:27.579Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "b7dfab57-2237-4151-9c66-46c207796310",
      "text": "Được vậy con mới là người có giáo dục tử tế,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:27.607Z",
      "updatedAt": "2025-09-03T02:53:27.607Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "ee3028c2-19a6-4ec8-b97d-f457b0054672",
      "text": "và sẽ tỏ ra từng trải trước mặt mọi người.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 3,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:27.620Z",
      "updatedAt": "2025-09-03T02:53:27.620Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "4ab9f981-4221-49d0-8dec-495279fd6f6d",
      "text": "Đối với một người cha,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:27.634Z",
      "updatedAt": "2025-09-03T02:53:27.634Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "0f1534d7-e6a4-4821-9cff-ddce9ca4dfea",
      "text": "con gái là kho tàng không bảo đảm,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:27.661Z",
      "updatedAt": "2025-09-03T02:53:27.661Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "d40949ac-39a6-4e73-ab24-09342fadd00a",
      "text": "ông mất ăn mất ngủ vì lo lắng :",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:27.689Z",
      "updatedAt": "2025-09-03T02:53:27.689Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "4d94c80a-33ae-43eb-b29a-8427c48ead87",
      "text": "con còn thiếu nữ thì lo con lỡ thì,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 3,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:27.703Z",
      "updatedAt": "2025-09-03T02:53:27.703Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "ebf043ba-895a-475a-b84b-f958b02821a9",
      "text": "con lấy chồng rồi thì lo con bị ghét,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 4,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:27.717Z",
      "updatedAt": "2025-09-03T02:53:27.717Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "09449ace-4afc-4b65-9f6f-33ccf1fbcbfa",
      "text": "con còn con gái thì sợ người dụ dỗ,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:27.744Z",
      "updatedAt": "2025-09-03T02:53:27.744Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "f7d85105-8580-4936-8ecb-d488a9d2f4ce",
      "text": "phải mang bầu khi còn ở nhà cha,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:27.758Z",
      "updatedAt": "2025-09-03T02:53:27.758Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "dbabd026-b131-4b4b-a53b-229d6addba16",
      "text": "con về với chồng thì lo con lầm lỗi,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:27.772Z",
      "updatedAt": "2025-09-03T02:53:27.772Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "ff551af7-c053-4f9d-a3c7-e3ac6860d388",
      "text": "chung sống với chồng mà lại hiếm hoi.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 3,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:27.787Z",
      "updatedAt": "2025-09-03T02:53:27.787Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "4049ac04-6ef9-4b99-875f-a4dbff6cf163",
      "text": "Có con gái hư thân, phải canh chừng nghiêm khắc,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:27.800Z",
      "updatedAt": "2025-09-03T02:53:27.800Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "10ee5bc5-3752-4918-a181-f9dd8b572cd1",
      "text": "kẻo vì con mà cha nên trò cười cho thù địch,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:27.814Z",
      "updatedAt": "2025-09-03T02:53:27.814Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "9a0e8dba-928e-4a40-aa4e-e55a615e0ccf",
      "text": "nên câu chuyện cho dân thành đàm tiếu,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:27.828Z",
      "updatedAt": "2025-09-03T02:53:27.828Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "8db3419c-2fcf-42a4-bcc5-6f6f2d1ed16c",
      "text": "nên cớ tụ họp cho những người ngồi lê mách lẻo,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 3,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:27.842Z",
      "updatedAt": "2025-09-03T02:53:27.842Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "0d1849cb-7531-47ec-bfdc-0531facb9934",
      "text": "khiến vì con mà cha xấu hổ trước đám đông.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 4,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:27.856Z",
      "updatedAt": "2025-09-03T02:53:27.856Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "92e364d0-2bbd-48a0-a888-dc07456f8c80",
      "text": "Trước bất cứ ai, đừng chăm chú nhìn vào sắc đẹp,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:27.870Z",
      "updatedAt": "2025-09-03T02:53:27.870Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "0c8d538c-3e4d-4bd8-b9dd-e5844b09bae6",
      "text": "cũng đừng ngồi chung với bọn đàn bà.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:27.912Z",
      "updatedAt": "2025-09-03T02:53:27.912Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "eab4518a-1ad5-410b-9def-ffa75f78f2da",
      "text": "Vì cũng như áo quần có rận,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:27.940Z",
      "updatedAt": "2025-09-03T02:53:27.940Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "af8199a7-510b-482e-ae54-ca6875dfecf3",
      "text": "đàn bà có thứ gian ác của đàn bà.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:27.954Z",
      "updatedAt": "2025-09-03T02:53:27.954Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "89f9d9be-2799-4175-afdc-98edb501a9a7",
      "text": "Đàn ông gian ác hơn đàn bà tốt bụng,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:27.968Z",
      "updatedAt": "2025-09-03T02:53:27.968Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "e2169386-5514-4e83-88d5-85047240ab0d",
      "text": "vì đàn bà trơ trẽn đưa đến nhục nhằn.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:27.996Z",
      "updatedAt": "2025-09-03T02:53:27.996Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "f62e749a-8ff0-4f17-8ebc-5a2b2b25a8da",
      "text": "Tôi sẽ nhắc lại những công trình của Đức Chúa,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:28.024Z",
      "updatedAt": "2025-09-03T02:53:28.024Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "63631f08-17f8-44c8-ad91-4f37f5bc6b00",
      "text": "những điều mắt thấy, tôi sẽ kể lại.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:28.071Z",
      "updatedAt": "2025-09-03T02:53:28.071Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "96936b58-3f66-4ed6-8f72-1fe4c574bc98",
      "text": "Do lời Đức Chúa mà có những công trình của Người.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 2,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:28.083Z",
      "updatedAt": "2025-09-03T02:53:28.083Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "35f496ba-6a5f-4c67-9864-c82f06858310",
      "text": "Mặt trời toả sáng nhìn xuống muôn loài,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:28.123Z",
      "updatedAt": "2025-09-03T02:53:28.123Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "4475628e-bfe6-4b0b-98a9-4ce4fafa79fe",
      "text": "vinh quang Đức Chúa bao phủ công trình Người sáng tạo,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:28.137Z",
      "updatedAt": "2025-09-03T02:53:28.137Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "394c42a9-a2f7-4583-9f61-52e0307525d2",
      "text": "các thánh của Đức Chúa",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:28.151Z",
      "updatedAt": "2025-09-03T02:53:28.151Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "4ff34fe4-d9ff-4754-81ae-6b381e234857",
      "text": "không tài nào kể lại mọi kỳ công của Người.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:28.179Z",
      "updatedAt": "2025-09-03T02:53:28.179Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "1102f98e-f87c-43aa-b9b4-ed688f15cacb",
      "text": "Đó là những kỳ công Đức Chúa toàn năng đã thực hiện",
      "label": "17",
      "number": 17,
      "subVerseIndex": 2,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:28.193Z",
      "updatedAt": "2025-09-03T02:53:28.193Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "c42edf81-afad-4079-966f-33e8707d5b94",
      "text": "cho vũ trụ được bền vững",
      "label": "17",
      "number": 17,
      "subVerseIndex": 3,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:28.207Z",
      "updatedAt": "2025-09-03T02:53:28.207Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "eff53502-ee74-4a1a-9285-3dfa3478409a",
      "text": "(trước tôn nhan) vinh hiển của Người.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 4,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:28.221Z",
      "updatedAt": "2025-09-03T02:53:28.221Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "ad537ae5-4831-47b4-b3ae-93b5762688a4",
      "text": "Người dò thấu vực thẳm và cõi lòng nhân thế,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:28.249Z",
      "updatedAt": "2025-09-03T02:53:28.249Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "fadf2feb-cae8-4fdd-949b-8596a4a3b409",
      "text": "hiểu rõ toan tính của con người,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:28.277Z",
      "updatedAt": "2025-09-03T02:53:28.277Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "4e85a905-a808-451e-b4f0-022d1e5fced2",
      "text": "vì Đấng Tối Cao am tường tất cả",
      "label": "18",
      "number": 18,
      "subVerseIndex": 2,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:28.291Z",
      "updatedAt": "2025-09-03T02:53:28.291Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "68e8859b-beb8-44b5-bb0d-fe3242de33d7",
      "text": "và đưa mắt nhìn các dấu hiệu thời gian.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 3,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:28.318Z",
      "updatedAt": "2025-09-03T02:53:28.318Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "3939a389-4a63-4ef5-98a8-9856a638f22b",
      "text": "Người công bố dĩ vãng và tương lai",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:28.345Z",
      "updatedAt": "2025-09-03T02:53:28.345Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "e7e8b162-59e0-49ce-95d7-cf4df7423a22",
      "text": "và mặc khải dấu vết của những điều bí ẩn.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:28.356Z",
      "updatedAt": "2025-09-03T02:53:28.356Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "09d3bdf1-9c5c-4bcd-b91c-867d61ee3807",
      "text": "Không một ý nghĩ nào Người không thấu suốt,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:28.367Z",
      "updatedAt": "2025-09-03T02:53:28.367Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "6f6ff6ed-893a-4e00-a484-f6327105c7c8",
      "text": "chẳng một lời nào là bí ẩn đối với Người.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:28.387Z",
      "updatedAt": "2025-09-03T02:53:28.387Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "e48c994f-3e16-4a19-839d-67f08c50d6ac",
      "text": "Người khôn ngoan sắp xếp những công trình vĩ đại,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:28.398Z",
      "updatedAt": "2025-09-03T02:53:28.398Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "577fa56c-a152-45ca-9a26-fdd18d6d8ffd",
      "text": "vì Người hằng có từ đời đời đến muôn muôn thuở,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:28.409Z",
      "updatedAt": "2025-09-03T02:53:28.409Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "fb3962d8-3cb4-4f61-b8ef-667f2e4536c9",
      "text": "không cần thêm hay bớt điều gì",
      "label": "21",
      "number": 21,
      "subVerseIndex": 2,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:28.420Z",
      "updatedAt": "2025-09-03T02:53:28.420Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "353e4d27-bc53-42bc-bfc1-10c11b9bfb58",
      "text": "và cũng chẳng cần ai làm cố vấn.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 3,
      "paragraphNumber": 61,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:28.460Z",
      "updatedAt": "2025-09-03T02:53:28.460Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "fdbb9e7f-0a3a-4dce-b1c2-7affbfbbc8fa",
      "text": "Mọi công trình của Người kỳ diệu biết bao !",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 62,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:28.474Z",
      "updatedAt": "2025-09-03T02:53:28.474Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "59ffe17b-d00d-4b67-9e1c-8b76086ced54",
      "text": "Những gì thấy được chỉ như một ánh lửa.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 63,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:28.499Z",
      "updatedAt": "2025-09-03T02:53:28.499Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "69afbe10-668a-44aa-ac81-c9db98a2db18",
      "text": "Mọi vật ấy đều sống và tồn tại muôn đời",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 64,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:28.514Z",
      "updatedAt": "2025-09-03T02:53:28.514Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "245602d0-ec07-4aaf-be4c-cc769d2d2397",
      "text": "để đáp ứng mọi nhu cầu cần thiết và tất cả đều vâng phục Người.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 65,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:28.529Z",
      "updatedAt": "2025-09-03T02:53:28.529Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "709919ba-1f5a-4bfc-bc64-c935f9d6fce5",
      "text": "Tất cả đều có đôi, cái này đối cái kia ;",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 66,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:28.542Z",
      "updatedAt": "2025-09-03T02:53:28.542Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "bfeed2d5-bac7-4648-bb50-1b0f7112d42b",
      "text": "Người không làm gì dang dở.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 67,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:28.567Z",
      "updatedAt": "2025-09-03T02:53:28.567Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "caaf1b50-f217-46b5-8e25-1865af3bbae9",
      "text": "Vật này làm tôn vẻ đẹp của vật kia,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 68,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:28.594Z",
      "updatedAt": "2025-09-03T02:53:28.594Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    },
    {
      "id": "a9b03cd1-1386-4772-ad88-886643ac571a",
      "text": "nhìn ngắm vinh quang của Người, ai mà chán được ?",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 69,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:28.608Z",
      "updatedAt": "2025-09-03T02:53:28.608Z",
      "chapterId": "8dc785c4-fdb2-4b32-8861-f2dcba00e74c"
    }
  ],
  "marks": [
    {
      "id": "4f55bc9a-e63a-4b1e-b83e-742425a14009",
      "content": "Sau khi đã đề ra những gì làm cho người ta phải hổ thẹn, ông Ben Xi-ra nêu ra một số những việc khác, người ta không nên vì cả nể mà ngại thi hành.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 30,
      "endOffset": 30,
      "createdAt": "2025-09-03T02:53:27.265Z",
      "updatedAt": "2025-09-03T02:53:27.265Z",
      "targetId": "b413bbfe-bf7b-4c87-b061-1b00c416fe6a",
      "targetType": "MARK_TARGET_TYPE_VERSE",
