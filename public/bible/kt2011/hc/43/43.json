{
  "chapter": {
    "id": "cbcbdb0e-4efb-461c-8e5b-069a63d59557",
    "number": 43,
    "createdAt": "2025-09-03T01:07:51.705Z",
    "updatedAt": "2025-09-03T01:07:51.705Z",
    "bookId": "5c66a463-0bfa-46b7-9af1-3766a8779b73"
  },
  "verses": [
    {
      "id": "54270aa0-6846-45e8-b25b-5baafa6280e1",
      "text": "Lộng lẫy chốn cao vời, một khung trời trong vắt.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:34.316Z",
      "updatedAt": "2025-09-03T02:53:34.316Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "206443b4-d309-419e-b75c-5c3c9d703e26",
      "text": "Nhìn ngắm cả bầu trời : cảnh tượng xán lạn thay !",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:34.379Z",
      "updatedAt": "2025-09-03T02:53:34.379Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "2c34db31-cd2c-4286-9922-dc3f77a9dad8",
      "text": "Vừa ló dạng lúc hừng đông, mặt trời liền công bố :",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:34.393Z",
      "updatedAt": "2025-09-03T02:53:34.393Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "47f65d85-24e8-4bc7-bd15-79a1f759eb2c",
      "text": "“Công trình của Đấng Tối Cao kỳ diệu dường nào !”",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:34.407Z",
      "updatedAt": "2025-09-03T02:53:34.407Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "1ff06920-6b8f-4571-949b-2ebb2ef82336",
      "text": "Vào chính ngọ, mặt đất cháy khô,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:34.439Z",
      "updatedAt": "2025-09-03T02:53:34.439Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "45ec0abf-c6a5-4892-a023-3b91d9e00a28",
      "text": "dưới sức nóng mặt trời, ai nào chịu nổi ?",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:34.453Z",
      "updatedAt": "2025-09-03T02:53:34.453Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "1819be86-f031-416f-b34e-b832a428f9ec",
      "text": "Người ta kéo bễ thổi lò để tạo ra sức nóng,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:34.468Z",
      "updatedAt": "2025-09-03T02:53:34.468Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "e4f0615d-b1f2-4422-8438-486e479ea685",
      "text": "nhưng mặt trời còn nóng gấp ba,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:34.482Z",
      "updatedAt": "2025-09-03T02:53:34.482Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "86540ddd-8915-4414-9961-27b2f258f0a0",
      "text": "đốt cháy cả núi đồi, toả hơi nóng bỏng,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:34.498Z",
      "updatedAt": "2025-09-03T02:53:34.498Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "387a2759-72e4-4d60-b3a5-306635d360b7",
      "text": "chiếu rọi những ánh nắng chói chang, làm loá con mắt.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 3,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:34.509Z",
      "updatedAt": "2025-09-03T02:53:34.509Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "79b83516-81c2-4144-bd92-006a7ce8e5fc",
      "text": "Cao cả thay Đức Chúa, Đấng làm ra mặt trời !",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:34.520Z",
      "updatedAt": "2025-09-03T02:53:34.520Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "3ccc2734-50b4-4c1b-8fa1-1848c1e7cf2c",
      "text": "Theo lệnh Người, nó lên đường mau lẹ.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:34.532Z",
      "updatedAt": "2025-09-03T02:53:34.532Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "cf5b8292-70ac-4d9c-b184-5aad20658623",
      "text": "Cả vầng trăng cũng luôn đúng hẹn,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:34.544Z",
      "updatedAt": "2025-09-03T02:53:34.544Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "2701e514-1810-476d-92c3-2f3fa950bc5c",
      "text": "làm dấu hiệu muôn đời chỉ rõ thời gian.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:34.585Z",
      "updatedAt": "2025-09-03T02:53:34.585Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "b73a223f-8ff9-47d9-afb5-39052c53a661",
      "text": "Trăng đánh dấu các thời kỳ đại lễ,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:34.599Z",
      "updatedAt": "2025-09-03T02:53:34.599Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "617d3d38-c876-451c-91d5-59f40ba5783e",
      "text": "có khi khuyết, có lúc lại tròn.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:34.613Z",
      "updatedAt": "2025-09-03T02:53:34.613Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "451005a8-5cbd-4b1c-b2d3-049b39889167",
      "text": "Người ta lấy chữ nguyệt mà đặt tên cho tháng,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:34.640Z",
      "updatedAt": "2025-09-03T02:53:34.640Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "15e0fe6b-8e5a-418c-a40e-542151eec6c1",
      "text": "theo chu kỳ tuyệt diệu, trăng cứ mãi tròn thêm,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:34.668Z",
      "updatedAt": "2025-09-03T02:53:34.668Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "36749dd5-2ebb-4c8f-be3e-5b3ae6132e28",
      "text": "làm đèn hiệu cho đạo binh trên chốn cao vời.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:34.682Z",
      "updatedAt": "2025-09-03T02:53:34.682Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "559484b1-16a1-4b57-9da2-967befc24de3",
      "text": "Khắp bầu trời, vầng trăng toả sáng.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 3,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:34.697Z",
      "updatedAt": "2025-09-03T02:53:34.697Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "fb1565aa-51a9-456c-8e43-cf36480f8e1f",
      "text": "Các vì sao lấp lánh là vẻ đẹp của bầu trời,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:34.711Z",
      "updatedAt": "2025-09-03T02:53:34.711Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "a98e1397-eaac-41e8-b2e7-59107d5db2dc",
      "text": "là đồ trang sức lộng lẫy",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:34.766Z",
      "updatedAt": "2025-09-03T02:53:34.766Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "f643e035-b9c1-4939-bbb4-5c1bb3ddb6b4",
      "text": "trên chốn cao vời của Đức Chúa.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:34.780Z",
      "updatedAt": "2025-09-03T02:53:34.780Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "9e646649-3d1b-4113-b291-2553c66571a2",
      "text": "Vâng lời Đấng Thánh, các vì sao sẵn sàng chờ lệnh,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:34.794Z",
      "updatedAt": "2025-09-03T02:53:34.794Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "b5182f00-7b21-479a-b674-47b97886cc3e",
      "text": "không chểnh mảng trong lúc canh đêm.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:34.808Z",
      "updatedAt": "2025-09-03T02:53:34.808Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "4f6d2a89-7bb8-4bc0-8562-a814e35e88f2",
      "text": "Hãy ngắm cầu vồng mà chúc tụng Đấng làm ra nó,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:34.822Z",
      "updatedAt": "2025-09-03T02:53:34.822Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "68f1c314-e83c-4249-a4f8-45f53342ba77",
      "text": "nó thật là xán lạn huy hoàng,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:34.892Z",
      "updatedAt": "2025-09-03T02:53:34.892Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "7022d109-4cdd-42bd-b2dc-06fbd05c32b2",
      "text": "uốn quanh bầu trời thành vòng cung rực rỡ ;",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:34.906Z",
      "updatedAt": "2025-09-03T02:53:34.906Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "d8ca7776-f024-4e37-a881-f9666e2ef3ad",
      "text": "chính tay Đấng Tối Cao đã giăng lên.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:34.920Z",
      "updatedAt": "2025-09-03T02:53:34.920Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "b12849a2-5f76-410d-aca9-fdafc48d1727",
      "text": "Người ra lệnh truyền, tuyết liền sa xuống.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:34.948Z",
      "updatedAt": "2025-09-03T02:53:34.948Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "b90d42a2-8ed3-483f-916a-13b455f2b3ad",
      "text": "Người phóng những tia chớp làm phán quyết của Người.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.003Z",
      "updatedAt": "2025-09-03T02:53:35.003Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "86eb0d04-0eac-4369-8b8e-db24c84ddbe7",
      "text": "Nhờ vậy, các kho lẫm được mở ra và mây tựa chim chóc bay đi.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.017Z",
      "updatedAt": "2025-09-03T02:53:35.017Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "6d1e2dee-8b4c-4ab2-855f-a8fe7ef2fbdd",
      "text": "Người dùng quyền năng làm cho mây đen đặc",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.049Z",
      "updatedAt": "2025-09-03T02:53:35.049Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "4c24a504-019f-448c-a392-c865fe8b5832",
      "text": "rồi tan thành mưa đá.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.064Z",
      "updatedAt": "2025-09-03T02:53:35.064Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "281d2347-e387-4856-ae1e-ebf1cd187151",
      "text": "Người nhìn, núi non liền rung chuyển,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.105Z",
      "updatedAt": "2025-09-03T02:53:35.105Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "0270d1b6-d35a-4a0b-b665-66a012d92e23",
      "text": "Người muốn là gió nam,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.119Z",
      "updatedAt": "2025-09-03T02:53:35.119Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "b7a3ff87-fd79-433c-a7d4-21c9af493df2",
      "text": "bão táp phương bắc và gió xoáy liền thổi tới.",
      "label": "17b",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.077Z",
      "updatedAt": "2025-09-03T02:53:35.077Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "f6e7f42d-771d-400a-8862-4acf72476516",
      "text": "Người rải tuyết như chim sa,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.161Z",
      "updatedAt": "2025-09-03T02:53:35.161Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "c859b6c5-bd86-46bc-8971-4484205b8cf1",
      "text": "tuyết rơi xuống như cào cào",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.175Z",
      "updatedAt": "2025-09-03T02:53:35.175Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "f53d6dcc-0eff-495e-b10d-bfeeb4106c0d",
      "text": "vẻ đẹp trắng ngần khiến mắt kinh ngạc.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 2,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.189Z",
      "updatedAt": "2025-09-03T02:53:35.189Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "bda97053-8db8-43f6-8459-2d9555929cd7",
      "text": "Thấy tuyết rơi, lòng trí sững sờ.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 3,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.203Z",
      "updatedAt": "2025-09-03T02:53:35.203Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "49034dab-976f-4c11-9544-888d1abf3f99",
      "text": "Người còn đổ sương giá xuống đất như đổ muối,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.217Z",
      "updatedAt": "2025-09-03T02:53:35.217Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "0365d9a4-0af0-4475-aebf-800d3741dbed",
      "text": "sương giá đông lại thành những mũi kim.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.232Z",
      "updatedAt": "2025-09-03T02:53:35.232Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "cce877b6-10e4-4b1e-ab38-3ef545ff276f",
      "text": "Gió lạnh từ phương bắc thổi xuống",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.246Z",
      "updatedAt": "2025-09-03T02:53:35.246Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "5ca283ee-03e6-4a14-ae93-1de9ffda41ca",
      "text": "làm cho mặt nước đóng thành băng ;",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.259Z",
      "updatedAt": "2025-09-03T02:53:35.259Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "efcb55d4-d355-42b1-8587-1ee70f3fa4fe",
      "text": "băng tụ lại trên khắp mặt nước,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 2,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.273Z",
      "updatedAt": "2025-09-03T02:53:35.273Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "67737a07-2afe-4b53-ba92-de5ee566607a",
      "text": "nước như thể mặc lấy chiến bào.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 3,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.288Z",
      "updatedAt": "2025-09-03T02:53:35.288Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "f238e6ba-70a7-4c1f-92ba-abee43f0f293",
      "text": "Gió nóng ngốn sạch núi non, đốt cháy vùng hoang địa,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.301Z",
      "updatedAt": "2025-09-03T02:53:35.301Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "609496b1-b3c1-445e-9b6d-516eb030de5b",
      "text": "nó như ngọn lửa thiêu rụi cỏ xanh.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.315Z",
      "updatedAt": "2025-09-03T02:53:35.315Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "d020bce6-f292-4f40-a855-9305e9570ef0",
      "text": "Bỗng mây bay đến chữa lành tất cả,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.329Z",
      "updatedAt": "2025-09-03T02:53:35.329Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "23e54fe9-67fb-41fc-b495-f6dcf963caee",
      "text": "và sau cơn nồng nực, sương xuống làm cho cảnh vật vui tươi.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.343Z",
      "updatedAt": "2025-09-03T02:53:35.343Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "dc5ebe75-379c-49c7-95fb-5db85d9739ba",
      "text": "Theo kế hoạch của Người, Người chế ngự vực thẳm",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.358Z",
      "updatedAt": "2025-09-03T02:53:35.358Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "291e08a0-c2de-4b61-812d-abcc57612df1",
      "text": "và trồng những hòn đảo lên trên.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.385Z",
      "updatedAt": "2025-09-03T02:53:35.385Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "4eb8c5f3-ccad-48ed-bee9-40bcad3fc42f",
      "text": "Những người vượt biển thuật lại các hiểm nguy,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.399Z",
      "updatedAt": "2025-09-03T02:53:35.399Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "3bf31a91-06de-4adc-b8b9-ac0c70c15ebf",
      "text": "chuyện tai nghe khiến chúng ta kinh ngạc.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.414Z",
      "updatedAt": "2025-09-03T02:53:35.414Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "3a46409e-eb79-42e4-84ac-03ba00d69977",
      "text": "Ở đó có bao điều kỳ diệu, lạ lùng,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.427Z",
      "updatedAt": "2025-09-03T02:53:35.427Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "2a201397-9396-4709-acce-5d2815f991eb",
      "text": "đủ loại thú vật và những loài thuỷ quái.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.455Z",
      "updatedAt": "2025-09-03T02:53:35.455Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "6f98072f-b186-4346-bc67-5774100e5855",
      "text": "Nhờ Người, sứ giả của Người thuận buồm xuôi gió",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.477Z",
      "updatedAt": "2025-09-03T02:53:35.477Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "0f863b67-702d-4c28-a576-69f0c88f96e5",
      "text": "cũng nhờ lời Người, muôn vật được xếp đặt lớp lang.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.492Z",
      "updatedAt": "2025-09-03T02:53:35.492Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "59a29979-e5aa-42c1-b55e-142f9dd52dd4",
      "text": "Kể sao cho xiết những gì muốn nói ;",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.506Z",
      "updatedAt": "2025-09-03T02:53:35.506Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "4d6db1ed-5db8-49c0-98fb-b31d121ac3b8",
      "text": "tắt một lời : “Người là tất cả !”",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 61,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.519Z",
      "updatedAt": "2025-09-03T02:53:35.519Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "1d173979-22e8-45ca-8965-ac7fe10e8113",
      "text": "Làm sao đủ sức để tôn vinh Người ?",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 62,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.547Z",
      "updatedAt": "2025-09-03T02:53:35.547Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "84db05be-8bab-4cf8-ae77-7c66970063f5",
      "text": "Vì chính Người là Đấng Cao Cả,",
      "label": "28",
      "number": 28,
      "subVerseIndex": 1,
      "paragraphNumber": 63,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.561Z",
      "updatedAt": "2025-09-03T02:53:35.561Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "4454116a-435f-45b5-b296-ef53cd42bfdc",
      "text": "vượt trên mọi công trình Người thực hiện.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 2,
      "paragraphNumber": 64,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.590Z",
      "updatedAt": "2025-09-03T02:53:35.590Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "e294419b-d9be-44b7-8180-4b2ca39fb766",
      "text": "Đức Chúa khả uý và rất mực cao cả,",
      "label": "29",
      "number": 29,
      "subVerseIndex": 0,
      "paragraphNumber": 65,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.604Z",
      "updatedAt": "2025-09-03T02:53:35.604Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "298b04cc-576c-4377-8bac-d63bc6361d7e",
      "text": "kỳ diệu thay quyền năng của Người !",
      "label": "29",
      "number": 29,
      "subVerseIndex": 1,
      "paragraphNumber": 66,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.618Z",
      "updatedAt": "2025-09-03T02:53:35.618Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "e2cbbb48-8628-4e44-b0c0-d228c6d65179",
      "text": "Anh em hãy hết sức ca tụng và tôn vinh Đức Chúa,",
      "label": "30",
      "number": 30,
      "subVerseIndex": 0,
      "paragraphNumber": 67,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.632Z",
      "updatedAt": "2025-09-03T02:53:35.632Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "a06575da-6335-41fd-9674-c56a06ff5785",
      "text": "nhưng Người vẫn còn hơn thế nhiều.",
      "label": "30",
      "number": 30,
      "subVerseIndex": 1,
      "paragraphNumber": 68,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.646Z",
      "updatedAt": "2025-09-03T02:53:35.646Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "be69b1b1-fc27-4716-985f-22f108b45294",
      "text": "Để tôn vinh Người, anh em hãy dốc toàn lực.",
      "label": "30",
      "number": 30,
      "subVerseIndex": 2,
      "paragraphNumber": 69,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.660Z",
      "updatedAt": "2025-09-03T02:53:35.660Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "17215663-949d-4a5b-b556-4cec15a5e816",
      "text": "Đừng sờn lòng nản chí, dù anh em chẳng đi tới cùng.",
      "label": "30",
      "number": 30,
      "subVerseIndex": 3,
      "paragraphNumber": 70,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.675Z",
      "updatedAt": "2025-09-03T02:53:35.675Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "74360834-6d34-438f-80ab-4fc75e61e21b",
      "text": "Ai đã từng thấy Người để mà thuật lại ?",
      "label": "31",
      "number": 31,
      "subVerseIndex": 0,
      "paragraphNumber": 71,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.690Z",
      "updatedAt": "2025-09-03T02:53:35.690Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "3b6228f7-7d38-483c-8807-f768ccd293f6",
      "text": "Ai có thể ngợi khen Người cho cân xứng ?",
      "label": "31",
      "number": 31,
      "subVerseIndex": 1,
      "paragraphNumber": 72,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.718Z",
      "updatedAt": "2025-09-03T02:53:35.718Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "e8c84693-3980-4dc4-aa17-f4ad4f2342af",
      "text": "Nhiều điều bí ẩn còn lớn lao hơn những điều kể trên,",
      "label": "32",
      "number": 32,
      "subVerseIndex": 0,
      "paragraphNumber": 73,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.732Z",
      "updatedAt": "2025-09-03T02:53:35.732Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "39a37844-c7e1-4cf8-8e09-54be1df0d6db",
      "text": "và ta chỉ thấy một số ít trong những việc Người làm.",
      "label": "32",
      "number": 32,
      "subVerseIndex": 1,
      "paragraphNumber": 74,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.745Z",
      "updatedAt": "2025-09-03T02:53:35.745Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "6fe04a18-554f-4ea2-a857-2e551d562215",
      "text": "Quả thật, chính Đức Chúa đã làm nên tất cả,",
      "label": "33",
      "number": 33,
      "subVerseIndex": 0,
      "paragraphNumber": 75,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.773Z",
      "updatedAt": "2025-09-03T02:53:35.773Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    },
    {
      "id": "f823aabe-0d45-42e9-806a-404a8832f815",
      "text": "và ban tặng khôn ngoan cho người đạo hạnh.",
      "label": "33",
      "number": 33,
      "subVerseIndex": 1,
      "paragraphNumber": 76,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:53:35.801Z",
      "updatedAt": "2025-09-03T02:53:35.801Z",
      "chapterId": "cbcbdb0e-4efb-461c-8e5b-069a63d59557"
    }
  ],
  "marks": [
    {
      "id": "5831511b-88fc-4ba9-81f9-df7f1160c17c",
      "content": "Tác giả tiếp tục khám phá những kỳ quan trong vũ trụ với tất cả niềm cảm phục sâu xa. Có thể so sánh những vần thơ này với Đn 3,52-90 và với Tv 19,5 tt ; 136 ; 145 ; 148. Nhưng bản văn ở đây rất khó hiểu, cả HL lẫn HR.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 8,
      "endOffset": 8,
      "createdAt": "2025-09-03T02:53:34.339Z",
