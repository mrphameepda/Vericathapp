    },
    {
      "id": "24f59704-4e1d-430b-8f11-73732deef19a",
      "content": "Câu này cũng có thể dịch : *Ước chi có nhiều người chào hỏi con*, hoặc *chúc bình an cho con*, hay là *ước chi con giao lưu liên hệ rộng rãi với nhiều người*.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 43,
      "endOffset": 43,
      "createdAt": "2025-09-03T02:49:06.038Z",
      "updatedAt": "2025-09-03T02:49:06.038Z",
      "targetId": "aa871323-e8e8-4159-9c82-22e05c17d75c",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "3d3921cf-11be-4be8-b88a-c2034b2649e0",
      "content": "Hc 37,1-6",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 0,
      "endOffset": 0,
