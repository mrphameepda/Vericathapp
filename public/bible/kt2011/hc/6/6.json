{
  "chapter": {
    "id": "49c60970-896d-4e9d-aca3-87757aefdc57",
    "number": 6,
    "createdAt": "2025-09-03T01:07:51.705Z",
    "updatedAt": "2025-09-03T01:07:51.705Z",
    "bookId": "5c66a463-0bfa-46b7-9af1-3766a8779b73"
  },
  "verses": [
    {
      "id": "cd2d54da-c188-476c-a646-afe18952e4d9",
      "text": "Quả vậy, bị mang tiếng thì thật là nhục nhã và ô danh,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:05.823Z",
      "updatedAt": "2025-09-03T02:49:05.823Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "31cf30da-b1b1-444a-b45f-e4422594867c",
      "text": "cũng như mắc tội hay nói lời hai ý.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:05.840Z",
      "updatedAt": "2025-09-03T02:49:05.840Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "655e1438-c47b-4153-baf9-7654e701bb97",
      "text": "Đừng dương dương tự đắc khi con quyết định điều gì,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:05.851Z",
      "updatedAt": "2025-09-03T02:49:05.851Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "30f5e6c1-0d98-46f2-936d-24368dee5b60",
      "text": "kẻo con bị nát thân như bò tót.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:05.862Z",
      "updatedAt": "2025-09-03T02:49:05.862Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "3cd471ab-e0ef-493f-a027-9fddda96fb6b",
      "text": "Kẻo lá cành của con, con ngốn sạch,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:05.873Z",
      "updatedAt": "2025-09-03T02:49:05.873Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "46f4fe0b-619c-44e3-a9df-6035e0244af5",
      "text": "hoa trái của con, con phá hết,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:05.884Z",
      "updatedAt": "2025-09-03T02:49:05.884Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "b13763eb-bedc-434b-a3de-f5ce819e24cb",
      "text": "và con sẽ chỉ còn như một khúc củi khô.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:05.911Z",
      "updatedAt": "2025-09-03T02:49:05.911Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "cb8363fa-391c-490a-9d0b-9a1386ba2835",
      "text": "Một con người xấu xa làm băng hoại chính mình,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:05.926Z",
      "updatedAt": "2025-09-03T02:49:05.926Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "c97dc163-287b-4300-86b8-676de4bd8f34",
      "text": "tự biến thành trò cười cho kẻ thù nghịch.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:05.940Z",
      "updatedAt": "2025-09-03T02:49:05.940Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "ce8fa2bf-6685-4cd0-8925-3c2227cc0292",
      "text": "Ăn nói dịu dàng thì tăng thêm bạn hữu,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:05.954Z",
      "updatedAt": "2025-09-03T02:49:05.954Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "0f1f84ce-eb81-4ea1-8631-f86269adcdbf",
      "text": "phát biểu dễ thương thì tăng thêm lời thân ái.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.009Z",
      "updatedAt": "2025-09-03T02:49:06.009Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "aa871323-e8e8-4159-9c82-22e05c17d75c",
      "text": "Ước chi có nhiều người sống hoà nhã với con ;",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.024Z",
      "updatedAt": "2025-09-03T02:49:06.024Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "5160e188-0db2-4aae-82a4-c3ad48e6f3ef",
      "text": "nhưng cố vấn cho con, thì trong muôn ngàn chỉ nên chọn một.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.052Z",
      "updatedAt": "2025-09-03T02:49:06.052Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "1fd5223c-4831-45ee-90f0-20e596cfc815",
      "text": "Nếu con muốn làm bạn với ai thì hãy thử người ấy trước,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.076Z",
      "updatedAt": "2025-09-03T02:49:06.076Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "ff1ce52a-ef60-4f2b-8dfc-11137f30ec0b",
      "text": "nhưng đừng vội tin tưởng ngay.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.097Z",
      "updatedAt": "2025-09-03T02:49:06.097Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "13f79b3d-e334-47ca-8f42-0b6a5eeb3a30",
      "text": "Vì có kẻ chỉ là bạn nhất thời,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.108Z",
      "updatedAt": "2025-09-03T02:49:06.108Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "183eadc9-90df-4e65-a8e4-34fcc15ec941",
      "text": "ngày con gặp nạn, nó chẳng còn là bạn nữa.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.122Z",
      "updatedAt": "2025-09-03T02:49:06.122Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "8b7d1e29-aaaa-4a4a-91fe-0b2e5514993c",
      "text": "Có người là bạn lại trở nên thù,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.134Z",
      "updatedAt": "2025-09-03T02:49:06.134Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "5565fc00-0faa-40ab-8587-8644f913cae3",
      "text": "và tiết lộ chuyện cãi nhau, khiến con phải xấu hổ.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.147Z",
      "updatedAt": "2025-09-03T02:49:06.147Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "28f4146f-4c98-4185-a328-64bb623d1105",
      "text": "Có người là bạn khi đồng hành với con,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.160Z",
      "updatedAt": "2025-09-03T02:49:06.160Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "792abdcd-452b-4e0d-b66e-72e8102fa39e",
      "text": "nhưng ngày con gặp nạn, nó chẳng còn là bạn nữa.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.172Z",
      "updatedAt": "2025-09-03T02:49:06.172Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "3c6a34bb-7cbe-4740-9d1b-7e6e0aa340b2",
      "text": "Khi con gặp may, thì nó chẳng khác nào chính con :",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.186Z",
      "updatedAt": "2025-09-03T02:49:06.186Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "ba8e4f7f-e613-4b28-9562-d7a5ee7f68ca",
      "text": "gia nhân con, nó tự do sai bảo.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.214Z",
      "updatedAt": "2025-09-03T02:49:06.214Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "22128d83-55f6-4cb0-8cd8-623ca1d9cf9f",
      "text": "Nhưng lúc con sa cơ, nó liền chống lại và lánh mặt con luôn.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.228Z",
      "updatedAt": "2025-09-03T02:49:06.228Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "4cd7728f-3215-4e4f-99c5-93eb23defd5b",
      "text": "Với quân thù, con hãy tránh xa,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.242Z",
      "updatedAt": "2025-09-03T02:49:06.242Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "d00e137f-141d-41be-a521-e2dca94958bf",
      "text": "còn với bè bạn, con phải coi chừng.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.256Z",
      "updatedAt": "2025-09-03T02:49:06.256Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "3ce346d2-9446-45bd-8cfb-9b07cab51f73",
      "text": "Người bạn trung thành là một nơi nương tựa vững chắc,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.284Z",
      "updatedAt": "2025-09-03T02:49:06.284Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "2ff62751-a0ea-4763-b2ea-b93d37071979",
      "text": "ai gặp được người bạn như thế, là gặp được kho tàng.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.298Z",
      "updatedAt": "2025-09-03T02:49:06.298Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "396ee029-f88e-4155-9613-2c0961a687cb",
      "text": "Không gì đổi lấy được một người bạn trung thành,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.312Z",
      "updatedAt": "2025-09-03T02:49:06.312Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "9eedcfde-956f-4caf-aa35-cf593d38b771",
      "text": "và giá trị của người bạn ấy, không cân nào lường được.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.327Z",
      "updatedAt": "2025-09-03T02:49:06.327Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "541778ad-a8c1-4750-acc8-c75bc192231f",
      "text": "Người bạn trung thành là phương thuốc xoa dịu cuộc đời,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.340Z",
      "updatedAt": "2025-09-03T02:49:06.340Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "4024ed1a-3101-4866-b402-bd7450909644",
      "text": "những ai kính sợ Đức Chúa sẽ gặp được người như vậy.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.368Z",
      "updatedAt": "2025-09-03T02:49:06.368Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "03edc1de-5c42-4ad7-ac03-04b1f7a50870",
      "text": "Người kính sợ Đức Chúa thì điều khiển được tình bạn của mình",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.383Z",
      "updatedAt": "2025-09-03T02:49:06.383Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "4f4e2da7-fd5c-43e6-ba9d-c06c83ca5d87",
      "text": "vì bản thân mình thế nào, thì cận thân mình cũng thế.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.397Z",
      "updatedAt": "2025-09-03T02:49:06.397Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "cb42c544-e4dc-4638-8305-1401a2620986",
      "text": "Con ơi, từ thiếu thời, hãy hấp thụ giáo huấn,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.425Z",
      "updatedAt": "2025-09-03T02:49:06.425Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "6a69b3eb-a15f-4c13-873d-7f84cb4201a2",
      "text": "thì tới khi tóc bạc, con sẽ được khôn ngoan.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.466Z",
      "updatedAt": "2025-09-03T02:49:06.466Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "72c2287b-bb3f-4860-900e-51195e7d41b7",
      "text": "Như người cày và kẻ gieo, con hãy vun trồng khôn ngoan,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.483Z",
      "updatedAt": "2025-09-03T02:49:06.483Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "08351056-d49c-4e79-909f-3e7186bc8876",
      "text": "và đợi chờ hoa thơm trái tốt của đức ấy ;",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.514Z",
      "updatedAt": "2025-09-03T02:49:06.514Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "aa765b23-39a0-4020-bbbe-3da5de122000",
      "text": "vì con phải khó nhọc vun trồng một thời gian thôi,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 2,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.543Z",
      "updatedAt": "2025-09-03T02:49:06.543Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "cc82fbb4-bc46-40e1-a03e-07afd235706e",
      "text": "rồi chẳng bao lâu sẽ được ăn hoa trái.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 3,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.558Z",
      "updatedAt": "2025-09-03T02:49:06.558Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "7550d7cb-89e3-418f-86f2-65a741d7ee20",
      "text": "Giáo huấn quả thật là gay go đối với những kẻ vô học,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.571Z",
      "updatedAt": "2025-09-03T02:49:06.571Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "617a15fa-7b17-4997-9ed8-3ed8dbfe346d",
      "text": "và kẻ vô tâm vô trí thì không kiên trì trong việc thụ giáo.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.600Z",
      "updatedAt": "2025-09-03T02:49:06.600Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "4a8a7070-a44b-4dc8-8269-78b05bb5c436",
      "text": "Giáo huấn, như đá tảng thử sức, đè nặng trên người ấy,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.614Z",
      "updatedAt": "2025-09-03T02:49:06.614Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "260a39da-4084-4875-8f39-271e7517d8fb",
      "text": "rồi chẳng mấy chốc nó sẽ vứt bỏ đi.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.641Z",
      "updatedAt": "2025-09-03T02:49:06.641Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "da50531c-340f-4c9a-9c00-79c349a2931b",
      "text": "Quả thật, khôn ngoan xứng với tên mình :",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.655Z",
      "updatedAt": "2025-09-03T02:49:06.655Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "d21ef779-f423-478e-8a5c-26f1f6aa6aed",
      "text": "không phải nhiều người biết rõ đâu !",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.669Z",
      "updatedAt": "2025-09-03T02:49:06.669Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "dd3d2ed0-30c1-452b-8572-a6bc64f18415",
      "text": "Con ơi, hãy lắng nghe và đón nhận điều ta dạy bảo,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.684Z",
      "updatedAt": "2025-09-03T02:49:06.684Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "08dcb5b1-13a3-47ee-9e6f-da91eac5dc50",
      "text": "và đừng vứt bỏ ý kiến của ta.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.697Z",
      "updatedAt": "2025-09-03T02:49:06.697Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "b4439637-500c-4409-9917-4de859650194",
      "text": "Hãy đưa chân cho khôn ngoan xích lại,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.711Z",
      "updatedAt": "2025-09-03T02:49:06.711Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "e49e78a9-3a89-46c2-b377-c6d3fc95068f",
      "text": "và cúi đầu cho khôn ngoan đặt dây cương.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.726Z",
      "updatedAt": "2025-09-03T02:49:06.726Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "477c111d-b015-4cb9-bfb1-67dd4b3d415a",
      "text": "Hãy ghé vai mang lấy,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.739Z",
      "updatedAt": "2025-09-03T02:49:06.739Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "2186fc68-cc5f-4404-a329-3142dd36a3f3",
      "text": "và đừng bất mãn vì bị khôn ngoan ràng buộc.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.774Z",
      "updatedAt": "2025-09-03T02:49:06.774Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "84706e7c-e9c5-444e-9cf0-bac82cb2d321",
      "text": "Với tất cả tâm tình, hãy trau dồi khôn ngoan,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.788Z",
      "updatedAt": "2025-09-03T02:49:06.788Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "ee145005-e8b7-4cab-bbc3-a689e2b1523f",
      "text": "và đường lối của khôn ngoan, hãy gắng công tuân giữ.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.830Z",
      "updatedAt": "2025-09-03T02:49:06.830Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "e6a5e10e-60e0-4d1d-8fdf-902cd3f4a2c3",
      "text": "Cứ theo dõi và kiếm tìm,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.844Z",
      "updatedAt": "2025-09-03T02:49:06.844Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "21cb045d-5098-447b-a527-ab79f4801a27",
      "text": "thì khôn ngoan sẽ tỏ mình ra cho con biết,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.861Z",
      "updatedAt": "2025-09-03T02:49:06.861Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "80f05463-1963-4984-a68d-5ed29d507141",
      "text": "và một khi đã nắm được rồi, con chớ buông ra.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 2,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.875Z",
      "updatedAt": "2025-09-03T02:49:06.875Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "4a258173-8611-4208-896e-4bf45a258f0a",
      "text": "Vì cuối cùng, khôn ngoan sẽ cho con được nghỉ ngơi yên hàn,",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.890Z",
      "updatedAt": "2025-09-03T02:49:06.890Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "cb9768d7-b439-4af8-bb8f-f80f93292ae7",
      "text": "và sẽ trở thành niềm hoan lạc của con.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 1,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.918Z",
      "updatedAt": "2025-09-03T02:49:06.918Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "bf5d223c-e88c-44e3-b49e-cb8f6db95bfd",
      "text": "Xiềng xích của khôn ngoan sẽ là nơi nương tựa vững chắc,",
      "label": "29",
      "number": 29,
      "subVerseIndex": 0,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.938Z",
      "updatedAt": "2025-09-03T02:49:06.938Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "04d91f52-41b3-4897-a881-1019d6feed7e",
      "text": "và dây cương của khôn ngoan",
      "label": "29",
      "number": 29,
      "subVerseIndex": 1,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.952Z",
      "updatedAt": "2025-09-03T02:49:06.952Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "3440f320-e896-47e4-95be-f255f7383725",
      "text": "sẽ như trang phục huy hoàng của con.",
      "label": "29",
      "number": 29,
      "subVerseIndex": 2,
      "paragraphNumber": 61,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.966Z",
      "updatedAt": "2025-09-03T02:49:06.966Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "be1c0c24-9216-4588-a1df-c01d367bb59e",
      "text": "Ách của khôn ngoan là đồ trang sức bằng vàng,",
      "label": "30",
      "number": 30,
      "subVerseIndex": 0,
      "paragraphNumber": 62,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:06.980Z",
      "updatedAt": "2025-09-03T02:49:06.980Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "51a4d2ca-6776-4323-affa-b98670f69315",
      "text": "và dây buộc của khôn ngoan là dải điều quý giá.",
      "label": "30",
      "number": 30,
      "subVerseIndex": 1,
      "paragraphNumber": 63,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:07.027Z",
      "updatedAt": "2025-09-03T02:49:07.027Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "da11663c-fabc-4fa5-b539-72671ead471c",
      "text": "Con sẽ mặc lấy khôn ngoan như áo choàng rực rỡ,",
      "label": "31",
      "number": 31,
      "subVerseIndex": 0,
      "paragraphNumber": 64,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:07.042Z",
      "updatedAt": "2025-09-03T02:49:07.042Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "1ed50d62-c7ab-4abe-b095-d87b6bc63ae2",
      "text": "đội lên đầu như triều thiên biểu lộ niềm vui.",
      "label": "31",
      "number": 31,
      "subVerseIndex": 1,
      "paragraphNumber": 65,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:07.055Z",
      "updatedAt": "2025-09-03T02:49:07.055Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "3c7391c5-6ec9-48d3-ba76-54bde7f4a0eb",
      "text": "Con ơi, nếu muốn, con sẽ là người có học,",
      "label": "32",
      "number": 32,
      "subVerseIndex": 0,
      "paragraphNumber": 66,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:07.096Z",
      "updatedAt": "2025-09-03T02:49:07.096Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "28759420-ab42-4537-ad8a-ef37e7b00b49",
      "text": "nếu để tâm, con sẽ thành người khôn khéo.",
      "label": "32",
      "number": 32,
      "subVerseIndex": 1,
      "paragraphNumber": 67,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:07.109Z",
      "updatedAt": "2025-09-03T02:49:07.109Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "bb4eb1dd-01c7-45f0-bdfe-74c1ef62971f",
      "text": "Nếu thích nghe, con sẽ học được nhiều,",
      "label": "33",
      "number": 33,
      "subVerseIndex": 0,
      "paragraphNumber": 68,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:07.121Z",
      "updatedAt": "2025-09-03T02:49:07.121Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "8faba4b1-3e3f-4bdd-b896-45e9cf5c7696",
      "text": "nếu biết lắng tai để ý, con sẽ trở nên khôn.",
      "label": "33",
      "number": 33,
      "subVerseIndex": 1,
      "paragraphNumber": 69,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:07.134Z",
      "updatedAt": "2025-09-03T02:49:07.134Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "7f985be5-3c75-4b05-98c2-3674d8f3fcca",
      "text": "Hãy có mặt khi các bậc lão thành hội họp,",
      "label": "34",
      "number": 34,
      "subVerseIndex": 0,
      "paragraphNumber": 70,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:07.146Z",
      "updatedAt": "2025-09-03T02:49:07.146Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "e659ff8d-aa37-48e0-bb1c-b432e5c0306e",
      "text": "thấy vị nào khôn ngoan, hãy hết lòng gắn bó.",
      "label": "34",
      "number": 34,
      "subVerseIndex": 1,
      "paragraphNumber": 71,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:07.172Z",
      "updatedAt": "2025-09-03T02:49:07.172Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "ad9aeb54-4a2a-4593-ab2f-d15c718d314e",
      "text": "Mọi lời lẽ về Thiên Chúa, con hãy thích nghe,",
      "label": "35",
      "number": 35,
      "subVerseIndex": 0,
      "paragraphNumber": 72,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:07.187Z",
      "updatedAt": "2025-09-03T02:49:07.187Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "337014bc-e68b-4857-8a82-313bd840dc53",
      "text": "những châm ngôn ý nhị, con đừng bỏ uổng.",
      "label": "35",
      "number": 35,
      "subVerseIndex": 1,
      "paragraphNumber": 73,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:07.201Z",
      "updatedAt": "2025-09-03T02:49:07.201Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "10dd1775-5d83-4501-bd88-5d5b19712940",
      "text": "Thấy người học thức uyên thâm, con hãy năng lui tới,",
      "label": "36",
      "number": 36,
      "subVerseIndex": 0,
      "paragraphNumber": 74,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:07.215Z",
      "updatedAt": "2025-09-03T02:49:07.215Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "8aaa9d71-4e66-4420-9a1f-f34f1f037137",
      "text": "chân đi mòn ngưỡng cửa nhà họ.",
      "label": "36",
      "number": 36,
      "subVerseIndex": 1,
      "paragraphNumber": 75,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:07.228Z",
      "updatedAt": "2025-09-03T02:49:07.228Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "15fb183a-ea15-4778-88d3-079f63a1981f",
      "text": "Hãy suy gẫm các mệnh lệnh Đức Chúa đã truyền,",
      "label": "37",
      "number": 37,
      "subVerseIndex": 0,
      "paragraphNumber": 76,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:07.242Z",
      "updatedAt": "2025-09-03T02:49:07.242Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "d5917d4d-f691-42a3-9db2-70ce76a87974",
      "text": "các điều răn của Người, hãy luôn luôn để ý.",
      "label": "37",
      "number": 37,
      "subVerseIndex": 1,
      "paragraphNumber": 77,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:07.270Z",
      "updatedAt": "2025-09-03T02:49:07.270Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "d23f15bd-580b-454a-bb9a-d3ddf9cf3cee",
      "text": "Chính Người làm cho tâm hồn con kiên vững,",
      "label": "37",
      "number": 37,
      "subVerseIndex": 2,
      "paragraphNumber": 78,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:07.284Z",
      "updatedAt": "2025-09-03T02:49:07.284Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    },
    {
      "id": "b6f7dc75-fce1-45bf-a3bb-d7149b75bd58",
      "text": "và cho con được khôn ngoan như lòng sở nguyện.",
      "label": "37",
      "number": 37,
      "subVerseIndex": 3,
      "paragraphNumber": 79,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:07.298Z",
      "updatedAt": "2025-09-03T02:49:07.298Z",
      "chapterId": "49c60970-896d-4e9d-aca3-87757aefdc57"
    }
  ],
  "marks": [
    {
      "id": "74e4ddc9-65b7-4c22-a5c0-cfce1131bbe8",
      "content": "Ga 15,5-6",
      "kind": "MARK_KIND_REFERENCE",
      "label": "1@",
      "sortOrder": 0,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:49:05.896Z",
      "updatedAt": "2025-09-03T02:49:05.896Z",
      "targetId": "46f4fe0b-619c-44e3-a9df-6035e0244af5",
      "targetType": "MARK_TARGET_TYPE_VERSE",
