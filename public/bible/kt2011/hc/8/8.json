{
  "chapter": {
    "id": "45518557-dedc-438f-bd47-64168d821536",
    "number": 8,
    "createdAt": "2025-09-03T01:07:51.705Z",
    "updatedAt": "2025-09-03T01:07:51.705Z",
    "bookId": "5c66a463-0bfa-46b7-9af1-3766a8779b73"
  },
  "verses": [
    {
      "id": "7444481b-bfbe-4605-938f-c0851ba34f0f",
      "text": "Con đừng chống chọi với người quyền thế, kẻo rơi vào tay họ.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:19.809Z",
      "updatedAt": "2025-09-03T02:49:19.809Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "010845b9-3f50-4456-823c-a69f49720c91",
      "text": "Đừng tranh chấp với người giàu,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:19.840Z",
      "updatedAt": "2025-09-03T02:49:19.840Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "24e59736-472a-41d0-beff-e09abdaa4e01",
      "text": "kẻo họ lấy thế mạnh mà chống lại con ;",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:19.861Z",
      "updatedAt": "2025-09-03T02:49:19.861Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "40714276-39bf-48fd-9cf3-1bcd4ec1e5c0",
      "text": "vì vàng bạc làm cho bao người hư hỏng",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:19.871Z",
      "updatedAt": "2025-09-03T02:49:19.871Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "13309218-5587-42fa-a39a-8f24b25a8e85",
      "text": "và lòng dạ vua chúa ngả nghiêng.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 3,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:19.883Z",
      "updatedAt": "2025-09-03T02:49:19.883Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "d4be3f0d-3418-4124-98ac-6f02e926f969",
      "text": "Đừng chống chọi với kẻ lắm mồm,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:19.896Z",
      "updatedAt": "2025-09-03T02:49:19.896Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "06e5cf07-578e-4505-8534-e1c53abdc74a",
      "text": "cũng đừng chất củi thêm vào lửa.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:19.910Z",
      "updatedAt": "2025-09-03T02:49:19.910Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "e7b47a70-62e0-452d-aac0-f364f8a2343c",
      "text": "Đừng đùa giỡn với kẻ vô giáo dục,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:19.923Z",
      "updatedAt": "2025-09-03T02:49:19.923Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "84c0c3f1-638f-4662-8349-e591a4191672",
      "text": "kẻo tổ tiên con bị khinh chê.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:19.937Z",
      "updatedAt": "2025-09-03T02:49:19.937Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "c05a8c8f-5b95-4fa9-a397-1a8f94e39c50",
      "text": "Một người đã biết hối lỗi, con đừng la rầy,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:19.966Z",
      "updatedAt": "2025-09-03T02:49:19.966Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "6b35e3c8-18cf-485a-b9ae-f6362f27f853",
      "text": "hãy nhớ rằng tất cả chúng ta đều đáng phạt.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:19.979Z",
      "updatedAt": "2025-09-03T02:49:19.979Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "107901a7-fa1a-40cd-8401-8c34dc52b968",
      "text": "Đừng khinh dể người đã cao niên,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:20.021Z",
      "updatedAt": "2025-09-03T02:49:20.021Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "9e3759c7-9651-479f-82bf-a6a79c3bc651",
      "text": "vì đến lượt chúng ta rồi cũng già hết cả.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:20.044Z",
      "updatedAt": "2025-09-03T02:49:20.044Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "1ae29301-36f1-426b-a073-4978112f8548",
      "text": "Khi có người nào chết, con chớ vui mừng,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:20.057Z",
      "updatedAt": "2025-09-03T02:49:20.057Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "31f90fca-af1b-42ce-a144-e1385300faf5",
      "text": "hãy nhớ rằng tất cả chúng ta đều phải chết.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:20.068Z",
      "updatedAt": "2025-09-03T02:49:20.068Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "6a9087b1-819a-4739-a567-03068cdcf442",
      "text": "Chớ khinh thường chuyện các bậc khôn ngoan kể lại,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:20.080Z",
      "updatedAt": "2025-09-03T02:49:20.080Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "fc2d5572-a33f-407d-bbe2-975f372c7971",
      "text": "hãy nghiền ngẫm phương ngôn của các ngài ;",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:20.127Z",
      "updatedAt": "2025-09-03T02:49:20.127Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "c567b247-447f-4681-9a18-f593a2c4130a",
      "text": "vì nhờ học với các ngài mà con có được kiến thức,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:20.140Z",
      "updatedAt": "2025-09-03T02:49:20.140Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "3903d0dc-7330-4557-805b-ca4ccfb69c98",
      "text": "và biết cách phục vụ các bậc quyền cao.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 3,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:20.154Z",
      "updatedAt": "2025-09-03T02:49:20.154Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "d8b1fa27-18fb-4efa-ba06-a8096df9a9ff",
      "text": "Đừng bỏ qua chuyện các vị cao niên kể lại,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:20.183Z",
      "updatedAt": "2025-09-03T02:49:20.183Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "41b8d4c6-e7ad-4152-afcd-93b78543315c",
      "text": "vì chính các ngài đã học hỏi nơi tổ tiên mình ;",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:20.196Z",
      "updatedAt": "2025-09-03T02:49:20.196Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "9066b512-3f67-4c52-856a-c695bd66f00d",
      "text": "nhờ học với các ngài mà con có được sự hiểu biết,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:20.232Z",
      "updatedAt": "2025-09-03T02:49:20.232Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "39d8beb0-6ce1-4539-b496-c3a59b26d72a",
      "text": "và khi cần, con biết đưa ra câu trả lời thích hợp.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 3,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:20.246Z",
      "updatedAt": "2025-09-03T02:49:20.246Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "1f74a656-c01e-447d-9b5a-e213263c43a2",
      "text": "Đừng khơi dậy lửa đam mê của người tội lỗi,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:20.274Z",
      "updatedAt": "2025-09-03T02:49:20.274Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "0acf952b-27f2-4e2a-a2ff-e7fbf2c63d47",
      "text": "kẻo chính con bị đốt cháy trong ngọn lửa của y.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:20.301Z",
      "updatedAt": "2025-09-03T02:49:20.301Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "69c6d413-fe9e-4914-8e4c-cc7843c6face",
      "text": "Con chớ đương đầu với kẻ vũ phu,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:20.315Z",
      "updatedAt": "2025-09-03T02:49:20.315Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "47cab8d2-8188-41aa-a6ef-bc5cb4b3069e",
      "text": "kẻo nó nên như cái bẫy cho con lỡ lời.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:20.328Z",
      "updatedAt": "2025-09-03T02:49:20.328Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "ee598755-d356-41e8-b7ba-8395d9c50469",
      "text": "Đừng cho kẻ mạnh thế hơn con vay mượn,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:20.342Z",
      "updatedAt": "2025-09-03T02:49:20.342Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "0bae6284-faf5-453a-8452-8f511f50e523",
      "text": "cho họ mượn là kể như mất đứt rồi.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:20.369Z",
      "updatedAt": "2025-09-03T02:49:20.369Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "1f09d41d-e56b-4e72-bc0b-8b6cac02efdf",
      "text": "Đừng đứng ra bảo đảm điều gì vượt quá sức con,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:20.384Z",
      "updatedAt": "2025-09-03T02:49:20.384Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "e8ead152-abcd-4704-8c8a-22d89c196178",
      "text": "nếu đã bảo đảm, thì lo mà thanh toán.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:20.411Z",
      "updatedAt": "2025-09-03T02:49:20.411Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "60b10d4d-af6f-48b9-aefd-7103bdbf6caa",
      "text": "Đừng tranh kiện với quan toà,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:20.425Z",
      "updatedAt": "2025-09-03T02:49:20.425Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "adb3bd44-9b67-4c7b-abef-8171fdc8ec6d",
      "text": "toà sẽ vì danh dự của ông mà xử cho ông thắng.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:20.442Z",
      "updatedAt": "2025-09-03T02:49:20.442Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "1cf19de6-3f22-49db-8642-2bbb7c945b57",
      "text": "Đừng đồng hành với quân bạt mạng, kẻo nó ăn hiếp con ;",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:20.458Z",
      "updatedAt": "2025-09-03T02:49:20.458Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "13908f59-cbe1-4aad-a5e4-747331120280",
      "text": "vì chính nó chỉ làm theo sở thích :",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:20.486Z",
      "updatedAt": "2025-09-03T02:49:20.486Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "54da1bee-053f-437a-8f7b-8cc1bf68348f",
      "text": "sự điên rồ của nó làm cho cả hai phải tiêu vong.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 2,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:20.501Z",
      "updatedAt": "2025-09-03T02:49:20.501Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "d0742157-6788-40a1-9d7a-3bee740a2487",
      "text": "Đừng đánh nhau với kẻ hung dữ,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:20.518Z",
      "updatedAt": "2025-09-03T02:49:20.518Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "f3a8c050-71b3-4d37-89e6-1cafebdeda44",
      "text": "cũng đừng đi qua nơi vắng vẻ với y ;",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:20.546Z",
      "updatedAt": "2025-09-03T02:49:20.546Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "51e76713-b847-4315-847c-75953adfd359",
      "text": "vì y coi chuyện đổ máu như không vậy,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 2,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:20.560Z",
      "updatedAt": "2025-09-03T02:49:20.560Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "ab3eb01c-0e56-4bc7-bfe2-9fed853b5b6b",
      "text": "và y sẽ tấn công con nơi chẳng có ai cứu giúp.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 3,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:20.574Z",
      "updatedAt": "2025-09-03T02:49:20.574Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "6599bdf9-9ebd-49dc-8e13-8e4db7eed6ae",
      "text": "Đừng bàn hỏi người ngu, vì nó không giữ kín được.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:20.587Z",
      "updatedAt": "2025-09-03T02:49:20.587Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "c472cd90-786e-4e41-9e00-f1ccccda8fd4",
      "text": "Trước mặt người lạ, chớ làm điều phải giữ kín,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:20.601Z",
      "updatedAt": "2025-09-03T02:49:20.601Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "63d48af5-98a9-41f3-a5b0-a3d09eec5464",
      "text": "vì con chẳng biết chuyện gì sẽ xảy ra.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:20.615Z",
      "updatedAt": "2025-09-03T02:49:20.615Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "a06589a5-bfda-479a-a53a-6690a772b5c6",
      "text": "Đừng tâm sự với bất cứ người nào,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:20.628Z",
      "updatedAt": "2025-09-03T02:49:20.628Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "8e3ff9c2-75f8-4245-a332-4cdc777db128",
      "text": "đừng tưởng làm như vậy là người ta thích.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:20.640Z",
      "updatedAt": "2025-09-03T02:49:20.640Z",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    }
  ],
  "marks": [
    {
      "id": "9e93c27c-cd2f-45ba-8918-b94212aadf49",
      "content": "Cn 10,15",
      "kind": "MARK_KIND_REFERENCE",
      "label": "1@",
      "sortOrder": 0,
      "startOffset": 20,
      "endOffset": 20,
      "createdAt": "2025-09-03T02:49:19.850Z",
      "updatedAt": "2025-09-03T02:49:19.850Z",
      "targetId": "010845b9-3f50-4456-823c-a69f49720c91",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "5b460323-7b6b-4812-b64b-ee02fd6eb28d",
      "content": "Bằng cách đưa cha mẹ, tổ tiên ra mà chửi tục như thường xảy ra trong giới bình dân ở Việt Nam.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 28,
      "endOffset": 28,
      "createdAt": "2025-09-03T02:49:19.952Z",
      "updatedAt": "2025-09-03T02:49:19.952Z",
      "targetId": "84c0c3f1-638f-4662-8349-e591a4191672",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "f21f0f37-bbfd-441c-bc46-57dbb0e5cb19",
      "content": "HR : *có lỗi, đáng trách*. Ý tưởng mọi người đều mắc tội đã phổ quát trong Cựu Ước (1 V 8,46 ; Gv 7,20) sẽ còn được Tân Ước quả quyết rõ hơn (Rm 3,9-20).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 42,
      "endOffset": 42,
      "createdAt": "2025-09-03T02:49:19.994Z",
      "updatedAt": "2025-09-03T02:49:19.994Z",
      "targetId": "6b35e3c8-18cf-485a-b9ae-f6362f27f853",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "5146cb45-1d40-4eb1-9f52-ab16a63d502b",
      "content": "Mt 7,1-5; Rm 3,9-20; 1 Ga 1,8-10",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 33,
      "endOffset": 33,
      "createdAt": "2025-09-03T02:49:20.008Z",
      "updatedAt": "2025-09-03T02:49:20.008Z",
      "targetId": "6b35e3c8-18cf-485a-b9ae-f6362f27f853",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "e1de4b41-cb53-4738-8781-4446880155ef",
      "content": "Lv 19,32",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 23,
      "endOffset": 23,
      "createdAt": "2025-09-03T02:49:20.032Z",
      "updatedAt": "2025-09-03T02:49:20.032Z",
      "targetId": "107901a7-fa1a-40cd-8401-8c34dc52b968",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "86a1f9e1-998f-46f8-b9bc-4ad659b7cd7c",
      "content": "Tác giả Ben Xi-ra thừa biết rằng khôn ngoan là chuyện thuộc truyền thống và xưa kia, tại Ít-ra-en cũng như ở Ai-cập, khôn ngoan là “nghệ thuật phục vụ các vị lớn” mà một viên chức phải lo học cho được.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 12,
      "endOffset": 12,
      "createdAt": "2025-09-03T02:49:20.102Z",
      "updatedAt": "2025-09-03T02:49:20.102Z",
      "targetId": "825be53f-cb7e-4902-9fc7-5d7c3d3b1f91",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "1d231dd1-76d4-4652-b1b0-ea0a4a4ec763",
      "content": "Cn 13,20",
      "kind": "MARK_KIND_REFERENCE",
      "label": "4@",
      "sortOrder": 3,
      "startOffset": 28,
      "endOffset": 28,
      "createdAt": "2025-09-03T02:49:20.114Z",
      "updatedAt": "2025-09-03T02:49:20.114Z",
      "targetId": "6a9087b1-819a-4739-a567-03068cdcf442",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "7b304ed3-327c-45ff-ae82-c60b393afee4",
      "content": "Đấy là góc cạnh thực hành của khôn ngoan. Các thầy Ráp-bi gọi đó là “luật truyền khẩu” được cha truyền con nối dưới dạng “các châm ngôn”. Truyền khẩu này rất quan trọng đối với Ít-ra-en và là gốc nguồn của hầu hết các Sách Thánh trước khi được viết ra. X. Đnl 4,9 ; 11,19 ; Tv 44,2 ; 78,3 tt ; G 8,8 ; 12,12.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 45,
      "endOffset": 45,
      "createdAt": "2025-09-03T02:49:20.217Z",
      "updatedAt": "2025-09-03T02:49:20.217Z",
      "targetId": "41b8d4c6-e7ad-4152-afcd-93b78543315c",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "5ea81337-099f-4923-8697-a5f79ceb9c6a",
      "content": "Cn 14,35; 16,13",
      "kind": "MARK_KIND_REFERENCE",
      "label": "5@",
      "sortOrder": 4,
      "startOffset": 25,
      "endOffset": 25,
      "createdAt": "2025-09-03T02:49:20.169Z",
      "updatedAt": "2025-09-03T02:49:20.169Z",
      "targetId": "3903d0dc-7330-4557-805b-ca4ccfb69c98",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "45518557-dedc-438f-bd47-64168d821536"
    },
    {
      "id": "ba3b8296-67b5-4567-a7a0-e383e347991c",
      "content": "HR : *và đừng làm cho hạnh phúc bỏ con mà đi*. Cũng có thể dịch : *và đừng hòng lấy lòng người ta*.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "5",
      "sortOrder": 4,
      "startOffset": 40,
      "endOffset": 40,
      "createdAt": "2025-09-03T02:49:20.650Z",
