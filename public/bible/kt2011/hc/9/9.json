{
  "chapter": {
    "id": "bced09d7-3767-484a-940a-a1af1cce12fe",
    "number": 9,
    "createdAt": "2025-09-03T01:07:51.705Z",
    "updatedAt": "2025-09-03T01:07:51.705Z",
    "bookId": "5c66a463-0bfa-46b7-9af1-3766a8779b73"
  },
  "verses": [
    {
      "id": "9ddb3483-eee6-46ff-8dc8-80534c255d04",
      "text": "Đừng ghen với người vợ mà con đang ôm ấp,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.088Z",
      "updatedAt": "2025-09-03T02:49:26.088Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "25f7fd1c-231a-4b64-9816-d8fec0c91171",
      "text": "kẻo con dạy cho nàng nghĩ xấu về con.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.148Z",
      "updatedAt": "2025-09-03T02:49:26.148Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "a099167c-aeb6-491c-b60f-24e7242b75fd",
      "text": "Đừng phó mặc hồn con cho một người đàn bà,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.159Z",
      "updatedAt": "2025-09-03T02:49:26.159Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "6adeb7b5-2c9d-4e18-8c6d-cf3ebdae737e",
      "text": "kẻo bị nó đè đầu đè cổ.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.184Z",
      "updatedAt": "2025-09-03T02:49:26.184Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "7858ccbf-8229-4857-82a6-37dfb29578aa",
      "text": "Đừng đón đường một gái làng chơi,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.197Z",
      "updatedAt": "2025-09-03T02:49:26.197Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "4bd97532-3ddd-4159-b7c3-22efe4aee7c5",
      "text": "kẻo con rơi vào bẫy của nó.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.225Z",
      "updatedAt": "2025-09-03T02:49:26.225Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "1d04e5d9-b7f8-44b0-910b-cc25b609ceb1",
      "text": "Đừng đi lại với một ả đào,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.239Z",
      "updatedAt": "2025-09-03T02:49:26.239Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "615ff556-f2d2-4b03-bec4-c2bcd0b0a992",
      "text": "kẻo con mắc phải mưu mô của nó.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.266Z",
      "updatedAt": "2025-09-03T02:49:26.266Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "10c21b7c-82e4-4c2e-9d63-88b44ca66994",
      "text": "Đừng chòng chọc nhìn nàng trinh nữ,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.280Z",
      "updatedAt": "2025-09-03T02:49:26.280Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "a1acaa94-e6e7-4712-890b-7f9a41b70753",
      "text": "kẻo con sa ngã mà bị phạt với nàng.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.308Z",
      "updatedAt": "2025-09-03T02:49:26.308Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "bf4aae76-d0ac-42dc-9b4c-360f3ca2f3f7",
      "text": "Đừng trao thân cho đĩ điếm,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.321Z",
      "updatedAt": "2025-09-03T02:49:26.321Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "a8e87b4b-eb9d-4a48-8201-2e5e906cf130",
      "text": "kẻo con phải khuynh gia bại sản.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.349Z",
      "updatedAt": "2025-09-03T02:49:26.349Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "2a288161-aca7-4ae1-83fd-ccba510c93f6",
      "text": "Ngoài đường phố, mắt đừng láo liên,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.363Z",
      "updatedAt": "2025-09-03T02:49:26.363Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "a0aaeb43-3ae7-4e5b-a998-228467750638",
      "text": "trong ngõ hẻm, chớ có la cà.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.377Z",
      "updatedAt": "2025-09-03T02:49:26.377Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "737a7c2b-1935-4200-accf-04faa317ed97",
      "text": "Hãy tránh đừng nhìn người phụ nữ nhan sắc,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.391Z",
      "updatedAt": "2025-09-03T02:49:26.391Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "7829549e-9fda-44e1-9698-881de7a568c4",
      "text": "cũng đừng ngắm nghía một giai nhân xa lạ.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.419Z",
      "updatedAt": "2025-09-03T02:49:26.419Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "327f943c-1d75-456e-9604-a6f9a5237f60",
      "text": "Vì sắc đẹp đàn bà mà bao kẻ đảo điên,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.433Z",
      "updatedAt": "2025-09-03T02:49:26.433Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "3e1d56aa-cc0f-40f1-83e9-4c7482f05073",
      "text": "cũng vì thế mà ái tình bừng lên như lửa.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 3,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.450Z",
      "updatedAt": "2025-09-03T02:49:26.450Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "2e744768-e311-4bae-93af-e48629d33a44",
      "text": "Chớ ngồi bên người phụ nữ có chồng,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.464Z",
      "updatedAt": "2025-09-03T02:49:26.464Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "94aaafbb-b0e2-483d-bbbd-3851a63505b0",
      "text": "đừng uống rượu với nàng trong các bữa tiệc,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.478Z",
      "updatedAt": "2025-09-03T02:49:26.478Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "7a616a37-3cdc-49bf-8613-40363c2db8b3",
      "text": "kẻo vì nàng mà lòng con nghiêng ngửa,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.491Z",
      "updatedAt": "2025-09-03T02:49:26.491Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "956ed3fd-8cb6-4894-8609-b2c9733ab7f7",
      "text": "và tâm thần chao đảo tiêu vong.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 3,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.506Z",
      "updatedAt": "2025-09-03T02:49:26.506Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "39b621f9-df6a-43df-9d5e-cf34f6af1805",
      "text": "Đừng bỏ rơi người bạn cố tri :",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.520Z",
      "updatedAt": "2025-09-03T02:49:26.520Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "8423bd7c-121e-4bd8-86ac-e2f08d4e4129",
      "text": "người mới đâu có giá bằng người cũ.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.546Z",
      "updatedAt": "2025-09-03T02:49:26.546Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "738b6350-4feb-4c57-acbe-f081dd74cc87",
      "text": "Rượu mới thế nào, thì bạn mới cũng vậy ;",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.560Z",
      "updatedAt": "2025-09-03T02:49:26.560Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "3272321a-1f5c-4173-9c36-8b99062219a5",
      "text": "để lâu rồi uống, mới thấy ngon.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 3,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.574Z",
      "updatedAt": "2025-09-03T02:49:26.574Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "cbfafe67-745c-45c4-a348-1e558ab9cf3b",
      "text": "Chớ ghen với người tội lỗi được vinh dự,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.588Z",
      "updatedAt": "2025-09-03T02:49:26.588Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "28d32104-a11a-4bc2-a6ba-b4e5144d8e74",
      "text": "vì con chẳng biết hậu vận nó thế nào.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.616Z",
      "updatedAt": "2025-09-03T02:49:26.616Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "0565e4df-06c3-4300-8b67-b82c367c470d",
      "text": "Đừng vui niềm vui của quân vô đạo ;",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.629Z",
      "updatedAt": "2025-09-03T02:49:26.629Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "b9edc387-99c3-463a-bc63-49d0bd1ba971",
      "text": "hãy nhớ rằng : chúng sẽ phải đền tội trước khi xuống âm ty.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.643Z",
      "updatedAt": "2025-09-03T02:49:26.643Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "53bb5835-6fbd-4706-a286-5211dddb497b",
      "text": "Hãy đứng xa người nắm quyền sinh sát,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.671Z",
      "updatedAt": "2025-09-03T02:49:26.671Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "da9d7c1d-35f0-4393-8b7c-c25527b451df",
      "text": "thì con sẽ không còn cảm thấy sợ tử thần.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.685Z",
      "updatedAt": "2025-09-03T02:49:26.685Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "f00c0515-9bad-4827-a9fc-f89c0758b60d",
      "text": "Nếu đến gần nó, thì đừng bất cẩn,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.699Z",
      "updatedAt": "2025-09-03T02:49:26.699Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "c2a4d511-5612-4952-a030-b8188915957a",
      "text": "kẻo nó lại cướp mất mạng con.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 3,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.714Z",
      "updatedAt": "2025-09-03T02:49:26.714Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "83bc5c60-16ae-450f-838e-91fcaeb5525f",
      "text": "Hãy nhớ rằng con đang bước qua giữa bao cạm bẫy,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 4,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.727Z",
      "updatedAt": "2025-09-03T02:49:26.727Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "1bb559cd-69e8-4f96-8247-c03c2c8d91a5",
      "text": "và đi lại trên tường thành đầy lỗ châu mai.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 5,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.742Z",
      "updatedAt": "2025-09-03T02:49:26.742Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "a7a81c7d-05a5-48e1-bf87-80502f4f4a76",
      "text": "Hãy giao tiếp với người chung quanh khi có thể,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.771Z",
      "updatedAt": "2025-09-03T02:49:26.771Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "2622f39a-2fe4-463b-900e-8230cfea80cb",
      "text": "và năng bàn hỏi với người khôn ngoan.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.788Z",
      "updatedAt": "2025-09-03T02:49:26.788Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "bfbb178f-2b2c-49a3-b6c0-d8aafefaca25",
      "text": "Hãy tìm người hiểu biết mà trò chuyện,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.817Z",
      "updatedAt": "2025-09-03T02:49:26.817Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "5295bcfa-e91d-443d-9afd-d25ac88ab24f",
      "text": "và mọi điều con nói phải quy về Luật của Đấng Tối Cao.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.830Z",
      "updatedAt": "2025-09-03T02:49:26.830Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "079b9b4c-d71f-40ad-bfda-5ba3356a3d43",
      "text": "Đồng bàn với con phải là những người công chính,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.858Z",
      "updatedAt": "2025-09-03T02:49:26.858Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "a012fba8-9e52-46ee-8202-de646fcf59dc",
      "text": "và lòng kính sợ Đức Chúa sẽ là niềm hãnh diện của con.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.873Z",
      "updatedAt": "2025-09-03T02:49:26.873Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "8ce93afa-966e-490b-8e33-ac1acd25fb27",
      "text": "Một tác phẩm được ca tụng là nhờ tay nghệ sĩ,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.901Z",
      "updatedAt": "2025-09-03T02:49:26.901Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "c5b8bb20-d279-43a5-a9d1-31e7e9e75d1f",
      "text": "ai lãnh đạo dân thì phải khôn ngoan trong lời ăn tiếng nói.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.915Z",
      "updatedAt": "2025-09-03T02:49:26.915Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "96b1adcd-cd84-4de9-8d28-11855fb4700e",
      "text": "Kẻ lắm mồm lắm miệng, trong thành ai cũng ngán cũng sợ,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.943Z",
      "updatedAt": "2025-09-03T02:49:26.943Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    },
    {
      "id": "6e1a153a-7283-420d-9b04-72572bd1d2ba",
      "text": "người nói năng láu táu, ai cũng ghét cũng chê.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:49:26.970Z",
      "updatedAt": "2025-09-03T02:49:26.970Z",
      "chapterId": "bced09d7-3767-484a-940a-a1af1cce12fe"
    }
  ],
