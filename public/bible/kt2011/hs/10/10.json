  "headings": [
    {
      "id": "ad3638ad-1593-4c6c-857f-a5f23632a8d2",
      "text": "Ngẫu tượng Ít-ra-en thờ sẽ bị phá huỷ",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:21:39.306Z",
      "updatedAt": "2025-09-03T03:21:39.306Z",
      "verseId": "f46db539-d0c2-4361-a414-3a8775863486",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "87f40281-f5e7-46af-abb1-5c02ac664f74",
      "text": "Ít-ra-en đã không đáp ứng điều ĐỨC CHÚA chờ đợi",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:21:40.192Z",
