{
  "chapter": {
    "id": "eb854a68-69b1-414c-aa03-73b1f6d2154a",
    "number": 10,
    "createdAt": "2025-09-03T01:07:51.809Z",
    "updatedAt": "2025-09-03T01:07:51.809Z",
    "bookId": "11aabdfa-f668-4d41-962c-372a8b9257be"
  },
  "verses": [
    {
      "id": "f46db539-d0c2-4361-a414-3a8775863486",
      "text": "Ít-ra-en vốn là một cây nho sum sê,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:39.289Z",
      "updatedAt": "2025-09-03T03:21:39.289Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "844991c0-c8bd-449d-90a9-73947dff41ee",
      "text": "trái trăng thật dồi dào phong phú.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:39.366Z",
      "updatedAt": "2025-09-03T03:21:39.366Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "31fa1c91-88fa-4ccb-a7d5-c48efcf3e417",
      "text": "Nhưng trái trăng càng nhiều,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:39.380Z",
      "updatedAt": "2025-09-03T03:21:39.380Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "a9d22148-461e-4d62-8fa2-e41169336ad0",
      "text": "chúng càng dựng thêm các bàn thờ ngẫu tượng ;",
      "label": "1",
      "number": 1,
      "subVerseIndex": 3,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:39.408Z",
      "updatedAt": "2025-09-03T03:21:39.408Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "6ba926b9-6a29-4843-af08-e735c4354dbd",
      "text": "đất nước càng giàu sang,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 4,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:39.423Z",
      "updatedAt": "2025-09-03T03:21:39.423Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "73ba2ecf-b322-4fb6-a875-726e9e548ef3",
      "text": "chúng càng làm thêm những trụ thần lộng lẫy.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 5,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:39.437Z",
      "updatedAt": "2025-09-03T03:21:39.437Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "1f727233-7784-4595-9a8b-1c51a96f424e",
      "text": "Chúng là thứ người lòng một dạ hai,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:39.464Z",
      "updatedAt": "2025-09-03T03:21:39.464Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "ba9b3513-d776-4aa6-ac00-420e3f396d4f",
      "text": "rồi đây chúng sẽ phải đền tội ;",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:39.478Z",
      "updatedAt": "2025-09-03T03:21:39.478Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "07a8461d-6180-4f5a-a049-08b1d02137de",
      "text": "bàn thờ của chúng, chính Người sẽ đập tan,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:39.492Z",
      "updatedAt": "2025-09-03T03:21:39.492Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "5ec8fdc9-b323-4f79-b0be-91fb31ae0d0d",
      "text": "trụ thần của chúng, Người cũng sẽ phá đổ.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 3,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:39.506Z",
      "updatedAt": "2025-09-03T03:21:39.506Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "9e77150d-0471-46b7-b547-4c49b4fdcb3a",
      "text": "Bây giờ chúng lại nói : “Chúng tôi không có vua.”",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:39.520Z",
      "updatedAt": "2025-09-03T03:21:39.520Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "263dd5e9-ce06-464e-be2b-c40d9f1440b5",
      "text": "Vì ĐỨC CHÚA, chúng còn không kính sợ,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:39.534Z",
      "updatedAt": "2025-09-03T03:21:39.534Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "878327cd-3ab2-4ad6-a298-85620ab9e065",
      "text": "thì nếu có vua, liệu ông làm gì được cho chúng ?",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:39.562Z",
      "updatedAt": "2025-09-03T03:21:39.562Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "1bca1901-dc4f-47a4-9c2a-1d332b20b08a",
      "text": "Chúng ăn nói ba hoa, thề gian thề dối, thoả hiệp với mọi người,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:39.577Z",
      "updatedAt": "2025-09-03T03:21:39.577Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "42a87299-d8c8-44dc-bed9-88005c9d9aa8",
      "text": "biến luật pháp nên như cây độc hại tươi tốt trên nương đồng.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:39.592Z",
      "updatedAt": "2025-09-03T03:21:39.592Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "d44d2f0a-637a-4a14-b3e0-a21517e95f23",
      "text": "Đứng trước con bò của Bết A-ven, dân cư Sa-ma-ri run sợ.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:39.626Z",
      "updatedAt": "2025-09-03T03:21:39.626Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "82d5fc1f-2a1c-48ef-99d9-8738a6078c7c",
      "text": "Quả thật, dân của nó để tang nó,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:39.682Z",
      "updatedAt": "2025-09-03T03:21:39.682Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "9715a1ef-9045-4b6b-9b39-a3374457d5c6",
      "text": "bọn tư tế bất hợp pháp cũng vậy.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:39.697Z",
      "updatedAt": "2025-09-03T03:21:39.697Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "8fb34efc-0351-4c37-819f-f7d10c11375b",
      "text": "Chúng cứ vui mừng vì vinh quang của nó đi,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 3,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:39.711Z",
      "updatedAt": "2025-09-03T03:21:39.711Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "7223c482-5bf0-48d9-9add-e4dd983d258a",
      "text": "bởi giờ đây vinh quang ấy đã bị đẩy xa rồi.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 4,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:39.725Z",
      "updatedAt": "2025-09-03T03:21:39.725Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "62ecb854-1b64-4c15-b91a-558c94d66ded",
      "text": "Nó cũng bị đưa sang Át-sua làm lễ vật triều cống cho vua cả.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:39.754Z",
      "updatedAt": "2025-09-03T03:21:39.754Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "73dab8a1-3fd1-4069-9c29-823127d7ddc8",
      "text": "Ép-ra-im sẽ chuốc lấy nhuốc nhơ,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:39.796Z",
      "updatedAt": "2025-09-03T03:21:39.796Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "e8eb3ff5-6bbb-4cc0-8ede-5fc92d73aa36",
      "text": "Ít-ra-en phải hổ thẹn về những điều mình suy tính.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:39.824Z",
      "updatedAt": "2025-09-03T03:21:39.824Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "b859d3db-977d-458b-9ea7-5faf24234e98",
      "text": "Thế là Sa-ma-ri tiêu tùng.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:39.852Z",
      "updatedAt": "2025-09-03T03:21:39.852Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "a3f83480-6bc7-418f-b8d9-a8f1618a52ad",
      "text": "Vua của nó tựa hồ mảnh ván trôi dạt trên mặt nước.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:39.879Z",
      "updatedAt": "2025-09-03T03:21:39.879Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "47408447-9fd4-416b-8708-35be866cd053",
      "text": "Các nơi cao của A-ven sẽ bị phá huỷ, đó là tội của Ít-ra-en.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:39.892Z",
      "updatedAt": "2025-09-03T03:21:39.892Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "ed7994bd-e45b-4552-9d73-91b3bb1ac50d",
      "text": "Gai góc sẽ leo lên các bàn thờ của nó.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:39.948Z",
      "updatedAt": "2025-09-03T03:21:39.948Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "1e303441-2582-45fe-97a0-058ed41fae6d",
      "text": "Bấy giờ chúng sẽ nói với núi đồi : “Phủ lấp chúng tôi đi !”",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:39.962Z",
      "updatedAt": "2025-09-03T03:21:39.962Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "1e1e8b0e-b43f-4d9f-af64-519c548f87f2",
      "text": "và với gò nổng : “Hãy đổ xuống trên chúng tôi !”",
      "label": "8",
      "number": 8,
      "subVerseIndex": 3,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:39.990Z",
      "updatedAt": "2025-09-03T03:21:39.990Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "1f19233c-d394-4b52-8c04-896618f4e204",
      "text": "Hỡi Ít-ra-en, từ những ngày ở Ghíp-a, ngươi đã phạm tội.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:40.004Z",
      "updatedAt": "2025-09-03T03:21:40.004Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "39045aff-25ae-4615-9b8e-17da0d086760",
      "text": "Ngày nay vẫn chứng nào tật ấy, như thể tại Ghíp-a xưa",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:40.063Z",
      "updatedAt": "2025-09-03T03:21:40.063Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "bd6b0723-8ed2-41e4-b460-1296bffcb80d",
      "text": "chiến tranh đã không đụng tới những kẻ gian ác.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:40.094Z",
      "updatedAt": "2025-09-03T03:21:40.094Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "ef704913-0ad3-42df-9d5c-5843aa6142b9",
      "text": "Ta sẽ đến và sửa trị chúng.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:40.108Z",
      "updatedAt": "2025-09-03T03:21:40.108Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "88dfbb17-32a3-4b64-825b-84f24fb56ded",
      "text": "Các dân sẽ tập hợp chống lại chúng,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:40.122Z",
      "updatedAt": "2025-09-03T03:21:40.122Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "bb4ec1f5-b2be-4a75-aef7-6edf4312047d",
      "text": "khi chúng bị sửa trị về hai tội ác chúng đã phạm.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:40.136Z",
      "updatedAt": "2025-09-03T03:21:40.136Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "40bb9ac8-f9ae-43a2-8a43-541ef76b9ac5",
      "text": "Ép-ra-im là con bê thuần thục, ưa đạp lúa,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:40.178Z",
      "updatedAt": "2025-09-03T03:21:40.178Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "e26c27c6-4500-4fa8-a918-eeac9cdc6b93",
      "text": "và Ta, Ta sẽ luồn cái ách vào cổ xinh đẹp của nó !",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:40.263Z",
      "updatedAt": "2025-09-03T03:21:40.263Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "6e16ef26-35a7-4a55-81b3-f697e560b36d",
      "text": "Ta sẽ đặt ách cho Ép-ra-im,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:40.291Z",
      "updatedAt": "2025-09-03T03:21:40.291Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "79fc288a-c7ba-4816-989a-914fd0a8c3c8",
      "text": "Giu-đa sẽ kéo cày, Gia-cóp sẽ kéo bừa.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 3,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:40.320Z",
      "updatedAt": "2025-09-03T03:21:40.320Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "8232ddd0-bc28-462c-8965-12d4116c3f40",
      "text": "Hãy gieo công chính, rồi sẽ gặt được tình thương.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:40.362Z",
      "updatedAt": "2025-09-03T03:21:40.362Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "ee1141e4-5f4f-49f5-8878-6b029c2075e5",
      "text": "Hãy khai khẩn đất hoang ;",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:40.389Z",
      "updatedAt": "2025-09-03T03:21:40.389Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "536ab555-9c25-4a02-beed-90f1d8b8e7fc",
      "text": "đây là thời kiếm tìm ĐỨC CHÚA",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:40.416Z",
      "updatedAt": "2025-09-03T03:21:40.416Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "5546bf8e-1fa6-4da6-96e4-d163ae4ed960",
      "text": "cho đến khi Người đến làm mưa công chính trên các ngươi.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 3,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:40.444Z",
      "updatedAt": "2025-09-03T03:21:40.444Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "9d538ca8-0745-473f-ba6a-0f01ef0d5a05",
      "text": "Các ngươi đã gieo tội ác, gặt sự bất công, ăn hoa quả dối trá.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:40.458Z",
      "updatedAt": "2025-09-03T03:21:40.458Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "bf037944-4676-46bf-8a9b-ef4403d562d7",
      "text": "Vì ngươi cậy có chiến xa và nhiều dũng sĩ,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:40.472Z",
      "updatedAt": "2025-09-03T03:21:40.472Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "dbcf5171-77ed-42f4-b941-fdbc7dc62972",
      "text": "thì náo loạn sẽ nổi lên trong dân ngươi.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:40.503Z",
      "updatedAt": "2025-09-03T03:21:40.503Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "c630c133-2798-4a87-9228-a6ee7f7205e0",
      "text": "Tất cả các pháo đài của ngươi đều bị phá huỷ,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:40.518Z",
      "updatedAt": "2025-09-03T03:21:40.518Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "0c626664-73ca-4fca-b9d4-c770f904f542",
      "text": "như San-man phá huỷ Bết Ác-vên,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 2,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:40.532Z",
      "updatedAt": "2025-09-03T03:21:40.532Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "2ca52cc4-c67c-499f-8e0b-99733369a384",
      "text": "trong ngày có giao tranh, khi cả mẹ lẫn con đều bị đập tan xác.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 3,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:40.587Z",
      "updatedAt": "2025-09-03T03:21:40.587Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "5e437127-d395-4461-9e12-795f6fc1a836",
      "text": "Bết Ên đã gây ra cho các ngươi như thế đó",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:40.615Z",
      "updatedAt": "2025-09-03T03:21:40.615Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "fac9966f-2c6e-473b-b198-0cb9ff9c062c",
      "text": "vì tội ác nặng nề của các ngươi ;",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:40.629Z",
      "updatedAt": "2025-09-03T03:21:40.629Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    },
    {
      "id": "1808155b-6b36-4963-8d4a-cc6d8451ad17",
      "text": "ngay từ rạng đông chắc chắn vua Ít-ra-en sẽ bị rồi đời !",
      "label": "15",
      "number": 15,
      "subVerseIndex": 2,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:40.643Z",
      "updatedAt": "2025-09-03T03:21:40.643Z",
      "chapterId": "eb854a68-69b1-414c-aa03-73b1f6d2154a"
    }
  ],
