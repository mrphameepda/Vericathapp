{
  "chapter": {
    "id": "e6fad58b-8af7-48fe-8bd9-12d95ba33cbc",
    "number": 11,
    "createdAt": "2025-09-03T01:07:51.809Z",
    "updatedAt": "2025-09-03T01:07:51.809Z",
    "bookId": "11aabdfa-f668-4d41-962c-372a8b9257be"
  },
  "verses": [
    {
      "id": "2f658846-7da4-4e60-b8bd-da9da06b9efe",
      "text": "Khi Ít-ra-en còn là đứa trẻ, Ta đã yêu nó,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:46.374Z",
      "updatedAt": "2025-09-03T03:21:46.374Z",
      "chapterId": "e6fad58b-8af7-48fe-8bd9-12d95ba33cbc"
    },
    {
      "id": "9707f3bc-1c1b-4003-90b6-a6e13ee704ed",
      "text": "từ Ai-cập Ta đã gọi con Ta về.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:46.457Z",
      "updatedAt": "2025-09-03T03:21:46.457Z",
      "chapterId": "e6fad58b-8af7-48fe-8bd9-12d95ba33cbc"
    },
    {
      "id": "b2b48bb4-ca22-43d2-a5d6-08f6896e16a6",
      "text": "Nhưng Ta càng gọi chúng, chúng càng bỏ đi ;",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:46.513Z",
      "updatedAt": "2025-09-03T03:21:46.513Z",
      "chapterId": "e6fad58b-8af7-48fe-8bd9-12d95ba33cbc"
    },
    {
      "id": "7d09dd79-04d0-4837-82f7-e31f9a181583",
      "text": "chúng dâng hy lễ cho các Ba-an, đốt hương kính ngẫu tượng.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:46.529Z",
      "updatedAt": "2025-09-03T03:21:46.529Z",
      "chapterId": "e6fad58b-8af7-48fe-8bd9-12d95ba33cbc"
    },
    {
      "id": "0e066d90-463f-45bb-8da5-c0ba0a8ce168",
      "text": "Ta đã tập đi cho Ép-ra-im, đã đỡ cánh tay nó,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:46.558Z",
      "updatedAt": "2025-09-03T03:21:46.558Z",
      "chapterId": "e6fad58b-8af7-48fe-8bd9-12d95ba33cbc"
    },
    {
      "id": "20f78a8a-e360-4a5e-8fb0-2b2177ddbff2",
      "text": "nhưng chúng không hiểu là Ta chữa lành chúng.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:46.600Z",
      "updatedAt": "2025-09-03T03:21:46.600Z",
      "chapterId": "e6fad58b-8af7-48fe-8bd9-12d95ba33cbc"
    },
    {
      "id": "82e00f37-0f06-4d76-a8c8-dfff050fc9b1",
      "text": "Ta lấy dây nhân nghĩa, lấy mối ân tình mà lôi kéo chúng.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:46.614Z",
      "updatedAt": "2025-09-03T03:21:46.614Z",
      "chapterId": "e6fad58b-8af7-48fe-8bd9-12d95ba33cbc"
    },
    {
      "id": "216aa1f2-85bb-49f5-8011-5f85a804c5bb",
      "text": "Ta xử với chúng như người nựng trẻ thơ, nâng lên áp vào má ;",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:46.627Z",
      "updatedAt": "2025-09-03T03:21:46.627Z",
      "chapterId": "e6fad58b-8af7-48fe-8bd9-12d95ba33cbc"
    },
    {
      "id": "b43ac599-4669-4fc5-a364-90041d6147b1",
      "text": "Ta cúi xuống gần nó mà đút cho nó ăn.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:46.642Z",
      "updatedAt": "2025-09-03T03:21:46.642Z",
      "chapterId": "e6fad58b-8af7-48fe-8bd9-12d95ba33cbc"
    },
    {
      "id": "19a5c463-9a9a-477f-91e2-9f183ad38486",
      "text": "Nó sẽ không trở về Ai-cập nữa,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:46.683Z",
      "updatedAt": "2025-09-03T03:21:46.683Z",
      "chapterId": "e6fad58b-8af7-48fe-8bd9-12d95ba33cbc"
    },
    {
      "id": "d3519f46-423a-4d5f-a86d-7f125437276c",
      "text": "nhưng Át-sua sẽ lại làm vua nó, vì nó không chịu về với Ta.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:46.727Z",
      "updatedAt": "2025-09-03T03:21:46.727Z",
      "chapterId": "e6fad58b-8af7-48fe-8bd9-12d95ba33cbc"
    },
    {
      "id": "baa25dd5-37d2-4c48-98b0-839e612c98db",
      "text": "Gươm đao sẽ hoành hành trong các thành của nó,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:46.770Z",
      "updatedAt": "2025-09-03T03:21:46.770Z",
      "chapterId": "e6fad58b-8af7-48fe-8bd9-12d95ba33cbc"
    },
    {
      "id": "9581c2c7-5f8f-44bc-adaf-a58bee62f8c7",
      "text": "sẽ làm cỏ và ngốn sạch con cái nó, vì chúng có những ý đồ xấu xa.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:46.784Z",
      "updatedAt": "2025-09-03T03:21:46.784Z",
      "chapterId": "e6fad58b-8af7-48fe-8bd9-12d95ba33cbc"
    },
    {
      "id": "37f85c38-1d66-4c21-920a-03cac310b863",
      "text": "Dân Ta cứ miệt mài buông theo bội tín,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:46.798Z",
      "updatedAt": "2025-09-03T03:21:46.798Z",
      "chapterId": "e6fad58b-8af7-48fe-8bd9-12d95ba33cbc"
    },
    {
      "id": "1e984e62-1f2f-425e-959d-10d42aac882b",
      "text": "chúng được kêu mời hãy vươn lên,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:46.841Z",
      "updatedAt": "2025-09-03T03:21:46.841Z",
      "chapterId": "e6fad58b-8af7-48fe-8bd9-12d95ba33cbc"
    },
    {
      "id": "801e712a-5231-4f09-83c4-99ce6c36aa8c",
      "text": "mà chẳng một ai ngóc đầu dậy !",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:46.875Z",
      "updatedAt": "2025-09-03T03:21:46.875Z",
      "chapterId": "e6fad58b-8af7-48fe-8bd9-12d95ba33cbc"
    },
    {
      "id": "b0f5ca15-7111-4824-94a6-cf2cb0840eca",
      "text": "Hỡi Ép-ra-im, Ta từ chối ngươi sao nổi !",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:46.889Z",
      "updatedAt": "2025-09-03T03:21:46.889Z",
      "chapterId": "e6fad58b-8af7-48fe-8bd9-12d95ba33cbc"
    },
    {
      "id": "9f71ed67-2266-44b1-864c-7b304b1501fe",
      "text": "Hỡi Ít-ra-en, Ta trao nộp ngươi sao đành !",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:46.918Z",
      "updatedAt": "2025-09-03T03:21:46.918Z",
      "chapterId": "e6fad58b-8af7-48fe-8bd9-12d95ba33cbc"
    },
    {
      "id": "caa5fe26-6b8d-408c-a8df-5d2b84b59917",
      "text": "Làm sao Ta xử với ngươi như với Át-ma,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:46.945Z",
      "updatedAt": "2025-09-03T03:21:46.945Z",
      "chapterId": "e6fad58b-8af7-48fe-8bd9-12d95ba33cbc"
    },
    {
      "id": "70878c5c-0f0b-4e51-b8b5-a4cb28f8a1f1",
      "text": "để ngươi nên giống như Xơ-vô-gim được ?",
      "label": "8",
      "number": 8,
      "subVerseIndex": 3,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:46.973Z",
      "updatedAt": "2025-09-03T03:21:46.973Z",
      "chapterId": "e6fad58b-8af7-48fe-8bd9-12d95ba33cbc"
    },
    {
      "id": "a983a147-7544-4cf5-996d-ff0c20fa53d5",
      "text": "Trái tim Ta thổn thức, ruột gan Ta bồi hồi.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 4,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:47.016Z",
      "updatedAt": "2025-09-03T03:21:47.016Z",
      "chapterId": "e6fad58b-8af7-48fe-8bd9-12d95ba33cbc"
    },
    {
      "id": "e98bd4e9-c7ce-4750-ac85-3fd5984805cf",
      "text": "Ta sẽ không hành động theo cơn nóng giận,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:47.048Z",
      "updatedAt": "2025-09-03T03:21:47.048Z",
      "chapterId": "e6fad58b-8af7-48fe-8bd9-12d95ba33cbc"
    },
    {
      "id": "c94992df-cbaa-4a09-ac79-517e1aa52a32",
      "text": "sẽ không tiêu diệt Ép-ra-im nữa,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:47.062Z",
      "updatedAt": "2025-09-03T03:21:47.062Z",
      "chapterId": "e6fad58b-8af7-48fe-8bd9-12d95ba33cbc"
    },
    {
      "id": "15b65c65-3bea-4d99-9aab-ed6f96109dfa",
      "text": "vì Ta là Thiên Chúa, chứ không phải người phàm.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:47.090Z",
      "updatedAt": "2025-09-03T03:21:47.090Z",
      "chapterId": "e6fad58b-8af7-48fe-8bd9-12d95ba33cbc"
    },
    {
      "id": "e1fa74ae-0bce-403e-a889-1bd626c4bb98",
      "text": "Ở giữa ngươi, Ta là Đấng Thánh,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 3,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:47.118Z",
      "updatedAt": "2025-09-03T03:21:47.118Z",
      "chapterId": "e6fad58b-8af7-48fe-8bd9-12d95ba33cbc"
    },
    {
      "id": "2f9ac476-00f3-4e8e-9fca-c8e38a319f3a",
      "text": "và Ta sẽ không đến trong cơn thịnh nộ.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 4,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:47.147Z",
      "updatedAt": "2025-09-03T03:21:47.147Z",
      "chapterId": "e6fad58b-8af7-48fe-8bd9-12d95ba33cbc"
    },
    {
      "id": "18d5ced6-7115-4df5-ba37-909a655b658f",
      "text": "Chúng sẽ bước theo ĐỨC CHÚA.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:47.167Z",
      "updatedAt": "2025-09-03T03:21:47.167Z",
      "chapterId": "e6fad58b-8af7-48fe-8bd9-12d95ba33cbc"
    },
    {
      "id": "b0bee101-2821-4b2c-a864-fb8cd58076f2",
      "text": "Người sẽ rống lên như sư tử.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:47.209Z",
      "updatedAt": "2025-09-03T03:21:47.209Z",
      "chapterId": "e6fad58b-8af7-48fe-8bd9-12d95ba33cbc"
    },
    {
      "id": "1b0ad971-e070-422a-b43c-00575ce61198",
      "text": "Quả thật, Người sẽ rống lên,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:47.244Z",
      "updatedAt": "2025-09-03T03:21:47.244Z",
      "chapterId": "e6fad58b-8af7-48fe-8bd9-12d95ba33cbc"
    },
    {
      "id": "68bf9765-1b71-41fa-8362-5a2d0426394c",
      "text": "và từ phía tây, con cái sẽ vui mừng chạy tới.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 3,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:47.258Z",
      "updatedAt": "2025-09-03T03:21:47.258Z",
      "chapterId": "e6fad58b-8af7-48fe-8bd9-12d95ba33cbc"
    },
    {
      "id": "c4f72f59-5b8a-4ce0-a5b2-9e36ab776234",
      "text": "Chúng sẽ chạy tới lẹ như chim từ Ai-cập,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:47.273Z",
      "updatedAt": "2025-09-03T03:21:47.273Z",
      "chapterId": "e6fad58b-8af7-48fe-8bd9-12d95ba33cbc"
    },
    {
      "id": "f25e5ab9-00bf-47c9-9962-050a24b89c1a",
      "text": "như bồ câu từ đất Át-sua,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:47.301Z",
      "updatedAt": "2025-09-03T03:21:47.301Z",
      "chapterId": "e6fad58b-8af7-48fe-8bd9-12d95ba33cbc"
    },
    {
      "id": "56b08b81-2446-4aa0-997d-bc3f6bf9090f",
      "text": "và Ta sẽ cho chúng cư ngụ trong nhà của chúng,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:47.328Z",
      "updatedAt": "2025-09-03T03:21:47.328Z",
      "chapterId": "e6fad58b-8af7-48fe-8bd9-12d95ba33cbc"
    },
    {
      "id": "3e5692a3-96c0-4337-984c-23dbddb67d95",
      "text": "– sấm ngôn của ĐỨC CHÚA.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 3,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:47.343Z",
      "updatedAt": "2025-09-03T03:21:47.343Z",
      "chapterId": "e6fad58b-8af7-48fe-8bd9-12d95ba33cbc"
    }
  ],
