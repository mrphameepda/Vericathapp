{
  "chapter": {
    "id": "d72de577-d74d-449c-b044-35ce1b14979f",
    "number": 13,
    "createdAt": "2025-09-03T01:07:51.809Z",
    "updatedAt": "2025-09-03T01:07:51.809Z",
    "bookId": "11aabdfa-f668-4d41-962c-372a8b9257be"
  },
  "verses": [
    {
      "id": "12b6073a-f1bb-469c-97bd-e095fdd7cb31",
      "text": "Xưa kia hễ Ép-ra-im lên tiếng là nó gây kinh hoàng,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:00.001Z",
      "updatedAt": "2025-09-03T03:22:00.001Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "265cbc3c-ee1a-4373-90f5-4845c0112536",
      "text": "nó có một địa vị cao trong Ít-ra-en,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:00.043Z",
      "updatedAt": "2025-09-03T03:22:00.043Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "7e309844-9eed-463b-9e24-dfb3bdf88bce",
      "text": "nhưng vì mắc tội thờ Ba-an nên nó đã chết.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:00.067Z",
      "updatedAt": "2025-09-03T03:22:00.067Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "ebbf27ba-a91f-4765-9535-3a5cc17b0456",
      "text": "Giờ đây chúng phạm thêm tội lỗi :",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:00.094Z",
      "updatedAt": "2025-09-03T03:22:00.094Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "a3e45285-8819-4f3e-9ad1-ae0ec8f26be7",
      "text": "đúc cho mình những tượng bằng kim loại,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:00.108Z",
      "updatedAt": "2025-09-03T03:22:00.108Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "4bf235fe-bc7d-45a5-9401-30893f797dd1",
      "text": "lấy bạc làm ra những tượng thần như trí mình sáng chế.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:00.123Z",
      "updatedAt": "2025-09-03T03:22:00.123Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "58fa6a46-0a16-4a70-86a4-80465c4ed46d",
      "text": "Tất cả những thứ đó đều là sản phẩm do tay thợ làm ra.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 3,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:00.137Z",
      "updatedAt": "2025-09-03T03:22:00.137Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "60903ec5-8461-460e-a808-139bbdcf936d",
      "text": "Rồi chúng ngỏ lời với những thần đó, còn dâng hy lễ nữa.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 4,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:00.166Z",
      "updatedAt": "2025-09-03T03:22:00.166Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "2771b083-adbe-4b7f-b844-42662c318a17",
      "text": "Chúng là người mà lại hôn kính những con bê.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 5,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:00.193Z",
      "updatedAt": "2025-09-03T03:22:00.193Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "6d8dd3e1-5d6a-43ca-bf0b-8b2610851751",
      "text": "Bởi vậy, chúng chỉ như đám mây buổi sáng,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:00.221Z",
      "updatedAt": "2025-09-03T03:22:00.221Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "23a78fcc-911c-41a7-9dbe-a25fc919822c",
      "text": "như sương mai chóng tan, như vỏ trấu bị cuốn khỏi sân lúa,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:00.250Z",
      "updatedAt": "2025-09-03T03:22:00.250Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "651bc511-3099-4690-a13a-00efbca6726a",
      "text": "như làn khói toả từ ống thông hơi.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:00.279Z",
      "updatedAt": "2025-09-03T03:22:00.279Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "46af9b95-0ffc-41f0-8bf4-51fefff8184c",
      "text": "Ta là ĐỨC CHÚA, Thiên Chúa của ngươi",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:00.295Z",
      "updatedAt": "2025-09-03T03:22:00.295Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "0fa8a904-fc38-4f0c-b372-bfae904d1c20",
      "text": "từ khi ngươi còn ở đất Ai-cập.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:00.350Z",
      "updatedAt": "2025-09-03T03:22:00.350Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "a74e03e7-4cec-4ff4-993f-dad613bdb32e",
      "text": "Ngoài Ta ra, ngươi không được biết thần nào khác,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:00.382Z",
      "updatedAt": "2025-09-03T03:22:00.382Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "0b2f9863-2997-42ab-8366-db8277ce6bd8",
      "text": "chẳng có vị cứu tinh nào khác ngoại trừ Ta.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 3,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:00.396Z",
      "updatedAt": "2025-09-03T03:22:00.396Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "fbc7dcb3-8701-451d-9b33-2566fd2fcbe7",
      "text": "Chính Ta đã biết ngươi khi ngươi còn ở trong sa mạc,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:00.423Z",
      "updatedAt": "2025-09-03T03:22:00.423Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "6fb9dbea-302a-4826-a474-776794d877db",
      "text": "trong vùng đất cằn cỗi khô khan.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:00.437Z",
      "updatedAt": "2025-09-03T03:22:00.437Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "bb071178-df8a-4a9e-8bc5-9da38844c982",
      "text": "Vừa khi ra đồng cỏ, chúng liền được ăn uống thoả thuê.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:00.451Z",
      "updatedAt": "2025-09-03T03:22:00.451Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "82267314-8809-4a12-bab7-fea2e53df67e",
      "text": "Nhưng khi thoả thuê rồi, chúng đâm ra tự cao tự đại.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:00.465Z",
      "updatedAt": "2025-09-03T03:22:00.465Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "540a9b87-b0f6-4185-b392-edb37c595fb1",
      "text": "Chính vì thế mà chúng đã quên Ta.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:00.493Z",
      "updatedAt": "2025-09-03T03:22:00.493Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "d4c024af-24e6-4755-9cdf-5ce20c9b551a",
      "text": "Nên đối với chúng, Ta khác nào sư tử,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:00.507Z",
      "updatedAt": "2025-09-03T03:22:00.507Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "4321817c-1734-44f0-a0a1-f267f4bed260",
      "text": "tựa con báo, Ta rình rập bên đường.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:00.535Z",
      "updatedAt": "2025-09-03T03:22:00.535Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "a4c4ad02-573a-4371-a598-4b6cb0537d30",
      "text": "Như gấu mất con, Ta chồm lên chúng,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:00.549Z",
      "updatedAt": "2025-09-03T03:22:00.549Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "5c3fcad3-04b1-4f33-a320-cc70d4ec5222",
      "text": "Ta xé chúng cho nát tan lồng ngực ;",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:00.578Z",
      "updatedAt": "2025-09-03T03:22:00.578Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "1bf7e283-cce9-47ae-95d7-818552f7d7f9",
      "text": "Ta ăn thịt chúng tại chỗ như sư tử cái,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:00.593Z",
      "updatedAt": "2025-09-03T03:22:00.593Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "5af8a173-688e-414d-aaa0-56085c746917",
      "text": "chúng sẽ bị mãnh thú ngoài đồng phanh thây.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 3,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:00.607Z",
      "updatedAt": "2025-09-03T03:22:00.607Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "2360c12e-3fba-4a1d-b138-0b2bb9cbb4ce",
      "text": "Ta sắp tiêu diệt ngươi, hỡi Ít-ra-en.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:00.621Z",
      "updatedAt": "2025-09-03T03:22:00.621Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "6a52dcd4-f533-45a3-9a88-9bd7d3f89173",
      "text": "Ai sẽ đến cứu ngươi ?",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:00.662Z",
      "updatedAt": "2025-09-03T03:22:00.662Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "c8febae3-ae6f-4e81-825c-c8ad39b3c845",
      "text": "Vua ngươi là người phải cứu ngươi",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:00.676Z",
      "updatedAt": "2025-09-03T03:22:00.676Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "a35b90a5-0cfc-4e9b-b5b9-d6525c864392",
      "text": "dù ngươi ở thành thị nào đi nữa,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:00.690Z",
      "updatedAt": "2025-09-03T03:22:00.690Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "2f2f272e-0ee4-4002-bbf6-024f3c2778b4",
      "text": "giờ đây vua ngươi ở đâu rồi ?",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:00.704Z",
      "updatedAt": "2025-09-03T03:22:00.704Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "03a2c021-64c5-4567-a447-6776976cb368",
      "text": "Các thẩm phán của ngươi, những kẻ xưa ngươi tìm đến ngỏ lời :",
      "label": "10",
      "number": 10,
      "subVerseIndex": 3,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:00.718Z",
      "updatedAt": "2025-09-03T03:22:00.718Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "7bbf34ee-44d4-460a-b00c-4df26c12479e",
      "text": "“Tôi muốn có vua, muốn có thủ lãnh, xin ban cho tôi đi !”",
      "label": "10",
      "number": 10,
      "subVerseIndex": 4,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:00.732Z",
      "updatedAt": "2025-09-03T03:22:00.732Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "ec3537fe-3d69-4ec4-b293-fb513f6adeff",
      "text": "Giờ đây các thẩm phán đó đâu rồi ?",
      "label": "10",
      "number": 10,
      "subVerseIndex": 5,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:00.761Z",
      "updatedAt": "2025-09-03T03:22:00.761Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "9ba1d603-8eca-4cf2-9a0c-80609d6937c7",
      "text": "Ta cho ngươi một ông vua trong cơn thịnh nộ,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:00.775Z",
      "updatedAt": "2025-09-03T03:22:00.775Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "3a2f813f-a0e4-4144-b711-57c887a71685",
      "text": "rồi lấy đi giữa trận lôi đình.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:00.803Z",
      "updatedAt": "2025-09-03T03:22:00.803Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "3840705c-f0ae-4800-ae04-89de7fce262d",
      "text": "Sự gian ác của Ép-ra-im được cuốn lại để dành,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:00.830Z",
      "updatedAt": "2025-09-03T03:22:00.830Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "7a3a6b0f-c718-4cd1-83fe-89946e4441ec",
      "text": "tội lỗi của nó được giữ kỹ.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:00.871Z",
      "updatedAt": "2025-09-03T03:22:00.871Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "6f55c79c-4206-4833-ad45-df1c5ddbf188",
      "text": "Nó sẽ đau quằn quại như sản phụ lâm bồn ;",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:00.897Z",
      "updatedAt": "2025-09-03T03:22:00.897Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "2f52f47d-22af-4614-bab6-592e84f0a286",
      "text": "nó là đứa con ngu dốt :",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:00.926Z",
      "updatedAt": "2025-09-03T03:22:00.926Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "0f501622-2a32-4d6c-8e57-bb2b7720d812",
      "text": "vì đã đến giờ mà không chịu rời lòng mẹ !",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:00.940Z",
      "updatedAt": "2025-09-03T03:22:00.940Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "e9c5a722-2fb4-4acc-82da-fb982380c173",
      "text": "Ta lại giải thoát nó khỏi quyền lực âm phủ sao,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:00.982Z",
      "updatedAt": "2025-09-03T03:22:00.982Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "2aedf330-6204-4263-ba7d-88dcbea41404",
      "text": "lại chuộc nó khỏi thần chết ư ?",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:00.999Z",
      "updatedAt": "2025-09-03T03:22:00.999Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "0257562c-6d6b-45bc-bd89-30f15d8f89b6",
      "text": "Tử khí ngươi đâu rồi, hỡi Thần Chết ?",
      "label": "14",
      "number": 14,
      "subVerseIndex": 2,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:01.031Z",
      "updatedAt": "2025-09-03T03:22:01.031Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "11ead0e7-163d-47f3-a3ff-251e8c7f7df8",
      "text": "Nọc độc của ngươi đâu, hỡi Âm ty ?",
      "label": "14",
      "number": 14,
      "subVerseIndex": 3,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:01.059Z",
      "updatedAt": "2025-09-03T03:22:01.059Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "de196cfe-fc56-4b26-9a43-6149ec0dc091",
      "text": "Ta nhắm mắt không còn thương xót nữa.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 4,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:01.088Z",
      "updatedAt": "2025-09-03T03:22:01.088Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "65cc5ce3-a77d-41a3-850d-05c14f540be7",
      "text": "Vì nó có sinh sôi nảy nở giữa anh em mình,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:01.102Z",
      "updatedAt": "2025-09-03T03:22:01.102Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "c211d0e1-c3f1-4c06-a99e-2dada97e30de",
      "text": "thì một cơn gió nóng như thiêu cũng sẽ đến,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:01.115Z",
      "updatedAt": "2025-09-03T03:22:01.115Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "1cb3055d-dbb1-480e-9c4b-1290ee374cec",
      "text": "gió của ĐỨC CHÚA thổi lên từ sa mạc khiến suối cạn, giếng khô.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 2,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:01.146Z",
      "updatedAt": "2025-09-03T03:22:01.146Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "24e4480c-c3b6-4946-9e26-361448668f0b",
      "text": "Cơn gió ấy sẽ cướp đi kho tàng, cuốn hết mọi bảo vật.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 3,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:01.189Z",
      "updatedAt": "2025-09-03T03:22:01.189Z",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    }
  ],
