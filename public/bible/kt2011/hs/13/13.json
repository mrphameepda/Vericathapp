    },
    {
      "id": "fa084547-b913-462e-8f5e-18cd6c0ea259",
      "content": "Đnl 32,15",
      "kind": "MARK_KIND_REFERENCE",
      "label": "8@",
      "sortOrder": 7,
      "startOffset": 38,
      "endOffset": 38,
      "createdAt": "2025-09-03T03:22:00.480Z",
      "updatedAt": "2025-09-03T03:22:00.480Z",
      "targetId": "82267314-8809-4a12-bab7-fea2e53df67e",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "d43629f7-1373-40ea-a229-090fe0fd64bd",
      "content": "Hình ảnh sản phụ phải quằn quại vì đau đớn khi sinh con được sử dụng để chỉ tai hoạ đe doạ dân (x. Tv 48,7 ; Is 13,8 ; 21,3 ; 26,17 ; 66,7 ; Gr 4,31 ; 6,24 ; 13,21 ; 22,23 ; 50,43 ; Mk 4,9). Tai hoạ thúc đẩy dân ăn năn hối cải có thể là cơ may đem lại cái phúc (sự sống mới : đứa con sinh ra). Nhưng Ép-ra-im đã tự kết án bản thân khi từ chối không chịu sinh ra.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "8",
      "sortOrder": 7,
      "startOffset": 39,
      "endOffset": 39,
      "createdAt": "2025-09-03T03:22:00.954Z",
      "updatedAt": "2025-09-03T03:22:00.954Z",
      "targetId": "0f501622-2a32-4d6c-8e57-bb2b7720d812",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "290e27f1-2218-468b-b7bc-9c15f5732fa8",
      "content": "Hs 5,14",
      "kind": "MARK_KIND_REFERENCE",
      "label": "9@",
      "sortOrder": 8,
      "startOffset": 31,
      "endOffset": 31,
      "createdAt": "2025-09-03T03:22:00.521Z",
      "updatedAt": "2025-09-03T03:22:00.521Z",
      "targetId": "d4c024af-24e6-4755-9cdf-5ce20c9b551a",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d72de577-d74d-449c-b044-35ce1b14979f"
    },
    {
      "id": "19e886a8-84cb-4a40-8a1e-6bb02d7228a7",
      "content": "Theo ngữ cảnh, 13,14 này là một lời đe doạ. Câu trả lời cho hai câu hỏi đầu tiên (*Ta lại giải thoát nó khỏi quyền lực âm phủ sao, lại chuộc nó khỏi thần chết ư ?*) phải là một câu trả lời tiêu cực. Hai câu hỏi kế tiếp là lời kêu mời *Thần Chết* và *Âm Ty* đến gây hoạ cho dân phản loạn. Thánh Phao-lô đã dùng câu này ở 1 Cr 15,55 theo cách chú giải thông thường trong thời của ngài : 13,14b (hai câu hỏi cuối) được tách khỏi văn cảnh để mang một ý nghĩa mới : thần chết đã bị đánh bại !",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "9",
      "sortOrder": 8,
      "startOffset": 32,
      "endOffset": 32,
