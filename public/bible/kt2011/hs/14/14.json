{
  "chapter": {
    "id": "9391fbc4-be67-4aea-856c-49e7b2687ed8",
    "number": 14,
    "createdAt": "2025-09-03T01:07:51.809Z",
    "updatedAt": "2025-09-03T01:07:51.809Z",
    "bookId": "11aabdfa-f668-4d41-962c-372a8b9257be"
  },
  "verses": [
    {
      "id": "ae8e3529-8179-45ce-a06e-8523b0d30e4a",
      "text": "Sa-ma-ri sẽ phải đền tội vì đã phản bội Thiên Chúa của mình.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:07.026Z",
      "updatedAt": "2025-09-03T03:22:07.026Z",
      "chapterId": "9391fbc4-be67-4aea-856c-49e7b2687ed8"
    },
    {
      "id": "0d220d6b-c74d-4267-97dd-19a39f03c190",
      "text": "Chúng sẽ gục ngã vì gươm đao,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:07.059Z",
      "updatedAt": "2025-09-03T03:22:07.059Z",
      "chapterId": "9391fbc4-be67-4aea-856c-49e7b2687ed8"
    },
    {
      "id": "77a36770-a08d-4476-b639-7acdd60fc205",
      "text": "con thơ của chúng sẽ bị tan xác, phụ nữ mang thai bị mổ bụng.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:07.070Z",
      "updatedAt": "2025-09-03T03:22:07.070Z",
      "chapterId": "9391fbc4-be67-4aea-856c-49e7b2687ed8"
    },
    {
      "id": "a8deed92-d9c4-4141-88d7-d9d5e2c311a8",
      "text": "Hỡi Ít-ra-en, hãy trở về với ĐỨC CHÚA là Thiên Chúa của ngươi.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:07.110Z",
      "updatedAt": "2025-09-03T03:22:07.110Z",
      "chapterId": "9391fbc4-be67-4aea-856c-49e7b2687ed8"
    },
    {
      "id": "70b28aac-b666-43b7-ad20-a752a5f3626c",
      "text": "Chính vì tội ác của ngươi mà ngươi đã vấp ngã.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:07.246Z",
      "updatedAt": "2025-09-03T03:22:07.246Z",
      "chapterId": "9391fbc4-be67-4aea-856c-49e7b2687ed8"
    },
    {
      "id": "3deb95d8-452e-4e39-9151-82cd885222e9",
      "text": "Hãy trở về với ĐỨC CHÚA, mang theo lời cầu nguyện.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:07.274Z",
      "updatedAt": "2025-09-03T03:22:07.274Z",
      "chapterId": "9391fbc4-be67-4aea-856c-49e7b2687ed8"
    },
    {
      "id": "5112fe16-cb39-4c7c-9ca2-202a7f4a9a9d",
      "text": "Hãy thưa với Người :",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:07.304Z",
      "updatedAt": "2025-09-03T03:22:07.304Z",
      "chapterId": "9391fbc4-be67-4aea-856c-49e7b2687ed8"
    },
    {
      "id": "cdbe738b-20e4-4e4e-91a7-7b2267a34f2b",
      "text": "“Xin thứ tha mọi gian ác, xin vui nhận lời ngợi khen",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:07.318Z",
      "updatedAt": "2025-09-03T03:22:07.318Z",
      "chapterId": "9391fbc4-be67-4aea-856c-49e7b2687ed8"
    },
    {
      "id": "5fd09761-05d1-426d-ba39-febabd9f2aaf",
      "text": "chúng con dâng lên Ngài làm lễ vật thay thế bò tơ.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 3,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:07.374Z",
      "updatedAt": "2025-09-03T03:22:07.374Z",
      "chapterId": "9391fbc4-be67-4aea-856c-49e7b2687ed8"
    },
    {
      "id": "8320ddca-8478-4281-9b58-2023b23f4950",
      "text": "Chúng con sẽ không cầu cứu với Át-sua,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:07.388Z",
      "updatedAt": "2025-09-03T03:22:07.388Z",
      "chapterId": "9391fbc4-be67-4aea-856c-49e7b2687ed8"
    },
    {
      "id": "6d3b7b2c-6411-4aee-a35c-d5a6b86a5fb8",
      "text": "sẽ không cậy nhờ vào chiến mã,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:07.429Z",
      "updatedAt": "2025-09-03T03:22:07.429Z",
      "chapterId": "9391fbc4-be67-4aea-856c-49e7b2687ed8"
    },
    {
      "id": "d746c20c-b478-4b76-9a37-4724eefa5053",
      "text": "cũng chẳng gọi là thần những sản phẩm tay chúng con làm ra,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:07.458Z",
      "updatedAt": "2025-09-03T03:22:07.458Z",
      "chapterId": "9391fbc4-be67-4aea-856c-49e7b2687ed8"
    },
    {
      "id": "78dc48d7-a905-4190-885d-ea48f14e7982",
      "text": "vì chỉ ở nơi Ngài kẻ mồ côi mới tìm được lòng thương cảm.”",
      "label": "4",
      "number": 4,
      "subVerseIndex": 3,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:07.502Z",
      "updatedAt": "2025-09-03T03:22:07.502Z",
      "chapterId": "9391fbc4-be67-4aea-856c-49e7b2687ed8"
    },
    {
      "id": "dee6baf5-7f65-4111-95a0-e96f18236c7f",
      "text": "Ta sẽ chữa chúng khỏi tội bất trung,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:07.515Z",
      "updatedAt": "2025-09-03T03:22:07.515Z",
      "chapterId": "9391fbc4-be67-4aea-856c-49e7b2687ed8"
    },
    {
      "id": "5a95afd0-de40-48a6-a873-ccf79d35c9a8",
      "text": "sẽ yêu thương chúng hết tình,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:07.530Z",
      "updatedAt": "2025-09-03T03:22:07.530Z",
      "chapterId": "9391fbc4-be67-4aea-856c-49e7b2687ed8"
    },
    {
      "id": "289841c5-edfb-49d5-807c-4bcc97b0f1c4",
      "text": "vì cơn giận của Ta sẽ không còn đeo đuổi chúng.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:07.560Z",
      "updatedAt": "2025-09-03T03:22:07.560Z",
      "chapterId": "9391fbc4-be67-4aea-856c-49e7b2687ed8"
    },
    {
      "id": "14ec4620-d0bb-4387-8d64-ca378b8ae07c",
      "text": "Với Ít-ra-en Ta sẽ như làn sương mai",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:07.574Z",
      "updatedAt": "2025-09-03T03:22:07.574Z",
      "chapterId": "9391fbc4-be67-4aea-856c-49e7b2687ed8"
    },
    {
      "id": "890684d0-e423-4022-8f65-b35a61a12e7e",
      "text": "làm nó vươn lên như bông huệ,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:07.618Z",
      "updatedAt": "2025-09-03T03:22:07.618Z",
      "chapterId": "9391fbc4-be67-4aea-856c-49e7b2687ed8"
    },
    {
      "id": "2e598d94-a590-4fe1-ba59-371506271b26",
      "text": "cho bén rễ sâu như cây ngàn Li-băng.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:07.632Z",
      "updatedAt": "2025-09-03T03:22:07.632Z",
      "chapterId": "9391fbc4-be67-4aea-856c-49e7b2687ed8"
    },
    {
      "id": "2280631b-3c69-4e78-a3bd-3947cef2eb91",
      "text": "Họ sẽ đâm chồi nẩy lộc, sum sê tựa ô-liu tươi tốt,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:07.661Z",
      "updatedAt": "2025-09-03T03:22:07.661Z",
      "chapterId": "9391fbc4-be67-4aea-856c-49e7b2687ed8"
    },
    {
      "id": "1e043baa-1cf7-42b8-9778-f96c67a9e7fd",
      "text": "toả hương thơm ngát như rừng Li-băng.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:07.688Z",
      "updatedAt": "2025-09-03T03:22:07.688Z",
      "chapterId": "9391fbc4-be67-4aea-856c-49e7b2687ed8"
    },
    {
      "id": "9836c44f-5c4d-459b-947a-b088a94a4e86",
      "text": "Chúng sẽ trở về cư ngụ dưới bóng Ta,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:07.730Z",
      "updatedAt": "2025-09-03T03:22:07.730Z",
      "chapterId": "9391fbc4-be67-4aea-856c-49e7b2687ed8"
    },
    {
      "id": "3b436447-2b99-412b-9127-9ca7375946f6",
      "text": "sẽ làm cho lúa miến hồi sinh nơi đồng ruộng,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:07.744Z",
      "updatedAt": "2025-09-03T03:22:07.744Z",
      "chapterId": "9391fbc4-be67-4aea-856c-49e7b2687ed8"
    },
    {
      "id": "5b8c753d-727f-4257-8c91-90236a05f384",
      "text": "tựa vườn nho, chúng sẽ sinh sôi nảy nở,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:07.759Z",
      "updatedAt": "2025-09-03T03:22:07.759Z",
      "chapterId": "9391fbc4-be67-4aea-856c-49e7b2687ed8"
    },
    {
      "id": "0b7d29cd-14f5-4eb5-9bf2-b77491acce5f",
      "text": "danh tiếng lẫy lừng như rượu Li-băng.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 3,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:07.773Z",
      "updatedAt": "2025-09-03T03:22:07.773Z",
      "chapterId": "9391fbc4-be67-4aea-856c-49e7b2687ed8"
    },
    {
      "id": "7cd05751-a902-4756-bbd0-2ccc5a666ff3",
      "text": "Ép-ra-im còn liên hệ gì với các ngẫu tượng ?",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:07.803Z",
      "updatedAt": "2025-09-03T03:22:07.803Z",
      "chapterId": "9391fbc4-be67-4aea-856c-49e7b2687ed8"
    },
    {
      "id": "5a5aa7e9-eac5-482f-b2cb-993da3b29832",
      "text": "Còn Ta, Ta đã nhậm lời và đoái nhìn đến nó.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:07.845Z",
      "updatedAt": "2025-09-03T03:22:07.845Z",
      "chapterId": "9391fbc4-be67-4aea-856c-49e7b2687ed8"
    },
    {
      "id": "21927ca6-29ef-49a1-93bd-d047c1fcec14",
      "text": "Ta như một cây trắc bá xanh tươi,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:07.873Z",
      "updatedAt": "2025-09-03T03:22:07.873Z",
      "chapterId": "9391fbc4-be67-4aea-856c-49e7b2687ed8"
    },
    {
      "id": "d2b40700-1a1a-43de-825d-223649cb8075",
      "text": "chính nhờ Ta mà ngươi trổ sinh hoa trái.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 3,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:07.887Z",
      "updatedAt": "2025-09-03T03:22:07.887Z",
      "chapterId": "9391fbc4-be67-4aea-856c-49e7b2687ed8"
    },
    {
      "id": "1d5c9df1-a343-419d-8180-3d35f05da28f",
      "text": "Ai đủ khôn ngoan để hiểu được điều này,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:07.921Z",
      "updatedAt": "2025-09-03T03:22:07.921Z",
      "chapterId": "9391fbc4-be67-4aea-856c-49e7b2687ed8"
    },
    {
      "id": "4cc6a7a5-6590-44d5-8466-0494eb1718d9",
      "text": "đủ thông minh để biết được điều ấy ?",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:07.963Z",
      "updatedAt": "2025-09-03T03:22:07.963Z",
      "chapterId": "9391fbc4-be67-4aea-856c-49e7b2687ed8"
    },
    {
      "id": "624e99b7-2781-4a27-8185-d8a02ec9dd5d",
      "text": "Quả thật đường lối ĐỨC CHÚA rất mực thẳng ngay.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:07.976Z",
      "updatedAt": "2025-09-03T03:22:07.976Z",
      "chapterId": "9391fbc4-be67-4aea-856c-49e7b2687ed8"
    },
    {
      "id": "de58b029-4ad1-47c8-aa26-b62b099f6221",
      "text": "Trên con đường này, người công chính sẽ hiên ngang tiến bước,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 3,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:08.018Z",
      "updatedAt": "2025-09-03T03:22:08.018Z",
      "chapterId": "9391fbc4-be67-4aea-856c-49e7b2687ed8"
    },
    {
      "id": "51663997-de70-4f4e-b315-c833bfe26d8a",
      "text": "còn kẻ gian ác sẽ phải té nhào.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 4,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:22:08.031Z",
      "updatedAt": "2025-09-03T03:22:08.031Z",
      "chapterId": "9391fbc4-be67-4aea-856c-49e7b2687ed8"
    }
  ],
