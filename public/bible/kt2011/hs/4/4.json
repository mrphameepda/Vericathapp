      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "5761e28b-1f8e-4bfc-a18e-6811813592c6",
      "content": "Ml 2,1-3.9",
      "kind": "MARK_KIND_REFERENCE",
