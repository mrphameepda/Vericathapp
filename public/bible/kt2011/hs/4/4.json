  "headings": [
    {
      "id": "c06fc588-7bc3-49cc-9335-5823e2446125",
      "text": "II. ÍT-RA-EN PHẠM TỘI VÀ BỊ TRỪNG PHẠT",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:20:56.803Z",
      "updatedAt": "2025-09-03T03:20:56.803Z",
      "verseId": "2cd6424e-8ab8-47fd-8bc8-370a6424f11f",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "c05266b6-b971-4095-a0d5-caf63840307f",
      "text": "Lên án hàng tư tế",
      "level": 2,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:20:57.065Z",
      "updatedAt": "2025-09-03T03:20:57.065Z",
      "verseId": "6342be73-ef08-4148-99e3-6a6da182daf0",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "248e8997-69c3-4c34-bead-d3dffed1099e",
      "text": "Phụng tự của Ít-ra-en : thờ ngẫu tượng và sống sa đoạ",
      "level": 2,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:20:57.463Z",
      "updatedAt": "2025-09-03T03:20:57.463Z",
      "verseId": "c78c0c72-354f-42d2-a2ed-9ac11cb83ead",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "95562bf1-76c2-4332-b823-22a096ac1ad8",
      "text": "Cảnh cáo Giu-đa và Ít-ra-en",
      "level": 2,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:20:57.780Z",
      "updatedAt": "2025-09-03T03:20:57.780Z",
      "verseId": "f93e1a24-c70f-4d0a-b049-12e32b78e615",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "27eca8b4-88d3-4b77-a600-1ffb9766fd8a",
      "text": "Tình trạng đồi bại chung",
      "level": 2,
      "sortOrder": 1,
      "createdAt": "2025-09-03T03:20:56.814Z",
      "updatedAt": "2025-09-03T03:20:56.814Z",
      "verseId": "2cd6424e-8ab8-47fd-8bc8-370a6424f11f",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    }
  ],
