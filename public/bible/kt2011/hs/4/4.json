{
  "chapter": {
    "id": "b679ed97-85af-49f6-9163-ed146cee73ca",
    "number": 4,
    "createdAt": "2025-09-03T01:07:51.809Z",
    "updatedAt": "2025-09-03T01:07:51.809Z",
    "bookId": "11aabdfa-f668-4d41-962c-372a8b9257be"
  },
  "verses": [
    {
      "id": "2cd6424e-8ab8-47fd-8bc8-370a6424f11f",
      "text": "Hỡi con cái Ít-ra-en, hãy nghe lời ĐỨC CHÚA,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:56.785Z",
      "updatedAt": "2025-09-03T03:20:56.785Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "fdd388c2-3f36-4a5a-b98c-216e615f09e0",
      "text": "vì ĐỨC CHÚA sẽ kiện dân cư xứ này : Quả thật trong xứ này,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:56.852Z",
      "updatedAt": "2025-09-03T03:20:56.852Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "0f9ec42d-ffc3-47ca-8944-58c339631169",
      "text": "chẳng có tín thành, chẳng có ân nghĩa,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:56.907Z",
      "updatedAt": "2025-09-03T03:20:56.907Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "da89283b-0f7b-4651-b39a-22fd193e46cc",
      "text": "cũng chẳng có sự hiểu biết Thiên Chúa.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 3,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:56.935Z",
      "updatedAt": "2025-09-03T03:20:56.935Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "ebd5c244-f5e9-40f8-b4f9-7bbaa96d84cf",
      "text": "Chỉ có bội thề, dối trá, sát nhân và trộm cướp,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:56.949Z",
      "updatedAt": "2025-09-03T03:20:56.949Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "d47e3265-3287-4970-8be9-1a61f28f4dff",
      "text": "áp bức với ngoại tình, các cuộc đổ máu cứ nối tiếp nhau.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:56.977Z",
      "updatedAt": "2025-09-03T03:20:56.977Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "26b264b8-88e0-4e4c-9146-76edfe39536e",
      "text": "Chính vì thế mà xứ sở tang thương, dân cư tàn tạ,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:56.991Z",
      "updatedAt": "2025-09-03T03:20:56.991Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "8a4b99fb-b1f9-4885-b8a0-1722ab65bf20",
      "text": "ngay thú vật ngoài đồng, cũng như chim trời cá biển,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:57.023Z",
      "updatedAt": "2025-09-03T03:20:57.023Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "93326941-1496-41db-9bc9-ac9844093467",
      "text": "tất cả đều chết hết.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:57.037Z",
      "updatedAt": "2025-09-03T03:20:57.037Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "6342be73-ef08-4148-99e3-6a6da182daf0",
      "text": "Thế mà chẳng có ai kiện tụng, chẳng có ai trách mắng !",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:57.051Z",
      "updatedAt": "2025-09-03T03:20:57.051Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "8d2ef9bf-b4be-42ba-a840-ce0cdada5c1f",
      "text": "Nhưng hỡi tư tế, chính Ta sẽ đưa ngươi ra toà.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:57.078Z",
      "updatedAt": "2025-09-03T03:20:57.078Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "383b1898-ba20-464c-b269-450890dc304d",
      "text": "Giữa ban ngày, chính ngươi sẽ vấp ngã,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:57.092Z",
      "updatedAt": "2025-09-03T03:20:57.092Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "b26d848c-d24f-45ab-887a-cc2c7f1f571d",
      "text": "ban đêm, cả ngôn sứ cũng vấp ngã như ngươi.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:57.106Z",
      "updatedAt": "2025-09-03T03:20:57.106Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "bcea5c5b-331e-4938-8854-293f87f02aff",
      "text": "Ta sẽ bắt mẹ ngươi phải chết.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:57.120Z",
      "updatedAt": "2025-09-03T03:20:57.120Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "146e10c8-e36a-45aa-869d-597856b6e130",
      "text": "Vì thiếu hiểu biết mà dân Ta bị tiêu vong.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:57.134Z",
      "updatedAt": "2025-09-03T03:20:57.134Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "4de687d9-c8d6-43b4-872f-13262ccd8e0c",
      "text": "Bởi chính ngươi đã gạt bỏ sự hiểu biết,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:57.162Z",
      "updatedAt": "2025-09-03T03:20:57.162Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "d2b6f05c-33dd-4962-b788-4989be482bb4",
      "text": "nên Ta sẽ gạt bỏ ngươi, không cho làm tư tế của Ta nữa ;",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:57.176Z",
      "updatedAt": "2025-09-03T03:20:57.176Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "d6ad96de-31ba-4a5a-90e8-3423bf0d433d",
      "text": "ngươi đã quên luật của Thiên Chúa ngươi thờ,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 3,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:57.206Z",
      "updatedAt": "2025-09-03T03:20:57.206Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "7d73a989-7f90-448f-b4ae-32d9e2fb589e",
      "text": "thì Ta, Ta cũng sẽ quên con cái ngươi.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 4,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:57.221Z",
      "updatedAt": "2025-09-03T03:20:57.221Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "d4937139-2a68-4562-8738-e031141c0cc3",
      "text": "Tất cả đám đông chúng nó đều xúc phạm đến Ta.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:57.236Z",
      "updatedAt": "2025-09-03T03:20:57.236Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "fca8c37e-8918-4d93-bf48-505c671c03fc",
      "text": "Vinh quang của chúng, chúng đổi lấy ô nhục.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:57.255Z",
      "updatedAt": "2025-09-03T03:20:57.255Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "bb7270b5-9d15-419f-a2d5-c0bcd0449913",
      "text": "Chúng có ăn, nhờ dân Ta phạm tội,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:57.281Z",
      "updatedAt": "2025-09-03T03:20:57.281Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "4fd3ff5e-257b-4db4-81c0-773ab07aba48",
      "text": "chúng thích thú, khi dân Ta lỗi lầm.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:57.322Z",
      "updatedAt": "2025-09-03T03:20:57.322Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "f865b637-65da-43ff-8f67-fe212e256f1d",
      "text": "Nên tư tế phải chung số phận của dân :",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:57.336Z",
      "updatedAt": "2025-09-03T03:20:57.336Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "1bd56841-3019-4744-9a6d-9d9e78831b83",
      "text": "Ta sẽ cứ lối sống của nó mà trừng phạt nó,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:57.350Z",
      "updatedAt": "2025-09-03T03:20:57.350Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "31216f18-0c63-4090-8011-9ecd749b9719",
      "text": "sẽ trả cho nó theo việc nó làm.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:57.364Z",
      "updatedAt": "2025-09-03T03:20:57.364Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "7023f7e8-08e6-4fb5-bfa7-d4e5bdc26e9a",
      "text": "Chúng ăn mà chẳng no, làm điếm mà chẳng sinh sôi nảy nở,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:57.379Z",
      "updatedAt": "2025-09-03T03:20:57.379Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "4ad62e66-6539-4abe-9d08-d1678ff4ceb9",
      "text": "vì chúng đã bỏ không thờ ĐỨC CHÚA.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:57.421Z",
      "updatedAt": "2025-09-03T03:20:57.421Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "c78c0c72-354f-42d2-a2ed-9ac11cb83ead",
      "text": "Đĩ điếm, rượu chè làm dân Ta mất trí.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:57.449Z",
      "updatedAt": "2025-09-03T03:20:57.449Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "0bb16ddd-e033-4f9f-a068-2361344f957b",
      "text": "Chúng thỉnh ý khúc gỗ của mình,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:57.491Z",
      "updatedAt": "2025-09-03T03:20:57.491Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "b6d79a5c-f134-42d1-8935-b1be13a2806b",
      "text": "và xin cây gậy của mình mặc khải cho ;",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:57.520Z",
      "updatedAt": "2025-09-03T03:20:57.520Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "7de88aea-f6eb-4574-8d58-fbc337513917",
      "text": "vì thói đĩ điếm làm cho chúng lầm lạc,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:57.534Z",
      "updatedAt": "2025-09-03T03:20:57.534Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "73b21bcc-a61a-41b7-b5ad-8919984d316e",
      "text": "chúng bỏ Thiên Chúa của mình mà đi làm điếm.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 3,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:57.569Z",
      "updatedAt": "2025-09-03T03:20:57.569Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "b4d1c1d0-ea29-4f55-8565-8b3a3f461fa7",
      "text": "Chúng sát tế, chúng dâng hương",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:57.583Z",
      "updatedAt": "2025-09-03T03:20:57.583Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "526dfdd0-2071-4c2d-af73-a755419218cf",
      "text": "trên các đỉnh núi, trên các ngọn đồi,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:57.596Z",
      "updatedAt": "2025-09-03T03:20:57.596Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "52267e4b-bbee-410a-881d-0cb8f8d92768",
      "text": "dưới bóng mát cây sồi, cây hương, cây sến.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:57.624Z",
      "updatedAt": "2025-09-03T03:20:57.624Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "af9413a8-8010-47d7-886a-65c771648a09",
      "text": "Thảo nào con gái các ngươi chẳng làm điếm,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 3,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:57.652Z",
      "updatedAt": "2025-09-03T03:20:57.652Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "7ed50378-70d4-4c67-bb3c-af283d8c7044",
      "text": "con dâu các ngươi chẳng ngoại tình.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 4,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:57.666Z",
      "updatedAt": "2025-09-03T03:20:57.666Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "a8fb704e-8df7-452f-b8d9-e41d4514b808",
      "text": "Con gái các ngươi làm điếm, con dâu các ngươi ngoại tình,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:57.680Z",
      "updatedAt": "2025-09-03T03:20:57.680Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "2e776270-5d77-42c0-ac78-e80225f7304a",
      "text": "Ta sẽ không trừng phạt,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:57.694Z",
      "updatedAt": "2025-09-03T03:20:57.694Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "9225d028-b2c0-4f21-97eb-014a3b60e492",
      "text": "vì chính các tư tế cũng giao du với phường kỹ nữ",
      "label": "14",
      "number": 14,
      "subVerseIndex": 2,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:57.708Z",
      "updatedAt": "2025-09-03T03:20:57.708Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "58a696b5-4669-4bae-84a8-5010e458dbde",
      "text": "và cùng tế lễ với bọn điếm đền thần.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 3,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:57.738Z",
      "updatedAt": "2025-09-03T03:20:57.738Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "47d8cf98-9637-431f-a809-6a66e40d0a76",
      "text": "Đám dân đen chẳng thông, chẳng hiểu sẽ bị diệt vong.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 4,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:57.752Z",
      "updatedAt": "2025-09-03T03:20:57.752Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "f93e1a24-c70f-4d0a-b049-12e32b78e615",
      "text": "Hỡi Ít-ra-en, nếu ngươi làm điếm,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:57.766Z",
      "updatedAt": "2025-09-03T03:20:57.766Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "3a23ebdb-2c63-4bb5-831e-76371bb07867",
      "text": "thì đừng để cho Giu-đa mắc tội !",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:57.834Z",
      "updatedAt": "2025-09-03T03:20:57.834Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "778fbaa3-0693-4d76-af6f-0df594b99ca9",
      "text": "Đừng tới Ghin-gan, đừng lên Bết A-ven,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 2,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:57.866Z",
      "updatedAt": "2025-09-03T03:20:57.866Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "13ac3e53-bdc6-47f4-a787-5583b59b375d",
      "text": "đừng thề “nhân danh ĐỨC CHÚA hằng sống”.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 3,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:57.935Z",
      "updatedAt": "2025-09-03T03:20:57.935Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "6410da60-252c-4607-b5fb-13493e70e641",
      "text": "Quả thật, Ít-ra-en cứng đầu như một con bò cái bất trị,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:57.978Z",
      "updatedAt": "2025-09-03T03:20:57.978Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "df2dce60-b11a-49d2-af01-a35081a0baef",
      "text": "chẳng lẽ bây giờ ĐỨC CHÚA lại để cho chúng tha hồ ăn cỏ",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:58.023Z",
      "updatedAt": "2025-09-03T03:20:58.023Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "587bb29d-2e65-4ef5-9d33-d31ef0c94d49",
      "text": "khác nào con chiên trong đồng rộng thênh thang ?",
      "label": "16",
      "number": 16,
      "subVerseIndex": 2,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:58.051Z",
      "updatedAt": "2025-09-03T03:20:58.051Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "5096f99c-120c-46f2-a733-f5840c85f160",
      "text": "Ép-ra-im kết thân với ngẫu tượng, thì cứ để mặc nó !",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:58.066Z",
      "updatedAt": "2025-09-03T03:20:58.066Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "a870626a-e74e-4ed7-8763-1c45184e41a2",
      "text": "Chè chén say sưa rồi, chúng tha hồ đàng điếm ;",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:58.111Z",
      "updatedAt": "2025-09-03T03:20:58.111Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "14d2d2c7-0d2f-4808-b3b8-08be9a77c6a4",
      "text": "chúng ham thích Ô nhục mà bỏ Đấng Tối Cao.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:58.139Z",
      "updatedAt": "2025-09-03T03:20:58.139Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "e7c4a370-77ec-4230-9882-eb2e3d5043d9",
      "text": "Chúng sẽ bị cuốn đi trong cánh gió,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:58.183Z",
      "updatedAt": "2025-09-03T03:20:58.183Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    },
    {
      "id": "a67785f1-e7bc-47f6-9b04-15f81127d077",
      "text": "sẽ hổ thẹn vì hiến lễ của mình.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:20:58.211Z",
      "updatedAt": "2025-09-03T03:20:58.211Z",
      "chapterId": "b679ed97-85af-49f6-9163-ed146cee73ca"
    }
  ],
