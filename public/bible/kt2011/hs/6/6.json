{
  "chapter": {
    "id": "b9010dab-ae7f-43e2-bb5d-a6f8c0dc68dd",
    "number": 6,
    "createdAt": "2025-09-03T01:07:51.809Z",
    "updatedAt": "2025-09-03T01:07:51.809Z",
    "bookId": "11aabdfa-f668-4d41-962c-372a8b9257be"
  },
  "verses": [
    {
      "id": "9b1c010e-8632-4df1-b26d-04de1bd285c6",
      "text": "“Nào chúng ta hãy trở về cùng ĐỨC CHÚA.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:11.017Z",
      "updatedAt": "2025-09-03T03:21:11.017Z",
      "chapterId": "b9010dab-ae7f-43e2-bb5d-a6f8c0dc68dd"
    },
    {
      "id": "8977c46c-2170-401a-acfc-e09ac8bb46e6",
      "text": "Người đã xé nát thân chúng ta, nhưng rồi lại chữa lành.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:11.079Z",
      "updatedAt": "2025-09-03T03:21:11.079Z",
      "chapterId": "b9010dab-ae7f-43e2-bb5d-a6f8c0dc68dd"
    },
    {
      "id": "d877ac3b-4aef-494e-bba3-1358ec1f58eb",
      "text": "Người đã đánh đập chúng ta, nhưng rồi lại băng bó vết thương.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:11.091Z",
      "updatedAt": "2025-09-03T03:21:11.091Z",
      "chapterId": "b9010dab-ae7f-43e2-bb5d-a6f8c0dc68dd"
    },
    {
      "id": "faba05de-2c03-4933-80cb-4fe8f97d19ed",
      "text": "Sau hai ngày, Người sẽ hoàn lại cho chúng ta sự sống ;",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:11.105Z",
      "updatedAt": "2025-09-03T03:21:11.105Z",
      "chapterId": "b9010dab-ae7f-43e2-bb5d-a6f8c0dc68dd"
    },
    {
      "id": "e3bc9140-150c-495a-8f3a-fd2dfa750490",
      "text": "ngày thứ ba, sẽ cho chúng ta trỗi dậy,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:11.119Z",
      "updatedAt": "2025-09-03T03:21:11.119Z",
      "chapterId": "b9010dab-ae7f-43e2-bb5d-a6f8c0dc68dd"
    },
    {
      "id": "4246b72c-091b-4d79-b63f-154162aa3670",
      "text": "và chúng ta sẽ được sống trước nhan Người.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:11.162Z",
      "updatedAt": "2025-09-03T03:21:11.162Z",
      "chapterId": "b9010dab-ae7f-43e2-bb5d-a6f8c0dc68dd"
    },
    {
      "id": "50d2146f-9b51-4f27-9fc2-d86f5dff5386",
      "text": "Chúng ta phải biết ĐỨC CHÚA, phải ra sức nhận biết Người ;",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:11.189Z",
      "updatedAt": "2025-09-03T03:21:11.189Z",
      "chapterId": "b9010dab-ae7f-43e2-bb5d-a6f8c0dc68dd"
    },
    {
      "id": "c80048cf-41ad-4599-af74-5d893ddf0f2d",
      "text": "như hừng đông mỗi ngày xuất hiện,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:11.234Z",
      "updatedAt": "2025-09-03T03:21:11.234Z",
      "chapterId": "b9010dab-ae7f-43e2-bb5d-a6f8c0dc68dd"
    },
    {
      "id": "1ad73922-3c74-4bcb-baf0-cae28f9f70bf",
      "text": "chắc chắn thế nào Người cũng đến.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:11.248Z",
      "updatedAt": "2025-09-03T03:21:11.248Z",
      "chapterId": "b9010dab-ae7f-43e2-bb5d-a6f8c0dc68dd"
    },
    {
      "id": "b0e422d1-e402-4d59-89dd-2befefc72799",
      "text": "Người sẽ đến với chúng ta như mưa rào,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 3,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:11.262Z",
      "updatedAt": "2025-09-03T03:21:11.262Z",
      "chapterId": "b9010dab-ae7f-43e2-bb5d-a6f8c0dc68dd"
    },
    {
      "id": "823b6826-97cc-402b-9a21-2c3bc7d3bf8b",
      "text": "như mưa xuân tưới gội đất đai.”",
      "label": "3",
      "number": 3,
      "subVerseIndex": 4,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:11.287Z",
      "updatedAt": "2025-09-03T03:21:11.287Z",
      "chapterId": "b9010dab-ae7f-43e2-bb5d-a6f8c0dc68dd"
    },
    {
      "id": "fc8c1647-dd64-41ec-acbe-8b162451a071",
      "text": "Ta phải làm gì cho ngươi đây, Ép-ra-im hỡi ?",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:11.301Z",
      "updatedAt": "2025-09-03T03:21:11.301Z",
      "chapterId": "b9010dab-ae7f-43e2-bb5d-a6f8c0dc68dd"
    },
    {
      "id": "f72d96db-126c-4677-a445-fac528e95187",
      "text": "Ta phải làm gì cho ngươi, hỡi Giu-đa ?",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:11.334Z",
      "updatedAt": "2025-09-03T03:21:11.334Z",
      "chapterId": "b9010dab-ae7f-43e2-bb5d-a6f8c0dc68dd"
    },
    {
      "id": "6fd7edba-c22e-44f2-bc1b-2be04e9d2c29",
      "text": "Tình yêu của các ngươi khác nào mây buổi sáng,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:11.362Z",
      "updatedAt": "2025-09-03T03:21:11.362Z",
      "chapterId": "b9010dab-ae7f-43e2-bb5d-a6f8c0dc68dd"
    },
    {
      "id": "e3b758ce-2551-43f5-9995-f9549bb33f89",
      "text": "mau tan tựa sương mai.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 3,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:11.391Z",
      "updatedAt": "2025-09-03T03:21:11.391Z",
      "chapterId": "b9010dab-ae7f-43e2-bb5d-a6f8c0dc68dd"
    },
    {
      "id": "beb81dfe-bd79-4c39-ab63-c2b09253754e",
      "text": "Vì vậy, Ta dùng ngôn sứ mà đánh phạt chúng,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:11.405Z",
      "updatedAt": "2025-09-03T03:21:11.405Z",
      "chapterId": "b9010dab-ae7f-43e2-bb5d-a6f8c0dc68dd"
    },
    {
      "id": "cdd68981-21d4-4f0a-97b7-84d03e103573",
      "text": "lấy lời miệng Ta mà diệt trừ.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:11.433Z",
      "updatedAt": "2025-09-03T03:21:11.433Z",
      "chapterId": "b9010dab-ae7f-43e2-bb5d-a6f8c0dc68dd"
    },
    {
      "id": "6a414a1d-1e53-469d-bed2-f7996fd96673",
      "text": "Phán quyết của Ta sẽ bừng lên như ánh sáng.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:11.464Z",
      "updatedAt": "2025-09-03T03:21:11.464Z",
      "chapterId": "b9010dab-ae7f-43e2-bb5d-a6f8c0dc68dd"
    },
    {
      "id": "706789a3-53cb-4b41-b949-65ddbedf8052",
      "text": "Vì Ta muốn tình yêu chứ không cần hy lễ,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:11.479Z",
      "updatedAt": "2025-09-03T03:21:11.479Z",
      "chapterId": "b9010dab-ae7f-43e2-bb5d-a6f8c0dc68dd"
    },
    {
      "id": "2eb21252-187e-4ae9-a419-f73657c66c67",
      "text": "thích được các ngươi nhận biết hơn là được của lễ toàn thiêu.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:11.521Z",
      "updatedAt": "2025-09-03T03:21:11.521Z",
      "chapterId": "b9010dab-ae7f-43e2-bb5d-a6f8c0dc68dd"
    },
    {
      "id": "fc6095f6-1ca1-403e-b88b-8b4052c87ea6",
      "text": "Nhưng ngay tại A-đam, chúng đã vi phạm giao ước,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:11.549Z",
      "updatedAt": "2025-09-03T03:21:11.549Z",
      "chapterId": "b9010dab-ae7f-43e2-bb5d-a6f8c0dc68dd"
    },
    {
      "id": "35cb103f-90a5-4680-bb33-6b679df7c6ad",
      "text": "tại đó, chúng đã phản bội Ta.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:11.633Z",
      "updatedAt": "2025-09-03T03:21:11.633Z",
      "chapterId": "b9010dab-ae7f-43e2-bb5d-a6f8c0dc68dd"
    },
    {
      "id": "be0288f7-2378-40d1-aa51-0e9077bd9586",
      "text": "Ga-la-át là thành của những kẻ bất lương, thành đầy vết máu.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:11.647Z",
      "updatedAt": "2025-09-03T03:21:11.647Z",
      "chapterId": "b9010dab-ae7f-43e2-bb5d-a6f8c0dc68dd"
    },
    {
      "id": "123df0a0-c03d-455c-b606-359892290ff5",
      "text": "Trên đường về Si-khem, một đoàn tư tế gây chết chóc,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:11.696Z",
      "updatedAt": "2025-09-03T03:21:11.696Z",
      "chapterId": "b9010dab-ae7f-43e2-bb5d-a6f8c0dc68dd"
    },
    {
      "id": "3041708f-bf6e-45a9-a192-daea1246c374",
      "text": "khác nào bọn cướp đang rình rập.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:11.725Z",
      "updatedAt": "2025-09-03T03:21:11.725Z",
      "chapterId": "b9010dab-ae7f-43e2-bb5d-a6f8c0dc68dd"
    },
    {
      "id": "1feeca46-af5e-468a-8cf7-9414834fe3eb",
      "text": "Việc chúng làm quả thật xấu xa.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:11.739Z",
      "updatedAt": "2025-09-03T03:21:11.739Z",
      "chapterId": "b9010dab-ae7f-43e2-bb5d-a6f8c0dc68dd"
    },
    {
      "id": "81c8664d-6094-44b5-9bb4-5be6205571f9",
      "text": "Tại nhà Ít-ra-en, Ta đã thấy một điều ghê tởm,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:11.752Z",
      "updatedAt": "2025-09-03T03:21:11.752Z",
      "chapterId": "b9010dab-ae7f-43e2-bb5d-a6f8c0dc68dd"
    },
    {
      "id": "b9611493-5628-4c6a-bd50-9dc0fed6dade",
      "text": "ở đó, Ép-ra-im đã làm điếm, Ít-ra-en đã ra dơ bẩn.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:11.785Z",
      "updatedAt": "2025-09-03T03:21:11.785Z",
      "chapterId": "b9010dab-ae7f-43e2-bb5d-a6f8c0dc68dd"
    },
    {
      "id": "a44222f4-bf61-4eaf-a3a1-ba3352eea3c5",
      "text": "Cả ngươi nữa, hỡi Giu-đa, Ta ấn định cho ngươi một mùa gặt,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:11.838Z",
      "updatedAt": "2025-09-03T03:21:11.838Z",
      "chapterId": "b9010dab-ae7f-43e2-bb5d-a6f8c0dc68dd"
    },
    {
      "id": "7ec529c3-4351-4c09-85e7-50d1842e047a",
      "text": "khi Ta đổi số phận dân Ta.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:11.866Z",
      "updatedAt": "2025-09-03T03:21:11.866Z",
      "chapterId": "b9010dab-ae7f-43e2-bb5d-a6f8c0dc68dd"
    }
  ],
