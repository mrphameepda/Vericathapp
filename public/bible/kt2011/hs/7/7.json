{
  "chapter": {
    "id": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2",
    "number": 7,
    "createdAt": "2025-09-03T01:07:51.809Z",
    "updatedAt": "2025-09-03T01:07:51.809Z",
    "bookId": "11aabdfa-f668-4d41-962c-372a8b9257be"
  },
  "verses": [
    {
      "id": "3065b97a-2b52-47fb-93c8-64aafd393eb6",
      "text": "Khi Ta muốn chữa Ít-ra-en cho lành,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:17.714Z",
      "updatedAt": "2025-09-03T03:21:17.714Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "e6268485-bf3a-4244-97c7-060f4b52d216",
      "text": "thì tội lỗi của Ép-ra-im và các sự gian ác của Sa-ma-ri",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:17.742Z",
      "updatedAt": "2025-09-03T03:21:17.742Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "b347ad41-e116-4922-9b63-4ffe3723e434",
      "text": "lại bị phát giác, bởi vì chúng làm chuyện gian tà :",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:17.795Z",
      "updatedAt": "2025-09-03T03:21:17.795Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "7f34788e-da5d-43be-b0d6-6b10db788578",
      "text": "kẻ trộm lẻn vào trong, bọn cướp phá bên ngoài.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 3,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:17.809Z",
      "updatedAt": "2025-09-03T03:21:17.809Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "23611c1c-27e2-4e3a-ab9a-6f546c685b17",
      "text": "Chúng đâu có tự nhủ : Ta nhớ hết mọi việc gian ác chúng làm.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:17.823Z",
      "updatedAt": "2025-09-03T03:21:17.823Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "d86f690d-d98b-44dc-9e7a-0f59abd04fd4",
      "text": "Giờ đây hành động của chúng trói chặt lấy chúng,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:17.853Z",
      "updatedAt": "2025-09-03T03:21:17.853Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "63c6f5d5-d68f-493c-8fc7-4d26582ac288",
      "text": "tất cả rành rành trước mặt Ta.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:17.867Z",
      "updatedAt": "2025-09-03T03:21:17.867Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "353addfa-70c9-4e8a-9707-2ccb2a0e6786",
      "text": "Để mua vui cho vua, chúng làm điều gian ác,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:17.896Z",
      "updatedAt": "2025-09-03T03:21:17.896Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "eaa13764-b2f0-4bcb-99c2-e5b830f4a5cf",
      "text": "để vừa lòng thủ lãnh, chúng bày chuyện dối gian,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:17.924Z",
      "updatedAt": "2025-09-03T03:21:17.924Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "2c2abab4-45f1-43b3-bcd7-133fc1dafc7a",
      "text": "tất cả bọn chúng là một đám ngoại tình,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:17.938Z",
      "updatedAt": "2025-09-03T03:21:17.938Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "0b1d5be9-f554-4af7-9a6f-8598a9649726",
      "text": "chẳng khác chi hoả lò phừng phực cháy",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:17.952Z",
      "updatedAt": "2025-09-03T03:21:17.952Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "108fe8dd-ceb3-428b-9e9f-0ce29b87818a",
      "text": "khi người nướng bánh đã ngưng thổi lửa",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:17.970Z",
      "updatedAt": "2025-09-03T03:21:17.970Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "17c32e9f-9a28-4f12-8231-c45195bd6213",
      "text": "để nhồi bột cho đến lúc dậy men.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 3,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:17.984Z",
      "updatedAt": "2025-09-03T03:21:17.984Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "f90037e6-80aa-4251-bc55-a0f0e68ae680",
      "text": "Trong ngày mừng đức vua,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:17.999Z",
      "updatedAt": "2025-09-03T03:21:17.999Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "8e96ab7d-09f2-4d54-95a0-036bec43ccac",
      "text": "các thủ lãnh choáng váng vì hơi rượu ;",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:18.013Z",
      "updatedAt": "2025-09-03T03:21:18.013Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "34ec678a-c754-4e23-ae61-0b1ee8f8117c",
      "text": "bọn chè chén say sưa cũng được rộng tay đón tiếp.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:18.030Z",
      "updatedAt": "2025-09-03T03:21:18.030Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "879f1239-3d53-46c3-af2d-aaa42a9efbb5",
      "text": "Khi chúng bày những âm mưu xảo quyệt,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:18.044Z",
      "updatedAt": "2025-09-03T03:21:18.044Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "aa392bc9-d292-46a0-82d6-6da86dac8a28",
      "text": "lòng chúng chẳng khác chi hoả lò :",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:18.058Z",
      "updatedAt": "2025-09-03T03:21:18.058Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "35bd8509-28c1-41f2-b178-b1404658d2f2",
      "text": "suốt đêm cơn giận của chúng ngủ yên,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:18.072Z",
      "updatedAt": "2025-09-03T03:21:18.072Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "9d62bcea-a6ff-4363-8567-dde7043b2703",
      "text": "nhưng bừng lên như ngọn hoả hào khi trời sáng ;",
      "label": "6",
      "number": 6,
      "subVerseIndex": 3,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:18.085Z",
      "updatedAt": "2025-09-03T03:21:18.085Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "ad17378d-2d89-40ad-9f73-691b0f847442",
      "text": "cả đám phừng phực như hoả lò",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:18.099Z",
      "updatedAt": "2025-09-03T03:21:18.099Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "81207961-2d4f-44d5-b089-8e7bc3d5b6a2",
      "text": "đốt tiêu tan các quan toà của chúng ;",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:18.113Z",
      "updatedAt": "2025-09-03T03:21:18.113Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "3855081a-809b-4928-8796-ff7bcbc71ca1",
      "text": "hết thảy các vua đều gục ngã",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:18.127Z",
      "updatedAt": "2025-09-03T03:21:18.127Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "e94d25e6-1563-4251-8595-956df1656c9a",
      "text": "mà không ai trong chúng kêu cầu Ta.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 3,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:18.169Z",
      "updatedAt": "2025-09-03T03:21:18.169Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "38b24db4-f3ff-40ae-81c8-39c373d5be83",
      "text": "Ép-ra-im chung đụng với chư dân,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:18.183Z",
      "updatedAt": "2025-09-03T03:21:18.183Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "a222622d-f553-494c-b6cb-8bb0ccfd16ac",
      "text": "Ép-ra-im như chiếc bánh nướng cháy một bên.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:18.241Z",
      "updatedAt": "2025-09-03T03:21:18.241Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "afdf56be-a087-492e-86f0-9bac7756f2b9",
      "text": "Ngoại bang ngốn hết sức lực của nó",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:18.268Z",
      "updatedAt": "2025-09-03T03:21:18.268Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "72e58975-d4c0-4bdf-8b19-a0ca34acc7ea",
      "text": "mà nó cũng chẳng hay.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:18.296Z",
      "updatedAt": "2025-09-03T03:21:18.296Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "96084c74-4e57-42e7-8dc2-66d7bc188e8f",
      "text": "Ngay cả khi tóc nó bạc màu, nó nào đâu có biết.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:18.311Z",
      "updatedAt": "2025-09-03T03:21:18.311Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "57009209-cc36-4c88-a37e-6149cc532f53",
      "text": "Ít-ra-en kiêu ngạo, tội nó tố cáo nó.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:18.325Z",
      "updatedAt": "2025-09-03T03:21:18.325Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "9a2c6f1f-c03b-4ee0-a49a-0a8ee614132d",
      "text": "Chúng đâu chịu trở về",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:18.353Z",
      "updatedAt": "2025-09-03T03:21:18.353Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "3c9ba6dd-8f4a-4a1e-a0ff-1820a308e74a",
      "text": "với ĐỨC CHÚA là Thiên Chúa của chúng.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:18.381Z",
      "updatedAt": "2025-09-03T03:21:18.381Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "da86229d-81b4-4b09-8df2-fe3086ac2e83",
      "text": "Sự thể đã rành rành như vậy",
      "label": "10",
      "number": 10,
      "subVerseIndex": 3,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:18.424Z",
      "updatedAt": "2025-09-03T03:21:18.424Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "830f5cf6-4902-4f89-8a3c-70bff6730e82",
      "text": "mà chúng cũng chẳng kiếm tìm Người.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 4,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:18.438Z",
      "updatedAt": "2025-09-03T03:21:18.438Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "87f13f35-20d1-481e-bea4-f7489fd04076",
      "text": "Ép-ra-im vô tâm vô trí tựa bồ câu khờ dại.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:18.466Z",
      "updatedAt": "2025-09-03T03:21:18.466Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "5acda3c8-f73d-4dfe-b19c-684207380624",
      "text": "Chúng cầu cứu Ai-cập, chạy đến với Át-sua.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:18.509Z",
      "updatedAt": "2025-09-03T03:21:18.509Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "fea78d8c-1ab6-4437-adc9-9da11773bacf",
      "text": "Chúng lên đường là Ta bủa lưới bắt chúng.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:18.580Z",
      "updatedAt": "2025-09-03T03:21:18.580Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "6dc17e2e-b665-4146-9261-7a803458deaa",
      "text": "Ta sẽ làm cho chúng sa lưới tựa chim trời.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:18.608Z",
      "updatedAt": "2025-09-03T03:21:18.608Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "1da7bef6-fd4d-4ead-974d-fc9b14d265df",
      "text": "Khi hay tin chúng cùng nhau hội họp, Ta liền sửa trị chúng.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:18.622Z",
      "updatedAt": "2025-09-03T03:21:18.622Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "18e4d783-de70-4777-8d07-f81ca0005ba5",
      "text": "Khốn cho chúng vì chúng đã lìa bỏ Ta.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:18.636Z",
      "updatedAt": "2025-09-03T03:21:18.636Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "2bed2843-99a9-4e80-85fc-2b1b91df1c65",
      "text": "Chúng sẽ bị tiêu diệt, vì đã dám xúc phạm đến Ta.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:18.673Z",
      "updatedAt": "2025-09-03T03:21:18.673Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "2098fd97-d076-46e5-b98d-6351b14e7140",
      "text": "Ta, Ta muốn giải cứu chúng,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:18.685Z",
      "updatedAt": "2025-09-03T03:21:18.685Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "6adad8e1-5648-4a0e-a4bf-2b24a6459ba7",
      "text": "còn chúng lại nói lời gian dối phạm đến Ta.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 3,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:18.713Z",
      "updatedAt": "2025-09-03T03:21:18.713Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "e32853b4-7ead-45fc-919e-f4652117ac0b",
      "text": "Chúng kêu lên Ta mà chẳng thật lòng,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:18.726Z",
      "updatedAt": "2025-09-03T03:21:18.726Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "00b6eeea-7597-4ba6-979c-5d461ec93773",
      "text": "chỉ than vãn trên giường nằm của chúng.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:18.743Z",
      "updatedAt": "2025-09-03T03:21:18.743Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "bd20498a-8aad-4572-9fa0-3eb7003e9c64",
      "text": "Chúng tự rạch mình, mong có được lúa mì, rượu mới,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 2,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:18.758Z",
      "updatedAt": "2025-09-03T03:21:18.758Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "4c424da8-5d6a-4045-a149-9b66397ff5aa",
      "text": "chúng đã phản bội Ta.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 3,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:18.779Z",
      "updatedAt": "2025-09-03T03:21:18.779Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "ca7980c7-1280-410a-b19a-f2c6802b5c4a",
      "text": "Ta vừa uốn nắn, vừa làm cho cánh tay chúng nên mạnh mẽ,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:18.793Z",
      "updatedAt": "2025-09-03T03:21:18.793Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "f14acbbb-ea67-4bb8-a446-b7c66b919b88",
      "text": "nhưng chúng lại mưu đồ chống lại Ta.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:18.821Z",
      "updatedAt": "2025-09-03T03:21:18.821Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "d64acef7-66c8-4a60-b66a-0fc13b6bf37f",
      "text": "Chúng quay về với cái hư không.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:18.835Z",
      "updatedAt": "2025-09-03T03:21:18.835Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "56465793-3f70-44d2-b13b-6f4ee438bf7e",
      "text": "Chúng chẳng khác nào cánh cung sai chạy.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:18.849Z",
      "updatedAt": "2025-09-03T03:21:18.849Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "5d2d2680-606d-4e27-b32c-047040436768",
      "text": "Thủ lãnh chúng ngã gục dưới lưỡi gươm,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 2,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:18.877Z",
      "updatedAt": "2025-09-03T03:21:18.877Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "359dce87-9007-42b8-9350-57e7f45c3e04",
      "text": "vì thốt ra những lời giận dữ ;",
      "label": "16",
      "number": 16,
      "subVerseIndex": 3,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:18.891Z",
      "updatedAt": "2025-09-03T03:21:18.891Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    },
    {
      "id": "ae17f57f-5cd5-4722-b71f-2aeee5c2fb3e",
      "text": "trong đất Ai-cập, chúng sẽ nên trò cười.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 4,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:18.919Z",
      "updatedAt": "2025-09-03T03:21:18.919Z",
      "chapterId": "2d00998a-51ff-449a-8d64-b2b6f6c3b6a2"
    }
