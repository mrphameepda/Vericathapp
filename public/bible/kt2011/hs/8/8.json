{
  "chapter": {
    "id": "00caa076-a4e6-49df-a0c7-a9a929d94787",
    "number": 8,
    "createdAt": "2025-09-03T01:07:51.809Z",
    "updatedAt": "2025-09-03T01:07:51.809Z",
    "bookId": "11aabdfa-f668-4d41-962c-372a8b9257be"
  },
  "verses": [
    {
      "id": "9a6aae7c-5c03-44e7-a392-72e6da46cd11",
      "text": "Thổi kèn báo động đi !",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:24.341Z",
      "updatedAt": "2025-09-03T03:21:24.341Z",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "f30528f9-b726-4b71-aac4-7e9686832e30",
      "text": "Như phượng hoàng, tai hoạ chụp xuống nhà ĐỨC CHÚA,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:24.389Z",
      "updatedAt": "2025-09-03T03:21:24.389Z",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "ac0543d7-170c-483f-9f58-2dd041c1f2be",
      "text": "vì chúng không tuân giữ giao ước của Ta,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:24.418Z",
      "updatedAt": "2025-09-03T03:21:24.418Z",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "b5429ffa-6316-4572-87f8-999874223d7b",
      "text": "và vi phạm lề luật Ta truyền dạy.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 3,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:24.445Z",
      "updatedAt": "2025-09-03T03:21:24.445Z",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "2c9a7c1d-6b9f-4934-b1ea-c47507af53e3",
      "text": "Chúng lớn tiếng kêu lên Ta :",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:24.460Z",
      "updatedAt": "2025-09-03T03:21:24.460Z",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "7265f864-e124-4380-8ae4-29bab9f2091d",
      "text": "“Lạy Thiên Chúa chúng con, chúng con là Ít-ra-en,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:24.488Z",
      "updatedAt": "2025-09-03T03:21:24.488Z",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "27f67bff-2fb1-42aa-9a4e-76e2203dd232",
      "text": "chúng con nhận biết Ngài.”",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:24.517Z",
      "updatedAt": "2025-09-03T03:21:24.517Z",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "7ae53b5e-610d-449a-b6f1-6a2653ae7043",
      "text": "Thế nhưng, điều tốt lành, Ít-ra-en đã gạt bỏ,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:24.531Z",
      "updatedAt": "2025-09-03T03:21:24.531Z",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "2862bb89-34d2-45c6-a89e-aaf05737155d",
      "text": "nên nó sẽ bị quân thù đuổi bắt.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:24.559Z",
      "updatedAt": "2025-09-03T03:21:24.559Z",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "ae12dd23-233b-42f5-b538-7fa176102241",
      "text": "Chúng phong vương người mà Ta không chọn,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:24.573Z",
      "updatedAt": "2025-09-03T03:21:24.573Z",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "7f4193ea-1c01-419f-b167-8c14f50cc322",
      "text": "tôn làm lãnh tụ kẻ Ta không biết,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:24.615Z",
      "updatedAt": "2025-09-03T03:21:24.615Z",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "8f622d84-d853-4ffc-bcce-99c4a4d8e87c",
      "text": "dùng bạc vàng làm ra ngẫu tượng, để rồi bị đập tan.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:24.629Z",
      "updatedAt": "2025-09-03T03:21:24.629Z",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "0e3ed2fc-3034-4c3e-b058-761a4969948e",
      "text": "Hỡi Sa-ma-ri, hãy gạt bỏ con bê của ngươi",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:24.642Z",
      "updatedAt": "2025-09-03T03:21:24.642Z",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "f7a323cd-e33d-4bde-a5c8-eae5ebbd7067",
      "text": "–chúng làm Ta nổi giận.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:24.671Z",
      "updatedAt": "2025-09-03T03:21:24.671Z",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "dbb7c65d-6f97-48ca-98b0-cc68c75565ea",
      "text": "Chúng không chịu để cho Ta thanh tẩy mãi cho tới bao giờ ?–",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:24.685Z",
      "updatedAt": "2025-09-03T03:21:24.685Z",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "44de23c1-a073-4145-a3d3-1e47371466cb",
      "text": "Vì con bê đó là do Ít-ra-en làm ra,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:24.699Z",
      "updatedAt": "2025-09-03T03:21:24.699Z",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "0fa8c2c5-d350-424c-84ab-4f69d796eb1e",
      "text": "do một nghệ nhân sản xuất, nó đâu phải là thần !",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:24.741Z",
      "updatedAt": "2025-09-03T03:21:24.741Z",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "ad8a2be2-7f0c-449f-a583-7730663a35e8",
      "text": "Chắc chắn con bê của Sa-ma-ri sẽ như thể mùn cưa.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:24.769Z",
      "updatedAt": "2025-09-03T03:21:24.769Z",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "a6655d96-d6b0-44da-86bd-c94ca937ac4d",
      "text": "Chúng gieo gió thì phải gặt bão.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:24.798Z",
      "updatedAt": "2025-09-03T03:21:24.798Z",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "e9c63f0e-6112-444a-af1c-eaa5f63a7433",
      "text": "Chúng là cây lúa không làm đòng, là hạt lúa lép không có bột,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:24.826Z",
      "updatedAt": "2025-09-03T03:21:24.826Z",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "b6d7330b-850a-4b63-ab7c-41a07b72533c",
      "text": "nhưng giả như có bột, thì ngoại bang cũng sẽ nuốt hết.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:24.841Z",
      "updatedAt": "2025-09-03T03:21:24.841Z",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "ab023c17-0636-4c89-832d-7d006d70da79",
      "text": "Ít-ra-en đã bị nuốt chửng.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:24.855Z",
      "updatedAt": "2025-09-03T03:21:24.855Z",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "de5ae04c-9ec3-4e7a-ba5c-ee9f3ccb5712",
      "text": "Giờ đây chúng ở lẫn với chư dân, như một vật chẳng ai ưa thích.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:24.910Z",
      "updatedAt": "2025-09-03T03:21:24.910Z",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "31a814db-0322-4c93-b910-559c5c298efa",
      "text": "Chính chúng đã lên với Át-sua.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:24.924Z",
      "updatedAt": "2025-09-03T03:21:24.924Z",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "7ba33bcb-55f6-45fa-bc0f-9d804b01acf2",
      "text": "Con lừa hoang còn thích sống độc lập,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:24.965Z",
      "updatedAt": "2025-09-03T03:21:24.965Z",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "573a7d9a-b52a-446d-a842-f7d4b9cdc00d",
      "text": "nhưng Ép-ra-im lại tặng quà để có tình nhân.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:24.979Z",
      "updatedAt": "2025-09-03T03:21:24.979Z",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "5f5511ce-1b45-4a4f-b1eb-38e7cd2a30e7",
      "text": "Dù chúng có đem quà tặng chư dân,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:25.040Z",
      "updatedAt": "2025-09-03T03:21:25.040Z",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "f38d8893-2cb3-40df-b276-5b803791d72a",
      "text": "thì giờ đây Ta cũng gom chúng lại,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:25.054Z",
      "updatedAt": "2025-09-03T03:21:25.054Z",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "ac30a672-9710-4cbb-aa34-798b803c2ca0",
      "text": "và chẳng bao lâu nữa, chúng sẽ phải khốn khổ lao đao",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:25.068Z",
      "updatedAt": "2025-09-03T03:21:25.068Z",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "4c881fd5-3577-400a-9068-7d3e343895b5",
      "text": "dưới gánh nặng của vua các thủ lãnh.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 3,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:25.082Z",
      "updatedAt": "2025-09-03T03:21:25.082Z",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "849b73a9-8622-4342-83c6-482766c28348",
      "text": "Khi Ép-ra-im đua nhau dựng bàn thờ, thì các bàn thờ ấy",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:25.110Z",
      "updatedAt": "2025-09-03T03:21:25.110Z",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "5e8e473a-8453-4e2a-bbf4-8d8d4e87c335",
      "text": "chỉ làm cho chúng phạm tội thêm.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:25.152Z",
      "updatedAt": "2025-09-03T03:21:25.152Z",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "c7d5593d-a4a4-4aca-a84f-aee8593ce175",
      "text": "Luật lệ của Ta, Ta có viết cho nó cả ngàn,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:25.165Z",
      "updatedAt": "2025-09-03T03:21:25.165Z",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "ffeef567-e464-4af4-a318-f5be4c5c3c89",
      "text": "thì nó cũng coi là xa lạ.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:25.179Z",
      "updatedAt": "2025-09-03T03:21:25.179Z",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "39ebe9e3-f940-4d3d-a987-1514e666c968",
      "text": "Hy lễ dâng Ta thì chúng cứ dâng,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:25.194Z",
      "updatedAt": "2025-09-03T03:21:25.194Z",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "0d8ab6e3-afbd-4086-9c90-efb393c643df",
      "text": "chúng cứ ăn thịt đã sát tế,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:25.208Z",
      "updatedAt": "2025-09-03T03:21:25.208Z",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "4eccbd7f-b3bf-4015-bebc-4aed71c5fdd8",
      "text": "nhưng ĐỨC CHÚA sẽ chẳng đoái hoài.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:25.222Z",
      "updatedAt": "2025-09-03T03:21:25.222Z",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "f288cfa4-5cef-4bda-ac68-7e9e0bbfe919",
      "text": "Giờ đây Người sẽ nhớ lại sự gian ác của chúng,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 3,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:25.264Z",
      "updatedAt": "2025-09-03T03:21:25.264Z",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "a9857f44-0369-4f56-acb6-ae51afcac7fd",
      "text": "chúng đã phạm tội thì chúng sẽ phải đền :",
      "label": "13",
      "number": 13,
      "subVerseIndex": 4,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:25.289Z",
      "updatedAt": "2025-09-03T03:21:25.289Z",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "d72e9ebb-cc48-4a69-8eab-5ef48bb06030",
      "text": "chúng sẽ phải trở về Ai-cập.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 5,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:25.301Z",
      "updatedAt": "2025-09-03T03:21:25.301Z",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "a5a1bd4e-e7af-4920-8008-249e6110d2bc",
      "text": "Ít-ra-en đã quên Đấng tác tạo ra nó, và lo xây đền đài ;",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:25.342Z",
      "updatedAt": "2025-09-03T03:21:25.342Z",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "31b5a192-1591-4055-853c-accc28fec5b7",
      "text": "còn Giu-đa thì xây thêm những thành kiên cố.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:25.369Z",
      "updatedAt": "2025-09-03T03:21:25.369Z",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "ca09e38f-dc8f-44b6-800e-3968efd4a10c",
      "text": "Nhưng Ta sẽ phóng lửa xuống các thành này,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 2,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:25.397Z",
      "updatedAt": "2025-09-03T03:21:25.397Z",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "5d0a61ad-b7ea-415d-811c-ec2e4e69d114",
      "text": "và lửa sẽ ngốn hết các dinh thự.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 3,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:21:25.426Z",
      "updatedAt": "2025-09-03T03:21:25.426Z",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    }
