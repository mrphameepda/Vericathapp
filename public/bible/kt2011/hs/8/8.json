      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "bfc6e6c9-f4c0-494d-b094-86a018727a8c",
      "text": "Ít-ra-en bị tiêu diệt vì cầu cứu ngoại bang",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:21:24.869Z",
      "updatedAt": "2025-09-03T03:21:24.869Z",
      "verseId": "ab023c17-0636-4c89-832d-7d006d70da79",
      "chapterId": "00caa076-a4e6-49df-a0c7-a9a929d94787"
    },
    {
      "id": "70a7bcfa-6402-4f75-a68c-efcc5acd35e5",
      "text": "Chống nền phụng tự vụ hình thức",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:21:25.124Z",
