    },
    {
      "id": "795e6677-90da-4a5b-a1f7-dcb0ed7f3bea",
      "text": "Xã hội hỗn loạn vì dân Chúa thờ ngẫu tượng",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:21:24.587Z",
      "updatedAt": "2025-09-03T03:21:24.587Z",
