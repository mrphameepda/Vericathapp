    {
      "id": "29176e50-a848-4e54-8d71-214d41d3c707",
      "text": "Báo động",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:21:24.359Z",
      "updatedAt": "2025-09-03T03:21:24.359Z",
