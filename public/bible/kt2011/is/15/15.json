{
  "chapter": {
    "id": "52b5874e-d91d-4762-b2d0-03081242169b",
    "number": 15,
    "createdAt": "2025-09-03T01:07:51.736Z",
    "updatedAt": "2025-09-03T01:07:51.736Z",
    "bookId": "d17ae149-2718-48e5-b452-c522381bf71a"
  },
  "verses": [
    {
      "id": "eb87053c-90f5-4783-a76b-95900847e220",
      "text": "Lời sấm hạch tội Mô-áp.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:56:52.926Z",
      "updatedAt": "2025-09-03T02:56:52.926Z",
      "chapterId": "52b5874e-d91d-4762-b2d0-03081242169b"
    },
    {
      "id": "ffee8e0a-bd12-4142-abad-9da560fe94a7",
      "text": "Phải, giữa đêm khuya, thành A Mô-áp",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:56:53Z",
      "updatedAt": "2025-09-03T02:56:53Z",
      "chapterId": "52b5874e-d91d-4762-b2d0-03081242169b"
    },
    {
      "id": "8e56b6fd-3cc7-470c-a7c0-319b1d1f7ac5",
      "text": "bị tàn phá và phải tiêu vong.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:56:53.043Z",
      "updatedAt": "2025-09-03T02:56:53.043Z",
      "chapterId": "52b5874e-d91d-4762-b2d0-03081242169b"
    },
    {
      "id": "2ce5c37e-fd2f-4935-a5ba-f0feca317c82",
      "text": "Phải, giữa đêm khuya, thành Kia Mô-áp",
      "label": "1",
      "number": 1,
      "subVerseIndex": 3,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:56:53.067Z",
      "updatedAt": "2025-09-03T02:56:53.067Z",
      "chapterId": "52b5874e-d91d-4762-b2d0-03081242169b"
    },
    {
      "id": "6930c6b4-d187-4b52-b9a1-2a7ed53f18db",
      "text": "bị tàn phá và phải tiêu vong.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 4,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:56:53.095Z",
      "updatedAt": "2025-09-03T02:56:53.095Z",
      "chapterId": "52b5874e-d91d-4762-b2d0-03081242169b"
    },
    {
      "id": "cfb9ea17-188e-4c16-ada1-9deeec8be65c",
      "text": "Dân Đi-vôn lên những nơi cao mà khóc lóc ;",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:56:53.109Z",
      "updatedAt": "2025-09-03T02:56:53.109Z",
      "chapterId": "52b5874e-d91d-4762-b2d0-03081242169b"
    },
    {
      "id": "df51fd71-0a12-4846-8e81-7d4a1c760b83",
      "text": "Mô-áp rên siết tại Nơ-vô và Mê-đơ-va.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:56:53.151Z",
      "updatedAt": "2025-09-03T02:56:53.151Z",
      "chapterId": "52b5874e-d91d-4762-b2d0-03081242169b"
    },
    {
      "id": "1d77ddcd-1d6e-4d13-b9b5-e58b0c1498d2",
      "text": "Người nào cũng để đầu trọc và râu cạo nhẵn.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:56:53.206Z",
      "updatedAt": "2025-09-03T02:56:53.206Z",
      "chapterId": "52b5874e-d91d-4762-b2d0-03081242169b"
    },
    {
      "id": "e8e62c23-a386-467d-abd7-c084af0307c4",
      "text": "Ngoài phố phường, người ta mặc áo vải thô ;",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:56:53.234Z",
      "updatedAt": "2025-09-03T02:56:53.234Z",
      "chapterId": "52b5874e-d91d-4762-b2d0-03081242169b"
    },
    {
      "id": "2442639a-76bd-4a08-bf63-7a80955721c5",
      "text": "trên mái nhà và tại các quảng trường,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:56:53.248Z",
      "updatedAt": "2025-09-03T02:56:53.248Z",
      "chapterId": "52b5874e-d91d-4762-b2d0-03081242169b"
    },
    {
      "id": "c8f91a36-ac99-4ab6-9d21-c538ec764267",
      "text": "mọi người đều rên siết và khóc lóc thảm thương.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:56:53.265Z",
      "updatedAt": "2025-09-03T02:56:53.265Z",
      "chapterId": "52b5874e-d91d-4762-b2d0-03081242169b"
    },
    {
      "id": "508693d6-d0eb-40d7-b00e-a2472ab2ce38",
      "text": "Khét-bôn và En-a-lê kêu la, tiếng chúng thấu đến tận Gia-hát.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:56:53.278Z",
      "updatedAt": "2025-09-03T02:56:53.278Z",
      "chapterId": "52b5874e-d91d-4762-b2d0-03081242169b"
    },
    {
      "id": "0b08bb60-fc29-4805-b58b-899da376fa60",
      "text": "Vì thế, lòng dạ Mô-áp run rẩy,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:56:53.366Z",
      "updatedAt": "2025-09-03T02:56:53.366Z",
      "chapterId": "52b5874e-d91d-4762-b2d0-03081242169b"
    },
    {
      "id": "c2787961-300e-4f1c-8dd1-f214521611b7",
      "text": "hồn Mô-áp cũng run rẩy cho số phận mình.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:56:53.395Z",
      "updatedAt": "2025-09-03T02:56:53.395Z",
      "chapterId": "52b5874e-d91d-4762-b2d0-03081242169b"
    },
    {
      "id": "ede6a9c7-1bfb-4b9b-8c63-c1a729f94b5f",
      "text": "Lòng tôi kêu gào bênh vực Mô-áp ;",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:56:53.424Z",
      "updatedAt": "2025-09-03T02:56:53.424Z",
      "chapterId": "52b5874e-d91d-4762-b2d0-03081242169b"
    },
    {
      "id": "028d2a0d-0113-496c-aa32-d08d4c57ba98",
      "text": "những người dân tị nạn đã đến tận Xô-a và Éc-lát Sơ-li-si-gia.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:56:53.481Z",
      "updatedAt": "2025-09-03T02:56:53.481Z",
      "chapterId": "52b5874e-d91d-4762-b2d0-03081242169b"
    },
    {
      "id": "14a6504b-a08b-4a3d-ad7b-8a1e0684e4c0",
      "text": "Thật vậy, tại dốc Lu-khít, họ vừa trèo vừa khóc ;",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:56:53.538Z",
      "updatedAt": "2025-09-03T02:56:53.538Z",
      "chapterId": "52b5874e-d91d-4762-b2d0-03081242169b"
    },
    {
      "id": "c70e390d-9f09-426d-ae52-11eb01f61d0b",
      "text": "quả thế, trên đường Khô-rô-na-gim,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 3,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:56:53.566Z",
      "updatedAt": "2025-09-03T02:56:53.566Z",
      "chapterId": "52b5874e-d91d-4762-b2d0-03081242169b"
    },
    {
      "id": "91bb3702-2e9f-45b7-a06c-518d0c8f0ef8",
      "text": "họ thốt lên những tiếng kêu than thảm bại.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 4,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:56:53.594Z",
      "updatedAt": "2025-09-03T02:56:53.594Z",
      "chapterId": "52b5874e-d91d-4762-b2d0-03081242169b"
    },
    {
      "id": "6291a3ca-e908-4a80-a07c-c6db2262e190",
      "text": "Thật vậy, dòng nước Nim-rim thành nơi hoang tàn ;",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:56:53.608Z",
      "updatedAt": "2025-09-03T02:56:53.608Z",
      "chapterId": "52b5874e-d91d-4762-b2d0-03081242169b"
    },
    {
      "id": "3253cbbc-beee-47e7-b5d2-3f88221416ae",
      "text": "thật vậy, cỏ úa khô, cây chết héo, màu xanh cũng chẳng còn.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:56:53.637Z",
      "updatedAt": "2025-09-03T02:56:53.637Z",
      "chapterId": "52b5874e-d91d-4762-b2d0-03081242169b"
    },
    {
      "id": "3d2f5b31-fe85-467f-b604-04d04ec3fcc8",
      "text": "Vì thế, những gì đã kiếm được hay để dành,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:56:53.651Z",
      "updatedAt": "2025-09-03T02:56:53.651Z",
      "chapterId": "52b5874e-d91d-4762-b2d0-03081242169b"
    },
    {
      "id": "c308e50e-d351-47f4-ab74-90e6f7cb2f8a",
      "text": "họ đều phải chuyển qua bên kia Thác Liễu.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:56:53.665Z",
      "updatedAt": "2025-09-03T02:56:53.665Z",
      "chapterId": "52b5874e-d91d-4762-b2d0-03081242169b"
    },
    {
      "id": "b630e1a5-cf7a-4667-bbb4-e229a1f8d9b7",
      "text": "Thật vậy, tiếng kêu la vọng khắp lãnh thổ Mô-áp,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:56:53.693Z",
      "updatedAt": "2025-09-03T02:56:53.693Z",
      "chapterId": "52b5874e-d91d-4762-b2d0-03081242169b"
    },
    {
      "id": "712e47ed-a420-42b8-a914-93745cb3cf88",
      "text": "tiếng rên siết vang đến tận Éc-la-gim,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:56:53.721Z",
      "updatedAt": "2025-09-03T02:56:53.721Z",
      "chapterId": "52b5874e-d91d-4762-b2d0-03081242169b"
    },
    {
      "id": "8589697f-e306-46ff-baa8-b7346e4022fe",
      "text": "tiếng rên siết thấu đến tận Bơ-e Ê-lim.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:56:53.749Z",
      "updatedAt": "2025-09-03T02:56:53.749Z",
      "chapterId": "52b5874e-d91d-4762-b2d0-03081242169b"
    },
    {
      "id": "98fe075a-a31c-46f6-b457-24df8a4980a4",
      "text": "Thật vậy, dòng nước Đi-môn đầy những máu !",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:56:53.776Z",
      "updatedAt": "2025-09-03T02:56:53.776Z",
      "chapterId": "52b5874e-d91d-4762-b2d0-03081242169b"
    },
    {
      "id": "81c93948-fd9b-4847-8c6e-c51c22fe8d31",
      "text": "Ta sẽ giáng thêm cho Đi-môn những tai hoạ khác nữa",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:56:53.822Z",
      "updatedAt": "2025-09-03T02:56:53.822Z",
      "chapterId": "52b5874e-d91d-4762-b2d0-03081242169b"
    },
    {
      "id": "27e73fba-7b77-4ba4-9a7e-1dd8dccab040",
      "text": "là cho sư tử đuổi theo những người Mô-áp thoát nạn",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:56:53.850Z",
      "updatedAt": "2025-09-03T02:56:53.850Z",
      "chapterId": "52b5874e-d91d-4762-b2d0-03081242169b"
    },
    {
      "id": "fe1c3352-bf4a-4a0d-981d-884d2a438483",
      "text": "và những kẻ còn sót lại trên đất.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 3,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:56:53.877Z",
      "updatedAt": "2025-09-03T02:56:53.877Z",
      "chapterId": "52b5874e-d91d-4762-b2d0-03081242169b"
    }
  ],
