{
  "chapter": {
    "id": "ff84bd10-c9b7-43e8-bc43-7071949b4480",
    "number": 16,
    "createdAt": "2025-09-03T01:07:51.736Z",
    "updatedAt": "2025-09-03T01:07:51.736Z",
    "bookId": "d17ae149-2718-48e5-b452-c522381bf71a"
  },
  "verses": [
    {
      "id": "00b0f370-8191-46d4-8f6c-5598a04703e8",
      "text": "Hãy gửi con chiên của người cầm đầu xứ sở",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:56:59.943Z",
      "updatedAt": "2025-09-03T02:56:59.943Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "2f1909bc-141a-4e10-8d1d-0ee59e2e3d4c",
      "text": "từ Xe-la qua sa mạc đến núi của thiếu nữ Xi-on.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:56:59.997Z",
      "updatedAt": "2025-09-03T02:56:59.997Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "1fa1bfa4-74b7-4ee4-ba7e-da886a8da6e0",
      "text": "Bấy giờ, tại khúc cạn Ác-nôn,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:00.039Z",
      "updatedAt": "2025-09-03T02:57:00.039Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "96ad95d1-2f5b-4a28-a246-7237270c2761",
      "text": "thiếu nữ Mô-áp sẽ chạy trốn như đàn chim vỡ tổ.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:00.068Z",
      "updatedAt": "2025-09-03T02:57:00.068Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "74a3cf62-c490-43cc-99dd-dee0f9a627af",
      "text": "Chúng kêu cầu : “Xin cho ý kiến, xin lấy quyết định :",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:00.096Z",
      "updatedAt": "2025-09-03T02:57:00.096Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "7c7a5919-d5d1-4807-b93d-2ba216fce163",
      "text": "giữa ban trưa, xin toả bóng như màn đêm bao phủ,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:00.124Z",
      "updatedAt": "2025-09-03T02:57:00.124Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "779a397f-43f8-458b-9e11-80bd0208d4a4",
      "text": "xin che giấu những kẻ lưu đày,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:00.138Z",
      "updatedAt": "2025-09-03T02:57:00.138Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "dbd3042d-1f2e-42da-b4b3-06a8a057a71f",
      "text": "và đừng tố giác những người chạy trốn.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 3,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:00.152Z",
      "updatedAt": "2025-09-03T02:57:00.152Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "18cbf85a-e23a-4f20-9477-b1cb9e099afb",
      "text": "Xin cho những người Mô-áp bị xua đuổi",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:00.166Z",
      "updatedAt": "2025-09-03T02:57:00.166Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "76cee37b-622c-49c9-9d86-7effee543bc4",
      "text": "được trú ngụ bên quý quốc,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:00.209Z",
      "updatedAt": "2025-09-03T02:57:00.209Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "ee0661bf-558d-4e4e-a00d-3fc01d77a6f4",
      "text": "xin nên chỗ cho họ ẩn thân tránh người tàn phá,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:00.222Z",
      "updatedAt": "2025-09-03T02:57:00.222Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "d2737340-7694-4bb0-942b-1635065b050e",
      "text": "vì khi kẻ áp bức lìa đời, lúc cơn tàn phá chấm dứt",
      "label": "4",
      "number": 4,
      "subVerseIndex": 3,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:00.242Z",
      "updatedAt": "2025-09-03T02:57:00.242Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "f8920e26-9ece-476c-b280-083fe5417de2",
      "text": "và kẻ giày xéo xứ sở biến đi,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 4,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:00.256Z",
      "updatedAt": "2025-09-03T02:57:00.256Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "58f76b41-3fd8-4492-9f4d-7baaf9ced44d",
      "text": "thì ngai báu sẽ được vững bền nhờ lòng nhân nghĩa.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:00.271Z",
      "updatedAt": "2025-09-03T02:57:00.271Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "d4537aa0-8428-4144-b80a-946518d619e2",
      "text": "Trong lều vua Đa-vít,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:00.285Z",
      "updatedAt": "2025-09-03T02:57:00.285Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "cc181a38-ddcc-43bd-b74b-320c5a552c12",
      "text": "một vị thẩm phán sẽ ngự trên ngai nhờ đức tín thành.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:00.314Z",
      "updatedAt": "2025-09-03T02:57:00.314Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "0cb73cde-bf57-4d3c-8175-50223914a6e8",
      "text": "Vị ấy lo tìm kiếm điều chính trực,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 3,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:00.328Z",
      "updatedAt": "2025-09-03T02:57:00.328Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "bf334418-01e2-472b-b1ba-2b22fea16fd3",
      "text": "và mau mắn thực hiện lẽ công minh.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 4,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:00.342Z",
      "updatedAt": "2025-09-03T02:57:00.342Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "95945c17-7410-4811-a291-1e0d93c8b3e8",
      "text": "Chúng ta đã biết tính kiêu căng của Mô-áp,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:00.356Z",
      "updatedAt": "2025-09-03T02:57:00.356Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "1ab67117-6f6e-4a9e-b450-9f1d4f274b67",
      "text": "một dân rất kiêu căng.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:00.385Z",
      "updatedAt": "2025-09-03T02:57:00.385Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "c0da5d6a-03bc-4f0d-86f2-acd2158ca0dd",
      "text": "Thói ngạo mạn, tính kiêu căng, vẻ điên khùng",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:00.399Z",
      "updatedAt": "2025-09-03T02:57:00.399Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "274b6a2d-a03e-4a3d-a67b-0dd828992b84",
      "text": "cùng những lời ngu ngốc của nó, chúng ta đều biết cả.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 3,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:00.412Z",
      "updatedAt": "2025-09-03T02:57:00.412Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "103f39bb-5b27-47d9-bdd4-19c87b3b916d",
      "text": "Vì thế, Mô-áp rên siết về chính thân phận mình,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:00.427Z",
      "updatedAt": "2025-09-03T02:57:00.427Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "b14352a0-75eb-433d-9633-592fb98d27a1",
      "text": "toàn dân cùng rên siết, ai nấy đều phủ phục khóc than,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:00.509Z",
      "updatedAt": "2025-09-03T02:57:00.509Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "c3d3c821-f82e-49e7-8612-5ae5947dde94",
      "text": "tiếc những cái bánh nho ở Kia Kha-re-xét,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:00.523Z",
      "updatedAt": "2025-09-03T02:57:00.523Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "12dd0f85-71fc-45fe-a011-f741608ff186",
      "text": "vì những vườn nho Khét-bôn,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:00.551Z",
      "updatedAt": "2025-09-03T02:57:00.551Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "cc9b262a-1d65-4a4f-9faf-4c9275b2c34f",
      "text": "cũng như cây nho Xíp-ma đã héo tàn.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:00.580Z",
      "updatedAt": "2025-09-03T02:57:00.580Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "1feb7c01-9182-4d90-909b-03f1e93b877d",
      "text": "Những chùm nho quý của nó",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:00.607Z",
      "updatedAt": "2025-09-03T02:57:00.607Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "17e554e9-7ced-4b48-bbcf-f5f7f5985bfb",
      "text": "đã làm cho những người thống trị các dân phải ngã gục.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 3,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:00.621Z",
      "updatedAt": "2025-09-03T02:57:00.621Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "d78edb79-4b59-469c-b599-4e9fac84a427",
      "text": "Cây nho ấy từng vươn tới Gia-de, lan mãi vào sa mạc ;",
      "label": "8",
      "number": 8,
      "subVerseIndex": 4,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:00.635Z",
      "updatedAt": "2025-09-03T02:57:00.635Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "b62f2b2a-ff80-41ae-bf1f-f4542a29e900",
      "text": "nhánh của nó toả ra vượt qua biển cả.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 5,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:00.662Z",
      "updatedAt": "2025-09-03T02:57:00.662Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "eb43d437-d05a-4493-89b7-02d77bcf7d33",
      "text": "Vì thế, cùng với tiếng dân Gia-de nức nở,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:00.675Z",
      "updatedAt": "2025-09-03T02:57:00.675Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "279508fd-5c77-4b08-887c-a464abc275ac",
      "text": "ta khóc thương cây nho Xíp-ma.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:00.696Z",
      "updatedAt": "2025-09-03T02:57:00.696Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "a2a21ce2-997e-436d-a8b6-2521f39a50a6",
      "text": "Vì ngươi, nước mắt ta chan hoà, hỡi Khét-bôn và En-a-lê,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:00.718Z",
      "updatedAt": "2025-09-03T02:57:00.718Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "1dca0315-b651-4c6e-a764-c9140ff348db",
      "text": "vào thời ngươi hái nho và gặt lúa, tiếng hát câu hò đâu còn nữa !",
      "label": "9",
      "number": 9,
      "subVerseIndex": 3,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:00.756Z",
      "updatedAt": "2025-09-03T02:57:00.756Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "17372eed-06d4-42e3-8b29-ee4a9152f7dc",
      "text": "Niềm hân hoan vui sướng đã bị cất đi khỏi vườn cây ;",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:00.771Z",
      "updatedAt": "2025-09-03T02:57:00.771Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "ac676d41-3e9d-4a04-8549-552a72c8c743",
      "text": "trong vườn nho không còn tiếng reo mừng",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:00.786Z",
      "updatedAt": "2025-09-03T02:57:00.786Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "205741d8-733d-4b3e-8252-cd0d4e8b42aa",
      "text": "chẳng nghe tiếng hò la ;",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:00.800Z",
      "updatedAt": "2025-09-03T02:57:00.800Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "260c9514-09a8-4b4e-8ccb-d9cb56c384b5",
      "text": "không còn ai đạp nho trong các bồn ;",
      "label": "10",
      "number": 10,
      "subVerseIndex": 3,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:00.815Z",
      "updatedAt": "2025-09-03T02:57:00.815Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "273fa55a-6300-4c92-8f8f-da9dd4125e98",
      "text": "câu hò tiếng hát cũng im bặt.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 4,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:00.829Z",
      "updatedAt": "2025-09-03T02:57:00.829Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "2270d6cc-90b4-4374-84c0-3ceb587ef744",
      "text": "Bởi thế, lòng ta như cây đàn rung lên vì Mô-áp ;",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:00.842Z",
      "updatedAt": "2025-09-03T02:57:00.842Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "9554b36b-0acf-4c7e-9e1f-0b2c43caf79e",
      "text": "và vì Kia Khe-rét, ruột gan ta bồi hồi.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:00.865Z",
      "updatedAt": "2025-09-03T02:57:00.865Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "119e0122-1a36-455e-a884-47b6cd41f088",
      "text": "Bấy giờ, dù Mô-áp có ra mặt, có vất vả lên tận nơi cao,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:00.892Z",
      "updatedAt": "2025-09-03T02:57:00.892Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "ba028361-a5d1-4802-a9c4-441bea328d2e",
      "text": "có vào Thánh Điện để nguyện cầu, cũng chỉ luống công thôi.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:00.920Z",
      "updatedAt": "2025-09-03T02:57:00.920Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "3bc2ed7d-809e-4603-b947-9eb1caad2d15",
      "text": "Đó là lời ĐỨC CHÚA phán từ xưa về Mô-áp.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:57:00.934Z",
      "updatedAt": "2025-09-03T02:57:00.934Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    },
    {
      "id": "5b2bf806-08b8-48a0-802f-3e21424d4bc2",
      "text": "Và giờ đây ĐỨC CHÚA lại phán : Theo cách tính của người làm thuê thì còn đúng ba năm nữa, vinh quang của Mô-áp sẽ tàn tạ ; dù có đông vô số, dân nó cũng sẽ chỉ còn một số ít, rất ít, hầu như không đáng kể.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 1,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:57:00.978Z",
      "updatedAt": "2025-09-03T02:57:00.978Z",
      "chapterId": "ff84bd10-c9b7-43e8-bc43-7071949b4480"
    }
  ],
