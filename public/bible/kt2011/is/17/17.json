{
  "chapter": {
    "id": "5e8107d2-a5cf-46c1-9689-3b433b4a7696",
    "number": 17,
    "createdAt": "2025-09-03T01:07:51.736Z",
    "updatedAt": "2025-09-03T01:07:51.736Z",
    "bookId": "d17ae149-2718-48e5-b452-c522381bf71a"
  },
  "verses": [
    {
      "id": "4ffb9551-5cf6-4888-bb62-981375f50bb6",
      "text": "Lời sấm hạch tội Đa-mát.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:06.636Z",
      "updatedAt": "2025-09-03T02:57:06.636Z",
      "chapterId": "5e8107d2-a5cf-46c1-9689-3b433b4a7696"
    },
    {
      "id": "3d18d968-3d50-4232-9bc5-c9b00a7f69b4",
      "text": "Này đây Đa-mát bị xoá sổ, không còn phải là thành,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:06.730Z",
      "updatedAt": "2025-09-03T02:57:06.730Z",
      "chapterId": "5e8107d2-a5cf-46c1-9689-3b433b4a7696"
    },
    {
      "id": "a4e8dd5e-cc0b-45bf-8096-7db1b8ddeced",
      "text": "mà chỉ là hoang tàn đổ nát.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:06.759Z",
      "updatedAt": "2025-09-03T02:57:06.759Z",
      "chapterId": "5e8107d2-a5cf-46c1-9689-3b433b4a7696"
    },
    {
      "id": "d4e3bed1-9f08-4d7a-a773-b879abef7cc4",
      "text": "Các thành miền A-rô-e bị bỏ hoang, dành cho các đàn vật ;",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:06.773Z",
      "updatedAt": "2025-09-03T02:57:06.773Z",
      "chapterId": "5e8107d2-a5cf-46c1-9689-3b433b4a7696"
    },
    {
      "id": "92a1edff-f129-4dde-a60c-0679893a2538",
      "text": "chúng đến nằm nghỉ mà không sợ hãi chi.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:06.816Z",
      "updatedAt": "2025-09-03T02:57:06.816Z",
      "chapterId": "5e8107d2-a5cf-46c1-9689-3b433b4a7696"
    },
    {
      "id": "f34d3168-65b0-4298-b9d2-c09fb7fff394",
      "text": "Ép-ra-im không còn tuyến phòng thủ,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:06.830Z",
      "updatedAt": "2025-09-03T02:57:06.830Z",
      "chapterId": "5e8107d2-a5cf-46c1-9689-3b433b4a7696"
    },
    {
      "id": "3c3cf2f3-ceda-4c65-a1fc-5c7928a4498e",
      "text": "Đa-mát mất vương quyền, số người của A-ram còn sót lại",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:06.857Z",
      "updatedAt": "2025-09-03T02:57:06.857Z",
      "chapterId": "5e8107d2-a5cf-46c1-9689-3b433b4a7696"
    },
    {
      "id": "7e049ece-2956-4758-ba65-26cb22ec8860",
      "text": "cũng sẽ giống như vinh quang của con cái Ít-ra-en.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:06.910Z",
      "updatedAt": "2025-09-03T02:57:06.910Z",
      "chapterId": "5e8107d2-a5cf-46c1-9689-3b433b4a7696"
    },
    {
      "id": "fb7e5089-8b28-40b0-ab30-a024570932a2",
      "text": "Sấm ngôn của ĐỨC CHÚA các đạo binh.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 3,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:06.939Z",
      "updatedAt": "2025-09-03T02:57:06.939Z",
      "chapterId": "5e8107d2-a5cf-46c1-9689-3b433b4a7696"
    },
    {
      "id": "09c67745-f193-4dab-aadb-9b2be89c2929",
      "text": "Trong ngày đó, vinh quang của Gia-cóp sẽ suy giảm,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:06.968Z",
      "updatedAt": "2025-09-03T02:57:06.968Z",
      "chapterId": "5e8107d2-a5cf-46c1-9689-3b433b4a7696"
    },
    {
      "id": "292fa019-9b69-4325-acfa-cab6db86148b",
      "text": "thân xác béo mập của nó sẽ gầy đi.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:07.010Z",
      "updatedAt": "2025-09-03T02:57:07.010Z",
      "chapterId": "5e8107d2-a5cf-46c1-9689-3b433b4a7696"
    },
    {
      "id": "a656caa3-a4d0-4e25-bc5e-1e8e18bc52e4",
      "text": "Ví như khi người ta gặt lúa ngày mùa",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:07.023Z",
      "updatedAt": "2025-09-03T02:57:07.023Z",
      "chapterId": "5e8107d2-a5cf-46c1-9689-3b433b4a7696"
    },
    {
      "id": "c4b74152-1ac9-4718-8f10-5228919a94d7",
      "text": "và đưa tay cắt những bông lúa,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:07.037Z",
      "updatedAt": "2025-09-03T02:57:07.037Z",
      "chapterId": "5e8107d2-a5cf-46c1-9689-3b433b4a7696"
    },
    {
      "id": "1810d338-dc0a-44a5-9af6-13a637588441",
      "text": "như khi người ta mót lúa ở thung lũng người Ra-pha,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:07.050Z",
      "updatedAt": "2025-09-03T02:57:07.050Z",
      "chapterId": "5e8107d2-a5cf-46c1-9689-3b433b4a7696"
    },
    {
      "id": "ca5b8aad-dbc6-43cd-88f4-0b92b25030e6",
      "text": "thì chỉ thấy mấy bông còn sót lại ;",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:07.102Z",
      "updatedAt": "2025-09-03T02:57:07.102Z",
      "chapterId": "5e8107d2-a5cf-46c1-9689-3b433b4a7696"
    },
    {
      "id": "35d8614b-cb49-495e-98e4-910bf1e235ba",
      "text": "hoặc như khi người ta hái ô-liu,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:07.122Z",
      "updatedAt": "2025-09-03T02:57:07.122Z",
      "chapterId": "5e8107d2-a5cf-46c1-9689-3b433b4a7696"
    },
    {
      "id": "49b662c7-9394-4fce-a537-199df1e4560f",
      "text": "thì chỉ còn vài ba trái chín trên ngọn",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:07.135Z",
      "updatedAt": "2025-09-03T02:57:07.135Z",
      "chapterId": "5e8107d2-a5cf-46c1-9689-3b433b4a7696"
    },
    {
      "id": "c1aa7734-6709-4394-90cc-983bed612f19",
      "text": "và bốn năm trái nơi đầu cành.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 3,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:07.150Z",
      "updatedAt": "2025-09-03T02:57:07.150Z",
      "chapterId": "5e8107d2-a5cf-46c1-9689-3b433b4a7696"
    },
    {
      "id": "fbff0d19-5b6c-4a7f-a83b-94d31ece5d39",
      "text": "Đó là sấm ngôn của ĐỨC CHÚA, Thiên Chúa của Ít-ra-en.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 4,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:07.170Z",
      "updatedAt": "2025-09-03T02:57:07.170Z",
      "chapterId": "5e8107d2-a5cf-46c1-9689-3b433b4a7696"
    },
    {
      "id": "02a58275-51e7-473b-afdc-946cc79a871e",
      "text": "Ngày ấy, con người sẽ ngước trông lên Đấng làm ra họ, và đưa mắt nhìn về Đức Thánh của Ít-ra-en.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:57:07.213Z",
      "updatedAt": "2025-09-03T02:57:07.213Z",
      "chapterId": "5e8107d2-a5cf-46c1-9689-3b433b4a7696"
    },
    {
      "id": "30a592db-c47f-4c20-a50c-247b62bb2902",
      "text": "Họ sẽ không còn ngước trông lên những bàn thờ tay họ làm ra, không nhìn về những cột thờ và hương án ngón tay họ làm thành.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 1,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:57:07.261Z",
      "updatedAt": "2025-09-03T02:57:07.261Z",
      "chapterId": "5e8107d2-a5cf-46c1-9689-3b433b4a7696"
    },
    {
      "id": "e1cb9ca1-e5c0-4b82-8a4c-e014fa14ac52",
      "text": "Ngày ấy, các thành thị Ít-ra-en trú ẩn sẽ bị bỏ hoang.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:07.303Z",
      "updatedAt": "2025-09-03T02:57:07.303Z",
      "chapterId": "5e8107d2-a5cf-46c1-9689-3b433b4a7696"
    },
    {
      "id": "421f9fb5-921b-470a-b7a2-bbdf1b19313e",
      "text": "như đã từng là nơi rừng hoang đồng vắng",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:07.332Z",
      "updatedAt": "2025-09-03T02:57:07.332Z",
      "chapterId": "5e8107d2-a5cf-46c1-9689-3b433b4a7696"
    },
    {
      "id": "853b87dd-ab85-415b-b2d5-1ee02d45c196",
      "text": "trước mặt con cái Ít-ra-en.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:07.346Z",
      "updatedAt": "2025-09-03T02:57:07.346Z",
      "chapterId": "5e8107d2-a5cf-46c1-9689-3b433b4a7696"
    },
    {
      "id": "eb5eda14-cb0d-4d32-83e5-bf18495697c0",
      "text": "Đó sẽ là cảnh hoang tàn đổ nát.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 3,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:07.373Z",
      "updatedAt": "2025-09-03T02:57:07.373Z",
      "chapterId": "5e8107d2-a5cf-46c1-9689-3b433b4a7696"
    },
    {
      "id": "f0febec4-b0c1-4113-8c31-01a8a2115891",
      "text": "Vì ngươi đã quên Thiên Chúa cứu độ ngươi ;",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:07.387Z",
      "updatedAt": "2025-09-03T02:57:07.387Z",
      "chapterId": "5e8107d2-a5cf-46c1-9689-3b433b4a7696"
    },
    {
      "id": "34b2f1d6-7cd2-43b7-a908-6aee0eb48b2e",
      "text": "núi đá ngươi trú ẩn, ngươi không còn nhớ nữa.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:07.401Z",
      "updatedAt": "2025-09-03T02:57:07.401Z",
      "chapterId": "5e8107d2-a5cf-46c1-9689-3b433b4a7696"
    },
    {
      "id": "c7dbab4e-3a70-4b10-b8fa-1ddab287074f",
      "text": "Vì vậy ngươi trồng những vườn cây vui thú,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:07.429Z",
      "updatedAt": "2025-09-03T02:57:07.429Z",
      "chapterId": "5e8107d2-a5cf-46c1-9689-3b433b4a7696"
    },
    {
      "id": "d59ace85-720c-4ff2-bcdc-128438049703",
      "text": "ngươi ươm những mầm giống ngoại bang.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 3,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:07.443Z",
      "updatedAt": "2025-09-03T02:57:07.443Z",
      "chapterId": "5e8107d2-a5cf-46c1-9689-3b433b4a7696"
    },
    {
      "id": "daa97781-fc9b-446d-adb2-ce9db06eac95",
      "text": "Ngày ngươi trồng, ngươi trông thấy chúng lớn ;",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:07.457Z",
      "updatedAt": "2025-09-03T02:57:07.457Z",
      "chapterId": "5e8107d2-a5cf-46c1-9689-3b433b4a7696"
    },
    {
      "id": "1720bc37-bc2f-44fa-963f-4f278b102373",
      "text": "ngay buổi sáng, hạt giống ngươi gieo đã trổ bông.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:07.486Z",
      "updatedAt": "2025-09-03T02:57:07.486Z",
      "chapterId": "5e8107d2-a5cf-46c1-9689-3b433b4a7696"
    },
    {
      "id": "f0aef555-c94e-4548-becd-996e18d45e99",
      "text": "Nhưng trong ngày thu hoạch, chẳng gặt hái được gì,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:07.500Z",
      "updatedAt": "2025-09-03T02:57:07.500Z",
      "chapterId": "5e8107d2-a5cf-46c1-9689-3b433b4a7696"
    },
    {
      "id": "91650dd0-d254-4e82-976a-6e6a1c05b0a0",
      "text": "và tai hoạ thật vô phương cứu chữa.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 3,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:07.517Z",
      "updatedAt": "2025-09-03T02:57:07.517Z",
      "chapterId": "5e8107d2-a5cf-46c1-9689-3b433b4a7696"
    },
    {
      "id": "985366c1-bc7f-4f4f-b75f-47453ace3bc5",
      "text": "Nguy khốn thay, tiếng gầm thét của đám dân đông đảo :",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:07.531Z",
      "updatedAt": "2025-09-03T02:57:07.531Z",
      "chapterId": "5e8107d2-a5cf-46c1-9689-3b433b4a7696"
    },
    {
      "id": "d6d38cbd-a7db-4b21-987d-ad6e0a479929",
      "text": "chúng gầm vang như biển cả thét gào !",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:07.560Z",
      "updatedAt": "2025-09-03T02:57:07.560Z",
      "chapterId": "5e8107d2-a5cf-46c1-9689-3b433b4a7696"
    },
    {
      "id": "4b50f5b1-a5cc-4888-9ee6-75c65ed6874d",
      "text": "Chư dân náo động ; chúng ồn ào như biển khơi dậy sóng.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:07.574Z",
      "updatedAt": "2025-09-03T02:57:07.574Z",
      "chapterId": "5e8107d2-a5cf-46c1-9689-3b433b4a7696"
    },
    {
      "id": "9497f8d3-a73a-4971-aebf-2ee674d5cf61",
      "text": "Chúng náo động như sóng nước ồn ào.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:07.588Z",
      "updatedAt": "2025-09-03T02:57:07.588Z",
      "chapterId": "5e8107d2-a5cf-46c1-9689-3b433b4a7696"
    },
    {
      "id": "4951aab4-ad9f-411e-8544-3ccb9213c475",
      "text": "ĐỨC CHÚA doạ, chúng liền xa chạy cao bay ;",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:07.605Z",
      "updatedAt": "2025-09-03T02:57:07.605Z",
      "chapterId": "5e8107d2-a5cf-46c1-9689-3b433b4a7696"
    },
    {
      "id": "2687c66e-4667-477b-a76c-2eda2a60554a",
      "text": "chúng bị rượt đuổi như vỏ trấu trên núi gặp cơn gió,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:07.636Z",
      "updatedAt": "2025-09-03T02:57:07.636Z",
      "chapterId": "5e8107d2-a5cf-46c1-9689-3b433b4a7696"
    },
    {
      "id": "94292c12-5287-44a9-9ebb-dea120e34d9e",
      "text": "như cơn lốc trong trận cuồng phong.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 3,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:07.650Z",
      "updatedAt": "2025-09-03T02:57:07.650Z",
      "chapterId": "5e8107d2-a5cf-46c1-9689-3b433b4a7696"
    },
    {
      "id": "fb55092a-e364-4991-9d76-8efcd4d0e86c",
      "text": "Lúc chiều tà, thật là kinh khủng ;",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:07.664Z",
      "updatedAt": "2025-09-03T02:57:07.664Z",
      "chapterId": "5e8107d2-a5cf-46c1-9689-3b433b4a7696"
    },
    {
      "id": "2f0c87b5-700e-4d38-b86c-f02e75ac2a58",
      "text": "trước rạng đông, chẳng còn lại chút gì.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:07.678Z",
      "updatedAt": "2025-09-03T02:57:07.678Z",
      "chapterId": "5e8107d2-a5cf-46c1-9689-3b433b4a7696"
    },
    {
      "id": "4e533872-40fc-400a-be15-739c36d202b9",
      "text": "Đó là phần của những kẻ cướp phá,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 2,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:07.693Z",
      "updatedAt": "2025-09-03T02:57:07.693Z",
      "chapterId": "5e8107d2-a5cf-46c1-9689-3b433b4a7696"
    },
    {
      "id": "a6ff0786-44c7-45c1-bb27-a510b1a77b93",
      "text": "là số mạng dành cho kẻ bóc lột chúng ta.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 3,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:07.707Z",
      "updatedAt": "2025-09-03T02:57:07.707Z",
      "chapterId": "5e8107d2-a5cf-46c1-9689-3b433b4a7696"
    }
