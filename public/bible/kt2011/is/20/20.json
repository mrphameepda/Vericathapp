      "updatedAt": "2025-09-03T02:57:26.952Z",
      "targetId": "e0b3094c-53b5-48a5-9e38-1ff47e449206",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "22ff4d66-4020-457f-abe1-66c3353e1eec"
    },
    {
      "id": "b7117c4a-34b3-406e-965d-b35b282c5f07",
      "content": "Câu này được viết sau khi biến cố xảy ra năm 711. Nhưng từ năm 713, Át-sua đã truất phế vua xứ Át-đốt và đặt vua mới. I-sai-a đã thi hành lệnh này từ năm 713 hoặc năm 714 (trước đó 3 năm).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:57:26.673Z",
      "updatedAt": "2025-09-03T02:57:26.673Z",
