      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "9396dd9c-9d57-4a4e-8dfd-2615dce786bc",
      "content": "*Tượng thần* : vừa gợi ý thờ ngẫu thần là tội lớn của Ba-by-lon, vừa nêu lên sự bất lực của các ngẫu thần.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "12",
      "sortOrder": 11,
      "startOffset": 21,
      "endOffset": 21,
      "createdAt": "2025-09-03T02:57:33.748Z",
      "updatedAt": "2025-09-03T02:57:33.748Z",
      "targetId": "84556e0c-bb0a-4322-bfda-9c380c875c4f",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "d658b72b-37ad-4e88-90c2-0e086c64dd91",
      "content": "*Những kẻ bị chà đạp ...* : sự sụp đổ của Ba-by-lon là niềm an ủi cho dân Giu-đa bị nó áp bức.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "13",
      "sortOrder": 12,
      "startOffset": 34,
      "endOffset": 34,
      "createdAt": "2025-09-03T02:57:33.775Z",
      "updatedAt": "2025-09-03T02:57:33.775Z",
      "targetId": "8d586865-a482-4c73-a1d3-fb219429387c",
