{
  "chapter": {
    "id": "c6c09a2f-1485-4bf9-84df-b01246d5a67b",
    "number": 21,
    "createdAt": "2025-09-03T01:07:51.736Z",
    "updatedAt": "2025-09-03T01:07:51.736Z",
    "bookId": "d17ae149-2718-48e5-b452-c522381bf71a"
  },
  "verses": [
    {
      "id": "5323e230-41b8-41da-a0ef-76e1fe0c78f0",
      "text": "Lời sấm về sa mạc vùng biển.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:33.178Z",
      "updatedAt": "2025-09-03T02:57:33.178Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "a81eed64-f36b-47be-9451-34c656b1242a",
      "text": "Như cuồng phong thổi qua Ne-ghép,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:33.263Z",
      "updatedAt": "2025-09-03T02:57:33.263Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "586e4d2f-74c2-4610-9215-71563e7546c6",
      "text": "một người xông đến từ sa mạc, từ giải đất kinh hoàng",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:33.285Z",
      "updatedAt": "2025-09-03T02:57:33.285Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "3a5d8e34-2b4a-4385-a5d7-607cbdb9ae0e",
      "text": "–ghê sợ biết bao, thị kiến tôi đang gặp– :",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:33.296Z",
      "updatedAt": "2025-09-03T02:57:33.296Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "47704bb6-5a5f-4021-9217-d7909e804c26",
      "text": "đó là tên phản bội đang phản bội, là tay tàn phá đang tàn phá.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:33.319Z",
      "updatedAt": "2025-09-03T02:57:33.319Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "b5cc6508-1275-4b29-aff5-6c47c524b49b",
      "text": "“Ê-lam, tiến lên, Mê-đi, siết chặt vòng vây !”",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:33.347Z",
      "updatedAt": "2025-09-03T02:57:33.347Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "382344ae-0154-446a-8a1e-47a294e29df7",
      "text": "Ta sẽ làm im bặt mọi tiếng khóc.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 3,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:33.389Z",
      "updatedAt": "2025-09-03T02:57:33.389Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "aa1bc6be-a1b8-444d-9a4f-51aaba474980",
      "text": "Vì thế, tâm can tôi lo lắng bồi hồi,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:33.403Z",
      "updatedAt": "2025-09-03T02:57:33.403Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "05d6c81a-c736-469d-963b-563126df4247",
      "text": "tôi phải đớn đau quằn quại như người phụ nữ lúc sinh con,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:33.418Z",
      "updatedAt": "2025-09-03T02:57:33.418Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "c62472ee-7998-441f-bad7-cf8c6c90c808",
      "text": "tôi rụng rời không còn nghe được nữa,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:33.432Z",
      "updatedAt": "2025-09-03T02:57:33.432Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "480fa517-d884-4b13-a782-c6e1956f9851",
      "text": "tôi kinh hãi chẳng còn thấy được gì.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 3,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:33.447Z",
      "updatedAt": "2025-09-03T02:57:33.447Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "f0f9f85c-4cbf-45ce-9b20-6a91518f6f24",
      "text": "Lòng tôi dao động, nỗi kinh hãi khiến tôi bàng hoàng.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:33.460Z",
      "updatedAt": "2025-09-03T02:57:33.460Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "f5a25be4-cb8d-474e-851b-9e913cc35fdb",
      "text": "Cảnh chiều tà xưa tôi ưa thích nay trở thành mối lo sợ cho tôi.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:33.474Z",
      "updatedAt": "2025-09-03T02:57:33.474Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "90698933-133e-4044-8c6e-f674d290e5a8",
      "text": "Người ta dọn bữa tiệc, trải khăn trải thảm, rồi bắt đầu ăn uống.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:33.488Z",
      "updatedAt": "2025-09-03T02:57:33.488Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "36690afe-af42-4808-a221-78c269f997fe",
      "text": "Hỡi các tướng lãnh, hãy đứng lên !",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:33.532Z",
      "updatedAt": "2025-09-03T02:57:33.532Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "1706844f-6599-46a0-87a7-811e297ca0c7",
      "text": "Hãy thoa dầu vào khiên, vào thuẫn !",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:33.546Z",
      "updatedAt": "2025-09-03T02:57:33.546Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "977fab50-a24d-4e6c-978c-2e155a1d356b",
      "text": "Quả thật, Chúa Thượng phán với tôi thế này :",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:33.560Z",
      "updatedAt": "2025-09-03T02:57:33.560Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "644e143e-780d-471d-a6e6-e55725f061c3",
      "text": "“Hãy đi đặt người đứng canh, thấy gì thì nó phải báo.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:33.574Z",
      "updatedAt": "2025-09-03T02:57:33.574Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "4ffd2ec9-1e4f-4ae0-9eb8-60fcefa82f8d",
      "text": "Khi thấy một cỗ xe song mã, một người cỡi lừa hay cỡi lạc đà,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:33.603Z",
      "updatedAt": "2025-09-03T02:57:33.603Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "0aee45c5-5ff7-408c-8972-c4b6c25899f2",
      "text": "thì nó phải quan sát cho kỹ, quan sát cho thật kỹ.”",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:33.618Z",
      "updatedAt": "2025-09-03T02:57:33.618Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "aa182307-94c7-41bd-8ece-b4cbd8dcc2db",
      "text": "Người lính canh hô lớn :",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:33.632Z",
      "updatedAt": "2025-09-03T02:57:33.632Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "b9425310-8a8b-4116-b1d3-c426586b839d",
      "text": "“Lạy Chúa Thượng, suốt ngày con đứng ở chòi canh,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:33.650Z",
      "updatedAt": "2025-09-03T02:57:33.650Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "4ccac102-3339-41b3-b939-c9d3ab9f92fd",
      "text": "đêm đêm con trực nơi vọng gác.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:33.663Z",
      "updatedAt": "2025-09-03T02:57:33.663Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "7517de28-ec7a-41c8-961e-61c5aa719ef0",
      "text": "Và kìa, con thấy một người đang tới trên cỗ xe song mã.”",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:33.677Z",
      "updatedAt": "2025-09-03T02:57:33.677Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "cc13a7fb-fcc3-421b-93b8-667629be7f09",
      "text": "Người này lên tiếng : “Ba-by-lon đã sụp đổ, sụp đổ rồi !",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:33.692Z",
      "updatedAt": "2025-09-03T02:57:33.692Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "84556e0c-bb0a-4322-bfda-9c380c875c4f",
      "text": "Tất cả các tượng thần của nó đều rơi xuống đất vỡ tan tành.”",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:33.734Z",
      "updatedAt": "2025-09-03T02:57:33.734Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "8d586865-a482-4c73-a1d3-fb219429387c",
      "text": "Hỡi dân tôi là những kẻ bị chà đạp",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:33.761Z",
      "updatedAt": "2025-09-03T02:57:33.761Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "9dfd1b45-6934-4727-b871-447290b2abf4",
      "text": "như lúa bị người ta đập trên sân,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:33.789Z",
      "updatedAt": "2025-09-03T02:57:33.789Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "ba6349f0-86c8-40b4-bc0f-f88c33e7b95a",
      "text": "tôi xin báo lại cho các người điều tôi đã được nghe nói,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:33.802Z",
      "updatedAt": "2025-09-03T02:57:33.802Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "443388de-8225-4eee-9649-f6cc67a30a13",
      "text": "do ĐỨC CHÚA các đạo binh, Thiên Chúa của Ít-ra-en.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 3,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:33.815Z",
      "updatedAt": "2025-09-03T02:57:33.815Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "fc513702-4c25-47ad-b15c-b44e4160325f",
      "text": "Lời sấm về Đu-ma.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:33.856Z",
      "updatedAt": "2025-09-03T02:57:33.856Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "feb9b2a8-be5a-44f7-9849-de1a576e71d6",
      "text": "Từ Xê-ia, người ta gọi tôi : “Này người canh gác, đêm đến đâu rồi ?",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:33.940Z",
      "updatedAt": "2025-09-03T02:57:33.940Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "204ce915-bd29-4f14-a194-e49b0e8fb6df",
      "text": "Này người canh gác, đêm đến đâu rồi ?”",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:33.968Z",
      "updatedAt": "2025-09-03T02:57:33.968Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "d4ac1aa5-0734-4926-8ab7-7213c4c195dd",
      "text": "Người canh gác trả lời : “Sáng đến rồi, và cả đêm cũng đến !",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:33.982Z",
      "updatedAt": "2025-09-03T02:57:33.982Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "9ddff4ed-bbe1-4f76-b899-e0d6bc3a5442",
      "text": "Còn muốn hỏi gì, cứ việc hỏi.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:34.011Z",
      "updatedAt": "2025-09-03T02:57:34.011Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "8fd96fdf-49e1-446f-ad2e-bf32d4a45b9e",
      "text": "Nhưng hãy trở lại đây, hãy đến đây !”",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:34.025Z",
      "updatedAt": "2025-09-03T02:57:34.025Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "57b3526b-0eef-4808-8320-b372ce8a022c",
      "text": "Lời sấm về Ả-rập.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:34.039Z",
      "updatedAt": "2025-09-03T02:57:34.039Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "74db2de9-9f98-4100-a4c3-140aa6006b34",
      "text": "Các ngươi hãy nghỉ đêm trong rừng Ả-rập,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:34.122Z",
      "updatedAt": "2025-09-03T02:57:34.122Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "03fdd950-ca17-4abf-acff-65c9d7e1dff6",
      "text": "hỡi đoàn lữ hành xứ Đơ-đan !",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:34.151Z",
      "updatedAt": "2025-09-03T02:57:34.151Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "7016ebfc-1d95-404f-8cfe-26367e5ed606",
      "text": "Hãy đi gặp người đang khát và mang nước cho nó,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:34.192Z",
      "updatedAt": "2025-09-03T02:57:34.192Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "133f711d-4017-450a-a2b8-bb80e154a178",
      "text": "hỡi dân cư xứ Tê-ma,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:34.206Z",
      "updatedAt": "2025-09-03T02:57:34.206Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "6b5b5081-bb94-479e-8e4e-0e16d865e99c",
      "text": "hãy vượt lên trước người chạy trốn và mang bánh cho nó,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 2,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:34.234Z",
      "updatedAt": "2025-09-03T02:57:34.234Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "b35e05e2-e398-42fd-af8e-6103b5b35f40",
      "text": "bởi vì chúng chạy trốn để thoát khỏi lưỡi gươm,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:34.248Z",
      "updatedAt": "2025-09-03T02:57:34.248Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "d1c1cdff-afb6-4f38-a0be-b38f1da1a99d",
      "text": "lưỡi gươm tuốt trần,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:34.261Z",
      "updatedAt": "2025-09-03T02:57:34.261Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "5b6e9c21-1277-4947-ae0d-cb23cae28a11",
      "text": "thoát cung tên giương sẵn và cuộc chiến cam go.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 2,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:34.276Z",
      "updatedAt": "2025-09-03T02:57:34.276Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "0d1f4d55-646d-4f28-b751-7e9d465b93e4",
      "text": "Chúa Thượng phán với tôi như sau :",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:57:34.291Z",
      "updatedAt": "2025-09-03T02:57:34.291Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "f6caa901-cd51-41d3-b4e6-30e7bc51191c",
      "text": "Còn đúng một năm nữa, ví như một năm làm thuê, tất cả vinh quang của Kê-đa sẽ chấm dứt.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:57:34.319Z",
      "updatedAt": "2025-09-03T02:57:34.319Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    },
    {
      "id": "ea174a59-ba6a-4997-8fcf-5e23422855e5",
      "text": "Sẽ còn rất ít kẻ sót lại trong số những dũng sĩ bắn cung tên của con cái Kê-đa. ĐỨC CHÚA, Thiên Chúa Ít-ra-en, đã phán như vậy.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 46,
      "paragraphIndex": 1,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:57:34.361Z",
      "updatedAt": "2025-09-03T02:57:34.361Z",
      "chapterId": "c6c09a2f-1485-4bf9-84df-b01246d5a67b"
    }
  ],
