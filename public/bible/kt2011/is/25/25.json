{
  "chapter": {
    "id": "7bab5eef-62dc-4812-8531-b1c5e5822312",
    "number": 25,
    "createdAt": "2025-09-03T01:07:51.736Z",
    "updatedAt": "2025-09-03T01:07:51.736Z",
    "bookId": "d17ae149-2718-48e5-b452-c522381bf71a"
  },
  "verses": [
    {
      "id": "5221046f-3d32-4366-bf09-67bcd6631361",
      "text": "Lạy ĐỨC CHÚA, Ngài là Thiên Chúa của con,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:01.838Z",
      "updatedAt": "2025-09-03T02:58:01.838Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "42c634c5-84f1-43a1-b6b3-8b0f00cc65f2",
      "text": "con suy tôn Ngài, con xưng tụng danh Ngài,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:01.907Z",
      "updatedAt": "2025-09-03T02:58:01.907Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "a1f4cdb5-d52d-4993-9ffb-b42196d82169",
      "text": "vì Ngài thực hiện những kỳ công,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:01.921Z",
      "updatedAt": "2025-09-03T02:58:01.921Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "582b20ff-6aa0-4735-99ff-1bdc59f270ce",
      "text": "những chương trình tự ngàn xưa thật là bền vững.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 3,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:01.934Z",
      "updatedAt": "2025-09-03T02:58:01.934Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "38b6792b-6771-48b9-96c0-cb386f221960",
      "text": "Ngài đã làm cho đô thị hoá ra đống đá,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:01.948Z",
      "updatedAt": "2025-09-03T02:58:01.948Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "c2450017-4d9c-4ee9-acd1-24c745a1ed14",
      "text": "cho thành trì kiên cố nên chốn hoang tàn.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:01.963Z",
      "updatedAt": "2025-09-03T02:58:01.963Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "0c58d128-826e-4247-b124-b19ca9748fce",
      "text": "Thành trì của bọn ngoại bang",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:01.976Z",
      "updatedAt": "2025-09-03T02:58:01.976Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "ba654281-ec9a-43f6-91ef-b0989ad24bdf",
      "text": "không còn là đô thị nữa, và chẳng ai xây lại bao giờ.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 3,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:02.004Z",
      "updatedAt": "2025-09-03T02:58:02.004Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "f2659cd5-9cf3-45ad-9b7a-cf6930ffedec",
      "text": "Vì thế, một dân hùng mạnh sẽ tôn vinh Ngài,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:02.018Z",
      "updatedAt": "2025-09-03T02:58:02.018Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "3c83e8e7-c45c-4b64-bcf9-3a7ce50a49be",
      "text": "và thành trì của những dân hung hãn sẽ kính sợ Ngài.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:02.032Z",
      "updatedAt": "2025-09-03T02:58:02.032Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "aafd95c1-5196-456f-b147-471f764c4549",
      "text": "Quả thật, Ngài là chốn dung thân cho người hèn yếu,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:02.046Z",
      "updatedAt": "2025-09-03T02:58:02.046Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "a5454b72-fd19-4341-a66b-40917debae30",
      "text": "là nơi nương náu cho kẻ khó nghèo khi gặp bước gian truân.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:02.060Z",
      "updatedAt": "2025-09-03T02:58:02.060Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "4830af90-75a4-411e-b63f-e984d2ae8a3a",
      "text": "Ngài là nơi trú ẩn trong cơn bão táp,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:02.089Z",
      "updatedAt": "2025-09-03T02:58:02.089Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "bfea5ae5-3cd1-4933-bd6d-6e3ab67d8da3",
      "text": "là bóng mát giữa buổi nắng thiêu,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 3,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:02.102Z",
      "updatedAt": "2025-09-03T02:58:02.102Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "e210e146-a9dc-4ec8-ae03-7ec7822d14e8",
      "text": "vì sát khí của quân cường bạo",
      "label": "4",
      "number": 4,
      "subVerseIndex": 4,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:02.116Z",
      "updatedAt": "2025-09-03T02:58:02.116Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "7b7362cb-85a0-4c55-aaa2-87d44e8a068f",
      "text": "chẳng khác nào mưa bão đập vào tường.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 5,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:02.130Z",
      "updatedAt": "2025-09-03T02:58:02.130Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "08aaf12f-5d0a-407c-a274-f3c749efa4bb",
      "text": "Như nắng thiêu trên đất khô cằn,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:02.160Z",
      "updatedAt": "2025-09-03T02:58:02.160Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "e903bf14-786c-4e80-a5c8-be3e36eb4424",
      "text": "Ngài chế ngự tiếng ồn ào náo động của lũ ngoại bang.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:02.174Z",
      "updatedAt": "2025-09-03T02:58:02.174Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "691f625d-fa2f-46c8-9f10-a81907b15c27",
      "text": "Như bóng mây ngăn sức nắng thiêu,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:02.188Z",
      "updatedAt": "2025-09-03T02:58:02.188Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "751acdff-0478-4a17-9efb-2f927aa810b3",
      "text": "Ngài dập tắt những lời ca tiếng hát của quân bạo cường.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 3,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:02.202Z",
      "updatedAt": "2025-09-03T02:58:02.202Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "6b738100-7d44-4868-a044-2c787bbc3539",
      "text": "",
      "label": "5",
      "number": 5,
      "subVerseIndex": 4,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:02.217Z",
      "updatedAt": "2025-09-03T02:58:02.217Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "c0d89974-bbd5-4548-a090-40319d5aa7ff",
      "text": "Ngày ấy, trên núi này,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:58:02.276Z",
      "updatedAt": "2025-09-03T02:58:02.276Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "7337cfc2-ce2e-44b8-948b-8bcac81b89af",
      "text": "ĐỨC CHÚA các đạo binh sẽ đãi muôn dân một bữa tiệc :",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:02.303Z",
      "updatedAt": "2025-09-03T02:58:02.303Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "4c3a3503-6ba0-4fad-a585-c00c955a7c0d",
      "text": "tiệc thịt béo, tiệc rượu ngon,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:02.345Z",
      "updatedAt": "2025-09-03T02:58:02.345Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "b71638d2-3d8e-42d5-9490-a3b6d8a1a19a",
      "text": "thịt béo ngậy, rượu ngon tinh chế.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 3,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:02.372Z",
      "updatedAt": "2025-09-03T02:58:02.372Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "dc836a86-3500-4d33-9b7b-a226600e4508",
      "text": "Trên núi này, Người sẽ xé bỏ chiếc khăn che phủ mọi dân,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:02.386Z",
      "updatedAt": "2025-09-03T02:58:02.386Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "01111797-6ff9-46ef-9fe3-fc2fb6fbda0e",
      "text": "và tấm màn trùm lên muôn nước.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:02.414Z",
      "updatedAt": "2025-09-03T02:58:02.414Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "562fbb45-48ec-42d5-93d1-bfae7e1128e1",
      "text": "Người sẽ vĩnh viễn tiêu diệt tử thần.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:02.428Z",
      "updatedAt": "2025-09-03T02:58:02.428Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "c78b87be-f261-4753-b726-da3628a716d9",
      "text": "ĐỨC CHÚA là Chúa Thượng sẽ lau khô dòng lệ",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:02.457Z",
      "updatedAt": "2025-09-03T02:58:02.457Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "e2342da0-e229-46cc-af5b-f7a522774be0",
      "text": "trên khuôn mặt mọi người,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:02.498Z",
      "updatedAt": "2025-09-03T02:58:02.498Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "97190147-4a69-461e-8991-1c963004b7ef",
      "text": "và trên toàn cõi đất, Người sẽ xoá sạch",
      "label": "8",
      "number": 8,
      "subVerseIndex": 3,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:02.526Z",
      "updatedAt": "2025-09-03T02:58:02.526Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "3a5761a9-8135-43ce-8d4a-8ff3f7942a67",
      "text": "nỗi ô nhục của dân Người.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 4,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:02.540Z",
      "updatedAt": "2025-09-03T02:58:02.540Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "73786b0a-1c50-4ce2-ad67-2a2832be1433",
      "text": "ĐỨC CHÚA phán như vậy.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 5,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:02.553Z",
      "updatedAt": "2025-09-03T02:58:02.553Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "312566dc-b53d-45fa-881a-a512ea4dede2",
      "text": "Ngày ấy, người ta sẽ nói :",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:02.590Z",
      "updatedAt": "2025-09-03T02:58:02.590Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "9a9e2120-5eba-4a0a-8d84-3f9879af85bc",
      "text": "“Đây là Thiên Chúa chúng ta,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:02.603Z",
      "updatedAt": "2025-09-03T02:58:02.603Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "1888a04a-1ae0-4157-9267-0095cce2c36c",
      "text": "chúng ta từng trông đợi Người, và đã được Người thương cứu độ.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:02.632Z",
      "updatedAt": "2025-09-03T02:58:02.632Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "001a0d86-5068-4c4b-b465-29aec516c91a",
      "text": "Chính Người là ĐỨC CHÚA chúng ta từng đợi trông.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 3,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:02.646Z",
      "updatedAt": "2025-09-03T02:58:02.646Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "343df59e-591e-46d1-a424-c08293dd771c",
      "text": "Nào ta cùng hoan hỷ vui mừng bởi được Người cứu độ.”",
      "label": "9",
      "number": 9,
      "subVerseIndex": 4,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:02.674Z",
      "updatedAt": "2025-09-03T02:58:02.674Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "57c2dd34-0fd7-485c-bcb6-e747894d0e8a",
      "text": "Bàn tay ĐỨC CHÚA sẽ đặt trên núi này mà nghỉ.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:02.688Z",
      "updatedAt": "2025-09-03T02:58:02.688Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "8d37e013-b5e9-4fbf-981f-4202ed05d380",
      "text": "Còn Mô-áp sẽ bị giày đạp ngay tại chỗ,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:02.730Z",
      "updatedAt": "2025-09-03T02:58:02.730Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "d17e301e-e4d1-40f8-93e7-4765a1bdb8fa",
      "text": "như rơm bị nghiền nát trong hố phân.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:02.772Z",
      "updatedAt": "2025-09-03T02:58:02.772Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "c94f6aef-1714-4c7e-ae0a-186d33e0513e",
      "text": "Nó sẽ dang tay ra ở giữa hố, như người ta dang tay để bơi ;",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:02.786Z",
      "updatedAt": "2025-09-03T02:58:02.786Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "ba641746-ef02-4aac-857e-3e0cdc3d712e",
      "text": "nhưng Đức Chúa sẽ triệt hạ tính kiêu căng của nó,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:02.799Z",
      "updatedAt": "2025-09-03T02:58:02.799Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "0598fbcc-e66f-4748-99c6-66b7abe9ebdf",
      "text": "mặc dù tay nó cố vẫy vùng.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:02.813Z",
      "updatedAt": "2025-09-03T02:58:02.813Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "c00b9c5f-fc6e-448e-86f1-42793c9717ad",
      "text": "Tường thành cao vững của ngươi,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:02.827Z",
      "updatedAt": "2025-09-03T02:58:02.827Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "d5fb2642-ac2e-485a-bf2b-7b63f0060ae7",
      "text": "Người đã phá nhào, đã triệt hạ,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:02.841Z",
      "updatedAt": "2025-09-03T02:58:02.841Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    },
    {
      "id": "9ee2faa5-fd4c-49ad-9ac4-34a5cf582d96",
      "text": "phá cho bình địa, chỉ còn là bụi đất.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:02.855Z",
      "updatedAt": "2025-09-03T02:58:02.855Z",
      "chapterId": "7bab5eef-62dc-4812-8531-b1c5e5822312"
    }
  ],
