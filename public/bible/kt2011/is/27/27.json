    {
      "id": "1f3f1ba3-3c82-4b92-819e-ef5222ecb7c4",
      "text": "và những kẻ đã bị xua đuổi sang Ai-cập",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
