{
  "chapter": {
    "id": "442dbf19-73d9-4669-a6f0-6d468512c6c4",
    "number": 27,
    "createdAt": "2025-09-03T01:07:51.736Z",
    "updatedAt": "2025-09-03T01:07:51.736Z",
    "bookId": "d17ae149-2718-48e5-b452-c522381bf71a"
  },
  "verses": [
    {
      "id": "74ee877f-e02f-44fc-9152-17bd8f5cc3b3",
      "text": "Ngày ấy, ĐỨC CHÚA sẽ dùng thanh gươm",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:20.104Z",
      "updatedAt": "2025-09-03T02:58:20.104Z",
      "chapterId": "442dbf19-73d9-4669-a6f0-6d468512c6c4"
    },
    {
      "id": "e9b1f361-5a35-4715-bf9c-f693897ce8dd",
      "text": "vừa cứng, vừa dài, vừa mạnh",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:20.134Z",
      "updatedAt": "2025-09-03T02:58:20.134Z",
      "chapterId": "442dbf19-73d9-4669-a6f0-6d468512c6c4"
    },
    {
      "id": "be5738ca-796f-4bce-8663-f316aa0137d1",
      "text": "mà trừng trị con giao long, con rắn chui nhủi,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:20.146Z",
      "updatedAt": "2025-09-03T02:58:20.146Z",
      "chapterId": "442dbf19-73d9-4669-a6f0-6d468512c6c4"
    },
    {
      "id": "7bc0a7af-e235-4207-bb3d-908c33599a81",
      "text": "con giao long, con rắn ngoằn ngoèo,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 3,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:20.182Z",
      "updatedAt": "2025-09-03T02:58:20.182Z",
      "chapterId": "442dbf19-73d9-4669-a6f0-6d468512c6c4"
    },
    {
      "id": "acda008a-11e0-40d1-9a0e-56763a88a39c",
      "text": "và Người sẽ giết chết con thuồng luồng ngoài biển.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 4,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:20.196Z",
      "updatedAt": "2025-09-03T02:58:20.196Z",
      "chapterId": "442dbf19-73d9-4669-a6f0-6d468512c6c4"
    },
    {
      "id": "258290a4-9a38-4a03-888c-6c29fa2af712",
      "text": "Ngày ấy, các ngươi hãy ca ngợi vườn nho tuyệt diệu.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:20.225Z",
      "updatedAt": "2025-09-03T02:58:20.225Z",
      "chapterId": "442dbf19-73d9-4669-a6f0-6d468512c6c4"
    },
    {
      "id": "0fda47f1-b68f-4aed-863d-fe67a9b95688",
      "text": "Chính Ta, ĐỨC CHÚA, Ta là người canh giữ vườn nho,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:20.309Z",
      "updatedAt": "2025-09-03T02:58:20.309Z",
      "chapterId": "442dbf19-73d9-4669-a6f0-6d468512c6c4"
    },
    {
      "id": "7dae351f-f44b-40cc-9368-ed6fc5c705c5",
      "text": "vẫn đều đặn tưới nước ;",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:20.337Z",
      "updatedAt": "2025-09-03T02:58:20.337Z",
      "chapterId": "442dbf19-73d9-4669-a6f0-6d468512c6c4"
    },
    {
      "id": "29a75b0f-aca6-4766-a669-99aee75efd1f",
      "text": "Ta canh giữ ngày đêm, không cho ai phá hoại.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:20.351Z",
      "updatedAt": "2025-09-03T02:58:20.351Z",
      "chapterId": "442dbf19-73d9-4669-a6f0-6d468512c6c4"
    },
    {
      "id": "38b1e013-f7c3-4488-b784-83bddffd3ffe",
      "text": "Ta không giận nữa đâu : có gai góc hay bụi rậm,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:20.366Z",
      "updatedAt": "2025-09-03T02:58:20.366Z",
      "chapterId": "442dbf19-73d9-4669-a6f0-6d468512c6c4"
    },
    {
      "id": "3c021b1b-ac88-4e69-b411-c3dec934d4c2",
      "text": "là Ta mở cuộc chiến, Ta sẽ đốt hết một trật.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:20.393Z",
      "updatedAt": "2025-09-03T02:58:20.393Z",
      "chapterId": "442dbf19-73d9-4669-a6f0-6d468512c6c4"
    },
    {
      "id": "2dea9528-92ae-4293-b6b1-1b3513ecc857",
      "text": "Kẻ nào bám lấy Ta để được che chở,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:20.408Z",
      "updatedAt": "2025-09-03T02:58:20.408Z",
      "chapterId": "442dbf19-73d9-4669-a6f0-6d468512c6c4"
    },
    {
      "id": "a29659c2-bc9c-44e2-bdd9-0699950afcb3",
      "text": "thì hãy làm lành với Ta ;",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:20.422Z",
      "updatedAt": "2025-09-03T02:58:20.422Z",
      "chapterId": "442dbf19-73d9-4669-a6f0-6d468512c6c4"
    },
    {
      "id": "10636f39-ebb8-4f58-947d-19907e15ec00",
      "text": "với Ta, nó hãy làm lành.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:20.435Z",
      "updatedAt": "2025-09-03T02:58:20.435Z",
      "chapterId": "442dbf19-73d9-4669-a6f0-6d468512c6c4"
    },
    {
      "id": "4c3318e6-f934-47be-9d39-3110d5b4e557",
      "text": "Trong tương lai,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:20.449Z",
      "updatedAt": "2025-09-03T02:58:20.449Z",
      "chapterId": "442dbf19-73d9-4669-a6f0-6d468512c6c4"
    },
    {
      "id": "d3f3d71a-41ac-405f-8807-8fc615ed659f",
      "text": "Gia-cóp sẽ bén rễ,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:20.504Z",
      "updatedAt": "2025-09-03T02:58:20.504Z",
      "chapterId": "442dbf19-73d9-4669-a6f0-6d468512c6c4"
    },
    {
      "id": "ee0b94ac-e58b-4712-a217-a76cb520695a",
      "text": "Ít-ra-en sẽ trổ nụ đơm bông,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:20.531Z",
      "updatedAt": "2025-09-03T02:58:20.531Z",
      "chapterId": "442dbf19-73d9-4669-a6f0-6d468512c6c4"
    },
    {
      "id": "768fb604-6f25-4404-aa4c-1d0bfb6ea1b4",
      "text": "và mặt đất sẽ đầy tràn hoa trái.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 3,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:20.560Z",
      "updatedAt": "2025-09-03T02:58:20.560Z",
      "chapterId": "442dbf19-73d9-4669-a6f0-6d468512c6c4"
    },
    {
      "id": "ba58f028-e7a1-49c5-b137-17d99af33892",
      "text": "Phải chăng Người đã đánh nó, như đánh những ai đã đánh nó ?",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:20.574Z",
      "updatedAt": "2025-09-03T02:58:20.574Z",
      "chapterId": "442dbf19-73d9-4669-a6f0-6d468512c6c4"
    },
    {
      "id": "cc5f3900-9516-4756-a692-1691be3cf627",
      "text": "Phải chăng Người đã giết nó, như giết những ai đã giết nó ?",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:20.602Z",
      "updatedAt": "2025-09-03T02:58:20.602Z",
      "chapterId": "442dbf19-73d9-4669-a6f0-6d468512c6c4"
    },
    {
      "id": "b3caa870-09c8-423e-929f-ecbe712e7300",
      "text": "Người đã thi hành công lý",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:20.616Z",
      "updatedAt": "2025-09-03T02:58:20.616Z",
      "chapterId": "442dbf19-73d9-4669-a6f0-6d468512c6c4"
    },
    {
      "id": "9d618cfc-7a51-46e3-8d12-715357a240c4",
      "text": "khi trục xuất bọn chúng, xua đuổi chúng đi.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:20.630Z",
      "updatedAt": "2025-09-03T02:58:20.630Z",
      "chapterId": "442dbf19-73d9-4669-a6f0-6d468512c6c4"
    },
    {
      "id": "bccd772e-8aee-4238-b527-88fd8827eb7e",
      "text": "Người đã thổi làn hơi mãnh liệt của Người,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:20.644Z",
      "updatedAt": "2025-09-03T02:58:20.644Z",
      "chapterId": "442dbf19-73d9-4669-a6f0-6d468512c6c4"
    },
    {
      "id": "2d7bfc9d-3a49-44a4-a618-1b6da7d08aef",
      "text": "đánh bật chúng trong ngày gió đông.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 3,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:20.658Z",
      "updatedAt": "2025-09-03T02:58:20.658Z",
      "chapterId": "442dbf19-73d9-4669-a6f0-6d468512c6c4"
    },
    {
      "id": "65562cec-832b-4f85-b9fc-5fc734d6cd70",
      "text": "Chính nhờ vậy mà tội tình Gia-cóp được tẩy xoá,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:20.672Z",
      "updatedAt": "2025-09-03T02:58:20.672Z",
      "chapterId": "442dbf19-73d9-4669-a6f0-6d468512c6c4"
    },
    {
      "id": "ccfb2391-684c-49a0-afc6-975d1544b8ed",
      "text": "và việc xoá bỏ tội lỗi đưa đến hậu quả này :",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:20.701Z",
      "updatedAt": "2025-09-03T02:58:20.701Z",
      "chapterId": "442dbf19-73d9-4669-a6f0-6d468512c6c4"
    },
    {
      "id": "fbd45747-1a0a-45e7-af35-e35d111640fa",
      "text": "họ đập những viên đá bàn thờ tan tành như đá vôi tán vụn ;",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:20.715Z",
      "updatedAt": "2025-09-03T02:58:20.715Z",
      "chapterId": "442dbf19-73d9-4669-a6f0-6d468512c6c4"
    },
    {
      "id": "7531a2f3-a36b-4ce0-8bf9-f8ea2f19f81c",
      "text": "cột thờ với bàn thiên cũng chẳng còn.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 3,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:20.728Z",
      "updatedAt": "2025-09-03T02:58:20.728Z",
      "chapterId": "442dbf19-73d9-4669-a6f0-6d468512c6c4"
    },
    {
      "id": "200a50f9-15ce-46e5-899e-23b15a551620",
      "text": "Vì thành trì kiên cố nay điêu tàn vắng vẻ,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:20.756Z",
      "updatedAt": "2025-09-03T02:58:20.756Z",
      "chapterId": "442dbf19-73d9-4669-a6f0-6d468512c6c4"
    },
    {
      "id": "a4cd1d2d-1056-4506-a224-e046cf5e17be",
      "text": "làng xóm tan hoang tựa sa mạc tiêu điều,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:20.785Z",
      "updatedAt": "2025-09-03T02:58:20.785Z",
      "chapterId": "442dbf19-73d9-4669-a6f0-6d468512c6c4"
    },
    {
      "id": "f40a92f3-1125-4a70-8d6c-529aabec8453",
      "text": "chỉ còn bò bê đến gặm cỏ, đến nằm đó mà nhá những cành cây.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:20.799Z",
      "updatedAt": "2025-09-03T02:58:20.799Z",
      "chapterId": "442dbf19-73d9-4669-a6f0-6d468512c6c4"
    },
    {
      "id": "b32206c6-5e66-4f10-a7b8-65d949ebfa98",
      "text": "Cành héo khô thì bị bẻ gãy, và các bà đến châm lửa đốt đi.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:20.813Z",
      "updatedAt": "2025-09-03T02:58:20.813Z",
      "chapterId": "442dbf19-73d9-4669-a6f0-6d468512c6c4"
    },
    {
      "id": "e6e3be47-7ed9-41b5-8256-0fdd8cbb6755",
      "text": "Vì bọn dân này không chịu hiểu,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:20.828Z",
      "updatedAt": "2025-09-03T02:58:20.828Z",
      "chapterId": "442dbf19-73d9-4669-a6f0-6d468512c6c4"
    },
    {
      "id": "552b3528-ef3c-440d-8e42-f7f08b7b5b58",
      "text": "nên Đấng tác thành chẳng thương xót,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:20.842Z",
      "updatedAt": "2025-09-03T02:58:20.842Z",
      "chapterId": "442dbf19-73d9-4669-a6f0-6d468512c6c4"
    },
    {
      "id": "7e68d964-ecd2-4e0f-b24d-781ee59c82eb",
      "text": "Đấng nặn ra chúng chẳng dung tha.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 3,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:20.856Z",
      "updatedAt": "2025-09-03T02:58:20.856Z",
      "chapterId": "442dbf19-73d9-4669-a6f0-6d468512c6c4"
    },
    {
      "id": "e9859ce9-fed7-4c8c-a75c-0b3f4ae7b969",
      "text": "Rồi ngày kia ĐỨC CHÚA sẽ đập lúa từ sông Cả cho tới suối Ai-cập.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:20.870Z",
      "updatedAt": "2025-09-03T02:58:20.870Z",
      "chapterId": "442dbf19-73d9-4669-a6f0-6d468512c6c4"
    },
    {
      "id": "e4f17616-3329-495b-a3d5-07f2e4f1a633",
      "text": "Và anh em, hỡi con cái Ít-ra-en,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:20.956Z",
      "updatedAt": "2025-09-03T02:58:20.956Z",
      "chapterId": "442dbf19-73d9-4669-a6f0-6d468512c6c4"
    },
    {
      "id": "caf93366-b36c-4185-9d0f-208b72485a35",
      "text": "từng người một, anh em sẽ được Chúa mót nhặt về.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
