{
  "chapter": {
    "id": "a71ea5d3-a67a-48b0-90e6-5e4e97722815",
    "number": 31,
    "createdAt": "2025-09-03T01:07:51.736Z",
    "updatedAt": "2025-09-03T01:07:51.736Z",
    "bookId": "d17ae149-2718-48e5-b452-c522381bf71a"
  },
  "verses": [
    {
      "id": "a93a8b31-7b7f-4790-9513-f8068dcd31e9",
      "text": "Khốn thay những kẻ xuống Ai-cập cầu viện,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:52.889Z",
      "updatedAt": "2025-09-03T02:58:52.889Z",
      "chapterId": "a71ea5d3-a67a-48b0-90e6-5e4e97722815"
    },
    {
      "id": "f8a398df-418e-4a74-b592-0afaf91bf238",
      "text": "những kẻ cậy dựa vào chiến mã,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:52.970Z",
      "updatedAt": "2025-09-03T02:58:52.970Z",
      "chapterId": "a71ea5d3-a67a-48b0-90e6-5e4e97722815"
    },
    {
      "id": "0a350772-6a20-42a4-984b-53465a736c51",
      "text": "tin tưởng vì có lắm chiến xa,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:52.999Z",
      "updatedAt": "2025-09-03T02:58:52.999Z",
      "chapterId": "a71ea5d3-a67a-48b0-90e6-5e4e97722815"
    },
    {
      "id": "27b59628-4108-4c5c-8d69-e0d4cd0aebfb",
      "text": "vì kỵ binh hùng mạnh,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 3,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:53.013Z",
      "updatedAt": "2025-09-03T02:58:53.013Z",
      "chapterId": "a71ea5d3-a67a-48b0-90e6-5e4e97722815"
    },
    {
      "id": "43bf5099-3ebe-4236-a088-2111721011c0",
      "text": "mà không chịu ngước nhìn Đức Thánh của Ít-ra-en,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 4,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:53.027Z",
      "updatedAt": "2025-09-03T02:58:53.027Z",
      "chapterId": "a71ea5d3-a67a-48b0-90e6-5e4e97722815"
    },
    {
      "id": "0cf92c02-aa9b-42cf-9cf2-7665e82d0a1a",
      "text": "không kiếm tìm ĐỨC CHÚA.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 5,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:53.069Z",
      "updatedAt": "2025-09-03T02:58:53.069Z",
      "chapterId": "a71ea5d3-a67a-48b0-90e6-5e4e97722815"
    },
    {
      "id": "17e72ca1-8dff-4596-84a6-d8dabc14acea",
      "text": "Nhưng chính Người cũng lại khôn ngoan,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:53.097Z",
      "updatedAt": "2025-09-03T02:58:53.097Z",
      "chapterId": "a71ea5d3-a67a-48b0-90e6-5e4e97722815"
    },
    {
      "id": "9ee8e62c-4817-43d2-ab4b-1d8381d65474",
      "text": "Người có thể giáng hoạ, không rút lại lời đã phán ra ;",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:53.126Z",
      "updatedAt": "2025-09-03T02:58:53.126Z",
      "chapterId": "a71ea5d3-a67a-48b0-90e6-5e4e97722815"
    },
    {
      "id": "d44bcc8e-feac-482a-a7d3-ff374573a76a",
      "text": "Người sẽ đứng lên chống cự phường gian ác,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:53.141Z",
      "updatedAt": "2025-09-03T02:58:53.141Z",
      "chapterId": "a71ea5d3-a67a-48b0-90e6-5e4e97722815"
    },
    {
      "id": "07ec8059-4991-4a7a-90a7-286fbdffa6b8",
      "text": "chống cự những kẻ làm điều dữ được mời đến tiếp viện.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 3,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:53.155Z",
      "updatedAt": "2025-09-03T02:58:53.155Z",
      "chapterId": "a71ea5d3-a67a-48b0-90e6-5e4e97722815"
    },
    {
      "id": "50bd4d9b-3e42-4d77-b248-7d1fd088ca23",
      "text": "Ai-cập là phàm nhân, chứ đâu phải là thần !",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:53.169Z",
      "updatedAt": "2025-09-03T02:58:53.169Z",
      "chapterId": "a71ea5d3-a67a-48b0-90e6-5e4e97722815"
    },
    {
      "id": "279517d4-5c4f-491e-9533-ebd2dd321e3e",
      "text": "Chiến mã của chúng là súc vật, chứ đâu phải thần khí !",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:53.211Z",
      "updatedAt": "2025-09-03T02:58:53.211Z",
      "chapterId": "a71ea5d3-a67a-48b0-90e6-5e4e97722815"
    },
    {
      "id": "45ca95f6-ca48-4bf7-b08c-0f897d951219",
      "text": "Khi ĐỨC CHÚA vung tay, kẻ tiếp viện sẽ lảo đảo,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:53.242Z",
      "updatedAt": "2025-09-03T02:58:53.242Z",
      "chapterId": "a71ea5d3-a67a-48b0-90e6-5e4e97722815"
    },
    {
      "id": "13fc4ced-ceee-442e-988a-e7bc9c979f50",
      "text": "người được tiếp viện cũng té nhào,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 3,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:53.284Z",
      "updatedAt": "2025-09-03T02:58:53.284Z",
      "chapterId": "a71ea5d3-a67a-48b0-90e6-5e4e97722815"
    },
    {
      "id": "22c4ea7b-3852-4749-b6a1-12cc3cd017e3",
      "text": "chúng sẽ cùng tiêu vong hết thảy.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 4,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:53.298Z",
      "updatedAt": "2025-09-03T02:58:53.298Z",
      "chapterId": "a71ea5d3-a67a-48b0-90e6-5e4e97722815"
    },
    {
      "id": "a4336754-28db-4b62-8f6b-19000daa4bbd",
      "text": "ĐỨC CHÚA phán với tôi thế này :",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:53.313Z",
      "updatedAt": "2025-09-03T02:58:53.313Z",
      "chapterId": "a71ea5d3-a67a-48b0-90e6-5e4e97722815"
    },
    {
      "id": "fc25f495-eb75-4aef-8137-d23f825e9539",
      "text": "Khi sư tử hoặc sư tử con gầm gừ để giữ mồi của nó,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:53.385Z",
      "updatedAt": "2025-09-03T02:58:53.385Z",
      "chapterId": "a71ea5d3-a67a-48b0-90e6-5e4e97722815"
    },
    {
      "id": "34b9ef73-2540-461c-8137-708c9b07d3ab",
      "text": "dù cả đám mục đồng được gọi đến tấn công,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:53.414Z",
      "updatedAt": "2025-09-03T02:58:53.414Z",
      "chapterId": "a71ea5d3-a67a-48b0-90e6-5e4e97722815"
    },
    {
      "id": "ed30f68d-0c1a-413e-baa7-4220d26f3134",
      "text": "nó cũng không run sợ vì tiếng hét tiếng hò,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 3,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:53.428Z",
      "updatedAt": "2025-09-03T02:58:53.428Z",
      "chapterId": "a71ea5d3-a67a-48b0-90e6-5e4e97722815"
    },
    {
      "id": "add6c973-2b03-43f3-aa6d-522058f367af",
      "text": "chẳng kinh hoàng vì tiếng ồn ào náo động.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 4,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:53.442Z",
      "updatedAt": "2025-09-03T02:58:53.442Z",
      "chapterId": "a71ea5d3-a67a-48b0-90e6-5e4e97722815"
    },
    {
      "id": "b1d83add-e83b-4768-a123-9836e65bd4a4",
      "text": "Cũng vậy, ĐỨC CHÚA các đạo binh sẽ ngự xuống chiến đấu",
      "label": "4",
      "number": 4,
      "subVerseIndex": 5,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:53.456Z",
      "updatedAt": "2025-09-03T02:58:53.456Z",
      "chapterId": "a71ea5d3-a67a-48b0-90e6-5e4e97722815"
    },
    {
      "id": "71cfe7ea-64b9-4fa3-99d9-b33d693c2656",
      "text": "trên núi Xi-on, trên đồi của thành.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 6,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:53.489Z",
      "updatedAt": "2025-09-03T02:58:53.489Z",
      "chapterId": "a71ea5d3-a67a-48b0-90e6-5e4e97722815"
    },
    {
      "id": "4d8b0f39-8a9f-4822-8189-eb6728fb4b86",
      "text": "Như cánh chim bay đi lượn lại,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:53.517Z",
      "updatedAt": "2025-09-03T02:58:53.517Z",
      "chapterId": "a71ea5d3-a67a-48b0-90e6-5e4e97722815"
    },
    {
      "id": "b28f25ae-aead-48f6-8fe6-8ccc0045301f",
      "text": "ĐỨC CHÚA các đạo binh sẽ bảo vệ Giê-ru-sa-lem,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:53.560Z",
      "updatedAt": "2025-09-03T02:58:53.560Z",
      "chapterId": "a71ea5d3-a67a-48b0-90e6-5e4e97722815"
    },
    {
      "id": "de3a1924-09fe-495d-b1ad-143bfced070d",
      "text": "Người sẽ bảo vệ và giải thoát, sẽ dung tha và cứu độ.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:53.603Z",
      "updatedAt": "2025-09-03T02:58:53.603Z",
      "chapterId": "a71ea5d3-a67a-48b0-90e6-5e4e97722815"
    },
    {
      "id": "0843057d-8aea-4c72-a8ac-fae56c5130e3",
      "text": "Hỡi con cái Ít-ra-en, hãy trở lại",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:53.617Z",
      "updatedAt": "2025-09-03T02:58:53.617Z",
      "chapterId": "a71ea5d3-a67a-48b0-90e6-5e4e97722815"
    },
    {
      "id": "f7622344-a46b-4320-884a-c78a76bd74ba",
      "text": "với Đấng anh em đã phản bội nặng nề.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:53.645Z",
      "updatedAt": "2025-09-03T02:58:53.645Z",
      "chapterId": "a71ea5d3-a67a-48b0-90e6-5e4e97722815"
    },
    {
      "id": "0ec557ee-520a-4c9e-b6ef-451412779438",
      "text": "Phải, trong ngày đó, mỗi người sẽ vứt bỏ",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:53.659Z",
      "updatedAt": "2025-09-03T02:58:53.659Z",
      "chapterId": "a71ea5d3-a67a-48b0-90e6-5e4e97722815"
    },
    {
      "id": "d2fef3aa-cfea-474c-94b1-c91961e2ce12",
      "text": "các tượng thần bằng bạc bằng vàng",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:53.701Z",
      "updatedAt": "2025-09-03T02:58:53.701Z",
      "chapterId": "a71ea5d3-a67a-48b0-90e6-5e4e97722815"
    },
    {
      "id": "ae9bc5fd-a2d2-49c9-ae51-18654878e752",
      "text": "do tay tội lỗi của anh em làm ra.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:53.715Z",
      "updatedAt": "2025-09-03T02:58:53.715Z",
      "chapterId": "a71ea5d3-a67a-48b0-90e6-5e4e97722815"
    },
    {
      "id": "8a2db2b7-d494-42cf-a3dc-953746917db9",
      "text": "Át-sua sẽ ngã gục dưới một lưỡi gươm không phải của con người.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:53.729Z",
      "updatedAt": "2025-09-03T02:58:53.729Z",
      "chapterId": "a71ea5d3-a67a-48b0-90e6-5e4e97722815"
    },
    {
      "id": "52fb62d3-a5de-4d5f-a3da-178a1193f329",
      "text": "Nó sẽ bị tiêu diệt do một lưỡi gươm không phải của người phàm.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:53.757Z",
      "updatedAt": "2025-09-03T02:58:53.757Z",
      "chapterId": "a71ea5d3-a67a-48b0-90e6-5e4e97722815"
    },
    {
      "id": "11886eeb-f3ca-4114-9f86-c6f8a0854ccf",
      "text": "Nó sẽ phải trốn chạy trước lưỡi gươm,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:53.771Z",
      "updatedAt": "2025-09-03T02:58:53.771Z",
      "chapterId": "a71ea5d3-a67a-48b0-90e6-5e4e97722815"
    },
    {
      "id": "aa996ff1-8582-4a86-a3a5-13e17ac76e07",
      "text": "trai tráng của nó sẽ phải làm lao dịch.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 3,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:53.785Z",
      "updatedAt": "2025-09-03T02:58:53.785Z",
      "chapterId": "a71ea5d3-a67a-48b0-90e6-5e4e97722815"
    },
    {
      "id": "3ed71dc1-25d7-47c4-ac92-2cf20f612047",
      "text": "Đá tảng của nó sẽ bỏ đi vì sợ hãi,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:53.798Z",
      "updatedAt": "2025-09-03T02:58:53.798Z",
      "chapterId": "a71ea5d3-a67a-48b0-90e6-5e4e97722815"
    },
    {
      "id": "47578f1a-fa65-471b-8c0f-28c114047d8c",
      "text": "khi thấy cờ hiệu, các tướng lãnh của nó sẽ kinh hoàng.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:53.830Z",
      "updatedAt": "2025-09-03T02:58:53.830Z",
      "chapterId": "a71ea5d3-a67a-48b0-90e6-5e4e97722815"
    },
    {
      "id": "e1d0aa2b-1756-4d17-a115-b9978df3dcb3",
      "text": "Đó là sấm ngôn của ĐỨC CHÚA, Đấng có lửa tại Xi-on,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:53.844Z",
      "updatedAt": "2025-09-03T02:58:53.844Z",
      "chapterId": "a71ea5d3-a67a-48b0-90e6-5e4e97722815"
    },
    {
