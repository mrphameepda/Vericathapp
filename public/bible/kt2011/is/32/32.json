      "id": "2dca3b06-f2eb-4aae-a842-0fba95ec0eda",
      "content": "*Bỏ áo ...* : nghi thức tang chế.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "10",
      "sortOrder": 9,
      "startOffset": 9,
      "endOffset": 9,
      "createdAt": "2025-09-03T02:59:00.005Z",
      "updatedAt": "2025-09-03T02:59:00.005Z",
