{
  "chapter": {
    "id": "904bb400-6217-4992-b4a0-2e0c7d05f801",
    "number": 32,
    "createdAt": "2025-09-03T01:07:51.736Z",
    "updatedAt": "2025-09-03T01:07:51.736Z",
    "bookId": "d17ae149-2718-48e5-b452-c522381bf71a"
  },
  "verses": [
    {
      "id": "900ac477-3f31-4626-955f-5b991379e1fb",
      "text": "Này đây, một vua sẽ trị vì theo lẽ công minh,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:59.306Z",
      "updatedAt": "2025-09-03T02:58:59.306Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "6709d06d-240d-4480-85da-54e0a439c91c",
      "text": "các thủ lãnh sẽ cầm quyền theo đường chính trực.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:59.363Z",
      "updatedAt": "2025-09-03T02:58:59.363Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "20715416-0d4c-4d63-a7b1-dfabc60ad4cb",
      "text": "Mỗi vị sẽ như một nơi tránh gió, một chốn trú mưa,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:59.384Z",
      "updatedAt": "2025-09-03T02:58:59.384Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "646e3f46-c113-4a26-94e7-b15232fc7dcc",
      "text": "như suối nước ở chỗ khô cằn,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:59.398Z",
      "updatedAt": "2025-09-03T02:58:59.398Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "0545cde1-a90e-410b-9070-4ea4170aeb85",
      "text": "như tảng đá to rợp bóng trên đất bị hạn hán.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:59.412Z",
      "updatedAt": "2025-09-03T02:58:59.412Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "05084c0c-95c0-4cf9-87be-5bd605a787b7",
      "text": "Bấy giờ mắt những người thấy sẽ không còn bị mờ,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:59.426Z",
      "updatedAt": "2025-09-03T02:58:59.426Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "62ee20b4-8c65-414e-ab3d-da8a182add94",
      "text": "tai những người nghe sẽ trở nên chăm chú ;",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:59.468Z",
      "updatedAt": "2025-09-03T02:58:59.468Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "c594f9ba-173f-4505-a631-b5ec03c351cf",
      "text": "lòng những người nhẹ dạ sẽ gẫm suy để am tường,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:59.488Z",
      "updatedAt": "2025-09-03T02:58:59.488Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "34354618-c994-4f2e-8be9-31a159209123",
      "text": "lưỡi những kẻ ngọng sẽ nói năng hoạt bát.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:59.502Z",
      "updatedAt": "2025-09-03T02:58:59.502Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "5fa92e85-0437-4f1b-b96d-6d7aa5273a8c",
      "text": "Kẻ ngu xuẩn sẽ không được gọi là cao thượng,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:59.530Z",
      "updatedAt": "2025-09-03T02:58:59.530Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "7480f292-5dd8-4095-b596-04c4ad2a6399",
      "text": "người quỷ quyệt không được coi là cao quý.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:59.573Z",
      "updatedAt": "2025-09-03T02:58:59.573Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "b2ea75e8-29bc-41e0-af89-36201c7c2f88",
      "text": "Quả thế, kẻ ngu xuẩn nói điều ngu xuẩn,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:59.593Z",
      "updatedAt": "2025-09-03T02:58:59.593Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "b7711421-7916-4dfe-8b4e-7fd531bf29b9",
      "text": "và lòng dạ mưu đồ chuyện xấu xa :",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:59.649Z",
      "updatedAt": "2025-09-03T02:58:59.649Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "9499e494-e883-4785-af9d-cd9202e0c3a0",
      "text": "nó làm chuyện vô luân, nói điều sai lạc phạm đến ĐỨC CHÚA ;",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:59.663Z",
      "updatedAt": "2025-09-03T02:58:59.663Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "a5f89c7a-2380-4a1c-9e7e-c42112b87ec1",
      "text": "người đói thì nó để bụng không,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 3,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:59.690Z",
      "updatedAt": "2025-09-03T02:58:59.690Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "b55a7c2f-ecd1-454f-bb6f-49a7228f45ff",
      "text": "còn kẻ khát thì chẳng cho nước uống.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 4,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:59.704Z",
      "updatedAt": "2025-09-03T02:58:59.704Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "0400b534-9ebf-4cb2-b98d-5332f2aee1ee",
      "text": "Người quỷ quyệt dùng trò quỷ quyệt xấu xa,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:59.719Z",
      "updatedAt": "2025-09-03T02:58:59.719Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "eb99f184-8227-49bf-871a-cef11ba707ec",
      "text": "nó bày ra mưu thâm chước độc, dùng những lời giả dối",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:59.732Z",
      "updatedAt": "2025-09-03T02:58:59.732Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "1676ac6c-ea94-4a11-bab8-03332cac45aa",
      "text": "hại kẻ nghèo hèn, hại người cùng khổ",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:59.747Z",
      "updatedAt": "2025-09-03T02:58:59.747Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "882f5366-7f28-4784-88cd-05dd8f2d2bfd",
      "text": "ngay khi họ đòi quyền lợi của mình.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 3,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:59.775Z",
      "updatedAt": "2025-09-03T02:58:59.775Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "c3f8caec-9fa7-4671-926d-d661c4546ee8",
      "text": "Còn người cao thượng thì suy tính những điều cao thượng",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:59.789Z",
      "updatedAt": "2025-09-03T02:58:59.789Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "1c389066-b192-4609-8221-3601c638adf4",
      "text": "và vì những điều cao thượng mà đứng ra lên tiếng.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:59.802Z",
      "updatedAt": "2025-09-03T02:58:59.802Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "3df68e5b-bd23-48ea-ab19-0050680064be",
      "text": "Bọn đàn bà ngạo mạn, hãy trỗi dậy mà nghe tiếng Ta !",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:59.831Z",
      "updatedAt": "2025-09-03T02:58:59.831Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "9f18b9e8-c605-481e-b847-459ced1d787e",
      "text": "Lũ con gái khinh đời, hãy lắng tai nghe lời Ta nói !",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:59.901Z",
      "updatedAt": "2025-09-03T02:58:59.901Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "dbde4bfd-d9f2-4992-be8b-818c311ef279",
      "text": "Chỉ còn một năm mấy ngày nữa,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:59.916Z",
      "updatedAt": "2025-09-03T02:58:59.916Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "41305577-0e45-45ec-b743-ee920d2d6778",
      "text": "hỡi đám phụ nữ khinh đời, các ngươi sẽ run rẩy,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:59.930Z",
      "updatedAt": "2025-09-03T02:58:59.930Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "3991a159-c1e5-41e2-9733-2e1f51e37c22",
      "text": "bởi vì mùa nho sắp lụi tàn, không còn thu hoạch chi nữa hết !",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:59.944Z",
      "updatedAt": "2025-09-03T02:58:59.944Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "33038cf9-470e-4d55-80ad-b06f6ccf1094",
      "text": "Run rẩy đi, bọn đàn bà ngạo mạn,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:59.958Z",
      "updatedAt": "2025-09-03T02:58:59.958Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "2c6f7456-d049-4ce4-9421-bfc748365de3",
      "text": "sợ quýnh lên, lũ con gái khinh đời !",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:59.973Z",
      "updatedAt": "2025-09-03T02:58:59.973Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "e8fca59d-8735-4a20-87f9-d9a442e6d0c3",
      "text": "Hãy bỏ áo, cởi trần, quấn bao bị vào lưng.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:58:59.990Z",
      "updatedAt": "2025-09-03T02:58:59.990Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "5c5d9922-ff07-4713-8883-a63bb60a7c02",
      "text": "Hãy đấm ngực khóc than cho những cánh đồng tươi mát,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:00.018Z",
      "updatedAt": "2025-09-03T02:59:00.018Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "0d139046-1729-47e0-9357-2f092e269cf8",
      "text": "cho vườn nho sai quả,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:00.046Z",
      "updatedAt": "2025-09-03T02:59:00.046Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "35dd9917-83f6-4ec4-93d0-88310aad6484",
      "text": "cho đất màu của dân Ta",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:00.061Z",
      "updatedAt": "2025-09-03T02:59:00.061Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "06717527-5917-4cf9-8f52-6f2aaca4f98b",
      "text": "đã mọc đầy bụi rậm và gai góc,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:00.074Z",
      "updatedAt": "2025-09-03T02:59:00.074Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "318319f6-2950-416f-bce1-6b155d30c4d2",
      "text": "cho mọi nhà đang truy hoan trong thành phố vui nhộn.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:00.088Z",
      "updatedAt": "2025-09-03T02:59:00.088Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "4d7096a3-a714-4078-a711-6cc5e99e91cf",
      "text": "Quả thật lâu đài bị bỏ hoang,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:00.103Z",
      "updatedAt": "2025-09-03T02:59:00.103Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "46df2f77-277e-4b09-a082-a9d5ba33a9c9",
      "text": "thành thị đông dân nên hiu quạnh,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:00.116Z",
      "updatedAt": "2025-09-03T02:59:00.116Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "b3826eba-f3ac-4373-822b-ae88d1afe51d",
      "text": "Ô-phen với vọng lâu thành trơ trụi muôn đời",
      "label": "14",
      "number": 14,
      "subVerseIndex": 2,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:00.131Z",
      "updatedAt": "2025-09-03T02:59:00.131Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "e10f9689-e112-4632-b12c-c92d9cb42995",
      "text": "cho lừa hoang tha hồ đùa giỡn, cho súc vật gặm cỏ no nê,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 3,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:00.174Z",
      "updatedAt": "2025-09-03T02:59:00.174Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "ba1859e1-c8ba-4be8-b034-1879b0562473",
      "text": "cho đến ngày, từ trên cao, thần khí sẽ được đổ xuống trên chúng ta.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:00.188Z",
      "updatedAt": "2025-09-03T02:59:00.188Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "b4ae2e2d-b17d-4d9e-a464-ec0f706439f7",
      "text": "Bấy giờ, sa mạc sẽ trở nên vườn cây ăn trái,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:00.259Z",
      "updatedAt": "2025-09-03T02:59:00.259Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "b368f966-6422-4a86-a564-858cab0e3039",
      "text": "và vườn cây ăn trái sẽ được coi như một cánh rừng.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 2,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:00.273Z",
      "updatedAt": "2025-09-03T02:59:00.273Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "9dab37c2-32ba-45d3-a267-28188184dccc",
      "text": "Lẽ chính trực sẽ ở trong sa mạc,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:00.287Z",
      "updatedAt": "2025-09-03T02:59:00.287Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "4a5d846e-87df-4c2c-bedd-8f6d9f6274c2",
      "text": "và đức công minh trong vườn cây ăn trái.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:00.301Z",
      "updatedAt": "2025-09-03T02:59:00.301Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "566df78a-1265-48d8-bec0-dc3a4a8463fd",
      "text": "Sự nghiệp của đức công minh sẽ là hoà bình.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:00.314Z",
      "updatedAt": "2025-09-03T02:59:00.314Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "f2afd1e4-02cc-4503-b124-a6d7327656c4",
      "text": "Thành quả của đức công minh",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:00.342Z",
      "updatedAt": "2025-09-03T02:59:00.342Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "a4782a9d-1f81-444c-b6b3-abf007315698",
      "text": "sẽ là sự yên hàn và an ninh vĩnh cửu.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 2,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:00.357Z",
      "updatedAt": "2025-09-03T02:59:00.357Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "fbf4620d-1853-416f-96a4-e09030a7e7c2",
      "text": "Dân Ta sẽ ở trong cảnh thái bình,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:00.371Z",
      "updatedAt": "2025-09-03T02:59:00.371Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "69d62db2-bbd5-4727-9d7f-d964c872e6c5",
      "text": "trong nơi ở an toàn, trong chốn nghỉ thảnh thơi.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:00.386Z",
      "updatedAt": "2025-09-03T02:59:00.386Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "aca6e3f3-7eac-403d-9624-3a2319234513",
      "text": "Nhưng rừng sẽ bị đốn tận gốc, và thành sẽ bị triệt hạ.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:00.400Z",
      "updatedAt": "2025-09-03T02:59:00.400Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "7d46c0dc-56eb-48b4-ae87-a0466d32cbb4",
      "text": "Anh em có phúc vì sẽ được gieo khắp những nơi có nước,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:00.428Z",
      "updatedAt": "2025-09-03T02:59:00.428Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    },
    {
      "id": "2fa2a34e-c984-4e1e-8554-e62cf7a006c2",
      "text": "và thả rong bò lừa.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:00.443Z",
      "updatedAt": "2025-09-03T02:59:00.443Z",
      "chapterId": "904bb400-6217-4992-b4a0-2e0c7d05f801"
    }
  ],
