    {
      "id": "e200a029-02bd-4ceb-affc-5959d67bb3b6",
      "content": "*Li-lít* : con quỷ cái thường ở nơi hoang tàn, theo thần thoại Lưỡng Hà Địa.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "22",
      "sortOrder": 21,
      "startOffset": 39,
      "endOffset": 39,
      "createdAt": "2025-09-03T02:59:13.842Z",
      "updatedAt": "2025-09-03T02:59:13.842Z",
      "targetId": "e6bbcfe6-e4c1-4d11-86fb-70702cb47636",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "5ba6bd48-5760-4c45-a048-443bf44c2565",
      "content": "*Sách của Đức Chúa* : có thể hiểu là một cuốn sách nào đó của I-sai-a, hoặc hiểu chung về sách ghi các loài đã được tạo thành.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "23",
      "sortOrder": 22,
      "startOffset": 18,
      "endOffset": 18,
      "createdAt": "2025-09-03T02:59:13.927Z",
      "updatedAt": "2025-09-03T02:59:13.927Z",
      "targetId": "7d20217a-65c0-49e5-b9f8-2154dbad9d97",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
