{
  "chapter": {
    "id": "f7e56e8a-d35b-493f-9bfb-8edfe0146788",
    "number": 34,
    "createdAt": "2025-09-03T01:07:51.736Z",
    "updatedAt": "2025-09-03T01:07:51.736Z",
    "bookId": "d17ae149-2718-48e5-b452-c522381bf71a"
  },
  "verses": [
    {
      "id": "7f723b4e-4620-42b2-b086-3de60b5c2a82",
      "text": "Chư dân hỡi, hãy lại mà nghe, các sắc tộc, nào cùng lưu ý.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:12.797Z",
      "updatedAt": "2025-09-03T02:59:12.797Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "b67fec9f-5c3c-4ae6-b317-9d28fa7d3828",
      "text": "Hãy nghe đây, hỡi trái đất và mọi loài trên đó,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:12.903Z",
      "updatedAt": "2025-09-03T02:59:12.903Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "4268404c-06c8-40b1-a98e-2133bf8bacec",
      "text": "hỡi địa cầu cùng muôn vật từ đất nảy sinh :",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:12.934Z",
      "updatedAt": "2025-09-03T02:59:12.934Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "4d7facc0-1f82-4662-8df0-4901b1cb9c66",
      "text": "Này, ĐỨC CHÚA nổi giận với chư dân hết thảy,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:12.952Z",
      "updatedAt": "2025-09-03T02:59:12.952Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "983c2f6a-02c4-4229-8b69-51427551b303",
      "text": "Người thịnh nộ với toàn thể đạo binh của chúng,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:12.979Z",
      "updatedAt": "2025-09-03T02:59:12.979Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "ab0d06e8-e9ca-42e5-9c69-1ff9e8d66bd1",
      "text": "cho chúng bị tru diệt và tiêu vong.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:12.994Z",
      "updatedAt": "2025-09-03T02:59:12.994Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "7ea8d848-9124-4d98-adb7-c8e2b1019efe",
      "text": "Những kẻ bị đâm chết sẽ bị quẳng đi xa.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:13.008Z",
      "updatedAt": "2025-09-03T02:59:13.008Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "4cb72a44-18d3-438e-97e9-8dc88750d64f",
      "text": "Tử thi xông mùi hôi thối, núi non máu chảy dầm dề.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:13.023Z",
      "updatedAt": "2025-09-03T02:59:13.023Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "f97861cc-3082-461c-86b1-334d5d7bb4ae",
      "text": "Toàn thể đạo binh trên trời tan rã.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:13.038Z",
      "updatedAt": "2025-09-03T02:59:13.038Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "64fc0190-9734-4ee3-a6f0-8c615d75cba0",
      "text": "Các tầng trời cuộn lại như cuốn sách.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:13.052Z",
      "updatedAt": "2025-09-03T02:59:13.052Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "ae93eb70-7994-4002-b7e4-b0db687888fb",
      "text": "Cả đạo binh của chúng lụi tàn",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:13.101Z",
      "updatedAt": "2025-09-03T02:59:13.101Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "93d635d6-42bb-4601-acde-4384a31baa23",
      "text": "như lá nho rơi rụng, tựa lá vả lìa cành.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 3,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:13.115Z",
      "updatedAt": "2025-09-03T02:59:13.115Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "b6b5b93c-a659-4606-8956-5824220ea564",
      "text": "Vì trên trời gươm Ta say máu : nó sắp giáng xuống Ê-đôm,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:13.129Z",
      "updatedAt": "2025-09-03T02:59:13.129Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "6cd46cbb-1bcf-4028-b599-3e43cf01ec76",
      "text": "xuống một dân Ta đã tuyên án tru diệt.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:13.188Z",
      "updatedAt": "2025-09-03T02:59:13.188Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "62563055-6c92-473e-acf6-baa061aeef02",
      "text": "Gươm của ĐỨC CHÚA, máu nhuộm đỏ, mỡ dính bầy nhầy,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:13.208Z",
      "updatedAt": "2025-09-03T02:59:13.208Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "7bd274cd-8434-4040-844b-7eface99f913",
      "text": "máu chiên máu dê, mỡ của trái cật loài cừu.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:13.236Z",
      "updatedAt": "2025-09-03T02:59:13.236Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "3523b3ac-a918-4e60-962d-06c90358db47",
      "text": "Vì một hy lễ đã được dâng kính ĐỨC CHÚA tại Bót-ra,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:13.251Z",
      "updatedAt": "2025-09-03T02:59:13.251Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "57d74059-d420-40fa-a82d-0a91f34697af",
      "text": "chính là cuộc tàn sát lớn trong xứ Ê-đôm.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 3,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:13.330Z",
      "updatedAt": "2025-09-03T02:59:13.330Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "aaf90639-4a8a-4218-962f-95556ce833ef",
      "text": "Cùng với chúng, nào trâu, nào bê, nào bò tót đều bị hạ.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:13.358Z",
      "updatedAt": "2025-09-03T02:59:13.358Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "3a673f71-564b-47d5-b70a-282e269a7c12",
      "text": "Đất đai của chúng máu tràn lênh láng,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:13.372Z",
      "updatedAt": "2025-09-03T02:59:13.372Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "6322b37c-c6f8-4df4-b847-15efe45afea4",
      "text": "cát bụi của chúng mỡ dính bầy nhầy.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:13.386Z",
      "updatedAt": "2025-09-03T02:59:13.386Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "cd51cc0e-a7d0-422e-bc68-a0564ce2f9cb",
      "text": "Quả thế, đó là ngày ĐỨC CHÚA báo phục,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:13.400Z",
      "updatedAt": "2025-09-03T02:59:13.400Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "74d97e17-3d9b-41a7-8059-9684435b5a0e",
      "text": "là năm Người trả oán mà biện hộ cho Xi-on.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:13.430Z",
      "updatedAt": "2025-09-03T02:59:13.430Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "9c85b66e-40ed-4861-be06-1bbf4d4d9576",
      "text": "Và suối nước biến thành nhựa chai,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:13.461Z",
      "updatedAt": "2025-09-03T02:59:13.461Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "3ee35cf7-e567-46a0-aad6-11e4f4b3849d",
      "text": "cát bụi hoá lưu huỳnh, đất đai thành nhựa cháy,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:13.476Z",
      "updatedAt": "2025-09-03T02:59:13.476Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "b6bedc89-edcf-48e5-a38b-903a3640234e",
      "text": "ngày đêm bốc lửa không ngừng, đời đời nghi ngút khói ;",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:13.518Z",
      "updatedAt": "2025-09-03T02:59:13.518Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "7c220d7e-749d-4a34-b28c-95844805e6c3",
      "text": "thế hệ này qua thế hệ kia, vẫn một cảnh hoang tàn,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:13.531Z",
      "updatedAt": "2025-09-03T02:59:13.531Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "dc334566-8864-4c53-9cee-cbe63351436e",
      "text": "không bóng người lai vãng.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:13.546Z",
      "updatedAt": "2025-09-03T02:59:13.546Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "24770daa-6711-47bb-a6ec-db5539972d90",
      "text": "Đó sẽ là lãnh địa của nhím và kền kền,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:13.560Z",
      "updatedAt": "2025-09-03T02:59:13.560Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "467dfb0d-3fb8-4d87-9cae-9d39265c95ad",
      "text": "là nơi ở cho loài cú, loài quạ.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:13.575Z",
      "updatedAt": "2025-09-03T02:59:13.575Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "cdff5f16-783b-4e2e-bf19-166e3eea0e15",
      "text": "ĐỨC CHÚA sẽ giăng dây đo biến nó thành hỗn mang,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:13.589Z",
      "updatedAt": "2025-09-03T02:59:13.589Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "fc1fa697-c902-4149-b8db-fe2db5d3287b",
      "text": "Người sẽ thả hòn chì cho nó nên trống rỗng.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 3,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:13.645Z",
      "updatedAt": "2025-09-03T02:59:13.645Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "1b5fa29d-1b2e-497e-bb92-8a5639c7fe37",
      "text": "Giới quý tộc của nó không còn,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:13.688Z",
      "updatedAt": "2025-09-03T02:59:13.688Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "bd2499be-be8e-4d46-84f7-d1d41892afa0",
      "text": "ở đó người ta chẳng tôn vương nữa,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:13.715Z",
      "updatedAt": "2025-09-03T02:59:13.715Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "d69c865b-272c-41ea-a743-c718f33dbfad",
      "text": "mọi thủ lãnh đều sẽ kể bằng không.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:13.742Z",
      "updatedAt": "2025-09-03T02:59:13.742Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "62cb0ea3-c199-46cf-831f-647df5f60108",
      "text": "Trong các lâu đài của nó, gai góc mọc um tùm,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:13.757Z",
      "updatedAt": "2025-09-03T02:59:13.757Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "4b22c7d9-fe95-49b4-9d29-eb7d43b1dd50",
      "text": "các đồn luỹ kiên cố đầy những tầm ma và cỏ dại.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:13.772Z",
      "updatedAt": "2025-09-03T02:59:13.772Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "64eb8644-6cb4-4020-abdc-1663e9e4d9ee",
      "text": "Nó sẽ là hang ổ sói rừng, là sân chim đà điểu.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:13.786Z",
      "updatedAt": "2025-09-03T02:59:13.786Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "49487ac7-a084-4ba0-b9fd-a1d731dceadf",
      "text": "Mèo rừng gặp chó rừng, loài dê ma quái hú gọi nhau.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:13.800Z",
      "updatedAt": "2025-09-03T02:59:13.800Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "e6bbcfe6-e4c1-4d11-86fb-70702cb47636",
      "text": "Đó cũng là nơi dung thân cho quỷ Li-lít, là chốn hắn nghỉ ngơi.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:13.814Z",
      "updatedAt": "2025-09-03T02:59:13.814Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "6aec0809-8cb5-43b5-be44-a1678f96ceca",
      "text": "Đó còn là nơi rắn làm ổ đẻ trứng, ấp cho nở và ủ ấm đàn con.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:13.871Z",
      "updatedAt": "2025-09-03T02:59:13.871Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "0f3e498d-7789-455a-9175-44b04aae3a24",
      "text": "Cũng tại đó, lũ diều hâu tụ tập, con nào cũng có bạn có đôi.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:13.885Z",
      "updatedAt": "2025-09-03T02:59:13.885Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "7d20217a-65c0-49e5-b9f8-2154dbad9d97",
      "text": "Hãy tìm trong sách của ĐỨC CHÚA và đọc :",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:13.913Z",
      "updatedAt": "2025-09-03T02:59:13.913Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "5745c0c6-4155-4990-903b-b2c32aae8d45",
      "text": "sẽ không thiếu một con nào trong chúng,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:13.954Z",
      "updatedAt": "2025-09-03T02:59:13.954Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "1e329b9a-9571-49a1-95bb-b090a51f7dcf",
      "text": "con nào cũng có bạn có đôi.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 2,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:13.968Z",
      "updatedAt": "2025-09-03T02:59:13.968Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "8e05ff52-ce56-438d-bf41-eef648705ad8",
      "text": "Bởi vì chính miệng Chúa đã phán truyền,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 3,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:13.984Z",
      "updatedAt": "2025-09-03T02:59:13.984Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "7828bb38-7031-4d5e-9cf3-de389a3162f7",
      "text": "chính thần khí Người quy tụ lại.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 4,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:13.998Z",
      "updatedAt": "2025-09-03T02:59:13.998Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "93732a73-89a0-4ce1-a278-99a1d57638ea",
      "text": "Chính Người đã bốc thăm,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:14.011Z",
      "updatedAt": "2025-09-03T02:59:14.011Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "b147b707-307e-49a5-ab37-4ce716f5e9d6",
      "text": "và tay Người đã dùng dây đo mà chia phần cho chúng.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:14.042Z",
      "updatedAt": "2025-09-03T02:59:14.042Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "f8fe2e41-2fac-42df-ac68-c3772888e440",
      "text": "Đến muôn đời, chúng sẽ được thừa hưởng phần này,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 2,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:14.057Z",
      "updatedAt": "2025-09-03T02:59:14.057Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    },
    {
      "id": "ac4645fb-9892-457c-afb8-b1b825246a4a",
      "text": "chúng sẽ ở lại đây hết đời này qua đời nọ.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 3,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:14.071Z",
      "updatedAt": "2025-09-03T02:59:14.071Z",
      "chapterId": "f7e56e8a-d35b-493f-9bfb-8edfe0146788"
    }
  ],
