{
  "chapter": {
    "id": "4d595c97-33d7-4443-bb97-c2b5549274d8",
    "number": 35,
    "createdAt": "2025-09-03T01:07:51.736Z",
    "updatedAt": "2025-09-03T01:07:51.736Z",
    "bookId": "d17ae149-2718-48e5-b452-c522381bf71a"
  },
  "verses": [
    {
      "id": "78e25a3c-bb32-4f90-a961-7bd2fabafcce",
      "text": "Vui lên nào, hỡi sa mạc và đồng khô cỏ cháy,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:19.412Z",
      "updatedAt": "2025-09-03T02:59:19.412Z",
      "chapterId": "4d595c97-33d7-4443-bb97-c2b5549274d8"
    },
    {
      "id": "c8e5ad42-8692-434a-a036-2aa4227a2627",
      "text": "vùng đất hoang, hãy mừng rỡ trổ bông,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:19.464Z",
      "updatedAt": "2025-09-03T02:59:19.464Z",
      "chapterId": "4d595c97-33d7-4443-bb97-c2b5549274d8"
    },
    {
      "id": "388bdca9-4879-4f8c-a804-6e9a05a2df55",
      "text": "hãy tưng bừng nở hoa như khóm huệ,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:19.492Z",
      "updatedAt": "2025-09-03T02:59:19.492Z",
      "chapterId": "4d595c97-33d7-4443-bb97-c2b5549274d8"
    },
    {
      "id": "0f5e1566-5119-4e65-b9f2-e43e06e91163",
      "text": "và hân hoan múa nhảy reo hò.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:19.506Z",
      "updatedAt": "2025-09-03T02:59:19.506Z",
      "chapterId": "4d595c97-33d7-4443-bb97-c2b5549274d8"
    },
    {
      "id": "0e310625-3c85-4f8d-97de-6cfee94c7457",
      "text": "Sa mạc được tặng ban ánh huy hoàng của núi Li-băng,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:19.520Z",
      "updatedAt": "2025-09-03T02:59:19.520Z",
      "chapterId": "4d595c97-33d7-4443-bb97-c2b5549274d8"
    },
    {
      "id": "7d657264-bde4-4325-a417-7204d2db6799",
      "text": "vẻ rực rỡ của núi Các-men và đồng bằng Sa-rôn.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 3,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:19.578Z",
      "updatedAt": "2025-09-03T02:59:19.578Z",
      "chapterId": "4d595c97-33d7-4443-bb97-c2b5549274d8"
    },
    {
      "id": "64ad2336-a930-4df0-9466-e5ffb8b1eefd",
      "text": "Thiên hạ sẽ nhìn thấy ánh huy hoàng của ĐỨC CHÚA,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 4,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:19.635Z",
      "updatedAt": "2025-09-03T02:59:19.635Z",
      "chapterId": "4d595c97-33d7-4443-bb97-c2b5549274d8"
    },
    {
      "id": "586dc7f3-b634-4b90-8f70-30cd893db880",
      "text": "và vẻ rực rỡ của Thiên Chúa chúng ta.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 5,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:19.663Z",
      "updatedAt": "2025-09-03T02:59:19.663Z",
      "chapterId": "4d595c97-33d7-4443-bb97-c2b5549274d8"
    },
    {
      "id": "6c4b6dc1-5730-41bd-9adf-e4d627c977c6",
      "text": "Hãy làm cho những bàn tay rã rời nên mạnh mẽ,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:19.690Z",
      "updatedAt": "2025-09-03T02:59:19.690Z",
      "chapterId": "4d595c97-33d7-4443-bb97-c2b5549274d8"
    },
    {
      "id": "156c533b-93a6-4f30-bfe0-6dc110a47222",
      "text": "cho những đầu gối bủn rủn được vững vàng.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:19.718Z",
      "updatedAt": "2025-09-03T02:59:19.718Z",
      "chapterId": "4d595c97-33d7-4443-bb97-c2b5549274d8"
    },
    {
      "id": "f508eec2-2ef0-4e59-898a-d21075ff51b3",
      "text": "Hãy nói với những kẻ nhát gan : “Can đảm lên, đừng sợ !",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:19.732Z",
      "updatedAt": "2025-09-03T02:59:19.732Z",
      "chapterId": "4d595c97-33d7-4443-bb97-c2b5549274d8"
    },
    {
      "id": "bca4cdcc-1995-4232-9002-0908955e9cdc",
      "text": "Thiên Chúa của anh em đây rồi ; sắp tới ngày báo phục,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:19.747Z",
      "updatedAt": "2025-09-03T02:59:19.747Z",
      "chapterId": "4d595c97-33d7-4443-bb97-c2b5549274d8"
    },
    {
      "id": "83a9680b-382e-444b-a1e6-fae7d0d224ba",
      "text": "ngày Thiên Chúa thưởng công, phạt tội.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:19.775Z",
      "updatedAt": "2025-09-03T02:59:19.775Z",
      "chapterId": "4d595c97-33d7-4443-bb97-c2b5549274d8"
    },
    {
      "id": "edf825c1-dd42-453d-9759-e26dbc8fcb58",
      "text": "Chính Người sẽ đến cứu anh em.”",
      "label": "4",
      "number": 4,
      "subVerseIndex": 3,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:19.789Z",
      "updatedAt": "2025-09-03T02:59:19.789Z",
      "chapterId": "4d595c97-33d7-4443-bb97-c2b5549274d8"
    },
    {
      "id": "8cddb9cf-49e2-4752-b80a-e50a706106e8",
      "text": "Bấy giờ, mắt người mù mở ra, tai người điếc nghe được.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:19.803Z",
      "updatedAt": "2025-09-03T02:59:19.803Z",
      "chapterId": "4d595c97-33d7-4443-bb97-c2b5549274d8"
    },
    {
      "id": "66ab4b77-232d-4a21-b7ab-50b5dcc78a54",
      "text": "Bấy giờ, kẻ què sẽ nhảy nhót như nai,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:19.833Z",
      "updatedAt": "2025-09-03T02:59:19.833Z",
      "chapterId": "4d595c97-33d7-4443-bb97-c2b5549274d8"
    },
    {
      "id": "4c78b577-1add-4ac0-af97-9d013f659718",
      "text": "miệng lưỡi người câm sẽ reo hò.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:19.861Z",
      "updatedAt": "2025-09-03T02:59:19.861Z",
      "chapterId": "4d595c97-33d7-4443-bb97-c2b5549274d8"
    },
    {
      "id": "2077290b-c667-4d70-ac22-8e9e5ad52bae",
      "text": "Vì có nước vọt lên trong sa mạc,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:19.876Z",
      "updatedAt": "2025-09-03T02:59:19.876Z",
      "chapterId": "4d595c97-33d7-4443-bb97-c2b5549274d8"
    },
    {
      "id": "0bfa6453-9eb9-4c60-befb-1919050a5258",
      "text": "khe suối tuôn ra giữa vùng đất hoang vu.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 3,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:19.904Z",
      "updatedAt": "2025-09-03T02:59:19.904Z",
      "chapterId": "4d595c97-33d7-4443-bb97-c2b5549274d8"
    },
    {
      "id": "13b018ec-c033-4c76-83e7-60585d752e69",
      "text": "Miền nóng bỏng biến thành ao hồ,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:19.918Z",
      "updatedAt": "2025-09-03T02:59:19.918Z",
      "chapterId": "4d595c97-33d7-4443-bb97-c2b5549274d8"
    },
    {
      "id": "2fea0497-0ead-4cb2-a219-99fbbed2f21a",
      "text": "đất khô cằn có mạch nước trào ra.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:19.932Z",
      "updatedAt": "2025-09-03T02:59:19.932Z",
      "chapterId": "4d595c97-33d7-4443-bb97-c2b5549274d8"
    },
    {
      "id": "f2cd987d-f23d-4b64-8a44-a010c3aeb72d",
      "text": "Trong hang chó rừng ở, sậy cói sẽ mọc lên.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:19.947Z",
      "updatedAt": "2025-09-03T02:59:19.947Z",
      "chapterId": "4d595c97-33d7-4443-bb97-c2b5549274d8"
    },
    {
      "id": "0a6160e6-a6dd-4fd2-9e4c-d7d8c6bfd6da",
      "text": "Ở đó sẽ có một đường đi mang tên là thánh lộ.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:19.960Z",
      "updatedAt": "2025-09-03T02:59:19.960Z",
      "chapterId": "4d595c97-33d7-4443-bb97-c2b5549274d8"
    },
    {
      "id": "2e9b97a5-027f-41d6-8b72-e7a0503e9862",
      "text": "Kẻ ô uế sẽ chẳng được qua.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:20.003Z",
      "updatedAt": "2025-09-03T02:59:20.003Z",
      "chapterId": "4d595c97-33d7-4443-bb97-c2b5549274d8"
    },
    {
      "id": "8dbc8486-5b27-491a-9b69-ccac9411debc",
      "text": "Đó sẽ là con đường cho họ đi,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:20.016Z",
      "updatedAt": "2025-09-03T02:59:20.016Z",
      "chapterId": "4d595c97-33d7-4443-bb97-c2b5549274d8"
    },
    {
      "id": "33037f43-ee7f-492c-96ef-a481b74e847d",
      "text": "những kẻ điên dại sẽ không được lang thang trên đó.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 3,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:20.030Z",
      "updatedAt": "2025-09-03T02:59:20.030Z",
      "chapterId": "4d595c97-33d7-4443-bb97-c2b5549274d8"
    },
    {
      "id": "3f2e3eb1-adf1-444c-b27d-1c76e71cbaf4",
      "text": "Ở đó sẽ không có sư tử, thú dữ ăn thịt cũng chẳng vãng lai,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:20.043Z",
      "updatedAt": "2025-09-03T02:59:20.043Z",
      "chapterId": "4d595c97-33d7-4443-bb97-c2b5549274d8"
    },
    {
      "id": "a3560f48-ade7-42e1-8644-adb168780d9b",
      "text": "không thấy bóng dáng một con nào,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:20.056Z",
      "updatedAt": "2025-09-03T02:59:20.056Z",
      "chapterId": "4d595c97-33d7-4443-bb97-c2b5549274d8"
    },
    {
      "id": "4c31daf4-bb10-4e7c-be1f-bb12b0f074d7",
      "text": "nhưng ai được Chúa cứu chuộc sẽ bước đi trên đó.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:20.070Z",
      "updatedAt": "2025-09-03T02:59:20.070Z",
      "chapterId": "4d595c97-33d7-4443-bb97-c2b5549274d8"
    },
    {
      "id": "982c71ce-f65a-414c-81a8-745b9bd433d2",
      "text": "Những người được ĐỨC CHÚA giải thoát sẽ trở về,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:20.082Z",
      "updatedAt": "2025-09-03T02:59:20.082Z",
      "chapterId": "4d595c97-33d7-4443-bb97-c2b5549274d8"
    },
    {
      "id": "b4cf6b4b-3471-4b19-8d56-b9d4043b77d2",
      "text": "tiến đến Xi-on giữa tiếng hò reo,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:20.127Z",
      "updatedAt": "2025-09-03T02:59:20.127Z",
      "chapterId": "4d595c97-33d7-4443-bb97-c2b5549274d8"
    },
    {
      "id": "fb8cd02b-6a3e-4a40-93bc-fb53465c8215",
      "text": "mặt rạng rỡ niềm vui vĩnh cửu.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:20.155Z",
      "updatedAt": "2025-09-03T02:59:20.155Z",
      "chapterId": "4d595c97-33d7-4443-bb97-c2b5549274d8"
    },
    {
      "id": "9c33f78b-fb3b-4b20-b11b-f5129c3797d1",
      "text": "Họ sẽ được hớn hở tươi cười,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 3,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:20.169Z",
      "updatedAt": "2025-09-03T02:59:20.169Z",
      "chapterId": "4d595c97-33d7-4443-bb97-c2b5549274d8"
    },
    {
      "id": "e9f45243-5a19-47bb-8564-12ea92d0f988",
      "text": "đau khổ và khóc than sẽ biến mất.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 4,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:59:20.184Z",
      "updatedAt": "2025-09-03T02:59:20.184Z",
      "chapterId": "4d595c97-33d7-4443-bb97-c2b5549274d8"
    }
  ],
  "marks": [
    {
