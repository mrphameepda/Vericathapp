    },
    {
      "id": "d13c29d8-51da-4a64-91fe-b177d6cd0696",
      "content": "Is 41,19",
      "kind": "MARK_KIND_REFERENCE",
      "label": "1@",
      "sortOrder": 0,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:59:19.478Z",
      "updatedAt": "2025-09-03T02:59:19.478Z",
      "targetId": "c8e5ad42-8692-434a-a036-2aa4227a2627",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "4d595c97-33d7-4443-bb97-c2b5549274d8"
    },
    {
      "id": "8071c767-cfbd-43c3-919f-3f7abb645fa7",
      "content": "Tương phản với cảnh Ê-đôm bị vĩnh viễn thành nơi hoang phế, sa mạc sẽ nở hoa đón mừng dân thánh trở về Xi-on. Đây cũng là chủ đề căn bản trong Is 40 – 55.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 24,
      "endOffset": 24,
