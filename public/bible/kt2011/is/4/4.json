{
  "chapter": {
    "id": "522a4d52-c819-4a2d-bf64-8de8f4c85cb1",
    "number": 4,
    "createdAt": "2025-09-03T01:07:51.736Z",
    "updatedAt": "2025-09-03T01:07:51.736Z",
    "bookId": "d17ae149-2718-48e5-b452-c522381bf71a"
  },
  "verses": [
    {
      "id": "1a4dbcbe-1f22-4437-a084-6fb21a3bd0b9",
      "text": "Ngày đó, bảy bà sẽ níu lấy một ông mà nói : “Bánh ăn áo mặc, chúng em sẽ liệu lấy ; chỉ xin được mang tên chàng, xin chàng cất đi cho nỗi khổ nhục của chúng em.”",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:55:20.520Z",
      "updatedAt": "2025-09-03T02:55:20.520Z",
      "chapterId": "522a4d52-c819-4a2d-bf64-8de8f4c85cb1"
    },
    {
      "id": "a202c2bf-42f1-4b00-aa83-4be4d42a360d",
      "text": "Ngày đó, chồi non ĐỨC CHÚA cho mọc lên",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:55:20.538Z",
      "updatedAt": "2025-09-03T02:55:20.538Z",
      "chapterId": "522a4d52-c819-4a2d-bf64-8de8f4c85cb1"
    },
    {
      "id": "8813586e-6731-45db-a74c-fdbfbb759186",
      "text": "sẽ là vinh quang và danh dự,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:55:20.626Z",
      "updatedAt": "2025-09-03T02:55:20.626Z",
      "chapterId": "522a4d52-c819-4a2d-bf64-8de8f4c85cb1"
    },
    {
      "id": "27564cb1-298f-4f92-8505-be89c99613ca",
      "text": "và hoa màu từ ruộng đất trổ sinh",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:55:20.640Z",
      "updatedAt": "2025-09-03T02:55:20.640Z",
      "chapterId": "522a4d52-c819-4a2d-bf64-8de8f4c85cb1"
    },
    {
      "id": "67947fa4-9254-499f-a555-74252c63ff24",
      "text": "sẽ là niềm hãnh diện và tự hào",
      "label": "2",
      "number": 2,
      "subVerseIndex": 3,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:55:20.654Z",
      "updatedAt": "2025-09-03T02:55:20.654Z",
      "chapterId": "522a4d52-c819-4a2d-bf64-8de8f4c85cb1"
    },
    {
      "id": "83808da4-8e61-46cf-8e2f-e15541b56afe",
      "text": "cho những người Ít-ra-en thoát nạn.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 4,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:55:20.681Z",
      "updatedAt": "2025-09-03T02:55:20.681Z",
      "chapterId": "522a4d52-c819-4a2d-bf64-8de8f4c85cb1"
    },
    {
      "id": "ef22216d-58af-4947-9b08-2c64658101c9",
      "text": "Những người sống sót ở Xi-on",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:55:20.707Z",
      "updatedAt": "2025-09-03T02:55:20.707Z",
      "chapterId": "522a4d52-c819-4a2d-bf64-8de8f4c85cb1"
    },
    {
      "id": "d8d94d6a-6081-42ed-8ddc-59811f51a689",
      "text": "và những kẻ còn sót lại ở Giê-ru-sa-lem sẽ được gọi là thánh.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:55:20.748Z",
      "updatedAt": "2025-09-03T02:55:20.748Z",
      "chapterId": "522a4d52-c819-4a2d-bf64-8de8f4c85cb1"
    },
    {
      "id": "3fad3f0a-f8f5-4cdd-98ca-fd0e4e2971f0",
      "text": "Tất cả được ghi tên vào sổ để sống tại Giê-ru-sa-lem.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:55:20.794Z",
      "updatedAt": "2025-09-03T02:55:20.794Z",
      "chapterId": "522a4d52-c819-4a2d-bf64-8de8f4c85cb1"
    },
    {
      "id": "38441918-59ea-4c1a-8364-6dc38dcfe2a0",
      "text": "Khi Chúa Thượng đã dùng thần khí thông minh",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:55:20.836Z",
      "updatedAt": "2025-09-03T02:55:20.836Z",
      "chapterId": "522a4d52-c819-4a2d-bf64-8de8f4c85cb1"
    },
    {
      "id": "21a27394-553a-4367-a963-bb433ea5ffa3",
      "text": "và thần khí có sức thiêu huỷ",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:55:20.849Z",
      "updatedAt": "2025-09-03T02:55:20.849Z",
      "chapterId": "522a4d52-c819-4a2d-bf64-8de8f4c85cb1"
    },
    {
      "id": "d1c49da0-8db6-4829-9f35-14d45f006864",
      "text": "mà tẩy sạch các thiếu nữ Xi-on khỏi những gì ô uế,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:55:20.864Z",
      "updatedAt": "2025-09-03T02:55:20.864Z",
      "chapterId": "522a4d52-c819-4a2d-bf64-8de8f4c85cb1"
    },
    {
      "id": "3d1bebb8-8e2e-4a62-a4a1-a35ea0e22f58",
      "text": "và gột rửa Giê-ru-sa-lem khỏi máu đã đổ ra trong thành,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 3,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:55:20.893Z",
      "updatedAt": "2025-09-03T02:55:20.893Z",
      "chapterId": "522a4d52-c819-4a2d-bf64-8de8f4c85cb1"
    },
    {
      "id": "6a2e140e-9132-4623-bfe9-30bdcb21e8ab",
      "text": "thì trên khắp núi Xi-on, và trên những người hội họp ở đó,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:55:20.922Z",
      "updatedAt": "2025-09-03T02:55:20.922Z",
      "chapterId": "522a4d52-c819-4a2d-bf64-8de8f4c85cb1"
    },
    {
      "id": "53cef536-ba17-4f24-afe3-fb2054cd5cb4",
      "text": "ĐỨC CHÚA sẽ tạo ra một đám mây ban ngày,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:55:20.950Z",
      "updatedAt": "2025-09-03T02:55:20.950Z",
      "chapterId": "522a4d52-c819-4a2d-bf64-8de8f4c85cb1"
    },
    {
      "id": "46769a36-a2ce-4a1a-bb4f-7c3fee46d55b",
      "text": "một đám khói và một ngọn lửa rực sáng ban đêm.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:55:20.979Z",
      "updatedAt": "2025-09-03T02:55:20.979Z",
      "chapterId": "522a4d52-c819-4a2d-bf64-8de8f4c85cb1"
    },
    {
      "id": "b1df4707-ea83-4db7-9e08-3123ca4159db",
      "text": "Thật vậy, trên tất cả,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 3,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:55:20.993Z",
      "updatedAt": "2025-09-03T02:55:20.993Z",
      "chapterId": "522a4d52-c819-4a2d-bf64-8de8f4c85cb1"
    },
    {
      "id": "8b3fd0fa-dc3f-4fec-bea7-9a53c604022f",
      "text": "vinh quang của Chúa",
      "label": "5",
      "number": 5,
      "subVerseIndex": 4,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:55:21.007Z",
      "updatedAt": "2025-09-03T02:55:21.007Z",
      "chapterId": "522a4d52-c819-4a2d-bf64-8de8f4c85cb1"
    },
    {
      "id": "bfce103b-0499-4898-875f-5a84dc29a607",
      "text": "sẽ là tán che,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 5,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:55:21.020Z",
      "updatedAt": "2025-09-03T02:55:21.020Z",
      "chapterId": "522a4d52-c819-4a2d-bf64-8de8f4c85cb1"
    },
    {
      "id": "4a8fb2c3-4cc8-4ddf-9deb-512fa8cf5fee",
      "text": "là mái lều",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 1,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:55:21.047Z",
      "updatedAt": "2025-09-03T02:55:21.047Z",
      "chapterId": "522a4d52-c819-4a2d-bf64-8de8f4c85cb1"
    },
    {
      "id": "ad9c5e68-1292-4aaa-9d2d-55077b558aac",
      "text": "làm bóng râm ban ngày cho khỏi nóng,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:55:21.062Z",
      "updatedAt": "2025-09-03T02:55:21.062Z",
      "chapterId": "522a4d52-c819-4a2d-bf64-8de8f4c85cb1"
    },
    {
      "id": "98e6810c-63d1-42a6-9ad4-442d54a9e692",
      "text": "làm nơi nương ẩn khi bão táp mưa sa.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:55:21.076Z",
      "updatedAt": "2025-09-03T02:55:21.076Z",
      "chapterId": "522a4d52-c819-4a2d-bf64-8de8f4c85cb1"
    }
  ],
