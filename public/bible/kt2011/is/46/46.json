{
  "chapter": {
    "id": "d847ab7d-1743-4172-b989-d5ca50f9d96f",
    "number": 46,
    "createdAt": "2025-09-03T01:07:51.736Z",
    "updatedAt": "2025-09-03T01:07:51.736Z",
    "bookId": "d17ae149-2718-48e5-b452-c522381bf71a"
  },
  "verses": [
    {
      "id": "363ab1b6-a35f-4412-b5e1-8d96e7facb6d",
      "text": "Thần Ben đã quỵ, thần Nơ-vô sụp đổ,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:48.222Z",
      "updatedAt": "2025-09-03T03:00:48.222Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "03457b71-3d7d-4a6c-9331-7e55e19dd5d4",
      "text": "tượng của chúng bị tải đi trên lưng thú vật, trên lưng gia súc.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:48.315Z",
      "updatedAt": "2025-09-03T03:00:48.315Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "7d476fb4-1d5b-477b-8a2a-92cb04c3d94d",
      "text": "Những gì xưa kia các ngươi nâng lên vai mà kiệu,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:48.326Z",
      "updatedAt": "2025-09-03T03:00:48.326Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "52a0ecc9-b9fd-4be8-b25f-25b4fa35b61a",
      "text": "giờ đây thành gánh nặng trên những con vật mệt nhoài.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 3,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:48.353Z",
      "updatedAt": "2025-09-03T03:00:48.353Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "93fcb9e7-1703-41a0-9bb3-192c8a8b81d2",
      "text": "Tượng thần đã sụp, đã quỵ cả đám,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:48.366Z",
      "updatedAt": "2025-09-03T03:00:48.366Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "498663aa-333a-4b90-a29d-7ee3e052858b",
      "text": "không tài nào cứu những con vật tải chúng đi,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:48.377Z",
      "updatedAt": "2025-09-03T03:00:48.377Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "83a83048-f22e-466b-b843-366ed557f26b",
      "text": "và chính chúng cũng phải đi lưu đày.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:48.393Z",
      "updatedAt": "2025-09-03T03:00:48.393Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "e5da82bf-b285-4319-8125-26ac45b8785c",
      "text": "Hãy nghe Ta, hỡi nhà Gia-cóp,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:48.404Z",
      "updatedAt": "2025-09-03T03:00:48.404Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "4c010527-9fd5-4ee7-ae8e-96feda38974a",
      "text": "và tất cả số sót của nhà Ít-ra-en !",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:48.424Z",
      "updatedAt": "2025-09-03T03:00:48.424Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "29e4ee93-c07f-4009-b956-336a6483a2de",
      "text": "Ta đã nâng các ngươi từ trong lòng mẹ,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:48.446Z",
      "updatedAt": "2025-09-03T03:00:48.446Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "99faf1dd-a23d-4735-86b0-6a1ae5907f8a",
      "text": "đã hứng các ngươi từ lúc chưa chào đời.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 3,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:48.469Z",
      "updatedAt": "2025-09-03T03:00:48.469Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "b6ec2308-a276-4d7f-b69d-8bdd04a64e1f",
      "text": "Cho đến khi các ngươi già nua tuổi tác,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:48.494Z",
      "updatedAt": "2025-09-03T03:00:48.494Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "f680fa1d-6bb9-45a8-adad-aac3f6d7cfec",
      "text": "trước sau gì Ta vẫn là Ta ;",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:48.507Z",
      "updatedAt": "2025-09-03T03:00:48.507Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "d8c516be-e584-4528-95bd-0322d9d48012",
      "text": "cho đến khi các ngươi da mồi tóc bạc,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:48.522Z",
      "updatedAt": "2025-09-03T03:00:48.522Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "a5f58204-6b7f-47e7-9a9c-d81acbd3318a",
      "text": "Ta vẫn còn gánh vác các ngươi.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 3,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:48.536Z",
      "updatedAt": "2025-09-03T03:00:48.536Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "e3654b16-5646-479b-9bfb-104ca8d75baa",
      "text": "Như xưa nay Ta vẫn từng đối xử :",
      "label": "4",
      "number": 4,
      "subVerseIndex": 4,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:48.549Z",
      "updatedAt": "2025-09-03T03:00:48.549Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "4f1a6a3e-d8b0-4291-a37e-93fd8a3d7ba2",
      "text": "Ta sẽ nâng niu, gánh vác các ngươi, và ban ơn cứu thoát.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 5,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:48.559Z",
      "updatedAt": "2025-09-03T03:00:48.559Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "435a1605-4b44-4aa8-bdd3-e4f808a503eb",
      "text": "Các ngươi so sánh Ta với ai, đặt Ta đồng hạng với ai nào ?",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:48.570Z",
      "updatedAt": "2025-09-03T03:00:48.570Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "84bd96fb-91ef-4199-b77c-5e8492c6eac5",
      "text": "Đối chiếu Ta với ai, để cả hai bên cùng tương xứng ?",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:48.601Z",
      "updatedAt": "2025-09-03T03:00:48.601Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "74d40f02-da2b-4507-b943-75c4c0428154",
      "text": "Có kẻ mở hầu bao đổ vàng, móc cán cân cân bạc,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:48.612Z",
      "updatedAt": "2025-09-03T03:00:48.612Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "9be7d494-1a73-4b60-85f0-716f2a1e3ab4",
      "text": "mướn thợ bạc làm ra một ông thần,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:48.632Z",
      "updatedAt": "2025-09-03T03:00:48.632Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "d592e694-ee55-4194-8812-d333d9f6e571",
      "text": "rồi sụp lạy, rồi bái thờ nữa.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:48.653Z",
      "updatedAt": "2025-09-03T03:00:48.653Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "e152143a-1ed9-412c-a4b5-df6f9ea637b8",
      "text": "Chính chúng nâng tượng thần lên vai,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:48.663Z",
      "updatedAt": "2025-09-03T03:00:48.663Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "7c9d5e71-9c8a-4cb1-9ca3-1401dc9cff5a",
      "text": "mang nó đi, đặt nó vào vị trí của nó.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:48.674Z",
      "updatedAt": "2025-09-03T03:00:48.674Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "90ad2c7f-6c8b-4e77-bf78-3e0d65fbeac4",
      "text": "Tượng đứng yên, không rời chỗ.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:48.685Z",
      "updatedAt": "2025-09-03T03:00:48.685Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "63ee7ab0-9e8d-4253-b8dd-bec09939bd55",
      "text": "Thế nhưng giả như có ai kêu, nó chẳng đáp lời,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 3,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:48.696Z",
      "updatedAt": "2025-09-03T03:00:48.696Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "825a9c39-1d49-4a20-ad8b-aef9419c614c",
      "text": "cũng chẳng cứu ai khỏi cơn khốn quẫn.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 4,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:48.708Z",
      "updatedAt": "2025-09-03T03:00:48.708Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "ad8d93b9-9112-488b-bf90-7cd995d51554",
      "text": "Những chuyện này, các ngươi hãy nhớ mà sống cho ra người !",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:48.727Z",
      "updatedAt": "2025-09-03T03:00:48.727Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "0b03b0c6-a143-4f73-82ad-1d6135913bb9",
      "text": "Hỡi quân phản trắc, hãy ghi lòng tạc dạ !",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:48.768Z",
      "updatedAt": "2025-09-03T03:00:48.768Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "35eb53da-a027-47ef-b047-b3b3782f1f26",
      "text": "Hãy nhớ lại những chuyện thuở ban đầu,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:48.782Z",
      "updatedAt": "2025-09-03T03:00:48.782Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "90597d4a-7f27-4297-912b-6580dbcf851f",
      "text": "những chuyện thời xa xưa,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:48.796Z",
      "updatedAt": "2025-09-03T03:00:48.796Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "cb03f2a2-9f61-4fd1-baf7-d25eee24a781",
      "text": "nhớ rằng Ta là Thần, không có thần nào khác,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:48.809Z",
      "updatedAt": "2025-09-03T03:00:48.809Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "48f03bb3-d629-4200-9e78-9c5183a780be",
      "text": "Ta là Thiên Chúa, và chẳng có thần nào như Ta.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 3,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:48.823Z",
      "updatedAt": "2025-09-03T03:00:48.823Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "2e3456bc-ceaf-427a-bb41-020c2374bc1c",
      "text": "Những chuyện xảy ra sau, Ta báo trước từ đầu,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:48.838Z",
      "updatedAt": "2025-09-03T03:00:48.838Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "e6ca7e5d-13c2-4ad9-9561-a1a50da7e778",
      "text": "những gì chưa thể hiện, Ta đã báo từ lâu.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:48.865Z",
      "updatedAt": "2025-09-03T03:00:48.865Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "1f6142fa-3edf-4de4-8f8c-c9e99c59b45a",
      "text": "Ta phán : Điều Ta dự tính sẽ thành tựu,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:48.879Z",
      "updatedAt": "2025-09-03T03:00:48.879Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "c705ae33-8df6-47aa-b218-0503b6b1359c",
      "text": "Ta sẽ thi hành điều Ta ưa thích.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 3,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:48.907Z",
      "updatedAt": "2025-09-03T03:00:48.907Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "5529028b-7e3b-4b4b-93c8-e63c80d850d6",
      "text": "Từ phương đông, Ta đã gọi một con chim săn mồi,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:48.921Z",
      "updatedAt": "2025-09-03T03:00:48.921Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "0a1b4abb-aace-4d34-a6f5-4bfb3c68e298",
      "text": "từ miền đất xa xăm,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:48.963Z",
      "updatedAt": "2025-09-03T03:00:48.963Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "8cc7b11f-cff9-485b-ba50-6764e723d76b",
      "text": "Ta đã cho vời người thực thi kế hoạch của Ta.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:48.977Z",
      "updatedAt": "2025-09-03T03:00:48.977Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "dc7723da-1381-4a0a-a4d5-db8a455af44b",
      "text": "Quả thật, Ta đã nói thì sẽ thi hành, đã nghĩ tới thì sẽ thực hiện.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 3,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:48.991Z",
      "updatedAt": "2025-09-03T03:00:48.991Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "8e499ba8-d281-4578-a43a-23da2fbd31cf",
      "text": "Hãy nghe Ta, hỡi kẻ cứng lòng, kẻ xa đường công chính !",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:49.005Z",
      "updatedAt": "2025-09-03T03:00:49.005Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "a915d0f7-d4ec-4207-bc81-708822e8b966",
      "text": "Ngày Ta thể hiện đức công chính của Ta đã đến gần,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:49.018Z",
      "updatedAt": "2025-09-03T03:00:49.018Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "8cfb2a2c-4836-4e78-87c8-74c8f97f1b2a",
      "text": "chẳng còn xa nữa đâu ;",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:49.032Z",
      "updatedAt": "2025-09-03T03:00:49.032Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "431a3c81-a60e-46c3-ad13-d0ddf0c554c6",
      "text": "ơn cứu độ của Ta, Ta sẽ không trì hoãn.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:49.046Z",
      "updatedAt": "2025-09-03T03:00:49.046Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "b1eecbd8-7e7f-4fd6-b068-d9b3d82ef4bb",
      "text": "Ta sẽ ban ơn cứu độ tại Xi-on,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 3,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:49.060Z",
      "updatedAt": "2025-09-03T03:00:49.060Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    },
    {
      "id": "003e28f0-abfc-4952-a0a0-2db8922250de",
      "text": "và sẽ cho Ít-ra-en được vinh quang rạng rỡ.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 4,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:49.087Z",
      "updatedAt": "2025-09-03T03:00:49.087Z",
      "chapterId": "d847ab7d-1743-4172-b989-d5ca50f9d96f"
    }
  ],
