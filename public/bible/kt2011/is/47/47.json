{
  "chapter": {
    "id": "aecd49ab-6877-4193-8db0-c6d59ad7a368",
    "number": 47,
    "createdAt": "2025-09-03T01:07:51.737Z",
    "updatedAt": "2025-09-03T01:07:51.737Z",
    "bookId": "d17ae149-2718-48e5-b452-c522381bf71a"
  },
  "verses": [
    {
      "id": "db787061-d4f4-4ee0-a960-c3d4d96b1823",
      "text": "Hỡi trinh nữ, con gái Ba-by-lon, xuống đi, ngồi trên cát bụi ;",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.035Z",
      "updatedAt": "2025-09-03T03:00:55.035Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "a00ea283-45de-4b19-abd0-e7f3dfb5bc59",
      "text": "hỡi con gái Can-đê, ngồi phệt xuống đất, không ngai không bệ,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.139Z",
      "updatedAt": "2025-09-03T03:00:55.139Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "732821b0-5db9-4bcb-8246-62d390031c9c",
      "text": "vì người ta sẽ không bao giờ gọi ngươi",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.167Z",
      "updatedAt": "2025-09-03T03:00:55.167Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "7b8bdccf-0915-4c5a-b020-ea335ddb8427",
      "text": "là cô gái yêu kiều đài các nữa.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 3,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.180Z",
      "updatedAt": "2025-09-03T03:00:55.180Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "fb69bc60-e8c6-4b44-96a6-2de1a261f183",
      "text": "Hãy lấy cối xay bột, phơi trần bím tóc,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.194Z",
      "updatedAt": "2025-09-03T03:00:55.194Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "7fa12eb7-b189-4a8c-a079-f4ac3200038d",
      "text": "vén vạt áo dài, phơi đùi lội qua sông,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.208Z",
      "updatedAt": "2025-09-03T03:00:55.208Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "b8ab7754-3fe8-455e-80e9-afb5b23486c9",
      "text": "để chỗ kín ngươi bị lột trần, cho nỗi nhục ngươi bị lộ ra !",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.221Z",
      "updatedAt": "2025-09-03T03:00:55.221Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "d40af142-6265-4b46-af4d-d861e954d363",
      "text": "Ta sẽ phục thù, không ai ngăn cản được.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.247Z",
      "updatedAt": "2025-09-03T03:00:55.247Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "246bdc77-8db6-43f4-875c-aca281fd17c4",
      "text": "Đấng cứu chuộc chúng ta,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.271Z",
      "updatedAt": "2025-09-03T03:00:55.271Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "10ceb870-4dde-4f46-9897-80367b7610d8",
      "text": "Đấng mang danh hiệu là ĐỨC CHÚA các đạo binh,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.301Z",
      "updatedAt": "2025-09-03T03:00:55.301Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "af7ed4a8-80f8-4fdd-bbfd-4ad624a1bf9f",
      "text": "là Đức Thánh của Ít-ra-en, Người phán thế này :",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.326Z",
      "updatedAt": "2025-09-03T03:00:55.326Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "1489cd11-d7fc-4ee8-949b-30fb80b3f520",
      "text": "Hỡi con gái Can-đê, hãy ngồi lặng lẽ, lùi vào bóng tối,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.365Z",
      "updatedAt": "2025-09-03T03:00:55.365Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "d26800ff-a1a6-425f-bcfc-8b2354ef4f20",
      "text": "vì thiên hạ sẽ không bao giờ gọi ngươi",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.386Z",
      "updatedAt": "2025-09-03T03:00:55.386Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "19c15266-c1b7-4a1d-af13-f7b25cb59122",
      "text": "là nữ hoàng muôn nước nữa.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.396Z",
      "updatedAt": "2025-09-03T03:00:55.396Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "d7c5d29c-842b-4157-966e-bd1449724de0",
      "text": "Ta đã nổi cơn thịnh nộ với dân Ta,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.407Z",
      "updatedAt": "2025-09-03T03:00:55.407Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "98753b7d-16aa-47e8-aadc-9e3974c6a010",
      "text": "đã hạ nhục cơ nghiệp của Ta, trao nó vào tay ngươi.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.428Z",
      "updatedAt": "2025-09-03T03:00:55.428Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "963d0a40-9004-49b6-8414-8208d83ba8d0",
      "text": "Nhưng ngươi chẳng hề đem lòng thương xót chúng ;",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.438Z",
      "updatedAt": "2025-09-03T03:00:55.438Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "8c2572d9-c44d-43d1-8649-648dc36bd5af",
      "text": "cả trên người già nua, ngươi đã đặt một cái ách thật nặng.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 3,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.449Z",
      "updatedAt": "2025-09-03T03:00:55.449Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "0b406282-4175-46a5-baf9-05bd32d78fcf",
      "text": "Ngươi đã nói : “Mãi mãi ta sẽ là nữ hoàng.”",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.459Z",
      "updatedAt": "2025-09-03T03:00:55.459Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "200d3b6d-9591-4b6c-a140-fe9d17bb4924",
      "text": "Những điều ấy, có bao giờ ngươi để lòng nghiền ngẫm,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.470Z",
      "updatedAt": "2025-09-03T03:00:55.470Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "0b8ff341-c8d7-445e-bedd-6974a7906c0b",
      "text": "suy nghĩ xem kết cục sẽ ra sao !",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.492Z",
      "updatedAt": "2025-09-03T03:00:55.492Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "e486b118-8fe2-406a-8ce2-9fa63c922f7a",
      "text": "Hỡi kẻ ham lạc thú,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.503Z",
      "updatedAt": "2025-09-03T03:00:55.503Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "65786f71-94d5-4209-b107-df5af739c928",
      "text": "ngươi ngồi trên ngai, bình chân như vại và tự nhủ :",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.514Z",
      "updatedAt": "2025-09-03T03:00:55.514Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "9dc1b19d-c20e-405e-b132-752d56ec6cab",
      "text": "“Chỉ có ta, đâu còn ai khác !",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.541Z",
      "updatedAt": "2025-09-03T03:00:55.541Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "68689ba0-5b20-4e22-8198-a8c3392d02e5",
      "text": "Ta sẽ chẳng bao giờ mang thân goá bụa,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 3,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.565Z",
      "updatedAt": "2025-09-03T03:00:55.565Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "ad1e9ded-8476-499d-9960-4857498bf13e",
      "text": "không bao giờ là người mẹ mất con.”",
      "label": "8",
      "number": 8,
      "subVerseIndex": 4,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.576Z",
      "updatedAt": "2025-09-03T03:00:55.576Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "d91e6c7b-a7d2-42b9-86a7-864539d93f30",
      "text": "Giờ đây, hãy nghe điều này :",
      "label": "8",
      "number": 8,
      "subVerseIndex": 5,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.586Z",
      "updatedAt": "2025-09-03T03:00:55.586Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "29f0bc04-0032-4dd7-9bd1-011c1536a918",
      "text": "Thình lình cả hai tai hoạ đó,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.597Z",
      "updatedAt": "2025-09-03T03:00:55.597Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "847a9782-421d-46d6-a06d-c7d9c032ec76",
      "text": "trong một ngày, sẽ ập xuống trên ngươi :",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.608Z",
      "updatedAt": "2025-09-03T03:00:55.608Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "c98ee87e-c03e-4a70-8bb4-6def405f7325",
      "text": "vừa mất con lại vừa goá bụa.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.619Z",
      "updatedAt": "2025-09-03T03:00:55.619Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "2b9bfaed-21dd-40cb-b59d-49b318990f21",
      "text": "Chưa hết tai hoạ này đã đến tai hoạ khác,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 3,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.630Z",
      "updatedAt": "2025-09-03T03:00:55.630Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "4f267ef3-0e8c-46a6-8337-2d2cddade8fe",
      "text": "chúng ập xuống trên ngươi,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 4,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.643Z",
      "updatedAt": "2025-09-03T03:00:55.643Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "5dbdd0fd-ba6c-4fa0-bc08-38708c45e605",
      "text": "dù ngươi cao tay phù chú và lắm trò ma thuật.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 5,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.657Z",
      "updatedAt": "2025-09-03T03:00:55.657Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "8d792ef0-d12d-4b1a-808f-69b4f4af6d05",
      "text": "Ngươi cậy vào lòng độc dữ của ngươi mà nói :",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.671Z",
      "updatedAt": "2025-09-03T03:00:55.671Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "88a1f593-1a1d-4165-aaba-f0be6fbb58f5",
      "text": "“Chẳng ai thấy ta đâu.”",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.685Z",
      "updatedAt": "2025-09-03T03:00:55.685Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "b5e27d95-b323-4a98-9ddc-e50b1c121644",
      "text": "Chính cái khôn cái giỏi của ngươi đã mê hoặc ngươi rồi,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.699Z",
      "updatedAt": "2025-09-03T03:00:55.699Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "700b2b9e-8b36-4859-a10b-428b91c8ccc7",
      "text": "và ngươi lại tự nhủ : “Chỉ có ta, đâu còn ai khác.”",
      "label": "10",
      "number": 10,
      "subVerseIndex": 3,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.711Z",
      "updatedAt": "2025-09-03T03:00:55.711Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "c0d206f6-4ea4-4443-986f-0b81ed348107",
      "text": "Điều dữ sẽ ập xuống trên ngươi",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.723Z",
      "updatedAt": "2025-09-03T03:00:55.723Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "05fea137-26b1-46b6-a8f8-eb544cede784",
      "text": "mà ngươi không làm sao đề phòng ;",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.749Z",
      "updatedAt": "2025-09-03T03:00:55.749Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "ab0fc101-19b7-4ffb-b4a4-edbbc1bedb85",
      "text": "hoạn nạn sẽ giáng xuống trên ngươi",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.763Z",
      "updatedAt": "2025-09-03T03:00:55.763Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "d2ce83fc-16c4-48bb-984d-d957e8a0cbf5",
      "text": "mà ngươi không tài nào ngăn cản ;",
      "label": "11",
      "number": 11,
      "subVerseIndex": 3,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.776Z",
      "updatedAt": "2025-09-03T03:00:55.776Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "c8e3a8ad-86fe-4f1d-8125-67934a4870bc",
      "text": "tai ương sẽ thình lình ập xuống trên ngươi",
      "label": "11",
      "number": 11,
      "subVerseIndex": 4,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.790Z",
      "updatedAt": "2025-09-03T03:00:55.790Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "6b746e9e-ce1a-46e3-860a-8dcb99b5c390",
      "text": "mà ngươi đã không hề lường trước.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 5,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.804Z",
      "updatedAt": "2025-09-03T03:00:55.804Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "d70da953-a218-4621-a55d-795ab1e0a486",
      "text": "Có giỏi thì đứng vững đi,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.818Z",
      "updatedAt": "2025-09-03T03:00:55.818Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "4831c8d7-8af5-431e-b54d-785586cde3a6",
      "text": "cứ tiếp tục những phù phép và những trò ma thuật vô số kể",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.832Z",
      "updatedAt": "2025-09-03T03:00:55.832Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "348bba2d-a7df-4021-981d-707ce143dc94",
      "text": "mà ngươi đã tốn công luyện tập từ thời niên thiếu :",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.860Z",
      "updatedAt": "2025-09-03T03:00:55.860Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "4775bf83-08e4-4a09-b37e-2d228b48885f",
      "text": "biết đâu ngươi lại không thể giúp ích cho chính mình,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 3,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.874Z",
      "updatedAt": "2025-09-03T03:00:55.874Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "4e2cd0bf-5a20-4f3c-8f61-c8e0257bc41e",
      "text": "biết đâu ngươi lại chẳng làm cho người ta khiếp sợ ?",
      "label": "12",
      "number": 12,
      "subVerseIndex": 4,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.887Z",
      "updatedAt": "2025-09-03T03:00:55.887Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "d6c51119-9e53-433e-b15b-b99e6dbd3e21",
      "text": "Ngươi đã kiệt quệ vì trăm mưu nghìn kế.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.901Z",
      "updatedAt": "2025-09-03T03:00:55.901Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "7134e6f8-55df-4887-a4b3-dadc246e4d7b",
      "text": "Đâu cả rồi, mấy ông xem số tử vi, mấy thầy chiêm tinh,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.916Z",
      "updatedAt": "2025-09-03T03:00:55.916Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "12a0ea5d-a027-4fb4-8a26-782603de2fcd",
      "text": "mấy kẻ cứ đến kỳ tân nguyệt",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.930Z",
      "updatedAt": "2025-09-03T03:00:55.930Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "b3c68fa9-7469-42c5-ac95-cb95ce3557c6",
      "text": "lại báo cho ngươi rõ những gì sẽ xảy đến ?",
      "label": "13",
      "number": 13,
      "subVerseIndex": 3,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.944Z",
      "updatedAt": "2025-09-03T03:00:55.944Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "1db9c84b-b4ca-4818-8090-859fb0b808a3",
      "text": "Tất cả hãy đứng lên nào, hãy cứu chữa ngươi đi !",
      "label": "13",
      "number": 13,
      "subVerseIndex": 4,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.957Z",
      "updatedAt": "2025-09-03T03:00:55.957Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "dd6f49a2-b817-41c4-8b08-0bfbeb90ff74",
      "text": "Này chúng sẽ như cọng rơm bị lửa đốt cháy,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.972Z",
      "updatedAt": "2025-09-03T03:00:55.972Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "697c9bb1-4ae1-49a2-8a1c-b7c115c672b5",
      "text": "không sao cứu mạng khỏi hoả hào.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:55.986Z",
      "updatedAt": "2025-09-03T03:00:55.986Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "0cd78fa1-b34e-4454-9e4b-793631f5686b",
      "text": "Đó không phải là than hồng để sưởi ấm,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 2,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:56.001Z",
      "updatedAt": "2025-09-03T03:00:56.001Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "9c2212c2-4769-4582-b1bd-44fd9d856c25",
      "text": "cũng chẳng là ánh lửa để ngồi bên.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 3,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:56.018Z",
      "updatedAt": "2025-09-03T03:00:56.018Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "0ea6d7c5-14b7-442b-b732-df17fda4eb6a",
      "text": "Đối với ngươi, chúng là thế đó,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:56.035Z",
      "updatedAt": "2025-09-03T03:00:56.035Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "b974cdc3-62f5-4761-9294-c8b7d7404275",
      "text": "những kẻ đã làm ngươi hao sức tốn công,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:56.048Z",
      "updatedAt": "2025-09-03T03:00:56.048Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "6512ce1d-ec75-4a97-8563-3f2b252ed47f",
      "text": "những kẻ nuốt tiền của ngươi từ khi ngươi còn niên thiếu ;",
      "label": "15",
      "number": 15,
      "subVerseIndex": 2,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:56.062Z",
      "updatedAt": "2025-09-03T03:00:56.062Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "ba1bc6a1-86e1-4f20-92cf-6759ffef1cb8",
      "text": "chúng sẽ lang thang mỗi người một ngả,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 3,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:56.089Z",
      "updatedAt": "2025-09-03T03:00:56.089Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    },
    {
      "id": "a1b9e044-b8a2-4a7d-9feb-c548eb4c8f89",
      "text": "chẳng có ai cứu được ngươi đâu.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 4,
      "paragraphNumber": 61,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:00:56.103Z",
      "updatedAt": "2025-09-03T03:00:56.103Z",
      "chapterId": "aecd49ab-6877-4193-8db0-c6d59ad7a368"
    }
  ],
