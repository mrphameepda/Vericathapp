{
  "chapter": {
    "id": "7e129480-73d0-43ea-98cc-94a0fb83d6e2",
    "number": 50,
    "createdAt": "2025-09-03T01:07:51.737Z",
    "updatedAt": "2025-09-03T01:07:51.737Z",
    "bookId": "d17ae149-2718-48e5-b452-c522381bf71a"
  },
  "verses": [
    {
      "id": "47986524-8f92-46b0-945d-dfec44a6f085",
      "text": "ĐỨC CHÚA phán thế này :",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:20.682Z",
      "updatedAt": "2025-09-03T03:01:20.682Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "f1e5edf2-164d-4d59-a418-9b1356f7f83a",
      "text": "Đâu là tờ ly hôn mà Ta đã viết để rẫy mẹ các ngươi,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:20.738Z",
      "updatedAt": "2025-09-03T03:01:20.738Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "bc342246-2dd2-464e-ad32-7dcd82500c34",
      "text": "hoặc trong số chủ nợ của Ta,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:20.766Z",
      "updatedAt": "2025-09-03T03:01:20.766Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "512da689-fdac-441f-b52d-b61145e3d2ec",
      "text": "Ta đã bán đứt các ngươi cho ai nào ?",
      "label": "1",
      "number": 1,
      "subVerseIndex": 3,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:20.780Z",
      "updatedAt": "2025-09-03T03:01:20.780Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "9ba7605e-618e-47bb-aa9b-9e2d0ce912ea",
      "text": "Này đây : chính vì lầm lỗi của các ngươi",
      "label": "1",
      "number": 1,
      "subVerseIndex": 4,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:20.808Z",
      "updatedAt": "2025-09-03T03:01:20.808Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "fcb55624-7886-4b0d-b495-51cdcacdb5f2",
      "text": "mà các ngươi đã bị đem đi bán,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 5,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:20.822Z",
      "updatedAt": "2025-09-03T03:01:20.822Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "49929220-b13f-41af-a098-6b3febef79c7",
      "text": "chính bởi tội lỗi của các ngươi mà mẹ các ngươi đã bị rẫy.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 6,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:20.850Z",
      "updatedAt": "2025-09-03T03:01:20.850Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "fabbb592-f4dc-4597-b651-27b6860628ef",
      "text": "Tại sao khi Ta đến, không có một người nào,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:20.864Z",
      "updatedAt": "2025-09-03T03:01:20.864Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "794caadb-7c6e-4eb6-946d-bec421c537eb",
      "text": "khi Ta kêu, chẳng có ai đáp lại ?",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:20.892Z",
      "updatedAt": "2025-09-03T03:01:20.892Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "892aea02-993b-496c-9e31-6f3e6cd6b723",
      "text": "Chẳng lẽ tay Ta quá ngắn, không chuộc nổi ?",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:20.922Z",
      "updatedAt": "2025-09-03T03:01:20.922Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "c615564d-b8f8-4f18-b25b-6de3f5883095",
      "text": "Hoặc Ta không đủ sức để cứu thoát chăng ?",
      "label": "2",
      "number": 2,
      "subVerseIndex": 3,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:20.953Z",
      "updatedAt": "2025-09-03T03:01:20.953Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "84f93d05-db8e-4d64-8e38-d2cccbe04056",
      "text": "Xem đây : Ta chỉ đe một tiếng là biển cạn khô,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 4,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:20.965Z",
      "updatedAt": "2025-09-03T03:01:20.965Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "764c92f6-4d17-4dc8-bbd9-eb4d339c52aa",
      "text": "sông ngòi thành hoang địa,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 5,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:20.993Z",
      "updatedAt": "2025-09-03T03:01:20.993Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "f4d0de2c-8e82-4ab5-9bc4-19b4a7518765",
      "text": "cá mắc cạn nặng mùi và chết khát.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 6,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:21.005Z",
      "updatedAt": "2025-09-03T03:01:21.005Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "cf3ea284-d2fa-4340-8c58-73bc33c926ec",
      "text": "Ta khoác lên bầu trời một màu đen ảm đạm",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:21.017Z",
      "updatedAt": "2025-09-03T03:01:21.017Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "0cf67aac-ea68-4059-a2b2-283159c4fbe5",
      "text": "và phủ lên đó tấm vải thô.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:21.037Z",
      "updatedAt": "2025-09-03T03:01:21.037Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "3152bb84-140a-4ee9-beb6-1c8f8225a874",
      "text": "ĐỨC CHÚA là Chúa Thượng",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:21.058Z",
      "updatedAt": "2025-09-03T03:01:21.058Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "9014c63b-392a-44fd-8c8c-b582ddf13ff0",
      "text": "đã cho tôi nói năng như một người môn đệ,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:21.109Z",
      "updatedAt": "2025-09-03T03:01:21.109Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "616ec852-5239-4c0f-9dbc-77e59e2c3532",
      "text": "để tôi biết lựa lời nâng đỡ ai rã rời kiệt sức.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:21.130Z",
      "updatedAt": "2025-09-03T03:01:21.130Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "42ddfec8-acc9-4d4f-8a41-7ae28de55d65",
      "text": "Sáng sáng, Người đánh thức, Người đánh thức tôi,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 3,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:21.140Z",
      "updatedAt": "2025-09-03T03:01:21.140Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "bcfa9fc5-68f9-4b5c-b12f-98f1fe74b743",
      "text": "để tôi lắng tai nghe như một người môn đệ.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 4,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:21.151Z",
      "updatedAt": "2025-09-03T03:01:21.151Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "11abdc4e-1dae-405d-b379-b3a84c4c4a0f",
      "text": "ĐỨC CHÚA là Chúa Thượng đã mở tai tôi,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:21.162Z",
      "updatedAt": "2025-09-03T03:01:21.162Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "471a98d7-7909-4fa9-b15d-6e43868276ce",
      "text": "còn tôi, tôi không cưỡng lại, cũng chẳng tháo lui.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:21.186Z",
      "updatedAt": "2025-09-03T03:01:21.186Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "6a7ce84e-6b20-4371-84ec-93e83b574985",
      "text": "Tôi đã đưa lưng cho người ta đánh đòn,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:21.214Z",
      "updatedAt": "2025-09-03T03:01:21.214Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "d17ebfb6-d053-4718-b7a4-caa7e2d03c57",
      "text": "giơ má cho người ta giật râu.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:21.228Z",
      "updatedAt": "2025-09-03T03:01:21.228Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "88114da7-b40d-47f1-ac86-4be94ee1307d",
      "text": "Tôi đã không che mặt khi bị mắng nhiếc phỉ nhổ.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:21.241Z",
      "updatedAt": "2025-09-03T03:01:21.241Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "8cf1053c-6caf-45e5-bceb-c2853475b1fe",
      "text": "Có ĐỨC CHÚA là Chúa Thượng phù trợ tôi,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:21.279Z",
      "updatedAt": "2025-09-03T03:01:21.279Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "68cc84c3-5fec-4c74-96f6-f23d038e6a73",
      "text": "vì thế, tôi đã không hổ thẹn,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:21.307Z",
      "updatedAt": "2025-09-03T03:01:21.307Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "b79fbf70-ee7e-484e-9934-d4706afe8ed4",
      "text": "vì thế, tôi trơ mặt ra như đá.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:21.320Z",
      "updatedAt": "2025-09-03T03:01:21.320Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "ef87cb2a-fd51-4699-9be1-3c0af62b9596",
      "text": "Tôi biết mình sẽ không phải thẹn thùng.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 3,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:21.348Z",
      "updatedAt": "2025-09-03T03:01:21.348Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "b5e222a5-d4c8-4d7f-aee7-2d9870aaf9c3",
      "text": "Đấng tuyên bố rằng tôi công chính, Người ở kề bên.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:21.376Z",
      "updatedAt": "2025-09-03T03:01:21.376Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "40c95727-f2c1-476b-9015-ec502657aaf6",
      "text": "Ai tranh tụng với tôi ? Cùng nhau ta hầu toà !",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:21.403Z",
      "updatedAt": "2025-09-03T03:01:21.403Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "ee74fd15-21dd-4b8c-a4b4-59783367b939",
      "text": "Ai muốn kiện cáo tôi ? Cứ thử đến đây coi !",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:21.415Z",
      "updatedAt": "2025-09-03T03:01:21.415Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "76c326e0-bfb3-48d3-93a2-224c3dd4f7f9",
      "text": "Này, có ĐỨC CHÚA là Chúa Thượng phù trợ tôi,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:21.428Z",
      "updatedAt": "2025-09-03T03:01:21.428Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "1e79da6f-07c2-4d1e-9032-b4b96fdd66aa",
      "text": "ai còn dám kết tội ?",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:21.452Z",
      "updatedAt": "2025-09-03T03:01:21.452Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "8cd19ecb-2c46-40c0-b3b7-bc9045c2e12a",
      "text": "Này, tất cả chúng sẽ mục đi như chiếc áo, và sẽ bị mối ăn.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:21.465Z",
      "updatedAt": "2025-09-03T03:01:21.465Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "edfe9d48-ef70-4cfb-81da-98026a4ee446",
      "text": "Ai trong các ngươi kính sợ ĐỨC CHÚA,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:21.502Z",
      "updatedAt": "2025-09-03T03:01:21.502Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "59f64d6d-9c81-474f-940e-e53521e06f20",
      "text": "nghe theo tiếng tôi tớ của Người,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:21.527Z",
      "updatedAt": "2025-09-03T03:01:21.527Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "d379ff43-325b-4221-8ad3-4c84d60cadc4",
      "text": "ai đi trong bóng tối, không một tia sáng nào chiếu rọi,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:21.551Z",
      "updatedAt": "2025-09-03T03:01:21.551Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "2d5cf9ac-dd7c-4945-8702-975facfcdf00",
      "text": "hãy tin tưởng vào danh ĐỨC CHÚA",
      "label": "10",
      "number": 10,
      "subVerseIndex": 3,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:21.579Z",
      "updatedAt": "2025-09-03T03:01:21.579Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "2e932358-29b2-4d7d-aa50-242056b8a092",
      "text": "và tìm nương tựa nơi Thiên Chúa mình thờ.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 4,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:21.604Z",
      "updatedAt": "2025-09-03T03:01:21.604Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "65a0d03b-b1ca-4481-994a-2038077a96b9",
      "text": "Phần tất cả các ngươi, những ai đã phóng hoả,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:21.626Z",
      "updatedAt": "2025-09-03T03:01:21.626Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "5177ca06-ef2f-404f-b139-9f95e448d7e4",
      "text": "dùng mũi tên lửa làm vũ khí, hãy đâm đầu vào đống lửa",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:21.640Z",
      "updatedAt": "2025-09-03T03:01:21.640Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "80fca286-2ad5-475d-9db7-ef57a54ad13d",
      "text": "chính các ngươi đã đốt lên, vào làn tên các ngươi đã châm lửa.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:21.667Z",
      "updatedAt": "2025-09-03T03:01:21.667Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "baae5018-7356-4b4a-b2b9-b91832779a68",
      "text": "Những gì các ngươi đang phải chịu đều là do chính tay Ta :",
      "label": "11",
      "number": 11,
      "subVerseIndex": 3,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:21.681Z",
      "updatedAt": "2025-09-03T03:01:21.681Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    },
    {
      "id": "72ab61c3-fd56-41b5-b596-d8868869131a",
      "text": "các ngươi sẽ nằm xuống trong đớn đau cùng cực.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 4,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:21.708Z",
      "updatedAt": "2025-09-03T03:01:21.708Z",
      "chapterId": "7e129480-73d0-43ea-98cc-94a0fb83d6e2"
    }
  ],
