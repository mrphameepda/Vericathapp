{
  "chapter": {
    "id": "f2c86c11-af8b-46c1-840d-73045071a5e3",
    "number": 53,
    "createdAt": "2025-09-03T01:07:51.737Z",
    "updatedAt": "2025-09-03T01:07:51.737Z",
    "bookId": "d17ae149-2718-48e5-b452-c522381bf71a"
  },
  "verses": [
    {
      "id": "d02b99e1-aa1c-4a0a-bb00-c0adc2b416af",
      "text": "",
      "label": "0",
      "number": 0,
      "subVerseIndex": 1,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T03:01:42.661Z",
      "updatedAt": "2025-09-03T03:01:42.661Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "368cadae-f3c6-46e4-b3e5-f8a2610c13a2",
      "text": "Điều chúng ta đã nghe,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 1,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:42.689Z",
      "updatedAt": "2025-09-03T03:01:42.689Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "e0115e1f-6a7d-442c-b744-e1870064142d",
      "text": "ai mà tin được ?",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:42.700Z",
      "updatedAt": "2025-09-03T03:01:42.700Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "e58959f6-624a-41d4-b065-1098c2b4c9a2",
      "text": "Cánh tay uy quyền của ĐỨC CHÚA đã được tỏ cho ai ?",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:42.723Z",
      "updatedAt": "2025-09-03T03:01:42.723Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "94079b84-9868-412e-915e-143bf174f585",
      "text": "Người tôi tớ đã lớn lên tựa chồi cây trước Nhan Thánh,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:42.749Z",
      "updatedAt": "2025-09-03T03:01:42.749Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "552c37d4-845d-43c4-8020-8aeb56b7d236",
      "text": "như khúc rễ trên đất khô cằn.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:42.763Z",
      "updatedAt": "2025-09-03T03:01:42.763Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "2efd987d-57cb-4836-a0e1-8b03c21be9aa",
      "text": "Người chẳng còn dáng vẻ,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:42.792Z",
      "updatedAt": "2025-09-03T03:01:42.792Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "c9f1e994-1141-4cdd-9dfc-a9599479f709",
      "text": "chẳng còn oai phong",
      "label": "2",
      "number": 2,
      "subVerseIndex": 3,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:42.806Z",
      "updatedAt": "2025-09-03T03:01:42.806Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "6bc29c46-f068-4aa1-b527-2cb2f58e8c5a",
      "text": "đáng chúng ta ngắm nhìn,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 4,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:42.819Z",
      "updatedAt": "2025-09-03T03:01:42.819Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "c5f4f85b-2a66-40f6-a74f-64ff0283518f",
      "text": "dung mạo chẳng còn gì",
      "label": "2",
      "number": 2,
      "subVerseIndex": 5,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:42.840Z",
      "updatedAt": "2025-09-03T03:01:42.840Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "4d920306-a91d-4614-a2b9-66b893646eb8",
      "text": "khiến chúng ta ưa thích.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 6,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:42.854Z",
      "updatedAt": "2025-09-03T03:01:42.854Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "91ac3dd8-c259-4cd9-bd51-b131a4eb4483",
      "text": "Người bị đời khinh khi ruồng rẫy,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:42.868Z",
      "updatedAt": "2025-09-03T03:01:42.868Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "b8ec8e7b-c3ff-460b-bea1-dff5e3fc6f78",
      "text": "phải đau khổ triền miên",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:42.896Z",
      "updatedAt": "2025-09-03T03:01:42.896Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "232865dd-d10d-45d7-91d6-26d8dfb5c934",
      "text": "và nếm mùi bệnh tật.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:42.910Z",
      "updatedAt": "2025-09-03T03:01:42.910Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "8e2b4022-52b2-49dd-862a-96139bf987e2",
      "text": "Người như kẻ ai thấy cũng che mặt không nhìn,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 3,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:42.924Z",
      "updatedAt": "2025-09-03T03:01:42.924Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "ddae934b-f775-4a42-9788-c66bf100195c",
      "text": "bị chúng ta khinh khi,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 4,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:42.938Z",
      "updatedAt": "2025-09-03T03:01:42.938Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "5e798d9b-e4ae-433e-8325-b124e9e0c095",
      "text": "không đếm xỉa tới.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 5,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:42.952Z",
      "updatedAt": "2025-09-03T03:01:42.952Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "5be51b6a-3b15-453a-812d-a92824199c5c",
      "text": "Sự thật, chính người đã mang lấy những bệnh tật của chúng ta,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:42.966Z",
      "updatedAt": "2025-09-03T03:01:42.966Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "37e0aeae-f8d5-4c37-a554-a6aec6c7dc6f",
      "text": "đã gánh chịu những đau khổ của chúng ta,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:42.994Z",
      "updatedAt": "2025-09-03T03:01:42.994Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "49b37626-f4d1-452d-8f74-dba4e70f9f54",
      "text": "còn chúng ta, chúng ta lại tưởng người bị phạt,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:43.008Z",
      "updatedAt": "2025-09-03T03:01:43.008Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "ff9a6bb1-92da-49c9-a66a-1915a65a6043",
      "text": "bị Thiên Chúa giáng hoạ, phải nhục nhã ê chề.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 3,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:43.022Z",
      "updatedAt": "2025-09-03T03:01:43.022Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "3d26823b-6e31-4c16-be3d-1a6afbef306e",
      "text": "Chính người đã bị đâm",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:43.049Z",
      "updatedAt": "2025-09-03T03:01:43.049Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "a4a08956-5720-4e3b-90b4-667b2e26eac0",
      "text": "vì chúng ta phạm tội,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:43.064Z",
      "updatedAt": "2025-09-03T03:01:43.064Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "85753e7c-9da4-4515-89c7-6df05389b6d6",
      "text": "bị nghiền nát",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:43.091Z",
      "updatedAt": "2025-09-03T03:01:43.091Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "1c7df7e1-5cf3-4716-a1b4-079b9eb414e7",
      "text": "vì chúng ta lỗi lầm ;",
      "label": "5",
      "number": 5,
      "subVerseIndex": 3,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:43.105Z",
      "updatedAt": "2025-09-03T03:01:43.105Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "a37273a3-c348-49f3-9fd3-27131ac4afb8",
      "text": "người đã chịu sửa trị",
      "label": "5",
      "number": 5,
      "subVerseIndex": 4,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:43.119Z",
      "updatedAt": "2025-09-03T03:01:43.119Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "11699576-c5b0-4960-89ec-51e71cba384d",
      "text": "để chúng ta được bình an,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 5,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:43.133Z",
      "updatedAt": "2025-09-03T03:01:43.133Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "b47d481f-a379-4ce6-9bfc-383dfc2feca5",
      "text": "đã phải mang thương tích",
      "label": "5",
      "number": 5,
      "subVerseIndex": 6,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:43.147Z",
      "updatedAt": "2025-09-03T03:01:43.147Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "f9f02e98-75ad-4cfb-9525-bf2a197f1d7b",
      "text": "cho chúng ta được chữa lành.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 7,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:43.175Z",
      "updatedAt": "2025-09-03T03:01:43.175Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "cbacb100-fe41-47c9-bb0b-b63921d77643",
      "text": "Tất cả chúng ta lạc lõng như chiên cừu,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:43.189Z",
      "updatedAt": "2025-09-03T03:01:43.189Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "d4dd24bb-f396-40de-9458-a84a19eb85b3",
      "text": "lang thang mỗi người một ngả.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:43.217Z",
      "updatedAt": "2025-09-03T03:01:43.217Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "f0ee2db8-0e75-4589-9a80-4700c42b9613",
      "text": "Nhưng ĐỨC CHÚA đã đổ trên đầu người",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:43.234Z",
      "updatedAt": "2025-09-03T03:01:43.234Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "0ae33ab8-3413-4a7b-8d8f-9e779e8a0309",
      "text": "tội lỗi của tất cả chúng ta.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 3,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:43.275Z",
      "updatedAt": "2025-09-03T03:01:43.275Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "58d2217a-2bb9-40b7-add7-ebba5cbdf091",
      "text": "Bị ngược đãi,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:43.289Z",
      "updatedAt": "2025-09-03T03:01:43.289Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "16f4aaf0-e002-471d-b57f-22757c2972c5",
      "text": "người cam chịu nhục,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:43.314Z",
      "updatedAt": "2025-09-03T03:01:43.314Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "112eb4fb-febc-49e1-a534-047f23dd3430",
      "text": "chẳng mở miệng kêu ca ;",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:43.333Z",
      "updatedAt": "2025-09-03T03:01:43.333Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "aa0cf930-3777-43e0-91b1-37ae128d46ec",
      "text": "như chiên bị đem đi làm thịt, như cừu câm nín khi bị xén lông,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 3,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:43.361Z",
      "updatedAt": "2025-09-03T03:01:43.361Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "7a4ba1eb-fcf1-445f-a73e-134f3c09436c",
      "text": "người chẳng hề mở miệng.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 4,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:43.405Z",
      "updatedAt": "2025-09-03T03:01:43.405Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "e9540ea7-34ad-49bf-9a82-49c496395ecd",
      "text": "Người đã bị ức hiếp, buộc tội,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:43.419Z",
      "updatedAt": "2025-09-03T03:01:43.419Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "85d14185-b1d4-48ca-bdbc-5d2b0f498a47",
      "text": "rồi bị thủ tiêu.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:43.433Z",
      "updatedAt": "2025-09-03T03:01:43.433Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "37c336f5-b762-4952-8325-e2f07dde3d8e",
      "text": "Dòng dõi của người,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:43.447Z",
      "updatedAt": "2025-09-03T03:01:43.447Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "69e8fbf0-8372-4ecc-925b-7d94e2bf6bfa",
      "text": "ai nào nghĩ tới ?",
      "label": "8",
      "number": 8,
      "subVerseIndex": 3,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:43.461Z",
      "updatedAt": "2025-09-03T03:01:43.461Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "47c37bfc-832a-4a81-8467-e88bc2fbd10b",
      "text": "Người đã bị khai trừ khỏi cõi nhân sinh,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 4,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:43.474Z",
      "updatedAt": "2025-09-03T03:01:43.474Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "7f7f74e8-a706-480e-ba26-e29469513a85",
      "text": "vì tội lỗi của dân,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 5,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:43.488Z",
      "updatedAt": "2025-09-03T03:01:43.488Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "67954e2d-afcf-44a1-857a-bff03cae0d7f",
      "text": "người bị đánh phạt.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 6,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:43.517Z",
      "updatedAt": "2025-09-03T03:01:43.517Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "dff8346b-d631-49ff-9e66-54d32565e022",
      "text": "Người đã bị chôn cất giữa bọn ác ôn,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:43.530Z",
      "updatedAt": "2025-09-03T03:01:43.530Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "d05bbf23-b82e-4169-9e56-607ee0137bcf",
      "text": "bị mai táng với người giàu có, dù đã chẳng làm chi tàn bạo,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:43.558Z",
      "updatedAt": "2025-09-03T03:01:43.558Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "44722af3-986c-4ec0-84b3-817499ccc3d4",
      "text": "và miệng không hề nói chuyện điêu ngoa.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:43.600Z",
      "updatedAt": "2025-09-03T03:01:43.600Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "91b33d68-ab21-45c0-8a31-9f1492cb325f",
      "text": "ĐỨC CHÚA đã muốn người phải bị nghiền nát vì đau khổ.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:43.628Z",
      "updatedAt": "2025-09-03T03:01:43.628Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "92a9ca6d-59f4-41c2-819d-0203f59e76d0",
      "text": "Nếu người hiến thân làm lễ vật đền tội,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:43.656Z",
      "updatedAt": "2025-09-03T03:01:43.656Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "89eafe10-fc2e-4953-b21b-743b14b6e4a5",
      "text": "người sẽ được thấy kẻ nối dõi, sẽ được trường tồn,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:43.683Z",
      "updatedAt": "2025-09-03T03:01:43.683Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "c65f247f-da0d-423c-9072-a0ba48b1a115",
      "text": "và nhờ người, ý muốn của ĐỨC CHÚA sẽ thành tựu.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 3,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:43.696Z",
      "updatedAt": "2025-09-03T03:01:43.696Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "92f80ebc-4df3-4b32-8e5a-e4a78b23eb0f",
      "text": "Nhờ nỗi thống khổ của mình,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:43.719Z",
      "updatedAt": "2025-09-03T03:01:43.719Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "dcd40f25-e5d6-4d2c-9a44-417b097a436d",
      "text": "người sẽ nhìn thấy ánh sáng và được mãn nguyện.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:43.751Z",
      "updatedAt": "2025-09-03T03:01:43.751Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "8d12c216-5663-4ae0-bfa0-9f7cc287c272",
      "text": "Vì đã nếm mùi đau khổ, người công chính, tôi trung của Ta,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:43.777Z",
      "updatedAt": "2025-09-03T03:01:43.777Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "e6e23de8-bb79-41ca-9385-ca973fd5c1a2",
      "text": "sẽ làm cho muôn người nên công chính",
      "label": "11",
      "number": 11,
      "subVerseIndex": 3,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:43.805Z",
      "updatedAt": "2025-09-03T03:01:43.805Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "dd1bf3ee-6aaa-43c7-8597-ea9813bccc73",
      "text": "và sẽ gánh lấy tội lỗi của họ.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 4,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:43.834Z",
      "updatedAt": "2025-09-03T03:01:43.834Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "a8576994-6c6c-4cf3-91c9-7bc0b44d2da7",
      "text": "Vì thế, Ta sẽ ban cho người muôn người làm gia sản,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:43.848Z",
      "updatedAt": "2025-09-03T03:01:43.848Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "738e5dcc-0425-4ddb-830a-2d55fa70849e",
      "text": "và cùng với những bậc anh hùng hào kiệt,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:43.891Z",
      "updatedAt": "2025-09-03T03:01:43.891Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "8192acb3-c59a-4de3-a85c-09dbf8489dbf",
      "text": "người sẽ được chia chiến lợi phẩm,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:43.905Z",
      "updatedAt": "2025-09-03T03:01:43.905Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "bcb1b4d1-141c-4e8b-8f6f-7462913482cb",
      "text": "bởi vì người đã hiến thân chịu chết, đã bị liệt vào hàng tội nhân ;",
      "label": "12",
      "number": 12,
      "subVerseIndex": 3,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:43.919Z",
      "updatedAt": "2025-09-03T03:01:43.919Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "934ed851-2291-4c53-a9f4-1d95d246e2e3",
      "text": "nhưng thật ra, người đã mang lấy tội muôn người",
      "label": "12",
      "number": 12,
      "subVerseIndex": 4,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:43.947Z",
      "updatedAt": "2025-09-03T03:01:43.947Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    },
    {
      "id": "4612fd50-29d9-4622-8c71-220a67f50732",
      "text": "và can thiệp cho những kẻ tội lỗi.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 5,
      "paragraphNumber": 61,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:43.974Z",
      "updatedAt": "2025-09-03T03:01:43.974Z",
      "chapterId": "f2c86c11-af8b-46c1-840d-73045071a5e3"
    }
  ],
