      "targetId": "ef92ae09-29b4-4bb0-9f3a-1f943ca4c54a",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "80be2726-abd7-4982-95c0-42aae8b43ce1",
      "content": "Đây không phải là một bài tả chân, nhưng là những nét phác hoạ có tính cách tượng trưng nói lên viễn tượng đầy vinh quang của Giê-ru-sa-lem, mà phần cuối quyển sách (các ch. 60,62,65) cũng như thánh Gio-an tông đồ (Kh 21) sẽ mượn lại để gợi lên vẻ huy hoàng của Giê-ru-sa-lem mới, thuộc một thế giới còn siêu việt hơn nữa.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "15",
      "sortOrder": 14,
      "startOffset": 17,
      "endOffset": 17,
      "createdAt": "2025-09-03T03:01:50.396Z",
      "updatedAt": "2025-09-03T03:01:50.396Z",
      "targetId": "6fb8a926-6fec-4019-a159-18feaa1f2511",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "e52dae22-bd49-4b03-9042-532011ba3ab7",
      "content": "Is 1,26",
      "kind": "MARK_KIND_REFERENCE",
      "label": "15@",
      "sortOrder": 14,
      "startOffset": 38,
      "endOffset": 38,
      "createdAt": "2025-09-03T03:01:50.580Z",
      "updatedAt": "2025-09-03T03:01:50.580Z",
      "targetId": "9aba66a5-d124-4557-b200-8a1fbbc373b2",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "cc42b398-3849-4a1b-9775-4fb048c87a40",
      "content": "Có lẽ chỉ thứ xi-măng đổ chung quanh đá quý để đúc cho chắc, được ví như thứ mỹ phẩm tô quanh đôi mắt đẹp (2 V 9,30).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "16",
      "sortOrder": 15,
      "startOffset": 42,
      "endOffset": 42,
      "createdAt": "2025-09-03T03:01:50.424Z",
      "updatedAt": "2025-09-03T03:01:50.424Z",
      "targetId": "18f9d620-8e05-44ea-aac1-7288d1063ceb",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
