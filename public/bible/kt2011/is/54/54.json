    {
      "id": "2e7886ae-bbbe-4e0c-b147-89c308e345a9",
      "content": "ds : *đừng giữ lại, đừng rút lại* vì tiếc của, tiếc công.",
      "kind": "MARK_KIND_FOOTNOTE",
