    },
    {
      "id": "8b1e9a53-e492-4d28-a643-ec42e2cd0f35",
      "content": "Hiểu theo nghĩa *được các dân tộc làm gia tài* (x. 53,12 và 56,8) chớ không phải theo nghĩa đoạt gia tài của các dân tộc như có nhiều bản hiểu.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "5",
      "sortOrder": 4,
      "startOffset": 37,
      "endOffset": 37,
      "createdAt": "2025-09-03T03:01:49.720Z",
      "updatedAt": "2025-09-03T03:01:49.720Z",
      "targetId": "49a5f7bb-458c-44d9-838e-4b64af2948d0",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "24cd1fd3-2ac5-4af7-80ba-07c4653fb3b1",
      "content": "Hs 2,4+",
      "kind": "MARK_KIND_REFERENCE",
      "label": "5@",
      "sortOrder": 4,
      "startOffset": 25,
      "endOffset": 25,
      "createdAt": "2025-09-03T03:01:49.840Z",
      "updatedAt": "2025-09-03T03:01:49.840Z",
      "targetId": "998e38ea-59f7-4e46-b5a4-0465beeef29d",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "162a602a-efd2-4208-8ca4-207bdb3fc60a",
      "content": "*Nỗi hổ thẹn tuổi thanh xuân* là cảnh nô lệ bên Ai-cập, lúc chưa có giao ước với Thiên Chúa, làm cho Ít-ra-en như con gái ế chồng ; và *bao nhục nhằn thời goá bụa* là cảnh tù đày ở Ba-by-lon, lúc không còn được hiển nhiên sống giao ước với Thiên Chúa nữa, như người vợ mất chồng.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "6",
      "sortOrder": 5,
      "startOffset": 9,
      "endOffset": 9,
      "createdAt": "2025-09-03T03:01:49.798Z",
      "updatedAt": "2025-09-03T03:01:49.798Z",
      "targetId": "c57724bb-0195-4408-87bb-118e3f855226",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "a125e793-51e1-4284-b289-2dd57bc6b018",
      "content": "Is 49,14-15",
      "kind": "MARK_KIND_REFERENCE",
      "label": "6@",
      "sortOrder": 5,
      "startOffset": 0,
      "endOffset": 0,
