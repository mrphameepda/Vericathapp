{
  "chapter": {
    "id": "f30665df-34dd-4740-a7ae-d237487a93d8",
    "number": 54,
    "createdAt": "2025-09-03T01:07:51.737Z",
    "updatedAt": "2025-09-03T01:07:51.737Z",
    "bookId": "d17ae149-2718-48e5-b452-c522381bf71a"
  },
  "verses": [
    {
      "id": "d7b97013-bb70-47b3-902c-4b30c0e2cb2f",
      "text": "Reo mừng lên, hỡi người phụ nữ son sẻ, không sinh con ;",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:49.475Z",
      "updatedAt": "2025-09-03T03:01:49.475Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "beb10ebf-25fc-4dac-aacf-12a760e3f673",
      "text": "hãy bật tiếng reo hò mừng vui, hỡi ai chưa một lần chuyển dạ,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:49.537Z",
      "updatedAt": "2025-09-03T03:01:49.537Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "7fb7f285-ccb4-4e25-94d3-66594ad0f935",
      "text": "vì con của phụ nữ bị bỏ rơi",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:49.549Z",
      "updatedAt": "2025-09-03T03:01:49.549Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "54cc1a14-613e-4036-b588-aff87137afd4",
      "text": "thì đông hơn con của phụ nữ có chồng – ĐỨC CHÚA phán.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 3,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:49.579Z",
      "updatedAt": "2025-09-03T03:01:49.579Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "451615a1-1696-48ad-a7aa-7c3bd0ea6708",
      "text": "Hãy nới rộng lều ngươi đang ở,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:49.608Z",
      "updatedAt": "2025-09-03T03:01:49.608Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "d22e4917-f87c-4692-b6c3-50de0964d021",
      "text": "căng các tấm bạt ra, đừng hẹp lòng hẹp dạ.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:49.635Z",
      "updatedAt": "2025-09-03T03:01:49.635Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "315a90d6-00fc-40bb-b49a-fa9d8b41a707",
      "text": "Nối dây thừng dài thêm, đóng cọc lều cho chắc,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:49.663Z",
      "updatedAt": "2025-09-03T03:01:49.663Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "982266e0-be00-4a57-8f00-e754f9e22109",
      "text": "vì ngươi sẽ tràn ra hai bên tả hữu,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:49.678Z",
      "updatedAt": "2025-09-03T03:01:49.678Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "49a5f7bb-458c-44d9-838e-4b64af2948d0",
      "text": "dòng dõi ngươi sẽ thừa kế các dân tộc,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:49.706Z",
      "updatedAt": "2025-09-03T03:01:49.706Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "a2c2a007-8e0e-4bf5-8ec5-b616cabdd7a9",
      "text": "và đến ở trong các thành bỏ hoang.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:49.734Z",
      "updatedAt": "2025-09-03T03:01:49.734Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "d623ba9a-d1c6-4154-999a-06a2e3358fb7",
      "text": "Đừng sợ chi : ngươi sẽ không phải xấu hổ,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:49.749Z",
      "updatedAt": "2025-09-03T03:01:49.749Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "88735ce2-7a41-4614-9d12-1b36bce70ac2",
      "text": "chớ e thẹn : ngươi sẽ không phải nhục nhằn.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:49.769Z",
      "updatedAt": "2025-09-03T03:01:49.769Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "c57724bb-0195-4408-87bb-118e3f855226",
      "text": "Thật vậy, ngươi sẽ quên hết nỗi hổ thẹn tuổi thanh xuân",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:49.783Z",
      "updatedAt": "2025-09-03T03:01:49.783Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "e229a0ad-9688-4a53-a0f1-42e7942efd11",
      "text": "và không còn nhớ bao nhục nhằn thời goá bụa.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 3,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:49.812Z",
      "updatedAt": "2025-09-03T03:01:49.812Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "998e38ea-59f7-4e46-b5a4-0465beeef29d",
      "text": "Quả thế, Đấng cùng ngươi sánh duyên cầm sắt",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:49.826Z",
      "updatedAt": "2025-09-03T03:01:49.826Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "4f506451-1868-4c40-ada5-b5c4a49b4ccd",
      "text": "chính là Đấng đã tác thành ngươi,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:49.853Z",
      "updatedAt": "2025-09-03T03:01:49.853Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "0c5bd1b2-fc90-46d2-a013-3370c2d86ebe",
      "text": "tôn danh Người là ĐỨC CHÚA các đạo binh ;",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:49.867Z",
      "updatedAt": "2025-09-03T03:01:49.867Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "78697cf4-6548-4fe4-a86e-020ee5d78901",
      "text": "Đấng chuộc ngươi về, chính là Đức Thánh của Ít-ra-en,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 3,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:49.896Z",
      "updatedAt": "2025-09-03T03:01:49.896Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "d2e6cf72-7dfe-4544-a270-87bc8981accc",
      "text": "tước hiệu Người là Thiên Chúa toàn cõi đất.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 4,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:49.932Z",
      "updatedAt": "2025-09-03T03:01:49.932Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "a315697a-c717-4e6d-98e7-ec25a66e90aa",
      "text": "Phải, ĐỨC CHÚA đã gọi ngươi về,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:49.946Z",
      "updatedAt": "2025-09-03T03:01:49.946Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "fa09e064-0524-4d52-baac-b1e726f5ac6d",
      "text": "như người đàn bà bị ruồng bỏ, tâm thần sầu muộn.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:49.974Z",
      "updatedAt": "2025-09-03T03:01:49.974Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "e617034e-c45a-4b41-9134-0247723b4fe1",
      "text": "“Người vợ cưới lúc thanh xuân, ai mà rẫy cho đành ?”,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:50.002Z",
      "updatedAt": "2025-09-03T03:01:50.002Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "cc275768-fea5-4a24-bbac-4b4f8326603a",
      "text": "Thiên Chúa ngươi phán như vậy.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 3,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:50.017Z",
      "updatedAt": "2025-09-03T03:01:50.017Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "c1d47cb8-bab3-4632-9bc6-30eb143aaba9",
      "text": "Trong một thời gian ngắn, Ta đã ruồng bỏ ngươi,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:50.031Z",
      "updatedAt": "2025-09-03T03:01:50.031Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "11cee910-ab3f-4f62-97ff-8935e27219fe",
      "text": "nhưng vì lòng thương xót vô bờ, Ta sẽ đón ngươi về tái hợp.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:50.045Z",
      "updatedAt": "2025-09-03T03:01:50.045Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "9a91a704-ba62-4c1a-9343-21ab560f2062",
      "text": "Lúc lửa giận bừng bừng,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:50.059Z",
      "updatedAt": "2025-09-03T03:01:50.059Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "bc80eb94-d105-48fe-b0d2-7f98cd8def78",
      "text": "Ta đã một thời ngoảnh mặt chẳng nhìn ngươi,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:50.087Z",
      "updatedAt": "2025-09-03T03:01:50.087Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "c50415f7-567c-48b5-b193-e7080715de61",
      "text": "nhưng vì tình nghĩa ngàn đời, Ta lại chạnh lòng thương xót,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:50.101Z",
      "updatedAt": "2025-09-03T03:01:50.101Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "ec9137f6-07d7-4f64-9b12-08c778e222ac",
      "text": "ĐỨC CHÚA, Đấng cứu chuộc ngươi, phán như vậy.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 3,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:50.129Z",
      "updatedAt": "2025-09-03T03:01:50.129Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "e344d969-08cc-4e46-b036-2d43e47dc2e1",
      "text": "Ta cũng sẽ làm như thời Nô-ê : lúc đó, Ta đã thề rằng",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:50.171Z",
      "updatedAt": "2025-09-03T03:01:50.171Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "d6a1f06d-1d0b-4771-91c6-222136f5f97c",
      "text": "hồng thuỷ sẽ không tràn ngập mặt đất nữa,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:50.213Z",
      "updatedAt": "2025-09-03T03:01:50.213Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "fb1d9965-7d2b-4945-9f35-640fe68aaabc",
      "text": "cũng vậy, nay Ta thề sẽ không còn nổi giận và hăm doạ ngươi đâu.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:50.242Z",
      "updatedAt": "2025-09-03T03:01:50.242Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "f5e3bfaa-aa17-4ce4-8fc1-1fdb59b7f0a2",
      "text": "Núi có dời có đổi, đồi có chuyển có lay,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:50.256Z",
      "updatedAt": "2025-09-03T03:01:50.256Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "1c0a7cb5-78d3-4f8a-8087-f29f04635665",
      "text": "tình nghĩa của Ta đối với ngươi vẫn không thay đổi,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:50.284Z",
      "updatedAt": "2025-09-03T03:01:50.284Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "4c777ffe-e8cc-40e8-b7d6-2f4d05794670",
      "text": "giao ước hoà bình của Ta cũng chẳng chuyển lay,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:50.298Z",
      "updatedAt": "2025-09-03T03:01:50.298Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "faa84907-ad51-4792-8689-c84f6b59a1d4",
      "text": "ĐỨC CHÚA là Đấng thương xót ngươi phán như vậy.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 3,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:50.323Z",
      "updatedAt": "2025-09-03T03:01:50.323Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "74eee9f5-89d4-42e3-95a6-6d0ab2444700",
      "text": "Hỡi thành đô khốn đốn, ba chìm bảy nổi, không người ủi an !",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:50.354Z",
      "updatedAt": "2025-09-03T03:01:50.354Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "18f9d620-8e05-44ea-aac1-7288d1063ceb",
      "text": "Này, đá của ngươi, Ta lấy phẩm màu tô điểm,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:50.410Z",
      "updatedAt": "2025-09-03T03:01:50.410Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "d83ffe20-1084-42f9-bf02-1740393bcb35",
      "text": "nền móng ngươi, Ta đặt trên lam ngọc,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:50.452Z",
      "updatedAt": "2025-09-03T03:01:50.452Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "94b9d34b-1797-49c5-ad7b-8a487a733afa",
      "text": "lỗ châu mai tường thành, Ta xây bằng hồng ngọc,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:50.466Z",
      "updatedAt": "2025-09-03T03:01:50.466Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "5373c9c4-1d1d-4d7a-a909-2839bb7dc0a9",
      "text": "các cửa thành ngươi, bằng pha lê,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:50.479Z",
      "updatedAt": "2025-09-03T03:01:50.479Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "94ae0573-5433-4df5-af54-6a9d9fd7f674",
      "text": "tường trong luỹ ngoài, toàn đá quý.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:50.493Z",
      "updatedAt": "2025-09-03T03:01:50.493Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "ef92ae09-29b4-4bb0-9f3a-1f943ca4c54a",
      "text": "Con cái ngươi, ĐỨC CHÚA đều dạy dỗ,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:50.507Z",
      "updatedAt": "2025-09-03T03:01:50.507Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "5ef24aad-e389-4dfc-aebc-b1c1983ed07d",
      "text": "chúng sẽ được vui hưởng thái bình.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:50.549Z",
      "updatedAt": "2025-09-03T03:01:50.549Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "9aba66a5-d124-4557-b200-8a1fbbc373b2",
      "text": "Nền tảng vững bền của ngươi sẽ là đức công chính ;",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:50.563Z",
      "updatedAt": "2025-09-03T03:01:50.563Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "74a78546-ae06-4dbe-9500-e0cad1455e70",
      "text": "ngươi sẽ thoát khỏi áp bức, không còn phải sợ chi,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:50.595Z",
      "updatedAt": "2025-09-03T03:01:50.595Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "43030bd2-57f3-4f87-b58d-d58cd457f344",
      "text": "sẽ thoát khỏi kinh hoàng,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 2,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:50.608Z",
      "updatedAt": "2025-09-03T03:01:50.608Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "8d844345-dcea-4848-9e04-041ce0bca006",
      "text": "vì kinh hoàng sẽ không đến gần ngươi nữa.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 3,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:50.637Z",
      "updatedAt": "2025-09-03T03:01:50.637Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "680bccb4-ea0f-4f0d-8c3a-f2e8779d2395",
      "text": "Vậy, nếu có âm mưu nào, Ta sẽ không dự phần vào đó ;",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:50.650Z",
      "updatedAt": "2025-09-03T03:01:50.650Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "8628ffa1-df02-47fb-9879-6732a078ec6a",
      "text": "có ai mưu tính chuyện hại ngươi, trước mặt ngươi, nó sẽ té nhào.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:50.664Z",
      "updatedAt": "2025-09-03T03:01:50.664Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "ded012f0-0bcb-4aee-bb04-a0090e609a0e",
      "text": "Này chính Ta đã dựng nên thợ rèn biết đốt than thổi lửa",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:50.678Z",
      "updatedAt": "2025-09-03T03:01:50.678Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "ce9276b7-db82-44b6-8e7c-82951278ebc0",
      "text": "và tạo ra dụng cụ cho công việc phải làm ;",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:50.692Z",
      "updatedAt": "2025-09-03T03:01:50.692Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "eaca3a8d-d998-4f61-8fa2-f96884278dc0",
      "text": "cũng chính Ta dựng nên bọn người phá hoại",
      "label": "16",
      "number": 16,
      "subVerseIndex": 2,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:50.705Z",
      "updatedAt": "2025-09-03T03:01:50.705Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "b24417f1-9c49-41ba-8882-2e91a93974e2",
      "text": "để gây thiệt hại mất mát.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 3,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:50.718Z",
      "updatedAt": "2025-09-03T03:01:50.718Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "029951fa-f381-4e1d-967b-02a6cca92673",
      "text": "Mọi khí cụ được chế ra nhằm chống lại ngươi đều chẳng lợi hại gì ;",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:50.729Z",
      "updatedAt": "2025-09-03T03:01:50.729Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "0b374904-10fb-439c-957f-1d716e909944",
      "text": "bất cứ ai uốn lưỡi tố cáo ngươi, ngươi sẽ đem ra kết tội.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:50.740Z",
      "updatedAt": "2025-09-03T03:01:50.740Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "2d49af56-1d1e-45d9-a4dd-ba197760c91c",
      "text": "Đó là phần sản nghiệp của những tôi trung ĐỨC CHÚA,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 2,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:50.751Z",
      "updatedAt": "2025-09-03T03:01:50.751Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "26f148fe-7d17-4207-8a03-f1d4d2e7fd2a",
      "text": "đó là sự công chính Ta dành sẵn cho những người này",
      "label": "17",
      "number": 17,
      "subVerseIndex": 3,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:50.785Z",
      "updatedAt": "2025-09-03T03:01:50.785Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    },
    {
      "id": "75a10c91-1fe3-4fc0-ad7a-d7ff3a9bf792",
      "text": "– sấm ngôn của ĐỨC CHÚA.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 4,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:50.796Z",
      "updatedAt": "2025-09-03T03:01:50.796Z",
      "chapterId": "f30665df-34dd-4740-a7ae-d237487a93d8"
    }
  ],
  "marks": [
