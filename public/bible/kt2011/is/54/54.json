    {
      "id": "0dcc2d26-7fd0-4273-bf56-55f65e3c273b",
      "content": "Is 26,15",
      "kind": "MARK_KIND_REFERENCE",
      "label": "4@",
      "sortOrder": 3,
      "startOffset": 12,
      "endOffset": 12,
