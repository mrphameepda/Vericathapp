{
  "chapter": {
    "id": "d32ded51-82b8-4a6d-a309-3710ae1833fa",
    "number": 55,
    "createdAt": "2025-09-03T01:07:51.737Z",
    "updatedAt": "2025-09-03T01:07:51.737Z",
    "bookId": "d17ae149-2718-48e5-b452-c522381bf71a"
  },
  "verses": [
    {
      "id": "48518856-edcc-4b6c-81e8-5a914d942385",
      "text": "Đến cả đi, hỡi những người đang khát, nước đã sẵn đây !",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:56.231Z",
      "updatedAt": "2025-09-03T03:01:56.231Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    },
    {
      "id": "e0181ab9-17f1-4678-9e6a-c105403ab27f",
      "text": "Dầu không có tiền bạc, cứ đến mua mà dùng ;",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:56.295Z",
      "updatedAt": "2025-09-03T03:01:56.295Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    },
    {
      "id": "2f6a6473-58a3-4826-ab91-e578f0c8d0ce",
      "text": "đến mua rượu mua sữa, không phải trả đồng nào.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:56.319Z",
      "updatedAt": "2025-09-03T03:01:56.319Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    },
    {
      "id": "f3bf6793-fa2e-4aca-95e0-28addb191378",
      "text": "Sao lại phí tiền bạc vào của không nuôi sống,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:56.342Z",
      "updatedAt": "2025-09-03T03:01:56.342Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    },
    {
      "id": "4a009ea0-95dc-4db9-922b-107a3fd3ddb5",
      "text": "tốn công lao vất vả vào thứ chẳng làm cho chắc dạ no lòng ?",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:56.368Z",
      "updatedAt": "2025-09-03T03:01:56.368Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    },
    {
      "id": "efd1e994-15e4-4c19-980f-aee7795e9ed2",
      "text": "Hãy chăm chú nghe Ta, thì các ngươi sẽ được ăn ngon,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:56.383Z",
      "updatedAt": "2025-09-03T03:01:56.383Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    },
    {
      "id": "70c6ca8e-b6e1-4384-816f-ba85b7666126",
      "text": "được thưởng thức cao lương mỹ vị.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 3,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:56.409Z",
      "updatedAt": "2025-09-03T03:01:56.409Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    },
    {
      "id": "8d794746-dbd4-4088-a24a-36662a019406",
      "text": "Hãy lắng tai và đến với Ta, hãy nghe thì các ngươi sẽ được sống.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:56.436Z",
      "updatedAt": "2025-09-03T03:01:56.436Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    },
    {
      "id": "5ebb8360-44ed-4062-80d3-540e73451e68",
      "text": "Ta sẽ lập với các ngươi một giao ước vĩnh cửu,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:56.449Z",
      "updatedAt": "2025-09-03T03:01:56.449Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    },
    {
      "id": "da2d5548-918d-4577-b590-2ec8f669fa18",
      "text": "để trọn bề nhân nghĩa với Đa-vít.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:56.461Z",
      "updatedAt": "2025-09-03T03:01:56.461Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    },
    {
      "id": "49d37313-0a8e-47d1-9327-1aecadd4e617",
      "text": "Này, Ta đã đặt Đa-vít làm nhân chứng cho các dân,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:56.514Z",
      "updatedAt": "2025-09-03T03:01:56.514Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    },
    {
      "id": "eea5ae22-3fe6-4f42-8cd0-3d30d546a391",
      "text": "làm thủ lãnh chỉ huy các nước.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:56.537Z",
      "updatedAt": "2025-09-03T03:01:56.537Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    },
    {
      "id": "4869412c-96cc-4c65-a1de-6e651132fa56",
      "text": "Này, ngươi sẽ chiêu tập một dân tộc ngươi không quen biết ;",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:56.554Z",
      "updatedAt": "2025-09-03T03:01:56.554Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    },
    {
      "id": "e247d2c3-e21a-4d32-9f78-6bf2a05af171",
      "text": "một dân tộc không quen biết ngươi sẽ chạy đến với ngươi,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:56.570Z",
      "updatedAt": "2025-09-03T03:01:56.570Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    },
    {
      "id": "fd7d7a3e-28e4-41f2-bf89-09bdabb47f70",
      "text": "vì ĐỨC CHÚA, Thiên Chúa của ngươi,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:56.583Z",
      "updatedAt": "2025-09-03T03:01:56.583Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    },
    {
      "id": "9b0de9b4-e74f-4c7d-ba11-96e9dac2813e",
      "text": "vì Đức Thánh của Ít-ra-en",
      "label": "5",
      "number": 5,
      "subVerseIndex": 3,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:56.613Z",
      "updatedAt": "2025-09-03T03:01:56.613Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    },
    {
      "id": "5f09902f-23fa-4ec0-91d6-2427c466a5e9",
      "text": "đã làm cho ngươi được vinh hiển.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 4,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:56.636Z",
      "updatedAt": "2025-09-03T03:01:56.636Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    },
    {
      "id": "568f0bc0-5d6a-46ea-ac1f-cdc254bbe640",
      "text": "Hãy tìm ĐỨC CHÚA khi Người còn cho gặp,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:56.649Z",
      "updatedAt": "2025-09-03T03:01:56.649Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    },
    {
      "id": "85d02306-5d16-4135-b5b4-eb590cd874eb",
      "text": "kêu cầu Người lúc Người ở kề bên.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:56.680Z",
      "updatedAt": "2025-09-03T03:01:56.680Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    },
    {
      "id": "38d117dd-5ede-4dbf-a79a-9e52cfdd4181",
      "text": "Kẻ gian ác, hãy bỏ đường lối mình đang theo,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:56.700Z",
      "updatedAt": "2025-09-03T03:01:56.700Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    },
    {
      "id": "9ca27413-e0af-4451-9f5d-980191d409d8",
      "text": "người bất lương, hãy bỏ tư tưởng mình đang có",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:56.713Z",
      "updatedAt": "2025-09-03T03:01:56.713Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    },
    {
      "id": "d046409c-49d4-48ee-a258-7ddde194991d",
      "text": "mà trở về với ĐỨC CHÚA – và Người sẽ xót thương –,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:56.724Z",
      "updatedAt": "2025-09-03T03:01:56.724Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    },
    {
      "id": "4defe454-a47e-4ea9-9abe-f5c94f3bd74c",
      "text": "về với Thiên Chúa chúng ta, vì Người sẽ rộng lòng tha thứ.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 3,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:56.759Z",
      "updatedAt": "2025-09-03T03:01:56.759Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    },
    {
      "id": "8a22f566-5f84-490c-85bf-c0e7994fcf65",
      "text": "Thật vậy, tư tưởng của Ta không phải là tư tưởng của các ngươi,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:56.793Z",
      "updatedAt": "2025-09-03T03:01:56.793Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    },
    {
      "id": "fcc0223f-665b-42f4-bcd4-aa99005ab502",
      "text": "và đường lối các ngươi không phải là đường lối của Ta",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:56.803Z",
      "updatedAt": "2025-09-03T03:01:56.803Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    },
    {
      "id": "8f9bd174-e42f-4065-b610-44a8cea01db2",
      "text": "– sấm ngôn của ĐỨC CHÚA.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:56.820Z",
      "updatedAt": "2025-09-03T03:01:56.820Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    },
    {
      "id": "2b07de78-acde-496c-bbef-ac0ee093d3b3",
      "text": "Trời cao hơn đất chừng nào",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:56.840Z",
      "updatedAt": "2025-09-03T03:01:56.840Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    },
    {
      "id": "0a09a63d-e3c4-4da1-ac96-81f28f57d451",
      "text": "thì đường lối của Ta cũng cao hơn đường lối các ngươi,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:56.863Z",
      "updatedAt": "2025-09-03T03:01:56.863Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    },
    {
      "id": "5df40869-2a0e-4cd9-bd77-bb9e9aa29b9d",
      "text": "và tư tưởng của Ta cũng cao hơn tư tưởng các ngươi chừng ấy.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:56.878Z",
      "updatedAt": "2025-09-03T03:01:56.878Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    },
    {
      "id": "8d35109d-c386-4779-b4e5-c9375ffb9f0f",
      "text": "Cũng như mưa với tuyết sa xuống từ trời",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:56.891Z",
      "updatedAt": "2025-09-03T03:01:56.891Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    },
    {
      "id": "aa541c8e-f22e-40b0-8f23-167c2f98272e",
      "text": "không trở về trời nếu chưa thấm xuống đất,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:56.901Z",
      "updatedAt": "2025-09-03T03:01:56.901Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    },
    {
      "id": "51d9be58-4876-492e-91f6-80e46753d600",
      "text": "chưa làm cho đất phì nhiêu và đâm chồi nẩy lộc,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:56.912Z",
      "updatedAt": "2025-09-03T03:01:56.912Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    },
    {
      "id": "cc3501ae-8a98-43d3-85e2-c1fd0579ceb1",
      "text": "cho kẻ gieo có hạt giống, cho người đói có bánh ăn,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 3,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:56.923Z",
      "updatedAt": "2025-09-03T03:01:56.923Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    },
    {
      "id": "3c8d451a-caae-44e7-b1ca-d33ca05fc3fc",
      "text": "thì lời Ta cũng vậy, một khi xuất phát từ miệng Ta,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:56.955Z",
      "updatedAt": "2025-09-03T03:01:56.955Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    },
    {
      "id": "7608d41d-36de-43d3-bdff-eadfce335410",
      "text": "sẽ không trở về với Ta nếu chưa đạt kết quả,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:56.986Z",
      "updatedAt": "2025-09-03T03:01:56.986Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    },
    {
      "id": "f226f672-e08e-4cd0-84ac-4889ec30a908",
      "text": "chưa thực hiện ý muốn của Ta,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:56.996Z",
      "updatedAt": "2025-09-03T03:01:56.996Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    },
    {
      "id": "0f8cb4b5-13b6-4645-99f9-294e4f6ae15a",
      "text": "chưa chu toàn sứ mạng Ta giao phó.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 3,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:57.007Z",
      "updatedAt": "2025-09-03T03:01:57.007Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    },
    {
      "id": "4ff533c1-b8b2-4312-a7fa-623145d797f3",
      "text": "Phải, các ngươi sẽ ra đi mừng rỡ hân hoan,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:57.018Z",
      "updatedAt": "2025-09-03T03:01:57.018Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    },
    {
      "id": "9955b8e1-6bb2-47bf-994d-6b2734339e3c",
      "text": "rồi lũ lượt kéo về bình an vô sự.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:57.051Z",
      "updatedAt": "2025-09-03T03:01:57.051Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    },
    {
      "id": "6e1ed1d5-4bc1-4631-a5aa-1ec96eeec3d9",
      "text": "Trước mặt các ngươi, đồi núi sẽ cất giọng reo hò,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:57.063Z",
      "updatedAt": "2025-09-03T03:01:57.063Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    },
    {
      "id": "bdbfd983-cec7-49e3-a2c7-243c04f06e85",
      "text": "cây cỏ ngoài đồng sẽ vỗ tay.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 3,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:57.076Z",
      "updatedAt": "2025-09-03T03:01:57.076Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    },
    {
      "id": "5ac52219-5b2c-4c73-a0c0-dd62a222381b",
      "text": "Cây bách vươn cao thay bụi rậm,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:57.089Z",
      "updatedAt": "2025-09-03T03:01:57.089Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    },
    {
      "id": "fbcb3fca-74aa-4517-b7da-241f89222e18",
      "text": "cây sim lớn mạnh thế tầm ma,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:57.120Z",
      "updatedAt": "2025-09-03T03:01:57.120Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    },
    {
      "id": "28017654-d480-4c3c-a24a-c8742f3b1ffe",
      "text": "để ĐỨC CHÚA được lừng danh nức tiếng,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:57.133Z",
      "updatedAt": "2025-09-03T03:01:57.133Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    },
    {
      "id": "0efee3d1-2860-412f-8196-b9f32d4bd6b7",
      "text": "được ghi nhớ ngàn năm và truyền tụng muôn đời.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 3,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:01:57.157Z",
      "updatedAt": "2025-09-03T03:01:57.157Z",
      "chapterId": "d32ded51-82b8-4a6d-a309-3710ae1833fa"
    }
  ],
  "marks": [
    {
      "id": "bfd0b3e5-aa84-41d2-9ca4-a71a7baeda41",
      "content": "Tiếp theo ch. 54, ch. 55 này ngỏ lời với những người sắp trở về tái thiết Giê-ru-sa-lem, nói lên những điều kiện sẽ giúp họ sống hạnh phúc. Đặt vào vị trí toàn bộ tác phẩm của Is đệ nhị, ch. 55 là phần kết, nhắc lại đề tài chính đã đề cập ở phần mở đầu (40,1-11) : Thiên Chúa cao cả, siêu việt trên hết mọi sự, lời Người đầy công hiệu, và cuộc xuất hành mới đầy vẻ vang.",
      "kind": "MARK_KIND_FOOTNOTE",
