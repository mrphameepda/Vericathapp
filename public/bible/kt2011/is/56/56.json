{
  "chapter": {
    "id": "e13e86ee-faa8-489f-88b6-a803d9e59876",
    "number": 56,
    "createdAt": "2025-09-03T01:07:51.737Z",
    "updatedAt": "2025-09-03T01:07:51.737Z",
    "bookId": "d17ae149-2718-48e5-b452-c522381bf71a"
  },
  "verses": [
    {
      "id": "786ad846-2187-4f2e-ad61-864e3ab784a8",
      "text": "ĐỨC CHÚA phán như sau : Hãy tuân giữ điều chính trực,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:02.099Z",
      "updatedAt": "2025-09-03T03:02:02.099Z",
      "chapterId": "e13e86ee-faa8-489f-88b6-a803d9e59876"
    },
    {
      "id": "4132a761-5665-4872-9aeb-36a5448a9429",
      "text": "thực hành điều công minh, vì ơn cứu độ của Ta đã gần tới,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:02.178Z",
      "updatedAt": "2025-09-03T03:02:02.178Z",
      "chapterId": "e13e86ee-faa8-489f-88b6-a803d9e59876"
    },
    {
      "id": "a5a8aaec-f3b7-42bc-a19e-8bcfaa88a7d1",
      "text": "và đức công chính của Ta sắp được biểu lộ.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:02.207Z",
      "updatedAt": "2025-09-03T03:02:02.207Z",
      "chapterId": "e13e86ee-faa8-489f-88b6-a803d9e59876"
    },
    {
      "id": "c763f0e0-24d2-42f0-bfc5-ef67273a3257",
      "text": "Phúc thay người làm như thế,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:02.220Z",
      "updatedAt": "2025-09-03T03:02:02.220Z",
      "chapterId": "e13e86ee-faa8-489f-88b6-a803d9e59876"
    },
    {
      "id": "9f1c0539-d641-4fa2-a2bf-8e4d7912aeb3",
      "text": "phúc thay phàm nhân nắm giữ điều này,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:02.234Z",
      "updatedAt": "2025-09-03T03:02:02.234Z",
      "chapterId": "e13e86ee-faa8-489f-88b6-a803d9e59876"
    },
    {
      "id": "fca67b6d-7849-4ec4-b2ae-5c95202bd116",
      "text": "người giữ ngày sa-bát mà không vi phạm,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:02.248Z",
      "updatedAt": "2025-09-03T03:02:02.248Z",
      "chapterId": "e13e86ee-faa8-489f-88b6-a803d9e59876"
    },
    {
      "id": "12903369-748c-465a-b08d-2d21d62eeb7f",
      "text": "chẳng hề đưa tay làm điều gian ác.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 3,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:02.277Z",
      "updatedAt": "2025-09-03T03:02:02.277Z",
      "chapterId": "e13e86ee-faa8-489f-88b6-a803d9e59876"
    },
    {
      "id": "a7998862-15f6-4bf1-9d5d-148ff2673cd4",
      "text": "Người ngoại bang gắn bó cùng ĐỨC CHÚA chớ nói rằng :",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:02.291Z",
      "updatedAt": "2025-09-03T03:02:02.291Z",
      "chapterId": "e13e86ee-faa8-489f-88b6-a803d9e59876"
    },
    {
      "id": "54a6b4fd-67e1-4e92-acd4-01dfe8fd8724",
      "text": "“Hẳn ĐỨC CHÚA đã tách tôi ra khỏi dân Người.”",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:02.329Z",
      "updatedAt": "2025-09-03T03:02:02.329Z",
      "chapterId": "e13e86ee-faa8-489f-88b6-a803d9e59876"
    },
    {
      "id": "85d38e13-118c-49a2-bf43-d2eb67049cee",
      "text": "Người bị hoạn chớ nói : “Chính tôi đây là một cây khô.”",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:02.353Z",
      "updatedAt": "2025-09-03T03:02:02.353Z",
      "chapterId": "e13e86ee-faa8-489f-88b6-a803d9e59876"
    },
    {
      "id": "64a15fc2-592e-46d4-b33b-42700f31f533",
      "text": "Quả vậy, ĐỨC CHÚA phán như sau : Nếu những người bị hoạn",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:02.366Z",
      "updatedAt": "2025-09-03T03:02:02.366Z",
      "chapterId": "e13e86ee-faa8-489f-88b6-a803d9e59876"
    },
    {
      "id": "a59364e0-29a4-4b12-8276-5b9bc35e848b",
      "text": "mà vẫn giữ các ngày sa-bát Ta truyền,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:02.412Z",
      "updatedAt": "2025-09-03T03:02:02.412Z",
      "chapterId": "e13e86ee-faa8-489f-88b6-a803d9e59876"
    },
    {
      "id": "6be182fe-8093-49d8-a4dd-b025b0ef3501",
      "text": "và lựa chọn điều Ta ưa thích, cùng tuân thủ giao ước của Ta,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:02.427Z",
      "updatedAt": "2025-09-03T03:02:02.427Z",
      "chapterId": "e13e86ee-faa8-489f-88b6-a803d9e59876"
    },
    {
      "id": "b6315e90-97f4-41e6-a5f4-bb831dd27b85",
      "text": "thì trong nhà và trong tường luỹ của Ta,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:02.441Z",
      "updatedAt": "2025-09-03T03:02:02.441Z",
      "chapterId": "e13e86ee-faa8-489f-88b6-a803d9e59876"
    },
    {
      "id": "098ec822-714a-4a20-afe2-f56d7fe77688",
      "text": "Ta sẽ cho chúng được lưu danh và có đài kỷ niệm ;",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:02.455Z",
      "updatedAt": "2025-09-03T03:02:02.455Z",
      "chapterId": "e13e86ee-faa8-489f-88b6-a803d9e59876"
    },
    {
      "id": "5c1aaa24-0df7-4b80-bf15-ed5c518568d2",
      "text": "như thế còn quý hơn con trai con gái.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:02.488Z",
      "updatedAt": "2025-09-03T03:02:02.488Z",
      "chapterId": "e13e86ee-faa8-489f-88b6-a803d9e59876"
    },
    {
      "id": "05f903b1-4a60-4ccc-b54c-809816aff485",
      "text": "Ta sẽ cho tên tuổi chúng trường tồn, không bao giờ bị ai xoá bỏ.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 3,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:02.516Z",
      "updatedAt": "2025-09-03T03:02:02.516Z",
      "chapterId": "e13e86ee-faa8-489f-88b6-a803d9e59876"
    },
    {
      "id": "e3dd7fcd-8fd1-49af-9e44-0d08a9ec3058",
      "text": "Người ngoại bang nào gắn bó cùng ĐỨC CHÚA",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:02.557Z",
      "updatedAt": "2025-09-03T03:02:02.557Z",
      "chapterId": "e13e86ee-faa8-489f-88b6-a803d9e59876"
    },
    {
      "id": "143c1699-8cde-42c2-a040-1081fe84f157",
      "text": "để phụng sự Người và yêu mến Thánh Danh,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:02.618Z",
      "updatedAt": "2025-09-03T03:02:02.618Z",
      "chapterId": "e13e86ee-faa8-489f-88b6-a803d9e59876"
    },
    {
      "id": "32d2ac28-3697-49d0-988e-beaa7546dee5",
      "text": "cùng trở nên tôi tớ của Người,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:02.632Z",
      "updatedAt": "2025-09-03T03:02:02.632Z",
      "chapterId": "e13e86ee-faa8-489f-88b6-a803d9e59876"
    },
    {
      "id": "960bd963-55b4-40d7-941e-b47aa8475519",
      "text": "hết những ai giữ ngày sa-bát mà không vi phạm,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 3,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:02.646Z",
      "updatedAt": "2025-09-03T03:02:02.646Z",
      "chapterId": "e13e86ee-faa8-489f-88b6-a803d9e59876"
    },
    {
      "id": "4d69990e-cd52-45d0-812b-f76c46b400c8",
      "text": "cùng những ai tuân thủ giao ước của Ta,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 4,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:02.660Z",
      "updatedAt": "2025-09-03T03:02:02.660Z",
      "chapterId": "e13e86ee-faa8-489f-88b6-a803d9e59876"
    },
    {
      "id": "17b8f10b-fe09-42a0-9dc0-159a9098b9e2",
      "text": "đều được Ta dẫn lên núi thánh",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:02.675Z",
      "updatedAt": "2025-09-03T03:02:02.675Z",
      "chapterId": "e13e86ee-faa8-489f-88b6-a803d9e59876"
    },
    {
      "id": "9a11530e-8127-4bc0-b343-d7aad0662cad",
      "text": "và cho hoan hỷ nơi nhà cầu nguyện của Ta.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:02.703Z",
      "updatedAt": "2025-09-03T03:02:02.703Z",
      "chapterId": "e13e86ee-faa8-489f-88b6-a803d9e59876"
    },
    {
      "id": "9460e697-83b4-4966-8a3f-f691277b44ea",
      "text": "Trên bàn thờ của Ta, Ta sẽ ưng nhận",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:02.731Z",
      "updatedAt": "2025-09-03T03:02:02.731Z",
      "chapterId": "e13e86ee-faa8-489f-88b6-a803d9e59876"
    },
    {
      "id": "def8ed0c-3da2-4f1e-92bb-14ae67f82b19",
      "text": "những lễ toàn thiêu và hy lễ chúng dâng,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 3,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:02.745Z",
      "updatedAt": "2025-09-03T03:02:02.745Z",
      "chapterId": "e13e86ee-faa8-489f-88b6-a803d9e59876"
    },
    {
      "id": "5a1a0ead-4275-488f-afe0-fcee16d793da",
      "text": "vì nhà của Ta sẽ được gọi là nhà cầu nguyện của muôn dân.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 4,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:02.759Z",
      "updatedAt": "2025-09-03T03:02:02.759Z",
      "chapterId": "e13e86ee-faa8-489f-88b6-a803d9e59876"
    },
    {
      "id": "5178aaa1-79b7-4de6-a3e0-20a7a7857277",
      "text": "Sấm ngôn của ĐỨC CHÚA là Thiên Chúa,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:02.802Z",
      "updatedAt": "2025-09-03T03:02:02.802Z",
      "chapterId": "e13e86ee-faa8-489f-88b6-a803d9e59876"
    },
    {
      "id": "783bf80b-7456-448a-9572-9cbef7957668",
      "text": "Đấng tập hợp những người Ít-ra-en tản lạc về :",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:02.830Z",
      "updatedAt": "2025-09-03T03:02:02.830Z",
      "chapterId": "e13e86ee-faa8-489f-88b6-a803d9e59876"
    },
    {
      "id": "e5871f9f-3663-4c04-acb5-ed85f13be0f8",
      "text": "Ngoài những người đã được tập hợp,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:02.858Z",
      "updatedAt": "2025-09-03T03:02:02.858Z",
      "chapterId": "e13e86ee-faa8-489f-88b6-a803d9e59876"
    },
    {
      "id": "071f638a-b2b3-4b8f-926a-d40feec8b43f",
      "text": "Ta sẽ còn tập hợp thêm nữa về với Ít-ra-en.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 3,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:02.871Z",
      "updatedAt": "2025-09-03T03:02:02.871Z",
      "chapterId": "e13e86ee-faa8-489f-88b6-a803d9e59876"
    },
    {
      "id": "303d2968-7ac2-4230-abaa-fc286a72fd54",
      "text": "Mọi thú vật ngoài đồng, hãy đến mà ăn ;",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:02.913Z",
      "updatedAt": "2025-09-03T03:02:02.913Z",
      "chapterId": "e13e86ee-faa8-489f-88b6-a803d9e59876"
    },
    {
      "id": "51d589af-f9b1-4a3a-bc3f-c601ac2a3235",
      "text": "tất cả thú trên rừng cũng vậy.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:02.927Z",
      "updatedAt": "2025-09-03T03:02:02.927Z",
      "chapterId": "e13e86ee-faa8-489f-88b6-a803d9e59876"
    },
    {
      "id": "4197f63d-fb42-4f2d-b9eb-433ec1c06ecd",
      "text": "Những người canh gác Ít-ra-en đui mù hết, chẳng hiểu biết gì ;",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:02.941Z",
      "updatedAt": "2025-09-03T03:02:02.941Z",
      "chapterId": "e13e86ee-faa8-489f-88b6-a803d9e59876"
    },
    {
      "id": "8021173e-7d3c-44b5-855a-da323166a9d1",
      "text": "cả bọn chúng là lũ chó câm, không biết sủa,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:03.025Z",
      "updatedAt": "2025-09-03T03:02:03.025Z",
      "chapterId": "e13e86ee-faa8-489f-88b6-a803d9e59876"
    },
    {
      "id": "b9441025-17df-418b-96b6-1d8029846d2d",
      "text": "chỉ mơ mộng, nằm dài và thích ngủ thôi.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:03.038Z",
      "updatedAt": "2025-09-03T03:02:03.038Z",
      "chapterId": "e13e86ee-faa8-489f-88b6-a803d9e59876"
    },
    {
      "id": "8a1110ae-632d-4114-a36e-0056ab143848",
      "text": "Chúng còn là lũ chó đói,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:03.053Z",
      "updatedAt": "2025-09-03T03:02:03.053Z",
      "chapterId": "e13e86ee-faa8-489f-88b6-a803d9e59876"
    },
    {
      "id": "6e00b9a6-1d48-430e-a764-4123cf32e876",
      "text": "ăn chẳng biết no.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:03.067Z",
      "updatedAt": "2025-09-03T03:02:03.067Z",
      "chapterId": "e13e86ee-faa8-489f-88b6-a803d9e59876"
    },
    {
      "id": "5a811b9d-f941-4d33-b3a4-2bc1daf9c314",
      "text": "Thế mà chúng lại là mục tử,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:03.081Z",
      "updatedAt": "2025-09-03T03:02:03.081Z",
      "chapterId": "e13e86ee-faa8-489f-88b6-a803d9e59876"
    },
    {
      "id": "f763a1b7-440b-4a72-afea-1f3c1b6ea92c",
      "text": "thứ mục tử chẳng biết phân biệt gì.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 3,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:03.095Z",
      "updatedAt": "2025-09-03T03:02:03.095Z",
      "chapterId": "e13e86ee-faa8-489f-88b6-a803d9e59876"
    },
    {
      "id": "69704ca4-f626-4ffb-9b05-51f772df1649",
      "text": "Cả bọn –chẳng trừ ai– mạnh ai theo đường nấy,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 4,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:03.123Z",
      "updatedAt": "2025-09-03T03:02:03.123Z",
      "chapterId": "e13e86ee-faa8-489f-88b6-a803d9e59876"
    },
    {
      "id": "e15c0f9c-95d8-47fe-b11d-8eb7e231dfd2",
      "text": "chỉ mưu tìm lợi lộc cho riêng mình.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 5,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:03.136Z",
      "updatedAt": "2025-09-03T03:02:03.136Z",
      "chapterId": "e13e86ee-faa8-489f-88b6-a803d9e59876"
    },
    {
      "id": "cc3b367f-cff9-4db1-8309-2850a5db92ac",
      "text": "“Lại đây ! Ta sẽ đi tìm rượu ngon, sẽ tha hồ uống rượu mạnh,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:03.151Z",
      "updatedAt": "2025-09-03T03:02:03.151Z",
      "chapterId": "e13e86ee-faa8-489f-88b6-a803d9e59876"
    },
    {
      "id": "9add3a30-0ff2-4af6-b9ad-9a2cb661ffdc",
      "text": "ngày mai cũng lại như hôm nay, và còn nhiều hơn nữa.”",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:03.178Z",
      "updatedAt": "2025-09-03T03:02:03.178Z",
      "chapterId": "e13e86ee-faa8-489f-88b6-a803d9e59876"
    }
  ],
  "marks": [
