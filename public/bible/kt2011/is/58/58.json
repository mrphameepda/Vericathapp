      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "0c852851-a3ed-43cf-87b4-7435b8a5d9ff",
      "content": "Luật chỉ buộc ăn chay vào ngày lễ đền tội (Lv 23,26-32), nhưng có một thời người ta ăn chay nhiều ngày khác nữa : hoặc vì là ngày lễ giỗ (Dcr 7,1-5 ; 8,18-19), hoặc để nài van lòng thương xót của Thiên Chúa (Gr 36,6.9 ; Gn 3,5 ; 1 V 21,9.12).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 51,
      "endOffset": 51,
      "createdAt": "2025-09-03T03:02:15.490Z",
      "updatedAt": "2025-09-03T03:02:15.490Z",
      "targetId": "71fecdfd-68c7-4664-b131-10edfd80d1e1",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "7e76cb86-333b-4273-a411-42070697d2a3",
      "content": "Am 5,21tđ; Mt 25,34-40",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 19,
      "endOffset": 19,
      "createdAt": "2025-09-03T03:02:15.738Z",
      "updatedAt": "2025-09-03T03:02:15.738Z",
      "targetId": "8f67992d-3880-4915-9f4f-bd337760ee16",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "8ee148b0-d8ea-463d-bed2-f7d846071985",
      "content": "ds ba vế này : *các ngươi không ăn chay như cách* (phải ăn chay trong) *ngày* (ăn chay) *để tiếng các ngươi ...* Còn ăn chay đúng cách, cc. 6-7 sẽ cho biết làm như thế nào.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T03:02:15.619Z",
      "updatedAt": "2025-09-03T03:02:15.619Z",
      "targetId": "047af99c-4557-4623-bcd5-968c31998922",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "e7b7bfff-443a-43cc-a0c3-1b8c4376074f",
      "content": "Gr 34,8-9",
      "kind": "MARK_KIND_REFERENCE",
      "label": "4@",
      "sortOrder": 3,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T03:02:15.777Z",
      "updatedAt": "2025-09-03T03:02:15.777Z",
