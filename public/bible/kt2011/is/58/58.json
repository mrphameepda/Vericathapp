      "content": "Đnl 32,13+",
      "kind": "MARK_KIND_REFERENCE",
      "label": "11@",
      "sortOrder": 10,
      "startOffset": 16,
      "endOffset": 16,
      "createdAt": "2025-09-03T03:02:16.460Z",
