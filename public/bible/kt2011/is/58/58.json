      "content": "Is 1,20; 40,5",
      "kind": "MARK_KIND_REFERENCE",
      "label": "12@",
      "sortOrder": 11,
      "startOffset": 6,
      "endOffset": 6,
      "createdAt": "2025-09-03T03:02:16.531Z",
