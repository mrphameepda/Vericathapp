    },
    {
      "id": "604ff7a2-0940-4192-b56c-b80b85d7ef86",
      "content": "Ga 4,14",
      "kind": "MARK_KIND_REFERENCE",
      "label": "8@",
      "sortOrder": 7,
      "startOffset": 4,
      "endOffset": 4,
      "createdAt": "2025-09-03T03:02:16.177Z",
