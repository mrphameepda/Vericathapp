    {
      "id": "fa202e77-28cf-4ae8-80a6-b3bcc0fd599b",
      "content": "ds : *dùng ngón tay ra hiệu* (x. Cn 6,13). Đây còn có thể là chỉ điểm, tố cáo trước quan toà, gây hại rất trầm trọng cho người khác.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "8",
      "sortOrder": 7,
      "startOffset": 23,
      "endOffset": 23,
      "createdAt": "2025-09-03T03:02:16.012Z",
