{
  "chapter": {
    "id": "7c3bba17-4d12-4c96-b584-3bdcf858b05d",
    "number": 58,
    "createdAt": "2025-09-03T01:07:51.737Z",
    "updatedAt": "2025-09-03T01:07:51.737Z",
    "bookId": "d17ae149-2718-48e5-b452-c522381bf71a"
  },
  "verses": [
    {
      "id": "9f5e2a32-8d20-4596-8fc2-8b9b1c9f9e59",
      "text": "Cứ lấy hết gân cổ mà kêu lên, đừng kìm hãm,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:15.303Z",
      "updatedAt": "2025-09-03T03:02:15.303Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "1fb4d46e-5d16-4689-add9-77e1c14f28b9",
      "text": "kêu lớn tiếng lên như tù và,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:15.343Z",
      "updatedAt": "2025-09-03T03:02:15.343Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "9e766e4b-6c40-4d4b-a88c-88ce64beda33",
      "text": "báo cho dân Ta hay tội ác của chúng,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:15.353Z",
      "updatedAt": "2025-09-03T03:02:15.353Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "ef14be8a-9803-4b01-90a2-3b9d979e304d",
      "text": "cho nhà Gia-cóp biết những lỗi lầm đã phạm.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 3,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:15.364Z",
      "updatedAt": "2025-09-03T03:02:15.364Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "28a80e1e-8f6c-4828-b386-24bab5da25ed",
      "text": "Ngày lại ngày chúng kiếm tìm Ta,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:15.388Z",
      "updatedAt": "2025-09-03T03:02:15.388Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "d6a2e5f3-a113-49a2-908b-4e3a012b59c8",
      "text": "chúng ao ước biết đường lối của Ta,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:15.402Z",
      "updatedAt": "2025-09-03T03:02:15.402Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "798a6665-3aad-4183-b9b3-2f65bedfcc03",
      "text": "như thể một dân tộc vẫn thực hành sự công chính",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:15.416Z",
      "updatedAt": "2025-09-03T03:02:15.416Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "3902ef36-1646-4286-ba6c-e14aaa15eb42",
      "text": "và không bỏ luật pháp của Thiên Chúa mình.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 3,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:15.429Z",
      "updatedAt": "2025-09-03T03:02:15.429Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "5ac49069-f1af-4bb1-b640-1c10a8cfc6b8",
      "text": "Chúng xin Ta ban những điều luật công minh,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 4,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:15.443Z",
      "updatedAt": "2025-09-03T03:02:15.443Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "c21787c4-c630-4d35-b212-32bfc8e0e52e",
      "text": "chúng ước ao được đến gần Thiên Chúa.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 5,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:15.458Z",
      "updatedAt": "2025-09-03T03:02:15.458Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "71fecdfd-68c7-4664-b131-10edfd80d1e1",
      "text": "Chúng nói : “Chúng tôi ăn chay, sao Ngài không thấy,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:15.472Z",
      "updatedAt": "2025-09-03T03:02:15.472Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "9c89aa9b-3d2f-4c94-9596-ba7dd8589128",
      "text": "chúng tôi hãm mình, sao Ngài chẳng hay ?”",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:15.531Z",
      "updatedAt": "2025-09-03T03:02:15.531Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "7d21d939-5509-49cb-9abb-ad518dc9c1af",
      "text": "Này, ngày ăn chay, các ngươi vẫn lo kiếm lợi,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:15.547Z",
      "updatedAt": "2025-09-03T03:02:15.547Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "c8d3dfb9-b1c8-4c5a-aed0-731b89d84c0d",
      "text": "vẫn áp bức mọi kẻ làm công cho mình.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 3,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:15.563Z",
      "updatedAt": "2025-09-03T03:02:15.563Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "fb68e7d3-ac1c-4d3c-bf16-32edc3251f95",
      "text": "Này, các ngươi ăn chay để mà đôi co cãi vã,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:15.585Z",
      "updatedAt": "2025-09-03T03:02:15.585Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "5857faa0-9aa3-4e8f-a6cf-1f6e7654ecad",
      "text": "để nắm tay đánh đấm thật bạo tàn.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:15.595Z",
      "updatedAt": "2025-09-03T03:02:15.595Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "047af99c-4557-4623-bcd5-968c31998922",
      "text": "Chính ngày các ngươi muốn ăn chay",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:15.605Z",
      "updatedAt": "2025-09-03T03:02:15.605Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "7361d98a-49c7-4717-bf41-9753334cfcd1",
      "text": "để tiếng các ngươi kêu thấu trời cao thẳm,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 3,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:15.629Z",
      "updatedAt": "2025-09-03T03:02:15.629Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "e8f13f75-3f27-43df-bf63-101b4e2e4184",
      "text": "thì các ngươi lại ăn chay không đúng cách.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 4,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:15.641Z",
      "updatedAt": "2025-09-03T03:02:15.641Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "99aed678-3f39-4f49-8f55-7aad32a1eac7",
      "text": "Phải chăng đó là cách ăn chay mà Ta ưa chuộng",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:15.651Z",
      "updatedAt": "2025-09-03T03:02:15.651Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "f1e1a8c1-fa8c-4502-ac62-0150f1a75f1c",
      "text": "trong ngày con người phải thực hành khổ chế ?",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:15.660Z",
      "updatedAt": "2025-09-03T03:02:15.660Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "ed8b4b93-b91b-4b6b-8b99-b38b910a7c88",
      "text": "Cúi rạp đầu như cây sậy cây lau,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:15.670Z",
      "updatedAt": "2025-09-03T03:02:15.670Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "497bed73-3b8b-4384-8359-ee24debc2740",
      "text": "nằm trên vải thô và tro bụi,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 3,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:15.681Z",
      "updatedAt": "2025-09-03T03:02:15.681Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "a05fa523-3b61-49e0-8514-5de4503c518b",
      "text": "phải chăng như thế mà gọi là ăn chay,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 4,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:15.691Z",
      "updatedAt": "2025-09-03T03:02:15.691Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "d6124db4-c5d9-4dee-9558-e9450a739728",
      "text": "trong ngày các ngươi muốn đẹp lòng ĐỨC CHÚA ?",
      "label": "5",
      "number": 5,
      "subVerseIndex": 5,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:15.703Z",
      "updatedAt": "2025-09-03T03:02:15.703Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "8f67992d-3880-4915-9f4f-bd337760ee16",
      "text": "Cách ăn chay mà Ta ưa thích chẳng phải là thế này sao :",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:15.727Z",
      "updatedAt": "2025-09-03T03:02:15.727Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "e4a6fae8-3388-4ea1-b78c-8ef6293b274e",
      "text": "mở xiềng xích bạo tàn, tháo gông cùm trói buộc,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:15.750Z",
      "updatedAt": "2025-09-03T03:02:15.750Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "03530244-f11e-4890-a435-1a86af0aedd9",
      "text": "trả tự do cho người bị áp bức, đập tan mọi gông cùm ?",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:15.763Z",
      "updatedAt": "2025-09-03T03:02:15.763Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "617b0e03-99bd-46e5-98ca-3226c2a2d4bb",
      "text": "Chẳng phải là chia cơm cho người đói,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:15.791Z",
      "updatedAt": "2025-09-03T03:02:15.791Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "d54d47a9-94fb-4879-8b45-afc8a2ab9c43",
      "text": "rước vào nhà những người nghèo không nơi trú ngụ ;",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:15.805Z",
      "updatedAt": "2025-09-03T03:02:15.805Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "54194783-c79f-4c00-b350-682dd529c0a6",
      "text": "thấy ai mình trần thì cho áo che thân,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:15.818Z",
      "updatedAt": "2025-09-03T03:02:15.818Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "1a704051-28e7-44f8-8819-5fe26090820f",
      "text": "không ngoảnh mặt làm ngơ trước người anh em cốt nhục ?",
      "label": "7",
      "number": 7,
      "subVerseIndex": 3,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:15.838Z",
      "updatedAt": "2025-09-03T03:02:15.838Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "b873f739-82da-4228-87a0-6d41b4442add",
      "text": "Bấy giờ ánh sáng ngươi sẽ bừng lên như rạng đông,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:15.852Z",
      "updatedAt": "2025-09-03T03:02:15.852Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "1d66698f-8bdc-4d9f-846a-48e421e21873",
      "text": "vết thương ngươi sẽ mau lành.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:15.867Z",
      "updatedAt": "2025-09-03T03:02:15.867Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "23543ce4-0b8f-4fc9-93c0-76359809a180",
      "text": "Đức công chính ngươi sẽ mở đường phía trước,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:15.877Z",
      "updatedAt": "2025-09-03T03:02:15.877Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "5b0aa43f-471c-485b-93b7-bf1a68feff4e",
      "text": "vinh quang ĐỨC CHÚA bao bọc phía sau ngươi.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 3,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:15.898Z",
      "updatedAt": "2025-09-03T03:02:15.898Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "3b15bd78-2547-4339-aec9-a243cd5c1b3f",
      "text": "Bấy giờ, ngươi kêu lên, ĐỨC CHÚA sẽ nhậm lời,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:15.927Z",
      "updatedAt": "2025-09-03T03:02:15.927Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "e6d9bd77-8460-4896-ba05-6c8b2d81cc92",
      "text": "ngươi cầu cứu, Người liền đáp lại : “Có Ta đây !”",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:15.953Z",
      "updatedAt": "2025-09-03T03:02:15.953Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "13afbd1e-4237-499c-9752-1c15927d6a71",
      "text": "Nếu ngươi loại khỏi nơi ngươi ở",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:15.982Z",
      "updatedAt": "2025-09-03T03:02:15.982Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "01ba339f-ad38-41d2-8a6b-6869459a1d37",
      "text": "gông cùm, cử chỉ đe doạ và lời nói hại người,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 3,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:15.997Z",
      "updatedAt": "2025-09-03T03:02:15.997Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "a3b8eff8-fdcd-416a-8239-96737e24502a",
      "text": "nếu ngươi nhường miếng ăn cho kẻ đói,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:16.026Z",
      "updatedAt": "2025-09-03T03:02:16.026Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "4071cc1b-f490-4632-a42a-121764db91a0",
      "text": "làm thoả lòng người bị hạ nhục,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:16.056Z",
      "updatedAt": "2025-09-03T03:02:16.056Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "b5c9561a-257c-4ed4-929c-7c81b4ebe387",
      "text": "thì ánh sáng ngươi sẽ chiếu toả trong bóng tối,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:16.070Z",
      "updatedAt": "2025-09-03T03:02:16.070Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "199dd4cf-3375-4186-b068-f966d6e5dbdf",
      "text": "và tối tăm của ngươi chẳng khác nào chính ngọ.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 3,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:16.099Z",
      "updatedAt": "2025-09-03T03:02:16.099Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "44fcecb1-6179-475c-84e5-8958f657fdd1",
      "text": "ĐỨC CHÚA sẽ không ngừng dẫn dắt ngươi,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:16.112Z",
      "updatedAt": "2025-09-03T03:02:16.112Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "0fe946cd-7df2-4b4a-a266-91cb94bf8f3a",
      "text": "giữa đồng khô cỏ cháy, Người sẽ cho ngươi được no lòng ;",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:16.134Z",
      "updatedAt": "2025-09-03T03:02:16.134Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "a687afb8-5450-408e-8162-01fe5f072dc6",
      "text": "xương cốt ngươi, Người sẽ làm cho cứng cáp.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:16.144Z",
      "updatedAt": "2025-09-03T03:02:16.144Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "2e3b3e2c-32c4-4ccb-843f-db8d95918f0f",
      "text": "Ngươi sẽ như thửa vườn được tưới đẫm,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 3,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:16.155Z",
      "updatedAt": "2025-09-03T03:02:16.155Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "850aa6c5-974b-4e13-bb70-2c6b2b961244",
      "text": "như mạch suối không cạn nước bao giờ.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 4,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:16.167Z",
      "updatedAt": "2025-09-03T03:02:16.167Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "b4afd5b7-8179-49cd-8ab9-623e8a104df7",
      "text": "Nhờ ngươi, người ta sẽ tái thiết những tàn tích cổ xưa,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:16.188Z",
      "updatedAt": "2025-09-03T03:02:16.188Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "032fa1f5-f8da-490a-9b92-b8da1248febb",
      "text": "ngươi sẽ dựng lại những nền móng của các thế hệ trước,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:16.210Z",
      "updatedAt": "2025-09-03T03:02:16.210Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "1d5f4627-6543-4b94-a931-1bc0261f85be",
      "text": "người ta sẽ gọi ngươi là người sửa lại những lỗ hổng,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:16.222Z",
      "updatedAt": "2025-09-03T03:02:16.222Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "993b54a7-62ec-4b92-9a01-8aa28310d5e1",
      "text": "là kẻ tu bổ phố phường cho người ta cư ngụ.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 3,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:16.235Z",
      "updatedAt": "2025-09-03T03:02:16.235Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "caa14f2f-689a-40e8-b58c-f9b9e2908728",
      "text": "Nếu ngươi giữ chân không vi phạm ngày sa-bát,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:16.265Z",
      "updatedAt": "2025-09-03T03:02:16.265Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "ef037674-d38d-4e9e-a6bc-c4c47c3cb95c",
      "text": "và không tìm lợi lộc trong ngày thánh của Ta,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:16.336Z",
      "updatedAt": "2025-09-03T03:02:16.336Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "de573672-d485-45e1-966e-35d5d6b21bbb",
      "text": "nếu ngươi gọi ngày sa-bát là “niềm vui”",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:16.347Z",
      "updatedAt": "2025-09-03T03:02:16.347Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "1ad91115-8580-4621-8f08-75b9602fdf66",
      "text": "và ngày thánh của ĐỨC CHÚA là “vinh hiển”,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 3,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:16.359Z",
      "updatedAt": "2025-09-03T03:02:16.359Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "597dec55-75db-47aa-b875-acfc8144cec3",
      "text": "nếu ngươi tôn trọng ngày đó",
      "label": "13",
      "number": 13,
      "subVerseIndex": 4,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:16.386Z",
      "updatedAt": "2025-09-03T03:02:16.386Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "b63d4a9b-7f0c-4219-a329-4c8b6038d0f0",
      "text": "mà tránh đi đường, tránh kiếm lợi, tránh nói huyên thuyên,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 5,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:16.400Z",
      "updatedAt": "2025-09-03T03:02:16.400Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "4bb8d430-ae26-42d4-a23b-ec5d002809a6",
      "text": "thì bấy giờ, ngươi sẽ được ĐỨC CHÚA làm niềm vui,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:16.414Z",
      "updatedAt": "2025-09-03T03:02:16.414Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "ef88a22e-2cca-46ca-9ce7-ea90051d7498",
      "text": "Ta sẽ cho ngươi phóng ngựa trên các vùng đất cao trong xứ,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:16.442Z",
      "updatedAt": "2025-09-03T03:02:16.442Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "7e54f77b-4310-42e8-93cd-bcdddf95cc8d",
      "text": "sẽ cho ngươi hưởng gia nghiệp của Gia-cóp, tổ tiên ngươi.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 2,
      "paragraphNumber": 61,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:16.474Z",
      "updatedAt": "2025-09-03T03:02:16.474Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
    {
      "id": "961c716b-08e3-43c1-bd6a-2f3a9dfcb09c",
      "text": "Chính miệng ĐỨC CHÚA đã phán như vậy.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 3,
      "paragraphNumber": 62,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:16.502Z",
      "updatedAt": "2025-09-03T03:02:16.502Z",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    }
  ],
  "marks": [
    {
      "id": "4739f713-081e-45d8-895f-0f761a06fe14",
      "content": "Đoạn này có lẽ do một người môn đệ của Is đệ nhị biên soạn, ít lâu sau cuộc hồi hương. Lời sấm được nói với dân Chúa tại Giê-ru-sa-lem, đòi hỏi thái độ nội tâm trong việc “giữ đạo”, theo tinh thần các ngôn sứ lớn tiền lưu đày (x. Is 1,10 tt ; Am 5,21 tt). Cần chỉnh lại như vậy vì có một số người quan niệm việc giữ đạo là một cách làm cho Thiên Chúa mắc nợ họ và phải đáp lại bằng những phúc lành, theo ý họ. Ở đây tập trung vào đề tài ăn chay, với ba câu chính yếu 5-7.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 32,
      "endOffset": 32,
      "createdAt": "2025-09-03T03:02:15.331Z",
      "updatedAt": "2025-09-03T03:02:15.331Z",
      "targetId": "5be8c087-3ced-4a56-9bea-f70f0a5adbb2",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "7c3bba17-4d12-4c96-b584-3bdcf858b05d"
    },
