    {
      "id": "8147bbeb-857c-415c-bb79-f3beca4f88ef",
      "content": "Từ *gấp đôi* được ghép với nhiều từ khác nhau, tuỳ bản dịch, vì bản văn không được rõ. Tuy nhiên, đại ý vẫn là để nói *anh em sẽ được đền bù gấp hai lần* trong ngày Thiên Chúa cứu độ (x. 40,2).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "11",
      "sortOrder": 10,
      "startOffset": 22,
      "endOffset": 22,
      "createdAt": "2025-09-03T03:02:37.532Z",
      "updatedAt": "2025-09-03T03:02:37.532Z",
      "targetId": "9cd47204-a3c6-4384-81cb-1dbe98831f5e",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "c22bdde1-86f0-43ba-8c73-5e509a08226d",
      "content": "Kh 19,8; 21,2+",
      "kind": "MARK_KIND_REFERENCE",
      "label": "11@",
      "sortOrder": 10,
      "startOffset": 33,
      "endOffset": 33,
      "createdAt": "2025-09-03T03:02:37.907Z",
      "updatedAt": "2025-09-03T03:02:37.907Z",
      "targetId": "0a40996f-e849-479d-a271-ff274caa06ab",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "27a6f267-5bc7-4eab-94a7-a84e28a42507",
      "content": "Bắt đầu từ đây cho đến hết c.9b, tất cả các chỗ dịch ra ngôi thứ hai số nhiều *anh em* hay *các ngươi* : đều là theo CR và XR ; M viết ngôi thứ ba số nhiều : *chúng*.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "12",
      "sortOrder": 11,
      "startOffset": 17,
      "endOffset": 17,
      "createdAt": "2025-09-03T03:02:37.572Z",
      "updatedAt": "2025-09-03T03:02:37.572Z",
      "targetId": "807a60e6-1b41-47e6-a280-b0d97d0cca44",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "86c05ac9-9a51-489c-8c1c-96a2bae30839",
      "content": "Is 45,8",
      "kind": "MARK_KIND_REFERENCE",
      "label": "12@",
      "sortOrder": 11,
      "startOffset": 36,
      "endOffset": 36,
      "createdAt": "2025-09-03T03:02:37.969Z",
