{
  "chapter": {
    "id": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a",
    "number": 61,
    "createdAt": "2025-09-03T01:07:51.737Z",
    "updatedAt": "2025-09-03T01:07:51.737Z",
    "bookId": "d17ae149-2718-48e5-b452-c522381bf71a"
  },
  "verses": [
    {
      "id": "8a67208c-495e-446f-b2df-c054a0f399f4",
      "text": "Thần khí của ĐỨC CHÚA là Chúa Thượng ngự trên tôi,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:36.978Z",
      "updatedAt": "2025-09-03T03:02:36.978Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "7fa2475e-43c8-47c1-823f-435c4f605107",
      "text": "vì ĐỨC CHÚA đã xức dầu tấn phong tôi,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.047Z",
      "updatedAt": "2025-09-03T03:02:37.047Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "5ee7742d-c8bd-47fb-a324-2f5ab179ff79",
      "text": "sai đi báo tin mừng cho kẻ nghèo hèn,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.072Z",
      "updatedAt": "2025-09-03T03:02:37.072Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "c9e593e7-b2d5-426b-84ff-97eb9fdc14db",
      "text": "băng bó những tấm lòng tan nát,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 3,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.101Z",
      "updatedAt": "2025-09-03T03:02:37.101Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "1141ffde-40d9-4761-8707-82c196234adf",
      "text": "công bố lệnh ân xá cho kẻ bị giam cầm,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 4,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.113Z",
      "updatedAt": "2025-09-03T03:02:37.113Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "293aa1f3-1784-4e04-9cc0-8a7de884e542",
      "text": "ngày phóng thích cho những tù nhân,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 5,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.124Z",
      "updatedAt": "2025-09-03T03:02:37.124Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "3f33e84a-0113-4c56-8f52-1369547a23ec",
      "text": "công bố một năm hồng ân của ĐỨC CHÚA,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.135Z",
      "updatedAt": "2025-09-03T03:02:37.135Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "741f9199-d09a-4112-9ff6-74c719846b26",
      "text": "một ngày báo phục của Thiên Chúa chúng ta ;",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.177Z",
      "updatedAt": "2025-09-03T03:02:37.177Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "fa3cd74e-4a1f-4148-adb4-df38cde54f58",
      "text": "Người sai tôi đi an ủi mọi kẻ khóc than,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.188Z",
      "updatedAt": "2025-09-03T03:02:37.188Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "181e9144-1c60-489c-959c-b2f830160bc8",
      "text": "tặng cho những kẻ khóc than ở Xi-on",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.209Z",
      "updatedAt": "2025-09-03T03:02:37.209Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "69558fb3-5588-4f43-8a9a-56bf938dddff",
      "text": "tấm khăn đại lễ thay tro bụi,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.235Z",
      "updatedAt": "2025-09-03T03:02:37.235Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "227958fd-eaf8-45c6-9fff-a85260f48bab",
      "text": "dầu thơm hoan lạc thay tang chế,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.260Z",
      "updatedAt": "2025-09-03T03:02:37.260Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "3dd02a90-5701-4879-aebe-6ff89a8fb202",
      "text": "áo ngày hội thay tâm thần sầu não.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 3,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.274Z",
      "updatedAt": "2025-09-03T03:02:37.274Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "50759c69-4117-48ea-b8f7-5697b4d61c96",
      "text": "Người ta sẽ gọi họ là cây thánh rừng thiêng,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 4,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.287Z",
      "updatedAt": "2025-09-03T03:02:37.287Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "dd926961-2bde-4277-977a-ea476878b0a8",
      "text": "là vườn cây ĐỨC CHÚA trồng để làm cho Người được vinh hiển.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 5,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.303Z",
      "updatedAt": "2025-09-03T03:02:37.303Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "4db077a6-e956-4bc9-b911-32ad09f2e1ff",
      "text": "Họ sẽ tái thiết những tàn tích cổ xưa,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.331Z",
      "updatedAt": "2025-09-03T03:02:37.331Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "a1b43e71-92c4-4dd3-a57e-489780a4ed18",
      "text": "sẽ dựng lại những hoang tàn thuở trước,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.358Z",
      "updatedAt": "2025-09-03T03:02:37.358Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "0bfdd8fa-3d07-4623-9bbf-64cfb3ade099",
      "text": "tu bổ những thành bị bỏ hoang,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.370Z",
      "updatedAt": "2025-09-03T03:02:37.370Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "0667cc41-2613-43b1-ae20-6096ac739026",
      "text": "những chốn hoang tàn từ bao thế hệ.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 3,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.381Z",
      "updatedAt": "2025-09-03T03:02:37.381Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "12e845aa-be66-4fc7-8635-563ac92a64d9",
      "text": "Người ngoại bang sẽ đứng sẵn để chăn chiên cừu cho anh em,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.392Z",
      "updatedAt": "2025-09-03T03:02:37.392Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "fd74ac08-9566-4e39-bb4f-03bd235912c6",
      "text": "con cái khách ngoại kiều sẽ cày ruộng",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.414Z",
      "updatedAt": "2025-09-03T03:02:37.414Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "9152aa9b-1e2d-4e0d-b74a-1812da620f83",
      "text": "và làm vườn nho cho anh em.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.425Z",
      "updatedAt": "2025-09-03T03:02:37.425Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "929bbcd8-e52f-4d18-93a0-1db46d7b142e",
      "text": "Còn anh em, anh em sẽ được gọi là “tư tế của ĐỨC CHÚA”,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.439Z",
      "updatedAt": "2025-09-03T03:02:37.439Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "f7478e07-04bf-42fa-b8d6-e192a542711a",
      "text": "người ta sẽ gọi anh em là “người phụng sự Thiên Chúa chúng ta.”",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.477Z",
      "updatedAt": "2025-09-03T03:02:37.477Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "a0123ce7-efce-4187-a503-5e454d878e6c",
      "text": "Của cải chư dân, anh em sẽ được dùng,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.490Z",
      "updatedAt": "2025-09-03T03:02:37.490Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "a0934eee-cb68-47a9-83ea-9e062b0603cd",
      "text": "phú quý vinh hoa của chúng, anh em sẽ được hưởng.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 3,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.507Z",
      "updatedAt": "2025-09-03T03:02:37.507Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "9cd47204-a3c6-4384-81cb-1dbe98831f5e",
      "text": "Anh em đã lãnh gấp đôi phần tủi nhục,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.519Z",
      "updatedAt": "2025-09-03T03:02:37.519Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "9866d7b5-a953-49e3-9799-ea8741c87114",
      "text": "đã chuốc vào thân sự nhục nhằn phỉ báng ;",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.545Z",
      "updatedAt": "2025-09-03T03:02:37.545Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "807a60e6-1b41-47e6-a280-b0d97d0cca44",
      "text": "bù vào đó, anh em sẽ được lãnh gấp đôi",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.560Z",
      "updatedAt": "2025-09-03T03:02:37.560Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "ee13c6d0-1f2f-41e9-b9ac-1e27f971fbae",
      "text": "phần gia nghiệp trên đất chúng, và sẽ được niềm vui vĩnh cửu.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 3,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.584Z",
      "updatedAt": "2025-09-03T03:02:37.584Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "d1a9eaa1-bddd-4236-aaf3-7f780bfd2882",
      "text": "Vì Ta, ĐỨC CHÚA, Ta chuộng lẽ công minh,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.597Z",
      "updatedAt": "2025-09-03T03:02:37.597Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "593e9a00-0be4-4cf2-bed2-5f3528cedb46",
      "text": "ghét chuyện cướp bóc gian tà, nên Ta sẽ theo lòng thành tín",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.618Z",
      "updatedAt": "2025-09-03T03:02:37.618Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "55782485-9624-4b33-8b42-d333f9cd36e0",
      "text": "mà ban phần thưởng cho các ngươi,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.639Z",
      "updatedAt": "2025-09-03T03:02:37.639Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "57a4fd8c-f4ae-4dd6-b814-e880f4ecb0b9",
      "text": "và sẽ lập với các ngươi một giao ước vĩnh cửu.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 3,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.650Z",
      "updatedAt": "2025-09-03T03:02:37.650Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "e9baba0b-43f3-4291-b992-d17540aec65e",
      "text": "Dòng dõi các ngươi sẽ nức tiếng giữa chư dân,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.673Z",
      "updatedAt": "2025-09-03T03:02:37.673Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "88ef911b-9020-4ade-a088-68eaca5e1822",
      "text": "và giống nòi các ngươi sẽ lừng danh giữa muôn nước.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.687Z",
      "updatedAt": "2025-09-03T03:02:37.687Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "55f8e011-9b60-4625-b278-af193c7c5729",
      "text": "Tất cả những ai thấy các ngươi sẽ biết rằng",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.701Z",
      "updatedAt": "2025-09-03T03:02:37.701Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "aa83aa91-91c0-46b6-8d2d-b43f3420d0dd",
      "text": "các ngươi là một dòng dõi được ĐỨC CHÚA ban phúc lành.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 3,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.729Z",
      "updatedAt": "2025-09-03T03:02:37.729Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "9d145fd8-0631-49a9-a530-084a3aa2bb1c",
      "text": "Tôi mừng rỡ muôn phần nhờ ĐỨC CHÚA,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.771Z",
      "updatedAt": "2025-09-03T03:02:37.771Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "7d34eab4-b4b5-448d-8263-644bc20eb11b",
      "text": "nhờ Thiên Chúa tôi thờ, tôi hớn hở biết bao !",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.840Z",
      "updatedAt": "2025-09-03T03:02:37.840Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "275b8834-1d36-4912-b3ae-61012033eaf1",
      "text": "Vì Người mặc cho tôi hồng ân cứu độ,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.854Z",
      "updatedAt": "2025-09-03T03:02:37.854Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "7b1cd6a6-9700-4cd1-8136-049ede0a42d8",
      "text": "choàng cho tôi đức chính trực công minh,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 3,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.867Z",
      "updatedAt": "2025-09-03T03:02:37.867Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "0a40996f-e849-479d-a271-ff274caa06ab",
      "text": "như chú rể chỉnh tề khăn áo, tựa cô dâu lộng lẫy điểm trang.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 4,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.881Z",
      "updatedAt": "2025-09-03T03:02:37.881Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "1e371582-9f6d-413d-9d7b-1633831cce9b",
      "text": "Như đất đai làm đâm chồi nẩy lộc,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.919Z",
      "updatedAt": "2025-09-03T03:02:37.919Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "4babadf7-396f-4666-9b08-a0e8825e1ddd",
      "text": "như vườn tược cho nở hạt sinh mầm,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.932Z",
      "updatedAt": "2025-09-03T03:02:37.932Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "1939b9f3-fdfb-4825-bda4-0f0dabf40a5f",
      "text": "ĐỨC CHÚA là Chúa Thượng cũng sẽ làm trổ hoa công chính,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.944Z",
      "updatedAt": "2025-09-03T03:02:37.944Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "38e54414-1afe-4eb6-b4e4-c8e7bd460e91",
      "text": "làm trổi vang lời ca ngợi trước mặt muôn dân.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 3,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:37.981Z",
      "updatedAt": "2025-09-03T03:02:37.981Z",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    }
  ],
  "marks": [
    {
      "id": "dbe26938-030c-4d2e-9527-67b07da99c03",
      "content": "Ch. 61 có nhiều giao điểm với ch. 60 về mặt từ ngữ cũng như tư tưởng. Nhưng ch. 61 đặt trọng tâm ở nhân vật ngôn sứ : tác giả khẳng định mình đã nhận thần khí để chu toàn sứ mạng (cc. 1-4), ngỏ lời với anh em của mình để tiên báo Thiên Chúa sẽ đổi vận mạng của họ (cc. 5-9), khiến môi miệng ông cất lên lời ca ngợi Thiên Chúa (cc. 10-11).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 18,
      "endOffset": 18,
      "createdAt": "2025-09-03T03:02:37.006Z",
      "updatedAt": "2025-09-03T03:02:37.006Z",
      "targetId": "dc3472d2-2867-4d7d-93fa-7e1701529052",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "9ed329d5-79b7-4d5a-bac8-69cab77d9f3a"
    },
    {
      "id": "03f8bd22-db0a-4498-8f26-e14ed3f70595",
      "content": "Is 11,2; 42,1; Mt 3,16; Lc 4,18-19",
      "kind": "MARK_KIND_REFERENCE",
      "label": "1@",
      "sortOrder": 0,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T03:02:37.037Z",
      "updatedAt": "2025-09-03T03:02:37.037Z",
      "targetId": "8a67208c-495e-446f-b2df-c054a0f399f4",
      "targetType": "MARK_TARGET_TYPE_VERSE",
