{
  "chapter": {
    "id": "1c2bd880-3d6f-4436-82b0-6ff4d9669777",
    "number": 62,
    "createdAt": "2025-09-03T01:07:51.737Z",
    "updatedAt": "2025-09-03T01:07:51.737Z",
    "bookId": "d17ae149-2718-48e5-b452-c522381bf71a"
  },
  "verses": [
    {
      "id": "3cb11ec1-2aa9-4b92-8d82-f4a5d260e085",
      "text": "Vì lòng mến Xi-on,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:43.122Z",
      "updatedAt": "2025-09-03T03:02:43.122Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "81b3196c-a878-42f9-b72b-bdc0bd17af6a",
      "text": "tôi sẽ không nín lặng,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:43.192Z",
      "updatedAt": "2025-09-03T03:02:43.192Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "4d6979b3-8c8a-4b32-a6b9-5163df57f3eb",
      "text": "vì lòng mến Giê-ru-sa-lem,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:43.222Z",
      "updatedAt": "2025-09-03T03:02:43.222Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "3eb6d0fd-9236-48ab-8243-d560d7befa6a",
      "text": "tôi nghỉ yên sao đành,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 3,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:43.249Z",
      "updatedAt": "2025-09-03T03:02:43.249Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "66307738-bc26-4e54-be8c-41ac785ef957",
      "text": "tới ngày đức công chính",
      "label": "1",
      "number": 1,
      "subVerseIndex": 4,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:43.263Z",
      "updatedAt": "2025-09-03T03:02:43.263Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "b914f260-6d18-4436-9a4a-018d3ffcb67f",
      "text": "xuất hiện tựa hừng đông,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 5,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:43.278Z",
      "updatedAt": "2025-09-03T03:02:43.278Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "e808ab28-c263-4d89-b208-60f4a0f5bd0f",
      "text": "ơn cứu độ của thành",
      "label": "1",
      "number": 1,
      "subVerseIndex": 6,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:43.292Z",
      "updatedAt": "2025-09-03T03:02:43.292Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "976f594b-405c-42bf-b69b-00e7d12056ab",
      "text": "rực lên như ngọn đuốc.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 7,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:43.306Z",
      "updatedAt": "2025-09-03T03:02:43.306Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "671abc21-b0fe-4d10-bb08-7c76df1d4b87",
      "text": "Rồi muôn dân sẽ được chiêm ngưỡng đức công chính của ngươi,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:43.320Z",
      "updatedAt": "2025-09-03T03:02:43.320Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "dfb3290c-f4b0-419d-89dd-774da77ccdc2",
      "text": "mọi đế vương sẽ được ngắm nhìn vinh quang ngươi tỏ rạng.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:43.334Z",
      "updatedAt": "2025-09-03T03:02:43.334Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "20b303dc-ec12-491b-ad61-a4446962b703",
      "text": "Người ta sẽ gọi ngươi bằng tên mới,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:43.348Z",
      "updatedAt": "2025-09-03T03:02:43.348Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "1d4ee0c0-21c0-4d61-8e36-1414a967ab9d",
      "text": "chính là tên miệng ĐỨC CHÚA đặt cho.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 3,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:43.375Z",
      "updatedAt": "2025-09-03T03:02:43.375Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "73902b26-94a4-425a-9b40-4577dca5083d",
      "text": "Ngươi sẽ là ngọc miện huy hoàng trong lòng bàn tay ĐỨC CHÚA,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:43.401Z",
      "updatedAt": "2025-09-03T03:02:43.401Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "2e7af045-cbd9-40ee-a7bd-100518bc37c8",
      "text": "sẽ là mũ triều thiên vương giả Thiên Chúa ngươi cầm ở tay.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:43.432Z",
      "updatedAt": "2025-09-03T03:02:43.432Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "6169603d-091b-4d23-9e63-2773030cb8be",
      "text": "Chẳng ai còn réo tên ngươi :",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:43.445Z",
      "updatedAt": "2025-09-03T03:02:43.445Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "260ed011-86af-4cde-add6-bf2bd08bd246",
      "text": "“Đồ bị ruồng bỏ !”",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:43.459Z",
      "updatedAt": "2025-09-03T03:02:43.459Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "a97b83df-7dc5-441f-a976-f40ad442c06d",
      "text": "Xứ sở ngươi hết bị tiếng",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:43.489Z",
      "updatedAt": "2025-09-03T03:02:43.489Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "7317f8d1-fa6b-4a8d-bcef-76bcb6807747",
      "text": "là “Phận bạc duyên đơn.”",
      "label": "4",
      "number": 4,
      "subVerseIndex": 3,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:43.503Z",
      "updatedAt": "2025-09-03T03:02:43.503Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "db8f4b1d-09b9-4115-93ca-ddd7650457d8",
      "text": "Nhưng ngươi được gọi :",
      "label": "4",
      "number": 4,
      "subVerseIndex": 4,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:43.517Z",
      "updatedAt": "2025-09-03T03:02:43.517Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "e93090ad-2ffb-457e-ba2a-4d00b0f86975",
      "text": "“Ái khanh lòng Ta hỡi !”",
      "label": "4",
      "number": 4,
      "subVerseIndex": 5,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:43.545Z",
      "updatedAt": "2025-09-03T03:02:43.545Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "a3898e58-c741-4eaa-8147-1e5435f6f2fa",
      "text": "Xứ sở ngươi nức tiếng",
      "label": "4",
      "number": 4,
      "subVerseIndex": 6,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:43.559Z",
      "updatedAt": "2025-09-03T03:02:43.559Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "21a2af50-828b-4a9d-b2aa-83644ded190a",
      "text": "là “Duyên thắm chỉ hồng.”",
      "label": "4",
      "number": 4,
      "subVerseIndex": 7,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:43.573Z",
      "updatedAt": "2025-09-03T03:02:43.573Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "fe98948a-f6d6-4100-acac-ac5b07c84c07",
      "text": "Vì ngươi sẽ được ĐỨC CHÚA đem lòng sủng ái,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 8,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:43.604Z",
      "updatedAt": "2025-09-03T03:02:43.604Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "cbb719e3-61d9-4342-947b-cc1f3ec5eb79",
      "text": "và Chúa lập hôn ước cùng xứ sở ngươi.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 9,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:43.632Z",
      "updatedAt": "2025-09-03T03:02:43.632Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "96ad3699-4cc9-4de1-9e3e-aefc78bedc02",
      "text": "Như tài trai sánh duyên cùng thục nữ,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:43.645Z",
      "updatedAt": "2025-09-03T03:02:43.645Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "20ec167e-8333-422a-ae39-458d496a7954",
      "text": "Đấng tác tạo ngươi sẽ cưới ngươi về.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:43.674Z",
      "updatedAt": "2025-09-03T03:02:43.674Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "1a7285af-b4d9-4fab-b5fd-39e6fb0acb81",
      "text": "Như cô dâu là niềm vui cho chú rể,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:43.705Z",
      "updatedAt": "2025-09-03T03:02:43.705Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "354f612d-4068-4870-9b5c-c713d4d71c53",
      "text": "ngươi cũng là niềm vui cho Thiên Chúa ngươi thờ.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 3,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:43.735Z",
      "updatedAt": "2025-09-03T03:02:43.735Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "0dd8a97d-4ce1-48dd-becd-e4b91c1cfc7d",
      "text": "Giê-ru-sa-lem hỡi, trên tường thành ngươi,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:43.749Z",
      "updatedAt": "2025-09-03T03:02:43.749Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "80b68d38-1518-4e76-8bc3-fd35ebd914a1",
      "text": "Ta đã đặt lính gác,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:43.778Z",
      "updatedAt": "2025-09-03T03:02:43.778Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "23f35f67-be1c-4f91-9e9e-687d4d199498",
      "text": "suốt ngày đêm, chúng sẽ chẳng bao giờ nín lặng.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:43.805Z",
      "updatedAt": "2025-09-03T03:02:43.805Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "c4b74a29-fc91-4881-90ad-d386289b2333",
      "text": "Hỡi những người có phận sự nhắc nhở ĐỨC CHÚA,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 3,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:43.819Z",
      "updatedAt": "2025-09-03T03:02:43.819Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "7e507853-09fc-4b21-8c0c-e0ef4cb84e17",
      "text": "anh em đừng nghỉ ngơi.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 4,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:43.861Z",
      "updatedAt": "2025-09-03T03:02:43.861Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "3f39feb6-c8de-4184-8a32-3fe9fa5e3132",
      "text": "Cũng đừng để ĐỨC CHÚA nghỉ ngơi bao lâu Người chưa tái lập,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:43.875Z",
      "updatedAt": "2025-09-03T03:02:43.875Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "92cefff6-ef8f-4be9-9d5f-9348583504ed",
      "text": "chưa đặt Giê-ru-sa-lem làm lời khen ngợi trên khắp địa cầu.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:43.905Z",
      "updatedAt": "2025-09-03T03:02:43.905Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "55a3e343-ad62-44c4-bdbe-97a3a7c4b223",
      "text": "ĐỨC CHÚA đã giơ cánh tay hữu",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:43.933Z",
      "updatedAt": "2025-09-03T03:02:43.933Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "1ed3c6c2-d2b6-4fd5-b2b6-f47142d18baf",
      "text": "và giơ cánh tay mạnh mẽ của Người mà thề :",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:43.964Z",
      "updatedAt": "2025-09-03T03:02:43.964Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "44fb8b95-ec41-458b-8185-088136b5c577",
      "text": "“Ta sẽ không đem lúa mì của ngươi",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:43.978Z",
      "updatedAt": "2025-09-03T03:02:43.978Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "ea3925c3-5cf4-4020-a8c3-6fb08c1a9bc4",
      "text": "làm lương thực cho kẻ thù ngươi nữa,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 3,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:44.006Z",
      "updatedAt": "2025-09-03T03:02:44.006Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "4c998eda-bcb5-41eb-bfdd-315096a8776d",
      "text": "ngoại kiều cũng sẽ không được uống rượu mới của ngươi,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 4,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:44.020Z",
      "updatedAt": "2025-09-03T03:02:44.020Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "0ae8473f-8b64-429a-8597-604db2ec5d0b",
      "text": "thứ rượu ngươi đã vất vả mới làm ra được.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 5,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:44.035Z",
      "updatedAt": "2025-09-03T03:02:44.035Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "32278a75-403d-4ce1-b8db-cba6f3181072",
      "text": "Nhưng những người gặt lúa mì sẽ được ăn",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:44.050Z",
      "updatedAt": "2025-09-03T03:02:44.050Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "a99e2eb5-e6f2-4b4d-9b28-c62a3cc5e2a4",
      "text": "và sẽ ca tụng ĐỨC CHÚA,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:44.064Z",
      "updatedAt": "2025-09-03T03:02:44.064Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "19494c52-0e88-4b8e-9d1f-da51954cf6b5",
      "text": "những kẻ hái nho sẽ được uống rượu",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:44.092Z",
      "updatedAt": "2025-09-03T03:02:44.092Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "f02b5721-d315-458d-b1fa-5a3a46748980",
      "text": "tại tiền đình thánh điện của Ta.”",
      "label": "9",
      "number": 9,
      "subVerseIndex": 3,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:44.105Z",
      "updatedAt": "2025-09-03T03:02:44.105Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "a9a43d93-1859-42a7-841e-e27da1b4be02",
      "text": "Hãy bước qua, hãy bước qua các cửa thành,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:44.119Z",
      "updatedAt": "2025-09-03T03:02:44.119Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "1d615498-0f78-4c02-8ea7-84d97f8d38c4",
      "text": "hãy mở con đường cho dân,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:44.159Z",
      "updatedAt": "2025-09-03T03:02:44.159Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "2d4725a1-1138-44c5-bf0d-098ffd450597",
      "text": "hãy dọn đường, hãy dọn đường, hãy nhặt cho hết đá.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:44.189Z",
      "updatedAt": "2025-09-03T03:02:44.189Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "6804f9b2-65eb-435a-aa6f-707b1b350c3f",
      "text": "Hãy phất cờ ra hiệu cho các dân.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 3,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:44.203Z",
      "updatedAt": "2025-09-03T03:02:44.203Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "b7ecf312-ef03-44c3-93c4-50c135ea39c6",
      "text": "Đây là lời ĐỨC CHÚA loan truyền cho khắp cùng cõi đất :",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:44.230Z",
      "updatedAt": "2025-09-03T03:02:44.230Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "1739d518-79f5-4ae5-aa02-4568e99c2178",
      "text": "Hãy nói với thiếu nữ Xi-on : Kìa ơn cứu độ ngươi đang tới.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:44.258Z",
      "updatedAt": "2025-09-03T03:02:44.258Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "01e95ff6-8303-44c7-99dd-ac063ef15095",
      "text": "Kìa phần thưởng của Người theo sát một bên,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:44.315Z",
      "updatedAt": "2025-09-03T03:02:44.315Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "e4f603f0-2c93-41ac-99c3-431fac76ae4c",
      "text": "và thành tích đi ngay trước mặt.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 3,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:44.339Z",
      "updatedAt": "2025-09-03T03:02:44.339Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "27c3b1a1-0f23-4326-beca-01aeac846982",
      "text": "Chúng sẽ được gọi là “dân thánh”,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:44.350Z",
      "updatedAt": "2025-09-03T03:02:44.350Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "e153b37d-0561-4483-b130-db44060fa349",
      "text": "là “những người được ĐỨC CHÚA cứu chuộc”.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:44.370Z",
      "updatedAt": "2025-09-03T03:02:44.370Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "ca478ef0-8c1b-441c-8f16-59ce5be45251",
      "text": "Còn ngươi sẽ được gọi là “Cô gái đắt chồng”,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:44.390Z",
      "updatedAt": "2025-09-03T03:02:44.390Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    },
    {
      "id": "d4b451ad-928e-40dc-a63b-9d8a0f448e7e",
      "text": "là “Thành không bị bỏ”.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 3,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:44.402Z",
      "updatedAt": "2025-09-03T03:02:44.402Z",
      "chapterId": "1c2bd880-3d6f-4436-82b0-6ff4d9669777"
    }
  ],
