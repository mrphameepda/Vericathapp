    },
    {
      "id": "b5c44907-6e25-430c-82db-d70661d867a1",
      "content": "1 Cr 2,9+",
      "kind": "MARK_KIND_REFERENCE",
      "label": "1@",
      "sortOrder": 0,
      "startOffset": 9,
