{
  "chapter": {
    "id": "86060296-8a50-4423-99fa-8586e966951d",
    "number": 64,
    "createdAt": "2025-09-03T01:07:51.737Z",
    "updatedAt": "2025-09-03T01:07:51.737Z",
    "bookId": "d17ae149-2718-48e5-b452-c522381bf71a"
  },
  "verses": [
    {
      "id": "38db259a-aef4-4622-a1f8-ffecdf655510",
      "text": "như lửa đốt củi khô, như lửa làm cho nước sôi sùng sục !",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:56.726Z",
      "updatedAt": "2025-09-03T03:02:56.726Z",
      "chapterId": "86060296-8a50-4423-99fa-8586e966951d"
    },
    {
      "id": "ae824700-fb90-4b53-8bac-762fe9c905ff",
      "text": "Ngài sẽ khiến cho thù địch Ngài nhận biết Thánh Danh,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:56.745Z",
      "updatedAt": "2025-09-03T03:02:56.745Z",
      "chapterId": "86060296-8a50-4423-99fa-8586e966951d"
    },
    {
      "id": "6209c5da-dbfd-4938-9813-acdde571bca7",
      "text": "chư dân sẽ run rẩy trước nhan Ngài,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:56.757Z",
      "updatedAt": "2025-09-03T03:02:56.757Z",
      "chapterId": "86060296-8a50-4423-99fa-8586e966951d"
    },
    {
      "id": "3b4f3675-2fe3-40c7-9407-7008e96cc6a8",
      "text": "khi thấy Ngài làm những điều kinh hồn táng đởm",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:56.771Z",
      "updatedAt": "2025-09-03T03:02:56.771Z",
      "chapterId": "86060296-8a50-4423-99fa-8586e966951d"
    },
    {
      "id": "341b3a6b-0c5a-4294-aeb8-0183953169ac",
      "text": "mà chúng con không ngờ :",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:56.783Z",
      "updatedAt": "2025-09-03T03:02:56.783Z",
      "chapterId": "86060296-8a50-4423-99fa-8586e966951d"
    },
    {
      "id": "3f35b1e7-0281-4d9a-9a4b-5ad88c34aaaf",
      "text": "Ngài ngự xuống : và núi non rung chuyển trước Thánh Nhan !",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:56.794Z",
      "updatedAt": "2025-09-03T03:02:56.794Z",
      "chapterId": "86060296-8a50-4423-99fa-8586e966951d"
    },
    {
      "id": "31ab4882-fb88-4d17-a747-68685911467a",
      "text": "Người ta chưa nghe nói đến bao giờ,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:56.816Z",
      "updatedAt": "2025-09-03T03:02:56.816Z",
      "chapterId": "86060296-8a50-4423-99fa-8586e966951d"
    },
    {
      "id": "15701516-26b5-4c2f-8639-8a09b39eff4f",
      "text": "tai chưa hề nghe, mắt chưa hề thấy",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:56.836Z",
      "updatedAt": "2025-09-03T03:02:56.836Z",
      "chapterId": "86060296-8a50-4423-99fa-8586e966951d"
    },
    {
      "id": "ba5c4b54-1058-49c3-a23e-0d348c1ceb0e",
      "text": "có vị thần nào, ngoài Chúa ra,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:56.858Z",
      "updatedAt": "2025-09-03T03:02:56.858Z",
      "chapterId": "86060296-8a50-4423-99fa-8586e966951d"
    },
    {
      "id": "618aa844-3d16-4d8c-bcc7-9001fbaf390e",
      "text": "đã hành động như thế đối với ai tin cậy nơi mình.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 3,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:56.869Z",
      "updatedAt": "2025-09-03T03:02:56.869Z",
      "chapterId": "86060296-8a50-4423-99fa-8586e966951d"
    },
    {
      "id": "7d6342c9-13cf-45a2-812b-3020c42c74a4",
      "text": "Ngài đón gặp kẻ sống đời công chính mà lấy làm vui",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:56.879Z",
      "updatedAt": "2025-09-03T03:02:56.879Z",
      "chapterId": "86060296-8a50-4423-99fa-8586e966951d"
    },
    {
      "id": "1e1588f0-8a29-4677-8d9c-dda659b0f9cf",
      "text": "và nhớ đến Ngài khi theo đường lối Ngài chỉ dạy.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:56.899Z",
      "updatedAt": "2025-09-03T03:02:56.899Z",
      "chapterId": "86060296-8a50-4423-99fa-8586e966951d"
    },
    {
      "id": "7385bdba-dcda-4d8d-be75-6ba3c42ad55e",
      "text": "Kìa, Ngài phẫn nộ vì tội lỗi chúng con,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:56.913Z",
      "updatedAt": "2025-09-03T03:02:56.913Z",
      "chapterId": "86060296-8a50-4423-99fa-8586e966951d"
    },
    {
      "id": "a3648302-be2b-463f-a6d0-a6d00d209a49",
      "text": "nhưng khi mải đi theo các đường lối của Ngài,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 3,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:56.923Z",
      "updatedAt": "2025-09-03T03:02:56.923Z",
      "chapterId": "86060296-8a50-4423-99fa-8586e966951d"
    },
    {
      "id": "fd8ff8ca-07a7-46fd-a0fd-44d3f4e54f23",
      "text": "chúng con sẽ được cứu thoát.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 4,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:56.933Z",
      "updatedAt": "2025-09-03T03:02:56.933Z",
      "chapterId": "86060296-8a50-4423-99fa-8586e966951d"
    },
    {
      "id": "d1731219-426d-4f45-ba5c-dfa626791266",
      "text": "Tất cả chúng con đã trở nên như người nhiễm uế,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:56.948Z",
      "updatedAt": "2025-09-03T03:02:56.948Z",
      "chapterId": "86060296-8a50-4423-99fa-8586e966951d"
    },
    {
      "id": "d28ac760-6122-416c-8f40-5378bc062845",
      "text": "mọi việc lành của chúng con khác nào chiếc áo dơ.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:56.958Z",
      "updatedAt": "2025-09-03T03:02:56.958Z",
      "chapterId": "86060296-8a50-4423-99fa-8586e966951d"
    },
    {
      "id": "d19dce0f-4144-436c-ad06-57f22ad6a24f",
      "text": "Tất cả chúng con héo tàn như lá úa,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:56.981Z",
      "updatedAt": "2025-09-03T03:02:56.981Z",
      "chapterId": "86060296-8a50-4423-99fa-8586e966951d"
    },
    {
      "id": "bb715538-4672-4a63-b9d7-ccbe1c17cc1d",
      "text": "và tội ác chúng con đã phạm, tựa cơn gió, cuốn chúng con đi.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 3,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:56.991Z",
      "updatedAt": "2025-09-03T03:02:56.991Z",
      "chapterId": "86060296-8a50-4423-99fa-8586e966951d"
    },
    {
      "id": "93d61c68-fdfb-4458-bda9-0af784f70168",
      "text": "Không có ai cầu khẩn danh Chúa,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:57.001Z",
      "updatedAt": "2025-09-03T03:02:57.001Z",
      "chapterId": "86060296-8a50-4423-99fa-8586e966951d"
    },
    {
      "id": "b991cd8f-fd9e-4459-a6d6-4330180d5dd4",
      "text": "cũng chẳng ai tỉnh dậy mà níu lấy Ngài,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:57.011Z",
      "updatedAt": "2025-09-03T03:02:57.011Z",
      "chapterId": "86060296-8a50-4423-99fa-8586e966951d"
    },
    {
      "id": "417db1a4-655d-4bca-a1e3-21e4cc5ca15b",
      "text": "vì Ngài đã ngoảnh mặt không nhìn đến,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:57.021Z",
      "updatedAt": "2025-09-03T03:02:57.021Z",
      "chapterId": "86060296-8a50-4423-99fa-8586e966951d"
    },
    {
      "id": "53fd16b4-3137-4a6a-bea3-e3d562c5b6f7",
      "text": "và để cho tội ác chúng con phạm mặc sức hành hạ chúng con.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 3,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:57.031Z",
      "updatedAt": "2025-09-03T03:02:57.031Z",
      "chapterId": "86060296-8a50-4423-99fa-8586e966951d"
    },
    {
      "id": "956ea0ec-7d17-448c-8357-043760d6d9ce",
      "text": "Thế nhưng, lạy ĐỨC CHÚA, Ngài là Cha chúng con ;",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:57.055Z",
      "updatedAt": "2025-09-03T03:02:57.055Z",
      "chapterId": "86060296-8a50-4423-99fa-8586e966951d"
    },
    {
      "id": "416d11fe-38db-4d87-948c-c4a308421181",
      "text": "chúng con là đất sét, còn thợ gốm là Ngài,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:57.075Z",
      "updatedAt": "2025-09-03T03:02:57.075Z",
      "chapterId": "86060296-8a50-4423-99fa-8586e966951d"
    },
    {
      "id": "52ef988e-9ac8-4232-bf9b-f2ceddbd4ff5",
      "text": "chính tay Ngài đã làm ra tất cả chúng con.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:57.103Z",
      "updatedAt": "2025-09-03T03:02:57.103Z",
      "chapterId": "86060296-8a50-4423-99fa-8586e966951d"
    },
    {
      "id": "222376da-f39e-469b-91fd-c5f8724c92ea",
      "text": "Lạy ĐỨC CHÚA, xin đừng quá phẫn nộ,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:57.125Z",
      "updatedAt": "2025-09-03T03:02:57.125Z",
      "chapterId": "86060296-8a50-4423-99fa-8586e966951d"
    },
    {
      "id": "3f716ffd-e83d-4984-aa59-bab730722a8e",
      "text": "đừng nhớ mãi tội ác chúng con.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:57.145Z",
      "updatedAt": "2025-09-03T03:02:57.145Z",
      "chapterId": "86060296-8a50-4423-99fa-8586e966951d"
    },
    {
      "id": "953d886d-f237-4e57-b953-9e67fc5e8098",
      "text": "Cúi xin Ngài nhìn đến : chúng con tất cả đều là dân của Ngài.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:57.160Z",
      "updatedAt": "2025-09-03T03:02:57.160Z",
      "chapterId": "86060296-8a50-4423-99fa-8586e966951d"
    },
    {
      "id": "46759ba6-2cfc-43ff-80f4-9d3acf74ed6d",
      "text": "Các thành thánh của Ngài đã trở nên sa mạc,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:57.170Z",
      "updatedAt": "2025-09-03T03:02:57.170Z",
      "chapterId": "86060296-8a50-4423-99fa-8586e966951d"
    },
    {
      "id": "f13ee788-2141-4196-919c-84f313c7b65d",
      "text": "Xi-on đã trở nên sa mạc, Giê-ru-sa-lem thành chốn hoang tàn.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:57.180Z",
      "updatedAt": "2025-09-03T03:02:57.180Z",
      "chapterId": "86060296-8a50-4423-99fa-8586e966951d"
    },
    {
      "id": "cb05b830-c6d2-4ace-99a7-15709db8b649",
      "text": "Ngôi nhà thánh và vinh hiển của chúng con,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:57.212Z",
      "updatedAt": "2025-09-03T03:02:57.212Z",
      "chapterId": "86060296-8a50-4423-99fa-8586e966951d"
    },
    {
      "id": "0e1d2889-6fc8-4444-8faf-3a7e18b873b0",
      "text": "là nơi cha ông chúng con ca tụng Ngài, đã làm mồi cho lửa,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:57.233Z",
      "updatedAt": "2025-09-03T03:02:57.233Z",
      "chapterId": "86060296-8a50-4423-99fa-8586e966951d"
    },
    {
      "id": "2a7277ea-197b-43a3-a2b6-a936eabea1b4",
      "text": "và tất cả những gì chúng con quý nhất đã bị tàn phá.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:57.243Z",
      "updatedAt": "2025-09-03T03:02:57.243Z",
      "chapterId": "86060296-8a50-4423-99fa-8586e966951d"
    },
    {
      "id": "f523905a-0920-4427-8cdb-bac873df8811",
      "text": "Lạy ĐỨC CHÚA, trước cảnh tượng đó, Ngài dằn lòng được sao ?",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:57.253Z",
      "updatedAt": "2025-09-03T03:02:57.253Z",
      "chapterId": "86060296-8a50-4423-99fa-8586e966951d"
    },
    {
      "id": "2d775e92-1e84-4edb-9eb4-cac2617379ac",
      "text": "Ngài đành nín lặng, để chúng con khổ nhục ê chề ?",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T03:02:57.283Z",
      "updatedAt": "2025-09-03T03:02:57.283Z",
      "chapterId": "86060296-8a50-4423-99fa-8586e966951d"
    }
  ],
  "marks": [
    {
