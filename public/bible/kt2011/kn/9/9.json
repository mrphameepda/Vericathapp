    {
      "id": "1c6df149-65ed-4655-a496-4876de2bb39f",
      "content": "Kn 9,4",
      "kind": "MARK_KIND_REFERENCE",
      "label": "7@",
      "sortOrder": 6,
      "startOffset": 17,
      "endOffset": 17,
      "createdAt": "2025-09-03T02:47:03.134Z",
      "updatedAt": "2025-09-03T02:47:03.134Z",
      "targetId": "466badd8-75c1-4945-8c29-143a10055987",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "224fb769-8014-466e-bc49-af3d78fa058e",
      "content": "*Quyền năng vinh hiển*, ds : *vinh quang*. Vinh quang ở đây hiểu là sức mạnh, quyền năng (x. Rm 6,4). Hoặc có thể dịch : *Đức Khôn Ngoan sẽ gìn giữ con trong vinh quang của Đức Khôn Ngoan* bằng cách dẫn dắt con theo ánh sáng của Đức Khôn Ngoan (x. Is 60,1-3 ; Br 5,7.9), hoặc bằng cách bao bọc con bằng một đám mây che chở (x. Hc 14,27).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "7",
      "sortOrder": 6,
      "startOffset": 39,
      "endOffset": 39,
      "createdAt": "2025-09-03T02:47:03.343Z",
      "updatedAt": "2025-09-03T02:47:03.343Z",
      "targetId": "46518996-adee-42dd-a9a8-9ad1c263c7e3",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "526943f7-2528-488f-95b2-3b52f3f4126e",
      "content": "Kn 8,4",
      "kind": "MARK_KIND_REFERENCE",
      "label": "8@",
      "sortOrder": 7,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:47:03.162Z",
      "updatedAt": "2025-09-03T02:47:03.162Z",
      "targetId": "0f6614f0-dc17-4750-b6a6-17f15849a4b6",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "450f173b-6c27-44cc-950d-b7b4d0d117b3",
      "content": "Từ ngữ được dùng trong câu này nhắc đến sự đối chọi, trong triết học Hy-lạp, giữa thân xác với linh hồn hoặc tâm trí (x. Rm 7,25). Tuy nhiên, tác giả coi việc linh hồn kết hợp với thân xác là chuyện bình thường, không hề có vấn đề thân xác là nhà tù cầm giữ linh hồn (x. 1,4 ; 8,19-20 ; 15,8.11.16 ; 16,14). Trong Cựu Ước, hình ảnh *cái lều* nói lên tính cách mau qua của cuộc sống con người (x. G 4,21 ; Is 33,20 ; 38,12). *Bằng đất* có thể nhắc đến G 4,19 hoặc St 2,7. Trong Tân Ước, x. 2 Cr 4,7 ; 5,1-4 ; 2 Pr 1,13-14 và cả Ga 5,17 ; Rm 7,14-15.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "8",
      "sortOrder": 7,
      "startOffset": 18,
      "endOffset": 18,
      "createdAt": "2025-09-03T02:47:03.530Z",
      "updatedAt": "2025-09-03T02:47:03.530Z",
      "targetId": "a9af9fd7-3938-4c82-8671-1d09fe00c643",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "5e0ce112-e9a0-44c4-b702-60051bc11391",
      "content": "Kn 7,21; Cn 8,22-31 tđ",
      "kind": "MARK_KIND_REFERENCE",
      "label": "9@",
      "sortOrder": 8,
      "startOffset": 19,
      "endOffset": 19,
      "createdAt": "2025-09-03T02:47:03.190Z",
      "updatedAt": "2025-09-03T02:47:03.190Z",
      "targetId": "81bf5bc0-84aa-4209-84cb-cbabde2e1667",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "8c2bc336-e3d3-4bbd-88e2-ee0568ee8087",
      "content": "Được cứu khỏi những hiểm nguy ở đời này hoặc trong đời sống thiêng liêng. Tác giả dùng lời khẳng định này để kết thúc lời cầu nguyện của vua Sa-lô-môn và cũng là để chuyển sang phần thứ ba. Trong phần thứ ba này, lời xác quyết của tác giả được chứng minh một cách cụ thể bằng lịch sử của Ít-ra-en.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "9",
      "sortOrder": 8,
      "startOffset": 36,
      "endOffset": 36,
      "createdAt": "2025-09-03T02:47:03.796Z",
      "updatedAt": "2025-09-03T02:47:03.796Z",
      "targetId": "a8d8c5d4-ab7d-4ce9-9477-754f3894d26e",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
