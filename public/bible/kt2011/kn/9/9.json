{
  "chapter": {
    "id": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962",
    "number": 9,
    "createdAt": "2025-09-03T01:07:51.693Z",
    "updatedAt": "2025-09-03T01:07:51.693Z",
    "bookId": "d8356a68-639d-4913-ba19-8694b046325c"
  },
  "verses": [
    {
      "id": "51d1e1bb-4e9c-4b2d-b684-8520301fae98",
      "text": "“Lạy Thượng Đế của bậc tổ tiên,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:02.580Z",
      "updatedAt": "2025-09-03T02:47:02.580Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "db4a8995-93a8-4e17-a192-d919b1319b5a",
      "text": "lạy Đức Chúa từ bi lân tuất,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:02.642Z",
      "updatedAt": "2025-09-03T02:47:02.642Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "04d77070-7cc5-4744-b6d5-0c65cf02fded",
      "text": "Chúa dùng lời Chúa mà tác thành vạn vật,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:02.655Z",
      "updatedAt": "2025-09-03T02:47:02.655Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "4d713747-5d70-4821-8f42-3602f92acf43",
      "text": "dùng sự khôn ngoan Chúa mà cấu tạo con người,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:02.684Z",
      "updatedAt": "2025-09-03T02:47:02.684Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "429b0f38-c646-4fbd-9335-a97fec503db6",
      "text": "để con người làm chủ mọi loài Chúa dựng nên,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:02.698Z",
      "updatedAt": "2025-09-03T02:47:02.698Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "276ae49c-240d-44bd-ae59-bd727c162f16",
      "text": "và sống sao cho thánh thiện công chính",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:02.726Z",
      "updatedAt": "2025-09-03T02:47:02.726Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "08ebe02b-e85c-4f3e-864a-098c3a1d90f4",
      "text": "mà chỉ huy cả vũ trụ này,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:02.739Z",
      "updatedAt": "2025-09-03T02:47:02.739Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "9d769f3a-dd35-40c5-a767-fc7238fb04ed",
      "text": "cùng được một tâm hồn ngay thẳng",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:02.754Z",
      "updatedAt": "2025-09-03T02:47:02.754Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "8b81b5c8-9ff5-4cad-85ed-08bcf4633b18",
      "text": "mà phân biệt phải trái.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 3,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:02.768Z",
      "updatedAt": "2025-09-03T02:47:02.768Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "5e8195ea-1d10-4617-91d6-0c2229892530",
      "text": "Xin rộng ban cho con",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:02.782Z",
      "updatedAt": "2025-09-03T02:47:02.782Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "08a258ea-44ec-42fc-9b98-dd4df7f1587e",
      "text": "Đức Khôn Ngoan hằng ngự bên toà Chúa.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:02.810Z",
      "updatedAt": "2025-09-03T02:47:02.810Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "f3cf08ee-09a9-473a-a585-012140bfe6f3",
      "text": "Xin đừng đuổi con đi mà chẳng nhận làm con.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:02.838Z",
      "updatedAt": "2025-09-03T02:47:02.838Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "0e3a96d1-0f68-45c4-ac17-d8d88b6d0921",
      "text": "Vì thân này là tôi tớ, con của nữ tỳ Ngài,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:02.866Z",
      "updatedAt": "2025-09-03T02:47:02.866Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "0a90d111-5f68-4201-b5b2-9d930aed6aa0",
      "text": "số phận mỏng manh, cuộc đời vắn vỏi,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:02.890Z",
      "updatedAt": "2025-09-03T02:47:02.890Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "5fbda9c7-8e9c-42dd-baed-d7d0dd0686fd",
      "text": "việc pháp đình lề luật, con bé bỏng hiểu chi !",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:02.909Z",
      "updatedAt": "2025-09-03T02:47:02.909Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "15acd64c-e28f-40ee-ae64-31a33742d5f9",
      "text": "Quả thế, con người ta dẫu thập toàn đi nữa",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:02.922Z",
      "updatedAt": "2025-09-03T02:47:02.922Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "e00d5525-8332-4041-929d-05656998a28a",
      "text": "mà chẳng có Đức Khôn Ngoan của Ngài,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:02.935Z",
      "updatedAt": "2025-09-03T02:47:02.935Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "d6b73f9c-c0ce-4db7-8810-e36eec0e31c7",
      "text": "thì cũng kể bằng không không vậy.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:02.950Z",
      "updatedAt": "2025-09-03T02:47:02.950Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "4941a859-57e7-4043-b86f-ce24977dcba0",
      "text": "Nhưng chính Chúa lại tuyển chọn con",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:02.964Z",
      "updatedAt": "2025-09-03T02:47:02.964Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "caef797e-39f0-4816-bb34-dd9e3b28f9da",
      "text": "làm vua của dân Ngài,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:02.993Z",
      "updatedAt": "2025-09-03T02:47:02.993Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "c593e1df-ef08-433d-8aad-f59af4d1ca67",
      "text": "và làm người xét xử con trai con gái của Ngài.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:03.006Z",
      "updatedAt": "2025-09-03T02:47:03.006Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "342145d1-21da-4965-bb15-1f64767cdef5",
      "text": "Cũng chính Chúa dạy con",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:03.020Z",
      "updatedAt": "2025-09-03T02:47:03.020Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "bff8b809-0eb3-4d89-a24a-906bb6bdba4a",
      "text": "xây một đền thờ trên núi thánh của Ngài,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:03.034Z",
      "updatedAt": "2025-09-03T02:47:03.034Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "795e44d0-ca3c-4add-8d72-b759023f9d9c",
      "text": "và xây một bàn thờ trong thành Ngài ngự,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:03.077Z",
      "updatedAt": "2025-09-03T02:47:03.077Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "a331662d-7f01-436c-aa86-df469574b3df",
      "text": "theo như mẫu lều thánh",
      "label": "8",
      "number": 8,
      "subVerseIndex": 3,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:03.091Z",
      "updatedAt": "2025-09-03T02:47:03.091Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "306eab2b-2737-42cf-af9b-784d070763c2",
      "text": "Ngài chỉ vẽ cho từ thuở ban đầu.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 4,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:03.105Z",
      "updatedAt": "2025-09-03T02:47:03.105Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "466badd8-75c1-4945-8c29-143a10055987",
      "text": "Đức Khôn Ngoan ở kề bên Chúa,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:03.120Z",
      "updatedAt": "2025-09-03T02:47:03.120Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "0f6614f0-dc17-4750-b6a6-17f15849a4b6",
      "text": "biết những việc Chúa làm,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:03.148Z",
      "updatedAt": "2025-09-03T02:47:03.148Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "81bf5bc0-84aa-4209-84cb-cbabde2e1667",
      "text": "hiện diện khi Ngài tạo thành vũ trụ,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:03.176Z",
      "updatedAt": "2025-09-03T02:47:03.176Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "ad553118-61b3-4668-b5ec-3e9bbb00d78a",
      "text": "biết rõ những gì đẹp mắt Chúa và phù hợp với huấn lệnh của Ngài.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 3,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:03.204Z",
      "updatedAt": "2025-09-03T02:47:03.204Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "d0206354-0a7a-4168-8d6d-b1ee1242d419",
      "text": "Tự cõi trời thánh thiêng Chúa ngự,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:03.219Z",
      "updatedAt": "2025-09-03T02:47:03.219Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "758fbf44-07aa-460a-9f6f-142e68e5e47a",
      "text": "xin gửi Đức Khôn Ngoan Ngài tới,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:03.232Z",
      "updatedAt": "2025-09-03T02:47:03.232Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "195821b9-ac1c-4e40-a962-69c13328e528",
      "text": "xin phái đến từ toà cao vinh hiển,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:03.246Z",
      "updatedAt": "2025-09-03T02:47:03.246Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "6b366492-2e3a-4dff-b6c1-017777706457",
      "text": "để phù trì và đồng lao cộng khổ với con,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 3,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:03.260Z",
      "updatedAt": "2025-09-03T02:47:03.260Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "c63c2f34-d154-416a-abc6-16547c6123e1",
      "text": "cho con biết điều đẹp ý Chúa.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 4,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:03.274Z",
      "updatedAt": "2025-09-03T02:47:03.274Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "2f60fbc1-d8ea-4be8-9b27-f36659c02ecb",
      "text": "Vì Đức Khôn Ngoan hiểu biết tất cả,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:03.288Z",
      "updatedAt": "2025-09-03T02:47:03.288Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "5c9c3ce1-1903-4da6-85a2-9b7724f73d42",
      "text": "sẽ khôn khéo hướng dẫn con trong việc con làm,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:03.316Z",
      "updatedAt": "2025-09-03T02:47:03.316Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "46518996-adee-42dd-a9a8-9ad1c263c7e3",
      "text": "lấy quyền năng vinh hiển mà gìn giữ con.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:03.329Z",
      "updatedAt": "2025-09-03T02:47:03.329Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "75524546-aecd-4279-9d27-79d36c912704",
      "text": "Nhờ thế, những gì con thực hiện sẽ làm vui lòng Chúa,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:03.375Z",
      "updatedAt": "2025-09-03T02:47:03.375Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "c35baca8-f9e9-4ed9-99e7-2890fc138678",
      "text": "và con sẽ công minh xét xử dân Ngài",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:03.390Z",
      "updatedAt": "2025-09-03T02:47:03.390Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "4f91f1ec-7207-446d-82b3-6b52923a1917",
      "text": "hầu xứng đáng với ngai vàng của thân phụ con.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:03.413Z",
      "updatedAt": "2025-09-03T02:47:03.413Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "e9452e52-bd47-4e40-bbbd-cc34a81e0169",
      "text": "Lạy Chúa, nào có ai biết được ý định của Thiên Chúa ?",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:03.424Z",
      "updatedAt": "2025-09-03T02:47:03.424Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "5671c9b5-4e18-49d2-9bfc-d356ffc05246",
      "text": "Nào có ai hiểu được Đức Chúa muốn điều chi ?",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:03.449Z",
      "updatedAt": "2025-09-03T02:47:03.449Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "3afb10fe-46ed-41b0-9f14-894ad3bb7825",
      "text": "Chúng con vốn là loài phải chết,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:03.459Z",
      "updatedAt": "2025-09-03T02:47:03.459Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "2e874520-b6e4-44c9-bfa3-fb0d42697074",
      "text": "tư tưởng không sâu, lý luận không vững.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:03.469Z",
      "updatedAt": "2025-09-03T02:47:03.469Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "688ca255-ab91-41bc-a02d-6bfdf56e4f58",
      "text": "Quả vậy, thân xác dễ hư nát này khiến linh hồn ra nặng,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:03.480Z",
      "updatedAt": "2025-09-03T02:47:03.480Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "f73b6619-d449-4d22-81ed-c88c5f571aca",
      "text": "cái vỏ bằng đất này làm tinh thần trĩu xuống",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:03.503Z",
      "updatedAt": "2025-09-03T02:47:03.503Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "a9af9fd7-3938-4c82-8671-1d09fe00c643",
      "text": "vì lo nghĩ trăm bề.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 2,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:03.516Z",
      "updatedAt": "2025-09-03T02:47:03.516Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "93a93258-dd5e-4c69-a7af-822a129fd7f2",
      "text": "Những gì thuộc hạ giới,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:03.544Z",
      "updatedAt": "2025-09-03T02:47:03.544Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "2a068f12-2e7c-46ed-b42a-df43f58aaf0d",
      "text": "chúng con đã khó mà hình dung nổi,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:03.558Z",
      "updatedAt": "2025-09-03T02:47:03.558Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "1eca4629-5f34-4181-b37a-dec51801fabd",
      "text": "những điều vừa tầm tay,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 2,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:03.572Z",
      "updatedAt": "2025-09-03T02:47:03.572Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "86e8eadf-dce7-48f2-bd41-63a980cabdb8",
      "text": "đã phải nhọc công mới khám phá được,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 3,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:03.599Z",
      "updatedAt": "2025-09-03T02:47:03.599Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "2fec539a-67a9-40e9-ab52-720fdde908b5",
      "text": "thì những gì thuộc thượng giới,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 4,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:03.613Z",
      "updatedAt": "2025-09-03T02:47:03.613Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "603e04d9-f812-4a80-85b9-c11bc01fd0da",
      "text": "có ai dò thấu nổi hay chăng ?",
      "label": "16",
      "number": 16,
      "subVerseIndex": 5,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:03.641Z",
      "updatedAt": "2025-09-03T02:47:03.641Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "bad350b7-1121-438f-a05e-4299db9f0d26",
      "text": "Ý định của Chúa, nào ai biết được, nếu tự chốn cao vời,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:03.669Z",
      "updatedAt": "2025-09-03T02:47:03.669Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "44510628-ced5-48a6-9b17-b7488446fa09",
      "text": "chính Ngài chẳng ban Đức Khôn Ngoan,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:03.683Z",
      "updatedAt": "2025-09-03T02:47:03.683Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "7c66861a-37ed-4d34-9545-80b4fd63794e",
      "text": "chẳng gửi thần khí thánh ?",
      "label": "17",
      "number": 17,
      "subVerseIndex": 2,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:03.711Z",
      "updatedAt": "2025-09-03T02:47:03.711Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "519bd387-95f2-432e-803e-b3b34df4cef6",
      "text": "Chính vì thế mà đường lối người phàm được sửa lại cho thẳng,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:03.726Z",
      "updatedAt": "2025-09-03T02:47:03.726Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "5d964814-9f9f-40a3-ab78-c7b57cfe5802",
      "text": "cũng vì thế mà con người được dạy cho biết",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:03.739Z",
      "updatedAt": "2025-09-03T02:47:03.739Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "d08c7531-2212-497a-8dc1-b8080da98bd1",
      "text": "những điều đẹp lòng Ngài,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 2,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:03.754Z",
      "updatedAt": "2025-09-03T02:47:03.754Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    },
    {
      "id": "a8d8c5d4-ab7d-4ce9-9477-754f3894d26e",
      "text": "và nhờ Đức Khôn Ngoan mà được cứu độ.”",
      "label": "18",
      "number": 18,
      "subVerseIndex": 3,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:47:03.782Z",
      "updatedAt": "2025-09-03T02:47:03.782Z",
      "chapterId": "2bf5e9c4-9401-48c5-9996-ac9fd9bc5962"
    }
  ],
  "marks": [
    {
      "id": "538f79ed-6b12-488e-9873-bd20518be540",
      "content": "Lời cầu xin này gồm ba đoạn (cc. 1-6 ; 7-12 ; 13-18), có bố cục đối xứng (1-6 với 7-12), và ba lần (4.10.17) nhắc đến chủ đề chính : xin phái Đức Khôn Ngoan tới. Lời cầu xin này cảm hứng một cách tự do lời cầu xin trong 1 V 3,6-9 và 2 Sb 1,8-10. Ở đây, vua Sa-lô-môn nói đến nhiều nét cụ thể khác về con người của ông (cc. 7-8.12), nhưng mở rộng ra, áp dụng vào con người nói chung, trong đó có cả ông (cc. 1-3 ; 5b-6 ; 13-18).",
      "kind": "MARK_KIND_FOOTNOTE",
