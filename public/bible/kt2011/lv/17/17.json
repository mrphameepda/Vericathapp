      "label": "20",
      "sortOrder": 19,
      "startOffset": 35,
      "endOffset": 35,
      "createdAt": "2025-09-03T01:20:57.361Z",
      "updatedAt": "2025-09-03T01:20:57.361Z",
      "targetId": "67008231-c0ba-473e-bf9a-16d7149c6238",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "8cd250dc-0dbc-4315-92d5-6356ef2ea534"
    },
    {
      "id": "4b441fa9-36c5-4f23-9e85-2acac2302320",
      "content": "Vai trò của máu trong hy lễ xá tội được giải thích hai cách : có người cho điều chính là giết con vật thay mạng người có tội ; người khác lại nghĩ điều cốt yếu là để cho máu, tức là sự sống, đụng tới bàn thờ hoặc nắp xá tội (x. Xh 25,17), có lẽ để chỉ rằng giữa Thiên Chúa hằng sống và con người có tội đã có hiệp thông trở lại.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "21",
      "sortOrder": 20,
      "startOffset": 183,
      "endOffset": 183,
      "createdAt": "2025-09-03T01:20:57.392Z",
      "updatedAt": "2025-09-03T01:20:57.392Z",
      "targetId": "abfecf21-5bd3-40fa-8581-3f4a5bea4654",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "8cd250dc-0dbc-4315-92d5-6356ef2ea534"
