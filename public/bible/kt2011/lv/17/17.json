    {
      "id": "4bbb8326-f6f7-4d8c-b006-f9375eeae964",
      "content": "English: Aaron | French: Aaron | Latin: Aaron | Origin: &#1488;&#1463;&#1492;&#1458;&#1512;&#1465;&#1503; | Vietnamese: A-ha-ron -- Gs 21,4",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "5",
      "sortOrder": 4,
