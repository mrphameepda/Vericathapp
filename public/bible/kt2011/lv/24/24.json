    {
      "id": "df292e1d-5f5e-4d81-891a-a5643b567621",
      "text": "Nói phạm thượng. Luật báo phục tương xứng.",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T01:21:47.720Z",
