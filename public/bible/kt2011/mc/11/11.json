  "headings": [
    {
      "id": "c39fb354-2052-4c8a-86e9-fceecb774b2c",
      "text": "IV. SỨ VỤ CỦA ĐỨC GIÊ-SU TẠI GIÊ-RU-SA-LEM",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:35:15.093Z",
      "updatedAt": "2025-09-03T03:35:15.093Z",
      "verseId": "61ddc89c-050b-41c5-95d0-4229da4f2366",
      "chapterId": "5732603c-35fa-4375-8f27-c4e5816826c8"
    },
    {
      "id": "b78bb521-6800-4842-8499-2b5f14a3f086",
      "text": "Cây vả bị rủa",
      "level": 2,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:35:15.502Z",
      "updatedAt": "2025-09-03T03:35:15.502Z",
      "verseId": "c62e8b9f-1240-472d-ac47-ee77b9c1ef14",
      "chapterId": "5732603c-35fa-4375-8f27-c4e5816826c8"
    },
    {
      "id": "fc2abd24-a787-47ff-ad10-3730aa33f5fc",
      "text": "Đức Giê-su đuổi những người buôn bán ra khỏi Đền Thờ",
      "level": 2,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:35:15.606Z",
      "updatedAt": "2025-09-03T03:35:15.606Z",
      "verseId": "57eef2c3-7ce0-450f-8adf-93e73875bf1f",
      "chapterId": "5732603c-35fa-4375-8f27-c4e5816826c8"
    },
    {
      "id": "6a89024f-a4d0-46e9-bf62-8fbfa8516ae4",
      "text": "Cây vả bị khô héo. Đức tin và cầu nguyện.",
      "level": 2,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:35:15.781Z",
      "updatedAt": "2025-09-03T03:35:15.781Z",
      "verseId": "a5ab99e9-5f42-4c25-9709-ae367b121ead",
      "chapterId": "5732603c-35fa-4375-8f27-c4e5816826c8"
    },
    {
      "id": "d8b7e998-42ba-4bdb-8ee9-90fb2e5f4c21",
      "text": "Tranh luận về thẩm quyền của Đức Giê-su",
      "level": 2,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:35:16.003Z",
      "updatedAt": "2025-09-03T03:35:16.003Z",
      "verseId": "c818cded-5eb7-4159-b510-d57e9d2822c4",
      "chapterId": "5732603c-35fa-4375-8f27-c4e5816826c8"
    },
    {
      "id": "6203a6ca-cddc-4469-bfcb-02b5f46bfbc0",
      "text": "Đức Giê-su vào Giê-ru-sa-lem với tư cách Mê-si-a",
      "level": 2,
      "sortOrder": 1,
      "createdAt": "2025-09-03T03:35:15.103Z",
      "updatedAt": "2025-09-03T03:35:15.103Z",
      "verseId": "61ddc89c-050b-41c5-95d0-4229da4f2366",
      "chapterId": "5732603c-35fa-4375-8f27-c4e5816826c8"
    }
  ],
