    },
    {
      "id": "e1a88cf7-8ca9-429f-98a5-c02778b521e9",
      "content": "*Vì thế* : lời nói về sức mạnh của lòng tin ở c.23 được áp dụng ở đây cho lời cầu nguyện.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "29",
      "sortOrder": 28,
      "startOffset": 6,
      "endOffset": 6,
      "createdAt": "2025-09-03T03:35:15.917Z",
