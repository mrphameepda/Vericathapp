    {
      "id": "dcc2b84a-dda5-42c7-864c-04be15997e05",
      "content": "Mt 9,1-8; Lc 5,17-26",
      "kind": "MARK_KIND_REFERENCE",
      "label": "1@",
      "sortOrder": 0,
      "startOffset": 0,
      "endOffset": 0,
