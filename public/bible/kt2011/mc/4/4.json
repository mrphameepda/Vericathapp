  "headings": [
    {
      "id": "6a49cd0c-2954-4e03-8c58-8ee85b9936d2",
      "text": "Dụ ngôn người gieo giống",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:34:14.839Z",
      "updatedAt": "2025-09-03T03:34:14.839Z",
      "verseId": "9e16b50a-aa47-468c-9003-8937c2eba444",
      "chapterId": "5acefb2f-ad63-4cf6-a378-70c6d5acc74f"
    },
    {
      "id": "6725014b-ba56-427c-b10d-3198c2337e63",
      "text": "Tại sao Đức Giê-su dùng dụ ngôn ?",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:34:15.033Z",
      "updatedAt": "2025-09-03T03:34:15.033Z",
      "verseId": "e5d56ca0-0ee9-430d-9a32-5561fe661f21",
      "chapterId": "5acefb2f-ad63-4cf6-a378-70c6d5acc74f"
    },
    {
      "id": "9d19b94b-f99b-4d74-899f-185649df2d80",
      "text": "Cắt nghĩa dụ ngôn người gieo giống",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:34:15.192Z",
      "updatedAt": "2025-09-03T03:34:15.192Z",
      "verseId": "82e93a57-e14b-4b35-b806-8b0ed81b8deb",
      "chapterId": "5acefb2f-ad63-4cf6-a378-70c6d5acc74f"
    },
    {
      "id": "f87a66a7-4819-4b3b-8565-76a57d9510e5",
      "text": "Dụ ngôn cái đèn, đấu đong",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:34:15.360Z",
      "updatedAt": "2025-09-03T03:34:15.360Z",
      "verseId": "0611d1ae-037a-4d28-b022-14d21a34ff88",
      "chapterId": "5acefb2f-ad63-4cf6-a378-70c6d5acc74f"
    },
    {
      "id": "df4e6824-4508-48a7-a85e-a51abeacf05b",
      "text": "Dụ ngôn hạt giống tự mọc lên",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:34:15.506Z",
      "updatedAt": "2025-09-03T03:34:15.506Z",
      "verseId": "07866ee7-bf0e-4189-a44a-7ab29640f706",
      "chapterId": "5acefb2f-ad63-4cf6-a378-70c6d5acc74f"
    },
    {
      "id": "db991626-3337-40fa-b5ef-3e92b2a78838",
      "text": "Dụ ngôn hạt cải",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:34:15.608Z",
      "updatedAt": "2025-09-03T03:34:15.608Z",
      "verseId": "ee2ad424-12ff-417a-b652-c2a223a0c30c",
      "chapterId": "5acefb2f-ad63-4cf6-a378-70c6d5acc74f"
    },
    {
      "id": "1fff3795-b01c-452c-9e16-595e30966c48",
      "text": "Kết luận về các dụ ngôn",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:34:15.721Z",
