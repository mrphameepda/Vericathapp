  "headings": [
    {
      "id": "03ba4917-c8c6-4917-a90c-cf87b7bfab4b",
      "text": "2. BÀI GIẢNG VỀ GIÁO HỘI",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:32:20.577Z",
      "updatedAt": "2025-09-03T03:32:20.577Z",
      "verseId": "b1b8c96b-bd6d-4b07-8fce-fc7d49afc4eb",
      "chapterId": "3363f29e-b618-488f-af38-0ebb644c9356"
    },
    {
      "id": "1058d351-9079-414a-ad3f-f9b6b0dc9844",
      "text": "Đừng làm cớ cho người ta sa ngã",
      "level": 2,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:32:20.788Z",
      "updatedAt": "2025-09-03T03:32:20.788Z",
      "verseId": "7e42d510-5c99-4618-9b2c-ed7487207e79",
      "chapterId": "3363f29e-b618-488f-af38-0ebb644c9356"
    },
    {
      "id": "b2696376-960b-4034-8114-76187dac84b2",
      "text": "Con chiên lạc",
      "level": 2,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:32:20.943Z",
      "updatedAt": "2025-09-03T03:32:20.943Z",
      "verseId": "a10b13ea-0e95-44c2-90cc-ef802dd7cc3c",
      "chapterId": "3363f29e-b618-488f-af38-0ebb644c9356"
    },
    {
      "id": "5c07a528-e1b1-4a7d-ad17-478b1d0f5bb9",
      "text": "Sửa lỗi anh em",
      "level": 2,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:32:21.027Z",
      "updatedAt": "2025-09-03T03:32:21.027Z",
      "verseId": "1c4baae9-ef6e-4023-8143-af8ccc1262ff",
      "chapterId": "3363f29e-b618-488f-af38-0ebb644c9356"
    },
    {
      "id": "3aa676ec-8784-4292-8475-646fd4909a3a",
      "text": "Hợp lời cầu nguyện",
      "level": 2,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:32:21.141Z",
      "updatedAt": "2025-09-03T03:32:21.141Z",
      "verseId": "66a5b8d2-2c7a-4bb0-9b87-ede75664e90a",
      "chapterId": "3363f29e-b618-488f-af38-0ebb644c9356"
    },
    {
      "id": "446dfa1d-696a-42b8-8de6-1b1be6aebea2",
      "text": "Anh em tha thứ cho nhau",
      "level": 2,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:32:21.197Z",
      "updatedAt": "2025-09-03T03:32:21.197Z",
      "verseId": "fc81aa96-a5b7-4027-9e4f-9b8334220e45",
      "chapterId": "3363f29e-b618-488f-af38-0ebb644c9356"
    },
    {
      "id": "3241d083-2db3-489a-9548-3c11668093d1",
      "text": "Dụ ngôn tên mắc nợ không biết thương xót",
      "level": 2,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:32:21.314Z",
      "updatedAt": "2025-09-03T03:32:21.314Z",
      "verseId": "fdaef469-ee28-4488-8a76-06007ff85518",
      "chapterId": "3363f29e-b618-488f-af38-0ebb644c9356"
    },
    {
      "id": "c0e0231b-2889-47a1-ba8f-aca496b3d5ad",
      "text": "Ai là người lớn nhất trong Nước Trời ?",
      "level": 2,
      "sortOrder": 1,
      "createdAt": "2025-09-03T03:32:20.587Z",
      "updatedAt": "2025-09-03T03:32:20.587Z",
      "verseId": "b1b8c96b-bd6d-4b07-8fce-fc7d49afc4eb",
      "chapterId": "3363f29e-b618-488f-af38-0ebb644c9356"
    }
