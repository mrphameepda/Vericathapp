  "headings": [
    {
      "id": "f07ab851-1185-4873-8628-4bca5d4f0bc7",
      "text": "Dụ ngôn thợ làm vườn nho",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:32:34.988Z",
      "updatedAt": "2025-09-03T03:32:34.988Z",
      "verseId": "b7f44941-fbda-4bf9-a0a3-002ffae0ab8a",
      "chapterId": "23a3bf31-085a-4ea5-be49-7257ee2f4e66"
    },
    {
      "id": "93e12c84-2232-4a69-aed7-2021fcbd7123",
      "text": "Đức Giê-su tiên báo cuộc Thương Khó lần thứ ba",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:32:35.267Z",
      "updatedAt": "2025-09-03T03:32:35.267Z",
      "verseId": "6ae4dbaa-8c74-4fbc-bae3-4ee5282ddaf5",
      "chapterId": "23a3bf31-085a-4ea5-be49-7257ee2f4e66"
    },
    {
      "id": "3a70221a-f188-4b7a-ab34-03354c00d360",
      "text": "Bà mẹ của hai người con ông Dê-bê-đê",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:32:35.426Z",
      "updatedAt": "2025-09-03T03:32:35.426Z",
      "verseId": "9a254983-d3ef-4813-a9dd-9537c33c8b00",
      "chapterId": "23a3bf31-085a-4ea5-be49-7257ee2f4e66"
    },
    {
      "id": "de7ebdc5-3a39-4ac4-8929-b870b531c296",
      "text": "Ai làm lớn phải phục vụ",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:32:35.630Z",
