    {
      "id": "72afff73-3a77-4600-b74d-75034c9b6ac4",
      "content": "*Nước Trời đã đến gần* : kiểu nói Do-thái tránh đọc tên Thiên Chúa, ý nghĩa cũng như *Nước Thiên Chúa* trong các Tin Mừng khác. Cựu Ước nhiều lần đã báo trước và hứa hẹn, người Do-thái nóng lòng chờ mong Đấng Mê-si-a thiết lập nước đó ; nhưng quần chúng thời bấy giờ lại có một ý niệm sai lạc, đợi trông một nước trần gian và chính trị. Ông Gio-an bắt đầu bằng kêu gọi sám hối như điều kiện thiết yếu chuẩn bị cho người ta gia nhập Nước Trời, cũng cho hiểu rằng nước ấy sẽ do Đức Giê-su khai mở và nó mang tính chất thiêng liêng.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "7",
      "sortOrder": 6,
      "startOffset": 44,
      "endOffset": 44,
      "createdAt": "2025-09-03T03:30:19.553Z",
      "updatedAt": "2025-09-03T03:30:19.553Z",
      "targetId": "7dc6f4ec-867f-4e3e-b5b4-1f7d977ef850",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "0b60cc3a-d504-45dc-b1ab-de750c441b9c"
    },
