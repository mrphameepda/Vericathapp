      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "0b60cc3a-d504-45dc-b1ab-de750c441b9c"
    },
    {
      "id": "c0ca0d90-34ce-44ed-a9bd-112120ada8ed",
      "content": "English: Judaea | French: Judée | Latin: Iudaea | Origin: &#921;&#959;&#965;&#948;&#945;&#953;&#945; | Vietnamese: Giu-đê 1 -- tên gọi khác của xứ Pa-lét-tin thời Ma-ca-bê, -- 1 Mcb 3,34 ; 4,35 v.v.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "13",
      "sortOrder": 12,
      "startOffset": 54,
      "endOffset": 54,
      "createdAt": "2025-09-03T03:30:19.646Z",
      "updatedAt": "2025-09-03T03:30:19.646Z",
