    {
      "id": "afc61300-d1c7-4aec-ab23-b578227c139d",
      "content": "Xh 21,2",
      "kind": "MARK_KIND_REFERENCE",
      "label": "1@",
      "sortOrder": 0,
      "startOffset": 126,
      "endOffset": 126,
      "createdAt": "2025-09-03T02:08:05.587Z",
      "updatedAt": "2025-09-03T02:08:05.587Z",
      "targetId": "8f724ed6-3b36-4863-bc57-bcf2e9ca25f4",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "036fd453-cb13-4651-9816-ae81d42f2416"
    },
    {
      "id": "7323d80c-4795-4458-853a-c3c5373a14ba",
      "content": "Híp-ri và LXX : *Cùng với con trai con gái chúng tôi, chúng tôi đông người, chúng tôi phải kiếm lúa để ăn mà sống*. Chúng tôi theo một cách đọc dựa vào cấu trúc câu sau để làm rõ nghĩa câu này, nhờ đọc khác đi một âm ở từ *đông* trong bản Híp-ri, thành ra từ *cầm* như ở câu sau. Cách đọc này được củng cố do c.5.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 92,
      "endOffset": 92,
      "createdAt": "2025-09-03T02:08:05.502Z",
      "updatedAt": "2025-09-03T02:08:05.502Z",
      "targetId": "ada9d0e5-ccd3-4ebf-8c94-ba27955e002e",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "036fd453-cb13-4651-9816-ae81d42f2416"
    },
    {
      "id": "b8bf76c4-015e-428b-99aa-f8228eeb445c",
      "content": "*Nộp thuế cho vua* : thuế nộp vào các ngân khố địa phương của đế quốc, x. Er 6,8 ; 7,20.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 104,
      "endOffset": 104,
      "createdAt": "2025-09-03T02:08:05.543Z",
      "updatedAt": "2025-09-03T02:08:05.543Z",
      "targetId": "910c5fc9-b328-401e-8575-03f2c105d05a",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "036fd453-cb13-4651-9816-ae81d42f2416"
    },
    {
      "id": "c2bab89b-03e5-4519-a307-f0730aebc668",
      "content": "*Cùng ruột thịt* : những kẻ bóc lột cũng chính là người Do-thái, x. Ml 2,10. Lời tố cáo về tội áp bức bóc lột anh em đồng bào đã vang lên trong tất cả các sách ngôn sứ trước lưu đày. Nay trong cộng đoàn những người hồi hương lại vang tiếng kêu than của những người nghèo bị áp bức bóc lột.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 24,
      "endOffset": 24,
      "createdAt": "2025-09-03T02:08:05.572Z",
      "updatedAt": "2025-09-03T02:08:05.572Z",
      "targetId": "8f724ed6-3b36-4863-bc57-bcf2e9ca25f4",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "036fd453-cb13-4651-9816-ae81d42f2416"
    },
    {
      "id": "9647a27b-db0b-4202-b836-df7b6eda5bb9",
      "content": "*Trưởng tộc và quan chức* : đây là những tầng lớp thường cấu kết với những kẻ đã chiếm lãnh đất đai sau khi dân Do-thái bị lưu đày, chủ yếu qua hôn nhân. Cuộc “thanh lọc giống nòi” sau này (x. Er 9 và Nkm 13,23-30) chủ yếu là vì lý do tôn giáo, nhưng cũng có thể đã có sự tác động của yếu tố kinh tế – xã hội này.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "5",
      "sortOrder": 4,
      "startOffset": 70,
      "endOffset": 70,
      "createdAt": "2025-09-03T02:08:05.629Z",
      "updatedAt": "2025-09-03T02:08:05.629Z",
      "targetId": "b5af4773-f90d-45db-b004-dbdf77e0c7e5",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "036fd453-cb13-4651-9816-ae81d42f2416"
    },
    {
      "id": "d47d4b3e-e070-4c26-9a0e-91941318b6d9",
      "content": "*Đại hội* : hình thức quen thuộc từ thời xuất hành và các thủ lãnh.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "6",
      "sortOrder": 5,
      "startOffset": 177,
      "endOffset": 177,
      "createdAt": "2025-09-03T02:08:05.643Z",
      "updatedAt": "2025-09-03T02:08:05.643Z",
      "targetId": "b5af4773-f90d-45db-b004-dbdf77e0c7e5",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "036fd453-cb13-4651-9816-ae81d42f2416"
    },
    {
      "id": "e25e3964-69be-4ac4-ae7c-e71df1e27484",
      "content": "*Bán cho dân ngoại* : không rõ điều này ám chỉ chính quyền Ba-tư hay dân ngoại chung quanh. Những người cho vay nặng lãi khiến đồng bào phải cho con ở đợ hay bán con thì cũng hành động như dân ngoại.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "7",
      "sortOrder": 6,
      "startOffset": 116,
      "endOffset": 116,
      "createdAt": "2025-09-03T02:08:05.672Z",
      "updatedAt": "2025-09-03T02:08:05.672Z",
      "targetId": "37547bc9-98fe-4d35-9f50-f2280eaab816",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "036fd453-cb13-4651-9816-ae81d42f2416"
    },
    {
      "id": "531f2e77-550e-4a53-aeb6-052b130e9dda",
      "content": "*Chính tôi ...* : bản thân ông Nơ-khe-mi-a, anh em và thuộc hạ của ông cũng đã cho vay tiền và lúa gạo, nên ông dễ dàng kêu gọi những chủ nợ khác cùng xoá nợ vì tình nghĩa đồng bào.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "8",
      "sortOrder": 7,
      "startOffset": 9,
      "endOffset": 9,
      "createdAt": "2025-09-03T02:08:05.715Z",
      "updatedAt": "2025-09-03T02:08:05.715Z",
      "targetId": "84014671-af96-4c5d-af3f-061df943f1b0",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "036fd453-cb13-4651-9816-ae81d42f2416"
    },
    {
      "id": "8c2ca603-9e27-4426-9c4e-2a141e8513bb",
      "content": "*Trả lại* : giải pháp cất gánh nặng cho người nghèo gồm hai phần : trả lại tài sản cầm cố và tha số lời, x. Đnl 23,20 ; 24,6.10-13 ; Xh 22,24-25.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "9",
      "sortOrder": 8,
      "startOffset": 33,
      "endOffset": 33,
      "createdAt": "2025-09-03T02:08:05.743Z",
      "updatedAt": "2025-09-03T02:08:05.743Z",
      "targetId": "d5d9808b-0867-4115-b85d-8f24400c2d84",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "036fd453-cb13-4651-9816-ae81d42f2416"
    },
    {
      "id": "80fb097c-ac0b-4d25-bf8d-d45f4147fdb5",
      "content": "*Bắt họ thề* : để bảo đảm rằng họ sẽ thi hành lời cam kết.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "10",
      "sortOrder": 9,
      "startOffset": 144,
      "endOffset": 144,
      "createdAt": "2025-09-03T02:08:05.771Z",
      "updatedAt": "2025-09-03T02:08:05.771Z",
      "targetId": "23048631-2548-4315-80ff-2b95dd39a69e",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "036fd453-cb13-4651-9816-ae81d42f2416"
    },
    {
      "id": "4a8c1449-dfb4-4648-bd3b-6dfc2afb1326",
      "content": "*Giũ vạt áo* : cũng có thể là cái túi đeo ở thắt lưng, hay chính dây lưng là tấm vải xếp lại, có thể đựng tiền bạc, tương tự “ruột tượng” của phụ nữ Việt Nam ngày xưa. Cử chỉ có tính cách nguyền rủa, chúc dữ cho kẻ không làm theo lời hứa.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "11",
      "sortOrder": 10,
      "startOffset": 18,
      "endOffset": 18,
      "createdAt": "2025-09-03T02:08:05.803Z",
      "updatedAt": "2025-09-03T02:08:05.803Z",
      "targetId": "7da8ed8e-0b5b-42c7-8ad1-6ef6bd4c759c",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "036fd453-cb13-4651-9816-ae81d42f2416"
    },
    {
      "id": "8b425a95-f968-4c00-85ca-434fe4b72edc",
      "content": "English: Yahweh | French: SEIGNEUR | Latin: Dominus | Origin: &#1497;&#1456;&#1492;&#64331;&#1464;&#1492; | Vietnamese: ĐỨC CHÚA -- Danh của Thiên Chúa Ít-ra-en, St 2,4...",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "12",
      "sortOrder": 11,
      "startOffset": 250,
      "endOffset": 250,
      "createdAt": "2025-09-03T02:08:05.817Z",
      "updatedAt": "2025-09-03T02:08:05.817Z",
      "targetId": "7da8ed8e-0b5b-42c7-8ad1-6ef6bd4c759c",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "036fd453-cb13-4651-9816-ae81d42f2416"
    },
    {
      "id": "6749bbbb-a21f-452c-82ef-d7be595f3e5b",
      "content": "*Dân đã làm theo lời hứa* : cũng có thể hiểu là *dân đã làm như thế*, nghĩa là họ cũng giũ vạt áo như ông Nơ-khe-mi-a, vì thật ra chỉ có đám trưởng tộc và quan chức mới bóc lột anh em và phải thi hành lời hứa.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "13",
      "sortOrder": 12,
      "startOffset": 282,
      "endOffset": 282,
      "createdAt": "2025-09-03T02:08:05.831Z",
      "updatedAt": "2025-09-03T02:08:05.831Z",
      "targetId": "7da8ed8e-0b5b-42c7-8ad1-6ef6bd4c759c",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "036fd453-cb13-4651-9816-ae81d42f2416"
    },
    {
      "id": "b8446b8f-3df3-47db-ba83-a1f5e91d930e",
      "content": "*Hơn nữa ...* : cc. 14-19 trình bày cách thức, đường lối cai trị của Nơ-khe-mi-a, trái với các vị tổng trấn trước, như để củng cố cho cách xử sự ông đã yêu cầu các trưởng tộc và quan chức phải theo để đừng làm khổ dân.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "14",
      "sortOrder": 13,
      "startOffset": 7,
      "endOffset": 7,
      "createdAt": "2025-09-03T02:08:05.859Z",
      "updatedAt": "2025-09-03T02:08:05.859Z",
      "targetId": "fec92eb9-7add-4c1f-ae07-f647d9d8ad54",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "036fd453-cb13-4651-9816-ae81d42f2416"
    },
    {
      "id": "26c49fb8-da41-4577-9b31-86273de0fcf8",
      "content": "English: Judah | French: Juda | Latin: Iuda | Origin: &#1497;&#1456;&#1492;&#64309;&#1491;&#1464;&#1492; | Vietnamese: Giu-đa 1 -- con ông Gia-cóp và bà Lê-a, St 29,35",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "15",
      "sortOrder": 14,
      "startOffset": 53,
      "endOffset": 53,
      "createdAt": "2025-09-03T02:08:05.873Z",
      "updatedAt": "2025-09-03T02:08:05.873Z",
      "targetId": "fec92eb9-7add-4c1f-ae07-f647d9d8ad54",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "036fd453-cb13-4651-9816-ae81d42f2416"
    },
    {
      "id": "eba60d5e-f7ca-471f-b9ef-b46ef3e96d16",
      "content": "English: Artaxerxes | French: Artaxerxès | Latin: Artaxerxes | Origin: &#1488;&#1463;&#1512;&#1456;&#64330;&#1463;&#1495;&#1456;&#64298;&#1463;&#64299;&#1456;&#1514;&#1464;&#1488; | Vietnamese: Ác-tắc-sát-ta -- vua Ba-tư, Er 4,7-23",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "16",
      "sortOrder": 15,
      "startOffset": 123,
      "endOffset": 123,
      "createdAt": "2025-09-03T02:08:05.888Z",
      "updatedAt": "2025-09-03T02:08:05.888Z",
      "targetId": "fec92eb9-7add-4c1f-ae07-f647d9d8ad54",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "036fd453-cb13-4651-9816-ae81d42f2416"
    },
    {
      "id": "ad444f69-a814-45a3-a837-4e1ada65f979",
      "content": "*Tiền nhiệm* : ám chỉ ai ? Lúc mới hồi hương thì có Sết-bát-xa và Dơ-rúp-ba-ven, ngay trước Nơ-khe-mi-a thì chính tổng đốc và quan chức Sa-ma-ri cai trị đất Giu-đa. Có lẽ ám chỉ nhóm sau thì đúng hơn. Suốt 12 năm, Nơ-khe-mi-a không bắt dân nuôi mình và thuộc hạ. Không lợi dụng địa vị, thế giá để tậu ruộng đất. Dù phải nuôi 150 miệng ăn, không kể khách khứa, ông vẫn không đòi bổng lộc mà ông có quyền đòi. Lý do : “vì việc lao dịch đã đè nặng trên dân này rồi”.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "17",
      "sortOrder": 16,
      "startOffset": 32,
      "endOffset": 32,
      "createdAt": "2025-09-03T02:08:05.916Z",
      "updatedAt": "2025-09-03T02:08:05.916Z",
      "targetId": "41812038-2239-4ac7-acbd-5e4474610819",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "036fd453-cb13-4651-9816-ae81d42f2416"
    },
    {
      "id": "eafaf317-0840-41c8-9908-e9a40813943b",
      "content": "*Lạy Thiên Chúa* : lời cầu nguyện thường gặp trong các thánh vịnh.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "18",
      "sortOrder": 17,
      "startOffset": 14,
      "endOffset": 14,
      "createdAt": "2025-09-03T02:08:05.988Z",
      "updatedAt": "2025-09-03T02:08:05.988Z",
      "targetId": "cd697c48-90d9-4400-aadb-839f9febd5b4",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "036fd453-cb13-4651-9816-ae81d42f2416"
    }
  ],
  "headings": [
    {
      "id": "9c987fb1-37f6-41dd-9627-95c554026552",
      "text": "Những khó khăn về mặt xã hội dưới thời ông Nơ-khe-mi-a. Ông biện hộ cho cách điều hành công việc của ông.",
