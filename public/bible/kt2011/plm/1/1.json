      "content": "English: Epaphras | French: Epaphras | Latin: Epaphras | Origin: &#917;&#960;&#945;&#981;&#961;&#945;&#962; | Vietnamese: Ê-páp-ra -- Cl 4,12",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "30",
      "sortOrder": 29,
      "startOffset": 12,
      "endOffset": 12,
      "createdAt": "2025-09-03T03:58:41.534Z",
