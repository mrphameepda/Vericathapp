  "headings": [
    {
      "id": "95139240-bcde-4dae-b1e0-1a9109528266",
      "text": "THƯ GỬI ÔNG PHI-LÊ-MÔN",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:58:40.578Z",
      "updatedAt": "2025-09-03T03:58:40.578Z",
      "verseId": "5d0c4a4d-4f79-46f3-a81d-fd1ebd312406",
      "chapterId": "dabc71ef-778f-4f81-96f7-87eaefd53ceb"
    },
    {
      "id": "49718570-e0cb-4845-b75d-4e619448ffef",
      "text": "Tạ ơn và cầu nguyện",
      "level": 2,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:58:40.833Z",
      "updatedAt": "2025-09-03T03:58:40.833Z",
      "verseId": "41e25697-3c62-43fa-aecf-81637e084e81",
      "chapterId": "dabc71ef-778f-4f81-96f7-87eaefd53ceb"
    },
    {
      "id": "ddf75fcd-960e-4cdd-bd25-d71031f67ea4",
      "text": "Can thiệp cho Ô-nê-xi-mô",
      "level": 2,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:58:40.977Z",
      "updatedAt": "2025-09-03T03:58:40.977Z",
      "verseId": "2dd83e74-0a59-4fc2-ae3b-a06b20f90b7f",
      "chapterId": "dabc71ef-778f-4f81-96f7-87eaefd53ceb"
    },
    {
      "id": "3ee3c32a-e4ca-4ffb-abb3-31088ac935ac",
      "text": "Những lời dặn dò, thăm hỏi",
      "level": 2,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:58:41.494Z",
      "updatedAt": "2025-09-03T03:58:41.494Z",
      "verseId": "a97f0660-77c7-4dc7-967f-ddce0b76aa8c",
      "chapterId": "dabc71ef-778f-4f81-96f7-87eaefd53ceb"
    },
    {
      "id": "577d3a71-60c0-4503-93b3-07212bab810b",
      "text": "Lời chào thăm",
      "level": 2,
      "sortOrder": 1,
      "createdAt": "2025-09-03T03:58:40.589Z",
      "updatedAt": "2025-09-03T03:58:40.589Z",
