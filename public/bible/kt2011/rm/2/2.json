    },
    {
      "id": "4e2d2d5e-4e4d-401e-bc53-057164a95bc9",
      "text": "Mặc dầu có Luật Mô-sê",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:47:05.338Z",
      "updatedAt": "2025-09-03T03:47:05.338Z",
      "verseId": "bc12737a-5359-44bd-b619-4734f60bd8d4",
      "chapterId": "252004ba-738d-4229-8195-42ec1bd827a1"
    },
    {
      "id": "fe81e0b6-85f3-4dd3-98ec-19063f981fcb",
      "text": "Mặc dầu có phép cắt bì",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:47:05.728Z",
