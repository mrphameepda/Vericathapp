    {
      "id": "a84bb590-7820-410a-be87-1f4a945ff613",
      "content": "St 15,6; Gl 3,6; Gc 2,14.20-24",
      "kind": "MARK_KIND_REFERENCE",
      "label": "1@",
      "sortOrder": 0,
      "startOffset": 35,
      "endOffset": 35,
      "createdAt": "2025-09-03T03:47:22.310Z",
      "updatedAt": "2025-09-03T03:47:22.310Z",
      "targetId": "62abfee5-a58e-4fca-a3fb-c822576a7fe1",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "779a2d73-0a03-471f-b009-b67607037ee0"
    },
    {
      "id": "779375db-c686-44a5-94c9-e854dbf47387",
      "content": "Thánh Phao-lô nêu gương của ông Áp-ra-ham như là một dẫn chứng Kinh Thánh để chứng minh chủ đề người ta được Thiên Chúa làm cho nên công chính nhờ họ tin. Câu chuyện ông Áp-ra-ham ở đây không những không nghịch với chủ đề thánh Phao-lô đang trình bày nhưng còn là một đề tài căn bản. Cũng qua đó, thánh Phao-lô cho thấy sự thống nhất giữa hai Giao Ước. – Lập luận mở rộng dần dần : c.1 : tổ phụ chúng tôi. c.12 : cắt bì không đủ mà còn cần có đức tin. Cc. 16-18 : không những là tổ phụ mà còn là gương mẫu của mọi kẻ tin.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 43,
      "endOffset": 43,
      "createdAt": "2025-09-03T03:47:22.209Z",
      "updatedAt": "2025-09-03T03:47:22.209Z",
