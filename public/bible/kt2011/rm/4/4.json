    },
    {
      "id": "11685277-3ad9-4f05-ad59-be944ec1b081",
      "content": "St 15,6",
      "kind": "MARK_KIND_REFERENCE",
      "label": "7@",
      "sortOrder": 6,
      "startOffset": 16,
      "endOffset": 16,
      "createdAt": "2025-09-03T03:47:22.885Z",
      "updatedAt": "2025-09-03T03:47:22.885Z",
      "targetId": "80357f1c-8008-40f4-897a-ba8ae1e13453",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "779a2d73-0a03-471f-b009-b67607037ee0"
    },
    {
      "id": "dfe2b891-faf4-4603-b532-b3a06ac92bff",
      "content": "St 15,6. Có thể có nhiều cách giải thích : 1) Nhờ đức tin, Thiên Chúa coi ông Áp-ra-ham là công chính, trong khi thực tế ông không công chính ; 2) Nhờ đức tin, Thiên Chúa ban không cho ông Áp-ra-ham ơn được nên công chính mà cho tới khi tin ông vẫn chưa có ; 3) Theo cách nhìn của Thiên Chúa : đức tin hoà nhập với sự công chính. Nhưng cũng không thể coi đức tin của ông Áp-ra-ham như thể một việc làm đáng Thiên Chúa ban cho ông ơn được nên công chính. Từ ngữ cho phép hiểu đó là tác động của Thiên Chúa chấp nhận một người hoàn toàn không có chút công chính nào riêng của mình (Rm 9,22-23 ; Gl 3,6 ; Gc 2,23).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "8",
      "sortOrder": 7,
      "startOffset": 102,
      "endOffset": 102,
      "createdAt": "2025-09-03T03:47:22.299Z",
      "updatedAt": "2025-09-03T03:47:22.299Z",
      "targetId": "62abfee5-a58e-4fca-a3fb-c822576a7fe1",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "779a2d73-0a03-471f-b009-b67607037ee0"
    },
    {
      "id": "d5b5ab55-7e7c-4806-b4d1-503ff8cd4123",
      "content": "*Người nào không dựa vào việc làm*, ds : *người không làm, nhưng tin* ... không làm không có nghĩa là hoàn toàn thụ động. Nhưng chỉ có ý xét về mặt pháp lý : việc làm chẳng có giá trị gì đáng đòi ơn của Thiên Chúa.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "9",
      "sortOrder": 8,
      "startOffset": 41,
      "endOffset": 41,
      "createdAt": "2025-09-03T03:47:22.342Z",
      "updatedAt": "2025-09-03T03:47:22.342Z",
      "targetId": "7397af95-aa82-4472-8e3d-49c32da206d8",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "779a2d73-0a03-471f-b009-b67607037ee0"
    },
    {
      "id": "3aacdd7b-4d1b-4a05-9dcb-0b083af9aba5",
      "content": "English: David | French: David | Latin: David | Origin: &#1491;&#1464;&#1493;&#1460;&#1491; | Vietnamese: Đa-vít -- 1 Sm 16,21-22",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "10",
      "sortOrder": 9,
      "startOffset": 21,
      "endOffset": 21,
      "createdAt": "2025-09-03T03:47:22.364Z",
      "updatedAt": "2025-09-03T03:47:22.364Z",
      "targetId": "f87dd340-3f7e-4d80-829d-92bbd121f58d",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "779a2d73-0a03-471f-b009-b67607037ee0"
    },
    {
      "id": "923cdab6-0695-4273-808b-d7a9d153e909",
      "content": "*Khoan dung*. ds : *che phủ,* không hiểu theo nghĩa che cho khỏi thấy, nhưng hiểu là Thiên Chúa phá huỷ, tiêu diệt tội lỗi (x. Tv 85,3 ; Cn 10,12 ; Gc 5,20 ; 1 Pr 4,8). Thánh Phao-lô dẫn Tv 32,1 theo kiểu của người : nêu trường hợp của một cá nhân được hưởng ơn tha tội để thành một nguyên tắc chung cho mọi người : Thiên Chúa làm cho con người nên công chính (= tha thứ tội lỗi) mà không xét đến việc làm của con người.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "11",
      "sortOrder": 10,
      "startOffset": 32,
      "endOffset": 32,
      "createdAt": "2025-09-03T03:47:22.409Z",
      "updatedAt": "2025-09-03T03:47:22.409Z",
      "targetId": "2dea61be-18c4-4e90-8c51-6611d0979484",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "779a2d73-0a03-471f-b009-b67607037ee0"
    },
    {
      "id": "3874dde4-6ff0-4713-96e3-13f7301ca587",
      "content": "English: Abraham | French: Abraham | Latin: Abraham | Origin: &#1488;&#1463;&#1489;&#1456;&#1512;&#1464;&#1492;&#1464;&#1501; | Vietnamese: Áp-ra-ham -- St 17,5",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "12",
      "sortOrder": 11,
      "startOffset": 160,
      "endOffset": 160,
      "createdAt": "2025-09-03T03:47:22.450Z",
      "updatedAt": "2025-09-03T03:47:22.450Z",
      "targetId": "f3c1b3ee-987a-4770-8bdd-cfe4214fc4d6",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "779a2d73-0a03-471f-b009-b67607037ee0"
    },
    {
      "id": "8584e1c8-9b3a-4cf5-815c-1b54e831f4d3",
      "content": "ds : *đã cắt bì hay còn chưa cắt bì* ? *Không phải là đã cắt bì, nhưng là còn chưa cắt bì.*",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "13",
      "sortOrder": 12,
      "startOffset": 125,
      "endOffset": 125,
      "createdAt": "2025-09-03T03:47:22.481Z",
      "updatedAt": "2025-09-03T03:47:22.481Z",
      "targetId": "dadeab6e-797f-48ca-a2d2-e9cbeac5329e",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "779a2d73-0a03-471f-b009-b67607037ee0"
    },
    {
      "id": "be3a3bc5-4234-4615-b8d5-ffe425c97f08",
      "content": "*Ông nhận được phép cắt bì như dấu hiệu chứng thực ...* ds : *ông đã nhận lấy dấu cắt bì, ấn tín của sự công chính bởi đức tin, ngay khi còn chưa cắt bì.* Thánh Phao-lô giải thích phép cắt bì của ông Áp-ra-ham như là một dấu hiệu chứng thực ông đã được Thiên Chúa cho trở nên công chính, chứ không phải là điều kiện.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "14",
      "sortOrder": 13,
      "startOffset": 38,
      "endOffset": 38,
      "createdAt": "2025-09-03T03:47:22.503Z",
      "updatedAt": "2025-09-03T03:47:22.503Z",
      "targetId": "42111c21-cfeb-4de7-8a39-1e3bbc16f450",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "779a2d73-0a03-471f-b009-b67607037ee0"
    },
    {
      "id": "44ca2944-5174-4d4f-ba77-0816987e7f39",
      "content": "*Nhờ tin mà ông được trở nên công chính ...* ds : *sự công chính của đức tin ngay khi còn chưa cắt bì*.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "15",
      "sortOrder": 14,
      "startOffset": 118,
      "endOffset": 118,
      "createdAt": "2025-09-03T03:47:22.513Z",
      "updatedAt": "2025-09-03T03:47:22.513Z",
      "targetId": "42111c21-cfeb-4de7-8a39-1e3bbc16f450",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "779a2d73-0a03-471f-b009-b67607037ee0"
    },
    {
      "id": "7726068f-f237-4162-a16f-fbc20b349493",
      "content": "ds : *để ông trở nên cha của mọi kẻ tin mà không được cắt bì, để họ được kể là công chính.*",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "16",
      "sortOrder": 15,
      "startOffset": 212,
      "endOffset": 212,
      "createdAt": "2025-09-03T03:47:22.523Z",
      "updatedAt": "2025-09-03T03:47:22.523Z",
      "targetId": "42111c21-cfeb-4de7-8a39-1e3bbc16f450",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "779a2d73-0a03-471f-b009-b67607037ee0"
    },
    {
      "id": "b7f41b2c-6cb8-4cd5-8162-a83cdb99c28d",
      "content": "English: Abraham | French: Abraham | Latin: Abraham | Origin: &#1488;&#1463;&#1489;&#1456;&#1512;&#1464;&#1492;&#1464;&#1501; | Vietnamese: Áp-ra-ham -- St 17,5",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "17",
      "sortOrder": 16,
      "startOffset": 127,
      "endOffset": 127,
      "createdAt": "2025-09-03T03:47:22.545Z",
      "updatedAt": "2025-09-03T03:47:22.545Z",
      "targetId": "53f8614a-5da6-407e-9335-86fd61a817b1",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "779a2d73-0a03-471f-b009-b67607037ee0"
    },
    {
      "id": "ec353014-182a-450f-ba46-07ecc4d94e87",
      "content": "ds : *ông cũng là cha của giới cắt bì, những kẻ không phải chỉ thuộc giới cắt bì mà thôi, nhưng còn dõi bước đức tin khi chưa được cắt bì của ông Áp-ra-ham, tổ phụ chúng ta.* – Cc. 11-12 : cả người ngoại lẫn người Do-thái đều thuộc dòng dõi của ông Áp-ra-ham không phải vì đã chịu phép cắt bì hay không, nhưng trên hết và căn bản nhất là vì đã tin.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "18",
      "sortOrder": 17,
      "startOffset": 188,
      "endOffset": 188,
      "createdAt": "2025-09-03T03:47:22.554Z",
      "updatedAt": "2025-09-03T03:47:22.554Z",
      "targetId": "53f8614a-5da6-407e-9335-86fd61a817b1",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "779a2d73-0a03-471f-b009-b67607037ee0"
    },
    {
      "id": "8819a41f-f1b5-4621-baa6-2ca4ec441f03",
      "content": "English: Abraham | French: Abraham | Latin: Abraham | Origin: &#1488;&#1463;&#1489;&#1456;&#1512;&#1464;&#1492;&#1464;&#1501; | Vietnamese: Áp-ra-ham -- St 17,5",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "19",
      "sortOrder": 18,
      "startOffset": 79,
      "endOffset": 79,
      "createdAt": "2025-09-03T03:47:22.587Z",
      "updatedAt": "2025-09-03T03:47:22.587Z",
      "targetId": "1913c94c-04a8-471a-aa8f-c07a36def6d2",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "779a2d73-0a03-471f-b009-b67607037ee0"
    },
    {
      "id": "cc0c2bbc-1f8d-4c3f-aef4-ec931f9eb770",
      "content": "Việc ông Áp-ra-ham được trở nên công chính đi liền với việc Thiên Chúa hứa cho dòng dõi ông được đông đảo như sao trên trời (St 15,1-6). Lời hứa của Thiên Chúa và việc ông Áp-ra-ham trở nên công chính có trước khi ông được cắt bì và độc lập với phép cắt bì, và như vậy cũng độc lập với Luật Mô-sê (Gl 3,17).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "20",
      "sortOrder": 19,
      "startOffset": 124,
      "endOffset": 124,
      "createdAt": "2025-09-03T03:47:22.598Z",
      "updatedAt": "2025-09-03T03:47:22.598Z",
      "targetId": "1913c94c-04a8-471a-aa8f-c07a36def6d2",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "779a2d73-0a03-471f-b009-b67607037ee0"
    },
    {
      "id": "f8ee8c4c-7f1a-46f8-9f73-ed5257a3ba2e",
      "content": "*Nhưng ông được lời hứa đó* : thêm vào.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "21",
      "sortOrder": 20,
      "startOffset": 152,
      "endOffset": 152,
      "createdAt": "2025-09-03T03:47:22.608Z",
      "updatedAt": "2025-09-03T03:47:22.608Z",
      "targetId": "1913c94c-04a8-471a-aa8f-c07a36def6d2",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "779a2d73-0a03-471f-b009-b67607037ee0"
    },
    {
      "id": "54401c83-f570-4c24-98d4-0af79a1e68cd",
      "content": "English: Abraham | French: Abraham | Latin: Abraham | Origin: &#1488;&#1463;&#1489;&#1456;&#1512;&#1464;&#1492;&#1464;&#1501; | Vietnamese: Áp-ra-ham -- St 17,5",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "22",
      "sortOrder": 21,
      "startOffset": 162,
      "endOffset": 162,
      "createdAt": "2025-09-03T03:47:22.661Z",
      "updatedAt": "2025-09-03T03:47:22.661Z",
      "targetId": "2721d33f-d4fc-4988-9ead-6bfff5d2be73",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "779a2d73-0a03-471f-b009-b67607037ee0"
    },
    {
      "id": "fa00b8ba-e8ad-432c-abd1-a904ad102511",
      "content": "C. 16 trong bản văn, khó ; ds : *Bởi vậy, nhờ đức tin, để trở nên ân huệ (nhưng không), lời hứa trở nên vững chắc cho tất cả dòng dõi, không chỉ cho dòng dõi theo Lề Luật, nhưng cho cả dòng dõi theo đức tin của ông Áp-ra-ham.*",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "23",
      "sortOrder": 22,
      "startOffset": 253,
      "endOffset": 253,
      "createdAt": "2025-09-03T03:47:22.671Z",
      "updatedAt": "2025-09-03T03:47:22.671Z",
      "targetId": "2721d33f-d4fc-4988-9ead-6bfff5d2be73",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "779a2d73-0a03-471f-b009-b67607037ee0"
    },
    {
      "id": "6ac1035a-a9f8-4fc5-b1b2-7ff0a2d3e479",
      "content": "Kết luận phần chứng minh và chuẩn bị cho phần sau (cc. 18-25) nói về ông Áp-ra-ham, không những ông là tổ phụ của chúng ta mà đức tin của ông còn là hình ảnh đức tin của chúng ta.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "24",
      "sortOrder": 23,
      "startOffset": 286,
      "endOffset": 286,
      "createdAt": "2025-09-03T03:47:22.682Z",
      "updatedAt": "2025-09-03T03:47:22.682Z",
      "targetId": "2721d33f-d4fc-4988-9ead-6bfff5d2be73",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "779a2d73-0a03-471f-b009-b67607037ee0"
    },
    {
      "id": "57bdd85c-1099-49e5-be5b-0e4c5a383270",
      "content": "Ám chỉ việc Thiên Chúa sáng tạo và chuẩn bị cho ý tưởng chính Đấng đã sáng tạo vũ trụ cũng là Đấng đã cho Đức Giê-su Ki-tô phục sinh (x. c.24).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "25",
      "sortOrder": 24,
      "startOffset": 191,
      "endOffset": 191,
      "createdAt": "2025-09-03T03:47:22.703Z",
      "updatedAt": "2025-09-03T03:47:22.703Z",
      "targetId": "59f9b316-c2ca-4a35-9021-6caa4b38a2b8",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "779a2d73-0a03-471f-b009-b67607037ee0"
    },
    {
      "id": "be2941d6-895b-4f28-8a89-f2662a84fa80",
      "content": "English: Abraham | French: Abraham | Latin: Abraham | Origin: &#1488;&#1463;&#1489;&#1456;&#1512;&#1464;&#1492;&#1464;&#1501; | Vietnamese: Áp-ra-ham -- St 17,5",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "26",
      "sortOrder": 25,
      "startOffset": 26,
      "endOffset": 26,
      "createdAt": "2025-09-03T03:47:22.748Z",
      "updatedAt": "2025-09-03T03:47:22.748Z",
      "targetId": "00bbd4fc-dc7a-4383-bd57-2eb5d9a7fd4f",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "779a2d73-0a03-471f-b009-b67607037ee0"
    },
    {
      "id": "e2200569-d996-4f2b-8159-0c1408c305cf",
      "content": "Nghĩa là xét theo phương diện loài người thì không còn lý do gì khiến ông Áp-ra-ham có thể hy vọng, nhưng ông vẫn hoàn toàn hy vọng vì lời Thiên Chúa đã hứa (x. cc.19-22).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "27",
      "sortOrder": 26,
      "startOffset": 64,
      "endOffset": 64,
      "createdAt": "2025-09-03T03:47:22.760Z",
      "updatedAt": "2025-09-03T03:47:22.760Z",
      "targetId": "0761a520-39b9-4b8c-b892-21e055bd5a1b",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "779a2d73-0a03-471f-b009-b67607037ee0"
    },
    {
      "id": "f789ad4a-1374-4efe-b601-eec454bbe688",
      "content": "English: Sarah | French: Sara | Latin: Sara | Origin: &#64299;&#1464;&#1512;&#1463;&#1497; | Vietnamese: Xa-ra 1 -- vợ ông Áp-ra-ham, St 17,15-22",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "28",
      "sortOrder": 27,
      "startOffset": 112,
      "endOffset": 112,
      "createdAt": "2025-09-03T03:47:22.805Z",
      "updatedAt": "2025-09-03T03:47:22.805Z",
      "targetId": "0b839535-5254-40af-91f6-3006f1695a94",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "779a2d73-0a03-471f-b009-b67607037ee0"
    },
    {
      "id": "8a53fe08-3ab7-4a9b-9765-8d608fc5e414",
      "content": "ds : *ông không yếu tin khi thấy rằng thân xác của ông đã chết – vì ông đã gần một trăm tuổi – và dạ của bà Xa-ra cũng đã chết.* Không hiểu chết theo nghĩa thông thường, nhưng ngụ ý nói hai ông bà tổ phụ không thể sinh con được nữa, thế mà vẫn vững tin lời Thiên Chúa hứa sẽ ban cho mình một dòng dõi đông đảo (x. c.18).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "29",
      "sortOrder": 28,
      "startOffset": 124,
      "endOffset": 124,
      "createdAt": "2025-09-03T03:47:22.816Z",
      "updatedAt": "2025-09-03T03:47:22.816Z",
      "targetId": "0b839535-5254-40af-91f6-3006f1695a94",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "779a2d73-0a03-471f-b009-b67607037ee0"
    },
    {
      "id": "caf762d9-712d-4fd6-a11f-f8a030a489fd",
      "content": "ds : ... *ông không vì bất tín mà do dự, nhưng đã nên vững mạnh nhờ đức tin.* – *Tôn vinh Thiên Chúa* : thái độ của người cậy trông Thiên Chúa, nhìn nhận rằng những gì mình có đều là do Người.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "30",
      "sortOrder": 29,
      "startOffset": 135,
      "endOffset": 135,
      "createdAt": "2025-09-03T03:47:22.836Z",
      "updatedAt": "2025-09-03T03:47:22.836Z",
      "targetId": "684f3d33-6d66-4f6e-8e4a-b9927aaaec31",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "779a2d73-0a03-471f-b009-b67607037ee0"
    },
    {
      "id": "1d592857-1403-42cc-a630-55bac45b066c",
      "content": "English: Jesus | French: Jésus | Latin: Iesu | Origin: &#921;&#951;&#963;&#959;&#965;&#962; | Vietnamese: Giê-su 1 -- con ông Xi-ra, Hc (lt) ; 50,27.51",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "31",
      "sortOrder": 30,
      "startOffset": 104,
      "endOffset": 104,
      "createdAt": "2025-09-03T03:47:22.906Z",
      "updatedAt": "2025-09-03T03:47:22.906Z",
      "targetId": "81d162dc-566f-4bb1-be45-2233c9db9f99",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "779a2d73-0a03-471f-b009-b67607037ee0"
    },
    {
      "id": "d05579e1-428e-4ad6-9195-4c00e76afc5c",
      "content": "English: Jesus | French: Jésus | Latin: Iesu | Origin: &#921;&#951;&#963;&#959;&#965;&#962; | Vietnamese: Giê-su 1 -- con ông Xi-ra, Hc (lt) ; 50,27.51",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "32",
      "sortOrder": 31,
      "startOffset": 10,
      "endOffset": 10,
      "createdAt": "2025-09-03T03:47:22.931Z",
      "updatedAt": "2025-09-03T03:47:22.931Z",
      "targetId": "e46a6525-e60e-4590-97b7-4a4b16a302d5",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "779a2d73-0a03-471f-b009-b67607037ee0"
    },
    {
      "id": "471a7979-2f27-41f4-aab4-dbbc6dd6c2e4",
      "content": "Ý tưởng mở rộng ra : ông Áp-ra-ham được Thiên Chúa kể là công chính vì ông đã tin và vì tin ông nhận được lời Thiên Chúa hứa, trước khi có Lề Luật. Như vậy phép cắt bì mà Lề Luật dạy cũng có sau khi ông Áp-ra-ham đã tin, và chỉ là dấu hiệu chứng tỏ ông đã được nên công chính và được hưởng lời hứa. Ông trở thành tổ phụ của tất cả những người tin – thuộc giới cắt bì hay không thuộc giới cắt bì – vì ông tin lời Thiên Chúa, Đấng đã cho Đức Giê-su Ki-tô phục sinh. Và trong công trình đó, Thiên Chúa làm cho chúng ta nên công chính.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "33",
      "sortOrder": 32,
      "startOffset": 130,
      "endOffset": 130,
      "createdAt": "2025-09-03T03:47:22.944Z",
      "updatedAt": "2025-09-03T03:47:22.944Z",
      "targetId": "e46a6525-e60e-4590-97b7-4a4b16a302d5",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "779a2d73-0a03-471f-b009-b67607037ee0"
    }
  ],
  "headings": [
    {
      "id": "5ee26fe1-cb77-452c-8b64-c538876c8bd2",
      "text": "C. GƯƠNG TỔ PHỤ ÁP-RA-HAM",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:47:22.166Z",
      "updatedAt": "2025-09-03T03:47:22.166Z",
      "verseId": "efa2165b-f80c-4f01-aad1-9f7285dedef5",
      "chapterId": "779a2d73-0a03-471f-b009-b67607037ee0"
    },
    {
      "id": "3dcb3d22-ca26-47f8-8248-f850a9681843",
      "text": "Không phải vì chịu phép cắt bì",
      "level": 2,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:47:22.440Z",
      "updatedAt": "2025-09-03T03:47:22.440Z",
      "verseId": "f3c1b3ee-987a-4770-8bdd-cfe4214fc4d6",
      "chapterId": "779a2d73-0a03-471f-b009-b67607037ee0"
    },
    {
      "id": "85777e72-ed26-4554-81ab-4b3a97c2d666",
      "text": "Không phải vì giữ Lề Luật",
      "level": 2,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:47:22.577Z",
      "updatedAt": "2025-09-03T03:47:22.577Z",
      "verseId": "1913c94c-04a8-471a-aa8f-c07a36def6d2",
      "chapterId": "779a2d73-0a03-471f-b009-b67607037ee0"
    },
    {
      "id": "00bbd4fc-dc7a-4383-bd57-2eb5d9a7fd4f",
      "text": "Lòng tin của ông Áp-ra-ham và lòng tin của chúng ta",
      "level": 2,
      "sortOrder": 0,
      "createdAt": "2025-09-03T03:47:22.736Z",
      "updatedAt": "2025-09-03T03:47:22.736Z",
      "verseId": "0761a520-39b9-4b8c-b892-21e055bd5a1b",
      "chapterId": "779a2d73-0a03-471f-b009-b67607037ee0"
    },
    {
      "id": "28cc3faa-8ab8-4be3-bcc7-243136fe41ca",
      "text": "Ông Áp-ra-ham được nên công chính vì đã tin",
      "level": 2,
      "sortOrder": 1,
      "createdAt": "2025-09-03T03:47:22.180Z",
      "updatedAt": "2025-09-03T03:47:22.180Z",
      "verseId": "efa2165b-f80c-4f01-aad1-9f7285dedef5",
      "chapterId": "779a2d73-0a03-471f-b009-b67607037ee0"
    }
  ],
