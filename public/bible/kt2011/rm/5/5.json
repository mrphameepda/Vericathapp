      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ab45ff52-b853-4988-ae97-251d35d29b09"
    },
    {
      "id": "edea22a1-5078-49fb-91bd-c35b63b8f2e7",
      "content": "Có cách dịch khác : *chúng ta hãy sống hoà hợp* ; ds : c*húng ta sống bình an.* Bình an là một ân huệ hơn là một điều kiện tâm hồn phải có đối với Chúa (x. Lc 1,79 ; Ga 14,27 ; 20,19.21.26 ; Ep 2,17).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 85,
      "endOffset": 85,
      "createdAt": "2025-09-03T03:47:31.161Z",
