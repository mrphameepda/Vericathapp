  "headings": [
    {
      "id": "af4e0255-9b2c-4853-8e51-e138ea8f6fb2",
      "text": "2. THIÊN CHÚA CỨU ĐỘ CON NGƯỜI",
      "level": 1,
      "sortOrder": 0,
