    },
    {
      "id": "82898e9e-3a52-4dbc-b125-bec96e029a53",
      "content": "1 Cr 15,21-22",
      "kind": "MARK_KIND_REFERENCE",
      "label": "7@",
      "sortOrder": 6,
      "startOffset": 18,
      "endOffset": 18,
      "createdAt": "2025-09-03T03:47:31.949Z",
      "updatedAt": "2025-09-03T03:47:31.949Z",
      "targetId": "e7cf34ab-0266-4f9c-b54e-a99b959a5c37",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ab45ff52-b853-4988-ae97-251d35d29b09"
    },
    {
      "id": "378b9900-838b-45bb-acab-eaf7e58bcfdd",
      "content": "Bản Phổ thông dịch : ... *vinh quang của con cái Thiên Chúa.*",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "8",
      "sortOrder": 7,
      "startOffset": 199,
      "endOffset": 199,
      "createdAt": "2025-09-03T03:47:31.243Z",
      "updatedAt": "2025-09-03T03:47:31.243Z",
      "targetId": "5b81c9cf-cda6-4638-8fdc-0990609f0748",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ab45ff52-b853-4988-ae97-251d35d29b09"
    },
    {
      "id": "a0f1f26e-449a-4df4-ad19-52847fce5b0b",
      "content": "Pl 2,8-9",
      "kind": "MARK_KIND_REFERENCE",
      "label": "8@",
      "sortOrder": 7,
      "startOffset": 131,
      "endOffset": 131,
      "createdAt": "2025-09-03T03:47:31.992Z",
      "updatedAt": "2025-09-03T03:47:31.992Z",
      "targetId": "8101bb21-a598-47cd-a024-217bf4a2a44f",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ab45ff52-b853-4988-ae97-251d35d29b09"
    },
    {
      "id": "a88216ae-9227-4e4d-aea9-184f0113e720",
      "content": "*Gian truân*. Theo thánh Phao-lô, đó là điều người tín hữu (x. Cv 11,19 ; 17,5-6 ; 2 Cr 1,4-5 ; Pl 4,14) phải đón nhận, khó tránh khỏi (x. Ga 16,33 ; Cv 14,22 ; 1 Tx 3,3). Đó là dấu hiệu thời cánh chung (x. Mt 24,9-28 ; Kh 1,9 ; 7,14).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "9",
      "sortOrder": 8,
      "startOffset": 68,
      "endOffset": 68,
      "createdAt": "2025-09-03T03:47:31.266Z",
      "updatedAt": "2025-09-03T03:47:31.266Z",
      "targetId": "047cfcff-9a99-474f-8e97-d4125726b0d4",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ab45ff52-b853-4988-ae97-251d35d29b09"
    },
    {
      "id": "ab24c414-20a6-4be2-82fb-7430f9e7c39d",
      "content": "Is 53,11",
      "kind": "MARK_KIND_REFERENCE",
      "label": "9@",
      "sortOrder": 8,
      "startOffset": 183,
      "endOffset": 183,
      "createdAt": "2025-09-03T03:47:32.006Z",
      "updatedAt": "2025-09-03T03:47:32.006Z",
      "targetId": "8101bb21-a598-47cd-a024-217bf4a2a44f",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ab45ff52-b853-4988-ae97-251d35d29b09"
    },
    {
      "id": "449ad397-53b1-472c-8f6f-965708e73f2c",
      "content": "ds cc. 3b-4 : *gian truân làm nên bền chí* (x. 2,17), *bền chí làm nên lão luyện, lão luyện làm nên hy vọng.* – *Kể là người trung kiên*. ds : *lão luyện, đã được thử thách* ; người hoặc vật đã được thử để biết chắc tính chất hoặc khả năng (x. 2 Cr 8,2 ; 1 Pr 1,6-7). – *Chịu đựng*. ds : *bền chí, kiên trì.*",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "10",
      "sortOrder": 9,
      "startOffset": 121,
      "endOffset": 121,
      "createdAt": "2025-09-03T03:47:31.277Z",
      "updatedAt": "2025-09-03T03:47:31.277Z",
      "targetId": "047cfcff-9a99-474f-8e97-d4125726b0d4",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ab45ff52-b853-4988-ae97-251d35d29b09"
    },
    {
      "id": "82ba258a-91c0-472a-8a96-9599ee76413a",
      "content": "Gl 3,19",
      "kind": "MARK_KIND_REFERENCE",
      "label": "10@",
      "sortOrder": 9,
      "startOffset": 30,
      "endOffset": 30,
      "createdAt": "2025-09-03T03:47:32.053Z",
      "updatedAt": "2025-09-03T03:47:32.053Z",
      "targetId": "d4a2f632-dc77-43af-a01e-1b7e55862647",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ab45ff52-b853-4988-ae97-251d35d29b09"
    },
    {
      "id": "9e54d0aa-89d3-47c2-96bd-7ce65fe47e93",
      "content": "*Trông cậy như thế sẽ không phải thất vọng*. ds : *hy vọng không làm cho xấu hổ.*",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "11",
      "sortOrder": 10,
      "startOffset": 51,
      "endOffset": 51,
      "createdAt": "2025-09-03T03:47:31.337Z",
      "updatedAt": "2025-09-03T03:47:31.337Z",
      "targetId": "e7ce9316-d6bb-4363-8952-6a7a94616341",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ab45ff52-b853-4988-ae97-251d35d29b09"
    },
    {
      "id": "fd094918-26a4-4c2b-a637-372a4ae7603e",
      "content": "Chúa Thánh Thần hiện diện nơi chúng ta là bằng chứng Thiên Chúa yêu thương chúng ta, đồng thời Chúa Thánh Thần cũng giúp cho ta đáp trả tình yêu Thiên Chúa (x. Gl 4,6) và đối xử với anh em cũng bằng tình yêu ấy (x. Ga 14,26). Thánh Thần là tình yêu liên kết chúng ta với Thiên Chúa và với anh em.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "12",
      "sortOrder": 11,
      "startOffset": 151,
      "endOffset": 151,
      "createdAt": "2025-09-03T03:47:31.349Z",
      "updatedAt": "2025-09-03T03:47:31.349Z",
      "targetId": "e7ce9316-d6bb-4363-8952-6a7a94616341",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ab45ff52-b853-4988-ae97-251d35d29b09"
    },
    {
      "id": "f97677a6-24d5-40d5-9f13-ca89e0f69955",
      "content": "*Không có sức làm được gì*. Không có trong bản văn, thêm vào cho dễ hiểu ý tưởng : chúng ta không thể tự giải thoát khỏi tội lỗi.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "13",
      "sortOrder": 12,
      "startOffset": 46,
      "endOffset": 46,
      "createdAt": "2025-09-03T03:47:31.372Z",
      "updatedAt": "2025-09-03T03:47:31.372Z",
      "targetId": "1a63efad-c232-475c-a0c1-00578b9ed4ec",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ab45ff52-b853-4988-ae97-251d35d29b09"
    },
    {
      "id": "8630b956-59e1-458c-bbfa-cb0f4df4fed5",
      "content": "*Đúng kỳ hạn* : Thiên Chúa đã có một chương trình hành động để cứu độ con người , chứ không theo ngẫu hứng (x. Gl 4,4).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "14",
      "sortOrder": 13,
      "startOffset": 96,
      "endOffset": 96,
      "createdAt": "2025-09-03T03:47:31.383Z",
      "updatedAt": "2025-09-03T03:47:31.383Z",
      "targetId": "1a63efad-c232-475c-a0c1-00578b9ed4ec",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ab45ff52-b853-4988-ae97-251d35d29b09"
    },
    {
      "id": "ce3ff650-d012-4f92-ac44-ca0396ffaedb",
      "content": "English: Christ | French: Chist | Latin: Christus | Origin: &#935;&#961;&#953;&#964;&#959;&#962; | Vietnamese: Ki-tô -- Mt 1,18",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "15",
      "sortOrder": 14,
      "startOffset": 107,
      "endOffset": 107,
      "createdAt": "2025-09-03T03:47:31.395Z",
      "updatedAt": "2025-09-03T03:47:31.395Z",
      "targetId": "1a63efad-c232-475c-a0c1-00578b9ed4ec",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ab45ff52-b853-4988-ae97-251d35d29b09"
    },
    {
      "id": "8524174c-4537-4128-95a7-9cb2b7632156",
      "content": "English: Christ | French: Chist | Latin: Christus | Origin: &#935;&#961;&#953;&#964;&#959;&#962; | Vietnamese: Ki-tô -- Mt 1,18",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "16",
      "sortOrder": 15,
      "startOffset": 16,
      "endOffset": 16,
      "createdAt": "2025-09-03T03:47:31.430Z",
      "updatedAt": "2025-09-03T03:47:31.430Z",
      "targetId": "8d93731a-bf00-4017-9f81-5903d79ee43a",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ab45ff52-b853-4988-ae97-251d35d29b09"
    },
    {
      "id": "f84d3da2-8c1f-4134-8db0-0a17483afac7",
      "content": "ds : *Nhưng Thiên Chúa đã chứng tỏ lòng yêu thương của Người đối với chúng ta : ngay khi chúng ta còn là những người tội lỗi, Đức Ki-tô đã chết vì chúng ta.*",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "17",
      "sortOrder": 16,
      "startOffset": 131,
      "endOffset": 131,
      "createdAt": "2025-09-03T03:47:31.443Z",
      "updatedAt": "2025-09-03T03:47:31.443Z",
      "targetId": "8d93731a-bf00-4017-9f81-5903d79ee43a",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ab45ff52-b853-4988-ae97-251d35d29b09"
    },
    {
      "id": "0a5580ff-bce8-4397-be52-8bca82ac0e9a",
      "content": "English: Christ | French: Chist | Latin: Christus | Origin: &#935;&#961;&#953;&#964;&#959;&#962; | Vietnamese: Ki-tô -- Mt 1,18",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "18",
      "sortOrder": 17,
      "startOffset": 68,
      "endOffset": 68,
      "createdAt": "2025-09-03T03:47:31.482Z",
      "updatedAt": "2025-09-03T03:47:31.482Z",
      "targetId": "80cde4ff-4d04-454e-a58a-82021ce4826c",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ab45ff52-b853-4988-ae97-251d35d29b09"
    },
    {
      "id": "2d593049-d83f-40db-b261-bb3c6274c0c4",
      "content": "ds : *ngay lúc chúng ta còn là những thù địch.*",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "19",
      "sortOrder": 18,
      "startOffset": 61,
      "endOffset": 61,
      "createdAt": "2025-09-03T03:47:31.507Z",
      "updatedAt": "2025-09-03T03:47:31.507Z",
      "targetId": "8e1a35cf-a38e-492f-8eda-c9390c5bea98",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ab45ff52-b853-4988-ae97-251d35d29b09"
    },
    {
      "id": "8cf71e0a-ef1d-4af8-b3f5-3f499156cee8",
      "content": "Ngay từ bây giờ người tín hữu đã được Thiên Chúa cho nên công chính (c.9), được hoà giải với Người (c.10) nhờ Đức Ki-tô đã chết và phục sinh (c.10), nhưng vẫn còn hy vọng ơn cứu thoát trọn vẹn Thiên Chúa sẽ thực hiện trong tương lai (cc 9-10). Rm 5,9-11 = Rm 5,2 = Rm 8,11.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "20",
      "sortOrder": 19,
      "startOffset": 252,
      "endOffset": 252,
      "createdAt": "2025-09-03T03:47:31.520Z",
      "updatedAt": "2025-09-03T03:47:31.520Z",
      "targetId": "8e1a35cf-a38e-492f-8eda-c9390c5bea98",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ab45ff52-b853-4988-ae97-251d35d29b09"
    },
    {
      "id": "049b27b0-6974-4ed8-be0d-6a659c6e8f6a",
      "content": "English: Jesus | French: Jésus | Latin: Iesu | Origin: &#921;&#951;&#963;&#959;&#965;&#962; | Vietnamese: Giê-su 1 -- con ông Xi-ra, Hc (lt) ; 50,27.51",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "21",
      "sortOrder": 20,
      "startOffset": 86,
      "endOffset": 86,
      "createdAt": "2025-09-03T03:47:31.563Z",
      "updatedAt": "2025-09-03T03:47:31.563Z",
      "targetId": "cb764f2d-723c-4ab4-9b0f-adb247ce3457",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ab45ff52-b853-4988-ae97-251d35d29b09"
    },
    {
      "id": "07e48ba7-49e3-4373-a21b-750594532e65",
      "content": "ds : ... *chúng ta còn tự hào trong Thiên Chúa, nhờ Đức Giê-su Ki-tô, Chúa chúng ta, nhờ Người, (ngay từ) bây giờ, chúng ta đã lãnh nhận ơn hoà giải* : không phải chỉ chờ đợi Thiên Chúa hoàn tất ơn cứu độ trong tương lai, mà ngay từ bây giờ đã được hãnh diện trong Thiên Chúa, chắc chắn sẽ được ơn cứu độ.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "22",
      "sortOrder": 21,
      "startOffset": 153,
      "endOffset": 153,
      "createdAt": "2025-09-03T03:47:31.576Z",
      "updatedAt": "2025-09-03T03:47:31.576Z",
      "targetId": "cb764f2d-723c-4ab4-9b0f-adb247ce3457",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ab45ff52-b853-4988-ae97-251d35d29b09"
    },
    {
      "id": "2e2aabd8-7f79-4184-b148-559a12eda9d0",
      "content": "Thánh Phao-lô lý luận ngược trở về quá khứ để đối chọi giữa A-đam với Đức Ki-tô, giữa sự chết và sự sống, giữa Lề Luật và ân sủng, giữa tội lỗi và ơn được nên công chính. Người muốn chứng minh rằng thời kỳ cứu độ đã bắt đầu với con người và việc làm của Đức Ki-tô, vượt tất cả những gì trong quá khứ. Lề Luật thuộc về thời quá khứ, không còn vai trò gì trong công cuộc cứu độ.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "23",
      "sortOrder": 22,
      "startOffset": 60,
      "endOffset": 60,
      "createdAt": "2025-09-03T03:47:31.613Z",
      "updatedAt": "2025-09-03T03:47:31.613Z",
      "targetId": "e0949bf4-c9d2-4971-8d16-1a9856b4bf27",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "ab45ff52-b853-4988-ae97-251d35d29b09"
    },
    {
      "id": "822d122f-b965-40e2-9f97-f1dc5c0001ae",
      "content": "English: Adam | French: Adam | Latin: Adam | Origin: &#1488;&#1464;&#1491;&#1464;&#1501; | Vietnamese: A-đam 1 -- thủy tổ loài người, St 4,25",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "24",
      "sortOrder": 23,
      "startOffset": 5,
      "endOffset": 5,
      "createdAt": "2025-09-03T03:47:31.637Z",
      "updatedAt": "2025-09-03T03:47:31.637Z",
      "targetId": "a2b516aa-a814-44ea-8fc1-ad51f5740e86",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "ab45ff52-b853-4988-ae97-251d35d29b09"
    },
    {
      "id": "9c82c3a6-afc0-4b15-ae28-26a32d08c247",
      "content": "English: Christ | French: Chist | Latin: Christus | Origin: &#935;&#961;&#953;&#964;&#959;&#962; | Vietnamese: Ki-tô -- Mt 1,18",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "25",
      "sortOrder": 24,
      "startOffset": 18,
      "endOffset": 18,
      "createdAt": "2025-09-03T03:47:31.648Z",
      "updatedAt": "2025-09-03T03:47:31.648Z",
      "targetId": "a2b516aa-a814-44ea-8fc1-ad51f5740e86",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "ab45ff52-b853-4988-ae97-251d35d29b09"
    },
    {
      "id": "c23eb797-6aaa-4c1c-b814-53a6e69e44be",
      "content": "Rm 5,12-21 so sánh Đức Ki-tô với A-đam và cho thấy Đức Ki-tô trổi vượt A-đam. A-đam là căn nguyên của tội lỗi, Đức Ki-tô là nguồn mạch sự sống và ơn được nên công chính. Rm 5,12-21 là một loạt những đối chọi giữa hai nhân vật A-đam và Đức Giê-su : tội của A-đam, ân sủng của Đức Giê-su (c.15) ; án xử đưa đến án phạt, ân sủng ban cho được nên công chính (c.16) ; tội của A-đam làm cho sự chết thống trị ; ơn được nên công chính cho những ai đã lãnh nhận được thống trị (c.17) ; tội của một người sinh ra án phạt, việc làm của một người đem lại ơn được nên công chính (c.18) ; sự bất tuân tạo ra các tội nhân, sự tuân phục tạo nên những người công chính, tội gia tăng, thống trị và đem lại sự chết, ân sủng thống trị bởi sự công chính và chuẩn bị được sống vĩnh cửu (c.20-21).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "26",
      "sortOrder": 25,
      "startOffset": 25,
      "endOffset": 25,
      "createdAt": "2025-09-03T03:47:31.661Z",
      "updatedAt": "2025-09-03T03:47:31.661Z",
      "targetId": "a2b516aa-a814-44ea-8fc1-ad51f5740e86",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "ab45ff52-b853-4988-ae97-251d35d29b09"
    },
    {
      "id": "cf8cf6af-641a-438b-afa5-8e955f96fce7",
      "content": "Cách dùng chữ tội lỗi và sự chết cho phép hiểu thánh Phao-lô nhân cách hoá tội lỗi và sự chết thành một sức lực xấu hoạt động trong trần gian nhằm làm cho con người xa cách Thiên Chúa, đưa con người đến chỗ đối nghịch với Thiên Chúa và vì thế sinh ra *sự chết* về phương diện thiêng liêng mà cái chết về thể lý là dấu hiệu.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "27",
      "sortOrder": 26,
      "startOffset": 83,
      "endOffset": 83,
      "createdAt": "2025-09-03T03:47:31.675Z",
      "updatedAt": "2025-09-03T03:47:31.675Z",
      "targetId": "d758c094-cf1f-4896-936c-3f65a70cbd4e",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ab45ff52-b853-4988-ae97-251d35d29b09"
    },
    {
      "id": "95fc9d30-591b-4391-b58a-66d8e9e7cc89",
      "content": "Có nhiều cách giải thích một chữ trong bản văn Hy-lạp : 1) *trong đó* mọi người đã phạm tội, nghĩa là trong tội của A-đam (các bản dịch La-tinh và các nhà thần học từ thánh Âu-tinh đến Ca-gi-tan theo cách này) ; 2) *vì ông* (ông A-đam) mà mọi người đã phạm tội (một số giáo phụ Hy-lạp) ; 3) *bởi vì* (nhiều giáo phụ Hy-lạp và các nhà chú giải hiện nay) ... Ý nghĩa chung : quyền lực tội lỗi vào trần gian qua tội A-đam, tội đầu tiên. Qua đó sự chết lan tràn tới mọi người vì các tội riêng của họ. Các tội riêng đó xác nhận rằng tội A-đam đã tràn tới họ. Giáo lý về tội nguyên tổ.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "28",
      "sortOrder": 27,
      "startOffset": 158,
      "endOffset": 158,
      "createdAt": "2025-09-03T03:47:31.689Z",
      "updatedAt": "2025-09-03T03:47:31.689Z",
      "targetId": "d758c094-cf1f-4896-936c-3f65a70cbd4e",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ab45ff52-b853-4988-ae97-251d35d29b09"
    },
    {
      "id": "8a83f962-d1fa-4682-8e39-534405ae7a89",
      "content": "Trước khi có Lề Luật. ds : *cho đến Lề Luật*. Nghĩa là từ A-đam cho đến Mô-sê.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "29",
      "sortOrder": 28,
      "startOffset": 20,
      "endOffset": 20,
      "createdAt": "2025-09-03T03:47:31.730Z",
      "updatedAt": "2025-09-03T03:47:31.730Z",
      "targetId": "1af81277-e56e-400a-ab71-1523fb07a5bf",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ab45ff52-b853-4988-ae97-251d35d29b09"
    },
    {
      "id": "8e41985b-11c8-454a-af2d-006d461de982",
      "content": "Cc. 13-14 xác quyết rằng : nếu những người sống trong khoảng thời gian từ ông A-đam đến ông Mô-sê đều ở dưới quyền thống trị của sự chết, thì đó là do hậu quả đương nhiên của tội : tội của A-đam ảnh hưởng đến tất cả nhân loại, giam hãm nhân loại trong thế lực của sự chết cho tới ngày Đức Ki-tô đến (x. Rm 11,32 ; Gl 3,22).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "30",
      "sortOrder": 29,
      "startOffset": 100,
      "endOffset": 100,
      "createdAt": "2025-09-03T03:47:31.744Z",
      "updatedAt": "2025-09-03T03:47:31.744Z",
      "targetId": "1af81277-e56e-400a-ab71-1523fb07a5bf",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ab45ff52-b853-4988-ae97-251d35d29b09"
    },
    {
      "id": "df7c0d2a-603d-47c8-83a4-066a265bfb5c",
      "content": "English: Adam | French: Adam | Latin: Adam | Origin: &#1488;&#1464;&#1491;&#1464;&#1501; | Vietnamese: A-đam 1 -- thủy tổ loài người, St 4,25",
      "kind": "MARK_KIND_FOOTNOTE",
