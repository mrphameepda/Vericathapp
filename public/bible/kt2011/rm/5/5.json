      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ab45ff52-b853-4988-ae97-251d35d29b09"
    },
    {
      "id": "21689eb5-7183-4ee5-abdb-831122fc1911",
      "content": "Gc 1,2-4",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 40,
      "endOffset": 40,
      "createdAt": "2025-09-03T03:47:31.314Z",
      "updatedAt": "2025-09-03T03:47:31.314Z",
      "targetId": "e71bd987-3c78-4fe9-b755-52cef5289546",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ab45ff52-b853-4988-ae97-251d35d29b09"
    },
    {
