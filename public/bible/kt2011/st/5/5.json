{
  "chapter": {
    "id": "a39e3149-235d-4bf5-83f7-c3658386c65d",
    "number": 5,
    "createdAt": "2025-09-03T01:07:51.393Z",
    "updatedAt": "2025-09-03T01:07:51.393Z",
    "bookId": "2702e3aa-93c2-4460-823f-4233bc59bea8"
  },
  "verses": [
    {
      "id": "ddf9b68e-67bb-496e-be53-5beaf8573cca",
      "text": "Đây là gia phả ông A-đam : Ngày Thiên Chúa sáng tạo con người, Chúa làm ra con người giống như Thiên Chúa.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:08:39.649Z",
      "updatedAt": "2025-09-03T01:08:39.649Z",
      "chapterId": "a39e3149-235d-4bf5-83f7-c3658386c65d"
    },
    {
      "id": "9b2b7d89-8815-41fe-976a-256693aa586a",
      "text": "Chúa sáng tạo con người có nam có nữ, Chúa ban phúc lành cho họ và đặt tên cho họ là “người”, ngày họ được sáng tạo.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 1,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:08:39.711Z",
      "updatedAt": "2025-09-03T01:08:39.711Z",
      "chapterId": "a39e3149-235d-4bf5-83f7-c3658386c65d"
    },
    {
      "id": "fe310e40-f0da-416b-a6f9-64f6624ada72",
      "text": "Khi ông A-đam được một trăm ba mươi tuổi, thì ông sinh ra một người con trai giống như ông, theo hình ảnh ông, và đặt tên là Sết.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:08:39.721Z",
      "updatedAt": "2025-09-03T01:08:39.721Z",
      "chapterId": "a39e3149-235d-4bf5-83f7-c3658386c65d"
    },
    {
      "id": "5706bf2b-8c1a-46ed-9a93-4b05687ad37a",
      "text": "Sau khi sinh ông Sết, ông A-đam sống tám trăm năm và sinh ra con trai con gái.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 1,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:08:39.757Z",
      "updatedAt": "2025-09-03T01:08:39.757Z",
      "chapterId": "a39e3149-235d-4bf5-83f7-c3658386c65d"
    },
    {
      "id": "0d348e28-84e2-41e9-90b6-15bacb4a2d0f",
      "text": "Tổng cộng ông A-đam sống được chín trăm ba mươi năm, rồi qua đời.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 2,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:08:39.799Z",
      "updatedAt": "2025-09-03T01:08:39.799Z",
      "chapterId": "a39e3149-235d-4bf5-83f7-c3658386c65d"
    },
    {
      "id": "b8b95b06-9fec-406a-af8a-00763f9de342",
      "text": "Khi ông Sết được một trăm lẻ năm tuổi, thì sinh ra E-nốt.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:08:39.819Z",
      "updatedAt": "2025-09-03T01:08:39.819Z",
      "chapterId": "a39e3149-235d-4bf5-83f7-c3658386c65d"
    },
    {
      "id": "55995a6d-6c1c-493f-8638-50951d3ea88c",
      "text": "Sau khi sinh E-nốt, ông Sết sống tám trăm lẻ bảy năm và sinh ra con trai con gái.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 1,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:08:39.862Z",
      "updatedAt": "2025-09-03T01:08:39.862Z",
      "chapterId": "a39e3149-235d-4bf5-83f7-c3658386c65d"
    },
    {
      "id": "c5e78468-22f9-4057-b069-9e2137e279c2",
      "text": "Tổng cộng ông Sết sống được chín trăm mười hai năm, rồi qua đời.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 2,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:08:39.906Z",
      "updatedAt": "2025-09-03T01:08:39.906Z",
      "chapterId": "a39e3149-235d-4bf5-83f7-c3658386c65d"
    },
    {
      "id": "6ca8ac4e-1e4c-4e88-95cf-d9ef64fa52e7",
      "text": "Khi ông E-nốt được chín mươi tuổi, thì sinh ra Kê-nan.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:08:39.936Z",
      "updatedAt": "2025-09-03T01:08:39.936Z",
      "chapterId": "a39e3149-235d-4bf5-83f7-c3658386c65d"
    },
    {
      "id": "45f0f326-5841-4137-9f1e-acb5c937a046",
      "text": "Sau khi sinh Kê-nan, ông E-nốt sống tám trăm mười lăm năm và sinh ra con trai con gái.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 1,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:08:39.980Z",
      "updatedAt": "2025-09-03T01:08:39.980Z",
      "chapterId": "a39e3149-235d-4bf5-83f7-c3658386c65d"
    },
    {
      "id": "68c165a3-4687-4dfc-919f-58ed1389838c",
      "text": "Tổng cộng ông E-nốt sống được chín trăm lẻ năm năm, rồi qua đời.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 2,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:08:40.020Z",
      "updatedAt": "2025-09-03T01:08:40.020Z",
      "chapterId": "a39e3149-235d-4bf5-83f7-c3658386c65d"
    },
    {
      "id": "64c127a7-0fe3-4ff8-b432-ee8c76602d2c",
      "text": "Khi ông Kê-nan được bảy mươi tuổi, thì sinh ra Ma-ha-lan-ên.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:08:40.040Z",
      "updatedAt": "2025-09-03T01:08:40.040Z",
      "chapterId": "a39e3149-235d-4bf5-83f7-c3658386c65d"
    },
    {
      "id": "e3f6402d-6cf9-4baa-ae97-a7ed2659f847",
      "text": "Sau khi sinh Ma-ha-lan-ên, ông Kê-nan sống tám trăm bốn mươi năm và sinh ra con trai con gái.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 1,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:08:40.082Z",
      "updatedAt": "2025-09-03T01:08:40.082Z",
      "chapterId": "a39e3149-235d-4bf5-83f7-c3658386c65d"
    },
    {
      "id": "7091e3d5-a01b-4b4b-8c89-aaeb90a4690f",
      "text": "Tổng cộng ông Kê-nan sống được chín trăm mười năm, rồi qua đời.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 2,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:08:40.122Z",
      "updatedAt": "2025-09-03T01:08:40.122Z",
      "chapterId": "a39e3149-235d-4bf5-83f7-c3658386c65d"
    },
    {
      "id": "1bdc5946-c118-45a0-9831-e8c9a9c6ac33",
      "text": "Khi ông Ma-ha-lan-ên được sáu mươi lăm tuổi, thì sinh ra Gie-rét.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:08:40.142Z",
      "updatedAt": "2025-09-03T01:08:40.142Z",
      "chapterId": "a39e3149-235d-4bf5-83f7-c3658386c65d"
    },
    {
      "id": "687e0083-a991-4969-b3a4-da0ec81d684f",
      "text": "Sau khi sinh Gie-rét, ông Ma-ha-lan-ên sống tám trăm ba mươi năm và sinh ra con trai con gái.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 1,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:08:40.164Z",
      "updatedAt": "2025-09-03T01:08:40.164Z",
      "chapterId": "a39e3149-235d-4bf5-83f7-c3658386c65d"
    },
    {
      "id": "56c135e4-ada5-40cf-8907-923b3c9df4c6",
      "text": "Tổng cộng ông Ma-ha-lan-ên sống được tám trăm chín mươi lăm năm, rồi qua đời.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 2,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:08:40.185Z",
      "updatedAt": "2025-09-03T01:08:40.185Z",
      "chapterId": "a39e3149-235d-4bf5-83f7-c3658386c65d"
    },
    {
      "id": "f2fda03d-9a2d-4cc3-b779-7dc49ab6304b",
      "text": "Khi ông Gie-rét sống được một trăm sáu mươi hai tuổi, thì sinh ra Kha-nốc.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:08:40.204Z",
      "updatedAt": "2025-09-03T01:08:40.204Z",
      "chapterId": "a39e3149-235d-4bf5-83f7-c3658386c65d"
    },
    {
      "id": "ba1718cb-b962-4782-963f-76fd057dccc8",
      "text": "Sau khi sinh Kha-nốc, ông Gie-rét sống tám trăm năm và sinh ra con trai con gái.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 1,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:08:40.225Z",
      "updatedAt": "2025-09-03T01:08:40.225Z",
      "chapterId": "a39e3149-235d-4bf5-83f7-c3658386c65d"
    },
    {
      "id": "270f90a2-191b-4592-8c78-7617798c0757",
      "text": "Tổng cộng ông Gie-rét sống được chín trăm sáu mươi hai năm, rồi qua đời.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 2,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:08:40.249Z",
      "updatedAt": "2025-09-03T01:08:40.249Z",
      "chapterId": "a39e3149-235d-4bf5-83f7-c3658386c65d"
    },
    {
      "id": "9f82ed60-31a3-44d4-8aa7-73c072075d7b",
      "text": "Khi ông Kha-nốc được sáu mươi lăm tuổi, thì sinh ra Mơ-thu-se-lác.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:08:40.260Z",
      "updatedAt": "2025-09-03T01:08:40.260Z",
      "chapterId": "a39e3149-235d-4bf5-83f7-c3658386c65d"
    },
    {
      "id": "109218d3-bc6a-4f65-a0ad-facbb69a5c97",
      "text": "Sau khi sinh Mơ-thu-se-lác, ông Kha-nốc đi với Thiên Chúa ba trăm năm và sinh ra con trai con gái.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 1,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:08:40.298Z",
      "updatedAt": "2025-09-03T01:08:40.298Z",
      "chapterId": "a39e3149-235d-4bf5-83f7-c3658386c65d"
    },
    {
      "id": "60f99248-b3e9-4e1f-a269-e8e95da488b8",
      "text": "Tổng cộng ông Kha-nốc sống được ba trăm sáu mươi lăm năm.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 2,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:08:40.337Z",
      "updatedAt": "2025-09-03T01:08:40.337Z",
      "chapterId": "a39e3149-235d-4bf5-83f7-c3658386c65d"
    },
    {
      "id": "30e16774-4fc9-44d0-ae94-9c8b802ef6a5",
      "text": "Sau khi đi với Thiên Chúa, ông không còn nữa, vì Thiên Chúa đã đem ông đi.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 3,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:08:40.363Z",
      "updatedAt": "2025-09-03T01:08:40.363Z",
      "chapterId": "a39e3149-235d-4bf5-83f7-c3658386c65d"
    },
    {
      "id": "6a36e23c-3c20-493d-a975-30e95f5b5191",
      "text": "Khi ông Mơ-thu-se-lác được một trăm tám mươi bảy tuổi, thì sinh ra La-méc.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:08:40.383Z",
      "updatedAt": "2025-09-03T01:08:40.383Z",
      "chapterId": "a39e3149-235d-4bf5-83f7-c3658386c65d"
    },
    {
      "id": "482383d3-c489-4a6b-a2a6-9c49798c66ab",
      "text": "Sau khi sinh La-méc, ông Mơ-thu-se-lác sống bảy trăm tám mươi hai năm và sinh ra con trai con gái.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 1,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:08:40.409Z",
      "updatedAt": "2025-09-03T01:08:40.409Z",
      "chapterId": "a39e3149-235d-4bf5-83f7-c3658386c65d"
    },
    {
      "id": "7a018145-33d4-47cf-800e-72e60bddffe3",
      "text": "Tổng cộng ông Mơ-thu-se-lác sống được chín trăm sáu mươi chín năm, rồi qua đời.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 2,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:08:40.442Z",
      "updatedAt": "2025-09-03T01:08:40.442Z",
      "chapterId": "a39e3149-235d-4bf5-83f7-c3658386c65d"
    },
    {
      "id": "c5ab2a8a-c9ad-4e8f-9c03-0d15720bbd5a",
      "text": "Khi ông La-méc sống được một trăm tám mươi hai tuổi, thì sinh ra một người con trai.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:08:40.471Z",
      "updatedAt": "2025-09-03T01:08:40.471Z",
      "chapterId": "a39e3149-235d-4bf5-83f7-c3658386c65d"
    },
    {
      "id": "0a41cd98-337f-40e9-87bd-f290486978ca",
      "text": "Ông đặt tên cho con là Nô-ê ; ông nói : “Khi tay chúng ta phải làm lụng cực nhọc, thì trẻ này sẽ đem lại cho chúng ta niềm an ủi phát xuất từ đất đai ĐỨC CHÚA đã nguyền rủa.”",
      "label": "29",
      "number": 29,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 1,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:08:40.491Z",
      "updatedAt": "2025-09-03T01:08:40.491Z",
      "chapterId": "a39e3149-235d-4bf5-83f7-c3658386c65d"
    },
    {
      "id": "1ac54f3d-125d-40b3-ab33-a67ec56da505",
      "text": "Sau khi sinh ông Nô-ê, ông La-méc sống năm trăm chín mươi lăm năm và sinh ra con trai con gái.",
      "label": "30",
      "number": 30,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 2,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:08:40.552Z",
      "updatedAt": "2025-09-03T01:08:40.552Z",
      "chapterId": "a39e3149-235d-4bf5-83f7-c3658386c65d"
    },
    {
      "id": "1d46eeff-e639-4a35-a763-06eed9152da2",
      "text": "Tổng cộng ông La-méc sống được bảy trăm bảy mươi bảy năm, rồi qua đời.",
      "label": "31",
      "number": 31,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 3,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:08:40.588Z",
      "updatedAt": "2025-09-03T01:08:40.588Z",
      "chapterId": "a39e3149-235d-4bf5-83f7-c3658386c65d"
    },
    {
      "id": "8eba093e-8c11-4b1a-abae-a0132079f5b7",
      "text": "Khi ông Nô-ê được năm trăm tuổi, thì sinh ra Sêm, Kham và Gia-phét.",
      "label": "32",
      "number": 32,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:08:40.608Z",
      "updatedAt": "2025-09-03T01:08:40.608Z",
      "chapterId": "a39e3149-235d-4bf5-83f7-c3658386c65d"
    }
  ],
  "marks": [
    {
      "id": "471213ba-1e00-46c2-84ca-c8252606777f",
      "content": "Trong St 5,1-32, danh sách đưa ra các tổ phụ trước Hồng Thuỷ (từ ông A-đam đến ông Nô-ê). Tuổi đời của các vị này đi từ 969 năm (ông Mơ-thu-se-lác : 5,25-27) cho tới 777 năm (ông La-méc : 5,28-31). Ông Kha-nốc chỉ thọ có 365 tuổi, nhưng đó là một con số tượng trưng : số ngày trong một năm. Theo lịch sử của Xu-me (Lưỡng Hà Địa) về 8 vua tiên khởi trước Hồng Thuỷ, các vua này trị vì rất lâu : từ 18.600 năm (vua Ubar-tutu) lên tới 43.200 năm (vua En-men-lu-a-na). Như thế, con số ghi trong Thánh Kinh khiêm tốn hơn nhiều. Gia phả trong St 11,10-26.32 về các tổ phụ sau Hồng Thuỷ, tổ tiên của ông Áp-ram, cho danh sách từ Hồng Thuỷ đến ông Te-ra cha ông Áp-ram. Số tuổi đời cao nhất là 600 năm (ông Sêm : 11,10-11) và thấp nhất là 148 năm (ông Na-kho : 11,24-25). Theo vài học giả Thánh Kinh, có thể hiểu ý nghĩa con số lớn trong tuổi đời các tổ phụ như sau : để làm tăng vẻ uy nghi của một tộc trưởng, hoạ sĩ vẽ ông với hình vóc vạm vỡ, râu rậm, tóc dài ; tác giả Thánh Kinh ghi những con số lớn để tạo nơi độc giả lòng kính phục và quý mến cần phải có đối với các ngài. Ngoài ra, vì sống thọ là ân huệ, là phúc lành của Thiên Chúa (x. Cn 10,27), nên nguyên nhân làm tuổi thọ bớt dần chính là sự dữ cứ hoành hành trên mặt đất (6,3) : càng xa nguồn sự sống là Thiên Chúa, sức sống càng giảm dần đi.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 26,
      "endOffset": 26,
      "createdAt": "2025-09-03T01:08:39.675Z",
