    },
    {
      "id": "9082d479-bb9d-4b7d-9cc5-096a385ba6b0",
      "content": "Đây là lần thứ ba (x. 6,9 ; 11,4) thiên sứ nói về chữa mắt cho ông Tô-bít.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "15",
      "sortOrder": 14,
      "startOffset": 14,
      "endOffset": 14,
      "createdAt": "2025-09-03T02:11:12.285Z",
      "updatedAt": "2025-09-03T02:11:12.285Z",
      "targetId": "c078bd7d-4a03-4019-8f51-0e842856ea36",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "2269bc9a-aecd-4423-b2d5-793f125c0ac8"
    },
    {
      "id": "8bcbc198-4676-495b-9c9f-4e0c383ffd6f",
      "content": "English: Hannah | French: Anne | Latin: Anna | Origin: &#1495;&#1463;&#1504;&#1468;&#1464;&#1492; | Vietnamese: An-na 1 -- mẹ của ngôn sứ Sa-mu-en, 1 Sm 1,1-8",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "16",
      "sortOrder": 15,
      "startOffset": 8,
      "endOffset": 8,
      "createdAt": "2025-09-03T02:11:12.324Z",
      "updatedAt": "2025-09-03T02:11:12.324Z",
      "targetId": "96baff8a-afed-428d-b259-4c09802d2f77",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "2269bc9a-aecd-4423-b2d5-793f125c0ac8"
    },
    {
      "id": "3f3cfb16-003d-427f-a632-3d520f940208",
      "content": "Mẹ con gặp lại nhau trong nước mắt sung sướng, vì bà An-na tưởng con mình đã mất nay tìm lại được.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "17",
      "sortOrder": 16,
      "startOffset": 125,
      "endOffset": 125,
      "createdAt": "2025-09-03T02:11:12.344Z",
      "updatedAt": "2025-09-03T02:11:12.344Z",
      "targetId": "96baff8a-afed-428d-b259-4c09802d2f77",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "2269bc9a-aecd-4423-b2d5-793f125c0ac8"
    },
    {
      "id": "5b066933-6169-4a7d-aab6-8b677ced9a3e",
      "content": "English: Tobit | French: Tobit | Latin: Thobis | Origin: &#932;&#969;&#946;&#953;&#964; | Vietnamese: Tô-bít -- Tb 1,1",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "18",
      "sortOrder": 17,
      "startOffset": 10,
      "endOffset": 10,
      "createdAt": "2025-09-03T02:11:12.403Z",
      "updatedAt": "2025-09-03T02:11:12.403Z",
      "targetId": "35387768-d577-4c39-9d4d-ae2ef1b22457",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "2269bc9a-aecd-4423-b2d5-793f125c0ac8"
    },
    {
      "id": "ec4782b8-e7dc-4ac2-8d74-9e926e0c8bb5",
      "content": "English: Raphael (S) | French: Raphael | Latin: Raphael | Origin: &#929;&#945;&#981;&#945;&#951;&#955; | Vietnamese: Ra-pha-en 1 -- người Náp-ta-li, tổ tiên ông Tô-bít và cậu Tô-bi-a, Tb 1,1",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "19",
      "sortOrder": 18,
      "startOffset": 7,
      "endOffset": 7,
      "createdAt": "2025-09-03T02:11:12.442Z",
      "updatedAt": "2025-09-03T02:11:12.442Z",
      "targetId": "a714c5e4-6870-408b-b37a-75a73179a614",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "2269bc9a-aecd-4423-b2d5-793f125c0ac8"
    },
    {
      "id": "1a63bcdb-5a25-4258-a222-58ffae905533",
      "content": "Tô-bi-a không nói gì khác ngoài câu này, lặp lại lời của mẹ tiễn đưa mình (7,17).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "20",
      "sortOrder": 19,
      "startOffset": 124,
      "endOffset": 124,
      "createdAt": "2025-09-03T02:11:12.457Z",
      "updatedAt": "2025-09-03T02:11:12.457Z",
      "targetId": "a714c5e4-6870-408b-b37a-75a73179a614",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "2269bc9a-aecd-4423-b2d5-793f125c0ac8"
    },
    {
      "id": "d6c1104c-8a78-48c5-a6c7-44cb5fb5119f",
      "content": "PTM thêm : *nhìn thấy con*.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "21",
      "sortOrder": 20,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:11:12.549Z",
      "updatedAt": "2025-09-03T02:11:12.549Z",
      "targetId": "ddaa7dae-2a3d-458f-b68f-99bc04d1c396",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "2269bc9a-aecd-4423-b2d5-793f125c0ac8"
    },
    {
      "id": "875ef4f5-f9ca-4161-a93b-f9ca7457de8b",
      "content": "Hiểu theo hai nghĩa : nhìn được con với tất cả thân hình, hoạt động, nhìn thấy con trở về an toàn, tốt đẹp.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "22",
      "sortOrder": 21,
      "startOffset": 70,
      "endOffset": 70,
      "createdAt": "2025-09-03T02:11:12.567Z",
      "updatedAt": "2025-09-03T02:11:12.567Z",
      "targetId": "ddaa7dae-2a3d-458f-b68f-99bc04d1c396",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "2269bc9a-aecd-4423-b2d5-793f125c0ac8"
    },
    {
      "id": "7e484943-7b40-4fd6-8137-c427b0792830",
      "content": "Trong 10,5 bà An-na đã sánh ví như vậy. Ở đây, nghĩa mạnh hơn : Tô-bi-a đã chữa cho cha mình sáng mắt, nhìn thấy mọi sự trong ánh sáng.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "23",
      "sortOrder": 22,
      "startOffset": 104,
      "endOffset": 104,
      "createdAt": "2025-09-03T02:11:12.584Z",
      "updatedAt": "2025-09-03T02:11:12.584Z",
      "targetId": "ddaa7dae-2a3d-458f-b68f-99bc04d1c396",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "2269bc9a-aecd-4423-b2d5-793f125c0ac8"
    },
    {
      "id": "ab0aff19-db9a-4a75-8752-59a846a9022a",
      "content": "Lần thứ năm sách Tb nói đến cầu nguyện.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "24",
      "sortOrder": 23,
      "startOffset": 11,
      "endOffset": 11,
      "createdAt": "2025-09-03T02:11:12.618Z",
      "updatedAt": "2025-09-03T02:11:12.618Z",
      "targetId": "d6dd0e91-81e9-4931-92ac-0c32963d5d5e",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "2269bc9a-aecd-4423-b2d5-793f125c0ac8"
    },
    {
      "id": "d91889ac-4533-4f44-9c75-8798014cecee",
      "content": "PTM thêm : *đến muôn đời*.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "25",
      "sortOrder": 24,
      "startOffset": 44,
      "endOffset": 44,
      "createdAt": "2025-09-03T02:11:12.680Z",
      "updatedAt": "2025-09-03T02:11:12.680Z",
      "targetId": "b503a80e-be4d-46d6-b7f1-aafa42dfecf9",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "2269bc9a-aecd-4423-b2d5-793f125c0ac8"
    },
    {
      "id": "918f2077-c0f8-453a-809d-8bd02808be38",
      "content": "PTM bỏ hai vế này.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "26",
      "sortOrder": 25,
      "startOffset": 0,
      "endOffset": 0,
