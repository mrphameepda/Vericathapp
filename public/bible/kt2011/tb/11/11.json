    {
      "id": "af945621-bcd0-48f0-83a6-af5e88ef923a",
      "content": "Địa danh này không rõ ràng. Bản PT : *Kha-ran*.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
