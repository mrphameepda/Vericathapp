{
  "chapter": {
    "id": "8b654899-889b-41d7-b070-5e445809bee9",
    "number": 10,
    "createdAt": "2025-09-03T01:07:51.659Z",
    "updatedAt": "2025-09-03T01:07:51.659Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "3a770039-fb8c-4d32-8751-51f53f7a9365",
      "text": "La-mét",
      "label": "0",
      "number": 0,
      "subVerseIndex": 1,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:25:31.478Z",
      "updatedAt": "2025-09-03T02:25:31.478Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "8fc8b97e-5824-45cb-9fbf-be5d6c1ff498",
      "text": "Lạy CHÚA, sao Chúa nỡ đứng xa,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:31.517Z",
      "updatedAt": "2025-09-03T02:25:31.517Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "fbafdcf2-7e89-4d0b-9b6f-1fbe3005ea51",
      "text": "ngày khốn quẫn, sao Ngài đành ẩn mặt ?",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:31.529Z",
      "updatedAt": "2025-09-03T02:25:31.529Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "4ad148ae-1c04-49bf-ae1e-9780bb819710",
      "text": "Kẻ ác kiêu căng đuổi bắt người nghèo khổ :",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:31.540Z",
      "updatedAt": "2025-09-03T02:25:31.540Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "740beb04-338e-4242-872d-5d478d31c812",
      "text": "họ mắc phải mưu nó đã bày ra.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:31.555Z",
      "updatedAt": "2025-09-03T02:25:31.555Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "d875ebbd-6648-45bc-ba14-f0d918be781f",
      "text": "Kẻ ác khoe khoang tham vọng của mình,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:31.570Z",
      "updatedAt": "2025-09-03T02:25:31.570Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "330def6e-97b8-4335-abb6-665eae37b6c4",
      "text": "bóc lột người ta, xúc phạm khinh thường CHÚA.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:31.584Z",
      "updatedAt": "2025-09-03T02:25:31.584Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "a5718779-d690-4709-af42-9a506e32132f",
      "text": "Kẻ ác dám ngông nghênh bảo rằng :",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:31.598Z",
      "updatedAt": "2025-09-03T02:25:31.598Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "51b0189b-c1ab-4160-b114-137d926a38f4",
      "text": "“Chúa chẳng phạt, vì có Chúa đâu !”",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:31.612Z",
      "updatedAt": "2025-09-03T02:25:31.612Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "da33e320-c545-4c89-9167-68e00644b305",
      "text": "Tư tưởng nó chung quy là vậy.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:31.626Z",
      "updatedAt": "2025-09-03T02:25:31.626Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "2a3d8baf-3a95-473d-99b6-6c76ef825451",
      "text": "Nó làm gì cũng vẫn thành công,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:31.640Z",
      "updatedAt": "2025-09-03T02:25:31.640Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "65413bac-99be-4e39-8ec3-a2cb5e86cca0",
      "text": "đối với nó, phán quyết Ngài thật quá xa vời.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:31.655Z",
      "updatedAt": "2025-09-03T02:25:31.655Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "4e0e2492-7fd8-4eac-b0d0-b8d0528c7973",
      "text": "Mọi thù địch, nó khinh thường tất cả,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:31.668Z",
      "updatedAt": "2025-09-03T02:25:31.668Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "eb0a739a-52df-411a-89b1-2b312fa2d953",
      "text": "lại còn tự nhủ : “Ta không hề nao núng,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:31.683Z",
      "updatedAt": "2025-09-03T02:25:31.683Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "80684d80-36bb-41b6-ad64-87fb98938884",
      "text": "chẳng đời nào phải hoạn nạn đâu !”",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:31.697Z",
      "updatedAt": "2025-09-03T02:25:31.697Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "9af6f4ea-5814-497f-8562-b99a9489cb29",
      "text": "Pê",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:25:31.711Z",
      "updatedAt": "2025-09-03T02:25:31.711Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "4a38501a-ca04-404f-a874-c7c3ea326846",
      "text": "Miệng độc dữ điêu ngoa, những buông lời nguyền rủa,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:31.726Z",
      "updatedAt": "2025-09-03T02:25:31.726Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "cb914e16-d682-496a-bcfd-a6e0b523d32c",
      "text": "lưỡi nói toàn chuyện gian ác bất công.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:31.740Z",
      "updatedAt": "2025-09-03T02:25:31.740Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "97b638f4-a5e9-4b06-908b-30a10b95b80b",
      "text": "Nó phục cạnh xóm làng",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:31.754Z",
      "updatedAt": "2025-09-03T02:25:31.754Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "2f96a6ab-ca28-4629-a32c-44cda093b6fe",
      "text": "giết trộm người vô tội, mắt rình ai yếu thế.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:31.769Z",
      "updatedAt": "2025-09-03T02:25:31.769Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "4d913eb9-0f3d-4732-9dbd-f3d3d2114efa",
      "text": "A-in",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:25:31.783Z",
      "updatedAt": "2025-09-03T02:25:31.783Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "856d9273-aff1-4df5-b64c-45de6993effb",
      "text": "Chẳng khác nào sư tử phục sẵn ở trong hang,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:31.797Z",
      "updatedAt": "2025-09-03T02:25:31.797Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "763cd319-6a67-46dd-9d74-7cf175269edf",
      "text": "nó phục nơi ẩn khuất rình bắt người nghèo khổ,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:31.809Z",
      "updatedAt": "2025-09-03T02:25:31.809Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "c81b75d8-4f10-4f7a-8a7e-a950348ff740",
      "text": "lừa vào lưới nó giăng.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:31.821Z",
      "updatedAt": "2025-09-03T02:25:31.821Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "5299b519-50d3-4a7a-917b-37caf452b1f0",
      "text": "",
      "label": "9",
      "number": 9,
      "subVerseIndex": 3,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:31.832Z",
      "updatedAt": "2025-09-03T02:25:31.832Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "dfe832b3-a820-43f8-a330-64737e7d17d6",
      "text": "Nó rạp xuống, nép mình, vồ lấy người yếu thế,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:25:31.848Z",
      "updatedAt": "2025-09-03T02:25:31.848Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "5753be91-327e-4ecc-83c7-83f5c7ae8056",
      "text": "nanh vuốt ghì cho chặt.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:31.861Z",
      "updatedAt": "2025-09-03T02:25:31.861Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "56ba2a17-8159-4f64-a620-9e4bdd57598b",
      "text": "Nó nhủ thầm : “Thiên Chúa đã quên,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:31.875Z",
      "updatedAt": "2025-09-03T02:25:31.875Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "e11f3f79-e83f-4f56-a627-d6ec462b7400",
      "text": "Người che mặt, chẳng bao giờ thấy nữa.”",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:31.889Z",
      "updatedAt": "2025-09-03T02:25:31.889Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "2844581d-b3c1-4c60-84e0-78b2b915bae6",
      "text": "Cốp",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:25:31.903Z",
      "updatedAt": "2025-09-03T02:25:31.903Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "98cf47a5-465a-4b69-88d7-2d9925b50115",
      "text": "Lạy CHÚA, xin đứng dậy ra tay,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:31.917Z",
      "updatedAt": "2025-09-03T02:25:31.917Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "6a2086e4-3cec-45cc-a00c-30008db24b8a",
      "text": "xin đừng quên những người nghèo khổ.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:31.932Z",
      "updatedAt": "2025-09-03T02:25:31.932Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "088d71ec-c910-4962-87bd-b18badb77a37",
      "text": "Sao kẻ ác dám khinh thường Thiên Chúa,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:31.946Z",
      "updatedAt": "2025-09-03T02:25:31.946Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "b03e1f98-c4b9-403e-8c88-bce319c8b5af",
      "text": "dám nhủ thầm : “Chúa chẳng phạt đâu !”",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:31.960Z",
      "updatedAt": "2025-09-03T02:25:31.960Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "5a3bfb18-b033-49c3-9ab5-2df8e4d5c407",
      "text": "Rết",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:25:31.982Z",
      "updatedAt": "2025-09-03T02:25:31.982Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "affa63be-f16e-44bb-b675-bd3b26dba98b",
      "text": "Nhưng Chúa nhìn nỗi khổ cực đau thương,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:31.996Z",
      "updatedAt": "2025-09-03T02:25:31.996Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "187d7612-8bc5-4d30-899e-5dcdf5d7cedb",
      "text": "Chúa để ý, tự tay lo liệu.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:32.010Z",
      "updatedAt": "2025-09-03T02:25:32.010Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "79057425-98bd-4194-be50-e4e89b2ffe1f",
      "text": "Người yếu thế giao phó đời mình cho Chúa,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 2,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:32.024Z",
      "updatedAt": "2025-09-03T02:25:32.024Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "8ec6bd57-5a39-4a43-9e0e-a4594aadae96",
      "text": "kẻ mồ côi được chính Chúa phù trì.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 3,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:32.037Z",
      "updatedAt": "2025-09-03T02:25:32.037Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "6d2bb70a-9ec1-4a27-8773-1a171d744d82",
      "text": "Sin",
      "label": "14",
      "number": 14,
      "subVerseIndex": 4,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:25:32.051Z",
      "updatedAt": "2025-09-03T02:25:32.051Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "3925c285-5084-463a-95bd-45131343d77b",
      "text": "Xin đập tan thế lực người gian ác,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:32.066Z",
      "updatedAt": "2025-09-03T02:25:32.066Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "24c025d0-095c-41f5-a779-8ddec9ca421b",
      "text": "xin trị tội nó, để không ai còn thấy nó nữa.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:32.093Z",
      "updatedAt": "2025-09-03T02:25:32.093Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "ed7a176d-ef1b-4acb-be67-5b3fb41c6b8c",
      "text": "CHÚA là Vua muôn thuở muôn đời,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:32.108Z",
      "updatedAt": "2025-09-03T02:25:32.108Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "93a5dcf4-3527-4fe2-9bb2-505495b6aa6a",
      "text": "miền đất Chúa sạch bóng chư dân.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:32.122Z",
      "updatedAt": "2025-09-03T02:25:32.122Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "2a07d7e0-f787-4c08-a3e7-4ab7ae53ce43",
      "text": "Tau",
      "label": "16",
      "number": 16,
      "subVerseIndex": 2,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:25:32.146Z",
      "updatedAt": "2025-09-03T02:25:32.146Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "ec1ee46d-cee0-4a92-b644-ed050cd0337f",
      "text": "Lạy CHÚA, Ngài nghe thấy ước vọng của kẻ nghèo hèn ;",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:32.158Z",
      "updatedAt": "2025-09-03T02:25:32.158Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "a833e493-c354-46a9-94ce-3fd418ad695c",
      "text": "Ngài cho họ an lòng và lắng tai nghe họ,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:32.182Z",
      "updatedAt": "2025-09-03T02:25:32.182Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "ed26cf39-2177-4824-88c0-fbda72251e02",
      "text": "để bênh kẻ mồ côi và người bị áp bức,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:32.195Z",
      "updatedAt": "2025-09-03T02:25:32.195Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "3e51b55b-696b-4cdc-b81a-3f15ddeddaff",
      "text": "khiến cho kẻ mang thân cát bụi, chẳng còn khủng bố ai.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:32.223Z",
      "updatedAt": "2025-09-03T02:25:32.223Z",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    }
  ],
  "marks": [
    {
      "id": "51d63e7a-5983-4bae-9bea-c6cfbd1cb7c7",
      "content": "Sau lời than van ngỏ với Thiên Chúa (c.1), tác giả cho thấy kẻ ác hoành hành trên thế gian (cc. 2-11) : có những ý nghĩ, thái độ và lời nói xúc phạm đến Thiên Chúa (cc. 3.4.11.13) ; tự cao tự đắc (c.4) ; khinh chê người khác (c.5) ; buông những lời nguyền rủa, nói những điều gian ác bất công (c.7) ; lưu manh, rình rập, áp bức và giết hại người vô tội (cc. 8-10) ... Phần còn lại (cc. 12-18) gồm những lời cầu xin Thiên Chúa ra tay cứu giúp kẻ nghèo hèn, những lời lạc quan nói với Thiên Chúa về thái độ che chở phù trì của Người ; c.16 là câu duy nhất không trực tiếp ngỏ với Thiên Chúa.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 25,
      "endOffset": 25,
      "createdAt": "2025-09-03T02:25:31.506Z",
      "updatedAt": "2025-09-03T02:25:31.506Z",
      "targetId": "39422e52-c459-4815-97f5-0d2ae0e7a3a8",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "8b654899-889b-41d7-b070-5e445809bee9"
    },
    {
      "id": "7258b486-3afb-41ce-afcd-ac5017639dbb",
