{
  "chapter": {
    "id": "24fc2030-6c91-4388-976d-4a9f2d3ef792",
    "number": 101,
    "createdAt": "2025-09-03T01:07:51.662Z",
    "updatedAt": "2025-09-03T01:07:51.662Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "4461074f-3f65-46e3-a068-a42ef013ef01",
      "text": "*Của vua Đa-vít. Thánh vịnh.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:35:02.964Z",
      "updatedAt": "2025-09-03T02:35:02.964Z",
      "chapterId": "24fc2030-6c91-4388-976d-4a9f2d3ef792"
    },
    {
      "id": "97e47ddf-b0ce-4359-a0dc-9b98a2ffa2e0",
      "text": "Lạy CHÚA, con xin ca ngợi tình thương và công lý :",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:03.015Z",
      "updatedAt": "2025-09-03T02:35:03.015Z",
      "chapterId": "24fc2030-6c91-4388-976d-4a9f2d3ef792"
    },
    {
      "id": "af323980-d988-47f1-ab34-1351667a1555",
      "text": "con đàn hát kính Ngài.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:03.040Z",
      "updatedAt": "2025-09-03T02:35:03.040Z",
      "chapterId": "24fc2030-6c91-4388-976d-4a9f2d3ef792"
    },
    {
      "id": "e7f6ce63-5679-4e5e-9782-6773f740a5b9",
      "text": "Con nguyện chủ tâm theo đường hoàn hảo,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:03.055Z",
      "updatedAt": "2025-09-03T02:35:03.055Z",
      "chapterId": "24fc2030-6c91-4388-976d-4a9f2d3ef792"
    },
    {
      "id": "84d4effd-3764-4d44-af0b-8c8d4cf8cc8d",
      "text": "bao giờ Ngài mới đến cùng con ?",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:03.097Z",
      "updatedAt": "2025-09-03T02:35:03.097Z",
      "chapterId": "24fc2030-6c91-4388-976d-4a9f2d3ef792"
    },
    {
      "id": "2acec1d5-688e-4524-8948-e29d38fa0912",
      "text": "Con sẽ sống theo lòng thuần khiết",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:03.112Z",
      "updatedAt": "2025-09-03T02:35:03.112Z",
      "chapterId": "24fc2030-6c91-4388-976d-4a9f2d3ef792"
    },
    {
      "id": "0b5f6abf-66fc-44d5-8b5d-3a163a475a19",
      "text": "ở trong cửa trong nhà.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 3,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:03.126Z",
      "updatedAt": "2025-09-03T02:35:03.126Z",
      "chapterId": "24fc2030-6c91-4388-976d-4a9f2d3ef792"
    },
    {
      "id": "af9d745c-b9af-422a-8efe-d300b5b6a168",
      "text": "Việc xấu xa đê tiện, con chẳng để mắt trông.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:03.141Z",
      "updatedAt": "2025-09-03T02:35:03.141Z",
      "chapterId": "24fc2030-6c91-4388-976d-4a9f2d3ef792"
    },
    {
      "id": "5dce26a5-4604-4e92-9394-dd3dfb20bbb1",
      "text": "Con ghét kẻ làm điều tà vạy,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:03.155Z",
      "updatedAt": "2025-09-03T02:35:03.155Z",
      "chapterId": "24fc2030-6c91-4388-976d-4a9f2d3ef792"
    },
    {
      "id": "8e8e9f4e-e79f-476c-9939-cefae5af5ff7",
      "text": "không để cho dính dáng đến mình.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:03.173Z",
      "updatedAt": "2025-09-03T02:35:03.173Z",
      "chapterId": "24fc2030-6c91-4388-976d-4a9f2d3ef792"
    },
    {
      "id": "4364bbc8-10d8-4d17-b5f1-8cb7ab4409a1",
      "text": "Tâm địa gian manh con hằng xa lánh,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:03.187Z",
      "updatedAt": "2025-09-03T02:35:03.187Z",
      "chapterId": "24fc2030-6c91-4388-976d-4a9f2d3ef792"
    },
    {
      "id": "5b9f980e-2d3d-4187-8722-8aec7596b201",
      "text": "chẳng muốn biết gì đến chuyện xấu xa.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:03.215Z",
      "updatedAt": "2025-09-03T02:35:03.215Z",
      "chapterId": "24fc2030-6c91-4388-976d-4a9f2d3ef792"
    },
    {
      "id": "aff6ee51-2e07-4101-acc8-620b71137cb7",
      "text": "Ai nói chùng nói lén, là con sẽ diệt trừ.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:03.229Z",
      "updatedAt": "2025-09-03T02:35:03.229Z",
      "chapterId": "24fc2030-6c91-4388-976d-4a9f2d3ef792"
    },
    {
      "id": "b23ce002-87ef-4301-a847-1b91609bc4b4",
      "text": "Con mắt khinh người, lòng dạ kiêu căng :",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:03.248Z",
      "updatedAt": "2025-09-03T02:35:03.248Z",
      "chapterId": "24fc2030-6c91-4388-976d-4a9f2d3ef792"
    },
    {
      "id": "639044a4-e0f7-40f4-84ce-9ecbefc56474",
      "text": "những bọn đó, không khi nào con chịu.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:03.276Z",
      "updatedAt": "2025-09-03T02:35:03.276Z",
      "chapterId": "24fc2030-6c91-4388-976d-4a9f2d3ef792"
    },
    {
      "id": "af2d14ee-5ba4-4056-a9ac-a634667f3770",
      "text": "Con để mắt kiếm người hiền trong xứ, cho họ được ở gần.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:03.290Z",
      "updatedAt": "2025-09-03T02:35:03.290Z",
      "chapterId": "24fc2030-6c91-4388-976d-4a9f2d3ef792"
    },
    {
      "id": "cfaa7153-6560-4c80-a059-101b0cf87faa",
      "text": "Ai sống đời hoàn hảo, sẽ là người được phục vụ con.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:03.306Z",
      "updatedAt": "2025-09-03T02:35:03.306Z",
      "chapterId": "24fc2030-6c91-4388-976d-4a9f2d3ef792"
    },
    {
      "id": "b8d6ac2c-9e93-47aa-8804-c2d12988a4cb",
      "text": "Nhà con ở không hề chứa chấp",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:03.320Z",
      "updatedAt": "2025-09-03T02:35:03.320Z",
      "chapterId": "24fc2030-6c91-4388-976d-4a9f2d3ef792"
    },
    {
      "id": "4d6a3d37-c563-4a88-b58d-c1ed79c5b379",
      "text": "kẻ quen trò bịp bợm thói lưu manh.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:03.333Z",
      "updatedAt": "2025-09-03T02:35:03.333Z",
      "chapterId": "24fc2030-6c91-4388-976d-4a9f2d3ef792"
    },
    {
      "id": "732c15bf-1509-459e-ab05-6aa98d0d617b",
      "text": "Hạng nói dối chuyên nghề, con đuổi cho khuất mắt.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:03.346Z",
      "updatedAt": "2025-09-03T02:35:03.346Z",
      "chapterId": "24fc2030-6c91-4388-976d-4a9f2d3ef792"
    },
    {
      "id": "ae9ecc39-821d-4aa4-b410-721218602fa6",
      "text": "Mỗi buổi mai con lại diệt trừ",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:03.358Z",
      "updatedAt": "2025-09-03T02:35:03.358Z",
      "chapterId": "24fc2030-6c91-4388-976d-4a9f2d3ef792"
    },
    {
      "id": "d8d69650-416b-4510-b5ac-8c31061117e3",
      "text": "cho hết phường ác nhân trong xứ sở,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:03.389Z",
      "updatedAt": "2025-09-03T02:35:03.389Z",
      "chapterId": "24fc2030-6c91-4388-976d-4a9f2d3ef792"
    },
    {
      "id": "4c369af4-9224-4191-9bfd-bea1dfb15228",
      "text": "hầu quét sạch khỏi thành đô CHÚA",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:03.406Z",
      "updatedAt": "2025-09-03T02:35:03.406Z",
      "chapterId": "24fc2030-6c91-4388-976d-4a9f2d3ef792"
    },
    {
      "id": "05b176a6-4f3e-493d-9749-e82522f020aa",
      "text": "bọn làm điều ác, chẳng sót một tên.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 3,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:03.423Z",
      "updatedAt": "2025-09-03T02:35:03.423Z",
      "chapterId": "24fc2030-6c91-4388-976d-4a9f2d3ef792"
    }
  ],
  "marks": [
    {
      "id": "218b6353-0bb3-4521-a87c-590f4a377ad5",
      "content": "Có thể *Tv về nhà vua* này được sử dụng hằng năm vào đầu lễ Lều để mừng kỷ niệm lễ đăng quang của nhà vua. Chắc đây là những lời hứa của nhà vua trong ngày lễ đó. Sau nhập đề (cc. 1-2), những lời hứa liên quan đến các điểm tiêu cực được ghi lại trong cc. 3-5 ; còn cc. 6-7 chú tâm hơn một chút đến yếu tố tích cực (c.6). C.8 là câu kết nói lên quyết tâm của nhà vua mỗi sáng khi xét xử, muốn thẳng tay tiêu diệt những kẻ làm điều ác.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 43,
      "endOffset": 43,
      "createdAt": "2025-09-03T02:35:02.994Z",
      "updatedAt": "2025-09-03T02:35:02.994Z",
