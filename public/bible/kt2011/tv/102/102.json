{
  "chapter": {
    "id": "9ac64d22-7078-4b4a-83f8-a2c09638ae47",
    "number": 102,
    "createdAt": "2025-09-03T01:07:51.662Z",
    "updatedAt": "2025-09-03T01:07:51.662Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "bdac67c9-55b6-49b0-aef1-2cc73bff8a25",
      "text": "*Lời cầu của kẻ gặp khốn khó. Trong cơn cùng khốn, người này dâng lời than vãn trước ĐỨC CHÚA.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:35:08.805Z",
      "updatedAt": "2025-09-03T02:35:08.805Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "a4d2a4d0-243f-4db7-9a51-1b79aa71a612",
      "text": "Lạy CHÚA, xin nghe lời con cầu khẩn,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:08.859Z",
      "updatedAt": "2025-09-03T02:35:08.859Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "4b719a1b-f666-40de-8587-45697b9ccc58",
      "text": "tiếng con kêu, mong được thấu tới Ngài.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:08.877Z",
      "updatedAt": "2025-09-03T02:35:08.877Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "19e2a4a4-c0fd-4cf3-bb6a-b706d0bd5ebd",
      "text": "Buổi con gặp gian truân, xin Ngài đừng ẩn mặt,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:08.890Z",
      "updatedAt": "2025-09-03T02:35:08.890Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "4bb1dbf0-6dfc-4518-ba94-4cea0710aa0e",
      "text": "trong ngày con cầu cứu, xin Ngài lắng tai nghe",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:08.920Z",
      "updatedAt": "2025-09-03T02:35:08.920Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "f3a12183-4cf3-4db7-a855-421a30a90704",
      "text": "và mau mau đáp lời.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:08.933Z",
      "updatedAt": "2025-09-03T02:35:08.933Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "3c9581f5-8bc8-4066-a3ea-cf419cf354bf",
      "text": "Vì đời con : tháng ngày tan thành khói,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:08.947Z",
      "updatedAt": "2025-09-03T02:35:08.947Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "f25db8eb-3979-4a9b-b973-fb0c344d2e85",
      "text": "xương tuỷ nóng ran như hoả lò.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:08.961Z",
      "updatedAt": "2025-09-03T02:35:08.961Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "669922f9-eed7-458a-b62c-ee8272a40b53",
      "text": "Tim héo hắt tựa hồ cỏ giập,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:08.975Z",
      "updatedAt": "2025-09-03T02:35:08.975Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "09beac5c-3df8-445a-9c7e-b864a0e17d03",
      "text": "nên chẳng còn tưởng đến miếng ăn.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:08.989Z",
      "updatedAt": "2025-09-03T02:35:08.989Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "c1d65b63-f423-4142-a2af-49e32c226d36",
      "text": "Vì con những kêu gào rên rẩm",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.003Z",
      "updatedAt": "2025-09-03T02:35:09.003Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "840c3817-ec73-4e08-b765-7cfc13d8d4ab",
      "text": "mà thân thể chỉ còn da bọc xương.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.017Z",
      "updatedAt": "2025-09-03T02:35:09.017Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "7bccb5ab-774c-404d-958e-3eacfc6afa37",
      "text": "Con chẳng khác bồ nông miền sa mạc,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.044Z",
      "updatedAt": "2025-09-03T02:35:09.044Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "f975f8ba-6053-4add-babd-b006ee6bba1b",
      "text": "tựa như cú vọ chốn hoang tàn.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.059Z",
      "updatedAt": "2025-09-03T02:35:09.059Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "9dc8cd9d-a91e-4169-8b12-bd4ac6dd72b2",
      "text": "Suốt năm canh trằn trọc,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.073Z",
      "updatedAt": "2025-09-03T02:35:09.073Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "2b42b812-fe09-4f90-a1f7-a4e2d4c25e69",
      "text": "phận như chim lạc đàn đậu mái hiên.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.088Z",
      "updatedAt": "2025-09-03T02:35:09.088Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "b14d10cb-60d7-48a8-8632-96100a7be3ee",
      "text": "Quân thù địch cả ngày phỉ báng,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.102Z",
      "updatedAt": "2025-09-03T02:35:09.102Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "23ca25b9-4701-4777-8465-a6f97c1bc122",
      "text": "giận điên lên, chúng nguyền rủa thân này.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.116Z",
      "updatedAt": "2025-09-03T02:35:09.116Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "6e87e0f6-b072-4518-b7da-ade4a047c64e",
      "text": "Ăn tro trấu đã thành cơm bữa,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.130Z",
      "updatedAt": "2025-09-03T02:35:09.130Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "1f442c2e-b6d1-4850-89a9-6e7c999d6672",
      "text": "nước mắt hoà nước uống thường khi.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.157Z",
      "updatedAt": "2025-09-03T02:35:09.157Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "786baac0-5971-4ec4-a518-b053fbabb7a2",
      "text": "Vì Chúa nổi trận lôi đình, ra oai nộ khí,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.171Z",
      "updatedAt": "2025-09-03T02:35:09.171Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "ba15c135-2787-4c3e-9643-81df68aa8c25",
      "text": "nhấc con lên, rồi quẳng ra xa.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.185Z",
      "updatedAt": "2025-09-03T02:35:09.185Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "f1582674-6bb0-4187-95a7-d028310a0578",
      "text": "Ngày tháng đời con : chiều tà bóng ngả,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.199Z",
      "updatedAt": "2025-09-03T02:35:09.199Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "9c1dc9f2-b845-4615-aa0f-c177837b3c37",
      "text": "tấm thân này : cỏ úa vàng khô.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.226Z",
      "updatedAt": "2025-09-03T02:35:09.226Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "56082e3f-2f16-4888-9209-2219856c0bff",
      "text": "Nhưng lạy CHÚA, muôn đời Ngài ngự trị,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.255Z",
      "updatedAt": "2025-09-03T02:35:09.255Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "37ef9f89-f944-47bd-957c-d16d7c036cb6",
      "text": "trải bao thế hệ, thiên hạ nhắc đến Ngài.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.269Z",
      "updatedAt": "2025-09-03T02:35:09.269Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "fdfd4d69-eb81-477f-a49c-8c8f90d6af9f",
      "text": "Chính Ngài sẽ đứng dậy và thương xót Xi-on,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.282Z",
      "updatedAt": "2025-09-03T02:35:09.282Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "a48d9cf8-d75b-4559-b184-6d084c0532ab",
      "text": "vì nay đã đến thời thi ân giáng phúc.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.310Z",
      "updatedAt": "2025-09-03T02:35:09.310Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "4d0b7c3d-8b95-42c1-b1c5-0fa42e4fd400",
      "text": "Bề tôi Ngài lưu luyến đá tường thành sụp đổ,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.324Z",
      "updatedAt": "2025-09-03T02:35:09.324Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "e7be976e-3f58-4e77-8f99-c3b8626cb4b8",
      "text": "lòng những xót xa nhìn đống tro tàn.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.338Z",
      "updatedAt": "2025-09-03T02:35:09.338Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "008d5dc4-e03a-4093-aabd-24fd128ed903",
      "text": "Bấy giờ chư dân sẽ sợ uy danh CHÚA,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.366Z",
      "updatedAt": "2025-09-03T02:35:09.366Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "d0ae35f6-5190-4ef0-a1ce-4aa22a76e8d3",
      "text": "mọi đế vương hoàn cầu uý kính Ngài vinh hiển.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.409Z",
      "updatedAt": "2025-09-03T02:35:09.409Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "f91f185e-8a09-4b6a-a025-7b6d214b8018",
      "text": "Vì CHÚA sẽ xây dựng lại Xi-on,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.422Z",
      "updatedAt": "2025-09-03T02:35:09.422Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "dffa5b82-a1ff-4d12-af12-b83eea2bd91a",
      "text": "sẽ xuất hiện quang vinh rực rỡ.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.450Z",
      "updatedAt": "2025-09-03T02:35:09.450Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "94321562-b334-4b92-a0e3-c1715f107029",
      "text": "Người đoái nghe dân bị bóc lột kêu cầu,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.464Z",
      "updatedAt": "2025-09-03T02:35:09.464Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "6231c706-0594-41a7-99b4-ba63b8b76f9d",
      "text": "chẳng khinh thường lời họ nguyện xin.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.478Z",
      "updatedAt": "2025-09-03T02:35:09.478Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "acc0f13a-4ae4-490d-b9c2-878bc56175ff",
      "text": "Điều này phải ghi lại cho đời sau được biết,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.492Z",
      "updatedAt": "2025-09-03T02:35:09.492Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "c1339058-342d-4576-b2c8-7135d783d07b",
      "text": "dân hậu sinh phải ca tụng CHÚA TRỜI.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.506Z",
      "updatedAt": "2025-09-03T02:35:09.506Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "7bc8bf91-5a85-45d7-a533-2c7c1c4e3d63",
      "text": "Vì CHÚA đưa mắt từ toà cao thánh điện,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.519Z",
      "updatedAt": "2025-09-03T02:35:09.519Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "238b3a74-9542-4709-ab18-d97a2df8cbbe",
      "text": "từ trời xanh đã nhìn xuống cõi trần,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.547Z",
      "updatedAt": "2025-09-03T02:35:09.547Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "0390990f-ddb3-4d85-b394-5eabffd09b2b",
      "text": "để nghe kẻ tù đày rên siết thở than",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.561Z",
      "updatedAt": "2025-09-03T02:35:09.561Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "cd300ff3-95f1-4bcb-a556-90243639ad80",
      "text": "và phóng thích những người mang án tử.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.576Z",
      "updatedAt": "2025-09-03T02:35:09.576Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "61743f16-b053-4cb9-babb-2c804fbcd949",
      "text": "Rồi ra, ở Xi-on, người người sẽ rao truyền danh thánh CHÚA,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.590Z",
      "updatedAt": "2025-09-03T02:35:09.590Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "d6e647b4-b9cf-4295-857b-17a7e6d46bdd",
      "text": "tại Giê-ru-sa-lem, ai nấy ngợi khen Người,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.631Z",
      "updatedAt": "2025-09-03T02:35:09.631Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "c2fd9f2b-62fa-4946-a487-1ec89b773b8f",
      "text": "khi mọi nước mọi dân",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.659Z",
      "updatedAt": "2025-09-03T02:35:09.659Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "b5d2995b-8fd3-4fa0-9615-6a013b857b8a",
      "text": "tập trung về để thờ phượng CHÚA.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.673Z",
      "updatedAt": "2025-09-03T02:35:09.673Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "6a05ebe2-3856-4d30-977b-919f07cd3f03",
      "text": "Chúa làm tôi kiệt lực giữa đường đời,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.687Z",
      "updatedAt": "2025-09-03T02:35:09.687Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "8474d26a-bb7d-4736-8591-d6ba5536fd61",
      "text": "tuổi thọ tôi, Người rút ngắn lại.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.701Z",
      "updatedAt": "2025-09-03T02:35:09.701Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "e82f32aa-3098-4934-962a-1ad0c45f4c15",
      "text": "Con nói : lạy Thiên Chúa của con,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.715Z",
      "updatedAt": "2025-09-03T02:35:09.715Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "364fa1df-a990-4dce-918b-b9a6a282662f",
      "text": "Ngài là Đấng vạn đại trường tồn,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.731Z",
      "updatedAt": "2025-09-03T02:35:09.731Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "534834c3-c1f7-468f-8b43-fdd52888826a",
      "text": "xin đừng cất mạng con giữa cuộc đời dang dở.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 2,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.744Z",
      "updatedAt": "2025-09-03T02:35:09.744Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "267d81af-95c0-4d42-866f-51e9c7eb6d23",
      "text": "Xưa Chúa đã đặt nền trái đất,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.770Z",
      "updatedAt": "2025-09-03T02:35:09.770Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "8276df77-c6f7-438d-8458-3531bce1f2cf",
      "text": "chính tay Ngài tạo tác vòm trời.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.794Z",
      "updatedAt": "2025-09-03T02:35:09.794Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "c6eb0a9b-4221-43f0-a72a-c36daf81017b",
      "text": "Chúng tiêu tan, Chúa còn hoài,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.807Z",
      "updatedAt": "2025-09-03T02:35:09.807Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "28536614-e4f3-44c9-a188-15d44cbf8758",
      "text": "chúng như áo cũ thảy rồi mòn hao.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.819Z",
      "updatedAt": "2025-09-03T02:35:09.819Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "5d712921-3a13-4142-983f-43bb7b3da4ec",
      "text": "Ngài thay chúng khác nào thay áo,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 2,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.833Z",
      "updatedAt": "2025-09-03T02:35:09.833Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "5377f71d-5415-421d-a9df-7d276f26ed5e",
      "text": "nhưng chính Ngài tiền hậu y nguyên ;",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.846Z",
      "updatedAt": "2025-09-03T02:35:09.846Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "b1464921-a85d-42e6-ba9b-f4880dfa7c41",
      "text": "tháng năm Ngài vẫn triền miên.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 1,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.860Z",
      "updatedAt": "2025-09-03T02:35:09.860Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "79100a44-09d3-4dac-bf00-6de83df45e8c",
      "text": "Con cháu bề tôi sẽ an cư lạc nghiệp,",
      "label": "29",
      "number": 29,
      "subVerseIndex": 0,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.873Z",
      "updatedAt": "2025-09-03T02:35:09.873Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    },
    {
      "id": "99b81213-cfea-4b64-80b0-235cec8b22ad",
      "text": "và dòng giống tồn tại trước nhan Ngài.",
      "label": "29",
      "number": 29,
      "subVerseIndex": 1,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:09.900Z",
      "updatedAt": "2025-09-03T02:35:09.900Z",
      "chapterId": "9ac64d22-7078-4b4a-83f8-a2c09638ae47"
    }
  ],
  "marks": [
    {
      "id": "27eaec86-946f-4c9a-95f5-73e65f9bc4c8",
      "content": "Tv 102 là *một Tv hỗn hợp* và cũng là Tv thứ năm trong bảy Tv sám hối. Hai thi ca hợp thành Tv này. Thi ca I (cc. 2-12.24-25) là một ai ca của cá nhân ; còn thi ca II, một ai ca của tập thể (cc. 13-23.29), là lời khẩn cầu Đức Chúa đến phục hưng Xi-on. Cấu trúc : **1**) Lời kêu gọi Đức Chúa (cc. 2-3), dẫn vào phần còn lại ai ca của cá nhân ; **2**) Ai ca của cá nhân, một bệnh nhân đau nặng, hao mòn vì bệnh tật, bị đối phương phỉ báng nhục mạ (cc. 4-12) ; **3**) Ai ca của tập thể, cộng đoàn mới đi đày về muốn xin Đức Chúa nâng nhắc Xi-on lên khỏi cảnh điêu tàn để Xi-on trở thành trung tâm tôn giáo của thế giới (cc. 13-23) ; **4**) Ai ca của cá nhân (cc. 24-25) ; **5**) Thánh thi kết thúc Tv (cc. 26-28) ; **6**) Cái nhìn về tương lai (c.29).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 56,
      "endOffset": 56,
      "createdAt": "2025-09-03T02:35:08.836Z",
      "updatedAt": "2025-09-03T02:35:08.836Z",
