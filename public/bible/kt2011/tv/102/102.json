    {
      "id": "45214d63-b597-45da-9f7c-c149e0a3c35b",
      "content": "C.15 ám chỉ cảnh đổ nát điêu tàn của Giê-ru-sa-lem bị thiêu huỷ và tàn phá.",
      "kind": "MARK_KIND_FOOTNOTE",
