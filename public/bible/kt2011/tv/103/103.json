      "targetId": "ccad575d-b898-4d02-a611-c713f51906a3",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "3865b6c1-ed57-4b12-9ade-72884f6814d8",
      "content": "Bệnh tật mà tác giả mắc phải có thể đe doạ đến tính mạng. Bệnh tật đó là hậu quả của tội lỗi và hình phạt giáng xuống tội nhân. Ý tưởng này phù hợp với đạo lý về sự thưởng phạt.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 35,
      "endOffset": 35,
      "createdAt": "2025-09-03T02:35:15.989Z",
