{
  "chapter": {
    "id": "d79962bd-770b-45a5-be6a-df88cbb6d492",
    "number": 103,
    "createdAt": "2025-09-03T01:07:51.662Z",
    "updatedAt": "2025-09-03T01:07:51.662Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "7a2d0112-79d6-4e19-92f2-7ca465c4c4b2",
      "text": "*Của vua Đa-vít.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:35:15.811Z",
      "updatedAt": "2025-09-03T02:35:15.811Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "2a1464f0-65ea-4253-94f2-e3c33b266862",
      "text": "Chúc tụng CHÚA đi, hồn tôi hỡi,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:15.875Z",
      "updatedAt": "2025-09-03T02:35:15.875Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "5fdf0e22-10ab-461d-80bc-9e657dc6962a",
      "text": "toàn thân tôi, hãy chúc tụng Thánh Danh !",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:15.903Z",
      "updatedAt": "2025-09-03T02:35:15.903Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "7e87f57c-c45f-456f-b917-f1dfbcc9a2e7",
      "text": "Chúc tụng CHÚA đi, hồn tôi hỡi,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:15.917Z",
      "updatedAt": "2025-09-03T02:35:15.917Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "4adb94db-c1eb-41a3-b532-79edd3004f77",
      "text": "chớ khá quên mọi ân huệ của Người.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:15.931Z",
      "updatedAt": "2025-09-03T02:35:15.931Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "52fef7b0-8164-4668-be32-627ced75ef0a",
      "text": "CHÚA tha cho ngươi muôn ngàn tội lỗi,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:15.945Z",
      "updatedAt": "2025-09-03T02:35:15.945Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "bff764ff-753b-4a9c-81f6-5ad8de0b9a25",
      "text": "thương chữa lành các bệnh tật ngươi.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:15.975Z",
      "updatedAt": "2025-09-03T02:35:15.975Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "01b08df0-b593-45a7-b7e5-4a6bbaabaa90",
      "text": "Cứu ngươi khỏi chôn vùi đáy huyệt,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:16.002Z",
      "updatedAt": "2025-09-03T02:35:16.002Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "c2a462dc-0eb6-42de-97df-faaf25612d6a",
      "text": "bao bọc ngươi bằng ân nghĩa với lượng hải hà,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:16.017Z",
      "updatedAt": "2025-09-03T02:35:16.017Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "60872a8b-3483-4ec9-a7a9-6a897af2de4b",
      "text": "ban cho đời ngươi chứa chan hạnh phúc,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:16.032Z",
      "updatedAt": "2025-09-03T02:35:16.032Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "ccad575d-b898-4d02-a611-c713f51906a3",
      "text": "khiến tuổi xuân ngươi mạnh mẽ tựa chim bằng.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:16.046Z",
      "updatedAt": "2025-09-03T02:35:16.046Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "3c675fdb-17ab-4836-82fa-08b4f86f584f",
      "text": "CHÚA phân xử công minh,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:16.074Z",
      "updatedAt": "2025-09-03T02:35:16.074Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "19fa91ab-6981-454a-bf33-ef2322273bfc",
      "text": "bênh quyền lợi những ai bị áp bức,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:16.103Z",
      "updatedAt": "2025-09-03T02:35:16.103Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "e3ea7423-6cd8-4f24-b345-28c09412a281",
      "text": "mặc khải cho Mô-sê biết đường lối của Người,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:16.117Z",
      "updatedAt": "2025-09-03T02:35:16.117Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "794d59f0-c625-45d4-93e0-cf209b5f8007",
      "text": "cho con cái nhà Ít-ra-en",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:16.145Z",
      "updatedAt": "2025-09-03T02:35:16.145Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "675567d8-7045-4681-943e-55007de17000",
      "text": "thấy những kỳ công Người thực hiện.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:16.174Z",
      "updatedAt": "2025-09-03T02:35:16.174Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "bd72a415-d892-431d-9a2b-9a2a87d7d549",
      "text": "CHÚA là Đấng từ bi nhân hậu,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:16.188Z",
      "updatedAt": "2025-09-03T02:35:16.188Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "c10748ca-143a-4efb-8722-c10ca7ea8a96",
      "text": "Người chậm giận và giàu tình thương,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:16.216Z",
      "updatedAt": "2025-09-03T02:35:16.216Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "e2daa359-9102-4e5b-b295-ba4806a8823a",
      "text": "chẳng trách cứ luôn luôn,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:16.232Z",
      "updatedAt": "2025-09-03T02:35:16.232Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "3d2251a9-ddad-4c9f-a49d-e31e9dbaf66c",
      "text": "không oán hờn mãi mãi.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:16.252Z",
      "updatedAt": "2025-09-03T02:35:16.252Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "686e274f-e97b-4fdb-b0f5-49b5dfeebd31",
      "text": "Người không cứ tội ta mà xét xử,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:16.266Z",
      "updatedAt": "2025-09-03T02:35:16.266Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "5a159af7-680a-44d3-ab82-6a69d4b7eb7c",
      "text": "không trả báo ta xứng với lỗi lầm.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:16.283Z",
      "updatedAt": "2025-09-03T02:35:16.283Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "515e792e-54b9-4548-98d1-ec51f6a76d7e",
      "text": "Như trời xanh trổi cao hơn mặt đất,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:16.296Z",
      "updatedAt": "2025-09-03T02:35:16.296Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "b7182418-b968-4e8c-bfb0-3b121e90a680",
      "text": "tình Chúa thương kẻ thờ Người cũng trổi cao.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:16.311Z",
      "updatedAt": "2025-09-03T02:35:16.311Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "629449cc-4775-4d7a-bb6e-782b296b985b",
      "text": "Như đông đoài cách xa nhau ngàn dặm,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:16.328Z",
      "updatedAt": "2025-09-03T02:35:16.328Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "8adc5610-ac1c-4d33-896a-34d74aa87a34",
      "text": "tội ta đã phạm, Chúa cũng ném thật xa ta.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:16.343Z",
      "updatedAt": "2025-09-03T02:35:16.343Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "8afed019-9c86-49a2-9928-061292e77850",
      "text": "Như người cha chạnh lòng thương con cái,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:16.362Z",
      "updatedAt": "2025-09-03T02:35:16.362Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "20dca737-c466-4913-9375-01aeb6a49f73",
      "text": "CHÚA cũng chạnh lòng thương kẻ kính tôn.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:16.373Z",
      "updatedAt": "2025-09-03T02:35:16.373Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "19fd0b4e-7ac7-4a61-b192-673acbbe3d20",
      "text": "Người quá biết ta được nhồi nắn bằng gì,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:16.385Z",
      "updatedAt": "2025-09-03T02:35:16.385Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "ff2fed22-02d2-4b46-8683-730aa02442a1",
      "text": "hẳn Người nhớ : ta chỉ là cát bụi.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:16.405Z",
      "updatedAt": "2025-09-03T02:35:16.405Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "8d964948-4867-4e82-bb10-b124eb13d1a5",
      "text": "Kiếp phù sinh, tháng ngày vắn vỏi,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:16.415Z",
      "updatedAt": "2025-09-03T02:35:16.415Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "f14ec3b4-b868-446b-8a7e-03978fbbbd1d",
      "text": "tươi thắm như cỏ nội hoa đồng,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:16.426Z",
      "updatedAt": "2025-09-03T02:35:16.426Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "ff539233-c3b9-40a8-aaca-8446dfd75d65",
      "text": "một cơn gió thoảng là xong,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:16.447Z",
      "updatedAt": "2025-09-03T02:35:16.447Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "5daf9793-65af-4370-8ac6-17b26b4f63ef",
      "text": "chốn xưa mình ở cũng không biết mình.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:16.468Z",
      "updatedAt": "2025-09-03T02:35:16.468Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "29c92d66-6210-4bfb-b3c0-6e9d739177ac",
      "text": "Nhưng ân tình CHÚA thiên thu vạn đại,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:16.478Z",
      "updatedAt": "2025-09-03T02:35:16.478Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "7f21929d-93b7-4c1e-bcdc-0781608a4e07",
      "text": "dành cho kẻ nào hết dạ kính tôn.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:16.488Z",
      "updatedAt": "2025-09-03T02:35:16.488Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "74b5ace5-2b67-40e0-ba53-c7c0e93bcf56",
      "text": "Người xử công minh cả với đời con cháu,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 2,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:16.498Z",
      "updatedAt": "2025-09-03T02:35:16.498Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "a748eee6-57b8-4137-b88e-8c066ba96f68",
      "text": "cả những ai giữ giao ước của Người",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:16.508Z",
      "updatedAt": "2025-09-03T02:35:16.508Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "465848f4-b399-4628-81c3-40f9a24681b6",
      "text": "và nhớ tuân hành mệnh lệnh Người ban.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:16.520Z",
      "updatedAt": "2025-09-03T02:35:16.520Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "e18654e3-3f98-4f17-b882-845bd4293e52",
      "text": "CHÚA đặt ngai báu trên trời cao thẳm,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:16.530Z",
      "updatedAt": "2025-09-03T02:35:16.530Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "7e9c60c3-beab-478c-a8ea-846a2df1b159",
      "text": "quyền đế vương bá chủ muôn loài.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:16.540Z",
      "updatedAt": "2025-09-03T02:35:16.540Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "cf930852-8b58-4761-88c0-70859fb3705e",
      "text": "Chúc tụng CHÚA đi, hỡi muôn vì thiên sứ,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:16.550Z",
      "updatedAt": "2025-09-03T02:35:16.550Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "ff7b0565-33de-41b4-aaff-0cb02afd45f2",
      "text": "bậc anh hùng dũng mãnh thực hiện lời Người,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:16.561Z",
      "updatedAt": "2025-09-03T02:35:16.561Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "21753072-8693-4eb3-88c9-3787ccebcfeb",
      "text": "luôn sẵn sàng phụng lệnh.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 2,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:16.592Z",
      "updatedAt": "2025-09-03T02:35:16.592Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "5936b332-78b9-443a-bbb4-be4228484063",
      "text": "Chúc tụng CHÚA đi, toàn thể thiên binh,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:16.601Z",
      "updatedAt": "2025-09-03T02:35:16.601Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "812edcb4-d652-47dc-8982-ddee043c3865",
      "text": "hằng hầu cận và tuân hành thánh ý.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:16.612Z",
      "updatedAt": "2025-09-03T02:35:16.612Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "71038c6d-8253-45ea-8694-d6c21c451ec2",
      "text": "Chúc tụng CHÚA đi, muôn vật Chúa tạo thành,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:16.629Z",
      "updatedAt": "2025-09-03T02:35:16.629Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "550cca00-3234-49b9-ae7d-3fca98b9cf3f",
      "text": "thuộc quyền Người thống trị khắp nơi nơi.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:16.640Z",
      "updatedAt": "2025-09-03T02:35:16.640Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    },
    {
      "id": "fac96ddc-7ca4-4ef1-af55-092930a581f6",
      "text": "Chúc tụng CHÚA đi, hồn tôi hỡi !",
      "label": "22",
      "number": 22,
      "subVerseIndex": 2,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:16.651Z",
      "updatedAt": "2025-09-03T02:35:16.651Z",
      "chapterId": "d79962bd-770b-45a5-be6a-df88cbb6d492"
    }
  ],
  "marks": [
    {
      "id": "e9006a56-dbed-4831-8603-5fed9e7c053c",
      "content": "English: Yahweh | French: SEIGNEUR | Latin: Dominus | Origin: &#1497;&#1456;&#1492;&#64331;&#1464;&#1492; | Vietnamese: ĐỨC CHÚA -- Danh của Thiên Chúa Ít-ra-en, St 2,4...",
      "kind": "MARK_KIND_FOOTNOTE",
