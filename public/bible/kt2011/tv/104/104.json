{
  "chapter": {
    "id": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b",
    "number": 104,
    "createdAt": "2025-09-03T01:07:51.662Z",
    "updatedAt": "2025-09-03T01:07:51.662Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "35ed69cb-da0c-4cef-b08b-9ad219252d67",
      "text": "Chúc tụng CHÚA đi, hồn tôi hỡi !",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:21.973Z",
      "updatedAt": "2025-09-03T02:35:21.973Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "6b95c33e-d24f-4bad-bd82-104cee1ca8e9",
      "text": "Lạy CHÚA là Thiên Chúa con thờ, Chúa muôn trùng cao cả !",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.011Z",
      "updatedAt": "2025-09-03T02:35:22.011Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "a2cc1100-abf9-44a3-86a1-77409918dc01",
      "text": "Áo Ngài mặc : toàn oai phong lẫm liệt,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.025Z",
      "updatedAt": "2025-09-03T02:35:22.025Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "eb1e2dc8-3892-4b25-b8af-ba3229cddb63",
      "text": "cẩm bào Ngài khoác : muôn vạn ánh hào quang.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.039Z",
      "updatedAt": "2025-09-03T02:35:22.039Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "849bcd30-de03-4b72-80a2-d96793cb967a",
      "text": "Tầng trời thẳm, Chúa căng như màn trướng,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.053Z",
      "updatedAt": "2025-09-03T02:35:22.053Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "aee20e80-2cf5-41e8-b04c-39f323791e2c",
      "text": "điện cao vời, dựng trên khối nước cõi thanh không.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.066Z",
      "updatedAt": "2025-09-03T02:35:22.066Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "cdfcc069-a76c-4520-9a39-22223dba0639",
      "text": "Chúa ngự giá xe mây, Ngài lướt bay cánh gió.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.081Z",
      "updatedAt": "2025-09-03T02:35:22.081Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "b4f823c3-406d-4441-b6d4-0466b817fd22",
      "text": "Sứ giả Ngài : làm gió bốn phương,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.109Z",
      "updatedAt": "2025-09-03T02:35:22.109Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "9d4914ed-16b7-4fa8-81e0-a45de781649d",
      "text": "nô bộc Chúa : lửa hồng muôn ngọn.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.122Z",
      "updatedAt": "2025-09-03T02:35:22.122Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "ddd68f27-5df6-459a-8d5e-19fb2d85886d",
      "text": "Chúa lập địa cầu trên nền vững,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.136Z",
      "updatedAt": "2025-09-03T02:35:22.136Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "fb516893-52ae-4354-a704-471467d1c381",
      "text": "khôn chuyển lay muôn thuở muôn đời !",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.150Z",
      "updatedAt": "2025-09-03T02:35:22.150Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "414a624c-5805-423f-96e2-1d288ae48856",
      "text": "Áo vực thẳm choàng lên trái đất,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.165Z",
      "updatedAt": "2025-09-03T02:35:22.165Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "c15b5e68-176e-48e3-9fde-4c9857aab65f",
      "text": "khối nước nguồn tụ lại đỉnh non cao.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.178Z",
      "updatedAt": "2025-09-03T02:35:22.178Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "d435c71c-d1e8-43c2-86cc-b8adc34a491d",
      "text": "Nghe tiếng Ngài doạ nạt, chúng đồng loạt chạy dài ;",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.192Z",
      "updatedAt": "2025-09-03T02:35:22.192Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "ef289152-f9af-4be7-9fb9-29dd0fe1fccc",
      "text": "sấm Ngài mới rền vang, chúng kinh hoàng trốn thoát,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.206Z",
      "updatedAt": "2025-09-03T02:35:22.206Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "3ee79ae6-6493-4640-8128-cf8373140ad4",
      "text": "băng qua núi qua đồi, chảy xuôi ra đồng nội",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.221Z",
      "updatedAt": "2025-09-03T02:35:22.221Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "c06e44cd-60b6-4986-ba59-71cb32b496b1",
      "text": "về nơi Chúa đặt cho.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.234Z",
      "updatedAt": "2025-09-03T02:35:22.234Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "6dfb3e20-bd71-4dbd-ad7b-98c26c964208",
      "text": "Ngài vạch đường ranh giới ngăn cản chúng vượt qua,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.248Z",
      "updatedAt": "2025-09-03T02:35:22.248Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "3323fbc5-6d4a-4cfe-9e6b-c456a944e08d",
      "text": "không còn cho trở lại dâng lên ngập địa cầu.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.276Z",
      "updatedAt": "2025-09-03T02:35:22.276Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "0d7789da-1c5b-4a7e-a554-30ba9f4fc00a",
      "text": "Chúa khơi nguồn : suối tuôn thác đổ,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.289Z",
      "updatedAt": "2025-09-03T02:35:22.289Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "d3724875-cf19-4c2d-a735-3484d82d1f2b",
      "text": "giữa núi đồi, lượn khúc quanh co,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.303Z",
      "updatedAt": "2025-09-03T02:35:22.303Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "76374ec9-6fae-492b-b55c-34fc4716445d",
      "text": "đem nước uống cho loài dã thú,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.317Z",
      "updatedAt": "2025-09-03T02:35:22.317Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "22cfda91-41b9-4b29-9a7a-e526a1a52988",
      "text": "bầy ngựa hoang đang khát được thoả thuê.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.331Z",
      "updatedAt": "2025-09-03T02:35:22.331Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "364b895f-020f-4a9c-bd59-7cb8fdf0504a",
      "text": "Bên dòng suối, chim trời làm tổ,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.348Z",
      "updatedAt": "2025-09-03T02:35:22.348Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "7f2a5654-f52e-4794-b0b5-e3aea22ed629",
      "text": "dưới lá cành cất giọng líu lo.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.363Z",
      "updatedAt": "2025-09-03T02:35:22.363Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "18149192-992c-4f8d-8cb7-a42d0535476a",
      "text": "Từ cao thẳm, Chúa đổ mưa xuống núi,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.377Z",
      "updatedAt": "2025-09-03T02:35:22.377Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "0c5a4018-5e55-4b45-be44-cfb460fdc826",
      "text": "đất chứa chan phước lộc của Ngài.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.404Z",
      "updatedAt": "2025-09-03T02:35:22.404Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "93d34313-7157-450c-a7ab-f21de5e41f01",
      "text": "Ngài khiến mọc cỏ xanh nuôi sống đàn gia súc,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.418Z",
      "updatedAt": "2025-09-03T02:35:22.418Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "8ec0509a-0943-4153-926e-9cacfe9992c5",
      "text": "làm tốt tươi thảo mộc cho người thế hưởng dùng.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.432Z",
      "updatedAt": "2025-09-03T02:35:22.432Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "fcd36b96-ac56-4539-b3fa-788749ac03c0",
      "text": "Từ ruộng đất, họ kiếm ra cơm bánh,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 2,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.449Z",
      "updatedAt": "2025-09-03T02:35:22.449Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "73e825e8-5e6e-4a80-b515-e7bdd286aab3",
      "text": "chế rượu ngon cho phấn khởi lòng người,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.463Z",
      "updatedAt": "2025-09-03T02:35:22.463Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "ff9bd632-5824-434e-bc2e-03a33f5a56d2",
      "text": "xức dầu thơm cho gương mặt sáng tươi,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.477Z",
      "updatedAt": "2025-09-03T02:35:22.477Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "1a898f9a-623a-4566-a2e8-09f0a38bd14f",
      "text": "nhờ cơm bánh mà no lòng chắc dạ.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 2,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.490Z",
      "updatedAt": "2025-09-03T02:35:22.490Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "ec453137-2c1d-4928-9749-edcf57ae5dc9",
      "text": "Hương bá Li-băng, những cây CHÚA đã trồng,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.518Z",
      "updatedAt": "2025-09-03T02:35:22.518Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "f47ac635-3a0a-4bdd-832b-267901a1f62f",
      "text": "được tràn trề nhựa sống.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.547Z",
      "updatedAt": "2025-09-03T02:35:22.547Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "332cd06e-c625-482f-9b15-f85341da58ef",
      "text": "Bầy chim tước rủ nhau làm ổ,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.560Z",
      "updatedAt": "2025-09-03T02:35:22.560Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "5a8b295e-d471-4d98-85b0-d8e016ffe905",
      "text": "hạc bay về xây tổ ngọn cao.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.574Z",
      "updatedAt": "2025-09-03T02:35:22.574Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "16d10fc9-0a28-4e75-8529-620c955ac22e",
      "text": "Núi chon von, loài sơn dương tìm đến,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.589Z",
      "updatedAt": "2025-09-03T02:35:22.589Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "900b0df2-4c4a-4195-8f98-0313bc23dcd8",
      "text": "hốc đá sâu, giống ngân thử ẩn mình.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.602Z",
      "updatedAt": "2025-09-03T02:35:22.602Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "9968ba9d-5204-4977-bc13-d36aa3c6fbe2",
      "text": "Chúa đặt vầng trăng để đo thời tiết,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.615Z",
      "updatedAt": "2025-09-03T02:35:22.615Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "ecdc1cf3-e846-4e61-bd22-0998241abf18",
      "text": "dạy mặt trời biết lặn đúng thời gian.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.641Z",
      "updatedAt": "2025-09-03T02:35:22.641Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "6735e3a3-707e-49b6-8543-28a379921996",
      "text": "Đêm trở lại khi Chúa buông màn tối,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.654Z",
      "updatedAt": "2025-09-03T02:35:22.654Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "75571f8b-efec-4705-a9d5-df4344e3097c",
      "text": "chốn rừng sâu, muông thú tung hoành.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.668Z",
      "updatedAt": "2025-09-03T02:35:22.668Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "42fbe59c-e262-4d95-96f5-0f4dcaab51d4",
      "text": "Tiếng sư tử gầm lên vang dội,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.682Z",
      "updatedAt": "2025-09-03T02:35:22.682Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "39f7c2d3-2e34-49a5-9600-bca93dd146e3",
      "text": "chúng săn mồi, gào xin Chúa cho ăn.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.696Z",
      "updatedAt": "2025-09-03T02:35:22.696Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "98c5f5c3-d13d-42aa-9e6c-29355c1c2a3f",
      "text": "Ánh dương lên, chúng bảo nhau về,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.716Z",
      "updatedAt": "2025-09-03T02:35:22.716Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "94e975e8-b328-4d1d-8e47-01d1cef691c8",
      "text": "tìm hang hốc, chui vào nằm nghỉ.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.729Z",
      "updatedAt": "2025-09-03T02:35:22.729Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "d555d641-93e1-4ba6-b230-f092039dafb1",
      "text": "Đến lượt con người ra đi làm lụng,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.743Z",
      "updatedAt": "2025-09-03T02:35:22.743Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "ed66cae5-f5b2-4eae-ab04-c72a06a4c980",
      "text": "những mải mê tới lúc chiều tà.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.757Z",
      "updatedAt": "2025-09-03T02:35:22.757Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "98922e3c-c0ea-4db9-a2ef-ae33e9d2b0d8",
      "text": "Công trình Ngài, lạy CHÚA, quả thiên hình vạn trạng !",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.771Z",
      "updatedAt": "2025-09-03T02:35:22.771Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "234159fd-ca72-4a9f-b739-5c0af92f848c",
      "text": "Chúa hoàn thành tất cả thật khôn ngoan,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.783Z",
      "updatedAt": "2025-09-03T02:35:22.783Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "718e2a80-a8c4-4cb8-8d6e-4867b765e35d",
      "text": "những loài Chúa dựng nên lan tràn mặt đất.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 2,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.794Z",
      "updatedAt": "2025-09-03T02:35:22.794Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "bc69eb00-5d02-4946-af84-c329759e2166",
      "text": "Này đại dương bát ngát mênh mông,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.805Z",
      "updatedAt": "2025-09-03T02:35:22.805Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "125b5f4f-9c2e-429b-b7d0-d29c5e2ab0e7",
      "text": "nơi muôn vàn sinh vật to lẫn nhỏ vẫy vùng,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.816Z",
      "updatedAt": "2025-09-03T02:35:22.816Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "24a7a492-b640-463d-ba2a-213715cbaaad",
      "text": "nơi tàu bè cỡi sóng và thuỷ quái tung tăng,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.828Z",
      "updatedAt": "2025-09-03T02:35:22.828Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "7a0d8158-67e5-489c-8c83-9e1530ed9a72",
      "text": "là vật Chúa tạo thành để làm trò tiêu khiển.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.841Z",
      "updatedAt": "2025-09-03T02:35:22.841Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "87cde82f-a3ae-49bc-934a-991a4eb70cfe",
      "text": "Hết mọi loài ngửa trông lên Chúa",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.855Z",
      "updatedAt": "2025-09-03T02:35:22.855Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "366ea2dd-5985-4369-a032-4879d2553943",
      "text": "đợi chờ Ngài đến bữa cho ăn.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.889Z",
      "updatedAt": "2025-09-03T02:35:22.889Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "7ada7747-7e30-46fe-ae2a-aa7d1da860bd",
      "text": "Ngài ban xuống, chúng lượm về,",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.903Z",
      "updatedAt": "2025-09-03T02:35:22.903Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "00afc8a4-3197-4dc0-b8bb-efcf5bb4186c",
      "text": "Ngài mở tay, chúng thoả thuê ơn phước.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 1,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.917Z",
      "updatedAt": "2025-09-03T02:35:22.917Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "cea4ad0b-0b45-41f7-ac7e-868e300a980b",
      "text": "Chúa ẩn mặt đi, chúng rụng rời kinh hãi ;",
      "label": "29",
      "number": 29,
      "subVerseIndex": 0,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.931Z",
      "updatedAt": "2025-09-03T02:35:22.931Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "f2388af0-c6fb-4023-8634-9f83f6a76a29",
      "text": "lấy sinh khí lại, là chúng tắt thở ngay, mà trở về cát bụi.",
      "label": "29",
      "number": 29,
      "subVerseIndex": 1,
      "paragraphNumber": 61,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.944Z",
      "updatedAt": "2025-09-03T02:35:22.944Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "baa7fc84-d9d0-44ba-b3e1-60960d7a67fc",
      "text": "Sinh khí của Ngài, Ngài gửi tới,",
      "label": "30",
      "number": 30,
      "subVerseIndex": 0,
      "paragraphNumber": 62,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.958Z",
      "updatedAt": "2025-09-03T02:35:22.958Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "acf3b58a-2863-43f0-b79b-35cd91421c77",
      "text": "là chúng được dựng nên,",
      "label": "30",
      "number": 30,
      "subVerseIndex": 1,
      "paragraphNumber": 63,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:22.986Z",
      "updatedAt": "2025-09-03T02:35:22.986Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "4231ea8c-fc6e-41f2-a67f-84c8f40e6467",
      "text": "và Ngài đổi mới mặt đất này.",
      "label": "30",
      "number": 30,
      "subVerseIndex": 2,
      "paragraphNumber": 64,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:23.014Z",
      "updatedAt": "2025-09-03T02:35:23.014Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "81fd33c9-1eeb-499b-99ba-42efeb1e05fa",
      "text": "Vinh hiển CHÚA, nguyện muôn năm tồn tại,",
      "label": "31",
      "number": 31,
      "subVerseIndex": 0,
      "paragraphNumber": 65,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:23.028Z",
      "updatedAt": "2025-09-03T02:35:23.028Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "1a80c3b9-1973-4d3a-bf61-e4ee33e21c53",
      "text": "công trình CHÚA làm Chúa được hân hoan.",
      "label": "31",
      "number": 31,
      "subVerseIndex": 1,
      "paragraphNumber": 66,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:23.042Z",
      "updatedAt": "2025-09-03T02:35:23.042Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "e5925937-7583-45cc-96cf-6580d9721730",
      "text": "Chúa nhìn đất thấp, đất sợ run lẩy bẩy,",
      "label": "32",
      "number": 32,
      "subVerseIndex": 0,
      "paragraphNumber": 67,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:23.056Z",
      "updatedAt": "2025-09-03T02:35:23.056Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "243a89d9-9d7e-45e8-a534-91a2051a16d5",
      "text": "Người chạm núi cao, núi toả khói mịt mù.",
      "label": "32",
      "number": 32,
      "subVerseIndex": 1,
      "paragraphNumber": 68,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:23.070Z",
      "updatedAt": "2025-09-03T02:35:23.070Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "e3aeffd1-14cd-40be-a8e0-4ad97dc68d24",
      "text": "Suốt cuộc đời, tôi sẽ ca mừng CHÚA,",
      "label": "33",
      "number": 33,
      "subVerseIndex": 0,
      "paragraphNumber": 69,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:23.084Z",
      "updatedAt": "2025-09-03T02:35:23.084Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "78858022-513b-462c-b9ee-29860d2b9aa5",
      "text": "sống ngày nào, xin đàn hát kính Thiên Chúa của tôi.",
      "label": "33",
      "number": 33,
      "subVerseIndex": 1,
      "paragraphNumber": 70,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:23.098Z",
      "updatedAt": "2025-09-03T02:35:23.098Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "427110a9-43e5-48f7-8840-a6db69f01c2b",
      "text": "Nguyện tiếng lòng tôi làm cho Người vui thoả,",
      "label": "34",
      "number": 34,
      "subVerseIndex": 0,
      "paragraphNumber": 71,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:23.112Z",
      "updatedAt": "2025-09-03T02:35:23.112Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "a160880b-2e02-481e-a543-4cab891ada28",
      "text": "đối với tôi, niềm vui là chính CHÚA.",
      "label": "34",
      "number": 34,
      "subVerseIndex": 1,
      "paragraphNumber": 72,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:23.126Z",
      "updatedAt": "2025-09-03T02:35:23.126Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "973455f2-0cd2-4d7a-84b0-38edfb6ded54",
      "text": "Ước gì tội nhân phải biệt tích cõi đời,",
      "label": "35",
      "number": 35,
      "subVerseIndex": 0,
      "paragraphNumber": 73,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:23.139Z",
      "updatedAt": "2025-09-03T02:35:23.139Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "1885d28b-2f90-4904-9e15-c1a233d7a0e3",
      "text": "bọn bất lương sạch bóng chẳng còn ai.",
      "label": "35",
      "number": 35,
      "subVerseIndex": 1,
      "paragraphNumber": 74,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:23.153Z",
      "updatedAt": "2025-09-03T02:35:23.153Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    },
    {
      "id": "4779ee78-838e-4328-8257-8a62d38f0fd0",
      "text": "Chúc tụng CHÚA đi, hồn tôi hỡi !",
      "label": "35",
      "number": 35,
      "subVerseIndex": 2,
      "paragraphNumber": 75,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:23.167Z",
      "updatedAt": "2025-09-03T02:35:23.167Z",
      "chapterId": "4817dccb-9c6e-4da1-aa15-8344bcbfd20b"
    }
  ],
  "marks": [
    {
      "id": "75b5c4e7-8ccd-4656-b237-d686a3e7952d",
      "content": "Đây là *một thánh thi* dùng để ca tụng Đức Chúa, Đấng tạo thành vũ trụ. Thánh thi là viên ngọc quý khác trong sách Tv, đã được tác giả soạn thảo với một tâm hồn nồng nhiệt do đức tin và lòng mến đối với Thiên Chúa của Ít-ra-en. Tác phẩm này có một giá trị tôn giáo và văn chương khá đặc biệt. Có thể dựa vào mối tương quan của Đấng Tạo Hoá với vũ trụ để chia Tv 104 làm bảy phần : **1**) Trời (cc. 1-4) ; **2**) Đất (cc. 5-9) ; **3**) Nước (cc. 10-13) ; **4**) Lương thực (cc. 14-18) ; **5**) Thời gian (cc. 19-23) ; **6**) Biển (cc. 24-26) ; **7**) Sự sống (cc. 27-30). Sau bảy phần đó, cc. 31-35 là một thứ vinh tụng ca kết thúc thánh thi.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 33,
      "endOffset": 33,
      "createdAt": "2025-09-03T02:35:21.997Z",
