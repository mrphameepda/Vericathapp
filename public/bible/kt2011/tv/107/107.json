{
  "chapter": {
    "id": "c67e7345-4f3c-445e-9628-f119c6bd6525",
    "number": 107,
    "createdAt": "2025-09-03T01:07:51.662Z",
    "updatedAt": "2025-09-03T01:07:51.662Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "f1a450e5-cd5b-4104-bd70-d9b8ed0bfc5c",
      "text": "Ha-lê-lui-a.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:43.572Z",
      "updatedAt": "2025-09-03T02:35:43.572Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "7e70df05-c0bc-438e-8816-ae3807150f54",
      "text": "Hãy tạ ơn CHÚA vì Chúa nhân từ,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:43.611Z",
      "updatedAt": "2025-09-03T02:35:43.611Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "1637f0bf-b6f5-4b51-83ac-f8da38c17cf8",
      "text": "muôn ngàn đời Chúa vẫn trọn tình thương.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:43.635Z",
      "updatedAt": "2025-09-03T02:35:43.635Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "516e1e73-5f5f-4751-9da3-f9435f8b166f",
      "text": "Họ sẽ cùng nói lên như vậy,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:43.649Z",
      "updatedAt": "2025-09-03T02:35:43.649Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "73641b42-a842-4401-ad82-1db1c34edb06",
      "text": "những người được CHÚA thương giải thoát ;",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:43.663Z",
      "updatedAt": "2025-09-03T02:35:43.663Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "9cb6125d-1a9f-4ebf-a161-7c46a17934df",
      "text": "giải thoát cho khỏi tay địch thù,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:43.691Z",
      "updatedAt": "2025-09-03T02:35:43.691Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "0e1e8496-e38a-4e8b-961d-7a89b87eff68",
      "text": "triệu tập về từ bao viễn xứ,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:43.705Z",
      "updatedAt": "2025-09-03T02:35:43.705Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "6f6dc21d-996e-4040-8ace-bfdf4f75a52e",
      "text": "khắp miền nam bắc, khắp ngả đông tây.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:43.719Z",
      "updatedAt": "2025-09-03T02:35:43.719Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "f5e76202-8778-4785-bb41-386e003f5add",
      "text": "Họ lạc bước trong vùng sa mạc, nơi cằn cỗi,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:43.733Z",
      "updatedAt": "2025-09-03T02:35:43.733Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "d98839e7-6ef9-49fe-aee5-71820d2336bb",
      "text": "không thấy đường về chốn thành thị để định cư,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:43.747Z",
      "updatedAt": "2025-09-03T02:35:43.747Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "52ead156-bcc9-451e-9a46-2f9d34b6ad6b",
      "text": "vừa đói vừa khát, mạng sống đã hầu tàn.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:43.761Z",
      "updatedAt": "2025-09-03T02:35:43.761Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "1d2402e0-ea8c-4adc-827a-8f8530f9ad38",
      "text": "Khi gặp bước ngặt nghèo,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:43.774Z",
      "updatedAt": "2025-09-03T02:35:43.774Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "d8df884c-8815-47ed-9641-31c1e5cfd4bc",
      "text": "họ kêu lên cùng CHÚA,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:43.788Z",
      "updatedAt": "2025-09-03T02:35:43.788Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "96a995b1-2a97-4ee8-90e1-9f93b00a1586",
      "text": "Người đưa tay kéo họ ra khỏi cảnh gian truân,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:43.800Z",
      "updatedAt": "2025-09-03T02:35:43.800Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "7c7ea1ce-3b82-4db1-b05c-d66505b239ee",
      "text": "dắt họ đi thẳng đường ngay lối",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:43.812Z",
      "updatedAt": "2025-09-03T02:35:43.812Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "2fbbffe5-abc4-43f6-83fe-821df1f7fa31",
      "text": "về chốn thành thị để định cư.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:43.835Z",
      "updatedAt": "2025-09-03T02:35:43.835Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "585c94b1-2cdd-4345-91f3-5607e154b1e7",
      "text": "Ước chi họ dâng lời cảm tạ vì tình thương của Chúa,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:43.847Z",
      "updatedAt": "2025-09-03T02:35:43.847Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "b8d3c10f-6144-4f07-8595-92475eff3b8e",
      "text": "và vì những kỳ công Chúa đã thực hiện cho người trần.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:43.860Z",
      "updatedAt": "2025-09-03T02:35:43.860Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "5c2a812a-9fae-4fcc-a8e3-fc2cb642fbb5",
      "text": "Họng ráo khô, Chúa cho uống phỉ tình,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:43.877Z",
      "updatedAt": "2025-09-03T02:35:43.877Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "8f0bd24d-b138-4850-8f3a-8b0146611e95",
      "text": "bụng đói lả, Người cho ăn thoả thích.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:43.890Z",
      "updatedAt": "2025-09-03T02:35:43.890Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "ac4bd504-cae7-40a3-80cb-691b102edcea",
      "text": "Họ phải sống trong cảnh tối tăm mù mịt,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:43.903Z",
      "updatedAt": "2025-09-03T02:35:43.903Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "dfe9b862-40b7-4769-93a0-ea57aac285e8",
      "text": "kiếp lầm than xiềng xích gông cùm ;",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:43.930Z",
      "updatedAt": "2025-09-03T02:35:43.930Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "c1d947b9-188d-42b7-81ab-b2727dadd0bf",
      "text": "vì họ chống cưỡng lời Thiên Chúa,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:43.944Z",
      "updatedAt": "2025-09-03T02:35:43.944Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "71196077-a499-41d6-b1e2-4309cbbed374",
      "text": "dám khinh nhờn lệnh Đấng Tối Cao,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:43.958Z",
      "updatedAt": "2025-09-03T02:35:43.958Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "276304a1-9752-4379-9232-978e9508e6b5",
      "text": "Người bắt họ nếm mùi gian khổ,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:43.987Z",
      "updatedAt": "2025-09-03T02:35:43.987Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "2ca8dbe2-303f-4699-b785-6e2f7ab0732d",
      "text": "phải lao đao mà không kẻ đỡ nâng.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.001Z",
      "updatedAt": "2025-09-03T02:35:44.001Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "b65c90d0-f4e9-4a3d-ae05-f1ba2b28f675",
      "text": "Khi gặp bước ngặt nghèo, họ kêu lên cùng CHÚA,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.014Z",
      "updatedAt": "2025-09-03T02:35:44.014Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "4e59bccf-b899-41a9-9757-ee32bed276d8",
      "text": "Người ra tay cứu họ thoát ngàn nỗi gian truân :",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.028Z",
      "updatedAt": "2025-09-03T02:35:44.028Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "9e4e09ff-7196-4766-b98f-bce62359b5b6",
      "text": "đưa ra khỏi cảnh tối tăm mù mịt",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.057Z",
      "updatedAt": "2025-09-03T02:35:44.057Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "724f5090-26ad-4279-a2c5-010bf024013d",
      "text": "và đập tan xiềng xích gông cùm.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.076Z",
      "updatedAt": "2025-09-03T02:35:44.076Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "b2c2a3c1-b405-4a0f-b704-301ac1dcb4d4",
      "text": "Ước chi họ dâng lời cảm tạ vì tình thương của Chúa,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.090Z",
      "updatedAt": "2025-09-03T02:35:44.090Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "2a100ed9-46fd-4a4c-aa58-4c0b610fee94",
      "text": "và vì những kỳ công Chúa đã thực hiện cho người trần.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.104Z",
      "updatedAt": "2025-09-03T02:35:44.104Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "da2f2f14-0c26-4058-bc29-8130c319a4cf",
      "text": "Cửa đồng kia, Chúa đã phá tung,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.118Z",
      "updatedAt": "2025-09-03T02:35:44.118Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "110dcc26-c3bf-493e-967b-df956fac66c5",
      "text": "then sắt nọ, tay Người bẻ gãy.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.132Z",
      "updatedAt": "2025-09-03T02:35:44.132Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "6f0404b3-bc66-4e72-9e3c-cdce593bc8dd",
      "text": "Họ hoá điên trong cuộc đời lầm lỗi,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.146Z",
      "updatedAt": "2025-09-03T02:35:44.146Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "fd390f5a-7361-450b-80f8-b35e8f635c4b",
      "text": "gánh tội tình đè nặng tấm thân,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.160Z",
      "updatedAt": "2025-09-03T02:35:44.160Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "4284d328-6506-450f-a394-9565a9915ca6",
      "text": "mọi thức ăn, họ đều chê chán,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.174Z",
      "updatedAt": "2025-09-03T02:35:44.174Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "632c647b-5603-45e0-95a3-e7c0c337ceff",
      "text": "và tiến gần tới cửa âm ty.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.188Z",
      "updatedAt": "2025-09-03T02:35:44.188Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "4b1130d8-9eab-4432-acde-b9af76b6db4b",
      "text": "Khi gặp bước ngặt nghèo, họ kêu lên cùng CHÚA,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.202Z",
      "updatedAt": "2025-09-03T02:35:44.202Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "61f161d4-085f-4792-bf2a-0172aaa75c2b",
      "text": "Người ra tay cứu họ thoát ngàn nỗi gian truân.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.216Z",
      "updatedAt": "2025-09-03T02:35:44.216Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "ce00de14-ea59-49a4-95e1-02e123082575",
      "text": "Sai lời Người đến, chữa cho lành mạnh,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.230Z",
      "updatedAt": "2025-09-03T02:35:44.230Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "1cba01cd-673f-4ad3-a9fc-995cc8ad7c0f",
      "text": "cứu họ khỏi sa vào hố sâu.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.243Z",
      "updatedAt": "2025-09-03T02:35:44.243Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "9979dd15-94a3-4414-9bc2-dcec61ff48b2",
      "text": "Ước chi họ dâng lời cảm tạ vì tình thương của Chúa,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.258Z",
      "updatedAt": "2025-09-03T02:35:44.258Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "f62fdb6f-98cc-451a-a10f-6f01bca3ff24",
      "text": "và vì những kỳ công Chúa đã thực hiện cho người trần.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.274Z",
      "updatedAt": "2025-09-03T02:35:44.274Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "8fe3450d-3a4f-44b4-9b0e-33088cdaaf8c",
      "text": "Ước chi họ dâng lễ tế tạ ơn Chúa,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.291Z",
      "updatedAt": "2025-09-03T02:35:44.291Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "cbfe9bf4-4349-4f97-8268-bfbbe24a83df",
      "text": "cất tiếng hò reo, tường thuật việc Chúa làm.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.323Z",
      "updatedAt": "2025-09-03T02:35:44.323Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "c47637fa-08f9-4efc-ae84-d35e06e0b0d5",
      "text": "Họ vượt biển ngược xuôi nghề thương mãi,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.337Z",
      "updatedAt": "2025-09-03T02:35:44.337Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "1c619149-bb5b-4f5f-bffd-d002f325bf7b",
      "text": "giữa trùng dương lèo lái con tàu,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.351Z",
      "updatedAt": "2025-09-03T02:35:44.351Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "8a158bdd-fd22-4e74-a608-28d9ef722fed",
      "text": "mắt đã tường việc CHÚA làm nên",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.365Z",
      "updatedAt": "2025-09-03T02:35:44.365Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "f6eb9c06-566e-4428-b047-397199d203c2",
      "text": "và kỳ công Người thực hiện giữa dòng nước lũ.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.378Z",
      "updatedAt": "2025-09-03T02:35:44.378Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "e146ac42-c099-420f-b956-aa987e8020b9",
      "text": "Chúa truyền lệnh khiến bùng lên bão táp,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.392Z",
      "updatedAt": "2025-09-03T02:35:44.392Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "f8f2fe64-7af0-45c5-9ef1-c12c7379231f",
      "text": "lớp sóng xô cuồn cuộn dập dồn.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.407Z",
      "updatedAt": "2025-09-03T02:35:44.407Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "42eecf39-bc0e-424c-963e-891fbabd0224",
      "text": "Họ nhô lên tận trời, nhào xuống vực sâu,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.421Z",
      "updatedAt": "2025-09-03T02:35:44.421Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "429bd1e5-7c98-4fac-bf4c-b582d25d737f",
      "text": "lúc nguy hiểm, hồn xiêu phách lạc,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.435Z",
      "updatedAt": "2025-09-03T02:35:44.435Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "c4b68d1a-2d20-4c48-94f3-7f5024076d5b",
      "text": "bị quay cuồng, lảo đảo như say,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.449Z",
      "updatedAt": "2025-09-03T02:35:44.449Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "909124d3-2f96-4f73-8a7c-b74db34ac45e",
      "text": "khéo cùng khôn đã chìm đâu mất.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.463Z",
      "updatedAt": "2025-09-03T02:35:44.463Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "76211c2e-7bcd-4b11-9f04-12e7d3ce1c3d",
      "text": "Khi gặp bước ngặt nghèo, họ kêu lên cùng CHÚA,",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.476Z",
      "updatedAt": "2025-09-03T02:35:44.476Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "8e366e36-1109-4917-baa7-608a2414250f",
      "text": "Người đưa tay kéo họ ra khỏi cảnh gian truân.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 1,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.490Z",
      "updatedAt": "2025-09-03T02:35:44.490Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "02e4eebe-c4a8-4203-92dc-5b1e201daeab",
      "text": "Đổi phong ba thành gió thoảng nhẹ nhàng,",
      "label": "29",
      "number": 29,
      "subVerseIndex": 0,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.504Z",
      "updatedAt": "2025-09-03T02:35:44.504Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "12b68bb9-86e4-425e-a578-61cdb32d1d1d",
      "text": "sóng đang gầm, bỗng đâu im tiếng,",
      "label": "29",
      "number": 29,
      "subVerseIndex": 1,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.518Z",
      "updatedAt": "2025-09-03T02:35:44.518Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "019c923f-9c0c-4f7e-858d-7ac4904547d8",
      "text": "họ vui sướng, vì trời yên bể lặng",
      "label": "30",
      "number": 30,
      "subVerseIndex": 0,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.531Z",
      "updatedAt": "2025-09-03T02:35:44.531Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "8fed3d70-d8ef-4eab-91e1-cbcadb76acd9",
      "text": "và Chúa dẫn đưa về bờ bến mong chờ.",
      "label": "30",
      "number": 30,
      "subVerseIndex": 1,
      "paragraphNumber": 61,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.545Z",
      "updatedAt": "2025-09-03T02:35:44.545Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "102023ad-501c-4cd7-8ca4-c93430534b2e",
      "text": "Ước chi họ dâng lời cảm tạ vì tình thương của Chúa,",
      "label": "31",
      "number": 31,
      "subVerseIndex": 0,
      "paragraphNumber": 62,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.559Z",
      "updatedAt": "2025-09-03T02:35:44.559Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "5810ee39-90e1-4163-9a6a-4d6c021e32a9",
      "text": "và vì những kỳ công Chúa đã thực hiện cho người trần.",
      "label": "31",
      "number": 31,
      "subVerseIndex": 1,
      "paragraphNumber": 63,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.573Z",
      "updatedAt": "2025-09-03T02:35:44.573Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "406a7f9e-ced8-4ff2-af61-4e24edf72413",
      "text": "Ước chi họ tán dương Người nơi nhóm họp toàn dân",
      "label": "32",
      "number": 32,
      "subVerseIndex": 0,
      "paragraphNumber": 64,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.591Z",
      "updatedAt": "2025-09-03T02:35:44.591Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "f766b983-ddb5-412b-b523-fb2993fcf097",
      "text": "và ca tụng giữa hội đồng bô lão.",
      "label": "32",
      "number": 32,
      "subVerseIndex": 1,
      "paragraphNumber": 65,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.605Z",
      "updatedAt": "2025-09-03T02:35:44.605Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "b961eeaf-2ba9-424f-a662-388188a10931",
      "text": "Chúa khiến sông ngòi cạn đi thành sa mạc,",
      "label": "33",
      "number": 33,
      "subVerseIndex": 0,
      "paragraphNumber": 66,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.622Z",
      "updatedAt": "2025-09-03T02:35:44.622Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "a63ba8b0-8580-4148-acea-2a2aab0ca904",
      "text": "đổi suối nguồn ra hoang địa khô khan,",
      "label": "33",
      "number": 33,
      "subVerseIndex": 1,
      "paragraphNumber": 67,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.647Z",
      "updatedAt": "2025-09-03T02:35:44.647Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "ea03d64a-79f9-4c60-b231-e0067993a377",
      "text": "đất mầu mỡ hoá đồng chua nước mặn,",
      "label": "34",
      "number": 34,
      "subVerseIndex": 0,
      "paragraphNumber": 68,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.659Z",
      "updatedAt": "2025-09-03T02:35:44.659Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "1d8c5943-26c6-4e78-87ea-ef422eba5793",
      "text": "vì dân cư độc ác gian tà.",
      "label": "34",
      "number": 34,
      "subVerseIndex": 1,
      "paragraphNumber": 69,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.670Z",
      "updatedAt": "2025-09-03T02:35:44.670Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "627e7f71-4ac4-46cf-98a3-cf5f2e79cb91",
      "text": "Người lại biến sa mạc thành hồ ao",
      "label": "35",
      "number": 35,
      "subVerseIndex": 0,
      "paragraphNumber": 70,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.681Z",
      "updatedAt": "2025-09-03T02:35:44.681Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "640df312-2907-4228-8e66-2787690b218a",
      "text": "và hoang địa khô khan nên nguồn suối.",
      "label": "35",
      "number": 35,
      "subVerseIndex": 1,
      "paragraphNumber": 71,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.704Z",
      "updatedAt": "2025-09-03T02:35:44.704Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "40b1e285-efea-4095-bacc-63741acca518",
      "text": "Kẻ nghèo đói, Người cho đến ở,",
      "label": "36",
      "number": 36,
      "subVerseIndex": 0,
      "paragraphNumber": 72,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.717Z",
      "updatedAt": "2025-09-03T02:35:44.717Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "f80f57fb-4e92-435e-bb3a-87a5c9f15aee",
      "text": "họ lập nên thành thị để định cư.",
      "label": "36",
      "number": 36,
      "subVerseIndex": 1,
      "paragraphNumber": 73,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.732Z",
      "updatedAt": "2025-09-03T02:35:44.732Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "11203177-fba2-4d31-8c36-a4cea891f452",
      "text": "Gieo lúa ngoài ruộng, trồng nho trong vườn,",
      "label": "37",
      "number": 37,
      "subVerseIndex": 0,
      "paragraphNumber": 74,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.746Z",
      "updatedAt": "2025-09-03T02:35:44.746Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "2832b8ab-28de-43d3-9c13-e079a635ac83",
      "text": "họ thu hoạch hoa màu lợi tức.",
      "label": "37",
      "number": 37,
      "subVerseIndex": 1,
      "paragraphNumber": 75,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.760Z",
      "updatedAt": "2025-09-03T02:35:44.760Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "7140e263-054f-4b94-86a8-d5020e2e7553",
      "text": "Chúa chúc lành, họ sinh sôi nảy nở,",
      "label": "38",
      "number": 38,
      "subVerseIndex": 0,
      "paragraphNumber": 76,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.774Z",
      "updatedAt": "2025-09-03T02:35:44.774Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "21f24a5b-2452-45f8-a1d6-5cba8c40ee63",
      "text": "bầy gia súc, Người không để giảm đi.",
      "label": "38",
      "number": 38,
      "subVerseIndex": 1,
      "paragraphNumber": 77,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.788Z",
      "updatedAt": "2025-09-03T02:35:44.788Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "6f5f4604-539d-466d-a292-d756e801eb20",
      "text": "Nhưng rồi họ phải tiêu hao lụn bại,",
      "label": "39",
      "number": 39,
      "subVerseIndex": 0,
      "paragraphNumber": 78,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.802Z",
      "updatedAt": "2025-09-03T02:35:44.802Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "9fd83c56-c76c-4bd1-a0c6-3947e7542134",
      "text": "điêu đứng vì tai hoạ với khổ đau.",
      "label": "39",
      "number": 39,
      "subVerseIndex": 1,
      "paragraphNumber": 79,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.815Z",
      "updatedAt": "2025-09-03T02:35:44.815Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "52ed2d46-d577-45a2-be90-631c94fe963b",
      "text": "Chúa đổ nhuốc nhơ xuống hàng quyền thế,",
      "label": "40",
      "number": 40,
      "subVerseIndex": 0,
      "paragraphNumber": 80,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.828Z",
      "updatedAt": "2025-09-03T02:35:44.828Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "53ebcaf6-c4cc-42b1-bba0-54b5ac10091a",
      "text": "bắt phiêu bạt giữa chốn hoang vu,",
      "label": "40",
      "number": 40,
      "subVerseIndex": 1,
      "paragraphNumber": 81,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.841Z",
      "updatedAt": "2025-09-03T02:35:44.841Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "31ed3587-6564-45bc-855e-98509a0fd21d",
      "text": "không đường ra lối vào.",
      "label": "40",
      "number": 40,
      "subVerseIndex": 2,
      "paragraphNumber": 82,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.853Z",
      "updatedAt": "2025-09-03T02:35:44.853Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "12a8a049-79f2-4f02-89d9-9543de8d4659",
      "text": "Nhưng Chúa lại cất nhắc",
      "label": "41",
      "number": 41,
      "subVerseIndex": 0,
      "paragraphNumber": 83,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.866Z",
      "updatedAt": "2025-09-03T02:35:44.866Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "4dd5ee02-1310-41d1-881f-b1ace544fbf8",
      "text": "kẻ nghèo hèn thoát cảnh lầm than,",
      "label": "41",
      "number": 41,
      "subVerseIndex": 1,
      "paragraphNumber": 84,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.880Z",
      "updatedAt": "2025-09-03T02:35:44.880Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "d8b602f3-ff00-4547-8301-7a0d9b301683",
      "text": "ban cho cả giống dòng",
      "label": "41",
      "number": 41,
      "subVerseIndex": 2,
      "paragraphNumber": 85,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.894Z",
      "updatedAt": "2025-09-03T02:35:44.894Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "11b695bc-73cc-4185-a55c-0084be4fa25e",
      "text": "như chiên cừu sinh năm đẻ bảy.",
      "label": "41",
      "number": 41,
      "subVerseIndex": 3,
      "paragraphNumber": 86,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.909Z",
      "updatedAt": "2025-09-03T02:35:44.909Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "c7498187-0466-4073-a0bf-23706157576c",
      "text": "Người chính trực thấy thế mà mừng rỡ,",
      "label": "42",
      "number": 42,
      "subVerseIndex": 0,
      "paragraphNumber": 87,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.923Z",
      "updatedAt": "2025-09-03T02:35:44.923Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "4c076632-02e9-4aa1-b163-f29940872446",
      "text": "bọn gian tà chẳng dám hé môi.",
      "label": "42",
      "number": 42,
      "subVerseIndex": 1,
      "paragraphNumber": 88,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.951Z",
      "updatedAt": "2025-09-03T02:35:44.951Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "d6faf1fc-bcd5-4d4e-a7be-61687f24dc30",
      "text": "Ai kẻ hiền nhân, hãy để tâm suy nghĩ,",
      "label": "43",
      "number": 43,
      "subVerseIndex": 0,
      "paragraphNumber": 89,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.965Z",
      "updatedAt": "2025-09-03T02:35:44.965Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    },
    {
      "id": "c87d026e-e846-4212-8d14-77a2cd75c552",
      "text": "thì sẽ am tường lòng CHÚA thương yêu.",
      "label": "43",
      "number": 43,
      "subVerseIndex": 1,
      "paragraphNumber": 90,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:44.978Z",
      "updatedAt": "2025-09-03T02:35:44.978Z",
      "chapterId": "c67e7345-4f3c-445e-9628-f119c6bd6525"
    }
  ],
  "marks": [
    {
      "id": "dcb6432c-878f-4068-93c7-63f8b5000baf",
      "content": "Tv 107 là *một Tv hỗn hợp* gồm hai phần : lời tạ ơn của tập thể (cc. 4-32) và thánh thi (cc. 33-43). Phần I (cc. 4-32) có một cấu trúc riêng biệt : Có bốn đoạn trong phần I (cc. 4-9 ; 10-16 ; 17-22 ; 23-32) ; mỗi đoạn đều gồm bốn điểm sau đây : **1**) Hoàn cảnh bi đát (cc. 4-5 ; 10-12 ; 17-18 ; 23-27) ; **2**) Điệp ca (cc. 6 ; 13 ; 19 ; 28) ; **3**) Thiên Chúa giải thoát (cc. 7 ; 14 ; 20 ; 29-30) ; **4**) Lời cảm tạ (cc. 8-9 ; 15-16 ; 21-22 ; 31-32). Phần II (cc. 33-43) là một thánh thi ca ngợi Đức Chúa, Đấng làm chủ thiên nhiên và điều khiển mọi biến cố.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 48,
      "endOffset": 48,
      "createdAt": "2025-09-03T02:35:43.600Z",
