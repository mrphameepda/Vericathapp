{
  "chapter": {
    "id": "c01bbce0-0dd5-4bd4-a99c-e43bce6cae63",
    "number": 108,
    "createdAt": "2025-09-03T01:07:51.662Z",
    "updatedAt": "2025-09-03T01:07:51.662Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "e6e756ae-baf1-49fa-a2ef-e7e67b0d5191",
      "text": "*Thánh ca. Thánh vịnh. Của vua Đa-vít.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:35:50.657Z",
      "updatedAt": "2025-09-03T02:35:50.657Z",
      "chapterId": "c01bbce0-0dd5-4bd4-a99c-e43bce6cae63"
    },
    {
      "id": "9422a1eb-c643-415b-b608-fd2fdcfee18e",
      "text": "Con vững dạ an lòng, lạy Thiên Chúa,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:50.716Z",
      "updatedAt": "2025-09-03T02:35:50.716Z",
      "chapterId": "c01bbce0-0dd5-4bd4-a99c-e43bce6cae63"
    },
    {
      "id": "c8a7ff2a-076c-49c4-b664-f45ad38262cb",
      "text": "này con xin đàn hát xướng ca với tất cả tâm hồn.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:50.742Z",
      "updatedAt": "2025-09-03T02:35:50.742Z",
      "chapterId": "c01bbce0-0dd5-4bd4-a99c-e43bce6cae63"
    },
    {
      "id": "e0a30790-1839-4cb6-aeaa-4ef77192d0fc",
      "text": "Thức dậy đi, hỡi đàn sắt đàn cầm,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:50.756Z",
      "updatedAt": "2025-09-03T02:35:50.756Z",
      "chapterId": "c01bbce0-0dd5-4bd4-a99c-e43bce6cae63"
    },
    {
      "id": "07cebc5c-61b1-49fe-afe4-6655deb8c7c2",
      "text": "tôi còn đánh thức cả bình minh.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:50.769Z",
      "updatedAt": "2025-09-03T02:35:50.769Z",
      "chapterId": "c01bbce0-0dd5-4bd4-a99c-e43bce6cae63"
    },
    {
      "id": "95c43ea9-8cb9-4b6c-aaee-f7cbc2219d55",
      "text": "Lạy THIÊN CHÚA, trước mặt chư dân, con dâng lời cảm tạ,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:50.783Z",
      "updatedAt": "2025-09-03T02:35:50.783Z",
      "chapterId": "c01bbce0-0dd5-4bd4-a99c-e43bce6cae63"
    },
    {
      "id": "d4f6ada0-197e-4e85-8860-339600ea67fd",
      "text": "giữa lòng muôn nước, con đàn hát xướng ca.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:50.811Z",
      "updatedAt": "2025-09-03T02:35:50.811Z",
      "chapterId": "c01bbce0-0dd5-4bd4-a99c-e43bce6cae63"
    },
    {
      "id": "fc94ecf7-60c2-402d-9b0b-0aa87810f435",
      "text": "Vì tình thương của Ngài cao ngất trời xanh,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:50.824Z",
      "updatedAt": "2025-09-03T02:35:50.824Z",
      "chapterId": "c01bbce0-0dd5-4bd4-a99c-e43bce6cae63"
    },
    {
      "id": "80a97e46-e3f6-4813-8114-ef96d0ad6d0a",
      "text": "lòng thành tín vượt ngàn mây thẳm.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:50.835Z",
      "updatedAt": "2025-09-03T02:35:50.835Z",
      "chapterId": "c01bbce0-0dd5-4bd4-a99c-e43bce6cae63"
    },
    {
      "id": "8c36feb2-8d7d-401b-926b-cdae38ab2b10",
      "text": "Lạy Thiên Chúa, xin biểu thị uy phong khắp cõi trời",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:50.847Z",
      "updatedAt": "2025-09-03T02:35:50.847Z",
      "chapterId": "c01bbce0-0dd5-4bd4-a99c-e43bce6cae63"
    },
    {
      "id": "61531e02-7720-407b-a036-b08b0aa5a07f",
      "text": "và chiếu toả vinh quang đầy mặt đất.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:50.859Z",
      "updatedAt": "2025-09-03T02:35:50.859Z",
      "chapterId": "c01bbce0-0dd5-4bd4-a99c-e43bce6cae63"
    },
    {
      "id": "9c0f8aa9-477c-4e05-ba9f-5d5572efdb93",
      "text": "Xin ra tay cứu độ, và đáp lời chúng con,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:50.872Z",
      "updatedAt": "2025-09-03T02:35:50.872Z",
      "chapterId": "c01bbce0-0dd5-4bd4-a99c-e43bce6cae63"
    },
    {
      "id": "25392fe1-9bee-44ec-b843-f6c0df670642",
      "text": "để những kẻ Ngài yêu thương được ơn giải thoát.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:50.914Z",
      "updatedAt": "2025-09-03T02:35:50.914Z",
      "chapterId": "c01bbce0-0dd5-4bd4-a99c-e43bce6cae63"
    },
    {
      "id": "3300f673-c36a-4897-a4ec-65d5f04d6133",
      "text": "Trong thánh điện, Chúa Trời tuyên phán :",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:50.928Z",
      "updatedAt": "2025-09-03T02:35:50.928Z",
      "chapterId": "c01bbce0-0dd5-4bd4-a99c-e43bce6cae63"
    },
    {
      "id": "ccdc8b7c-0fa4-4c3f-85ab-149052ab1dce",
      "text": "Khấp khởi mừng, Ta chia cắt Si-khem,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:50.941Z",
      "updatedAt": "2025-09-03T02:35:50.941Z",
      "chapterId": "c01bbce0-0dd5-4bd4-a99c-e43bce6cae63"
    },
    {
      "id": "fea68713-b20d-481b-9219-db88ac7735ba",
      "text": "Ta đo đạc cả đồng bằng Xúc-cốt.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:50.969Z",
      "updatedAt": "2025-09-03T02:35:50.969Z",
      "chapterId": "c01bbce0-0dd5-4bd4-a99c-e43bce6cae63"
    },
    {
      "id": "4c593b14-30dd-4cdd-bcab-91edf94b8aaf",
      "text": "Ga-la-át về Ta, Mơ-na-se cũng về Ta,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:50.996Z",
      "updatedAt": "2025-09-03T02:35:50.996Z",
      "chapterId": "c01bbce0-0dd5-4bd4-a99c-e43bce6cae63"
    },
    {
      "id": "c7e9792d-6f7a-4b5d-b383-d77353bcbe1c",
      "text": "Ta lấy Ép-ra-im làm mũ chiến đội đầu,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:51.039Z",
      "updatedAt": "2025-09-03T02:35:51.039Z",
      "chapterId": "c01bbce0-0dd5-4bd4-a99c-e43bce6cae63"
    },
    {
      "id": "2ce281fe-24cd-4725-8558-4715726a0ab5",
      "text": "lấy Giu-đa làm cây gậy chỉ huy.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:51.067Z",
      "updatedAt": "2025-09-03T02:35:51.067Z",
      "chapterId": "c01bbce0-0dd5-4bd4-a99c-e43bce6cae63"
    },
    {
      "id": "f483be0b-c116-4faf-a189-837e04199198",
      "text": "“Mô-áp là chậu Ta tắm rửa, Ê-đôm là chỗ Ta liệng giày,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:51.094Z",
      "updatedAt": "2025-09-03T02:35:51.094Z",
      "chapterId": "c01bbce0-0dd5-4bd4-a99c-e43bce6cae63"
    },
    {
      "id": "107ecbf2-c113-4b29-8647-1ab48c4f7904",
      "text": "đánh bại Phi-li-tinh, Ta reo mừng thắng trận.”",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:51.151Z",
      "updatedAt": "2025-09-03T02:35:51.151Z",
      "chapterId": "c01bbce0-0dd5-4bd4-a99c-e43bce6cae63"
    },
    {
      "id": "f2535a00-b31a-4cbc-9cfe-673cdb542b7f",
      "text": "Lạy Thiên Chúa, ai sẽ đưa con vào thành kiên cố,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:51.178Z",
      "updatedAt": "2025-09-03T02:35:51.178Z",
      "chapterId": "c01bbce0-0dd5-4bd4-a99c-e43bce6cae63"
    },
    {
      "id": "9a79ab4a-4eb2-47a0-a7b9-cfe68f2376fb",
      "text": "ai sẽ dắt con đến tận Ê-đôm ?",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:51.198Z",
      "updatedAt": "2025-09-03T02:35:51.198Z",
      "chapterId": "c01bbce0-0dd5-4bd4-a99c-e43bce6cae63"
    },
    {
      "id": "5011da82-0b64-4b62-b254-8cdb10434f84",
      "text": "Há chẳng phải chính Ngài,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:51.226Z",
      "updatedAt": "2025-09-03T02:35:51.226Z",
      "chapterId": "c01bbce0-0dd5-4bd4-a99c-e43bce6cae63"
    },
    {
      "id": "73b190e9-8130-4c2a-b683-570b3c993ff6",
      "text": "Đấng đã từng ruồng bỏ chúng con,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:51.240Z",
      "updatedAt": "2025-09-03T02:35:51.240Z",
      "chapterId": "c01bbce0-0dd5-4bd4-a99c-e43bce6cae63"
    },
    {
      "id": "b059769a-7770-47ad-bed2-27d1098f9fae",
      "text": "chẳng còn dẫn ba quân xuất trận ?",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:51.254Z",
      "updatedAt": "2025-09-03T02:35:51.254Z",
      "chapterId": "c01bbce0-0dd5-4bd4-a99c-e43bce6cae63"
    },
    {
      "id": "dfd34a40-ac19-4a3c-b877-f5c5c4327c89",
      "text": "Xin Ngài thương cứu viện, cho chúng con thoát khỏi quân thù,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:51.268Z",
      "updatedAt": "2025-09-03T02:35:51.268Z",
      "chapterId": "c01bbce0-0dd5-4bd4-a99c-e43bce6cae63"
    },
    {
      "id": "b6a9fd68-fb98-44de-893f-764b3479cc03",
      "text": "chứ người phàm giúp đỡ chỉ bằng không.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:51.297Z",
      "updatedAt": "2025-09-03T02:35:51.297Z",
      "chapterId": "c01bbce0-0dd5-4bd4-a99c-e43bce6cae63"
    },
    {
      "id": "5ba9559f-4765-46a0-be57-1e76b113c59b",
      "text": "Có Thiên Chúa, ta sẽ trổ tài oanh liệt,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:51.311Z",
      "updatedAt": "2025-09-03T02:35:51.311Z",
      "chapterId": "c01bbce0-0dd5-4bd4-a99c-e43bce6cae63"
    },
    {
      "id": "a7aa7f9d-e9cc-4c26-aabd-b2c068a218f1",
      "text": "chính Người chà đạp kẻ thù ta.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:35:51.325Z",
      "updatedAt": "2025-09-03T02:35:51.325Z",
      "chapterId": "c01bbce0-0dd5-4bd4-a99c-e43bce6cae63"
    }
  ],
