{
  "chapter": {
    "id": "70f61928-0b15-471e-906d-fca69d1b697b",
    "number": 109,
    "createdAt": "2025-09-03T01:07:51.662Z",
    "updatedAt": "2025-09-03T01:07:51.662Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "c32304e0-2d24-4b99-b932-8371a674bb94",
      "text": "*Phần ca trưởng. Của vua Đa-vít. Thánh vịnh.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:35:59.997Z",
      "updatedAt": "2025-09-03T02:35:59.997Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "8f8d3686-5cc8-4768-8cd7-329694a40adc",
      "text": "Lạy Thiên Chúa là Đấng con ca ngợi,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.062Z",
      "updatedAt": "2025-09-03T02:36:00.062Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "915bcf7c-35e0-40fe-b4d6-adebd17b6cc6",
      "text": "xin Chúa đừng lặng thinh.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.076Z",
      "updatedAt": "2025-09-03T02:36:00.076Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "9326f6c5-800f-4eb9-a5ff-86ca70176d0b",
      "text": "Bởi vì kẻ gian ngoa độc dữ mở miệng nhằm hại con,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.090Z",
      "updatedAt": "2025-09-03T02:36:00.090Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "632f1c6f-7914-43f5-b2cd-b493d9459638",
      "text": "nói với con toàn lời dối trá,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.104Z",
      "updatedAt": "2025-09-03T02:36:00.104Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "68f94a67-1661-4888-be59-e8594b45c5f7",
      "text": "buông lời hằn học bủa vây con, tấn công con vô cớ.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.119Z",
      "updatedAt": "2025-09-03T02:36:00.119Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "4ad79700-0ad2-445b-96ae-b100c6728ef3",
      "text": "Con thương nó, nhưng nó lại vu oan,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.133Z",
      "updatedAt": "2025-09-03T02:36:00.133Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "75ce0298-eb15-4df0-9f1f-8eca4747df10",
      "text": "phần con, con chỉ biết cầu nguyện.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.146Z",
      "updatedAt": "2025-09-03T02:36:00.146Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "8446f3de-e20d-4222-9329-ef8e1ee2a552",
      "text": "Nó lấy oán đền ơn,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.160Z",
      "updatedAt": "2025-09-03T02:36:00.160Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "2f22c62b-c09d-4e22-b4d4-cc8a9d00b608",
      "text": "lấy hận thù đáp lại lòng con thương mến.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.174Z",
      "updatedAt": "2025-09-03T02:36:00.174Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "954984c3-6cb1-4f64-a4b2-172687bc9895",
      "text": "Xin cho kẻ dữ nổi lên chống nó,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.188Z",
      "updatedAt": "2025-09-03T02:36:00.188Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "ff00adc2-a80a-4958-b788-cfdc435d615c",
      "text": "bên phải nó, đặt một người cáo tội đứng kèm.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.217Z",
      "updatedAt": "2025-09-03T02:36:00.217Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "d36f3ac7-f1b3-46fe-88a6-84cae7dafa1a",
      "text": "Ước gì nó phải mang án khi ra khỏi cửa công,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.245Z",
      "updatedAt": "2025-09-03T02:36:00.245Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "cec13d35-77dd-48b0-b646-566de1b81e3d",
      "text": "và lời xin ân xá thành lời buộc tội.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.258Z",
      "updatedAt": "2025-09-03T02:36:00.258Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "ce23a065-e48f-49c1-b332-f68d7253fb0f",
      "text": "Ước gì ngày đời nó bị rút ngắn đi,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.272Z",
      "updatedAt": "2025-09-03T02:36:00.272Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "a05fa9b4-5071-4442-ae88-1a5e0fd675fe",
      "text": "chức vụ nó vào tay kẻ khác,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.286Z",
      "updatedAt": "2025-09-03T02:36:00.286Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "d32ca7fe-6784-48f5-be12-0d3d4f4c0eea",
      "text": "con cái nó trở thành mồ côi,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.300Z",
      "updatedAt": "2025-09-03T02:36:00.300Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "36f0c5ab-60cc-440e-b96b-cf15c3721183",
      "text": "còn vợ nó ra người goá bụa !",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.314Z",
      "updatedAt": "2025-09-03T02:36:00.314Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "7d4c4a49-588a-4ad8-ab79-6527a39a42a7",
      "text": "Ước gì con cái nó phải lang thang ăn mày,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.327Z",
      "updatedAt": "2025-09-03T02:36:00.327Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "34321da7-6f50-483a-8149-a30570cabb0e",
      "text": "bị đuổi ra khỏi nhà, nhà đã tan hoang,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.342Z",
      "updatedAt": "2025-09-03T02:36:00.342Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "588f8001-52e5-4e8b-b944-8687e6f9bece",
      "text": "chủ nợ đến vét sạch bạc tiền",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.356Z",
      "updatedAt": "2025-09-03T02:36:00.356Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "aa257db8-d293-4a76-9444-f983bf4d4c46",
      "text": "và người lạ đoạt hết của mồ hôi nước mắt.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.385Z",
      "updatedAt": "2025-09-03T02:36:00.385Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "7613921f-0823-4183-aac4-0ea5dc68d308",
      "text": "Ước chi chẳng còn ai tình nghĩa gì với nó,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.398Z",
      "updatedAt": "2025-09-03T02:36:00.398Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "5d30de6c-1506-47c9-9ec2-b34782f421ea",
      "text": "chẳng người nào thương lũ con nó mồ côi,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.412Z",
      "updatedAt": "2025-09-03T02:36:00.412Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "18816f00-d718-4c24-973d-aacbdcfa87c0",
      "text": "dòng dõi nó bị tru di tam tộc,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.426Z",
      "updatedAt": "2025-09-03T02:36:00.426Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "9760620d-06a0-47cb-83d4-b3d46e9c9c33",
      "text": "sau một đời, tên tuổi bị xoá nhoà !",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.454Z",
      "updatedAt": "2025-09-03T02:36:00.454Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "b91a7c00-c818-4aa4-8b14-74a66849d5aa",
      "text": "Ước gì CHÚA nhớ lại tội cha ông nó,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.469Z",
      "updatedAt": "2025-09-03T02:36:00.469Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "f6a89f48-30fd-4685-8618-ed638125d931",
      "text": "lỗi của mẹ nó không hề được xoá bỏ đi !",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.483Z",
      "updatedAt": "2025-09-03T02:36:00.483Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "e64b6445-3c3e-4811-9bb7-274eafad7fd8",
      "text": "Các tội ấy cứ sờ sờ trước mặt CHÚA,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.496Z",
      "updatedAt": "2025-09-03T02:36:00.496Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "75c6408a-97ec-4161-8886-8cd84075866a",
      "text": "xin Chúa xoá nhoà tên tuổi chúng trên đời !",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.510Z",
      "updatedAt": "2025-09-03T02:36:00.510Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "959cda08-4c47-40ce-83ac-a5d217c28867",
      "text": "Bởi nó đã chẳng màng điều nhân việc nghĩa,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.524Z",
      "updatedAt": "2025-09-03T02:36:00.524Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "5533a115-d3d2-4fe1-87af-4ad51495bc79",
      "text": "đã ngược đãi kẻ khó người nghèo",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.552Z",
      "updatedAt": "2025-09-03T02:36:00.552Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "bdb1881b-7669-4c8c-9a88-53d2db4bb445",
      "text": "và giết hại cả người đã héo hắt tâm can.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 2,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.567Z",
      "updatedAt": "2025-09-03T02:36:00.567Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "d4032cee-3ab7-4975-b6cf-31b3bcc27084",
      "text": "Nó đã thích nguyền rủa,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.581Z",
      "updatedAt": "2025-09-03T02:36:00.581Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "07cb5edb-7cb2-4447-a4a6-8edd5b8270ad",
      "text": "thì cho lời nguyền rủa đổ lên đầu nó ;",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.609Z",
      "updatedAt": "2025-09-03T02:36:00.609Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "f23e79b6-3356-40b8-9beb-d9f8a14280bb",
      "text": "nó chẳng ưa chúc lành,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 2,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.637Z",
      "updatedAt": "2025-09-03T02:36:00.637Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "5ddeb58f-f5e3-4649-bc99-c4a00efe21c4",
      "text": "thì cho lời chúc lành bỏ nó mà đi !",
      "label": "17",
      "number": 17,
      "subVerseIndex": 3,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.651Z",
      "updatedAt": "2025-09-03T02:36:00.651Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "fb06e249-3ae3-41e8-aaef-17c3d3569bf4",
      "text": "Nó đã lấy lời nguyền rủa làm như áo mặc,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.665Z",
      "updatedAt": "2025-09-03T02:36:00.665Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "ecd27060-669f-4b00-b730-81a831eba71c",
      "text": "thì cho lời nguyền rủa thấm vào thân nó :",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.678Z",
      "updatedAt": "2025-09-03T02:36:00.678Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "ff16b2e0-cf28-43a5-8d8f-dbd2d168f712",
      "text": "như nước thấm ruột gan, như dầu vào xương tuỷ.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 2,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.693Z",
      "updatedAt": "2025-09-03T02:36:00.693Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "e12d9738-6925-487a-a76c-0bbbf307f0d0",
      "text": "Ước chi lời nguyền rủa như áo choàng quấn chặt lấy nó,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.706Z",
      "updatedAt": "2025-09-03T02:36:00.706Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "4ee0ff64-2000-4c29-8f71-8e370f1df1a4",
      "text": "như đai lưng thắt mãi không rời !",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.720Z",
      "updatedAt": "2025-09-03T02:36:00.720Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "3cfe016b-6f9e-4f43-96d9-47f79ab9c066",
      "text": "Những kẻ vu cáo tôi, những kẻ nói xấu tôi :",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.734Z",
      "updatedAt": "2025-09-03T02:36:00.734Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "baa9551c-4f66-4fa0-8631-152b725ca486",
      "text": "ước gì CHÚA trả công như vậy !",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.748Z",
      "updatedAt": "2025-09-03T02:36:00.748Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "98addf07-631c-4493-94a3-1f432c674016",
      "text": "Còn Ngài, lạy CHÚA là Thiên Chúa con thờ,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.762Z",
      "updatedAt": "2025-09-03T02:36:00.762Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "7afed953-6639-46e6-b028-125850b3770e",
      "text": "vì danh dự của Ngài, xin bênh đỡ,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.776Z",
      "updatedAt": "2025-09-03T02:36:00.776Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "5c1407d6-63fd-4a87-9297-2b7ee8847b13",
      "text": "vì lòng Ngài yêu thương nhân hậu, xin giải thoát con,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 2,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.790Z",
      "updatedAt": "2025-09-03T02:36:00.790Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "cefda53b-4e81-4dd5-8bac-89c9cc7b9e0b",
      "text": "bởi vì con khốn khổ nghèo hèn,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.805Z",
      "updatedAt": "2025-09-03T02:36:00.805Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "1e5b3d5e-f6ca-49f4-8a2e-24846a565279",
      "text": "nghe trong mình con tim rướm máu.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.818Z",
      "updatedAt": "2025-09-03T02:36:00.818Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "16833020-5933-422e-8b13-328bcf816087",
      "text": "Con ra đi, như chiều tà bóng ngả,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.830Z",
      "updatedAt": "2025-09-03T02:36:00.830Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "89576ddc-e266-4b94-9dae-cb381e12ce7f",
      "text": "bị cuốn lôi đi như gió cuốn cào cào.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.852Z",
      "updatedAt": "2025-09-03T02:36:00.852Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "2b02f4e3-610f-49e2-810b-b67d2cf79daf",
      "text": "Gối rã rời, vì nhịn ăn nhịn uống,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.863Z",
      "updatedAt": "2025-09-03T02:36:00.863Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "400abdc3-940e-4691-bdc2-5f40786354c5",
      "text": "thân xác con gầy còm yếu nhược.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.874Z",
      "updatedAt": "2025-09-03T02:36:00.874Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "083da0d9-4dbf-4849-9bab-9555f3c8d727",
      "text": "Con bị người đời mắng chửi dể duôi,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.887Z",
      "updatedAt": "2025-09-03T02:36:00.887Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "b5168955-bdfb-4c31-ab6b-8ea46969c487",
      "text": "trông thấy con là chúng lắc đầu.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.914Z",
      "updatedAt": "2025-09-03T02:36:00.914Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "c2d04f6c-2012-4343-bf44-676b42b0f331",
      "text": "Lạy CHÚA là Thiên Chúa của con, xin thương phù hộ,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.928Z",
      "updatedAt": "2025-09-03T02:36:00.928Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "1f4bf20c-1168-445f-8985-6ef8e0e21d06",
      "text": "xin lấy lòng nhân hậu cứu độ con,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.942Z",
      "updatedAt": "2025-09-03T02:36:00.942Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "bc160d22-c4aa-4441-97b6-bad3b611021c",
      "text": "để chúng biết rằng chính Ngài, lạy CHÚA,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.956Z",
      "updatedAt": "2025-09-03T02:36:00.956Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "e4887b87-9c4b-467b-8bf0-02c13a8cb656",
      "text": "chính tay Ngài đã làm như vậy !",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.970Z",
      "updatedAt": "2025-09-03T02:36:00.970Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "acb02bb0-7340-46d6-8bd9-799ef35b19bb",
      "text": "Chúng cứ nguyền rủa đi,",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.984Z",
      "updatedAt": "2025-09-03T02:36:00.984Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "018c9850-ac72-40bd-9d14-2f3e3a4a011c",
      "text": "nhưng phần Ngài, xin Ngài giáng phúc.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 1,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:00.998Z",
      "updatedAt": "2025-09-03T02:36:00.998Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "0da527fe-5128-4284-95dd-b0b98daa0ec4",
      "text": "Chúng cứ việc nổi dậy chống con,",
      "label": "28",
      "number": 28,
      "subVerseIndex": 2,
      "paragraphNumber": 61,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:01.011Z",
      "updatedAt": "2025-09-03T02:36:01.011Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "8ba78308-4ba2-45a5-a537-849e14b52a93",
      "text": "chúng sẽ phải nhục nhằn xấu hổ.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 3,
      "paragraphNumber": 62,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:01.025Z",
      "updatedAt": "2025-09-03T02:36:01.025Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "00550d78-3788-4513-bf85-4fb84c9e50fc",
      "text": "Nhưng tôi tớ Ngài đây sẽ được vui mừng.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 4,
      "paragraphNumber": 63,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:01.040Z",
      "updatedAt": "2025-09-03T02:36:01.040Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "5b971241-8e5d-4e35-bc19-e3968425482b",
      "text": "Ước gì những kẻ tố cáo con bị phủ đầy nhục nhã,",
      "label": "29",
      "number": 29,
      "subVerseIndex": 0,
      "paragraphNumber": 64,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:01.054Z",
      "updatedAt": "2025-09-03T02:36:01.054Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "3036c5d3-111e-4dd5-b8a6-5093fd892333",
      "text": "bị xấu hổ trùm lên như chiếc áo choàng.",
      "label": "29",
      "number": 29,
      "subVerseIndex": 1,
      "paragraphNumber": 65,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:01.071Z",
      "updatedAt": "2025-09-03T02:36:01.071Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "c067f00d-77b4-4ed2-9950-7d643bc9e98d",
      "text": "Tôi sẽ hết lời cảm tạ CHÚA,",
      "label": "30",
      "number": 30,
      "subVerseIndex": 0,
      "paragraphNumber": 66,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:01.085Z",
      "updatedAt": "2025-09-03T02:36:01.085Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "554819e7-bceb-445b-81c2-1df4fa78d362",
      "text": "tán dương Người giữa lòng đại hội,",
      "label": "30",
      "number": 30,
      "subVerseIndex": 1,
      "paragraphNumber": 67,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:01.099Z",
      "updatedAt": "2025-09-03T02:36:01.099Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "22b51ebc-716a-41c9-ac67-893a4195a8d2",
      "text": "vì Chúa đứng bên, bênh vực kẻ nghèo hèn,",
      "label": "31",
      "number": 31,
      "subVerseIndex": 0,
      "paragraphNumber": 68,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:01.113Z",
      "updatedAt": "2025-09-03T02:36:01.113Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
    {
      "id": "82589c0e-a289-443c-acaa-182e67c2c140",
      "text": "để cứu độ khỏi tay người kết án.",
      "label": "31",
      "number": 31,
      "subVerseIndex": 1,
      "paragraphNumber": 69,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:01.127Z",
      "updatedAt": "2025-09-03T02:36:01.127Z",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    }
  ],
