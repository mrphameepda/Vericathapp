    },
    {
      "id": "6544cd70-7e7a-413c-a8bc-550407cdc4d4",
      "content": "Đây là *một ai ca của cá nhân* đầy những lời nguyền rủa. Bị các kẻ thù vô ơn, độc dữ, dối trá vu oan, tác giả xin Thiên Chúa giáng hoạ xuống họ. Có thể, cc. 6-15 trích dẫn những lời của đối phương nguyền rủa tác giả. Chắc vì lý do đó mà Tv 109 này cũng như Tv 58 và Tv 83 không được sử dụng trong phụng vụ. Nhiều học giả phân chia Tv như sau : **1**) Cc. 1-5 ; **2**) Cc. 6-20 ; **3**) Cc. 21-29 ; **4**) Cc. 30-31.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 61,
      "endOffset": 61,
      "createdAt": "2025-09-03T02:36:00.037Z",
      "updatedAt": "2025-09-03T02:36:00.037Z",
      "targetId": "3d057930-5b72-48fd-af87-9cea80ba38ae",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "70f61928-0b15-471e-906d-fca69d1b697b"
    },
