{
  "chapter": {
    "id": "b81de628-9e2e-4e89-8630-a88941f30498",
    "number": 11,
    "createdAt": "2025-09-03T01:07:51.660Z",
    "updatedAt": "2025-09-03T01:07:51.660Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "783c04d7-ba87-4f7f-8197-c607227bf4ca",
      "text": "*Phần ca trưởng. Của vua Đa-vít.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:25:37.291Z",
      "updatedAt": "2025-09-03T02:25:37.291Z",
      "chapterId": "b81de628-9e2e-4e89-8630-a88941f30498"
    },
    {
      "id": "3acd1cea-8e8d-4bae-87c6-6d10b41e4f26",
      "text": "Tôi ẩn mình bên CHÚA, tại sao các người lại bảo tôi :",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:37.352Z",
      "updatedAt": "2025-09-03T02:25:37.352Z",
      "chapterId": "b81de628-9e2e-4e89-8630-a88941f30498"
    },
    {
      "id": "f9605981-8727-4c03-a025-ca4768fa607c",
      "text": "“Trốn về núi đi, này chim sẻ !",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:37.365Z",
      "updatedAt": "2025-09-03T02:25:37.365Z",
      "chapterId": "b81de628-9e2e-4e89-8630-a88941f30498"
    },
    {
      "id": "fdf82618-9825-4833-b231-d9ce4ce6d8d9",
      "text": "Kìa quân gian ác đã giương nỏ lắp tên,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:37.379Z",
      "updatedAt": "2025-09-03T02:25:37.379Z",
      "chapterId": "b81de628-9e2e-4e89-8630-a88941f30498"
    },
    {
      "id": "91783157-543f-4b51-a0ce-49a75748925f",
      "text": "núp trong bóng tối nhằm bắn người ngay thẳng.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:37.393Z",
      "updatedAt": "2025-09-03T02:25:37.393Z",
      "chapterId": "b81de628-9e2e-4e89-8630-a88941f30498"
    },
    {
      "id": "46e407d4-c54c-4fe3-a731-4de423158090",
      "text": "Khi nền móng cương thường đổ nát",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:37.407Z",
      "updatedAt": "2025-09-03T02:25:37.407Z",
      "chapterId": "b81de628-9e2e-4e89-8630-a88941f30498"
    },
    {
      "id": "979db2c8-8bed-4aa8-9ba1-b1392547bbe1",
      "text": "người công chính còn làm được chuyện gì ?”",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:37.422Z",
      "updatedAt": "2025-09-03T02:25:37.422Z",
      "chapterId": "b81de628-9e2e-4e89-8630-a88941f30498"
    },
    {
      "id": "9fa88dc1-494f-4c56-b36f-c820662e6973",
      "text": "Nhưng ĐỨC CHÚA ngự trong thánh điện,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:37.437Z",
      "updatedAt": "2025-09-03T02:25:37.437Z",
      "chapterId": "b81de628-9e2e-4e89-8630-a88941f30498"
    },
    {
      "id": "f167e199-0779-4f73-b5db-37717a04ec9e",
      "text": "ngai ĐỨC CHÚA đặt trên cõi trời ;",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:37.465Z",
      "updatedAt": "2025-09-03T02:25:37.465Z",
      "chapterId": "b81de628-9e2e-4e89-8630-a88941f30498"
    },
    {
      "id": "38c263fd-6d4f-415b-854c-41fd12c313d4",
      "text": "Chúa đưa mắt nhìn, dò xét phàm nhân.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:37.492Z",
      "updatedAt": "2025-09-03T02:25:37.492Z",
      "chapterId": "b81de628-9e2e-4e89-8630-a88941f30498"
    },
    {
      "id": "57f9b1c7-554a-4056-8678-43921926ccdb",
      "text": "CHÚA dò xét người lành kẻ dữ,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:37.507Z",
      "updatedAt": "2025-09-03T02:25:37.507Z",
      "chapterId": "b81de628-9e2e-4e89-8630-a88941f30498"
    },
    {
      "id": "c6f7676e-5656-425d-9716-08294cd776e1",
      "text": "ghét những ai ưa thích bạo tàn.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:37.521Z",
      "updatedAt": "2025-09-03T02:25:37.521Z",
      "chapterId": "b81de628-9e2e-4e89-8630-a88941f30498"
    },
    {
      "id": "823f41f0-a198-4a2f-b6ac-493d1e92e9cd",
      "text": "Chúa đổ mưa tai hoạ xuống đầu ác nhân ;",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:37.536Z",
      "updatedAt": "2025-09-03T02:25:37.536Z",
      "chapterId": "b81de628-9e2e-4e89-8630-a88941f30498"
    },
    {
      "id": "6cd5f704-4051-4e3b-ba05-f94f4cd61871",
      "text": "lửa đỏ, diêm sinh và gió nóng",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:37.549Z",
      "updatedAt": "2025-09-03T02:25:37.549Z",
      "chapterId": "b81de628-9e2e-4e89-8630-a88941f30498"
    },
    {
      "id": "ef527744-9844-4642-a436-2a3741a3be80",
      "text": "là phần riêng của chúng trên đời.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:37.577Z",
      "updatedAt": "2025-09-03T02:25:37.577Z",
      "chapterId": "b81de628-9e2e-4e89-8630-a88941f30498"
    },
    {
      "id": "e411febe-4593-469d-be38-90d7ac1cabdb",
      "text": "Quả thật CHÚA là Đấng công chính,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:37.591Z",
      "updatedAt": "2025-09-03T02:25:37.591Z",
      "chapterId": "b81de628-9e2e-4e89-8630-a88941f30498"
    },
    {
      "id": "9d4b0d0d-d7d7-4795-8ef1-1ce04b43d475",
      "text": "ưa thích điều chính trực ; những kẻ sống ngay lành",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:37.605Z",
      "updatedAt": "2025-09-03T02:25:37.605Z",
      "chapterId": "b81de628-9e2e-4e89-8630-a88941f30498"
    },
    {
      "id": "01dda082-8ec3-43d5-bdb5-32889ef6f923",
      "text": "được chiêm ngưỡng Thánh Nhan.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:37.619Z",
      "updatedAt": "2025-09-03T02:25:37.619Z",
      "chapterId": "b81de628-9e2e-4e89-8630-a88941f30498"
    }
  ],
  "marks": [
    {
      "id": "6f02a774-788f-4fbb-b907-fe1b0f37df33",
      "content": "English: Yahweh | French: SEIGNEUR | Latin: Dominus | Origin: &#1497;&#1456;&#1492;&#64331;&#1464;&#1492; | Vietnamese: ĐỨC CHÚA -- Danh của Thiên Chúa Ít-ra-en, St 2,4...",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 19,
      "endOffset": 19,
      "createdAt": "2025-09-03T02:25:37.318Z",
      "updatedAt": "2025-09-03T02:25:37.318Z",
      "targetId": "0c3baa97-8d90-4d3c-8f3d-8eed43978b64",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "b81de628-9e2e-4e89-8630-a88941f30498"
    },
    {
      "id": "be2a63e2-405b-433d-b0f1-fab3f2668ca0",
      "content": "Tv 11 là một trong những *Thánh vịnh tín nhiệm*, muốn diễn tả ý nghĩa sau đây : mặc dầu *quân gian ác* tìm cách tấn công người công chính (c.2), mặc dầu *cương thường* (*nền móng* : c.3) *đổ nát* tan hoang, những con người được gọi ở đây là *người ngay thẳng, người công chính, người lành, kẻ sống ngay lành*, vẫn *ẩn mình bên Chúa* (c.1), nghĩa là đặt niềm tin tưởng tuyệt đối vào Thiên Chúa, không cần lẩn trốn ở nơi nào khác, như núi non là nơi ẩn náu, nơi lánh nạn (x. St 19,17 ; Mt 24,16). Lý do : Thiên Chúa là Đấng công chính ngự trên cõi trời, hằng đưa mắt nhìn thế giới phàm nhân và giáng tai hoạ xuống đầu ác nhân.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 45,
      "endOffset": 45,
      "createdAt": "2025-09-03T02:25:37.330Z",
      "updatedAt": "2025-09-03T02:25:37.330Z",
      "targetId": "0c3baa97-8d90-4d3c-8f3d-8eed43978b64",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "b81de628-9e2e-4e89-8630-a88941f30498"
    },
