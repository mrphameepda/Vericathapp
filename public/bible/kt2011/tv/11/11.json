    },
    {
      "id": "f978007c-abd0-436b-bb44-c6115ef1b5f1",
      "content": "*Chiêm ngưỡng Thánh Nhan* là đến trước nhan Thiên Chúa để nhận lãnh những ân huệ Người ban.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "7",
      "sortOrder": 6,
