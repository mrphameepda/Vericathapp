    {
      "id": "c5c03939-448b-4121-8f09-c15fa2d091c8",
      "content": "Câu này ám chỉ hình phạt giáng xuống Xơ-đôm và Gô-mô-ra (x. St 19,24).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "6",
      "sortOrder": 5,
      "startOffset": 29,
      "endOffset": 29,
