{
  "chapter": {
    "id": "40627737-71fe-4b19-bad9-84f324332bb3",
    "number": 111,
    "createdAt": "2025-09-03T01:07:51.662Z",
    "updatedAt": "2025-09-03T01:07:51.662Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "73895160-dee4-4bfc-81d9-df23c761fa6a",
      "text": "Ha-lê-lui-a.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:16.239Z",
      "updatedAt": "2025-09-03T02:36:16.239Z",
      "chapterId": "40627737-71fe-4b19-bad9-84f324332bb3"
    },
    {
      "id": "649e715d-6f66-4c72-b77e-505737302725",
      "text": "A-lép",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:36:16.290Z",
      "updatedAt": "2025-09-03T02:36:16.290Z",
      "chapterId": "40627737-71fe-4b19-bad9-84f324332bb3"
    },
    {
      "id": "ead207ee-aec9-4a45-a5b5-424cbea1a184",
      "text": "Tôi xin hết lòng cảm tạ CHÚA,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:16.303Z",
      "updatedAt": "2025-09-03T02:36:16.303Z",
      "chapterId": "40627737-71fe-4b19-bad9-84f324332bb3"
    },
    {
      "id": "67c902ae-d18b-4f21-9b48-df0c95ff9f73",
      "text": "Bết",
      "label": "1",
      "number": 1,
      "subVerseIndex": 3,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:36:16.317Z",
      "updatedAt": "2025-09-03T02:36:16.317Z",
      "chapterId": "40627737-71fe-4b19-bad9-84f324332bb3"
    },
    {
      "id": "ba915728-622b-46d2-b0b3-a64834fc15ba",
      "text": "trong cộng đoàn chính nhân, giữa lòng đại hội.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 4,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:16.330Z",
      "updatedAt": "2025-09-03T02:36:16.330Z",
      "chapterId": "40627737-71fe-4b19-bad9-84f324332bb3"
    },
    {
      "id": "2e79ae42-00b2-47d9-8edd-d3c118596fbc",
      "text": "Ghi-men",
      "label": "1",
      "number": 1,
      "subVerseIndex": 5,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:36:16.344Z",
      "updatedAt": "2025-09-03T02:36:16.344Z",
      "chapterId": "40627737-71fe-4b19-bad9-84f324332bb3"
    },
    {
      "id": "47385f40-8f42-4e08-bc06-bdfffc100d27",
      "text": "Việc CHÚA làm quả thật lớn lao,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:16.358Z",
      "updatedAt": "2025-09-03T02:36:16.358Z",
      "chapterId": "40627737-71fe-4b19-bad9-84f324332bb3"
    },
    {
      "id": "6adb841a-b62b-4609-a38f-b76d5f45e6d6",
      "text": "Đa-lét",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:36:16.372Z",
      "updatedAt": "2025-09-03T02:36:16.372Z",
      "chapterId": "40627737-71fe-4b19-bad9-84f324332bb3"
    },
    {
      "id": "e99e1f93-9c14-4bf1-85f0-1547d912789e",
      "text": "người mộ mến ra công tìm hiểu.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:16.386Z",
      "updatedAt": "2025-09-03T02:36:16.386Z",
      "chapterId": "40627737-71fe-4b19-bad9-84f324332bb3"
    },
    {
      "id": "2e5905dd-96d9-4368-a247-c27db5963a88",
      "text": "Hê",
      "label": "2",
      "number": 2,
      "subVerseIndex": 3,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:36:16.400Z",
      "updatedAt": "2025-09-03T02:36:16.400Z",
      "chapterId": "40627737-71fe-4b19-bad9-84f324332bb3"
    },
    {
      "id": "ff8a1d69-0622-48f9-9613-f134c2df35fb",
      "text": "Sự nghiệp Chúa oai phong hiển hách,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:16.414Z",
      "updatedAt": "2025-09-03T02:36:16.414Z",
      "chapterId": "40627737-71fe-4b19-bad9-84f324332bb3"
    },
    {
      "id": "51e3ae57-d66b-474f-adf3-19a51ea61c8b",
      "text": "Vau",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:36:16.428Z",
      "updatedAt": "2025-09-03T02:36:16.428Z",
      "chapterId": "40627737-71fe-4b19-bad9-84f324332bb3"
    },
    {
      "id": "b6fffb7d-98e0-426e-a093-b9def7b7592b",
      "text": "đức công chính của Người tồn tại thiên thu.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:16.441Z",
      "updatedAt": "2025-09-03T02:36:16.441Z",
      "chapterId": "40627737-71fe-4b19-bad9-84f324332bb3"
    },
    {
      "id": "d21d3ea1-6179-41e4-a267-d4c12de56172",
      "text": "Da-in",
      "label": "3",
      "number": 3,
      "subVerseIndex": 3,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:36:16.469Z",
      "updatedAt": "2025-09-03T02:36:16.469Z",
      "chapterId": "40627737-71fe-4b19-bad9-84f324332bb3"
    },
    {
      "id": "47c68236-6c66-4bcc-a70e-6cbe06da2782",
      "text": "Chúa đã truyền tưởng niệm những kỳ công của Người.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:16.483Z",
      "updatedAt": "2025-09-03T02:36:16.483Z",
      "chapterId": "40627737-71fe-4b19-bad9-84f324332bb3"
    },
    {
      "id": "e325521b-1ed8-4600-80c6-be806af2e9db",
      "text": "Khết",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:36:16.497Z",
      "updatedAt": "2025-09-03T02:36:16.497Z",
      "chapterId": "40627737-71fe-4b19-bad9-84f324332bb3"
    },
    {
      "id": "a235248f-e572-48f7-88c8-f53a19702667",
      "text": "CHÚA là Đấng từ bi nhân hậu.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:16.511Z",
      "updatedAt": "2025-09-03T02:36:16.511Z",
      "chapterId": "40627737-71fe-4b19-bad9-84f324332bb3"
    },
    {
      "id": "0ab11136-009b-4212-a1fb-0cac0c847f8c",
      "text": "Tết",
      "label": "4",
      "number": 4,
      "subVerseIndex": 3,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:36:16.525Z",
      "updatedAt": "2025-09-03T02:36:16.525Z",
      "chapterId": "40627737-71fe-4b19-bad9-84f324332bb3"
    },
    {
      "id": "0581a258-c1b7-4097-a0dc-6d6766088944",
      "text": "Ai kính sợ Người, Người ban phát của ăn ;",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:16.538Z",
      "updatedAt": "2025-09-03T02:36:16.538Z",
      "chapterId": "40627737-71fe-4b19-bad9-84f324332bb3"
    },
    {
      "id": "44399859-9a49-4217-a891-a4863662efd5",
      "text": "Giốt",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:36:16.567Z",
      "updatedAt": "2025-09-03T02:36:16.567Z",
      "chapterId": "40627737-71fe-4b19-bad9-84f324332bb3"
    },
    {
      "id": "2701a7c8-afa9-4007-ac7a-bc3995713487",
      "text": "giao ước đã lập ra, muôn đời Người nhớ mãi.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:16.581Z",
      "updatedAt": "2025-09-03T02:36:16.581Z",
      "chapterId": "40627737-71fe-4b19-bad9-84f324332bb3"
    },
    {
      "id": "fee795dc-12cd-470f-a966-e2f404e88937",
      "text": "Cáp",
      "label": "5",
      "number": 5,
      "subVerseIndex": 3,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:36:16.595Z",
      "updatedAt": "2025-09-03T02:36:16.595Z",
      "chapterId": "40627737-71fe-4b19-bad9-84f324332bb3"
    },
    {
      "id": "f5b433d3-7719-4182-8617-e0e8213d769f",
      "text": "Sức mạnh việc Người làm, Người cho dân thấy rõ,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:16.609Z",
      "updatedAt": "2025-09-03T02:36:16.609Z",
      "chapterId": "40627737-71fe-4b19-bad9-84f324332bb3"
    },
    {
      "id": "0db8714d-e825-4481-86a1-b49d42c00921",
      "text": "La-mét",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:36:16.622Z",
      "updatedAt": "2025-09-03T02:36:16.622Z",
      "chapterId": "40627737-71fe-4b19-bad9-84f324332bb3"
    },
    {
      "id": "292953f6-7719-4d81-8d77-a3a3ab1fa286",
      "text": "khi tặng ban cho họ gia sản của chư dân.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:16.646Z",
      "updatedAt": "2025-09-03T02:36:16.646Z",
      "chapterId": "40627737-71fe-4b19-bad9-84f324332bb3"
    },
    {
      "id": "e7125476-4db1-4f9b-8e89-34facb1be7df",
      "text": "Mêm",
      "label": "6",
      "number": 6,
      "subVerseIndex": 3,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:36:16.660Z",
      "updatedAt": "2025-09-03T02:36:16.660Z",
      "chapterId": "40627737-71fe-4b19-bad9-84f324332bb3"
    },
    {
      "id": "dd91f01e-9427-4d66-a44b-55e12767394b",
      "text": "Những công trình tay Chúa thực hiện",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:16.673Z",
      "updatedAt": "2025-09-03T02:36:16.673Z",
      "chapterId": "40627737-71fe-4b19-bad9-84f324332bb3"
    },
    {
      "id": "598b6a18-b02e-495e-9d14-c7969d2ccab7",
      "text": "quả là chân thật và công minh.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:16.687Z",
      "updatedAt": "2025-09-03T02:36:16.687Z",
      "chapterId": "40627737-71fe-4b19-bad9-84f324332bb3"
    },
    {
      "id": "5bd75f1d-9f27-408c-8cff-539387e39bf5",
      "text": "Nun",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:36:16.701Z",
      "updatedAt": "2025-09-03T02:36:16.701Z",
      "chapterId": "40627737-71fe-4b19-bad9-84f324332bb3"
    },
    {
      "id": "62a6ec85-2a97-40c9-9527-7399297217f2",
      "text": "Huấn lệnh Người ban đều chắc chắn,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 3,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:16.728Z",
      "updatedAt": "2025-09-03T02:36:16.728Z",
      "chapterId": "40627737-71fe-4b19-bad9-84f324332bb3"
    },
    {
      "id": "1d84fb34-124c-41dc-8cf1-24e9482a5853",
      "text": "Xa-méc",
      "label": "7",
      "number": 7,
      "subVerseIndex": 4,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:36:16.742Z",
      "updatedAt": "2025-09-03T02:36:16.742Z",
      "chapterId": "40627737-71fe-4b19-bad9-84f324332bb3"
    },
    {
      "id": "24ae1350-6632-49ae-b8d8-f8434d9a16b1",
      "text": "bền vững đến muôn đời muôn thuở,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:16.756Z",
      "updatedAt": "2025-09-03T02:36:16.756Z",
      "chapterId": "40627737-71fe-4b19-bad9-84f324332bb3"
    },
    {
      "id": "33040a73-b1cf-4e92-a5b1-89946cda026d",
      "text": "A-in",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:36:16.770Z",
      "updatedAt": "2025-09-03T02:36:16.770Z",
      "chapterId": "40627737-71fe-4b19-bad9-84f324332bb3"
    },
    {
      "id": "dc75f7f6-c515-4f40-a7ca-880f5e8d4a79",
      "text": "căn cứ vào sự thật lẽ ngay.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:16.784Z",
      "updatedAt": "2025-09-03T02:36:16.784Z",
      "chapterId": "40627737-71fe-4b19-bad9-84f324332bb3"
    },
    {
      "id": "b3cf5d74-dbee-455e-b52b-86b1bcfa8ed2",
      "text": "Pê",
      "label": "8",
      "number": 8,
      "subVerseIndex": 3,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:36:16.798Z",
      "updatedAt": "2025-09-03T02:36:16.798Z",
      "chapterId": "40627737-71fe-4b19-bad9-84f324332bb3"
    },
    {
      "id": "adc8ef90-decd-47e1-afe2-0c3faa850b48",
      "text": "Người đem lại cho dân ơn giải thoát,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:16.812Z",
      "updatedAt": "2025-09-03T02:36:16.812Z",
      "chapterId": "40627737-71fe-4b19-bad9-84f324332bb3"
    },
    {
      "id": "35af6a43-12bf-42e7-9bf9-75f1cda3eba1",
      "text": "Xa-đê",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:36:16.826Z",
      "updatedAt": "2025-09-03T02:36:16.826Z",
      "chapterId": "40627737-71fe-4b19-bad9-84f324332bb3"
    },
    {
      "id": "028ac235-1242-4ae1-8013-639149c21c7d",
      "text": "thiết lập giao ước đến muôn đời.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:16.841Z",
      "updatedAt": "2025-09-03T02:36:16.841Z",
      "chapterId": "40627737-71fe-4b19-bad9-84f324332bb3"
    },
    {
      "id": "571079e3-d54d-49a1-8f05-983552eafac1",
      "text": "Cốp",
      "label": "9",
      "number": 9,
      "subVerseIndex": 3,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:36:16.855Z",
      "updatedAt": "2025-09-03T02:36:16.855Z",
      "chapterId": "40627737-71fe-4b19-bad9-84f324332bb3"
    },
    {
      "id": "cd209995-1ef7-4c47-9f73-6f2ea879c767",
      "text": "Tôn danh Người thánh thiêng khả uý.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 4,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:16.867Z",
      "updatedAt": "2025-09-03T02:36:16.867Z",
      "chapterId": "40627737-71fe-4b19-bad9-84f324332bb3"
    },
    {
      "id": "84ccece3-8ce7-4c6a-b793-3bf846b096a9",
      "text": "Rết",
      "label": "9",
      "number": 9,
      "subVerseIndex": 5,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:36:16.878Z",
      "updatedAt": "2025-09-03T02:36:16.878Z",
      "chapterId": "40627737-71fe-4b19-bad9-84f324332bb3"
    },
    {
