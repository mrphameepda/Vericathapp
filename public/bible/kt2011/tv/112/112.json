{
  "chapter": {
    "id": "af282355-f07b-406c-82b7-6f49c64ab349",
    "number": 112,
    "createdAt": "2025-09-03T01:07:51.662Z",
    "updatedAt": "2025-09-03T01:07:51.662Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "0ae99d4d-f1ad-459e-95d6-efd5f4b4b22c",
      "text": "Ha-lê-lui-a.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:24.095Z",
      "updatedAt": "2025-09-03T02:36:24.095Z",
      "chapterId": "af282355-f07b-406c-82b7-6f49c64ab349"
    },
    {
      "id": "7846a179-e50e-4865-b908-e7b98e6459a6",
      "text": "A-lép",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:36:24.135Z",
      "updatedAt": "2025-09-03T02:36:24.135Z",
      "chapterId": "af282355-f07b-406c-82b7-6f49c64ab349"
    },
    {
      "id": "3cfc3387-9ce6-4dbd-a98c-0a6df36d647e",
      "text": "Hạnh phúc thay, người kính sợ CHÚA,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:24.147Z",
      "updatedAt": "2025-09-03T02:36:24.147Z",
      "chapterId": "af282355-f07b-406c-82b7-6f49c64ab349"
    },
    {
      "id": "9c37b7a8-e637-43e8-80f0-08d5063dbad8",
      "text": "Bết",
      "label": "1",
      "number": 1,
      "subVerseIndex": 3,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:36:24.162Z",
      "updatedAt": "2025-09-03T02:36:24.162Z",
      "chapterId": "af282355-f07b-406c-82b7-6f49c64ab349"
    },
    {
      "id": "d8f6a526-6ce1-4932-8167-d8c2ca338ce4",
      "text": "những ưa cùng thích mệnh lệnh Chúa truyền ban.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 4,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:24.175Z",
      "updatedAt": "2025-09-03T02:36:24.175Z",
      "chapterId": "af282355-f07b-406c-82b7-6f49c64ab349"
    },
    {
      "id": "9d7e7c90-35bd-4dbe-8e2e-dfd8ea6feb03",
      "text": "Ghi-men",
      "label": "1",
      "number": 1,
      "subVerseIndex": 5,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:36:24.189Z",
      "updatedAt": "2025-09-03T02:36:24.189Z",
      "chapterId": "af282355-f07b-406c-82b7-6f49c64ab349"
    },
    {
      "id": "da599636-d5fe-46fc-ad29-1573658a74e1",
      "text": "Trên mặt đất, con cháu của họ sẽ hùng cường,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:24.202Z",
      "updatedAt": "2025-09-03T02:36:24.202Z",
      "chapterId": "af282355-f07b-406c-82b7-6f49c64ab349"
    },
    {
      "id": "db52463b-8b7e-45fb-9de6-e2857902dc5b",
      "text": "Đa-lét",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:36:24.216Z",
      "updatedAt": "2025-09-03T02:36:24.216Z",
      "chapterId": "af282355-f07b-406c-82b7-6f49c64ab349"
    },
    {
      "id": "24a92766-eeec-4da6-9b09-efc7274fef3b",
      "text": "dòng dõi kẻ ngay lành được Chúa thương giáng phúc.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:24.230Z",
      "updatedAt": "2025-09-03T02:36:24.230Z",
      "chapterId": "af282355-f07b-406c-82b7-6f49c64ab349"
    },
    {
      "id": "2e253a7f-6340-4e50-a943-ebb509112efd",
      "text": "Hê",
      "label": "2",
      "number": 2,
      "subVerseIndex": 3,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:36:24.244Z",
      "updatedAt": "2025-09-03T02:36:24.244Z",
      "chapterId": "af282355-f07b-406c-82b7-6f49c64ab349"
    },
    {
      "id": "90749c1f-1fba-465f-b63b-228f99842d5e",
      "text": "Gia đình họ phú quý giàu sang,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:24.258Z",
      "updatedAt": "2025-09-03T02:36:24.258Z",
      "chapterId": "af282355-f07b-406c-82b7-6f49c64ab349"
    },
    {
      "id": "b78b8455-c66b-47cd-a672-a9ed626af0ef",
      "text": "Vau",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:36:24.275Z",
      "updatedAt": "2025-09-03T02:36:24.275Z",
      "chapterId": "af282355-f07b-406c-82b7-6f49c64ab349"
    },
    {
      "id": "6b649b8f-a5a8-4403-83f1-fa34a87bf922",
      "text": "đức công chính của họ tồn tại muôn đời.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:24.292Z",
      "updatedAt": "2025-09-03T02:36:24.292Z",
      "chapterId": "af282355-f07b-406c-82b7-6f49c64ab349"
    },
    {
      "id": "da0c10ac-0a23-47b7-9297-9c7e4a9c3866",
      "text": "Da-in",
      "label": "3",
      "number": 3,
      "subVerseIndex": 3,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:36:24.321Z",
      "updatedAt": "2025-09-03T02:36:24.321Z",
      "chapterId": "af282355-f07b-406c-82b7-6f49c64ab349"
    },
    {
      "id": "e8c45bd9-21f0-431d-9d24-38fdd275705c",
      "text": "Giữa tối tăm bừng lên một ánh sáng",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:24.334Z",
      "updatedAt": "2025-09-03T02:36:24.334Z",
      "chapterId": "af282355-f07b-406c-82b7-6f49c64ab349"
    },
    {
      "id": "3cc44832-06b3-40dc-bc72-4cc50b2a6129",
      "text": "chiếu rọi kẻ ngay lành :",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:24.348Z",
      "updatedAt": "2025-09-03T02:36:24.348Z",
      "chapterId": "af282355-f07b-406c-82b7-6f49c64ab349"
    },
    {
      "id": "3fab1701-146c-4b39-9c0e-76aeb27a27ae",
      "text": "Khết",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:36:24.362Z",
      "updatedAt": "2025-09-03T02:36:24.362Z",
      "chapterId": "af282355-f07b-406c-82b7-6f49c64ab349"
    },
    {
      "id": "11f9fefb-49fe-475a-ba33-9ea914d5c26c",
      "text": "đó là người từ bi nhân hậu và công chính.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 3,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:24.376Z",
      "updatedAt": "2025-09-03T02:36:24.376Z",
      "chapterId": "af282355-f07b-406c-82b7-6f49c64ab349"
    },
    {
      "id": "2877472e-0ffe-4571-8c6e-a0e523dd7015",
      "text": "Tết",
      "label": "4",
      "number": 4,
      "subVerseIndex": 4,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:36:24.405Z",
      "updatedAt": "2025-09-03T02:36:24.405Z",
      "chapterId": "af282355-f07b-406c-82b7-6f49c64ab349"
    },
    {
      "id": "b162a1e1-58f7-4918-a661-54f0d5402a62",
      "text": "Phúc thay người biết cảm thương và cho vay mượn,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:24.419Z",
      "updatedAt": "2025-09-03T02:36:24.419Z",
      "chapterId": "af282355-f07b-406c-82b7-6f49c64ab349"
    },
    {
      "id": "fa31a9fd-14e0-4ec8-9635-555c88875da9",
      "text": "Giốt",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:36:24.446Z",
      "updatedAt": "2025-09-03T02:36:24.446Z",
      "chapterId": "af282355-f07b-406c-82b7-6f49c64ab349"
    },
    {
      "id": "111621da-543b-4c26-bb88-7fe6f92312e9",
      "text": "biết theo lẽ phải mà thu xếp công việc mình.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:24.460Z",
      "updatedAt": "2025-09-03T02:36:24.460Z",
      "chapterId": "af282355-f07b-406c-82b7-6f49c64ab349"
    },
    {
      "id": "235f631d-6652-472e-a533-65da5a2b0fda",
      "text": "Cáp",
      "label": "5",
      "number": 5,
      "subVerseIndex": 3,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:36:24.474Z",
      "updatedAt": "2025-09-03T02:36:24.474Z",
      "chapterId": "af282355-f07b-406c-82b7-6f49c64ab349"
    },
    {
      "id": "1a87aa95-5e72-48b7-be63-764f63696c07",
      "text": "Họ sẽ không bao giờ lay chuyển,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:24.488Z",
      "updatedAt": "2025-09-03T02:36:24.488Z",
      "chapterId": "af282355-f07b-406c-82b7-6f49c64ab349"
    },
    {
      "id": "c1eaf404-01df-49d6-bc67-ce881f5645db",
      "text": "La-mét",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:36:24.502Z",
      "updatedAt": "2025-09-03T02:36:24.502Z",
      "chapterId": "af282355-f07b-406c-82b7-6f49c64ab349"
    },
    {
      "id": "cffa7a68-a86f-4967-b1f1-59be6fc38686",
      "text": "thiên hạ muôn đời còn tưởng nhớ chính nhân.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:24.515Z",
      "updatedAt": "2025-09-03T02:36:24.515Z",
      "chapterId": "af282355-f07b-406c-82b7-6f49c64ab349"
    },
    {
      "id": "9d915a97-cb26-4371-9919-63371a89e213",
      "text": "Mêm",
      "label": "6",
      "number": 6,
      "subVerseIndex": 3,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:36:24.525Z",
      "updatedAt": "2025-09-03T02:36:24.525Z",
      "chapterId": "af282355-f07b-406c-82b7-6f49c64ab349"
    },
    {
      "id": "505775ab-47f6-4f8d-ba33-f54438cbfa48",
      "text": "Họ không lo phải nghe tin dữ,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:24.535Z",
      "updatedAt": "2025-09-03T02:36:24.535Z",
      "chapterId": "af282355-f07b-406c-82b7-6f49c64ab349"
    },
    {
      "id": "bc94d739-f1b6-4634-a2c3-477bbb42d3c1",
      "text": "Nun",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:36:24.546Z",
      "updatedAt": "2025-09-03T02:36:24.546Z",
      "chapterId": "af282355-f07b-406c-82b7-6f49c64ab349"
    },
    {
      "id": "c1fbe256-11d1-4c52-a6db-6c02f3d7e38a",
      "text": "hằng an tâm và tin cậy CHÚA,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:24.567Z",
      "updatedAt": "2025-09-03T02:36:24.567Z",
      "chapterId": "af282355-f07b-406c-82b7-6f49c64ab349"
    },
    {
      "id": "25072e50-6b26-4dcd-baaf-ae817e9c5ddd",
      "text": "Xa-méc",
      "label": "7",
      "number": 7,
      "subVerseIndex": 3,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:36:24.577Z",
      "updatedAt": "2025-09-03T02:36:24.577Z",
      "chapterId": "af282355-f07b-406c-82b7-6f49c64ab349"
    },
    {
      "id": "1964c7f3-3427-4249-94ff-9f22673da60e",
      "text": "luôn vững lòng không sợ hãi chi",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:24.588Z",
      "updatedAt": "2025-09-03T02:36:24.588Z",
      "chapterId": "af282355-f07b-406c-82b7-6f49c64ab349"
    },
    {
      "id": "1657c736-88a5-424d-a1ca-f79e040dfb98",
      "text": "A-in",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:36:24.598Z",
      "updatedAt": "2025-09-03T02:36:24.598Z",
      "chapterId": "af282355-f07b-406c-82b7-6f49c64ab349"
    },
    {
      "id": "7007ae73-3495-45f5-8239-23e0261a0572",
      "text": "và rốt cuộc coi khinh lũ địch thù.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:24.609Z",
      "updatedAt": "2025-09-03T02:36:24.609Z",
      "chapterId": "af282355-f07b-406c-82b7-6f49c64ab349"
    },
    {
      "id": "34af72a0-8dae-4306-b3db-3a4538ee1c1f",
      "text": "Pê",
      "label": "8",
      "number": 8,
      "subVerseIndex": 3,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:36:24.621Z",
      "updatedAt": "2025-09-03T02:36:24.621Z",
      "chapterId": "af282355-f07b-406c-82b7-6f49c64ab349"
    },
    {
      "id": "8f4cea71-b748-41b0-90cb-d501a281309a",
      "text": "Kẻ túng nghèo, họ rộng tay làm phúc,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:24.632Z",
      "updatedAt": "2025-09-03T02:36:24.632Z",
      "chapterId": "af282355-f07b-406c-82b7-6f49c64ab349"
    },
    {
      "id": "254d88bb-904f-41d1-afec-161bad0a381f",
      "text": "Xa-đê",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:36:24.645Z",
      "updatedAt": "2025-09-03T02:36:24.645Z",
      "chapterId": "af282355-f07b-406c-82b7-6f49c64ab349"
    },
    {
      "id": "ffd652c2-d254-4342-9fc3-1097a0e8c1bf",
      "text": "đức công chính của họ tồn tại muôn đời,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:24.659Z",
      "updatedAt": "2025-09-03T02:36:24.659Z",
      "chapterId": "af282355-f07b-406c-82b7-6f49c64ab349"
    },
    {
      "id": "99ee0584-4874-46d0-9ee6-6a08dd04fe06",
      "text": "Cốp",
      "label": "9",
      "number": 9,
      "subVerseIndex": 3,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:36:24.673Z",
      "updatedAt": "2025-09-03T02:36:24.673Z",
      "chapterId": "af282355-f07b-406c-82b7-6f49c64ab349"
    },
    {
      "id": "7d755f8e-fe40-46b4-8497-2a2275139561",
      "text": "uy thế họ vươn cao rực rỡ.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 4,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:24.687Z",
      "updatedAt": "2025-09-03T02:36:24.687Z",
      "chapterId": "af282355-f07b-406c-82b7-6f49c64ab349"
    },
    {
      "id": "7b128fd3-ffa4-49f2-b85d-531f61470b72",
      "text": "Rết",
      "label": "9",
      "number": 9,
      "subVerseIndex": 5,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": false,
