{
  "chapter": {
    "id": "dde02604-64de-4b5d-b9e4-8466bb51a444",
    "number": 113,
    "createdAt": "2025-09-03T01:07:51.662Z",
    "updatedAt": "2025-09-03T01:07:51.662Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "8c6a8bdf-6c68-477f-9bcb-df41d8e8750b",
      "text": "Ha-lê-lui-a.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:31.567Z",
      "updatedAt": "2025-09-03T02:36:31.567Z",
      "chapterId": "dde02604-64de-4b5d-b9e4-8466bb51a444"
    },
    {
      "id": "af7f45d6-044f-4fc3-b7f5-b4476d34d62c",
      "text": "Hỡi tôi tớ CHÚA, hãy dâng lời ca ngợi,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:31.606Z",
      "updatedAt": "2025-09-03T02:36:31.606Z",
      "chapterId": "dde02604-64de-4b5d-b9e4-8466bb51a444"
    },
    {
      "id": "98539368-16f6-4bf2-9640-173a7f1eb747",
      "text": "nào ca ngợi danh thánh CHÚA đi !",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:31.618Z",
      "updatedAt": "2025-09-03T02:36:31.618Z",
      "chapterId": "dde02604-64de-4b5d-b9e4-8466bb51a444"
    },
    {
      "id": "4fb5c40e-e0b1-40f4-b826-1aab6ef42339",
      "text": "Chúc tụng danh thánh CHÚA,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:31.629Z",
      "updatedAt": "2025-09-03T02:36:31.629Z",
      "chapterId": "dde02604-64de-4b5d-b9e4-8466bb51a444"
    },
    {
      "id": "60031ecf-dad3-4383-a1d5-48870bfeb34f",
      "text": "tự giờ đây cho đến mãi muôn đời !",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:31.641Z",
      "updatedAt": "2025-09-03T02:36:31.641Z",
      "chapterId": "dde02604-64de-4b5d-b9e4-8466bb51a444"
    },
    {
      "id": "5225f2c7-5dd2-4a67-8109-010e561b107a",
      "text": "Ca ngợi danh thánh CHÚA,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:31.655Z",
      "updatedAt": "2025-09-03T02:36:31.655Z",
      "chapterId": "dde02604-64de-4b5d-b9e4-8466bb51a444"
    },
    {
      "id": "6db8630c-5f19-4939-9c80-ece2e2005b7f",
      "text": "từ rạng đông tới lúc chiều tà !",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:31.668Z",
      "updatedAt": "2025-09-03T02:36:31.668Z",
      "chapterId": "dde02604-64de-4b5d-b9e4-8466bb51a444"
    },
    {
      "id": "662c87ff-7405-457f-b269-ec707de0734a",
      "text": "CHÚA siêu việt trên hết mọi dân,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:31.696Z",
      "updatedAt": "2025-09-03T02:36:31.696Z",
      "chapterId": "dde02604-64de-4b5d-b9e4-8466bb51a444"
    },
    {
      "id": "eedbdd5d-d081-41fb-ab93-367b5a6ed279",
      "text": "vinh quang Người vượt xa trời cao thẳm.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:31.710Z",
      "updatedAt": "2025-09-03T02:36:31.710Z",
      "chapterId": "dde02604-64de-4b5d-b9e4-8466bb51a444"
    },
    {
      "id": "545b18c5-5f4d-47b9-94b1-c2dc04aae7e7",
      "text": "Ai sánh tày THƯỢNG ĐẾ Chúa ta, Đấng ngự chốn cao vời,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:31.724Z",
      "updatedAt": "2025-09-03T02:36:31.724Z",
      "chapterId": "dde02604-64de-4b5d-b9e4-8466bb51a444"
    },
    {
      "id": "776a830b-8564-4cc7-897a-59763655ee0a",
      "text": "cúi xuống để nhìn xem bầu trời trái đất ?",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:31.738Z",
      "updatedAt": "2025-09-03T02:36:31.738Z",
      "chapterId": "dde02604-64de-4b5d-b9e4-8466bb51a444"
    },
    {
      "id": "3ccf2c75-3117-4c89-9caf-7336e7b34f05",
      "text": "Kẻ mọn hèn, Chúa kéo ra khỏi nơi cát bụi,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:31.752Z",
      "updatedAt": "2025-09-03T02:36:31.752Z",
      "chapterId": "dde02604-64de-4b5d-b9e4-8466bb51a444"
    },
    {
      "id": "84e505b1-5c6b-4cbc-954a-8521dfdee854",
      "text": "ai nghèo túng, Người cất nhắc từ đống phân tro,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:31.780Z",
      "updatedAt": "2025-09-03T02:36:31.780Z",
      "chapterId": "dde02604-64de-4b5d-b9e4-8466bb51a444"
    },
    {
      "id": "b802100a-eaff-4933-a7c2-c23d9148d969",
      "text": "đặt ngồi chung với hàng quyền quý, hàng quyền quý dân Người.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:31.794Z",
      "updatedAt": "2025-09-03T02:36:31.794Z",
      "chapterId": "dde02604-64de-4b5d-b9e4-8466bb51a444"
    },
    {
      "id": "8b1cd581-e420-4b30-b025-86ab09765f1e",
      "text": "Người làm cho đàn bà son sẻ",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:31.808Z",
      "updatedAt": "2025-09-03T02:36:31.808Z",
      "chapterId": "dde02604-64de-4b5d-b9e4-8466bb51a444"
    },
    {
      "id": "f394d90c-6798-407a-a8f8-64067da98176",
      "text": "thành mẹ đông con, vui cửa vui nhà.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:31.837Z",
      "updatedAt": "2025-09-03T02:36:31.837Z",
      "chapterId": "dde02604-64de-4b5d-b9e4-8466bb51a444"
    }
  ],
  "marks": [
    {
      "id": "f3963184-866b-4d74-a4a5-6338ff1b2a31",
      "content": "*Thánh thi* này là Tv đầu của một nhóm Tv gọi là *tiểu Ha-len* (Hallel = bài ca ngợi khen) gồm các Tv 113-118. Người Do-thái đọc hoặc hát những Tv này cách riêng trong ba lễ lớn : lễ Vượt Qua, lễ Ngũ Tuần và lễ Lều. Có thể chia thánh thi thành các phần sau đây : **1**) Cc. 1-3 ; **2**) Cc. 4-6 ; **3**) Cc. 7-9.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 35,
      "endOffset": 35,
      "createdAt": "2025-09-03T02:36:31.596Z",
      "updatedAt": "2025-09-03T02:36:31.596Z",
      "targetId": "61765b51-e733-4f67-ba40-ca09d4fa4751",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "dde02604-64de-4b5d-b9e4-8466bb51a444"
    },
    {
      "id": "d76b9b87-da25-4b3d-9ac6-cb5134f23c43",
      "content": "Tv 107,41; 1 Sm 2,8",
      "kind": "MARK_KIND_REFERENCE",
      "label": "1@",
      "sortOrder": 0,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:36:31.766Z",
      "updatedAt": "2025-09-03T02:36:31.766Z",
      "targetId": "3ccf2c75-3117-4c89-9caf-7336e7b34f05",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "dde02604-64de-4b5d-b9e4-8466bb51a444"
    },
    {
      "id": "c8854374-fe5b-4e6a-b863-6b9f21592295",
      "content": "Việc ca ngợi Thiên Chúa không có giới hạn về thời gian.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 29,
      "endOffset": 29,
      "createdAt": "2025-09-03T02:36:31.682Z",
      "updatedAt": "2025-09-03T02:36:31.682Z",
      "targetId": "6db8630c-5f19-4939-9c80-ece2e2005b7f",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "dde02604-64de-4b5d-b9e4-8466bb51a444"
    },
    {
      "id": "c9f8f462-cb06-48ab-b4e9-1e994be7e6a0",
      "content": "1 Sm 2,5",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 21,
      "endOffset": 21,
      "createdAt": "2025-09-03T02:36:31.822Z",
      "updatedAt": "2025-09-03T02:36:31.822Z",
      "targetId": "8b1cd581-e420-4b30-b025-86ab09765f1e",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "dde02604-64de-4b5d-b9e4-8466bb51a444"
    },
    {
      "id": "ef621a43-bcd3-4ef5-8961-99fec53641c3",
      "content": "Người phụ nữ son sẻ bị khinh chê. Khi giúp cho người phụ nữ trở thành *mẹ đông con*, Thiên Chúa đem lại cho người ấy niềm vui và sự hãnh diện.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 34,
      "endOffset": 34,
      "createdAt": "2025-09-03T02:36:31.851Z",
      "updatedAt": "2025-09-03T02:36:31.851Z",
      "targetId": "f394d90c-6798-407a-a8f8-64067da98176",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "dde02604-64de-4b5d-b9e4-8466bb51a444"
    }
  ],
