{
  "chapter": {
    "id": "550dfa26-894c-471b-a818-74bc77435b80",
    "number": 114,
    "createdAt": "2025-09-03T01:07:51.662Z",
    "updatedAt": "2025-09-03T01:07:51.662Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "7db7703f-0b05-489f-9f31-1943e9023179",
      "text": "Ha-lê-lui-a.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:38.701Z",
      "updatedAt": "2025-09-03T02:36:38.701Z",
      "chapterId": "550dfa26-894c-471b-a818-74bc77435b80"
    },
    {
      "id": "2e4c90b8-1906-4145-b717-f2d2ca41580c",
      "text": "Thuở Ít-ra-en ra khỏi Ai-cập,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:38.780Z",
      "updatedAt": "2025-09-03T02:36:38.780Z",
      "chapterId": "550dfa26-894c-471b-a818-74bc77435b80"
    },
    {
      "id": "ddf0f44e-cf0f-4113-80d5-bd3081a8eb81",
      "text": "thuở nhà Gia-cóp rời bỏ ngoại bang,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:38.821Z",
      "updatedAt": "2025-09-03T02:36:38.821Z",
      "chapterId": "550dfa26-894c-471b-a818-74bc77435b80"
    },
    {
      "id": "54a53288-4949-45ef-a97c-38368d9867b1",
      "text": "thì Giu-đa trở thành nơi Chúa ngự,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:38.849Z",
      "updatedAt": "2025-09-03T02:36:38.849Z",
      "chapterId": "550dfa26-894c-471b-a818-74bc77435b80"
    },
    {
      "id": "dab835e2-4cae-4707-b983-a4df2982ec7d",
      "text": "Ít-ra-en nên lãnh địa của Người.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:38.879Z",
      "updatedAt": "2025-09-03T02:36:38.879Z",
      "chapterId": "550dfa26-894c-471b-a818-74bc77435b80"
    },
    {
      "id": "65af44fc-72e2-40e3-834f-6b5d40725510",
      "text": "Vừa thấy thế, biển liền trốn chạy,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:38.917Z",
      "updatedAt": "2025-09-03T02:36:38.917Z",
      "chapterId": "550dfa26-894c-471b-a818-74bc77435b80"
    },
    {
      "id": "d170e960-7413-459a-9804-82f090519191",
      "text": "sông Gio-đan cũng chảy ngược dòng.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:38.929Z",
      "updatedAt": "2025-09-03T02:36:38.929Z",
      "chapterId": "550dfa26-894c-471b-a818-74bc77435b80"
    },
    {
      "id": "7069f4e4-a160-4590-aceb-00cedb05cf68",
      "text": "Ví tựa bầy chiên, núi đồi nhảy nhót,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:38.952Z",
      "updatedAt": "2025-09-03T02:36:38.952Z",
      "chapterId": "550dfa26-894c-471b-a818-74bc77435b80"
    },
    {
      "id": "a37897bf-a385-4fcb-8a96-50cda5392a9f",
      "text": "như thể đàn cừu, gò nổng tung tăng.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:38.978Z",
      "updatedAt": "2025-09-03T02:36:38.978Z",
      "chapterId": "550dfa26-894c-471b-a818-74bc77435b80"
    },
    {
      "id": "06f0294a-7906-4015-a58c-038d9bb4eca9",
      "text": "Biển kia ơi, việc gì mà trốn chạy ?",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:38.991Z",
      "updatedAt": "2025-09-03T02:36:38.991Z",
      "chapterId": "550dfa26-894c-471b-a818-74bc77435b80"
    },
    {
      "id": "dc7a0a7d-9c7a-45ff-adf4-322f95d66e9e",
      "text": "Gio-đan hỡi, cớ chi chảy ngược dòng ?",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:39.004Z",
      "updatedAt": "2025-09-03T02:36:39.004Z",
      "chapterId": "550dfa26-894c-471b-a818-74bc77435b80"
    },
    {
      "id": "ff29e1d9-97ac-450e-b727-d42f2f854442",
      "text": "Kìa núi đồi, sao nhảy nhót ví tựa bầy chiên ?",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:39.032Z",
      "updatedAt": "2025-09-03T02:36:39.032Z",
      "chapterId": "550dfa26-894c-471b-a818-74bc77435b80"
    },
    {
      "id": "eb474a55-c804-454a-8981-c0e9829a9db4",
      "text": "Này gò nổng, sao tung tăng như thể đàn cừu ?",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:39.046Z",
      "updatedAt": "2025-09-03T02:36:39.046Z",
      "chapterId": "550dfa26-894c-471b-a818-74bc77435b80"
    },
    {
      "id": "c1bb8717-cae2-487a-81e3-89b53e12f3da",
      "text": "Trước thánh nhan Chúa, hỡi địa cầu, hãy rung chuyển,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:39.060Z",
      "updatedAt": "2025-09-03T02:36:39.060Z",
      "chapterId": "550dfa26-894c-471b-a818-74bc77435b80"
    },
    {
      "id": "358ae4b5-31d9-4916-9926-fb8e6d5d715e",
      "text": "trước thánh nhan Chúa Trời nhà Gia-cóp,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:39.077Z",
      "updatedAt": "2025-09-03T02:36:39.077Z",
      "chapterId": "550dfa26-894c-471b-a818-74bc77435b80"
    },
    {
      "id": "50ada310-2d73-4d6f-a52b-87bbb9cfd329",
      "text": "Người biến đá tảng thành hồ ao,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:39.106Z",
      "updatedAt": "2025-09-03T02:36:39.106Z",
      "chapterId": "550dfa26-894c-471b-a818-74bc77435b80"
    },
    {
      "id": "fd0305db-6d25-43e0-900c-6f6a12e689a5",
      "text": "và sỏi đá nên mạch nước dồi dào.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:39.134Z",
      "updatedAt": "2025-09-03T02:36:39.134Z",
      "chapterId": "550dfa26-894c-471b-a818-74bc77435b80"
    }
  ],
