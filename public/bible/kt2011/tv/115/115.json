{
  "chapter": {
    "id": "34ebe1a5-7511-45c4-ad59-371e7a267f6f",
    "number": 115,
    "createdAt": "2025-09-03T01:07:51.662Z",
    "updatedAt": "2025-09-03T01:07:51.662Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "bf860f39-2d8e-4845-af21-91d879da52c6",
      "text": "Xin đừng làm rạng rỡ chúng con, vâng lạy CHÚA, xin đừng,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:45.462Z",
      "updatedAt": "2025-09-03T02:36:45.462Z",
      "chapterId": "34ebe1a5-7511-45c4-ad59-371e7a267f6f"
    },
    {
      "id": "fc267a66-4016-4d1a-a43e-db3030cdcd29",
      "text": "nhưng xin cho danh Ngài rạng rỡ,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:45.519Z",
      "updatedAt": "2025-09-03T02:36:45.519Z",
      "chapterId": "34ebe1a5-7511-45c4-ad59-371e7a267f6f"
    },
    {
      "id": "61f08cc5-f511-4d39-9f66-9c1151a6db97",
      "text": "bởi vì Ngài thành tín yêu thương.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:45.542Z",
      "updatedAt": "2025-09-03T02:36:45.542Z",
      "chapterId": "34ebe1a5-7511-45c4-ad59-371e7a267f6f"
    },
    {
      "id": "893a7b11-5803-4cc7-a137-27fbe8f45e6a",
      "text": "Sao chư dân lại nói : “Thiên Chúa chúng ở đâu ?”",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:45.558Z",
      "updatedAt": "2025-09-03T02:36:45.558Z",
      "chapterId": "34ebe1a5-7511-45c4-ad59-371e7a267f6f"
    },
    {
      "id": "bb7abd59-0b7d-4a37-af09-ab1db49e6b66",
      "text": "Thiên Chúa chúng ta ở trên trời,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:45.568Z",
      "updatedAt": "2025-09-03T02:36:45.568Z",
      "chapterId": "34ebe1a5-7511-45c4-ad59-371e7a267f6f"
    },
    {
      "id": "ddcb84cd-c5a0-46a1-aa20-3f323fc845b6",
      "text": "muốn làm gì là Chúa làm nên.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:45.585Z",
      "updatedAt": "2025-09-03T02:36:45.585Z",
      "chapterId": "34ebe1a5-7511-45c4-ad59-371e7a267f6f"
    },
    {
      "id": "1448f5ba-4f5b-4b1c-8b62-20204c7f5c58",
      "text": "Tượng thần chúng chỉ là vàng bạc,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:45.595Z",
      "updatedAt": "2025-09-03T02:36:45.595Z",
      "chapterId": "34ebe1a5-7511-45c4-ad59-371e7a267f6f"
    },
    {
      "id": "583f9557-56f1-44bf-b690-ef4ab68f8726",
      "text": "chỉ do tay người thế tạo thành.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:45.619Z",
      "updatedAt": "2025-09-03T02:36:45.619Z",
      "chapterId": "34ebe1a5-7511-45c4-ad59-371e7a267f6f"
    },
    {
      "id": "97dd498a-a8f6-4eaa-8a4d-64074d263147",
      "text": "Có mắt có miệng, không nhìn không nói,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:45.629Z",
      "updatedAt": "2025-09-03T02:36:45.629Z",
      "chapterId": "34ebe1a5-7511-45c4-ad59-371e7a267f6f"
    },
    {
      "id": "b2f33bd2-f4e0-4a62-90a6-869c0ba1fe3e",
      "text": "có mũi có tai, không ngửi không nghe.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:45.653Z",
      "updatedAt": "2025-09-03T02:36:45.653Z",
      "chapterId": "34ebe1a5-7511-45c4-ad59-371e7a267f6f"
    },
    {
      "id": "8cc88b82-2d74-4fa9-8db1-5edf65bdeb2c",
      "text": "Có hai tay, không sờ không mó",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:45.664Z",
      "updatedAt": "2025-09-03T02:36:45.664Z",
      "chapterId": "34ebe1a5-7511-45c4-ad59-371e7a267f6f"
    },
    {
      "id": "385f5100-d364-47a3-9c69-caad99705943",
      "text": "có hai chân, không bước không đi,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:45.674Z",
      "updatedAt": "2025-09-03T02:36:45.674Z",
      "chapterId": "34ebe1a5-7511-45c4-ad59-371e7a267f6f"
    },
    {
      "id": "b46cf6e7-3f9a-41d1-851c-e88c015b7d00",
      "text": "từ cổ họng, không thốt ra một tiếng.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:45.684Z",
      "updatedAt": "2025-09-03T02:36:45.684Z",
      "chapterId": "34ebe1a5-7511-45c4-ad59-371e7a267f6f"
    },
    {
      "id": "af5e03ec-00df-4604-a231-c634026577d9",
      "text": "Ước gì kẻ làm ra hoặc tin ở tượng thần",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:45.695Z",
      "updatedAt": "2025-09-03T02:36:45.695Z",
      "chapterId": "34ebe1a5-7511-45c4-ad59-371e7a267f6f"
    },
    {
      "id": "2ea5898e-9665-44e3-a6ca-8fbe39a911b6",
      "text": "cũng giống như chúng vậy.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:45.717Z",
      "updatedAt": "2025-09-03T02:36:45.717Z",
      "chapterId": "34ebe1a5-7511-45c4-ad59-371e7a267f6f"
    },
    {
      "id": "4b725702-5fee-4b32-80e0-6f44e354cc92",
      "text": "Nhà Ít-ra-en, hãy tin cậy CHÚA,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:45.729Z",
      "updatedAt": "2025-09-03T02:36:45.729Z",
      "chapterId": "34ebe1a5-7511-45c4-ad59-371e7a267f6f"
    },
    {
      "id": "8b7c3b9a-2e1c-46b6-9062-ef9c33435bc7",
      "text": "chính Chúa độ trì, làm thuẫn đỡ khiên che.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:45.770Z",
      "updatedAt": "2025-09-03T02:36:45.770Z",
      "chapterId": "34ebe1a5-7511-45c4-ad59-371e7a267f6f"
    },
    {
      "id": "31724afb-3dad-4bcd-a27b-91c1580b53e7",
      "text": "Nhà A-ha-ron, hãy tin cậy CHÚA,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:45.788Z",
      "updatedAt": "2025-09-03T02:36:45.788Z",
      "chapterId": "34ebe1a5-7511-45c4-ad59-371e7a267f6f"
    },
    {
      "id": "5f887d87-3d3b-4610-a06f-da77ace57b8a",
      "text": "chính Chúa độ trì, làm thuẫn đỡ khiên che.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:45.816Z",
      "updatedAt": "2025-09-03T02:36:45.816Z",
      "chapterId": "34ebe1a5-7511-45c4-ad59-371e7a267f6f"
    },
    {
      "id": "4bc7738e-424a-4c1e-ad0a-cc805ac210c6",
      "text": "Ai kính sợ CHÚA, hãy tin cậy CHÚA,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:45.830Z",
      "updatedAt": "2025-09-03T02:36:45.830Z",
      "chapterId": "34ebe1a5-7511-45c4-ad59-371e7a267f6f"
    },
    {
      "id": "8adadaad-e860-428b-a0a9-98fa09bae24a",
      "text": "chính Chúa độ trì, làm thuẫn đỡ khiên che.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:45.843Z",
      "updatedAt": "2025-09-03T02:36:45.843Z",
      "chapterId": "34ebe1a5-7511-45c4-ad59-371e7a267f6f"
    },
    {
      "id": "bdf9346e-6cb2-4db4-b6d0-0ed374416ac2",
      "text": "CHÚA nhớ đến ta và sẽ ban phúc cả :",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:45.857Z",
      "updatedAt": "2025-09-03T02:36:45.857Z",
      "chapterId": "34ebe1a5-7511-45c4-ad59-371e7a267f6f"
    },
    {
      "id": "67f63565-7222-4153-b5bb-af3031fdcc58",
      "text": "sẽ ban phúc cho nhà Ít-ra-en,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:45.871Z",
      "updatedAt": "2025-09-03T02:36:45.871Z",
      "chapterId": "34ebe1a5-7511-45c4-ad59-371e7a267f6f"
    },
    {
      "id": "068173da-e4b2-4f4b-bf0d-4acc895c57b8",
      "text": "sẽ ban phúc cho nhà A-ha-ron,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:45.899Z",
      "updatedAt": "2025-09-03T02:36:45.899Z",
      "chapterId": "34ebe1a5-7511-45c4-ad59-371e7a267f6f"
    },
    {
      "id": "74e6423a-d81d-4537-a18b-2f10412a2f96",
      "text": "sẽ ban phúc cho người kính sợ CHÚA,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:45.924Z",
      "updatedAt": "2025-09-03T02:36:45.924Z",
      "chapterId": "34ebe1a5-7511-45c4-ad59-371e7a267f6f"
    },
    {
      "id": "3c2ed099-7d75-4327-9289-8b0d79e2287e",
      "text": "cho người lớn cũng như kẻ nhỏ.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:45.936Z",
      "updatedAt": "2025-09-03T02:36:45.936Z",
      "chapterId": "34ebe1a5-7511-45c4-ad59-371e7a267f6f"
    },
    {
      "id": "56f91fa3-a921-461b-928c-188ade3d5b57",
      "text": "Nguyện xin CHÚA rộng rãi thi ân",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:45.948Z",
      "updatedAt": "2025-09-03T02:36:45.948Z",
      "chapterId": "34ebe1a5-7511-45c4-ad59-371e7a267f6f"
    },
    {
      "id": "461e34ba-2fc7-4a39-93cb-9ed6c66de0bd",
      "text": "cho anh em và cho con cháu.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:45.961Z",
      "updatedAt": "2025-09-03T02:36:45.961Z",
      "chapterId": "34ebe1a5-7511-45c4-ad59-371e7a267f6f"
    },
    {
      "id": "3f11aa16-a337-47fd-b9fc-e700ffdaada3",
      "text": "Nguyện xin CHÚA, Đấng dựng nên đất trời,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:45.974Z",
      "updatedAt": "2025-09-03T02:36:45.974Z",
      "chapterId": "34ebe1a5-7511-45c4-ad59-371e7a267f6f"
    },
    {
      "id": "e5840724-17cb-4fa0-bb4b-0bceefd9e005",
      "text": "xuống muôn phúc lành cho anh em.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:45.986Z",
      "updatedAt": "2025-09-03T02:36:45.986Z",
      "chapterId": "34ebe1a5-7511-45c4-ad59-371e7a267f6f"
    },
    {
      "id": "501dbec7-8fa3-480c-adbd-328fa9a7bd53",
      "text": "Trời là trời của CHÚA,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:45.998Z",
      "updatedAt": "2025-09-03T02:36:45.998Z",
      "chapterId": "34ebe1a5-7511-45c4-ad59-371e7a267f6f"
    },
    {
      "id": "cc678846-5101-44e6-bc92-d54a13608da4",
      "text": "còn đất thì Chúa cho con cái loài người.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:46.009Z",
      "updatedAt": "2025-09-03T02:36:46.009Z",
      "chapterId": "34ebe1a5-7511-45c4-ad59-371e7a267f6f"
    },
    {
      "id": "176ad3fd-34d8-477b-a042-315da5244849",
      "text": "Không phải người đã chết,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:46.020Z",
      "updatedAt": "2025-09-03T02:36:46.020Z",
      "chapterId": "34ebe1a5-7511-45c4-ad59-371e7a267f6f"
    },
    {
      "id": "8d7d6277-71da-49b3-bdcb-d5e9b1d57f86",
      "text": "hay mọi kẻ bước vào",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:46.042Z",
      "updatedAt": "2025-09-03T02:36:46.042Z",
      "chapterId": "34ebe1a5-7511-45c4-ad59-371e7a267f6f"
    },
    {
      "id": "9d2a7a05-f5d1-4463-af0c-912716642ff8",
      "text": "cõi thinh lặng ngàn thu",
      "label": "17",
      "number": 17,
      "subVerseIndex": 2,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:46.054Z",
      "updatedAt": "2025-09-03T02:36:46.054Z",
      "chapterId": "34ebe1a5-7511-45c4-ad59-371e7a267f6f"
    },
    {
      "id": "4850afc0-cd34-4991-8337-2f6b219dd6cd",
      "text": "sẽ ca tụng ĐỨC CHÚA ;",
      "label": "17",
      "number": 17,
      "subVerseIndex": 3,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:46.067Z",
      "updatedAt": "2025-09-03T02:36:46.067Z",
      "chapterId": "34ebe1a5-7511-45c4-ad59-371e7a267f6f"
    },
    {
      "id": "1f65a479-c028-494d-b39c-d057a9d43862",
      "text": "nhưng là chính chúng ta,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:46.095Z",
      "updatedAt": "2025-09-03T02:36:46.095Z",
      "chapterId": "34ebe1a5-7511-45c4-ad59-371e7a267f6f"
    },
    {
      "id": "e4fe1227-cc5c-4189-9028-2f5ceba50911",
      "text": "những người còn đang sống,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:46.109Z",
      "updatedAt": "2025-09-03T02:36:46.109Z",
      "chapterId": "34ebe1a5-7511-45c4-ad59-371e7a267f6f"
    },
    {
      "id": "22d4c475-cf74-4035-a37d-1f98033ec424",
      "text": "chúng ta chúc tụng CHÚA",
      "label": "18",
      "number": 18,
      "subVerseIndex": 2,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:46.123Z",
      "updatedAt": "2025-09-03T02:36:46.123Z",
