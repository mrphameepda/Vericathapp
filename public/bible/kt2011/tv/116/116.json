{
  "chapter": {
    "id": "c1325a92-9978-4bda-9236-6f4bb7bc24b9",
    "number": 116,
    "createdAt": "2025-09-03T01:07:51.662Z",
    "updatedAt": "2025-09-03T01:07:51.662Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "257b6924-12a0-411a-846e-61c0df58550a",
      "text": "Lòng tôi yêu mến Chúa, vì CHÚA đã nghe tiếng tôi khẩn nài,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:51.598Z",
      "updatedAt": "2025-09-03T02:36:51.598Z",
      "chapterId": "c1325a92-9978-4bda-9236-6f4bb7bc24b9"
    },
    {
      "id": "553a1573-03fd-417e-97ef-c2c082427b27",
      "text": "Người lại lắng tai ngày tôi kêu cứu.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:51.640Z",
      "updatedAt": "2025-09-03T02:36:51.640Z",
      "chapterId": "c1325a92-9978-4bda-9236-6f4bb7bc24b9"
    },
    {
      "id": "ea00e062-6149-4393-95a9-eafe7c224533",
      "text": "Dây tử thần đã bủa vây tôi chằng chịt,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:51.651Z",
      "updatedAt": "2025-09-03T02:36:51.651Z",
      "chapterId": "c1325a92-9978-4bda-9236-6f4bb7bc24b9"
    },
    {
      "id": "814efb9d-1e9b-4219-a699-d12c3aefe809",
      "text": "lưới âm ty chụp xuống trên mình.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:51.662Z",
      "updatedAt": "2025-09-03T02:36:51.662Z",
      "chapterId": "c1325a92-9978-4bda-9236-6f4bb7bc24b9"
    },
    {
      "id": "c8768e8e-5022-4447-9a4d-b5b70280bc58",
      "text": "Gặp gian truân sầu khổ, tôi đã kêu cầu danh CHÚA :",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:51.675Z",
      "updatedAt": "2025-09-03T02:36:51.675Z",
      "chapterId": "c1325a92-9978-4bda-9236-6f4bb7bc24b9"
    },
    {
      "id": "9d8cceca-3907-424c-86f2-0b9470802061",
      "text": "“Ôi lạy CHÚA, xin cứu gỡ mạng con !”",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:51.706Z",
      "updatedAt": "2025-09-03T02:36:51.706Z",
      "chapterId": "c1325a92-9978-4bda-9236-6f4bb7bc24b9"
    },
    {
      "id": "d4cbc7e3-3a88-4fbf-b22f-55bf0b139bb8",
      "text": "CHÚA là Đấng nhân từ chính trực,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:51.720Z",
      "updatedAt": "2025-09-03T02:36:51.720Z",
      "chapterId": "c1325a92-9978-4bda-9236-6f4bb7bc24b9"
    },
    {
      "id": "9fdce215-12df-42ed-96b9-08ed628cda48",
      "text": "Thiên Chúa chúng ta một dạ xót thương,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:51.734Z",
      "updatedAt": "2025-09-03T02:36:51.734Z",
      "chapterId": "c1325a92-9978-4bda-9236-6f4bb7bc24b9"
    },
    {
      "id": "3abf46e1-65f4-4413-9879-66bcfd48390c",
      "text": "hằng gìn giữ những ai bé mọn,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:51.748Z",
      "updatedAt": "2025-09-03T02:36:51.748Z",
      "chapterId": "c1325a92-9978-4bda-9236-6f4bb7bc24b9"
    },
    {
      "id": "eee2fb35-c74c-4141-b2e8-b9e8e619f157",
      "text": "tôi yếu đuối, Người đã cứu tôi.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:51.763Z",
      "updatedAt": "2025-09-03T02:36:51.763Z",
      "chapterId": "c1325a92-9978-4bda-9236-6f4bb7bc24b9"
    },
    {
      "id": "c01b2810-db30-458b-883b-11b7ed3609da",
      "text": "Hồn tôi hỡi, thôi bình tĩnh lại,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:51.777Z",
      "updatedAt": "2025-09-03T02:36:51.777Z",
      "chapterId": "c1325a92-9978-4bda-9236-6f4bb7bc24b9"
    },
    {
      "id": "0cdb813b-90bf-4821-8554-32c1225fd491",
      "text": "vì trên ngươi, CHÚA đã xuống ơn lành ;",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:51.790Z",
      "updatedAt": "2025-09-03T02:36:51.790Z",
      "chapterId": "c1325a92-9978-4bda-9236-6f4bb7bc24b9"
    },
    {
      "id": "6ac90c7e-ff1e-4575-b189-f902fd3c6450",
      "text": "Chúa cứu gỡ mạng tôi khỏi chết,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:51.804Z",
      "updatedAt": "2025-09-03T02:36:51.804Z",
      "chapterId": "c1325a92-9978-4bda-9236-6f4bb7bc24b9"
    },
    {
      "id": "4b2d2981-055a-4dc4-9e42-5a80ef64f8f9",
      "text": "giữ mắt này chẳng còn đẫm lệ,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:51.832Z",
      "updatedAt": "2025-09-03T02:36:51.832Z",
      "chapterId": "c1325a92-9978-4bda-9236-6f4bb7bc24b9"
    },
    {
      "id": "b20c7231-77c6-43b2-a4e1-59a02bfdc997",
      "text": "ngăn ngừa tôi khỏi phải hụt chân.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:51.846Z",
      "updatedAt": "2025-09-03T02:36:51.846Z",
      "chapterId": "c1325a92-9978-4bda-9236-6f4bb7bc24b9"
    },
    {
      "id": "aebdaa4a-6ba5-41dd-a54c-10f8389df6be",
      "text": "Tôi sẽ bước đi trước mặt Người",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:51.860Z",
      "updatedAt": "2025-09-03T02:36:51.860Z",
      "chapterId": "c1325a92-9978-4bda-9236-6f4bb7bc24b9"
    },
    {
      "id": "bd531e24-8716-4fa7-9b30-23917c768c39",
      "text": "trong cõi đất dành cho kẻ sống.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:51.873Z",
      "updatedAt": "2025-09-03T02:36:51.873Z",
      "chapterId": "c1325a92-9978-4bda-9236-6f4bb7bc24b9"
    },
    {
      "id": "b1a3c1b5-7c86-4973-8e6f-0a4d7c1876b6",
      "text": "Tôi đã tin cả khi mình đã nói : “Ôi nhục nhã ê chề !”",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:51.888Z",
      "updatedAt": "2025-09-03T02:36:51.888Z",
      "chapterId": "c1325a92-9978-4bda-9236-6f4bb7bc24b9"
    },
    {
      "id": "4b266791-1077-40cd-94bc-1d3bd7cd1f91",
      "text": "Đã thốt ra trong cơn hốt hoảng : “Mọi người đều giả dối !”",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:51.902Z",
      "updatedAt": "2025-09-03T02:36:51.902Z",
      "chapterId": "c1325a92-9978-4bda-9236-6f4bb7bc24b9"
    },
    {
      "id": "b0591748-7f96-4b52-b1a7-fd15c950ab94",
      "text": "Biết lấy chi đền đáp CHÚA bây giờ",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:51.916Z",
      "updatedAt": "2025-09-03T02:36:51.916Z",
      "chapterId": "c1325a92-9978-4bda-9236-6f4bb7bc24b9"
    },
    {
      "id": "005ea975-5e6a-4e25-80e1-4c5604faa556",
      "text": "vì mọi ơn lành Người đã ban cho ?",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:51.930Z",
      "updatedAt": "2025-09-03T02:36:51.930Z",
      "chapterId": "c1325a92-9978-4bda-9236-6f4bb7bc24b9"
    },
    {
      "id": "53df3038-bc81-4889-a95c-1bbea924ba6c",
      "text": "Tôi xin nâng chén mừng ơn cứu độ",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:51.941Z",
      "updatedAt": "2025-09-03T02:36:51.941Z",
      "chapterId": "c1325a92-9978-4bda-9236-6f4bb7bc24b9"
    },
    {
      "id": "2467cd86-a7bb-4412-83be-c74a291866f0",
      "text": "và kêu cầu thánh danh ĐỨC CHÚA.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:51.953Z",
      "updatedAt": "2025-09-03T02:36:51.953Z",
      "chapterId": "c1325a92-9978-4bda-9236-6f4bb7bc24b9"
    },
    {
      "id": "397dbdca-ed08-4d52-9b47-22ee97614c90",
      "text": "Lời khấn nguyền với CHÚA, tôi xin giữ trọn,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:51.979Z",
      "updatedAt": "2025-09-03T02:36:51.979Z",
      "chapterId": "c1325a92-9978-4bda-9236-6f4bb7bc24b9"
    },
    {
      "id": "4ced0277-802b-4aaa-b536-a868773e29ed",
      "text": "trước toàn thể dân Người.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:51.992Z",
      "updatedAt": "2025-09-03T02:36:51.992Z",
      "chapterId": "c1325a92-9978-4bda-9236-6f4bb7bc24b9"
    },
    {
      "id": "e11b2d37-a98d-4915-b635-3004486a8229",
      "text": "Đối với CHÚA thật là đắt giá",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:52.006Z",
      "updatedAt": "2025-09-03T02:36:52.006Z",
      "chapterId": "c1325a92-9978-4bda-9236-6f4bb7bc24b9"
    },
    {
      "id": "0c7f25ef-d469-455e-93d7-1346eabcae70",
      "text": "cái chết của những ai trung hiếu với Người.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:52.020Z",
      "updatedAt": "2025-09-03T02:36:52.020Z",
      "chapterId": "c1325a92-9978-4bda-9236-6f4bb7bc24b9"
    },
    {
      "id": "5e6c075c-41c5-4d2b-b4d3-c2b33709a368",
      "text": "Vâng lạy CHÚA, thân này là tôi tớ,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:52.034Z",
      "updatedAt": "2025-09-03T02:36:52.034Z",
      "chapterId": "c1325a92-9978-4bda-9236-6f4bb7bc24b9"
    },
    {
      "id": "74d9f202-674c-4fef-8344-b242613203e7",
      "text": "tôi tớ Ngài, con của nữ tỳ Ngài,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:52.047Z",
      "updatedAt": "2025-09-03T02:36:52.047Z",
      "chapterId": "c1325a92-9978-4bda-9236-6f4bb7bc24b9"
    },
    {
      "id": "c2b430cf-c6cc-415f-bdc1-2f2d24b1eca7",
      "text": "xiềng xích trói buộc con, Ngài đã tháo cởi.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 2,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:52.082Z",
      "updatedAt": "2025-09-03T02:36:52.082Z",
      "chapterId": "c1325a92-9978-4bda-9236-6f4bb7bc24b9"
    },
    {
      "id": "47e324f7-f63e-4915-887e-f514027d0c07",
      "text": "Con sẽ dâng lễ tế tạ ơn, và kêu cầu thánh danh ĐỨC CHÚA.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:52.093Z",
      "updatedAt": "2025-09-03T02:36:52.093Z",
      "chapterId": "c1325a92-9978-4bda-9236-6f4bb7bc24b9"
    },
    {
      "id": "dc9c6d6b-c90f-428c-887d-cb8511825dd0",
      "text": "Lời khấn nguyền với CHÚA, tôi xin giữ trọn,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:52.120Z",
      "updatedAt": "2025-09-03T02:36:52.120Z",
      "chapterId": "c1325a92-9978-4bda-9236-6f4bb7bc24b9"
    },
    {
      "id": "2717aa1d-879e-448e-ac08-781483b0203b",
      "text": "trước toàn thể dân Người,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:52.134Z",
      "updatedAt": "2025-09-03T02:36:52.134Z",
      "chapterId": "c1325a92-9978-4bda-9236-6f4bb7bc24b9"
    },
    {
      "id": "059573c4-21c6-4505-9eb5-5ae12bd58e86",
      "text": "tại khuôn viên đền CHÚA, giữa lòng ngươi, hỡi Giê-ru-sa-lem !",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:52.148Z",
      "updatedAt": "2025-09-03T02:36:52.148Z",
      "chapterId": "c1325a92-9978-4bda-9236-6f4bb7bc24b9"
    },
    {
      "id": "853d0dfa-e758-459b-8dbe-a69af7461e00",
      "text": "Ha-lê-lui-a.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:52.176Z",
      "updatedAt": "2025-09-03T02:36:52.176Z",
      "chapterId": "c1325a92-9978-4bda-9236-6f4bb7bc24b9"
    }
  ],
  "marks": [
    {
      "id": "caa5ddea-880e-4aae-b4b9-53bd87c4c1fd",
      "content": "Trong *Tv tạ ơn này của cá nhân*, tác giả cảm tạ Đức Chúa đã thương cứu mình khỏi một hiểm hoạ có thể dẫn tới cái chết (cc. 3-4). Phần sau đó nói về lời khấn nguyền với Đức Chúa : tác giả hứa sẽ dâng lễ tế tạ ơn trong Đền Thờ (cc. 14.17-19). Có thể chia Tv 116 như sau : **1**) Cc. 1-2 ; **2**) Cc. 3-6 ; **3**) Cc. 7-9 ; **4**) Cc. 10-15 ; **5**) Cc. 16-17 ; **6**) Cc. 18-19.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 31,
      "endOffset": 31,
      "createdAt": "2025-09-03T02:36:51.629Z",
      "updatedAt": "2025-09-03T02:36:51.629Z",
      "targetId": "6246a51c-453b-41e8-9f37-ccce01dab7c7",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "c1325a92-9978-4bda-9236-6f4bb7bc24b9"
    },
    {
      "id": "5b03dd49-6867-445c-a25a-2ab8cdac1ddd",
      "content": "Ge 3,5",
      "kind": "MARK_KIND_REFERENCE",
      "label": "1@",
      "sortOrder": 0,
      "startOffset": 31,
