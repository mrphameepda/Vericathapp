  "verses": [
    {
      "id": "019b8830-e3e7-4398-a4af-6f548de48479",
      "text": "Muôn nước hỡi, nào ca ngợi CHÚA,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:56.939Z",
      "updatedAt": "2025-09-03T02:36:56.939Z",
      "chapterId": "5afb7144-c169-4503-a424-03f27035cde1"
    },
    {
      "id": "805924fa-0042-4f0d-a663-eb3cbac5be62",
      "text": "ngàn dân ơi, hãy chúc tụng Người !",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:56.990Z",
      "updatedAt": "2025-09-03T02:36:56.990Z",
      "chapterId": "5afb7144-c169-4503-a424-03f27035cde1"
    },
    {
      "id": "0cb67eda-1a69-4382-8a30-e81b1dd55e74",
      "text": "Vì tình Chúa thương ta thật là mãnh liệt,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:57.003Z",
      "updatedAt": "2025-09-03T02:36:57.003Z",
      "chapterId": "5afb7144-c169-4503-a424-03f27035cde1"
    },
    {
      "id": "70a888bb-b76c-4a1a-a8bb-dac60166d26f",
      "text": "lòng thành tín của Người bền vững muôn năm. Ha-lê-lui-a.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:36:57.017Z",
      "updatedAt": "2025-09-03T02:36:57.017Z",
      "chapterId": "5afb7144-c169-4503-a424-03f27035cde1"
    }
  ],
