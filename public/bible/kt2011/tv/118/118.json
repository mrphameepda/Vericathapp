{
  "chapter": {
    "id": "c5fade64-7adb-4258-96af-b2d72b8d894c",
    "number": 118,
    "createdAt": "2025-09-03T01:07:51.662Z",
    "updatedAt": "2025-09-03T01:07:51.662Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "8e6ffba4-07e6-4b9a-8ac9-37cce7e1e317",
      "text": "Hãy tạ ơn CHÚA vì Chúa nhân từ,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:02.486Z",
      "updatedAt": "2025-09-03T02:37:02.486Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "bf30fe9f-80a3-4f03-96a9-ab0676631e6b",
      "text": "muôn ngàn đời Chúa vẫn trọn tình thương.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:02.528Z",
      "updatedAt": "2025-09-03T02:37:02.528Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "da3faa15-ac49-4169-b31f-5da73a4270e4",
      "text": "Ít-ra-en hãy nói lên rằng :",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:02.538Z",
      "updatedAt": "2025-09-03T02:37:02.538Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "686a5adf-296f-4043-96dc-951ce4663179",
      "text": "muôn ngàn đời Chúa vẫn trọn tình thương.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:02.571Z",
      "updatedAt": "2025-09-03T02:37:02.571Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "e5f9f17a-a8d3-4a32-9709-bd477c069a29",
      "text": "Nhà A-ha-ron hãy nói lên rằng :",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:02.582Z",
      "updatedAt": "2025-09-03T02:37:02.582Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "763285d1-fbf1-4059-92f6-ef9b5fbde08b",
      "text": "muôn ngàn đời Chúa vẫn trọn tình thương.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:02.607Z",
      "updatedAt": "2025-09-03T02:37:02.607Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "67d3b607-6219-40ad-9cee-434fb920ec17",
      "text": "Ai kính sợ CHÚA hãy nói lên rằng :",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:02.621Z",
      "updatedAt": "2025-09-03T02:37:02.621Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "5ec3e985-3c20-452c-98f1-545d50f01183",
      "text": "muôn ngàn đời Chúa vẫn trọn tình thương.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:02.636Z",
      "updatedAt": "2025-09-03T02:37:02.636Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "47e10be7-b6b9-4748-9ed4-f28d12b24f1d",
      "text": "Giữa cảnh gian truân, tôi đã kêu cầu CHÚA,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:02.650Z",
      "updatedAt": "2025-09-03T02:37:02.650Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "9029d840-bb4e-4348-875b-c3ce3b08f127",
      "text": "CHÚA đáp lời và giải thoát tôi.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:02.664Z",
      "updatedAt": "2025-09-03T02:37:02.664Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "24145578-9d3a-45c5-836c-a6df40e3912f",
      "text": "Có CHÚA ở cùng tôi, tôi chẳng sợ gì,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:02.678Z",
      "updatedAt": "2025-09-03T02:37:02.678Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "60a98580-3597-49c9-99b1-18066349837a",
      "text": "hỏi người đời làm chi tôi được ?",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:02.706Z",
      "updatedAt": "2025-09-03T02:37:02.706Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "730319da-544b-4514-99d9-bbfd177e716c",
      "text": "Có CHÚA ở cùng tôi mà bênh đỡ,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:02.720Z",
      "updatedAt": "2025-09-03T02:37:02.720Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "905707e9-92ac-4ac8-bc0d-9f43e6b586da",
      "text": "tôi dám nghênh lũ địch thù tôi.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:02.734Z",
      "updatedAt": "2025-09-03T02:37:02.734Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "96ec1e41-fe46-4851-adb0-89dea24a89fa",
      "text": "Ẩn thân bên cạnh CHÚA TRỜI,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:02.748Z",
      "updatedAt": "2025-09-03T02:37:02.748Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "0b4b84ee-2619-4a4e-8b4d-f4bd2d050f0f",
      "text": "thì hơn tin cậy ở người trần gian.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:02.763Z",
      "updatedAt": "2025-09-03T02:37:02.763Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "ec6c02be-3364-4b31-8579-576aadbd1daf",
      "text": "Cậy vào thần thế vua quan,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:02.777Z",
      "updatedAt": "2025-09-03T02:37:02.777Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "4e8b6cc5-7d7c-4c44-8f7b-d7e2b63bcc4e",
      "text": "chẳng bằng ẩn náu ở bên CHÚA TRỜI.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:02.790Z",
      "updatedAt": "2025-09-03T02:37:02.790Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "6118ee29-7d99-4096-afc8-ccb41903ef87",
      "text": "Chư dân xúm lại bủa vây tôi,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:02.804Z",
      "updatedAt": "2025-09-03T02:37:02.804Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "cf82938f-44f6-4b61-b0c1-35ca884087ff",
      "text": "nhờ danh CHÚA, tôi đã trừ diệt chúng.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:02.832Z",
      "updatedAt": "2025-09-03T02:37:02.832Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "0cdfe497-7d16-44ab-ab81-87672d73fd6f",
      "text": "Chúng bủa vây tôi, trùng điệp tư bề,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:02.846Z",
      "updatedAt": "2025-09-03T02:37:02.846Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "0f7f3288-44bd-4020-bd86-bddf221a1f0d",
      "text": "nhờ danh CHÚA, tôi đã trừ diệt chúng.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:02.859Z",
      "updatedAt": "2025-09-03T02:37:02.859Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "01c9706c-5145-4e3f-b9bc-178fa5eb2368",
      "text": "Chúng bủa vây tôi như thể bầy ong,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:02.873Z",
      "updatedAt": "2025-09-03T02:37:02.873Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "12f1b5eb-85c5-4c45-874d-7c22744f4f03",
      "text": "chúng như lửa bụi gai cháy bừng bừng,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:02.887Z",
      "updatedAt": "2025-09-03T02:37:02.887Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "1b3962f1-a33a-44db-8bce-b6b418559324",
      "text": "nhờ danh CHÚA, tôi đã trừ diệt chúng.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:02.900Z",
      "updatedAt": "2025-09-03T02:37:02.900Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "c8f73085-7d43-4a14-ae87-fcddccae2fd5",
      "text": "Chúng xô đẩy tôi, xô cho ngã,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:02.916Z",
      "updatedAt": "2025-09-03T02:37:02.916Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "a43ce8c7-b49e-416c-ba5d-6f97257baa29",
      "text": "nhưng CHÚA đã phù trợ thân này.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:02.929Z",
      "updatedAt": "2025-09-03T02:37:02.929Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "bd95ed76-d889-4e7b-8643-798d84126e57",
      "text": "CHÚA là sức mạnh tôi, là Đấng tôi ca ngợi,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:02.942Z",
      "updatedAt": "2025-09-03T02:37:02.942Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "a8c2a11d-ff22-49ab-b76d-8d9cb442c694",
      "text": "chính Người cứu độ tôi.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:02.965Z",
      "updatedAt": "2025-09-03T02:37:02.965Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "3ddbd930-2574-4051-9dbb-dc7d76fedb23",
      "text": "Kìa nghe tiếng reo mừng chiến thắng",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:02.977Z",
      "updatedAt": "2025-09-03T02:37:02.977Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "c727756d-ae86-424c-a1a7-bc71aab91af0",
      "text": "trong doanh trại chính nhân :",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:02.989Z",
      "updatedAt": "2025-09-03T02:37:02.989Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "81140d5c-31c0-4382-a0b1-804c1f166319",
      "text": "“Tay hữu CHÚA đã ra oai thần lực, tay hữu CHÚA giơ cao,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:03Z",
      "updatedAt": "2025-09-03T02:37:03Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "fa76e9d1-c64d-4568-a9be-88504a893dc5",
      "text": "tay hữu CHÚA đã ra oai thần lực.”",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:03.026Z",
      "updatedAt": "2025-09-03T02:37:03.026Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "a327ddb6-5923-4474-855a-bd4e7cf2fdfc",
      "text": "Tôi không phải chết, nhưng tôi sẽ sống,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:03.040Z",
      "updatedAt": "2025-09-03T02:37:03.040Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "19c77de2-5edd-46af-9752-e0140efea2de",
      "text": "để loan báo những công việc CHÚA làm.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:03.053Z",
      "updatedAt": "2025-09-03T02:37:03.053Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "79b96f56-bf5b-4d8e-bd90-708876cccdb5",
      "text": "Sửa phạt tôi, vâng CHÚA sửa phạt tôi,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:03.067Z",
      "updatedAt": "2025-09-03T02:37:03.067Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "a14724f5-dea8-407c-bd91-c352547db9eb",
      "text": "nhưng không nỡ để tôi phải chết.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:03.082Z",
      "updatedAt": "2025-09-03T02:37:03.082Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "fffcffc7-e587-46a9-852a-b1c2c3627fc8",
      "text": "Xin mở cửa công chính cho tôi",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:03.096Z",
      "updatedAt": "2025-09-03T02:37:03.096Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "fef0d86b-f373-42f8-9fd6-1b2b11195082",
      "text": "để tôi vào tạ ơn ĐỨC CHÚA.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:03.123Z",
      "updatedAt": "2025-09-03T02:37:03.123Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "df3ad99e-6fcb-449d-af2a-335fb00413bd",
      "text": "Đây là cửa dẫn vào nơi CHÚA ngự,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:03.152Z",
      "updatedAt": "2025-09-03T02:37:03.152Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "5c364b87-be78-42a2-b285-c8c3481ab199",
      "text": "chỉ những người công chính mới được qua.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:03.166Z",
      "updatedAt": "2025-09-03T02:37:03.166Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "4cb726d1-ebe9-456d-843d-80a8f0567beb",
      "text": "Lạy Chúa, con xin tạ ơn Ngài",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:03.180Z",
      "updatedAt": "2025-09-03T02:37:03.180Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "9e0ee409-e8f7-4bbd-a1cc-45356dcc2b04",
      "text": "vì đã đáp lời con và thương cứu độ.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:03.194Z",
      "updatedAt": "2025-09-03T02:37:03.194Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "764cf747-0131-4390-976e-b9f886f6b69c",
      "text": "Tảng đá thợ xây nhà loại bỏ",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:03.207Z",
      "updatedAt": "2025-09-03T02:37:03.207Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "f6111657-6da8-48d1-9324-d7dae9a7a4f0",
      "text": "lại trở nên đá tảng góc tường.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:03.222Z",
      "updatedAt": "2025-09-03T02:37:03.222Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "21a2d01f-2d30-4d83-a209-d86afed9ce43",
      "text": "Đó chính là công trình của CHÚA,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:03.236Z",
      "updatedAt": "2025-09-03T02:37:03.236Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "24dd4790-f748-46e8-8e09-ae96e5b15309",
      "text": "công trình kỳ diệu trước mắt chúng ta.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:03.249Z",
      "updatedAt": "2025-09-03T02:37:03.249Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "dd818a4b-1221-4fb9-82ba-538cf38bda57",
      "text": "Đây là ngày CHÚA đã làm ra,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:03.264Z",
      "updatedAt": "2025-09-03T02:37:03.264Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "3334cacc-9993-4756-bc06-b4a9537a3494",
      "text": "nào ta hãy vui mừng hoan hỷ.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:03.278Z",
      "updatedAt": "2025-09-03T02:37:03.278Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "b4af4a54-9035-447c-a15a-22e0d9579892",
      "text": "Lạy CHÚA, xin ban ơn cứu độ,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:03.291Z",
      "updatedAt": "2025-09-03T02:37:03.291Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "942cc11c-6d0c-4bd6-b58a-5d32b93cd9c0",
      "text": "lạy CHÚA, xin thương giúp thành công.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:03.319Z",
      "updatedAt": "2025-09-03T02:37:03.319Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "f60153e0-36b5-4500-a9a9-e79b1d94d17b",
      "text": "Nguyện xin Chúa tuôn đổ phúc lành",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:03.333Z",
      "updatedAt": "2025-09-03T02:37:03.333Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "cb5fc861-08ff-422f-918d-fcda51f0d74a",
      "text": "cho người tiến vào đây nhân danh CHÚA.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:03.361Z",
      "updatedAt": "2025-09-03T02:37:03.361Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "8bb16392-66b4-439b-8f30-e67f98254566",
      "text": "Từ nhà CHÚA, chúng tôi chúc lành cho anh em.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 2,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:03.376Z",
      "updatedAt": "2025-09-03T02:37:03.376Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "5c19b070-8c81-4a8c-a459-7dba0bddde13",
      "text": "ĐỨC CHÚA là Thượng Đế, Người giãi sáng trên ta.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:03.403Z",
      "updatedAt": "2025-09-03T02:37:03.403Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "df31d12d-4b65-4106-b989-f5113454dc48",
      "text": "Tay cầm lá, hãy sắp thành đám rước đến bên cạnh bàn thờ.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:03.431Z",
      "updatedAt": "2025-09-03T02:37:03.431Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "3832a7c8-58fb-4550-b346-afcd9c24a934",
      "text": "Lạy Chúa, chính Ngài là Thiên Chúa của con,",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:03.445Z",
      "updatedAt": "2025-09-03T02:37:03.445Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "023f1969-6896-4d89-bbd7-43d981688594",
      "text": "xin dâng Ngài muôn câu cảm tạ ;",
      "label": "28",
      "number": 28,
      "subVerseIndex": 1,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:03.459Z",
      "updatedAt": "2025-09-03T02:37:03.459Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "edcdd837-7ae9-445e-a531-0bc493f14471",
      "text": "lạy Thiên Chúa con thờ, xin dâng Ngài vạn tiếng tôn vinh.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 2,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:03.472Z",
      "updatedAt": "2025-09-03T02:37:03.472Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "9aa5dca3-4c58-4408-8a56-0bca81f03b35",
      "text": "Hãy tạ ơn CHÚA vì Chúa nhân từ,",
      "label": "29",
      "number": 29,
      "subVerseIndex": 0,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:03.486Z",
      "updatedAt": "2025-09-03T02:37:03.486Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    },
    {
      "id": "9e9fea9e-b061-49fc-8f55-277e40d1c281",
      "text": "muôn ngàn đời Chúa vẫn trọn tình thương.",
      "label": "29",
      "number": 29,
      "subVerseIndex": 1,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:03.514Z",
      "updatedAt": "2025-09-03T02:37:03.514Z",
      "chapterId": "c5fade64-7adb-4258-96af-b2d72b8d894c"
    }
  ],
  "marks": [
    {
      "id": "332b477f-107b-4975-9653-73330be37865",
      "content": "Cộng đoàn sử dụng *Tv tạ ơn này của tập thể* lúc đi kiệu vào Đền Thờ để tạ ơn Đức Chúa, sau khi được giải thoát khỏi một hiểm hoạ lớn. Các tư tế chúc lành cho cộng đoàn, rồi chuẩn bị dâng lễ tế tạ ơn. Tv này là Tv cuối cùng của nhóm Tv Ha-len (các Tv 113 – 118). Đây là một cách phân chia Tv : **1**) Cc. 1-4 ; **2**) Cc. 5-9 ; **3**) Cc. 10-21 ; **4**) Cc. 22-25 ; **5**) Cc. 26-27 ; **6**) C.28 ; **7**) C.29.",
