{
  "chapter": {
    "id": "c732747e-07f6-4d7b-8ba9-75e369f79e98",
    "number": 12,
    "createdAt": "2025-09-03T01:07:51.660Z",
    "updatedAt": "2025-09-03T01:07:51.660Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "8f46cd36-038b-48c4-8ddf-ec62a4f489d9",
      "text": "*Phần ca trưởng. Hoạ đàn bát huyền. Thánh vịnh. Của vua Đa-vít.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:25:43.049Z",
      "updatedAt": "2025-09-03T02:25:43.049Z",
      "chapterId": "c732747e-07f6-4d7b-8ba9-75e369f79e98"
    },
    {
      "id": "fc5fb16b-09c5-4ac7-8ce1-b71616aa400e",
      "text": "Xin cứu nguy, lạy CHÚA, vì chẳng còn thấy ai đạo hạnh,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:43.100Z",
      "updatedAt": "2025-09-03T02:25:43.100Z",
      "chapterId": "c732747e-07f6-4d7b-8ba9-75e369f79e98"
    },
    {
      "id": "135b1e30-d67f-4f5f-8175-0858c3748108",
      "text": "giữa loài người, không một kẻ tín trung.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:43.124Z",
      "updatedAt": "2025-09-03T02:25:43.124Z",
      "chapterId": "c732747e-07f6-4d7b-8ba9-75e369f79e98"
    },
    {
      "id": "7cdb3b5b-b93d-4be7-9813-7aaa47962b88",
      "text": "Người với người chỉ nói lời gian dối,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:43.137Z",
      "updatedAt": "2025-09-03T02:25:43.137Z",
      "chapterId": "c732747e-07f6-4d7b-8ba9-75e369f79e98"
    },
    {
      "id": "b658229e-4e77-42b7-88bb-42948ea5811a",
      "text": "môi phỉnh phờ, lòng một dạ hai.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:43.166Z",
      "updatedAt": "2025-09-03T02:25:43.166Z",
      "chapterId": "c732747e-07f6-4d7b-8ba9-75e369f79e98"
    },
    {
      "id": "afe2389e-fde8-424a-a5a1-7b54ae09e20c",
      "text": "Ước gì CHÚA xẻo môi phỉnh phờ, và cắt lưỡi ba hoa !",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:43.180Z",
      "updatedAt": "2025-09-03T02:25:43.180Z",
      "chapterId": "c732747e-07f6-4d7b-8ba9-75e369f79e98"
    },
    {
      "id": "fe6c95d1-51d7-49b7-9798-9bc140f8f4eb",
      "text": "Bọn chúng nói : “Sức mạnh ta là ba tấc lưỡi,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:43.194Z",
      "updatedAt": "2025-09-03T02:25:43.194Z",
      "chapterId": "c732747e-07f6-4d7b-8ba9-75e369f79e98"
    },
    {
      "id": "8d7e900c-235b-4d63-aa4e-d0aeb814dcfa",
      "text": "với môi mép này, ai làm chủ được ta ?”",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:43.208Z",
      "updatedAt": "2025-09-03T02:25:43.208Z",
      "chapterId": "c732747e-07f6-4d7b-8ba9-75e369f79e98"
    },
    {
      "id": "bf8995cf-cfd0-4585-9e2f-ac199867a896",
      "text": "CHÚA phán rằng : “Trước cảnh người nghèo bị áp bức,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:43.222Z",
      "updatedAt": "2025-09-03T02:25:43.222Z",
      "chapterId": "c732747e-07f6-4d7b-8ba9-75e369f79e98"
    },
    {
      "id": "f018d544-241b-41ca-bf48-4c0d3487bc71",
      "text": "kẻ khốn cùng rên siết thở than,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:43.236Z",
      "updatedAt": "2025-09-03T02:25:43.236Z",
      "chapterId": "c732747e-07f6-4d7b-8ba9-75e369f79e98"
    },
    {
      "id": "e0b57488-1bf4-4400-a27b-9a3bccb3828d",
      "text": "giờ đây Ta đứng dậy,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:43.251Z",
      "updatedAt": "2025-09-03T02:25:43.251Z",
      "chapterId": "c732747e-07f6-4d7b-8ba9-75e369f79e98"
    },
    {
      "id": "4cd02525-7c15-48a7-a64a-121f3e19706f",
      "text": "ban ơn giải thoát cho kẻ mong chờ.”",
      "label": "6",
      "number": 6,
      "subVerseIndex": 3,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:43.264Z",
      "updatedAt": "2025-09-03T02:25:43.264Z",
      "chapterId": "c732747e-07f6-4d7b-8ba9-75e369f79e98"
    },
    {
      "id": "29a962f4-27c9-4e0e-b09d-cfa77857caae",
      "text": "Lời CHÚA phán là lời chân thật,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:43.284Z",
      "updatedAt": "2025-09-03T02:25:43.284Z",
      "chapterId": "c732747e-07f6-4d7b-8ba9-75e369f79e98"
    },
    {
      "id": "6e493467-53e6-437e-960e-6dab51608183",
      "text": "như bạc nấu trong lò, đã bảy lần tinh luyện.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:43.314Z",
      "updatedAt": "2025-09-03T02:25:43.314Z",
      "chapterId": "c732747e-07f6-4d7b-8ba9-75e369f79e98"
    },
    {
      "id": "afb37b84-7cfb-4593-bd2c-5aa693f7ac87",
      "text": "Vâng lạy CHÚA, Ngài bảo vệ chúng con,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:43.328Z",
      "updatedAt": "2025-09-03T02:25:43.328Z",
      "chapterId": "c732747e-07f6-4d7b-8ba9-75e369f79e98"
    },
    {
      "id": "461077ef-5b76-43ef-b301-a01fa788bd49",
      "text": "giữ cho khỏi bọn này mãi mãi.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:43.342Z",
      "updatedAt": "2025-09-03T02:25:43.342Z",
      "chapterId": "c732747e-07f6-4d7b-8ba9-75e369f79e98"
    },
    {
      "id": "36e7447d-99d6-4c6e-a64a-e6bee500f282",
      "text": "Phường gian ác nhởn nhơ khắp chốn,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:43.356Z",
      "updatedAt": "2025-09-03T02:25:43.356Z",
      "chapterId": "c732747e-07f6-4d7b-8ba9-75e369f79e98"
    },
    {
      "id": "612bec0c-2579-45fb-be98-186d262bd702",
      "text": "chuyện đê hèn đầy dẫy nhân gian.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:43.370Z",
      "updatedAt": "2025-09-03T02:25:43.370Z",
      "chapterId": "c732747e-07f6-4d7b-8ba9-75e369f79e98"
    }
  ],
  "marks": [
    {
      "id": "e92b9e32-2e71-4c64-ac1b-7346ea3a8c3a",
      "content": "Đây là *một Thánh vịnh hỗn hợp* gồm những câu mang tính cách ai ca (cc. 2-6) và những yếu tố giáo huấn (cc. 7-9). Lời chân thật của Thiên Chúa đối nghịch với những lời gian dối của những kẻ hai lòng, hay ba hoa và phỉnh phờ.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 54,
