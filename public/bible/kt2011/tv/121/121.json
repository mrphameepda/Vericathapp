      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "2334dc06-f92e-4374-a5fc-f032b11ef1cc"
    },
    {
      "id": "da627176-ac93-416e-8d10-a6d1013f224f",
      "content": "Tv 91,1; Is 25,4",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 23,
      "endOffset": 23,
      "createdAt": "2025-09-03T02:37:25.319Z",
      "updatedAt": "2025-09-03T02:37:25.319Z",
      "targetId": "02107f48-49ce-4b78-83fb-ff58210f8025",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "2334dc06-f92e-4374-a5fc-f032b11ef1cc"
    },
    {
      "id": "3e04ed53-2515-4343-b58d-00da4880000f",
      "content": "*Rặng núi* mời gọi tác giả nhìn lên trời cao (x. Tv 123,1) ; ơn phù trợ của Thiên Chúa đến từ đó.",
      "kind": "MARK_KIND_FOOTNOTE",
