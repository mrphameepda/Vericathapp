{
  "chapter": {
    "id": "2334dc06-f92e-4374-a5fc-f032b11ef1cc",
    "number": 121,
    "createdAt": "2025-09-03T01:07:51.662Z",
    "updatedAt": "2025-09-03T01:07:51.662Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "b4fdeeec-969a-4656-8f9e-3ec3bd38bf24",
      "text": "*Ca khúc lên Đền.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:37:25.047Z",
      "updatedAt": "2025-09-03T02:37:25.047Z",
      "chapterId": "2334dc06-f92e-4374-a5fc-f032b11ef1cc"
    },
    {
      "id": "d2fb2b06-c7d0-41e3-b552-f9ceafc2b2e5",
      "text": "Tôi ngước mắt nhìn lên rặng núi,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:25.102Z",
      "updatedAt": "2025-09-03T02:37:25.102Z",
      "chapterId": "2334dc06-f92e-4374-a5fc-f032b11ef1cc"
    },
    {
      "id": "5b21612c-d866-4c85-bdf3-601342a25004",
      "text": "ơn phù hộ tôi đến tự nơi nao ?",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:25.128Z",
      "updatedAt": "2025-09-03T02:37:25.128Z",
      "chapterId": "2334dc06-f92e-4374-a5fc-f032b11ef1cc"
    },
    {
      "id": "0756f09e-0d35-4aaa-b5a8-ec408d5f4e6b",
      "text": "Ơn phù hộ tôi đến từ ĐỨC CHÚA",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:25.149Z",
      "updatedAt": "2025-09-03T02:37:25.149Z",
      "chapterId": "2334dc06-f92e-4374-a5fc-f032b11ef1cc"
    },
    {
      "id": "c9cde7b8-a38e-4751-8054-92e8039526fb",
      "text": "là Đấng dựng nên cả đất trời.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:25.179Z",
      "updatedAt": "2025-09-03T02:37:25.179Z",
      "chapterId": "2334dc06-f92e-4374-a5fc-f032b11ef1cc"
    },
    {
      "id": "6d0746ab-1ddd-4deb-9c65-bc89ec25d131",
      "text": "Xin Đấng gìn giữ bạn đừng để bạn lỡ chân trật bước,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:25.193Z",
      "updatedAt": "2025-09-03T02:37:25.193Z",
      "chapterId": "2334dc06-f92e-4374-a5fc-f032b11ef1cc"
    },
    {
      "id": "abcc5637-5eb1-42d0-90b7-6b843bb76b51",
      "text": "xin Người chớ ngủ quên.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:25.236Z",
      "updatedAt": "2025-09-03T02:37:25.236Z",
      "chapterId": "2334dc06-f92e-4374-a5fc-f032b11ef1cc"
    },
    {
      "id": "7cf86653-6f37-441e-a22d-8ebbda2d170c",
      "text": "Đấng gìn giữ Ít-ra-en,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:25.249Z",
      "updatedAt": "2025-09-03T02:37:25.249Z",
      "chapterId": "2334dc06-f92e-4374-a5fc-f032b11ef1cc"
    },
    {
      "id": "1851f8f9-9b51-42bc-b92a-4cc6e19f6439",
      "text": "lẽ nào chợp mắt ngủ quên cho đành !",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:25.277Z",
      "updatedAt": "2025-09-03T02:37:25.277Z",
      "chapterId": "2334dc06-f92e-4374-a5fc-f032b11ef1cc"
    },
    {
      "id": "ccb6bbb4-9bd5-4c16-9be3-724ba92c7890",
      "text": "Chính CHÚA là Đấng canh giữ bạn,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:25.291Z",
      "updatedAt": "2025-09-03T02:37:25.291Z",
      "chapterId": "2334dc06-f92e-4374-a5fc-f032b11ef1cc"
    },
    {
      "id": "02107f48-49ce-4b78-83fb-ff58210f8025",
      "text": "chính CHÚA là Đấng vẫn chở che,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:25.305Z",
      "updatedAt": "2025-09-03T02:37:25.305Z",
      "chapterId": "2334dc06-f92e-4374-a5fc-f032b11ef1cc"
    },
    {
      "id": "2eb3fa66-2f13-4bd6-aeb8-2f44f834e356",
      "text": "Người luôn luôn ở gần kề.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:25.333Z",
      "updatedAt": "2025-09-03T02:37:25.333Z",
      "chapterId": "2334dc06-f92e-4374-a5fc-f032b11ef1cc"
    },
    {
      "id": "5bd6fa5e-d30c-4b27-9003-f25ba02268bc",
      "text": "Ngày sáu khắc, vầng ô không tác hoạ,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:25.361Z",
      "updatedAt": "2025-09-03T02:37:25.361Z",
      "chapterId": "2334dc06-f92e-4374-a5fc-f032b11ef1cc"
    },
    {
      "id": "3ae39ca5-e1e4-45bb-8364-bf12d89a7b1c",
      "text": "đêm năm canh, vành nguyệt chẳng hại chi.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:25.375Z",
      "updatedAt": "2025-09-03T02:37:25.375Z",
      "chapterId": "2334dc06-f92e-4374-a5fc-f032b11ef1cc"
    },
    {
      "id": "c090d1da-ae0f-473e-8aa0-baf0fb690ff6",
      "text": "CHÚA giữ gìn bạn khỏi mọi điều bất hạnh,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:25.389Z",
      "updatedAt": "2025-09-03T02:37:25.389Z",
      "chapterId": "2334dc06-f92e-4374-a5fc-f032b11ef1cc"
    },
    {
      "id": "00b57ed4-33aa-48f5-9da6-d0b319cc24d9",
      "text": "giữ gìn cho sinh mệnh an toàn.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:25.403Z",
      "updatedAt": "2025-09-03T02:37:25.403Z",
      "chapterId": "2334dc06-f92e-4374-a5fc-f032b11ef1cc"
    },
    {
      "id": "35993348-a237-4986-ae91-1b479bf3ae36",
      "text": "CHÚA giữ gìn bạn lúc ra vào lui tới,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:25.417Z",
      "updatedAt": "2025-09-03T02:37:25.417Z",
      "chapterId": "2334dc06-f92e-4374-a5fc-f032b11ef1cc"
    },
    {
      "id": "20985834-f6a5-4e12-adc6-653b602f1ce7",
      "text": "từ giờ đây cho đến mãi muôn đời.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:25.444Z",
      "updatedAt": "2025-09-03T02:37:25.444Z",
      "chapterId": "2334dc06-f92e-4374-a5fc-f032b11ef1cc"
    }
  ],
  "marks": [
