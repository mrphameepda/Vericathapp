      "chapterId": "2334dc06-f92e-4374-a5fc-f032b11ef1cc"
    },
    {
      "id": "fea50281-1e7e-417f-8bc5-27307b5abdab",
      "content": "Đặc ngữ sê-mít tương đương với cụm từ *ra vào lui tới* chỉ mọi sinh hoạt của đời sống thường nhật.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "8",
