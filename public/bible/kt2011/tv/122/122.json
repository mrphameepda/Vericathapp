{
  "chapter": {
    "id": "6f1568c4-82de-442d-9454-cecdbbdb4464",
    "number": 122,
    "createdAt": "2025-09-03T01:07:51.662Z",
    "updatedAt": "2025-09-03T01:07:51.662Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "9be24285-5c0c-4a55-a62f-a10118057380",
      "text": "*Ca khúc lên Đền. Của vua Đa-vít.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:37:30.419Z",
      "updatedAt": "2025-09-03T02:37:30.419Z",
      "chapterId": "6f1568c4-82de-442d-9454-cecdbbdb4464"
    },
    {
      "id": "6dc4271e-8b7d-44a3-add7-3f467f55e21b",
      "text": "Vui dường nào khi thiên hạ bảo tôi :",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:30.483Z",
      "updatedAt": "2025-09-03T02:37:30.483Z",
      "chapterId": "6f1568c4-82de-442d-9454-cecdbbdb4464"
    },
    {
      "id": "98357bb6-69f3-42f6-a1c0-cd33d20a34c5",
      "text": "“Ta cùng trẩy lên đền thánh CHÚA !”",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:30.498Z",
      "updatedAt": "2025-09-03T02:37:30.498Z",
      "chapterId": "6f1568c4-82de-442d-9454-cecdbbdb4464"
    },
    {
      "id": "8d657b6b-3434-4558-8727-4a5819ee8015",
      "text": "Và giờ đây, Giê-ru-sa-lem hỡi,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 3,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:30.525Z",
      "updatedAt": "2025-09-03T02:37:30.525Z",
      "chapterId": "6f1568c4-82de-442d-9454-cecdbbdb4464"
    },
    {
      "id": "adcfe9dc-c08e-43e9-a2a1-126612466f14",
      "text": "cửa nội thành, ta đã dừng chân.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:30.556Z",
      "updatedAt": "2025-09-03T02:37:30.556Z",
      "chapterId": "6f1568c4-82de-442d-9454-cecdbbdb4464"
    },
    {
      "id": "6cd1a118-35bc-4cc2-96c4-742cd5bf6fd7",
      "text": "Giê-ru-sa-lem khác nào đô thị",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:30.571Z",
      "updatedAt": "2025-09-03T02:37:30.571Z",
      "chapterId": "6f1568c4-82de-442d-9454-cecdbbdb4464"
    },
    {
      "id": "6f508fb8-8b7e-4b8a-9a65-74d9f88263fd",
      "text": "được xây nên một khối vẹn toàn.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:30.599Z",
      "updatedAt": "2025-09-03T02:37:30.599Z",
      "chapterId": "6f1568c4-82de-442d-9454-cecdbbdb4464"
    },
    {
      "id": "60f1936b-ad44-443e-9296-c1fb01c8763e",
      "text": "Từng chi tộc, chi tộc của CHÚA,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:30.612Z",
      "updatedAt": "2025-09-03T02:37:30.612Z",
      "chapterId": "6f1568c4-82de-442d-9454-cecdbbdb4464"
    },
    {
      "id": "c0dffc86-bda7-4a95-988b-9113a75db9f4",
      "text": "trẩy hội lên đền ở nơi đây,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:30.626Z",
      "updatedAt": "2025-09-03T02:37:30.626Z",
      "chapterId": "6f1568c4-82de-442d-9454-cecdbbdb4464"
    },
    {
      "id": "5c8432d5-986e-41b3-9a6c-022cf53a7340",
      "text": "để danh CHÚA, họ cùng xưng tụng,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:30.640Z",
      "updatedAt": "2025-09-03T02:37:30.640Z",
      "chapterId": "6f1568c4-82de-442d-9454-cecdbbdb4464"
    },
    {
      "id": "f6170776-8f61-48a3-90d4-b1d3b9faddd5",
      "text": "như lệnh đã truyền cho Ít-ra-en.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 3,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:30.654Z",
      "updatedAt": "2025-09-03T02:37:30.654Z",
      "chapterId": "6f1568c4-82de-442d-9454-cecdbbdb4464"
    },
    {
      "id": "7e63024b-0aba-4d5f-b32f-820625ab2891",
      "text": "Cũng nơi đó, đặt ngai xét xử,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:30.696Z",
      "updatedAt": "2025-09-03T02:37:30.696Z",
      "chapterId": "6f1568c4-82de-442d-9454-cecdbbdb4464"
    },
    {
      "id": "faac154e-2712-4c67-b048-a4c7f3bf60cb",
      "text": "ngai vàng của vương triều Đa-vít.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:30.710Z",
      "updatedAt": "2025-09-03T02:37:30.710Z",
      "chapterId": "6f1568c4-82de-442d-9454-cecdbbdb4464"
    },
    {
      "id": "99bc07e2-639e-4f01-a056-0a30c1cb8b7c",
      "text": "Hãy nguyện chúc Giê-ru-sa-lem được thái bình,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:30.738Z",
      "updatedAt": "2025-09-03T02:37:30.738Z",
      "chapterId": "6f1568c4-82de-442d-9454-cecdbbdb4464"
    },
    {
      "id": "22941673-4075-40a9-b26f-908356c576b7",
      "text": "rằng : “Chúc thân hữu của thành luôn thịnh đạt,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:30.780Z",
      "updatedAt": "2025-09-03T02:37:30.780Z",
      "chapterId": "6f1568c4-82de-442d-9454-cecdbbdb4464"
    },
    {
      "id": "cb24a46d-0b00-4899-a547-afaba6766655",
      "text": "tường trong luỹ ngoài hằng yên ổn,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:30.793Z",
      "updatedAt": "2025-09-03T02:37:30.793Z",
      "chapterId": "6f1568c4-82de-442d-9454-cecdbbdb4464"
    },
    {
      "id": "1345f0f3-2eab-4056-9f4d-71973824127e",
      "text": "lâu đài dinh thự mãi an ninh.”",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:30.808Z",
      "updatedAt": "2025-09-03T02:37:30.808Z",
      "chapterId": "6f1568c4-82de-442d-9454-cecdbbdb4464"
    },
    {
      "id": "70ee617b-339d-45f6-8c93-d5c079809173",
      "text": "Nghĩ tới anh em cùng là bạn hữu,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:30.821Z",
      "updatedAt": "2025-09-03T02:37:30.821Z",
      "chapterId": "6f1568c4-82de-442d-9454-cecdbbdb4464"
    },
    {
      "id": "647ba445-0b86-4d3d-a435-0010bc3030b5",
      "text": "tôi nói rằng : “Chúc thành đô an lạc.”",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:30.835Z",
      "updatedAt": "2025-09-03T02:37:30.835Z",
      "chapterId": "6f1568c4-82de-442d-9454-cecdbbdb4464"
    },
    {
      "id": "297668e9-ee9e-4c89-b37c-4abd6d05a7c8",
      "text": "Nghĩ tới đền thánh CHÚA, Thiên Chúa chúng ta thờ,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:30.848Z",
      "updatedAt": "2025-09-03T02:37:30.848Z",
      "chapterId": "6f1568c4-82de-442d-9454-cecdbbdb4464"
    },
    {
      "id": "a5563af3-fe7c-4d69-81de-dd297537f9eb",
      "text": "tôi ước mong thành được hạnh phúc, hỡi thành đô.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:30.863Z",
      "updatedAt": "2025-09-03T02:37:30.863Z",
      "chapterId": "6f1568c4-82de-442d-9454-cecdbbdb4464"
    }
  ],
