    },
    {
      "id": "ea44fceb-c810-494d-a4ef-6634e0a21f77",
      "content": "Tv 25,15; 141,8",
      "kind": "MARK_KIND_REFERENCE",
      "label": "1@",
      "sortOrder": 0,
      "startOffset": 4,
      "endOffset": 4,
      "createdAt": "2025-09-03T02:37:35.731Z",
      "updatedAt": "2025-09-03T02:37:35.731Z",
      "targetId": "3b8efc73-0288-45f4-b3ba-bdd57a07703e",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7073f2dc-4134-4a18-afdc-508814094b7e"
    },
    {
      "id": "e8a8f414-fc36-458d-bfe4-99d282475848",
      "content": "Có lẽ *ai ca này của tập thể* đã được soạn thảo sau thời lưu đày hoặc vào thời ông Nơ-khe-mi-a. Lúc đó, dân Ít-ra-en bị dân ngoại tấn công, khinh dể và nhục mạ.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 62,
      "endOffset": 62,
      "createdAt": "2025-09-03T02:37:35.709Z",
      "updatedAt": "2025-09-03T02:37:35.709Z",
      "targetId": "782baea4-90d5-4087-8cc3-fadccd3d7b05",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "7073f2dc-4134-4a18-afdc-508814094b7e"
    },
    {
      "id": "6e218c94-c8e6-439b-ba81-0bd1f40d2f63",
      "content": "Mt 6,9",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:37:35.758Z",
      "updatedAt": "2025-09-03T02:37:35.758Z",
      "targetId": "ff0cc16e-622e-4c6e-af71-e30ab9124362",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7073f2dc-4134-4a18-afdc-508814094b7e"
    },
    {
      "id": "faeddcc2-e558-42da-834c-162cdaafcebc",
      "content": "Đó là thái độ của cộng đoàn Ít-ra-en đợi chờ sự cứu giúp của Thiên Chúa với niềm tin tưởng cậy trông.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 37,
      "endOffset": 37,
      "createdAt": "2025-09-03T02:37:35.820Z",
      "updatedAt": "2025-09-03T02:37:35.820Z",
      "targetId": "fe260e28-2520-47cb-93c1-5b4f257870e7",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7073f2dc-4134-4a18-afdc-508814094b7e"
    },
    {
      "id": "718df569-a84a-4921-926c-66134e218721",
      "content": "Không rõ ở đây, tác giả muốn nói về những người trong cộng đoàn Ít-ra-en, về những kẻ thù ở ngoài cộng đoàn hay về những người ngoại xâm ?",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 35,
      "endOffset": 35,
      "createdAt": "2025-09-03T02:37:35.931Z",
      "updatedAt": "2025-09-03T02:37:35.931Z",
      "targetId": "8a6bd139-8cc7-4b22-8918-ad05c9a2e832",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7073f2dc-4134-4a18-afdc-508814094b7e"
    }
  ],
