{
  "chapter": {
    "id": "7073f2dc-4134-4a18-afdc-508814094b7e",
    "number": 123,
    "createdAt": "2025-09-03T01:07:51.662Z",
    "updatedAt": "2025-09-03T01:07:51.662Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "ca77a29e-894d-4a48-bba9-1603264479be",
      "text": "*Ca khúc lên Đền.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:37:35.677Z",
      "updatedAt": "2025-09-03T02:37:35.677Z",
      "chapterId": "7073f2dc-4134-4a18-afdc-508814094b7e"
    },
    {
      "id": "3b8efc73-0288-45f4-b3ba-bdd57a07703e",
      "text": "Con ngước mắt hướng nhìn lên Chúa,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:35.720Z",
      "updatedAt": "2025-09-03T02:37:35.720Z",
      "chapterId": "7073f2dc-4134-4a18-afdc-508814094b7e"
    },
    {
      "id": "ff0cc16e-622e-4c6e-af71-e30ab9124362",
      "text": "Đấng đang ngự trên trời.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:35.744Z",
      "updatedAt": "2025-09-03T02:37:35.744Z",
      "chapterId": "7073f2dc-4134-4a18-afdc-508814094b7e"
    },
    {
      "id": "2ebc1209-e9bf-4f6b-8994-9de147aef570",
      "text": "Quả thật như mắt của gia nhân hướng nhìn tay ông chủ,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:35.772Z",
      "updatedAt": "2025-09-03T02:37:35.772Z",
      "chapterId": "7073f2dc-4134-4a18-afdc-508814094b7e"
    },
    {
      "id": "042a788c-f5fb-4d28-a5b0-9e847a14f5a6",
      "text": "như mắt của nữ tỳ hướng nhìn tay bà chủ,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:35.785Z",
      "updatedAt": "2025-09-03T02:37:35.785Z",
      "chapterId": "7073f2dc-4134-4a18-afdc-508814094b7e"
    },
    {
      "id": "fe260e28-2520-47cb-93c1-5b4f257870e7",
      "text": "mắt chúng ta cũng hướng nhìn lên CHÚA",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:35.799Z",
      "updatedAt": "2025-09-03T02:37:35.799Z",
      "chapterId": "7073f2dc-4134-4a18-afdc-508814094b7e"
    },
    {
      "id": "4cc77be6-8ea8-4901-bdfb-a2ca39a7f970",
      "text": "là Thiên Chúa chúng ta,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 3,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:35.833Z",
      "updatedAt": "2025-09-03T02:37:35.833Z",
      "chapterId": "7073f2dc-4134-4a18-afdc-508814094b7e"
    },
    {
      "id": "c4eedbf5-62a4-41f6-8cb1-9c24e6926557",
      "text": "tới khi Người xót thương chút phận.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 4,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:35.847Z",
      "updatedAt": "2025-09-03T02:37:35.847Z",
      "chapterId": "7073f2dc-4134-4a18-afdc-508814094b7e"
    },
    {
      "id": "71122a1c-3008-4526-8a0b-000803bd158d",
      "text": "Rủ lòng thương, lạy CHÚA, xin rủ lòng thương,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:35.861Z",
      "updatedAt": "2025-09-03T02:37:35.861Z",
      "chapterId": "7073f2dc-4134-4a18-afdc-508814094b7e"
    },
    {
      "id": "bba51fa2-a6e7-467f-b80a-ed6cf2048cd1",
      "text": "bởi chúng con bị khinh miệt ê chề ;",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:35.875Z",
      "updatedAt": "2025-09-03T02:37:35.875Z",
      "chapterId": "7073f2dc-4134-4a18-afdc-508814094b7e"
    },
    {
      "id": "e1110c6a-5522-4b43-a662-e72b2b4b4c2c",
      "text": "hồn thật quá ê chề vì hứng chịu",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:35.889Z",
      "updatedAt": "2025-09-03T02:37:35.889Z",
      "chapterId": "7073f2dc-4134-4a18-afdc-508814094b7e"
    },
    {
      "id": "60353a92-514a-457e-b1c5-14ce1d6b0109",
      "text": "lời nhạo báng của phường tự mãn,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:35.903Z",
      "updatedAt": "2025-09-03T02:37:35.903Z",
      "chapterId": "7073f2dc-4134-4a18-afdc-508814094b7e"
    },
    {
      "id": "8a6bd139-8cc7-4b22-8918-ad05c9a2e832",
      "text": "giọng khinh người của bọn kiêu căng.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:35.917Z",
      "updatedAt": "2025-09-03T02:37:35.917Z",
      "chapterId": "7073f2dc-4134-4a18-afdc-508814094b7e"
    }
  ],
  "marks": [
    {
