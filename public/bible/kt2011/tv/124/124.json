{
  "chapter": {
    "id": "96a60746-41be-4d91-81b1-cf0222a805b1",
    "number": 124,
    "createdAt": "2025-09-03T01:07:51.662Z",
    "updatedAt": "2025-09-03T01:07:51.662Z",
