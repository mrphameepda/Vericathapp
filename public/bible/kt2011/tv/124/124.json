  },
  "verses": [
    {
      "id": "28fa85f3-eb71-42c8-99f4-fd6549339186",
      "text": "*Ca khúc lên Đền. Của vua Đa-vít.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:37:41.375Z",
      "updatedAt": "2025-09-03T02:37:41.375Z",
      "chapterId": "96a60746-41be-4d91-81b1-cf0222a805b1"
    },
    {
      "id": "19fc7570-1129-4372-bcfd-e37d71a703fe",
      "text": "Nếu mà CHÚA chẳng đỡ bênh ta,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:41.453Z",
      "updatedAt": "2025-09-03T02:37:41.453Z",
      "chapterId": "96a60746-41be-4d91-81b1-cf0222a805b1"
    },
    {
      "id": "acb2c580-7399-4c27-99ce-86c36f12edf4",
      "text": "nhà Ít-ra-en hãy nói rằng :",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:41.467Z",
      "updatedAt": "2025-09-03T02:37:41.467Z",
      "chapterId": "96a60746-41be-4d91-81b1-cf0222a805b1"
    },
    {
      "id": "76b44c23-b8a1-44e6-a34a-9307f2f0acc2",
      "text": "Nếu mà CHÚA chẳng đỡ bênh ta,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:41.495Z",
      "updatedAt": "2025-09-03T02:37:41.495Z",
      "chapterId": "96a60746-41be-4d91-81b1-cf0222a805b1"
    },
    {
      "id": "71d26185-ed71-44c4-9330-02f2d05e13d6",
      "text": "khi thiên hạ nhằm ta xông tới,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:41.523Z",
      "updatedAt": "2025-09-03T02:37:41.523Z",
      "chapterId": "96a60746-41be-4d91-81b1-cf0222a805b1"
    },
    {
      "id": "d944dbf0-821f-40c6-8fc9-1e32f43e0ab3",
      "text": "hẳn là họ đã nuốt sống ta rồi,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:41.536Z",
      "updatedAt": "2025-09-03T02:37:41.536Z",
      "chapterId": "96a60746-41be-4d91-81b1-cf0222a805b1"
    },
    {
      "id": "6eb22a38-8df1-4572-a6ec-0ac5ed919a7f",
      "text": "lúc đùng đùng giận ta như vậy ;",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:41.564Z",
      "updatedAt": "2025-09-03T02:37:41.564Z",
      "chapterId": "96a60746-41be-4d91-81b1-cf0222a805b1"
    },
    {
      "id": "f980bed0-8b46-4c9f-b7ea-c53c402008dc",
      "text": "hẳn là nước đã cuốn ta đi,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:41.578Z",
      "updatedAt": "2025-09-03T02:37:41.578Z",
      "chapterId": "96a60746-41be-4d91-81b1-cf0222a805b1"
    },
    {
      "id": "d596d222-4149-48ae-b71c-f7b6e40a71c8",
      "text": "dòng thác lũ dâng lên ngập đầu ngập cổ ;",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:41.592Z",
      "updatedAt": "2025-09-03T02:37:41.592Z",
      "chapterId": "96a60746-41be-4d91-81b1-cf0222a805b1"
    },
    {
      "id": "08dcedc9-920c-4184-9359-20993eea7d44",
      "text": "hẳn là nước cuồn cuộn đã dâng lên ngập cổ ngập đầu.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:41.607Z",
      "updatedAt": "2025-09-03T02:37:41.607Z",
      "chapterId": "96a60746-41be-4d91-81b1-cf0222a805b1"
    },
    {
      "id": "d4d1f216-ea38-4360-8482-bd50b6337c44",
      "text": "Xin chúc tụng ĐỨC CHÚA",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:41.621Z",
      "updatedAt": "2025-09-03T02:37:41.621Z",
      "chapterId": "96a60746-41be-4d91-81b1-cf0222a805b1"
    },
    {
      "id": "69e5f215-78ce-4c99-b529-65e0f878af75",
      "text": "đã không bỏ mặc ta làm mồi ngon cho nanh vuốt họ.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:41.663Z",
      "updatedAt": "2025-09-03T02:37:41.663Z",
      "chapterId": "96a60746-41be-4d91-81b1-cf0222a805b1"
    },
    {
      "id": "97dff313-735c-41f5-bfaf-b51da76ea83d",
      "text": "Hồn ta tựa cánh chim thoát lưới người đánh bẫy ;",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:41.677Z",
      "updatedAt": "2025-09-03T02:37:41.677Z",
      "chapterId": "96a60746-41be-4d91-81b1-cf0222a805b1"
    },
    {
      "id": "1a2b3963-9793-409f-b20c-2b5b082be0db",
      "text": "lưới giăng đã đứt rồi, thế là ta thoát nạn.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:41.705Z",
      "updatedAt": "2025-09-03T02:37:41.705Z",
      "chapterId": "96a60746-41be-4d91-81b1-cf0222a805b1"
    },
    {
      "id": "0f6a8c5f-913e-423b-8da0-8445c33b210a",
      "text": "Ta được phù hộ là nhờ danh thánh CHÚA,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:41.719Z",
      "updatedAt": "2025-09-03T02:37:41.719Z",
      "chapterId": "96a60746-41be-4d91-81b1-cf0222a805b1"
    },
    {
      "id": "59558946-e7ab-4346-9675-12e07b94dc87",
      "text": "Đấng đã dựng nên cả đất trời.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:41.733Z",
      "updatedAt": "2025-09-03T02:37:41.733Z",
      "chapterId": "96a60746-41be-4d91-81b1-cf0222a805b1"
    }
  ],
