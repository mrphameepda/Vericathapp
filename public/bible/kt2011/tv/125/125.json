{
  "chapter": {
    "id": "07716c24-fa07-4eda-875e-0342d9b3bf9f",
    "number": 125,
    "createdAt": "2025-09-03T01:07:51.662Z",
    "updatedAt": "2025-09-03T01:07:51.662Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "1d1fbc25-1489-4f34-91bd-f51ffd60e637",
      "text": "*Ca khúc lên Đền.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:37:46.912Z",
      "updatedAt": "2025-09-03T02:37:46.912Z",
      "chapterId": "07716c24-fa07-4eda-875e-0342d9b3bf9f"
    },
    {
      "id": "4a5c1c73-323a-4cc7-bc6a-6e52f0ea7674",
      "text": "Ai tin tưởng vào CHÚA, khác nào núi Xi-on",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:46.963Z",
      "updatedAt": "2025-09-03T02:37:46.963Z",
      "chapterId": "07716c24-fa07-4eda-875e-0342d9b3bf9f"
    },
    {
      "id": "dc2c295d-b65d-480c-b50f-474fe86919b0",
      "text": "chẳng bao giờ lay chuyển, muôn thuở vẫn trường tồn.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:46.985Z",
      "updatedAt": "2025-09-03T02:37:46.985Z",
      "chapterId": "07716c24-fa07-4eda-875e-0342d9b3bf9f"
    },
    {
      "id": "72e3bed6-6b5a-45b1-bc27-87385d259fe3",
      "text": "Như núi đồi bao bọc thành Giê-ru-sa-lem,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:46.997Z",
      "updatedAt": "2025-09-03T02:37:46.997Z",
      "chapterId": "07716c24-fa07-4eda-875e-0342d9b3bf9f"
    },
    {
      "id": "612d79c1-6a1d-40a1-b9e2-861c07dd8493",
      "text": "CHÚA bao bọc dân Người bây giờ và mãi mãi.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:47.022Z",
      "updatedAt": "2025-09-03T02:37:47.022Z",
      "chapterId": "07716c24-fa07-4eda-875e-0342d9b3bf9f"
    },
    {
      "id": "8f0d18c0-43b5-40c3-842b-7b2a489d64fe",
      "text": "Chúa sẽ không cho vương trượng ác nhân",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:47.050Z",
      "updatedAt": "2025-09-03T02:37:47.050Z",
      "chapterId": "07716c24-fa07-4eda-875e-0342d9b3bf9f"
    },
    {
      "id": "6403b925-702f-4a12-a658-6d6ed39e2fe3",
      "text": "đè nặng trên phần đất người lành,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:47.078Z",
      "updatedAt": "2025-09-03T02:37:47.078Z",
      "chapterId": "07716c24-fa07-4eda-875e-0342d9b3bf9f"
    },
    {
      "id": "180688a1-30d2-4046-81fc-bd0a29ddc8a7",
      "text": "kẻo người lành tra tay làm điều ác.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:47.092Z",
      "updatedAt": "2025-09-03T02:37:47.092Z",
      "chapterId": "07716c24-fa07-4eda-875e-0342d9b3bf9f"
    },
    {
      "id": "9d82727b-b502-4ccb-85d7-7b888115133a",
      "text": "Lạy CHÚA, xin đối xử nhân hậu với người nhân hậu",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:47.106Z",
      "updatedAt": "2025-09-03T02:37:47.106Z",
      "chapterId": "07716c24-fa07-4eda-875e-0342d9b3bf9f"
    },
    {
      "id": "899f8e8e-9ee9-43eb-89f9-6fee4c5659dc",
      "text": "và những ai lòng dạ thẳng ngay.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:47.120Z",
      "updatedAt": "2025-09-03T02:37:47.120Z",
      "chapterId": "07716c24-fa07-4eda-875e-0342d9b3bf9f"
    },
    {
      "id": "b8056ccd-85c5-4592-a381-1a3cf6b0f737",
      "text": "Nhưng kẻ ngả theo đường tà vạy,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:47.135Z",
      "updatedAt": "2025-09-03T02:37:47.135Z",
      "chapterId": "07716c24-fa07-4eda-875e-0342d9b3bf9f"
    },
    {
      "id": "28a05c10-1f7c-4f21-b251-e1a94f2e3e83",
      "text": "xin CHÚA đuổi đi cùng bọn làm điều ác.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:47.149Z",
      "updatedAt": "2025-09-03T02:37:47.149Z",
      "chapterId": "07716c24-fa07-4eda-875e-0342d9b3bf9f"
    },
    {
      "id": "b3100ae0-afc0-4525-b532-b6e402829656",
      "text": "Nguyện chúc Ít-ra-en được thái bình.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:47.162Z",
      "updatedAt": "2025-09-03T02:37:47.162Z",
      "chapterId": "07716c24-fa07-4eda-875e-0342d9b3bf9f"
    }
  ],
