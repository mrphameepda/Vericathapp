    {
      "id": "0e4cac4f-4c61-4617-858e-d87ee7fe9a4d",
      "content": "Br 4,23",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:37:52.476Z",
      "updatedAt": "2025-09-03T02:37:52.476Z",
      "targetId": "e264c17b-cf81-43bc-a40b-4b64aba4431b",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ed557ccd-1fb8-45f8-a2cd-3890b5993b8e"
    },
    {
      "id": "774c8341-d383-41fd-abb5-56565a1015b0",
      "content": "Khô cạn vào mùa hè, *suối miền Nam* (= “neGeb” = sa mạc thuộc miền Nam Giu-đa) bỗng nhiên đầy tràn nước nhờ trận mưa dồi dào đổ xuống trong mùa đông. Cộng đoàn Ít-ra-en cầu xin Chúa cũng đem cho họ niềm vui và bầu khí phấn khởi, một sức sống mới, như Người đã cho cộng đoàn Ít-ra-en thời tái thiết được hồi sinh sau cuộc lưu đày tại Ba-by-lon (*xin dẫn tù nhân chúng con về* : c.4a), tựa trận mưa lớn đổ xuống suối cạn miền Nam trong mùa đông.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 37,
      "endOffset": 37,
      "createdAt": "2025-09-03T02:37:52.433Z",
      "updatedAt": "2025-09-03T02:37:52.433Z",
      "targetId": "992789fb-d601-4dc8-9fdf-1273ca328c9c",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ed557ccd-1fb8-45f8-a2cd-3890b5993b8e"
    },
    {
      "id": "8462d596-827e-41d2-a1bd-bcfe1073a3cb",
      "content": "Tv 4,8; Is 9,2",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 15,
      "endOffset": 15,
      "createdAt": "2025-09-03T02:37:52.531Z",
      "updatedAt": "2025-09-03T02:37:52.531Z",
      "targetId": "65eab031-65c2-41aa-a094-3a4e8bf071de",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "ed557ccd-1fb8-45f8-a2cd-3890b5993b8e"
    },
    {
      "id": "617d82e5-a1be-4c43-81e3-307d938bc091",
      "content": "Đây là câu trả lời trấn an cộng đoàn dâng lên Chúa lời khẩn cầu của họ.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 30,
      "endOffset": 30,
      "createdAt": "2025-09-03T02:37:52.462Z",
