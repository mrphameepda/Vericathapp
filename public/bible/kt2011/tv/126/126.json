{
  "chapter": {
    "id": "ed557ccd-1fb8-45f8-a2cd-3890b5993b8e",
    "number": 126,
    "createdAt": "2025-09-03T01:07:51.662Z",
    "updatedAt": "2025-09-03T01:07:51.662Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "9cc0429e-6eac-43d3-a8a0-186cf791834a",
      "text": "*Ca khúc lên Đền.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:37:52.227Z",
      "updatedAt": "2025-09-03T02:37:52.227Z",
      "chapterId": "ed557ccd-1fb8-45f8-a2cd-3890b5993b8e"
    },
    {
      "id": "4ed36265-3d75-4e8d-a440-e2bff4461077",
      "text": "Khi CHÚA dẫn tù nhân Xi-on trở về,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:52.268Z",
      "updatedAt": "2025-09-03T02:37:52.268Z",
      "chapterId": "ed557ccd-1fb8-45f8-a2cd-3890b5993b8e"
    },
    {
      "id": "5ffdf41c-317f-4d3b-8bc4-8304e9340e12",
      "text": "ta tưởng mình như giữa giấc mơ.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:52.305Z",
      "updatedAt": "2025-09-03T02:37:52.305Z",
      "chapterId": "ed557ccd-1fb8-45f8-a2cd-3890b5993b8e"
    },
    {
      "id": "7da2f3a8-af01-42cf-9d68-723734439e22",
      "text": "Vang vang ngoài miệng câu cười nói,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:52.319Z",
      "updatedAt": "2025-09-03T02:37:52.319Z",
      "chapterId": "ed557ccd-1fb8-45f8-a2cd-3890b5993b8e"
    },
    {
      "id": "f1062646-0536-495a-a172-68f2d3023317",
      "text": "rộn rã trên môi khúc nhạc mừng.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:52.333Z",
      "updatedAt": "2025-09-03T02:37:52.333Z",
      "chapterId": "ed557ccd-1fb8-45f8-a2cd-3890b5993b8e"
    },
    {
      "id": "a0d132ae-dd70-4c6a-a5ea-da9896cc91f8",
      "text": "Bấy giờ trong dân ngoại, người ta bàn tán :",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:52.349Z",
      "updatedAt": "2025-09-03T02:37:52.349Z",
      "chapterId": "ed557ccd-1fb8-45f8-a2cd-3890b5993b8e"
    },
    {
      "id": "10b9545d-4e97-4a60-b1d4-a7ede30028de",
      "text": "“Việc CHÚA làm cho họ, vĩ đại thay !”",
      "label": "2",
      "number": 2,
      "subVerseIndex": 3,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:52.363Z",
      "updatedAt": "2025-09-03T02:37:52.363Z",
      "chapterId": "ed557ccd-1fb8-45f8-a2cd-3890b5993b8e"
    },
    {
      "id": "67f737dd-8a6f-4651-aac5-c448963583a6",
      "text": "Việc CHÚA làm cho ta, ôi vĩ đại !",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:52.377Z",
      "updatedAt": "2025-09-03T02:37:52.377Z",
      "chapterId": "ed557ccd-1fb8-45f8-a2cd-3890b5993b8e"
    },
    {
      "id": "191c9158-39f8-40ba-89ee-d67184187092",
      "text": "Ta thấy mình chan chứa một niềm vui.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:52.391Z",
      "updatedAt": "2025-09-03T02:37:52.391Z",
      "chapterId": "ed557ccd-1fb8-45f8-a2cd-3890b5993b8e"
    },
    {
      "id": "8d5c9155-615d-445d-92a5-427579247524",
      "text": "Lạy CHÚA, xin dẫn tù nhân chúng con về,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:52.405Z",
      "updatedAt": "2025-09-03T02:37:52.405Z",
      "chapterId": "ed557ccd-1fb8-45f8-a2cd-3890b5993b8e"
    },
    {
      "id": "992789fb-d601-4dc8-9fdf-1273ca328c9c",
      "text": "như mưa dẫn nước về suối cạn miền Nam.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:52.419Z",
      "updatedAt": "2025-09-03T02:37:52.419Z",
      "chapterId": "ed557ccd-1fb8-45f8-a2cd-3890b5993b8e"
    },
    {
      "id": "e264c17b-cf81-43bc-a40b-4b64aba4431b",
      "text": "Ai nghẹn ngào ra đi gieo giống,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:52.448Z",
      "updatedAt": "2025-09-03T02:37:52.448Z",
      "chapterId": "ed557ccd-1fb8-45f8-a2cd-3890b5993b8e"
    },
    {
      "id": "8a218cb2-74e8-4563-a216-604d77ffda8f",
      "text": "mùa gặt mai sau khấp khởi mừng.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:52.489Z",
      "updatedAt": "2025-09-03T02:37:52.489Z",
      "chapterId": "ed557ccd-1fb8-45f8-a2cd-3890b5993b8e"
    },
    {
      "id": "89b51bcb-ce50-49d8-9897-a91239f15658",
      "text": "Họ ra đi, đi mà nức nở, mang hạt giống vãi gieo ;",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:52.503Z",
      "updatedAt": "2025-09-03T02:37:52.503Z",
      "chapterId": "ed557ccd-1fb8-45f8-a2cd-3890b5993b8e"
    },
    {
      "id": "65eab031-65c2-41aa-a094-3a4e8bf071de",
      "text": "lúc trở về, về reo hớn hở, vai nặng gánh lúa vàng.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:52.517Z",
      "updatedAt": "2025-09-03T02:37:52.517Z",
      "chapterId": "ed557ccd-1fb8-45f8-a2cd-3890b5993b8e"
    }
  ],
  "marks": [
    {
      "id": "038afed1-d035-4d4b-94ea-b9d694d6ff23",
      "content": "Tv 126 là *một ai ca của tập thể* được diễn tả theo trình tự sau đây : **1**) Gợi nhớ niềm vui và bầu khí phấn khởi của cộng đoàn Ít-ra-en hồi hương sau thời lưu đày tại Ba-by-lon (cc. 1-3) ; **2**) Cầu xin Chúa giải thoát dân khỏi những khó khăn hiện tại (c.4) ; **3**) Đặt niềm hy vọng vào Chúa : Người sẽ cho tiếng cười rộn rã thay tiếng khóc bi ai (cc. 5-6).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 45,
      "endOffset": 45,
      "createdAt": "2025-09-03T02:37:52.257Z",
      "updatedAt": "2025-09-03T02:37:52.257Z",
