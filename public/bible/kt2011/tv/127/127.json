    {
      "id": "8ad66e9f-843a-4dfc-8caf-bfab8119cef5",
      "content": "Tv 128,3 b",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:37:58.073Z",
