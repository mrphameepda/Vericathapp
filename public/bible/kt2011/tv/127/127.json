    },
    {
      "id": "cdfb43b8-d2ea-4bde-96b1-a45100f2cd90",
      "content": "*Khó nhọc làm ăn*, ds : *những kẻ ăn bánh lầm than đau khổ*. Ân huệ thứ nhất : cơm bánh là thứ mà con người phải vất vả nhiều mới kiếm được.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 15,
      "endOffset": 15,
      "createdAt": "2025-09-03T02:37:58.011Z",
      "updatedAt": "2025-09-03T02:37:58.011Z",
      "targetId": "8d505de4-630a-4c5b-bc25-fcc4426bd711",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "009978f3-fb7a-4628-b40f-005712d647d0"
    },
    {
      "id": "765eded1-aef0-4bca-b316-8242a41c81c0",
      "content": "Là hồng ân quý giá nhất Thiên Chúa ban, con cái trở thành phương thế kéo dài sự sống. Đàng khác, có nhiều con cái là có nhiều người bênh vực mình khi phải ra toà (c.5).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 40,
      "endOffset": 40,
      "createdAt": "2025-09-03T02:37:58.101Z",
      "updatedAt": "2025-09-03T02:37:58.101Z",
      "targetId": "3cd13a94-552e-47b7-bf6b-d4d00bb74304",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "009978f3-fb7a-4628-b40f-005712d647d0"
    }
  ],
