{
  "chapter": {
    "id": "009978f3-fb7a-4628-b40f-005712d647d0",
    "number": 127,
    "createdAt": "2025-09-03T01:07:51.662Z",
    "updatedAt": "2025-09-03T01:07:51.662Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "88730515-6633-430c-aad3-42c772394d8e",
      "text": "*Ca khúc lên Đền. Của vua Sa-lô-môn.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:37:57.858Z",
      "updatedAt": "2025-09-03T02:37:57.858Z",
      "chapterId": "009978f3-fb7a-4628-b40f-005712d647d0"
    },
    {
      "id": "7c169945-b73b-4926-b090-12fff9bc824d",
      "text": "Ví như CHÚA chẳng xây nhà,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:57.918Z",
      "updatedAt": "2025-09-03T02:37:57.918Z",
      "chapterId": "009978f3-fb7a-4628-b40f-005712d647d0"
    },
    {
      "id": "1b47c433-3430-4be2-9f0a-fdaaf90859c6",
      "text": "thợ nề vất vả cũng là uổng công.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:57.942Z",
      "updatedAt": "2025-09-03T02:37:57.942Z",
      "chapterId": "009978f3-fb7a-4628-b40f-005712d647d0"
    },
    {
      "id": "637a48b3-260f-477d-8ed2-3c72ccc2879c",
      "text": "Thành kia mà CHÚA không phòng giữ,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 3,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:57.956Z",
      "updatedAt": "2025-09-03T02:37:57.956Z",
      "chapterId": "009978f3-fb7a-4628-b40f-005712d647d0"
    },
    {
      "id": "10af86dd-a894-4454-99b7-b0c1a207ac0d",
      "text": "uổng công người trấn thủ canh đêm.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 4,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:57.969Z",
      "updatedAt": "2025-09-03T02:37:57.969Z",
      "chapterId": "009978f3-fb7a-4628-b40f-005712d647d0"
    },
    {
      "id": "6e4235a3-38b7-45af-9263-e3c67a2cd8df",
      "text": "Bạn có thức khuya hay dậy sớm,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:57.983Z",
      "updatedAt": "2025-09-03T02:37:57.983Z",
      "chapterId": "009978f3-fb7a-4628-b40f-005712d647d0"
    },
    {
      "id": "8d505de4-630a-4c5b-bc25-fcc4426bd711",
      "text": "khó nhọc làm ăn cũng hoài công.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:57.997Z",
      "updatedAt": "2025-09-03T02:37:57.997Z",
      "chapterId": "009978f3-fb7a-4628-b40f-005712d647d0"
    },
    {
      "id": "2601bde6-24ee-4297-a67f-d55a7851efff",
      "text": "Còn kẻ được Chúa thương dầu có ngủ,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:58.025Z",
      "updatedAt": "2025-09-03T02:37:58.025Z",
      "chapterId": "009978f3-fb7a-4628-b40f-005712d647d0"
    },
    {
      "id": "486d3215-b3c7-4e54-a73f-aae48c571dfa",
      "text": "Người vẫn ban cho đủ tiêu dùng.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 3,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:58.039Z",
      "updatedAt": "2025-09-03T02:37:58.039Z",
      "chapterId": "009978f3-fb7a-4628-b40f-005712d647d0"
    },
    {
      "id": "f1f19150-924c-48dc-89db-faa5d2c56f94",
      "text": "Này con cái là hồng ân của CHÚA,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:58.056Z",
      "updatedAt": "2025-09-03T02:37:58.056Z",
      "chapterId": "009978f3-fb7a-4628-b40f-005712d647d0"
    },
    {
      "id": "3cd13a94-552e-47b7-bf6b-d4d00bb74304",
      "text": "con mình sinh hạ là phần thưởng Chúa ban.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:58.087Z",
      "updatedAt": "2025-09-03T02:37:58.087Z",
      "chapterId": "009978f3-fb7a-4628-b40f-005712d647d0"
    },
    {
      "id": "2f583b8f-84d8-485a-a463-a5318dd8ce43",
      "text": "Bầy con sinh hạ thời son trẻ",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:58.114Z",
      "updatedAt": "2025-09-03T02:37:58.114Z",
      "chapterId": "009978f3-fb7a-4628-b40f-005712d647d0"
    },
    {
      "id": "f1ad52fe-4fa2-4ae7-9862-ad5841b2671f",
      "text": "tựa nắm tên người dũng sĩ cầm tay.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:58.128Z",
      "updatedAt": "2025-09-03T02:37:58.128Z",
      "chapterId": "009978f3-fb7a-4628-b40f-005712d647d0"
    },
    {
      "id": "5ddbe00e-049f-48fb-a3e3-9d612dc78d2e",
      "text": "Hạnh phúc thay người nào",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:58.142Z",
      "updatedAt": "2025-09-03T02:37:58.142Z",
      "chapterId": "009978f3-fb7a-4628-b40f-005712d647d0"
    },
    {
      "id": "955565d0-b31f-4476-a07e-7ee403cf7dde",
      "text": "đeo ống đầy loại tên như thế !",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:58.155Z",
      "updatedAt": "2025-09-03T02:37:58.155Z",
      "chapterId": "009978f3-fb7a-4628-b40f-005712d647d0"
    },
    {
      "id": "0377308a-05ad-4b3e-8e4e-be1361ae816b",
      "text": "Họ sẽ không nhục nhã",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:58.167Z",
      "updatedAt": "2025-09-03T02:37:58.167Z",
      "chapterId": "009978f3-fb7a-4628-b40f-005712d647d0"
    },
    {
      "id": "fd35e7e1-50a7-4e3d-be28-3c29e1b8f528",
      "text": "khi phải đến cửa công",
      "label": "5",
      "number": 5,
      "subVerseIndex": 3,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:58.177Z",
      "updatedAt": "2025-09-03T02:37:58.177Z",
      "chapterId": "009978f3-fb7a-4628-b40f-005712d647d0"
    },
    {
      "id": "939a4da8-9130-4210-8ea6-465fe75abab6",
      "text": "tranh tụng với địch thù.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 4,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:37:58.187Z",
      "updatedAt": "2025-09-03T02:37:58.187Z",
      "chapterId": "009978f3-fb7a-4628-b40f-005712d647d0"
    }
  ],
  "marks": [
    {
      "id": "c4866694-25bb-44b0-ae62-6905db8c0e5e",
      "content": "Theo *Tv giáo huấn* này, con người không thể thành công khi phải lao nhọc vất vả, nếu Thiên Chúa không can thiệp. Có hai loại của quý báu Thiên Chúa ban : cơm bánh (c.2) và con cái (cc. 3-5).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 53,
      "endOffset": 53,
      "createdAt": "2025-09-03T02:37:57.897Z",
      "updatedAt": "2025-09-03T02:37:57.897Z",
