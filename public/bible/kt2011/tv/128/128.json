{
  "chapter": {
    "id": "99f3b8d6-ac70-4f9c-adf6-c10cc94067f9",
    "number": 128,
    "createdAt": "2025-09-03T01:07:51.662Z",
    "updatedAt": "2025-09-03T01:07:51.662Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "b3ca5004-6f23-43c9-967a-121e9ad24d26",
      "text": "*Ca khúc lên Đền.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:38:03.493Z",
      "updatedAt": "2025-09-03T02:38:03.493Z",
      "chapterId": "99f3b8d6-ac70-4f9c-adf6-c10cc94067f9"
    },
    {
      "id": "99f713b7-8909-403c-b9c5-b236f6c5ab27",
      "text": "Hạnh phúc thay bạn nào kính sợ CHÚA,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:03.533Z",
      "updatedAt": "2025-09-03T02:38:03.533Z",
      "chapterId": "99f3b8d6-ac70-4f9c-adf6-c10cc94067f9"
    },
    {
      "id": "be064b07-d662-4c9b-8ae7-5652f8dfd391",
      "text": "ăn ở theo đường lối của Người.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:03.556Z",
      "updatedAt": "2025-09-03T02:38:03.556Z",
      "chapterId": "99f3b8d6-ac70-4f9c-adf6-c10cc94067f9"
    },
    {
      "id": "bb9bedbc-39e2-46e3-9af7-5a2c0da73977",
      "text": "Công khó tay bạn làm, bạn được an hưởng,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:03.574Z",
      "updatedAt": "2025-09-03T02:38:03.574Z",
      "chapterId": "99f3b8d6-ac70-4f9c-adf6-c10cc94067f9"
    },
    {
      "id": "e1e33bce-51fd-4ebb-98db-997f06f8f628",
      "text": "bạn quả là lắm phúc nhiều may.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:03.592Z",
      "updatedAt": "2025-09-03T02:38:03.592Z",
      "chapterId": "99f3b8d6-ac70-4f9c-adf6-c10cc94067f9"
    },
    {
      "id": "073ced65-e749-4c37-967e-eae3189b768a",
      "text": "Hiền thê bạn trong cửa trong nhà",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:03.603Z",
      "updatedAt": "2025-09-03T02:38:03.603Z",
      "chapterId": "99f3b8d6-ac70-4f9c-adf6-c10cc94067f9"
    },
    {
      "id": "d2574e20-3ae5-49bb-9ac0-9ed3b524ae88",
      "text": "khác nào cây nho đầy hoa trái ;",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:03.614Z",
      "updatedAt": "2025-09-03T02:38:03.614Z",
      "chapterId": "99f3b8d6-ac70-4f9c-adf6-c10cc94067f9"
    },
    {
      "id": "13b36e3d-1bfc-4870-8326-2b036c34e4c3",
      "text": "và bầy con tựa những cây ô-liu mơn mởn,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:03.624Z",
      "updatedAt": "2025-09-03T02:38:03.624Z",
      "chapterId": "99f3b8d6-ac70-4f9c-adf6-c10cc94067f9"
    },
    {
      "id": "7ebaa026-c9c9-45bf-a207-4f23eedd6678",
      "text": "xúm xít tại bàn ăn.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 3,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:03.649Z",
      "updatedAt": "2025-09-03T02:38:03.649Z",
      "chapterId": "99f3b8d6-ac70-4f9c-adf6-c10cc94067f9"
    },
    {
      "id": "e6bd44f0-4e3e-4158-8021-97cab7369a65",
      "text": "Đó chính là phúc lộc CHÚA dành cho kẻ kính sợ Người.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:03.661Z",
      "updatedAt": "2025-09-03T02:38:03.661Z",
      "chapterId": "99f3b8d6-ac70-4f9c-adf6-c10cc94067f9"
    },
    {
      "id": "a5e13d6e-2548-4909-b1ea-27660b9cc39e",
      "text": "Xin CHÚA từ Xi-on xuống cho bạn muôn vàn ơn phúc.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:03.674Z",
      "updatedAt": "2025-09-03T02:38:03.674Z",
      "chapterId": "99f3b8d6-ac70-4f9c-adf6-c10cc94067f9"
    },
    {
      "id": "470c857e-73ef-4e4c-a573-1c08800a7825",
      "text": "Ước chi trong suốt cả cuộc đời",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:03.737Z",
      "updatedAt": "2025-09-03T02:38:03.737Z",
      "chapterId": "99f3b8d6-ac70-4f9c-adf6-c10cc94067f9"
    },
    {
      "id": "9eef8f6f-1e3d-4aa1-9757-d3c7c44a2ba7",
      "text": "bạn được thấy Giê-ru-sa-lem phồn thịnh,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:03.751Z",
      "updatedAt": "2025-09-03T02:38:03.751Z",
      "chapterId": "99f3b8d6-ac70-4f9c-adf6-c10cc94067f9"
    },
    {
      "id": "cca1025f-dd38-4f0d-9307-17d8cc9d57f8",
      "text": "được sống lâu bên đàn con cháu.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:03.792Z",
      "updatedAt": "2025-09-03T02:38:03.792Z",
      "chapterId": "99f3b8d6-ac70-4f9c-adf6-c10cc94067f9"
    },
    {
      "id": "541552fa-69bb-4d28-8449-cb33fdd50fad",
      "text": "Nguyện chúc Ít-ra-en vui hưởng thái bình.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:03.820Z",
      "updatedAt": "2025-09-03T02:38:03.820Z",
      "chapterId": "99f3b8d6-ac70-4f9c-adf6-c10cc94067f9"
    }
  ],
  "marks": [
    {
