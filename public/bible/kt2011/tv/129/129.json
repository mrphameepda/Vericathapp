    {
      "id": "b62ff6e5-22b1-426e-86ac-d095c6b35561",
      "content": "Hình ảnh này dùng để chỉ những vết thương mà kẻ thù đã gây cho Dân Chúa.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
