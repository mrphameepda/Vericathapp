{
  "chapter": {
    "id": "dcdfa160-48f0-4082-9817-6be3378da5b1",
    "number": 129,
    "createdAt": "2025-09-03T01:07:51.662Z",
    "updatedAt": "2025-09-03T01:07:51.662Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "3b8ff507-d4d7-4d86-b8f8-3f280248ae6c",
      "text": "*Ca khúc lên Đền.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:38:09.745Z",
      "updatedAt": "2025-09-03T02:38:09.745Z",
      "chapterId": "dcdfa160-48f0-4082-9817-6be3378da5b1"
    },
    {
      "id": "1753f30b-da21-4ada-a529-91ac447c7b92",
      "text": "Từ lúc tôi còn trẻ, chúng hà hiếp tôi nhiều,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:09.793Z",
      "updatedAt": "2025-09-03T02:38:09.793Z",
      "chapterId": "dcdfa160-48f0-4082-9817-6be3378da5b1"
    },
    {
      "id": "b1e8dd11-c8c8-414c-95bc-dc236c84a5eb",
      "text": "Ít-ra-en hãy nói lên điều đó.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:09.807Z",
      "updatedAt": "2025-09-03T02:38:09.807Z",
      "chapterId": "dcdfa160-48f0-4082-9817-6be3378da5b1"
    },
    {
      "id": "de60d2c6-9383-4e5d-8516-144a608cf621",
      "text": "Từ lúc tôi còn trẻ, chúng hà hiếp tôi nhiều,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:09.849Z",
      "updatedAt": "2025-09-03T02:38:09.849Z",
      "chapterId": "dcdfa160-48f0-4082-9817-6be3378da5b1"
    },
    {
      "id": "32aee0e9-7000-4753-b4e7-778950a4ef5e",
      "text": "nhưng đã không hề thắng được tôi.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:09.863Z",
      "updatedAt": "2025-09-03T02:38:09.863Z",
      "chapterId": "dcdfa160-48f0-4082-9817-6be3378da5b1"
    },
    {
      "id": "dd565d31-117d-4616-8de2-407c918e404f",
      "text": "Trên lưng này, chúng cày ngang cày dọc,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:09.877Z",
      "updatedAt": "2025-09-03T02:38:09.877Z",
      "chapterId": "dcdfa160-48f0-4082-9817-6be3378da5b1"
    },
    {
      "id": "aeb472c7-f97a-4806-a14c-7d776e7de3e8",
      "text": "đào xới lên những luống thật dài.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:09.891Z",
      "updatedAt": "2025-09-03T02:38:09.891Z",
      "chapterId": "dcdfa160-48f0-4082-9817-6be3378da5b1"
    },
    {
      "id": "e9bdab20-c4cd-434d-90cd-9b64b6c8dc0f",
      "text": "Nhưng mà CHÚA công minh",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:09.919Z",
      "updatedAt": "2025-09-03T02:38:09.919Z",
      "chapterId": "dcdfa160-48f0-4082-9817-6be3378da5b1"
    },
    {
      "id": "d92ab3b2-3f69-460b-8618-cb2e8491fd02",
      "text": "đã chặt đứt chão thừng quân gian ác.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:09.933Z",
      "updatedAt": "2025-09-03T02:38:09.933Z",
      "chapterId": "dcdfa160-48f0-4082-9817-6be3378da5b1"
    },
    {
      "id": "84065df7-f306-4b37-af66-351b0343608c",
      "text": "Ước chi những kẻ thù Xi-on",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:09.962Z",
      "updatedAt": "2025-09-03T02:38:09.962Z",
      "chapterId": "dcdfa160-48f0-4082-9817-6be3378da5b1"
    },
    {
      "id": "842b2323-f08d-4fad-afe9-16f0d71340c0",
      "text": "đều nhục nhã tháo lui hết thảy,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:09.990Z",
      "updatedAt": "2025-09-03T02:38:09.990Z",
      "chapterId": "dcdfa160-48f0-4082-9817-6be3378da5b1"
    },
    {
      "id": "da607cf7-adcc-4989-9153-1feae09b19cd",
      "text": "và nên như cỏ mọc mái nhà",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:10.018Z",
      "updatedAt": "2025-09-03T02:38:10.018Z",
      "chapterId": "dcdfa160-48f0-4082-9817-6be3378da5b1"
    },
    {
      "id": "7528d19d-d70b-4898-ba75-fbaec77828bf",
      "text": "chưa ai nhổ mà đã héo khô !",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:10.031Z",
      "updatedAt": "2025-09-03T02:38:10.031Z",
      "chapterId": "dcdfa160-48f0-4082-9817-6be3378da5b1"
    },
    {
      "id": "31728755-2625-493e-a304-78695621523b",
      "text": "Tay thợ gặt không lượm chi thứ đó,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:10.044Z",
      "updatedAt": "2025-09-03T02:38:10.044Z",
      "chapterId": "dcdfa160-48f0-4082-9817-6be3378da5b1"
    },
    {
      "id": "0f53720a-59e4-40a2-95e7-6066bc3af3e9",
      "text": "cả người bó lúa cũng chẳng ôm về.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:10.056Z",
      "updatedAt": "2025-09-03T02:38:10.056Z",
      "chapterId": "dcdfa160-48f0-4082-9817-6be3378da5b1"
    },
    {
      "id": "a064e7b3-c172-404e-a66b-5623ac02aacb",
      "text": "Khách qua đường không ai chào hỏi chúng :",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:10.068Z",
      "updatedAt": "2025-09-03T02:38:10.068Z",
      "chapterId": "dcdfa160-48f0-4082-9817-6be3378da5b1"
    },
    {
      "id": "635f3ee9-791d-4bf2-9da8-b3b881904a2c",
      "text": "CHÚA ban phúc lành cho anh em.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:10.081Z",
      "updatedAt": "2025-09-03T02:38:10.081Z",
      "chapterId": "dcdfa160-48f0-4082-9817-6be3378da5b1"
    },
    {
      "id": "234023ed-6886-4164-beb3-af75faeb65da",
      "text": "Chúng tôi chúc lành cho anh em nhân danh CHÚA.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:10.093Z",
      "updatedAt": "2025-09-03T02:38:10.093Z",
      "chapterId": "dcdfa160-48f0-4082-9817-6be3378da5b1"
    }
  ],
  "marks": [
    {
      "id": "9d089a30-d787-402c-b49f-5e0c6079df43",
      "content": "Biết bao lần trong quá khứ, dân Chúa bị quấy nhiễu và áp bức, nhưng vẫn cậy trông vào Chúa là Đấng đã cứu mình và sẽ làm cho kẻ thù phải nhục nhã. *Tv tín nhiệm* này chia làm ba phần : **1**) Những thử thách trong quá khứ (cc. 1-4) ; **2**) Lời cầu xin Chúa dẹp tan kẻ thù (cc. 5-8b) ; **3**) Câu kết (c. 8c).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 56,
      "endOffset": 56,
      "createdAt": "2025-09-03T02:38:09.779Z",
