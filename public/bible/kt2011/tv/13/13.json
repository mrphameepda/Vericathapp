{
  "chapter": {
    "id": "07cb0adc-c3fa-45af-aba4-af041c1b9f52",
    "number": 13,
    "createdAt": "2025-09-03T01:07:51.660Z",
    "updatedAt": "2025-09-03T01:07:51.660Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "0994f9c5-88b3-4c94-8765-d9bc05e35435",
      "text": "*Phần ca trưởng. Thánh vịnh. Của vua Đa-vít.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:25:48.780Z",
      "updatedAt": "2025-09-03T02:25:48.780Z",
      "chapterId": "07cb0adc-c3fa-45af-aba4-af041c1b9f52"
    },
    {
      "id": "85b6ae8d-cda1-4eda-90ea-d04b20fb00ee",
      "text": "Lạy CHÚA, Ngài quên con mãi tới bao giờ ?",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:48.841Z",
      "updatedAt": "2025-09-03T02:25:48.841Z",
      "chapterId": "07cb0adc-c3fa-45af-aba4-af041c1b9f52"
    },
    {
      "id": "0339ffbb-1920-40f3-be1d-660d8fb0a6ad",
      "text": "Tới bao giờ còn ngoảnh mặt làm ngơ ?",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:48.853Z",
      "updatedAt": "2025-09-03T02:25:48.853Z",
      "chapterId": "07cb0adc-c3fa-45af-aba4-af041c1b9f52"
    },
    {
      "id": "2699f3f6-88cb-4377-aac4-c569b18499ef",
      "text": "Tới bao giờ hồn con vẫn còn lo lắng",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:48.880Z",
      "updatedAt": "2025-09-03T02:25:48.880Z",
      "chapterId": "07cb0adc-c3fa-45af-aba4-af041c1b9f52"
    },
    {
      "id": "7f9d1fab-2b26-4846-a47c-3a653b49117a",
      "text": "và lòng con ủ rũ đêm ngày ?",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:48.894Z",
      "updatedAt": "2025-09-03T02:25:48.894Z",
      "chapterId": "07cb0adc-c3fa-45af-aba4-af041c1b9f52"
    },
    {
      "id": "82697b82-34dc-4df3-95b0-1e13a20f0a61",
      "text": "Tới bao giờ kẻ thù con thắng mãi ?",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:48.908Z",
      "updatedAt": "2025-09-03T02:25:48.908Z",
      "chapterId": "07cb0adc-c3fa-45af-aba4-af041c1b9f52"
    },
    {
      "id": "86f4f2a5-dc27-4a7f-b795-9644705ede8f",
      "text": "Lạy CHÚA là Thiên Chúa của con,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:48.922Z",
      "updatedAt": "2025-09-03T02:25:48.922Z",
      "chapterId": "07cb0adc-c3fa-45af-aba4-af041c1b9f52"
    },
    {
      "id": "495f2cbe-8f43-4919-8a40-3d52e00257af",
      "text": "xin đoái nhìn và thương đáp lại,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:48.936Z",
      "updatedAt": "2025-09-03T02:25:48.936Z",
      "chapterId": "07cb0adc-c3fa-45af-aba4-af041c1b9f52"
    },
    {
      "id": "dfae646d-a709-48e7-8139-70220b186634",
      "text": "toả ánh sáng cho đôi mắt rạng ngời,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:48.950Z",
      "updatedAt": "2025-09-03T02:25:48.950Z",
      "chapterId": "07cb0adc-c3fa-45af-aba4-af041c1b9f52"
    },
    {
      "id": "dc8d54d7-3b11-43f0-aa5d-87cbaca488da",
      "text": "để con khỏi ngủ giấc ngàn thu ;",
      "label": "4",
      "number": 4,
      "subVerseIndex": 3,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:48.964Z",
      "updatedAt": "2025-09-03T02:25:48.964Z",
      "chapterId": "07cb0adc-c3fa-45af-aba4-af041c1b9f52"
    },
    {
      "id": "b6e86105-9760-4a2e-932a-3fe1d5fd220d",
      "text": "để kẻ thù con không thể nói : “Ta đã thắng nó rồi”,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:48.979Z",
      "updatedAt": "2025-09-03T02:25:48.979Z",
      "chapterId": "07cb0adc-c3fa-45af-aba4-af041c1b9f52"
    },
    {
      "id": "a68045be-cbd2-4e64-9583-a6ccd29ac41a",
      "text": "và đối thủ không được mừng vui vì thấy con gục ngã.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:48.993Z",
      "updatedAt": "2025-09-03T02:25:48.993Z",
      "chapterId": "07cb0adc-c3fa-45af-aba4-af041c1b9f52"
    },
    {
      "id": "a4c5b4fc-5184-4d05-8822-2a7b5f36128b",
      "text": "Phần con đây, con tin cậy vào tình thương CHÚA,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:49.013Z",
      "updatedAt": "2025-09-03T02:25:49.013Z",
      "chapterId": "07cb0adc-c3fa-45af-aba4-af041c1b9f52"
    },
    {
      "id": "3fb0697d-b0fd-4b5c-a832-bbe73a550cc5",
      "text": "được Ngài cứu độ, lòng con sẽ vui mừng.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:49.027Z",
      "updatedAt": "2025-09-03T02:25:49.027Z",
      "chapterId": "07cb0adc-c3fa-45af-aba4-af041c1b9f52"
    },
    {
      "id": "5fe224a4-88a5-44d9-829c-8bd327ae76d3",
      "text": "Con sẽ hát bài ca dâng CHÚA, vì phúc lộc Ngài ban.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:49.041Z",
      "updatedAt": "2025-09-03T02:25:49.041Z",
      "chapterId": "07cb0adc-c3fa-45af-aba4-af041c1b9f52"
    }
  ],
