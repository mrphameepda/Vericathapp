{
  "chapter": {
    "id": "ff1781aa-557d-4f49-afaf-eb6f2e44f372",
    "number": 131,
    "createdAt": "2025-09-03T01:07:51.662Z",
    "updatedAt": "2025-09-03T01:07:51.662Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "d687255e-0b5a-4897-a5fb-bf6804c304f8",
      "text": "*Ca khúc lên Đền. Của vua Đa-vít.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:38:21.860Z",
      "updatedAt": "2025-09-03T02:38:21.860Z",
      "chapterId": "ff1781aa-557d-4f49-afaf-eb6f2e44f372"
    },
    {
      "id": "422be0ec-bb13-47c8-a98a-8f297eb69d70",
      "text": "Lòng con chẳng dám tự cao,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:21.913Z",
      "updatedAt": "2025-09-03T02:38:21.913Z",
      "chapterId": "ff1781aa-557d-4f49-afaf-eb6f2e44f372"
    },
    {
      "id": "2e9d5342-5620-4865-ad27-bf22109169f4",
      "text": "mắt con chẳng dám tự hào, CHÚA ơi !",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:21.925Z",
      "updatedAt": "2025-09-03T02:38:21.925Z",
      "chapterId": "ff1781aa-557d-4f49-afaf-eb6f2e44f372"
    },
    {
      "id": "164d9ebc-7ed1-49a9-92b2-0307e20d7082",
      "text": "Đường cao vọng, chẳng đời nào bước,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 3,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:21.939Z",
      "updatedAt": "2025-09-03T02:38:21.939Z",
      "chapterId": "ff1781aa-557d-4f49-afaf-eb6f2e44f372"
    },
    {
      "id": "cc25bf97-9dba-457e-b93d-6abd7708c19b",
      "text": "việc diệu kỳ vượt sức, chẳng cầu ;",
      "label": "1",
      "number": 1,
      "subVerseIndex": 4,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:21.952Z",
      "updatedAt": "2025-09-03T02:38:21.952Z",
      "chapterId": "ff1781aa-557d-4f49-afaf-eb6f2e44f372"
    },
    {
      "id": "2ee56684-edcc-4723-aa61-e7e9732e3285",
      "text": "hồn con, con vẫn trước sau",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:21.967Z",
      "updatedAt": "2025-09-03T02:38:21.967Z",
      "chapterId": "ff1781aa-557d-4f49-afaf-eb6f2e44f372"
    },
    {
      "id": "ab440cae-c355-49b4-bb28-5ef1d8c7c209",
      "text": "giữ cho thinh lặng, giữ sao thanh bình.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:21.980Z",
      "updatedAt": "2025-09-03T02:38:21.980Z",
      "chapterId": "ff1781aa-557d-4f49-afaf-eb6f2e44f372"
    },
    {
      "id": "e928ec18-fb5f-4608-98b5-78bfb79d94f4",
      "text": "Như trẻ thơ nép mình lòng mẹ,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:21.995Z",
      "updatedAt": "2025-09-03T02:38:21.995Z",
      "chapterId": "ff1781aa-557d-4f49-afaf-eb6f2e44f372"
    },
    {
      "id": "bf40b03e-6a6e-441b-94e4-a908ce9df24f",
      "text": "trong con, hồn lặng lẽ an vui.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 3,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:22.009Z",
      "updatedAt": "2025-09-03T02:38:22.009Z",
      "chapterId": "ff1781aa-557d-4f49-afaf-eb6f2e44f372"
    },
    {
      "id": "e0816630-609b-4548-a111-ba2a91055201",
      "text": "Cậy vào CHÚA, Ít-ra-en ơi,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:22.023Z",
      "updatedAt": "2025-09-03T02:38:22.023Z",
      "chapterId": "ff1781aa-557d-4f49-afaf-eb6f2e44f372"
    },
    {
      "id": "5c46c871-5813-447d-8650-9b0e6ff39862",
      "text": "từ nay đến mãi muôn đời muôn năm.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:22.064Z",
      "updatedAt": "2025-09-03T02:38:22.064Z",
      "chapterId": "ff1781aa-557d-4f49-afaf-eb6f2e44f372"
    }
  ],
