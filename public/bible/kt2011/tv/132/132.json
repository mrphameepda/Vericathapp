{
  "chapter": {
    "id": "cf8ca9a0-4f0d-4d6e-8962-abf963a16079",
    "number": 132,
    "createdAt": "2025-09-03T01:07:51.662Z",
    "updatedAt": "2025-09-03T01:07:51.662Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "71e57ef2-e3fb-479b-8e3a-4372ff4d612b",
      "text": "*Ca khúc lên Đền.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:38:27.838Z",
      "updatedAt": "2025-09-03T02:38:27.838Z",
      "chapterId": "cf8ca9a0-4f0d-4d6e-8962-abf963a16079"
    },
    {
      "id": "6fd6e730-6441-4eec-8163-3dbbc5dbbd54",
      "text": "Lạy CHÚA, xin Ngài nhớ đến vua Đa-vít",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:27.892Z",
      "updatedAt": "2025-09-03T02:38:27.892Z",
      "chapterId": "cf8ca9a0-4f0d-4d6e-8962-abf963a16079"
    },
    {
      "id": "daf497ef-4136-429c-8b86-fba86f492e6a",
      "text": "và mọi công lao vất vả của người :",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:27.920Z",
      "updatedAt": "2025-09-03T02:38:27.920Z",
      "chapterId": "cf8ca9a0-4f0d-4d6e-8962-abf963a16079"
    },
    {
      "id": "8b8fc05b-f4aa-43ea-bf70-fb267c25dfb8",
      "text": "chính người đã đoan thệ cùng ĐỨC CHÚA,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:27.933Z",
      "updatedAt": "2025-09-03T02:38:27.933Z",
      "chapterId": "cf8ca9a0-4f0d-4d6e-8962-abf963a16079"
    },
    {
      "id": "9fd25743-38e6-485d-b7b3-8c5836ef2c49",
      "text": "đã khấn hứa cùng Đấng Toàn Năng của Gia-cóp rằng :",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:27.962Z",
      "updatedAt": "2025-09-03T02:38:27.962Z",
      "chapterId": "cf8ca9a0-4f0d-4d6e-8962-abf963a16079"
    },
    {
      "id": "f732587e-b307-49ef-9567-1a91c83dc631",
      "text": "“Tôi quyết chẳng về nhà,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:28.004Z",
      "updatedAt": "2025-09-03T02:38:28.004Z",
      "chapterId": "cf8ca9a0-4f0d-4d6e-8962-abf963a16079"
    },
    {
      "id": "53525949-bddf-4d96-ba31-3184db7efb1b",
      "text": "chẳng lên giường nằm nghỉ,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:28.018Z",
      "updatedAt": "2025-09-03T02:38:28.018Z",
      "chapterId": "cf8ca9a0-4f0d-4d6e-8962-abf963a16079"
    },
    {
      "id": "1b8b433d-f43d-4dd2-bb68-f48677e4d11c",
      "text": "chẳng bao giờ chợp mắt khép mi,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:28.032Z",
      "updatedAt": "2025-09-03T02:38:28.032Z",
      "chapterId": "cf8ca9a0-4f0d-4d6e-8962-abf963a16079"
    },
    {
      "id": "f5aefc2d-7de5-491b-bae7-3856a9b636c1",
      "text": "khi chưa tìm được một nơi cho CHÚA ngự,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:28.047Z",
      "updatedAt": "2025-09-03T02:38:28.047Z",
      "chapterId": "cf8ca9a0-4f0d-4d6e-8962-abf963a16079"
    },
    {
      "id": "f837aaa4-592d-424a-ae34-f3d1c1ce8b7f",
      "text": "một ngôi đền cho Đấng Toàn Năng của Gia-cóp.”",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:28.073Z",
      "updatedAt": "2025-09-03T02:38:28.073Z",
      "chapterId": "cf8ca9a0-4f0d-4d6e-8962-abf963a16079"
    },
    {
      "id": "76b296b5-ba5c-47aa-8036-3fad7bedda3f",
      "text": "Này đây khi ở Ép-ra-tha,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:28.111Z",
      "updatedAt": "2025-09-03T02:38:28.111Z",
      "chapterId": "cf8ca9a0-4f0d-4d6e-8962-abf963a16079"
    },
    {
      "id": "b8937583-dde2-4944-98c8-ba02c3daf875",
      "text": "chúng tôi đã nghe nói đến hòm bia,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:28.151Z",
      "updatedAt": "2025-09-03T02:38:28.151Z",
      "chapterId": "cf8ca9a0-4f0d-4d6e-8962-abf963a16079"
    },
    {
      "id": "e38aeb53-1840-4e64-86ab-ee73df5ff460",
      "text": "chúng tôi tìm thấy hòm bia đó tại cánh đồng Gia-a.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:28.165Z",
      "updatedAt": "2025-09-03T02:38:28.165Z",
      "chapterId": "cf8ca9a0-4f0d-4d6e-8962-abf963a16079"
    },
    {
      "id": "6cafc96a-8390-433f-8437-9d6c3704e36e",
      "text": "Nào ta tiến vào nơi Chúa ngự,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:28.206Z",
      "updatedAt": "2025-09-03T02:38:28.206Z",
      "chapterId": "cf8ca9a0-4f0d-4d6e-8962-abf963a16079"
    },
    {
      "id": "e0913bd2-ac80-43d0-b5a0-83bebc3d3373",
      "text": "phủ phục trước bệ rồng.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:28.219Z",
      "updatedAt": "2025-09-03T02:38:28.219Z",
      "chapterId": "cf8ca9a0-4f0d-4d6e-8962-abf963a16079"
    },
    {
      "id": "4d934676-a479-4709-bca8-6ff9f94458e3",
      "text": "Lạy CHÚA, xin đứng dậy, để cùng với hòm bia oai linh Chúa",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:28.233Z",
      "updatedAt": "2025-09-03T02:38:28.233Z",
      "chapterId": "cf8ca9a0-4f0d-4d6e-8962-abf963a16079"
    },
    {
      "id": "4f904c69-5634-4dcd-8917-bb68f5113367",
      "text": "ngự về chốn nghỉ ngơi.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:28.261Z",
      "updatedAt": "2025-09-03T02:38:28.261Z",
      "chapterId": "cf8ca9a0-4f0d-4d6e-8962-abf963a16079"
    },
    {
      "id": "9897b3cb-3d9f-45d3-9c23-b5223d27c925",
      "text": "Ước chi hàng tư tế của Ngài mặc lấy sự công chính,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:28.274Z",
      "updatedAt": "2025-09-03T02:38:28.274Z",
      "chapterId": "cf8ca9a0-4f0d-4d6e-8962-abf963a16079"
    },
    {
      "id": "be910781-f755-44ee-ada7-5330e8a11df1",
      "text": "kẻ hiếu trung với Ngài được cất tiếng hò reo.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:28.288Z",
      "updatedAt": "2025-09-03T02:38:28.288Z",
      "chapterId": "cf8ca9a0-4f0d-4d6e-8962-abf963a16079"
    },
    {
      "id": "8eab2a7a-6615-4b0a-aa55-2ef3e60fabf3",
      "text": "Vì vua Đa-vít, trung thần của Chúa,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:28.302Z",
      "updatedAt": "2025-09-03T02:38:28.302Z",
      "chapterId": "cf8ca9a0-4f0d-4d6e-8962-abf963a16079"
    },
    {
      "id": "3ef487fe-9428-49bb-b1eb-51c4dcd10018",
      "text": "xin đừng xua đuổi đấng Chúa đã xức dầu phong vương.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:28.342Z",
      "updatedAt": "2025-09-03T02:38:28.342Z",
      "chapterId": "cf8ca9a0-4f0d-4d6e-8962-abf963a16079"
    },
    {
      "id": "32a34957-f6b7-4f64-a050-f273fe5d47d4",
      "text": "ĐỨC CHÚA đã thề cùng vua Đa-vít",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:28.355Z",
      "updatedAt": "2025-09-03T02:38:28.355Z",
      "chapterId": "cf8ca9a0-4f0d-4d6e-8962-abf963a16079"
    },
    {
      "id": "56e08662-4d5c-4a6c-84d8-642c8b37f94f",
      "text": "và sẽ không thất tín bao giờ,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:28.409Z",
      "updatedAt": "2025-09-03T02:38:28.409Z",
      "chapterId": "cf8ca9a0-4f0d-4d6e-8962-abf963a16079"
    },
    {
      "id": "917bb0d9-94ff-4144-a75d-4e33f34bc594",
      "text": "thề rằng : “Chính con ruột của ngươi,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:28.423Z",
      "updatedAt": "2025-09-03T02:38:28.423Z",
      "chapterId": "cf8ca9a0-4f0d-4d6e-8962-abf963a16079"
    },
    {
      "id": "8c375b7a-afb6-42dd-94fd-0e8e7b695163",
      "text": "Ta sẽ đặt lên thừa kế ngai vàng.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 3,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:28.437Z",
      "updatedAt": "2025-09-03T02:38:28.437Z",
      "chapterId": "cf8ca9a0-4f0d-4d6e-8962-abf963a16079"
    },
    {
      "id": "fa6cdffd-455e-429a-9e0a-0012ed1ebc49",
      "text": "Con cái ngươi mà giữ giao ước của Ta",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:28.464Z",
      "updatedAt": "2025-09-03T02:38:28.464Z",
      "chapterId": "cf8ca9a0-4f0d-4d6e-8962-abf963a16079"
    },
    {
      "id": "4f353226-5d0f-44aa-8760-0e259ba9f7a0",
      "text": "và mệnh lệnh Ta truyền cho chúng,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:28.478Z",
      "updatedAt": "2025-09-03T02:38:28.478Z",
      "chapterId": "cf8ca9a0-4f0d-4d6e-8962-abf963a16079"
    },
    {
      "id": "5fde0f24-ac8b-4d73-8243-bed15f00f991",
      "text": "thì con cái chúng đến muôn đời",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:28.489Z",
      "updatedAt": "2025-09-03T02:38:28.489Z",
      "chapterId": "cf8ca9a0-4f0d-4d6e-8962-abf963a16079"
    },
    {
      "id": "4255b0ba-1444-4bc4-98fc-00dc2055209f",
      "text": "cũng sẽ được lên kế vị ngươi !”",
      "label": "12",
      "number": 12,
      "subVerseIndex": 3,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:28.499Z",
      "updatedAt": "2025-09-03T02:38:28.499Z",
      "chapterId": "cf8ca9a0-4f0d-4d6e-8962-abf963a16079"
    },
    {
      "id": "2d69f567-a5ed-46f4-9706-b7019929805b",
      "text": "Vì ĐỨC CHÚA đã chọn Xi-on,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:28.510Z",
      "updatedAt": "2025-09-03T02:38:28.510Z",
      "chapterId": "cf8ca9a0-4f0d-4d6e-8962-abf963a16079"
    },
    {
      "id": "de3956bb-532e-4cae-b94d-e76362102352",
      "text": "đã thích lấy chốn này làm nơi Người ngự.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:28.540Z",
      "updatedAt": "2025-09-03T02:38:28.540Z",
      "chapterId": "cf8ca9a0-4f0d-4d6e-8962-abf963a16079"
    },
    {
      "id": "7ea9b0fd-1ec4-4d10-b7e3-9e7e5e9982fc",
      "text": "Người phán : “Đây là chốn Ta nghỉ ngơi đến muôn đời,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:28.550Z",
      "updatedAt": "2025-09-03T02:38:28.550Z",
      "chapterId": "cf8ca9a0-4f0d-4d6e-8962-abf963a16079"
    },
    {
      "id": "8d1595ed-e5d2-4b96-94ba-b02b67f72311",
      "text": "Ta sẽ ngự nơi này, vì Ta ưa thích.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:28.560Z",
      "updatedAt": "2025-09-03T02:38:28.560Z",
      "chapterId": "cf8ca9a0-4f0d-4d6e-8962-abf963a16079"
    },
    {
      "id": "5f4a7336-74c1-4410-9330-da157142c5ec",
      "text": "Ta sẽ đổ xuống muôn hồng ân,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:28.570Z",
      "updatedAt": "2025-09-03T02:38:28.570Z",
      "chapterId": "cf8ca9a0-4f0d-4d6e-8962-abf963a16079"
    },
    {
      "id": "f1245433-af57-45f8-84d0-e94a28660ca2",
      "text": "cho Xi-on được lương thực dồi dào,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:28.580Z",
      "updatedAt": "2025-09-03T02:38:28.580Z",
      "chapterId": "cf8ca9a0-4f0d-4d6e-8962-abf963a16079"
    },
    {
      "id": "9f82e71d-4db8-4f41-92b0-bad36102fad4",
      "text": "và ban cho kẻ nghèo được no nê cơm bánh.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 2,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:28.600Z",
      "updatedAt": "2025-09-03T02:38:28.600Z",
      "chapterId": "cf8ca9a0-4f0d-4d6e-8962-abf963a16079"
    },
    {
      "id": "6d609bf3-230c-490a-ae5d-8748d2bbb87d",
      "text": "Ta sẽ cho hàng tư tế mặc lấy ơn cứu độ",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:28.610Z",
      "updatedAt": "2025-09-03T02:38:28.610Z",
      "chapterId": "cf8ca9a0-4f0d-4d6e-8962-abf963a16079"
    },
    {
      "id": "60867061-feac-4466-adbe-b54eca24ff73",
      "text": "và kẻ hiếu trung sẽ vui sướng reo hò.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:28.631Z",
      "updatedAt": "2025-09-03T02:38:28.631Z",
      "chapterId": "cf8ca9a0-4f0d-4d6e-8962-abf963a16079"
    },
    {
      "id": "cdc427d0-da1a-4239-9fb5-1612b52afb1e",
      "text": "“Nơi đây, Ta sẽ cho Đa-vít một dòng dõi hùng cường,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:28.641Z",
      "updatedAt": "2025-09-03T02:38:28.641Z",
      "chapterId": "cf8ca9a0-4f0d-4d6e-8962-abf963a16079"
    },
    {
      "id": "55a8f68c-c7ee-4801-a59f-06a6789596b8",
      "text": "sẽ thắp cho người Ta đã xức dầu phong vương",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:28.661Z",
      "updatedAt": "2025-09-03T02:38:28.661Z",
      "chapterId": "cf8ca9a0-4f0d-4d6e-8962-abf963a16079"
    },
    {
      "id": "b01798b3-3647-4f2f-85f7-f0a0b8b7d9dc",
      "text": "một ngọn đèn luôn luôn cháy sáng.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 2,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:28.671Z",
      "updatedAt": "2025-09-03T02:38:28.671Z",
      "chapterId": "cf8ca9a0-4f0d-4d6e-8962-abf963a16079"
    },
    {
      "id": "a4903774-9004-4709-a840-0b9637142e02",
      "text": "Kẻ thù vua, Ta phủ đầy nhục nhã,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:28.691Z",
      "updatedAt": "2025-09-03T02:38:28.691Z",
      "chapterId": "cf8ca9a0-4f0d-4d6e-8962-abf963a16079"
    },
    {
      "id": "8944aca3-ff8d-44b8-b7d6-5cdcb95e8bc6",
      "text": "còn trên đầu vua, rực rỡ ánh triều thiên.”",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:28.701Z",
      "updatedAt": "2025-09-03T02:38:28.701Z",
      "chapterId": "cf8ca9a0-4f0d-4d6e-8962-abf963a16079"
    }
  ],
