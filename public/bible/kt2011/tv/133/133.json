  },
  "verses": [
    {
      "id": "69a332f7-e2ba-4070-996b-94c7cfe956b3",
      "text": "*Ca khúc lên Đền. Của vua Đa-vít.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:38:34.775Z",
      "updatedAt": "2025-09-03T02:38:34.775Z",
      "chapterId": "b2c71fe8-7e2e-46ab-bbf5-96f1221a51a8"
    },
    {
      "id": "15d68f06-f311-40cb-83d0-c6cb6c943e51",
      "text": "Ngọt ngào tốt đẹp lắm thay,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:34.834Z",
      "updatedAt": "2025-09-03T02:38:34.834Z",
      "chapterId": "b2c71fe8-7e2e-46ab-bbf5-96f1221a51a8"
    },
    {
      "id": "157528fb-a100-428f-9c36-3337e124d9fd",
      "text": "anh em được sống vui vầy bên nhau,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:34.846Z",
      "updatedAt": "2025-09-03T02:38:34.846Z",
      "chapterId": "b2c71fe8-7e2e-46ab-bbf5-96f1221a51a8"
    },
    {
      "id": "ed7fcb09-464c-4468-96e7-40b6e522ad03",
      "text": "như dầu quý đổ trên đầu",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:34.872Z",
      "updatedAt": "2025-09-03T02:38:34.872Z",
      "chapterId": "b2c71fe8-7e2e-46ab-bbf5-96f1221a51a8"
    },
    {
      "id": "11575275-402d-4bc2-920c-e880cc333c6d",
      "text": "xuống râu xuống cổ áo chầu A-ha-ron,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:34.900Z",
      "updatedAt": "2025-09-03T02:38:34.900Z",
      "chapterId": "b2c71fe8-7e2e-46ab-bbf5-96f1221a51a8"
    },
    {
      "id": "c92c39ee-12c6-411d-96cc-9498477dbe91",
      "text": "như sương từ đỉnh Khéc-môn",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:34.942Z",
      "updatedAt": "2025-09-03T02:38:34.942Z",
      "chapterId": "b2c71fe8-7e2e-46ab-bbf5-96f1221a51a8"
    },
    {
      "id": "1276edde-d8fe-46bd-a599-409ea9f7b419",
      "text": "toả trên đồi núi Xi-on lan tràn,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:34.970Z",
      "updatedAt": "2025-09-03T02:38:34.970Z",
      "chapterId": "b2c71fe8-7e2e-46ab-bbf5-96f1221a51a8"
    },
    {
      "id": "624dcee7-bfcb-4762-bb0b-2483e471dab0",
      "text": "nơi đây ân huệ CHÚA ban,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:35.012Z",
      "updatedAt": "2025-09-03T02:38:35.012Z",
      "chapterId": "b2c71fe8-7e2e-46ab-bbf5-96f1221a51a8"
    },
    {
      "id": "9b9dbdfe-4c08-4e83-a3e3-2116c5740868",
      "text": "chính là sự sống chứa chan muôn đời.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 3,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:35.025Z",
      "updatedAt": "2025-09-03T02:38:35.025Z",
      "chapterId": "b2c71fe8-7e2e-46ab-bbf5-96f1221a51a8"
    }
  ],
  "marks": [
    {
      "id": "6cd5f959-63b7-42f6-b9b6-e690ed29ec5a",
      "content": "*Tv giáo huấn* này diễn tả hạnh phúc của những người đi hành hương lên Giê-ru-sa-lem được cảm thấy họ sống ở đó như *anh em* với nhau. Cũng có những người nghĩ đến cuộc sống đầy tình huynh đệ nối kết các tư tế và các thầy Lê-vi lại với nhau trong thành thánh cũng như đền thờ Giê-ru-sa-lem.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 50,
      "endOffset": 50,
      "createdAt": "2025-09-03T02:38:34.810Z",
