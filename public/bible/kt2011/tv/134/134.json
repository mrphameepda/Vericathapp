  "verses": [
    {
      "id": "56318520-b474-4a1c-be32-4481c5f34433",
      "text": "*Ca khúc lên Đền.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:38:40.408Z",
      "updatedAt": "2025-09-03T02:38:40.408Z",
      "chapterId": "2ca2ec68-381a-4046-a262-1d7b5b6b9c6c"
    },
    {
      "id": "14d9f3be-9805-486f-a0f3-0df478cc4bd6",
      "text": "Hỡi tất cả những người tôi tớ CHÚA",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:40.448Z",
      "updatedAt": "2025-09-03T02:38:40.448Z",
      "chapterId": "2ca2ec68-381a-4046-a262-1d7b5b6b9c6c"
    },
    {
      "id": "70459480-6cce-46ad-ba8b-7be5bacbf3a2",
      "text": "ứng trực suốt đêm trong thánh điện, nào chúc tụng CHÚA đi !",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:40.459Z",
      "updatedAt": "2025-09-03T02:38:40.459Z",
      "chapterId": "2ca2ec68-381a-4046-a262-1d7b5b6b9c6c"
    },
    {
      "id": "e2c67401-f927-40bf-99bf-ba97e5c36b57",
      "text": "Hãy giơ tay hướng về cung thánh",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:40.482Z",
      "updatedAt": "2025-09-03T02:38:40.482Z",
      "chapterId": "2ca2ec68-381a-4046-a262-1d7b5b6b9c6c"
    },
    {
      "id": "11d03107-d4b6-46d4-97f6-fd45fc76307f",
      "text": "mà dâng lên lời chúc tụng Người.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:40.524Z",
      "updatedAt": "2025-09-03T02:38:40.524Z",
      "chapterId": "2ca2ec68-381a-4046-a262-1d7b5b6b9c6c"
    },
    {
      "id": "d0b808da-47eb-4ce2-b5d6-450a1c02425f",
      "text": "Cúi xin Đấng tạo thành trời đất",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:40.538Z",
      "updatedAt": "2025-09-03T02:38:40.538Z",
      "chapterId": "2ca2ec68-381a-4046-a262-1d7b5b6b9c6c"
    },
    {
      "id": "2ad840d4-68c6-4fc3-b8fe-f16cb64c0f66",
      "text": "xuống cho bạn muôn vàn phúc cả",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:40.553Z",
      "updatedAt": "2025-09-03T02:38:40.553Z",
      "chapterId": "2ca2ec68-381a-4046-a262-1d7b5b6b9c6c"
    },
    {
      "id": "f7cb2e55-7c18-4bed-a735-3ad56a6bf567",
      "text": "từ núi thánh Xi-on.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:40.584Z",
      "updatedAt": "2025-09-03T02:38:40.584Z",
      "chapterId": "2ca2ec68-381a-4046-a262-1d7b5b6b9c6c"
    }
  ],
  "marks": [
