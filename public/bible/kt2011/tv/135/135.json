{
  "chapter": {
    "id": "7e7afa12-ae88-4469-8c39-71ed44ec26a9",
    "number": 135,
    "createdAt": "2025-09-03T01:07:51.663Z",
    "updatedAt": "2025-09-03T01:07:51.663Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "79c60b7f-7c44-4e28-9c8b-ad9d8dcd0d5f",
      "text": "Ha-lê-lui-a.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:46.355Z",
      "updatedAt": "2025-09-03T02:38:46.355Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "e7269643-e98d-40b4-a6c3-f0f7b437d8e9",
      "text": "Nào ca tụng danh thánh CHÚA đi,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:46.402Z",
      "updatedAt": "2025-09-03T02:38:46.402Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "3040ab78-8298-4564-8c22-c8d7fa3b5c4b",
      "text": "ca tụng Người, hỡi tôi tớ CHÚA",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:46.425Z",
      "updatedAt": "2025-09-03T02:38:46.425Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "cf016c50-6572-4020-b0d3-47dd7dd23fd6",
      "text": "đang ứng trực trong cung điện Người,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:46.438Z",
      "updatedAt": "2025-09-03T02:38:46.438Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "4222f0de-68e1-4604-b8fc-249f3877e865",
      "text": "tại khuôn viên đền Thiên Chúa chúng ta !",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:46.454Z",
      "updatedAt": "2025-09-03T02:38:46.454Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "3f35ebd6-dbf9-400d-8173-010f655456f8",
      "text": "Ca tụng CHÚA đi, vì CHÚA nhân hậu,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:46.467Z",
      "updatedAt": "2025-09-03T02:38:46.467Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "259fde87-869e-48c1-bd11-86d9f570a596",
      "text": "đàn hát mừng danh thánh, vì danh thánh ngọt ngào.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:46.481Z",
      "updatedAt": "2025-09-03T02:38:46.481Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "6731cf6e-cdf6-4881-9113-98915f28d68a",
      "text": "Vì CHÚA đã chọn nhà Gia-cóp,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:46.495Z",
      "updatedAt": "2025-09-03T02:38:46.495Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "8830ebc6-3bda-42da-92bb-b208b0a2cdc6",
      "text": "dành Ít-ra-en làm sản nghiệp riêng.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:46.525Z",
      "updatedAt": "2025-09-03T02:38:46.525Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "47a6bd06-65b6-4aaa-9767-02f63e87556e",
      "text": "Tôi quá rõ : CHÚA thật là cao cả,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:46.553Z",
      "updatedAt": "2025-09-03T02:38:46.553Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "584629c0-acfb-4179-886e-1a96bb923481",
      "text": "Chúa chúng ta vượt trên hết chư thần.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:46.595Z",
      "updatedAt": "2025-09-03T02:38:46.595Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "08f6343b-11b6-44b5-bd9f-88c15607dddd",
      "text": "Muốn làm gì là CHÚA làm nên,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:46.609Z",
      "updatedAt": "2025-09-03T02:38:46.609Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "8a748d64-5f0f-460f-a166-ef9dff14c366",
      "text": "chốn trời cao cùng nơi đất thấp,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:46.622Z",
      "updatedAt": "2025-09-03T02:38:46.622Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "156f0441-f23e-44d4-bf63-675629c21f53",
      "text": "lòng biển cả và đáy vực sâu.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:46.640Z",
      "updatedAt": "2025-09-03T02:38:46.640Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "5f7fdccd-f69e-40fd-ac84-a195f99c8759",
      "text": "Từ cùng tận địa cầu xa tắp,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:46.653Z",
      "updatedAt": "2025-09-03T02:38:46.653Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "40384d5a-2120-4369-a4ff-de37cd178889",
      "text": "Chúa đẩy lên từng lớp mây trời,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:46.667Z",
      "updatedAt": "2025-09-03T02:38:46.667Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "c68dc692-dbba-4cd3-8fab-8427bf48b104",
      "text": "làm cho chớp giật mưa rơi,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:46.681Z",
      "updatedAt": "2025-09-03T02:38:46.681Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "20425157-1142-4876-b12d-665f8ceec31e",
      "text": "mở kho thả gió khắp nơi tung hoành.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 3,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:46.695Z",
      "updatedAt": "2025-09-03T02:38:46.695Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "f9342bf7-432c-4698-bf57-88e1464f21a3",
      "text": "Chúa sát hại các con đầu lòng Ai-cập,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:46.723Z",
      "updatedAt": "2025-09-03T02:38:46.723Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "e976e449-01b8-4500-aeaa-166e3812bc3f",
      "text": "của loài vật cũng như loài người.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:46.764Z",
      "updatedAt": "2025-09-03T02:38:46.764Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "89ead6d1-3350-44c8-b4ab-7d75ad52c3ed",
      "text": "Ngay tại đất ngươi, Ai-cập hỡi,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:46.778Z",
      "updatedAt": "2025-09-03T02:38:46.778Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "ada8fa6e-978d-4239-8bda-8f95cfb6891b",
      "text": "Người giáng xuống những điềm thiêng dấu lạ,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:46.807Z",
      "updatedAt": "2025-09-03T02:38:46.807Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "7a938fae-538a-4ba8-a7f6-3c0be2d795eb",
      "text": "phạt Pha-ra-ô cùng với bầy tôi.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:46.835Z",
      "updatedAt": "2025-09-03T02:38:46.835Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "0f9c6246-e18e-4496-8a0c-d4f65b921823",
      "text": "Người đập tan tành nhiều dân nước,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:46.864Z",
      "updatedAt": "2025-09-03T02:38:46.864Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "dbb405e0-0d8f-4173-9b32-bfd32ff10a1a",
      "text": "tiêu diệt bao lãnh chúa hùng cường :",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:46.877Z",
      "updatedAt": "2025-09-03T02:38:46.877Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "738f2faa-1b8b-4f9c-9053-3c8f709501c8",
      "text": "Cả Xi-khôn, vua dân tộc E-mô-ri,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:46.891Z",
      "updatedAt": "2025-09-03T02:38:46.891Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "f3856475-0f8d-4a84-9ed5-a6b235fe13c5",
      "text": "lẫn vua Ốc cầm quyền Ba-san nữa,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:46.933Z",
      "updatedAt": "2025-09-03T02:38:46.933Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "b5099d4f-f42b-47ff-8a92-59dbd4f3ab5c",
      "text": "cùng mọi vương quốc miền Ca-na-an.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:46.976Z",
      "updatedAt": "2025-09-03T02:38:46.976Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "6dd5bead-1cbc-43c4-b98d-5a911e4a378b",
      "text": "Chúa lấy đất họ, ban làm gia sản,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:47.003Z",
      "updatedAt": "2025-09-03T02:38:47.003Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "87204c87-3cfa-4ee0-89df-44aa9a864079",
      "text": "gia sản cho dân Người là Ít-ra-en.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:47.017Z",
      "updatedAt": "2025-09-03T02:38:47.017Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "43599a84-68d4-4883-9921-e1b8ea38030c",
      "text": "Thánh danh Ngài, lạy CHÚA, sẽ trường tồn vạn kỷ,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:47.045Z",
      "updatedAt": "2025-09-03T02:38:47.045Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "db9c656c-3ec9-4339-a571-17da584e9e5d",
      "text": "trải qua muôn thế hệ, thiên hạ nhắc nhở Ngài.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:47.060Z",
      "updatedAt": "2025-09-03T02:38:47.060Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "92ca43f8-4bee-4d70-b738-72e63fb6f5be",
      "text": "CHÚA sẽ xét xử cho thần dân",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:47.074Z",
      "updatedAt": "2025-09-03T02:38:47.074Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "7351de2e-5cd1-414b-a77a-8d4b67a82c40",
      "text": "sẽ rủ lòng thương hàng tôi tớ.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:47.086Z",
      "updatedAt": "2025-09-03T02:38:47.086Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "75e587de-c879-4819-a3f3-1fb6e68eb15c",
      "text": "Tượng thần chư dân chỉ là vàng bạc,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:47.098Z",
      "updatedAt": "2025-09-03T02:38:47.098Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "ed4c95d5-83c1-44e4-b2f8-f6b28cb40578",
      "text": "chỉ do tay người thế tạo thành :",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:47.125Z",
      "updatedAt": "2025-09-03T02:38:47.125Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "1018ac2f-612b-4693-b954-4cc3264e058d",
      "text": "Có mắt có miệng, không nhìn không nói,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:47.137Z",
      "updatedAt": "2025-09-03T02:38:47.137Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "27c93290-35b8-4c67-8286-1967c109928a",
      "text": "có hai tai, mà chẳng thể nghe chi,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:47.149Z",
      "updatedAt": "2025-09-03T02:38:47.149Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "da09f81b-b02f-4310-81af-0924e9b23ace",
      "text": "không chút hơi thở nơi mồm nơi miệng.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:47.163Z",
      "updatedAt": "2025-09-03T02:38:47.163Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "848119fc-95d1-4cac-99e1-a32353bd5a9e",
      "text": "Ước gì kẻ làm ra hoặc tin ở tượng thần,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:47.177Z",
      "updatedAt": "2025-09-03T02:38:47.177Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "e211744b-4429-4764-983d-1dd36a0f2435",
      "text": "cũng giống như chúng vậy !",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:47.191Z",
      "updatedAt": "2025-09-03T02:38:47.191Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "5e074e95-69a5-4f0e-b23e-0204c2ca0df7",
      "text": "Nhà Ít-ra-en, nào chúc tụng CHÚA,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:47.205Z",
      "updatedAt": "2025-09-03T02:38:47.205Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "c0d7244a-b21a-45ce-8664-0d22e98410da",
      "text": "nhà A-ha-ron, chúc tụng CHÚA đi !",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:47.233Z",
      "updatedAt": "2025-09-03T02:38:47.233Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "26bc1f1c-3a41-4f8e-9f8b-bbda88fce8af",
      "text": "Nhà Lê-vi, nào chúc tụng CHÚA,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:47.261Z",
      "updatedAt": "2025-09-03T02:38:47.261Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "bc46d3a2-b8cd-4304-9114-349f3f7c69a1",
      "text": "ai kính sợ CHÚA, chúc tụng CHÚA đi !",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:47.289Z",
      "updatedAt": "2025-09-03T02:38:47.289Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "38d95868-98e3-44fb-bf12-9e3b526e045d",
      "text": "Từ Xi-on, xin chúc tụng CHÚA,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:47.303Z",
      "updatedAt": "2025-09-03T02:38:47.303Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "b9fa7a17-82e6-4393-b9ac-be97ff4351fe",
      "text": "Đấng ngự tại thành Giê-ru-sa-lem.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:47.331Z",
      "updatedAt": "2025-09-03T02:38:47.331Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    },
    {
      "id": "2b03ad95-e83b-45b1-85df-b0415fb94d2b",
      "text": "Ha-lê-lui-a.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 2,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:47.359Z",
      "updatedAt": "2025-09-03T02:38:47.359Z",
      "chapterId": "7e7afa12-ae88-4469-8c39-71ed44ec26a9"
    }
  ],
