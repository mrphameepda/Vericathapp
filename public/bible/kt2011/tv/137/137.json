{
  "chapter": {
    "id": "7ae3708f-d638-4f9f-9c24-ea8ca22a42c8",
    "number": 137,
    "createdAt": "2025-09-03T01:07:51.663Z",
    "updatedAt": "2025-09-03T01:07:51.663Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "33b75088-36f5-48cf-ba60-83d78dd61ccd",
      "text": "Bờ sông Ba-by-lon, ta ra ngồi nức nở mà tưởng nhớ Xi-on ;",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:59.077Z",
      "updatedAt": "2025-09-03T02:38:59.077Z",
      "chapterId": "7ae3708f-d638-4f9f-9c24-ea8ca22a42c8"
    },
    {
      "id": "396c682f-8185-48d5-be6c-fbb947209103",
      "text": "trên những cành dương liễu, ta tạm gác cây đàn.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:59.152Z",
      "updatedAt": "2025-09-03T02:38:59.152Z",
      "chapterId": "7ae3708f-d638-4f9f-9c24-ea8ca22a42c8"
    },
    {
      "id": "0c1021c8-8183-4368-b26d-39a5424c54f9",
      "text": "Bọn lính canh đòi ta hát xướng,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:59.164Z",
      "updatedAt": "2025-09-03T02:38:59.164Z",
      "chapterId": "7ae3708f-d638-4f9f-9c24-ea8ca22a42c8"
    },
    {
      "id": "86d22fe8-24cd-422c-8b4e-5ae10a23ec67",
      "text": "lũ cướp này mời gượng vui lên :",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:59.176Z",
      "updatedAt": "2025-09-03T02:38:59.176Z",
      "chapterId": "7ae3708f-d638-4f9f-9c24-ea8ca22a42c8"
    },
    {
      "id": "723076fa-38d5-4045-ad34-1834712fc87d",
      "text": "“Hát đi, hát thử đi xem",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:59.191Z",
      "updatedAt": "2025-09-03T02:38:59.191Z",
      "chapterId": "7ae3708f-d638-4f9f-9c24-ea8ca22a42c8"
    },
    {
      "id": "cc4d9123-61e6-46ef-81fb-cc945e83d3b0",
      "text": "Xi-on nhạc thánh điệu quen một bài !”",
      "label": "3",
      "number": 3,
      "subVerseIndex": 3,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:59.204Z",
      "updatedAt": "2025-09-03T02:38:59.204Z",
      "chapterId": "7ae3708f-d638-4f9f-9c24-ea8ca22a42c8"
    },
    {
      "id": "e6d608d4-ac03-4bae-b991-51469cbffbcb",
      "text": "Bài ca kính CHÚA TRỜI, làm sao ta hát nổi",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:59.233Z",
      "updatedAt": "2025-09-03T02:38:59.233Z",
      "chapterId": "7ae3708f-d638-4f9f-9c24-ea8ca22a42c8"
    },
    {
      "id": "8298c613-5fc0-4e0c-9cb4-0abb54fc38f3",
      "text": "nơi đất khách quê người ?",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:59.247Z",
      "updatedAt": "2025-09-03T02:38:59.247Z",
      "chapterId": "7ae3708f-d638-4f9f-9c24-ea8ca22a42c8"
    },
    {
      "id": "4fca7c62-d7cf-4ddd-98a6-d7ef652a95a1",
      "text": "Giê-ru-sa-lem hỡi, lòng này nếu quên ngươi,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:59.260Z",
      "updatedAt": "2025-09-03T02:38:59.260Z",
      "chapterId": "7ae3708f-d638-4f9f-9c24-ea8ca22a42c8"
    },
    {
      "id": "493877cd-0767-493e-a526-aa2307585407",
      "text": "thì tay gảy đàn thành tê bại !",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:59.288Z",
      "updatedAt": "2025-09-03T02:38:59.288Z",
      "chapterId": "7ae3708f-d638-4f9f-9c24-ea8ca22a42c8"
    },
    {
      "id": "2bd57d51-4f64-45a6-b53a-111366a41064",
      "text": "Lưỡi xướng ca sẽ dính với hàm,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:59.302Z",
      "updatedAt": "2025-09-03T02:38:59.302Z",
      "chapterId": "7ae3708f-d638-4f9f-9c24-ea8ca22a42c8"
    },
    {
      "id": "b5aa6217-e7fa-49b9-858b-6a84a708ad9f",
      "text": "nếu ta không hoài niệm, không còn lấy Giê-ru-sa-lem",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:59.316Z",
      "updatedAt": "2025-09-03T02:38:59.316Z",
      "chapterId": "7ae3708f-d638-4f9f-9c24-ea8ca22a42c8"
    },
    {
      "id": "53b7e262-e103-459a-854a-9617ea0faf0e",
      "text": "làm niềm vui tuyệt đỉnh của tâm hồn.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:59.345Z",
      "updatedAt": "2025-09-03T02:38:59.345Z",
      "chapterId": "7ae3708f-d638-4f9f-9c24-ea8ca22a42c8"
    },
    {
      "id": "15962431-b3fd-45c0-a5ee-d2d0425a57e9",
      "text": "Lạy CHÚA, xin nhớ lại ngày Giê-ru-sa-lem thất thủ,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:59.359Z",
      "updatedAt": "2025-09-03T02:38:59.359Z",
      "chapterId": "7ae3708f-d638-4f9f-9c24-ea8ca22a42c8"
    },
    {
      "id": "86a0c91a-efb2-41c5-848a-ddab72e95a41",
      "text": "để trừng phạt con cái Ê-đôm.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:59.415Z",
      "updatedAt": "2025-09-03T02:38:59.415Z",
      "chapterId": "7ae3708f-d638-4f9f-9c24-ea8ca22a42c8"
    },
    {
      "id": "33691cfc-2ab6-47ea-b623-fb4962c3f28a",
      "text": "Ngày ấy chúng reo hò : “Phá nó đi, phá cho bình địa.”",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:59.445Z",
      "updatedAt": "2025-09-03T02:38:59.445Z",
      "chapterId": "7ae3708f-d638-4f9f-9c24-ea8ca22a42c8"
    },
    {
      "id": "7526a4ec-a178-461d-8a4c-32ec8f8b2921",
      "text": "Gái Ba-by-lon hỡi, đồ trời tru đất diệt !",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:59.459Z",
      "updatedAt": "2025-09-03T02:38:59.459Z",
      "chapterId": "7ae3708f-d638-4f9f-9c24-ea8ca22a42c8"
    },
    {
      "id": "0da51f42-f869-4fd0-9c18-8a4e31a36913",
      "text": "Phúc thay người xử lại với mi, như mi đã xử với ta !",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:59.487Z",
      "updatedAt": "2025-09-03T02:38:59.487Z",
      "chapterId": "7ae3708f-d638-4f9f-9c24-ea8ca22a42c8"
    },
    {
      "id": "a02f3ea1-5300-4097-b860-46158cdca9ab",
      "text": "Phúc thay người bắt những con thơ của mi",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:59.501Z",
      "updatedAt": "2025-09-03T02:38:59.501Z",
      "chapterId": "7ae3708f-d638-4f9f-9c24-ea8ca22a42c8"
    },
    {
      "id": "98a6b1a6-c453-49bd-9ec1-a66a49365bd5",
      "text": "mà đem đập vào đá.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:38:59.517Z",
      "updatedAt": "2025-09-03T02:38:59.517Z",
      "chapterId": "7ae3708f-d638-4f9f-9c24-ea8ca22a42c8"
    }
  ],
