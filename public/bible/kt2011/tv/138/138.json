{
  "chapter": {
    "id": "9b273ed2-98fd-458a-b6f9-4844116a3c77",
    "number": 138,
    "createdAt": "2025-09-03T01:07:51.663Z",
    "updatedAt": "2025-09-03T01:07:51.663Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "6480713e-13f9-4d2b-bacd-8905365ba426",
      "text": "*Của vua Đa-vít.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:39:05.231Z",
      "updatedAt": "2025-09-03T02:39:05.231Z",
      "chapterId": "9b273ed2-98fd-458a-b6f9-4844116a3c77"
    },
    {
      "id": "4ae0a282-96ca-4422-a52f-61b291a1f306",
      "text": "Lạy Chúa, con hết lòng cảm tạ,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:05.285Z",
      "updatedAt": "2025-09-03T02:39:05.285Z",
      "chapterId": "9b273ed2-98fd-458a-b6f9-4844116a3c77"
    },
    {
      "id": "0ffe2ca3-3a3d-4772-9031-c197cd04a13b",
      "text": "Ngài đã nghe lời miệng con xin.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:05.300Z",
      "updatedAt": "2025-09-03T02:39:05.300Z",
      "chapterId": "9b273ed2-98fd-458a-b6f9-4844116a3c77"
    },
    {
      "id": "52f97a73-20f5-429d-8173-e1aa22b1d563",
      "text": "Giữa chư vị thiên thần, xin đàn ca kính Chúa,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 3,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:05.328Z",
      "updatedAt": "2025-09-03T02:39:05.328Z",
      "chapterId": "9b273ed2-98fd-458a-b6f9-4844116a3c77"
    },
    {
      "id": "c0025f0c-3bc3-4fbc-8cf4-a0aeb7ee11e3",
      "text": "hướng về đền thánh, con phủ phục tôn thờ.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:05.355Z",
      "updatedAt": "2025-09-03T02:39:05.355Z",
      "chapterId": "9b273ed2-98fd-458a-b6f9-4844116a3c77"
    },
    {
      "id": "2f3d3a95-5c4d-48db-ad01-d07080a2d497",
      "text": "Xin cảm tạ danh Chúa,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:05.384Z",
      "updatedAt": "2025-09-03T02:39:05.384Z",
      "chapterId": "9b273ed2-98fd-458a-b6f9-4844116a3c77"
    },
    {
      "id": "b9ef7cbe-3a28-46e7-b2b9-541c1d1d9d7e",
      "text": "vì Ngài vẫn thành tín yêu thương,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:05.411Z",
      "updatedAt": "2025-09-03T02:39:05.411Z",
      "chapterId": "9b273ed2-98fd-458a-b6f9-4844116a3c77"
    },
    {
      "id": "8a206fed-149c-4e0c-ad52-009b7660ff5a",
      "text": "đã đề cao danh thánh và lời hứa của Ngài",
      "label": "2",
      "number": 2,
      "subVerseIndex": 3,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:05.424Z",
      "updatedAt": "2025-09-03T02:39:05.424Z",
      "chapterId": "9b273ed2-98fd-458a-b6f9-4844116a3c77"
    },
    {
      "id": "364aa09f-fb86-4dd7-929b-85247629df52",
      "text": "trên tất cả mọi sự.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 4,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:05.438Z",
      "updatedAt": "2025-09-03T02:39:05.438Z",
      "chapterId": "9b273ed2-98fd-458a-b6f9-4844116a3c77"
    },
    {
      "id": "5edc8189-5957-4313-ab0f-d89eb9cadd95",
      "text": "Ngày con kêu cứu, Chúa đã thương đáp lại,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:05.452Z",
      "updatedAt": "2025-09-03T02:39:05.452Z",
      "chapterId": "9b273ed2-98fd-458a-b6f9-4844116a3c77"
    },
    {
      "id": "a5959793-d823-420a-b0b5-3d1debce011e",
      "text": "đã gia tăng nghị lực cho tâm hồn.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:05.466Z",
      "updatedAt": "2025-09-03T02:39:05.466Z",
      "chapterId": "9b273ed2-98fd-458a-b6f9-4844116a3c77"
    },
    {
      "id": "3bfaf02c-7f4f-430c-a059-57692bb0fc87",
      "text": "Lạy CHÚA, mọi đế vương dưới trần đều cảm tạ",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:05.480Z",
      "updatedAt": "2025-09-03T02:39:05.480Z",
      "chapterId": "9b273ed2-98fd-458a-b6f9-4844116a3c77"
    },
    {
      "id": "fd5f5c98-7105-47d7-b7d7-3da412b865d5",
      "text": "khi nghe những lời miệng Ngài phán ra.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:05.495Z",
      "updatedAt": "2025-09-03T02:39:05.495Z",
      "chapterId": "9b273ed2-98fd-458a-b6f9-4844116a3c77"
    },
    {
      "id": "671c01df-8685-403c-926b-2a5a13fff550",
      "text": "Họ sẽ ca ngợi đường lối CHÚA :",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:05.512Z",
      "updatedAt": "2025-09-03T02:39:05.512Z",
      "chapterId": "9b273ed2-98fd-458a-b6f9-4844116a3c77"
    },
    {
      "id": "857d1822-d96f-4400-9b36-758bd837ecf8",
      "text": "“Vinh quang CHÚA vĩ đại dường bao !”",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:05.532Z",
      "updatedAt": "2025-09-03T02:39:05.532Z",
      "chapterId": "9b273ed2-98fd-458a-b6f9-4844116a3c77"
    },
    {
      "id": "2ef58ab1-1b96-4361-a479-bcbf2f82b661",
      "text": "CHÚA tuy thật cao cả, nhưng vẫn nhìn đến kẻ thấp hèn ;",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:05.545Z",
      "updatedAt": "2025-09-03T02:39:05.545Z",
      "chapterId": "9b273ed2-98fd-458a-b6f9-4844116a3c77"
    },
    {
      "id": "0644a7bc-d7bc-43da-9c3f-668192b09d8d",
      "text": "đứa ngạo mạn ngông nghênh, từ xa Ngài đã biết.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:05.562Z",
      "updatedAt": "2025-09-03T02:39:05.562Z",
      "chapterId": "9b273ed2-98fd-458a-b6f9-4844116a3c77"
    },
    {
      "id": "a4824c7f-a3ad-4d68-8160-858a315be835",
      "text": "Cho dù con gặp bước ngặt nghèo,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:05.580Z",
      "updatedAt": "2025-09-03T02:39:05.580Z",
      "chapterId": "9b273ed2-98fd-458a-b6f9-4844116a3c77"
    },
    {
      "id": "334e6fe9-5e84-4c5c-ab85-0415f7b96500",
      "text": "Chúa vẫn bảo toàn mạng sống con.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:05.593Z",
      "updatedAt": "2025-09-03T02:39:05.593Z",
      "chapterId": "9b273ed2-98fd-458a-b6f9-4844116a3c77"
    },
    {
      "id": "ad3e4faf-b21c-4a82-8a58-d70d2e97da88",
      "text": "Địch thù đang hằm hằm giận dữ,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:05.607Z",
      "updatedAt": "2025-09-03T02:39:05.607Z",
      "chapterId": "9b273ed2-98fd-458a-b6f9-4844116a3c77"
    },
    {
      "id": "44770db5-2f31-4055-b021-24331481541d",
      "text": "Ngài ra tay chặn đứng,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 3,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:05.621Z",
      "updatedAt": "2025-09-03T02:39:05.621Z",
      "chapterId": "9b273ed2-98fd-458a-b6f9-4844116a3c77"
    },
    {
      "id": "d526f7f3-cd82-4117-a054-06f1272778e8",
      "text": "lấy tay uy quyền giải thoát con.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 4,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:05.634Z",
      "updatedAt": "2025-09-03T02:39:05.634Z",
      "chapterId": "9b273ed2-98fd-458a-b6f9-4844116a3c77"
    },
    {
      "id": "54c8f268-63db-45b1-b9ca-de2c28e415b9",
      "text": "Việc CHÚA làm cho con, Ngài sẽ hoàn tất ;",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:05.648Z",
      "updatedAt": "2025-09-03T02:39:05.648Z",
      "chapterId": "9b273ed2-98fd-458a-b6f9-4844116a3c77"
    },
    {
      "id": "afd2b846-75d0-455c-bdb6-b080b4bcfa9f",
      "text": "lạy CHÚA, muôn ngàn đời Chúa vẫn trọn tình thương.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:05.663Z",
      "updatedAt": "2025-09-03T02:39:05.663Z",
      "chapterId": "9b273ed2-98fd-458a-b6f9-4844116a3c77"
    },
    {
      "id": "5698e302-574d-40a7-be19-8bf9cb9707e9",
      "text": "Công trình do tay Ngài thực hiện, xin đừng bỏ dở dang.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:05.694Z",
      "updatedAt": "2025-09-03T02:39:05.694Z",
      "chapterId": "9b273ed2-98fd-458a-b6f9-4844116a3c77"
    }
  ],
  "marks": [
    {
      "id": "497a64f5-ceb2-484c-82a2-62a425ea1a43",
      "content": "Đây là *một Tv cảm tạ của cá nhân*. Tác giả dâng lời cảm tạ tri ân lên Đức Chúa, Đấng đã giải thoát tác giả khỏi một nỗi hiểm nguy đe doạ tính mạng mình (c.7). Tin đó thúc đẩy các *đế vương dưới trần* lên tiếng ca tụng Đức Chúa. Để kết thúc, tác giả dùng lời cầu xin Đức Chúa hoàn tất công việc Người đã làm dở dang. Tv này gồm ba phần : **1**) Cảm tạ Đức Chúa đã nhậm lời và thương đáp lại (cc. 1-3) ; **2**) Các đế vương cũng cảm tạ và ca tụng Đức Chúa (cc. 4-6) ; **3**) Tin tưởng vào Đức Chúa (cc. 7-8).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 23,
      "endOffset": 23,
      "createdAt": "2025-09-03T02:39:05.261Z",
      "updatedAt": "2025-09-03T02:39:05.261Z",
      "targetId": "b64e5afb-f08a-46e3-9edc-83308f2370f1",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "9b273ed2-98fd-458a-b6f9-4844116a3c77"
    },
