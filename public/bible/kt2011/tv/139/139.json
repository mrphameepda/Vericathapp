{
  "chapter": {
    "id": "63a8666b-56cc-4437-9696-92d39728d13d",
    "number": 139,
    "createdAt": "2025-09-03T01:07:51.663Z",
    "updatedAt": "2025-09-03T01:07:51.663Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "0eb0cf87-607f-4e6b-8cd4-9cf2226df45a",
      "text": "*Phần ca trưởng. Của vua Đa-vít. Thánh vịnh.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:39:10.753Z",
      "updatedAt": "2025-09-03T02:39:10.753Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "6f064f88-2f2e-423d-9900-c463fe81de7e",
      "text": "Lạy CHÚA, Ngài dò xét con và Ngài biết rõ,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:10.819Z",
      "updatedAt": "2025-09-03T02:39:10.819Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "e34e07d3-f72a-4d1f-82cb-aad612bbdf87",
      "text": "biết cả khi con đứng con ngồi.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:10.846Z",
      "updatedAt": "2025-09-03T02:39:10.846Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "ca5a0fd0-4471-4035-a0c5-94c4d8c8dcd6",
      "text": "Con nghĩ tưởng gì, Ngài thấu suốt từ xa,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:10.874Z",
      "updatedAt": "2025-09-03T02:39:10.874Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "25e87a2f-58b1-4312-a201-42d6b2f8797c",
      "text": "đi lại hay nghỉ ngơi, Chúa đều xem xét,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:10.888Z",
      "updatedAt": "2025-09-03T02:39:10.888Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "32af3b5b-14e3-487d-8d58-0b6d1d841573",
      "text": "mọi nẻo đường con đi, Ngài quen thuộc cả.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:10.903Z",
      "updatedAt": "2025-09-03T02:39:10.903Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "d03889ab-7593-4730-82bf-fb248b7abbe8",
      "text": "Miệng lưỡi con chưa thốt nên lời,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:10.917Z",
      "updatedAt": "2025-09-03T02:39:10.917Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "fe81a11e-0bf5-449d-96ea-8f3d26529dee",
      "text": "thì lạy CHÚA, Ngài đã am tường hết.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:10.930Z",
      "updatedAt": "2025-09-03T02:39:10.930Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "ff2e7bd0-c54c-42dd-ae45-c91e18baa936",
      "text": "Ngài bao bọc con cả sau lẫn trước,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:10.945Z",
      "updatedAt": "2025-09-03T02:39:10.945Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "2dd4b522-e059-4e5a-9735-bf4ffebd372b",
      "text": "bàn tay của Ngài, Ngài đặt lên con.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:10.959Z",
      "updatedAt": "2025-09-03T02:39:10.959Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "d5fa4872-2f31-4700-8a2d-e04ca635c887",
      "text": "Kỳ diệu thay, tri thức siêu phàm,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:10.987Z",
      "updatedAt": "2025-09-03T02:39:10.987Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "6b382bd2-94db-497b-aa8a-2c0996afb015",
      "text": "quá cao vời, con chẳng sao vươn tới !",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:11.001Z",
      "updatedAt": "2025-09-03T02:39:11.001Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "30456e91-d974-4fd1-98bd-5ae2b8f60415",
      "text": "Đi mãi đâu cho thoát thần trí Ngài,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:11.016Z",
      "updatedAt": "2025-09-03T02:39:11.016Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "0b049648-15fc-4bf3-b3f2-70d0fbd7e2a5",
      "text": "lẩn nơi nào cho khuất được Thánh Nhan ?",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:11.030Z",
      "updatedAt": "2025-09-03T02:39:11.030Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "41d74d75-c80c-4491-b00d-2f3c309523db",
      "text": "Con có lên trời, Chúa đang ngự đó,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:11.045Z",
      "updatedAt": "2025-09-03T02:39:11.045Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "aa06d98a-1c36-4850-958c-5cc1a9d8eda0",
      "text": "nằm dưới âm ty, vẫn gặp thấy Ngài.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:11.059Z",
      "updatedAt": "2025-09-03T02:39:11.059Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "18d0afe8-ac99-42be-8808-035aca24fa30",
      "text": "Dù chắp cánh bay từ phía hừng đông xuất hiện,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:11.073Z",
      "updatedAt": "2025-09-03T02:39:11.073Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "dc69c89a-3b9e-4744-bf4e-2cce1ddd15b4",
      "text": "đến ở nơi chân trời góc biển phương tây,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:11.090Z",
      "updatedAt": "2025-09-03T02:39:11.090Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "7d77a4e8-b553-4582-a764-4d23d26d19be",
      "text": "tại đó cũng tay Ngài đưa dẫn,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:11.106Z",
      "updatedAt": "2025-09-03T02:39:11.106Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "7326f8ec-b6fe-46ee-9cb5-b6068eb2d591",
      "text": "cánh tay hùng mạnh giữ lấy con.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:11.120Z",
      "updatedAt": "2025-09-03T02:39:11.120Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "71f5a897-1676-443e-8364-356d0b10ee6e",
      "text": "Con tự nhủ : “Ước gì bóng tối bao phủ tôi",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:11.133Z",
      "updatedAt": "2025-09-03T02:39:11.133Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "d514d3f5-7ffc-4dca-b4be-2df64c2f5e43",
      "text": "và ánh sáng quanh tôi thành đêm tối !”",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:11.146Z",
      "updatedAt": "2025-09-03T02:39:11.146Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "9463f53d-9f5f-4c67-9235-92df9e229b64",
      "text": "Nhưng đối với Ngài, tối tăm chẳng có chi mù mịt,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:11.159Z",
      "updatedAt": "2025-09-03T02:39:11.159Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "e9fdd8ed-7c16-4449-a9f8-27f6c521985f",
      "text": "và đêm đen sáng tỏ như ban ngày,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:11.171Z",
      "updatedAt": "2025-09-03T02:39:11.171Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "a8fd7233-617f-44ce-8006-ecc6901d67fa",
      "text": "bóng tối và ánh sáng cũng như nhau.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:11.182Z",
      "updatedAt": "2025-09-03T02:39:11.182Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "aad0091d-be46-404b-bf86-8909585c27e8",
      "text": "Tạng phủ con, chính Ngài đã cấu tạo,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:11.194Z",
      "updatedAt": "2025-09-03T02:39:11.194Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "1af27d05-97f6-46c7-8dd9-69fff5572a94",
      "text": "dệt tấm hình hài trong dạ mẫu thân con.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:11.220Z",
      "updatedAt": "2025-09-03T02:39:11.220Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "f198d1ff-5bc3-4ef7-bf10-f28da51e4158",
      "text": "Tạ ơn Chúa đã dựng nên con cách lạ lùng,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:11.232Z",
      "updatedAt": "2025-09-03T02:39:11.232Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "c48d5f64-fe71-451e-b798-ca12965a2684",
      "text": "công trình Ngài xiết bao kỳ diệu !",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:11.246Z",
      "updatedAt": "2025-09-03T02:39:11.246Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "c9d9bfda-c2cb-4279-82bb-9b6d15694b83",
      "text": "Hồn con đây biết rõ mười mươi.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 2,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:11.259Z",
      "updatedAt": "2025-09-03T02:39:11.259Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "dd1dc13f-d24a-430d-beec-41377414a5ef",
      "text": "Xương cốt con, Ngài không lạ lẫm gì,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:11.274Z",
      "updatedAt": "2025-09-03T02:39:11.274Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "cc2ff9df-387c-4562-8b2c-e58682cd210d",
      "text": "khi con được thành hình trong nơi bí ẩn,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:11.288Z",
      "updatedAt": "2025-09-03T02:39:11.288Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "567c6df9-4314-4e17-9723-6f209764fa10",
      "text": "được thêu dệt trong lòng đất thẳm sâu.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 2,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:11.301Z",
      "updatedAt": "2025-09-03T02:39:11.301Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "9609f581-5197-4ea8-b71a-0302838dfb69",
      "text": "Con mới là bào thai, mắt Ngài đã thấy ;",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:11.329Z",
      "updatedAt": "2025-09-03T02:39:11.329Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "228d2341-3a28-4a94-a0b7-f3e35430c8b2",
      "text": "mọi ngày đời được dành sẵn cho con",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:11.358Z",
      "updatedAt": "2025-09-03T02:39:11.358Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "2b0f4670-fd84-4dd8-8d1e-4919aee0de61",
      "text": "đều thấy ghi trong sổ sách Ngài,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 2,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:11.372Z",
      "updatedAt": "2025-09-03T02:39:11.372Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "145130da-0ed0-4f05-8552-da5bcf490ee9",
      "text": "trước khi ngày đầu của đời con khởi sự.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 3,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:11.400Z",
      "updatedAt": "2025-09-03T02:39:11.400Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "0cda78ac-6e19-4e9d-b51d-1173f240ff66",
      "text": "Lạy Chúa, con thấy tư tưởng Ngài khó hiểu biết bao,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:11.413Z",
      "updatedAt": "2025-09-03T02:39:11.413Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "c3fa3739-582d-4dfa-a4cf-feba36973ff3",
      "text": "tính chung lại, ôi nhiều vô kể !",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:11.428Z",
      "updatedAt": "2025-09-03T02:39:11.428Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "b67fc25d-ec6e-4859-83a5-f95a496d6d2b",
      "text": "Đếm sao nổi, vì nhiều hơn cát ;",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:11.445Z",
      "updatedAt": "2025-09-03T02:39:11.445Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "e05d4f88-223c-43c2-992c-972f6f4e2f5f",
      "text": "dù có đếm xong, con vẫn ở với Ngài.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:11.460Z",
      "updatedAt": "2025-09-03T02:39:11.460Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "d8a4b1b0-f563-47f8-964b-eaed52ef04a6",
      "text": "Lạy Chúa, ước chi Ngài tiêu diệt kẻ gian tà,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:11.473Z",
      "updatedAt": "2025-09-03T02:39:11.473Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "533125d8-d0bb-46ce-9166-4170275ae449",
      "text": "ước gì bọn khát máu đi cho khuất mắt con !",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:11.487Z",
      "updatedAt": "2025-09-03T02:39:11.487Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "0da2a1ae-de68-4dd4-aeef-16a343bb624f",
      "text": "Chúng nói về Ngài với chủ tâm phỉnh gạt,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:11.501Z",
      "updatedAt": "2025-09-03T02:39:11.501Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "80ba909a-a2fb-4ddd-a2d0-01b817509833",
      "text": "nổi dậy chống Ngài nhưng uổng công.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:11.515Z",
      "updatedAt": "2025-09-03T02:39:11.515Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "aa8035ba-b2fa-4041-833f-7b85d968cde8",
      "text": "Lạy CHÚA, kẻ ghét Ngài, làm sao con không ghét ?",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:11.529Z",
      "updatedAt": "2025-09-03T02:39:11.529Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "599f836e-cdff-47eb-b562-3c8dc5fb33cb",
      "text": "Làm sao con không tởm kẻ đứng lên chống Ngài ?",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:11.544Z",
      "updatedAt": "2025-09-03T02:39:11.544Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "3459f59e-0589-4479-9aba-caffbfb68b80",
      "text": "Con ghét chúng, ghét cay ghét đắng,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:11.558Z",
      "updatedAt": "2025-09-03T02:39:11.558Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "d9a5c67d-6eda-4896-8754-9c9672b0b010",
      "text": "chúng trở thành thù địch của chính con.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:11.572Z",
      "updatedAt": "2025-09-03T02:39:11.572Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "b16586a5-50e4-4681-8b69-6c640e873b4f",
      "text": "Lạy Chúa, xin dò xét để biết rõ lòng con,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:11.586Z",
      "updatedAt": "2025-09-03T02:39:11.586Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "5215fc76-102f-4e5f-8e82-df8c0c147cef",
      "text": "xin thử con cho biết những điều con cảm nghĩ.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:11.600Z",
      "updatedAt": "2025-09-03T02:39:11.600Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "6e0a0a75-bdac-4eb5-a16d-9c3a91e79454",
      "text": "Xin Ngài xem con có lạc vào đường gian ác",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:11.613Z",
      "updatedAt": "2025-09-03T02:39:11.613Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "30c92e06-6ae3-43c2-a7db-a242ad618422",
      "text": "thì dẫn con theo chính lộ ngàn đời.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:11.642Z",
      "updatedAt": "2025-09-03T02:39:11.642Z",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    }
  ],
  "marks": [
    {
