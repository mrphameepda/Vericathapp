    {
      "id": "cb039f1c-badd-4f9a-b94c-c2b90119da5e",
      "content": "Trong *Tv hỗn hợp* này, tác giả ca ngợi Đức Chúa là Đấng biết hết mọi sự (cc. 1-6), hiện diện ở khắp nơi (cc. 7-12) ; Người cũng là Đấng đầy uy quyền đối với những thù địch của Người (c.19). Những đoạn gồm cc. 1-6.7-12.13-18.23-24 mang nhiều nét thuộc văn chương khôn ngoan ; còn cc. 19-22 lại mặc hình thức ai ca.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 53,
      "endOffset": 53,
      "createdAt": "2025-09-03T02:39:10.796Z",
      "updatedAt": "2025-09-03T02:39:10.796Z",
      "targetId": "d803c119-3013-4f02-b512-9ee674401b5d",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "19010c2e-2582-4c50-92a4-faff9beefdf7",
      "content": "G 10,9-12",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:39:11.207Z",
      "updatedAt": "2025-09-03T02:39:11.207Z",
      "targetId": "aad0091d-be46-404b-bf86-8909585c27e8",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "4104273e-2049-4298-bb3c-e8c476ae75ea",
      "content": "English: David | French: David | Latin: David | Origin: &#1491;&#1464;&#1493;&#1460;&#1491; | Vietnamese: Đa-vít -- 1 Sm 16,21-22",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 31,
      "endOffset": 31,
      "createdAt": "2025-09-03T02:39:10.807Z",
      "updatedAt": "2025-09-03T02:39:10.807Z",
      "targetId": "0eb0cf87-607f-4e6b-8cd4-9cf2226df45a",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "2077b477-bb7e-4cbc-8bfc-d632e58814ab",
      "content": "Tv 69,29; Xh 32,32; Đn 7,10",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 19,
      "endOffset": 19,
      "createdAt": "2025-09-03T02:39:11.385Z",
      "updatedAt": "2025-09-03T02:39:11.385Z",
      "targetId": "2b0f4670-fd84-4dd8-8d1e-4919aee0de61",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "03a8b094-945e-4314-9ae5-1f0f325815a5",
      "content": "Thành ngữ *đứng, ngồi* chỉ những thái độ và hoạt động cụ thể của con người.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 29,
      "endOffset": 29,
      "createdAt": "2025-09-03T02:39:10.860Z",
      "updatedAt": "2025-09-03T02:39:10.860Z",
      "targetId": "e34e07d3-f72a-4d1f-82cb-aad612bbdf87",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "ce4a05f4-0a8c-4e38-962d-c2f6c931be91",
      "content": "C.5b chỉ quyền năng tuyệt đối của Thiên Chúa.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "5",
      "sortOrder": 4,
      "startOffset": 34,
      "endOffset": 34,
      "createdAt": "2025-09-03T02:39:10.973Z",
      "updatedAt": "2025-09-03T02:39:10.973Z",
      "targetId": "2dd4b522-e059-4e5a-9735-bf4ffebd372b",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "c0dc11a3-9d24-42d7-92ea-e6b902a794d1",
      "content": "Cơ thể con người là một tác phẩm nghệ thuật hình thành cách thầm kín trong cung lòng người mẹ được ví như *lòng đất thẳm sâu*.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "6",
      "sortOrder": 5,
      "startOffset": 37,
      "endOffset": 37,
      "createdAt": "2025-09-03T02:39:11.315Z",
      "updatedAt": "2025-09-03T02:39:11.315Z",
      "targetId": "567c6df9-4314-4e17-9723-6f209764fa10",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "4a257fca-96ac-4d7e-afce-9565579d9aad",
      "content": "C.16 rất khó cắt nghĩa vì tình trạng văn bản của câu không ổn chỉ có thể dịch theo sự phỏng đoán thôi.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "7",
      "sortOrder": 6,
      "startOffset": 37,
      "endOffset": 37,
      "createdAt": "2025-09-03T02:39:11.343Z",
      "updatedAt": "2025-09-03T02:39:11.343Z",
      "targetId": "9609f581-5197-4ea8-b71a-0302838dfb69",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "eea1f7b0-bedb-498a-ad69-524adef073c4",
      "content": "English: Sin | French: Sin | Latin: Sin | Origin: &#1505;&#1460;&#1497;&#1503; | Vietnamese: Xin 1 -- sa mạc trong cuộc Xuất hành, Xh 16,1 ; Ds 33,11-12",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "8",
      "sortOrder": 7,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:39:11.627Z",
      "updatedAt": "2025-09-03T02:39:11.627Z",
      "targetId": "6e0a0a75-bdac-4eb5-a16d-9c3a91e79454",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    },
    {
      "id": "3233cabf-3bd8-4c3b-a868-cd9b4a8ab79b",
      "content": "Tác giả Tv xin Đức Chúa xét xem mình có đi trên đường của kẻ dữ không ; nếu có, ông khẩn nài Người đưa mình vào *chính lộ ngàn đời*.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "9",
      "sortOrder": 8,
      "startOffset": 34,
      "endOffset": 34,
      "createdAt": "2025-09-03T02:39:11.656Z",
      "updatedAt": "2025-09-03T02:39:11.656Z",
      "targetId": "30c92e06-6ae3-43c2-a7db-a242ad618422",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "63a8666b-56cc-4437-9696-92d39728d13d"
    }
  ],
