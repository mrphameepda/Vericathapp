{
  "chapter": {
    "id": "298b069d-2e02-4875-9e60-1bc03e7fc276",
    "number": 14,
    "createdAt": "2025-09-03T01:07:51.660Z",
    "updatedAt": "2025-09-03T01:07:51.660Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "aa234242-b1f2-4dd5-b235-7a2c94afea03",
      "text": "*Phần ca trưởng. Của vua Đa-vít.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:25:54.318Z",
      "updatedAt": "2025-09-03T02:25:54.318Z",
      "chapterId": "298b069d-2e02-4875-9e60-1bc03e7fc276"
    },
    {
      "id": "785f7aae-8f19-44df-947b-6b685c780b5d",
      "text": "Kẻ ngu si tự nhủ : “Làm chi có Chúa Trời !”",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:54.375Z",
      "updatedAt": "2025-09-03T02:25:54.375Z",
      "chapterId": "298b069d-2e02-4875-9e60-1bc03e7fc276"
    },
    {
      "id": "60b3aef2-802c-4274-b842-48dbc38d05ac",
      "text": "Chúng đã ra hư đốn, làm những điều ghê tởm,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:54.389Z",
      "updatedAt": "2025-09-03T02:25:54.389Z",
      "chapterId": "298b069d-2e02-4875-9e60-1bc03e7fc276"
    },
    {
      "id": "8da1ff0a-0ecd-4f40-a1bf-4ced69c28886",
      "text": "chẳng có một ai làm điều thiện.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 3,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:54.403Z",
      "updatedAt": "2025-09-03T02:25:54.403Z",
      "chapterId": "298b069d-2e02-4875-9e60-1bc03e7fc276"
    },
    {
      "id": "0aa923a1-287e-4832-b4bb-24692bb900fc",
      "text": "Từ trời cao, CHÚA nhìn xuống loài người,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:54.416Z",
      "updatedAt": "2025-09-03T02:25:54.416Z",
      "chapterId": "298b069d-2e02-4875-9e60-1bc03e7fc276"
    },
    {
      "id": "5e80b74b-ffe0-4dbe-9354-44169be72d14",
      "text": "xem ai là kẻ có lương tri, biết kiếm tìm Thiên Chúa.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:54.430Z",
      "updatedAt": "2025-09-03T02:25:54.430Z",
      "chapterId": "298b069d-2e02-4875-9e60-1bc03e7fc276"
    },
    {
      "id": "d0d41a9b-9fb9-4a5d-95b1-7ec545168013",
      "text": "Người người đã lìa xa chính lộ,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:54.444Z",
      "updatedAt": "2025-09-03T02:25:54.444Z",
      "chapterId": "298b069d-2e02-4875-9e60-1bc03e7fc276"
    },
    {
      "id": "917b5e53-255c-495e-97dd-9becb78574d2",
      "text": "chỉ biết theo nhau làm chuyện suy đồi,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:54.458Z",
      "updatedAt": "2025-09-03T02:25:54.458Z",
      "chapterId": "298b069d-2e02-4875-9e60-1bc03e7fc276"
    },
    {
      "id": "e86808de-4fe9-47b2-a42e-939831173de1",
      "text": "chẳng có một ai làm điều thiện,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:54.472Z",
      "updatedAt": "2025-09-03T02:25:54.472Z",
      "chapterId": "298b069d-2e02-4875-9e60-1bc03e7fc276"
    },
    {
      "id": "85c7a550-0411-42bf-992f-7a771f251c73",
      "text": "dẫu một người cũng không.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 3,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:54.487Z",
      "updatedAt": "2025-09-03T02:25:54.487Z",
      "chapterId": "298b069d-2e02-4875-9e60-1bc03e7fc276"
    },
    {
      "id": "27fc44c0-3f30-4d42-a68e-c95a975f2ccc",
      "text": "Mọi kẻ làm điều ác, kẻ sống trên xương máu đồng bào ta,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:54.501Z",
      "updatedAt": "2025-09-03T02:25:54.501Z",
      "chapterId": "298b069d-2e02-4875-9e60-1bc03e7fc276"
    },
    {
      "id": "73f2fa1e-1906-46e1-b5a0-2172cad49bc9",
      "text": "kẻ không cầu khẩn CHÚA, há chẳng hiểu biết gì ?",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:54.530Z",
      "updatedAt": "2025-09-03T02:25:54.530Z",
      "chapterId": "298b069d-2e02-4875-9e60-1bc03e7fc276"
    },
    {
      "id": "1eb00877-44cd-4966-885d-774576596ef2",
      "text": "Này chúng phải kinh hoàng sợ hãi,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:54.544Z",
      "updatedAt": "2025-09-03T02:25:54.544Z",
      "chapterId": "298b069d-2e02-4875-9e60-1bc03e7fc276"
    },
    {
      "id": "14062689-6876-4264-b3f9-b479b51e8b81",
      "text": "vì Thiên Chúa bênh dòng dõi chính nhân.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:54.558Z",
      "updatedAt": "2025-09-03T02:25:54.558Z",
      "chapterId": "298b069d-2e02-4875-9e60-1bc03e7fc276"
    },
    {
      "id": "d6cdb4ed-05d6-4401-8add-77bc8cf1402a",
      "text": "Các ngươi chế giễu dự tính của người nghèo,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:54.573Z",
      "updatedAt": "2025-09-03T02:25:54.573Z",
      "chapterId": "298b069d-2e02-4875-9e60-1bc03e7fc276"
    },
    {
      "id": "d6e43644-315a-4066-9fc3-b2cc7ea4db96",
      "text": "nhưng CHÚA là nơi họ ẩn náu.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:54.587Z",
      "updatedAt": "2025-09-03T02:25:54.587Z",
      "chapterId": "298b069d-2e02-4875-9e60-1bc03e7fc276"
    },
    {
      "id": "33dd2a9e-34af-471f-9db9-538cab42e1e9",
      "text": "Từ Xi-on, ai sẽ đem ơn cứu độ cho Ít-ra-en ?",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:54.601Z",
      "updatedAt": "2025-09-03T02:25:54.601Z",
      "chapterId": "298b069d-2e02-4875-9e60-1bc03e7fc276"
    },
    {
      "id": "64ffd444-c556-4616-a0de-01f6a5519307",
      "text": "Khi CHÚA đổi vận mệnh dân Người,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:54.641Z",
      "updatedAt": "2025-09-03T02:25:54.641Z",
      "chapterId": "298b069d-2e02-4875-9e60-1bc03e7fc276"
    },
    {
      "id": "f0d30f18-5a2c-4a92-a927-f9586fc55f88",
      "text": "nhà Gia-cóp vui mừng biết mấy,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:54.653Z",
      "updatedAt": "2025-09-03T02:25:54.653Z",
      "chapterId": "298b069d-2e02-4875-9e60-1bc03e7fc276"
    },
    {
      "id": "ccd46e6e-20eb-4273-aec9-d8b44a324c43",
      "text": "dân Ít-ra-en hớn hở dường bao !",
      "label": "7",
      "number": 7,
      "subVerseIndex": 3,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:54.681Z",
      "updatedAt": "2025-09-03T02:25:54.681Z",
      "chapterId": "298b069d-2e02-4875-9e60-1bc03e7fc276"
    }
  ],
  "marks": [
    {
      "id": "36fd738c-87c4-4f90-8786-c0dec2c322e5",
      "content": "Là *một Thánh vịnh giáo huấn*, Tv 14 rất giống Tv 53 ; chỉ có vài điểm dị biệt nhỏ sau đây : **1**) Tv 14 thường dùng “YHWH” (= Đức Chúa) trừ hai nơi (cc. 1.2b) ; còn Tv 53 lại dùng “´élöhîm” (= Thiên Chúa) ; **2**) Tv 14,4a : *mọi kẻ làm điều ác* ; Tv 53,5a : *những kẻ làm điều ác* ; **3**) Tv 14,5b-6 khác với Tv 53,6b-e.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 41,
