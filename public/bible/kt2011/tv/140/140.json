{
  "chapter": {
    "id": "f5c9da67-b791-4df8-b3c7-7d51b401de8e",
    "number": 140,
    "createdAt": "2025-09-03T01:07:51.663Z",
    "updatedAt": "2025-09-03T01:07:51.663Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "36595a31-edf5-483b-a6c7-4fe84be468b6",
      "text": "*Phần ca trưởng. Thánh vịnh. Của vua Đa-vít.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:39:19.435Z",
      "updatedAt": "2025-09-03T02:39:19.435Z",
      "chapterId": "f5c9da67-b791-4df8-b3c7-7d51b401de8e"
    },
    {
      "id": "69c3ed06-a554-40d5-81d8-faeda92305ba",
      "text": "Lạy CHÚA, xin cứu con khỏi người gian ác,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:19.496Z",
      "updatedAt": "2025-09-03T02:39:19.496Z",
      "chapterId": "f5c9da67-b791-4df8-b3c7-7d51b401de8e"
    },
    {
      "id": "f99f7c64-ede1-4399-9ec3-bbfb69367078",
      "text": "giữ gìn con khỏi kẻ bạo tàn.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:19.508Z",
      "updatedAt": "2025-09-03T02:39:19.508Z",
      "chapterId": "f5c9da67-b791-4df8-b3c7-7d51b401de8e"
    },
    {
      "id": "8f678cff-0cf2-43fc-9147-47deecafcec5",
      "text": "Lòng chúng bày chước độc mưu thâm,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:19.522Z",
      "updatedAt": "2025-09-03T02:39:19.522Z",
      "chapterId": "f5c9da67-b791-4df8-b3c7-7d51b401de8e"
    },
    {
      "id": "f3711ede-abf4-4838-b26d-84e2544d60e4",
      "text": "cả ngày chỉ biết gây xung đột.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:19.536Z",
      "updatedAt": "2025-09-03T02:39:19.536Z",
      "chapterId": "f5c9da67-b791-4df8-b3c7-7d51b401de8e"
    },
    {
      "id": "9b9eece9-9696-4397-beb1-04db54e04ce4",
      "text": "Chúng mài lưỡi nhọn như lưỡi rắn,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:19.549Z",
      "updatedAt": "2025-09-03T02:39:19.549Z",
      "chapterId": "f5c9da67-b791-4df8-b3c7-7d51b401de8e"
    },
    {
      "id": "f7ad2383-5766-411a-99e8-a18f0313c884",
      "text": "chứa đầy mồm nọc độc hổ mang.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:19.577Z",
      "updatedAt": "2025-09-03T02:39:19.577Z",
      "chapterId": "f5c9da67-b791-4df8-b3c7-7d51b401de8e"
    },
    {
      "id": "28753af7-0895-481c-9ae0-e89cc1b12f36",
      "text": "Lạy CHÚA, xin bảo vệ con khỏi tay người tội lỗi,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:19.605Z",
      "updatedAt": "2025-09-03T02:39:19.605Z",
      "chapterId": "f5c9da67-b791-4df8-b3c7-7d51b401de8e"
    },
    {
      "id": "a9bba056-0787-4044-8d7d-9a3d73306180",
      "text": "giữ gìn con khỏi kẻ bạo tàn đang tìm kế làm con ngã quỵ.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:19.619Z",
      "updatedAt": "2025-09-03T02:39:19.619Z",
      "chapterId": "f5c9da67-b791-4df8-b3c7-7d51b401de8e"
    },
    {
      "id": "9541f969-6df5-494d-9a6f-3515feffb0f6",
      "text": "Quân kiêu hãnh ngấm ngầm đánh bẫy,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:19.633Z",
      "updatedAt": "2025-09-03T02:39:19.633Z",
      "chapterId": "f5c9da67-b791-4df8-b3c7-7d51b401de8e"
    },
    {
      "id": "36294e55-3868-4fab-8940-b2ec4a9dc986",
      "text": "chúng bủa lưới đặt dò, bên vệ đường gài bẫy hại con.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:19.647Z",
      "updatedAt": "2025-09-03T02:39:19.647Z",
      "chapterId": "f5c9da67-b791-4df8-b3c7-7d51b401de8e"
    },
    {
      "id": "58dc0c49-cc21-4c6a-8443-21d2ec58cb6a",
      "text": "Con thưa cùng ĐỨC CHÚA : Chính Ngài là Thiên Chúa của con,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:19.675Z",
      "updatedAt": "2025-09-03T02:39:19.675Z",
      "chapterId": "f5c9da67-b791-4df8-b3c7-7d51b401de8e"
    },
    {
      "id": "e22ab18b-048a-4307-b6a9-fe67dfafe6b3",
      "text": "lạy CHÚA, xin lắng tai nghe tiếng con cầu khẩn.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:19.717Z",
      "updatedAt": "2025-09-03T02:39:19.717Z",
      "chapterId": "f5c9da67-b791-4df8-b3c7-7d51b401de8e"
    },
    {
      "id": "e68b8e4c-b716-4293-be4e-81848e525b92",
      "text": "Lạy CHÚA là Chúa Tể, là sức mạnh cứu con,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:19.731Z",
      "updatedAt": "2025-09-03T02:39:19.731Z",
      "chapterId": "f5c9da67-b791-4df8-b3c7-7d51b401de8e"
    },
    {
      "id": "7dad2a48-eca0-4a9a-8daf-935f3c346e63",
      "text": "là mũ chiến đội đầu trong ngày con xuất trận.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:19.745Z",
      "updatedAt": "2025-09-03T02:39:19.745Z",
      "chapterId": "f5c9da67-b791-4df8-b3c7-7d51b401de8e"
    },
    {
      "id": "c83a1f6f-fadc-4ca7-b005-912912c8ba7e",
      "text": "Lạy CHÚA, xin đừng để ác nhân toại ý,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:19.760Z",
      "updatedAt": "2025-09-03T02:39:19.760Z",
      "chapterId": "f5c9da67-b791-4df8-b3c7-7d51b401de8e"
    },
    {
      "id": "00780478-9975-4996-a920-44208f05ef5b",
      "text": "đừng để nó thực hiện mưu đồ.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:19.777Z",
      "updatedAt": "2025-09-03T02:39:19.777Z",
      "chapterId": "f5c9da67-b791-4df8-b3c7-7d51b401de8e"
    },
    {
      "id": "d16f2fdd-4f42-488f-b063-7e2460781db7",
      "text": "Xin đừng để bọn vây hãm con ngẩng đầu lên được ;",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:19.794Z",
      "updatedAt": "2025-09-03T02:39:19.794Z",
      "chapterId": "f5c9da67-b791-4df8-b3c7-7d51b401de8e"
    },
    {
      "id": "cfe88051-946f-46ab-8bc8-370773b9bbf4",
      "text": "xin cho điều độc ác miệng chúng thốt ra",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:19.822Z",
      "updatedAt": "2025-09-03T02:39:19.822Z",
      "chapterId": "f5c9da67-b791-4df8-b3c7-7d51b401de8e"
    },
    {
      "id": "8c68f424-dd18-460e-b268-103092504a64",
      "text": "bao phủ lên người chúng !",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:19.836Z",
      "updatedAt": "2025-09-03T02:39:19.836Z",
      "chapterId": "f5c9da67-b791-4df8-b3c7-7d51b401de8e"
    },
    {
      "id": "5ee7aead-2b5c-4359-ba98-f7d550ee44e4",
      "text": "Xin đổ than hồng xuống trên chúng như mưa,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:19.850Z",
      "updatedAt": "2025-09-03T02:39:19.850Z",
      "chapterId": "f5c9da67-b791-4df8-b3c7-7d51b401de8e"
    },
    {
      "id": "cca4df2d-16fa-42f0-980c-365c7588f3b0",
      "text": "xin làm cho chúng bị xô vào lửa đỏ,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:19.893Z",
      "updatedAt": "2025-09-03T02:39:19.893Z",
      "chapterId": "f5c9da67-b791-4df8-b3c7-7d51b401de8e"
    },
    {
      "id": "1f426e86-b3e6-4d35-a4e3-82cd215be255",
      "text": "sa xuống vực sâu, không tài nào trỗi dậy,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:19.907Z",
      "updatedAt": "2025-09-03T02:39:19.907Z",
      "chapterId": "f5c9da67-b791-4df8-b3c7-7d51b401de8e"
    },
    {
      "id": "346e3ac2-d687-4081-a67a-a00374fe0915",
      "text": "cho tên xấu miệng không còn chỗ đứng trên đời,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:19.920Z",
      "updatedAt": "2025-09-03T02:39:19.920Z",
      "chapterId": "f5c9da67-b791-4df8-b3c7-7d51b401de8e"
    },
    {
      "id": "ee124355-a371-4c1d-9eb3-46f18a340b82",
      "text": "cho kẻ bạo tàn phải tai ương dồn dập !",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:19.934Z",
      "updatedAt": "2025-09-03T02:39:19.934Z",
      "chapterId": "f5c9da67-b791-4df8-b3c7-7d51b401de8e"
    },
    {
      "id": "ebbd773b-16ae-42da-95bc-318fc54901d2",
      "text": "Con biết rằng : CHÚA bênh người khốn khổ,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:19.948Z",
      "updatedAt": "2025-09-03T02:39:19.948Z",
      "chapterId": "f5c9da67-b791-4df8-b3c7-7d51b401de8e"
    },
    {
      "id": "7e11274e-82ac-4d25-9884-353bbd38795b",
      "text": "bảo vệ quyền lợi kẻ khó nghèo.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:19.976Z",
      "updatedAt": "2025-09-03T02:39:19.976Z",
      "chapterId": "f5c9da67-b791-4df8-b3c7-7d51b401de8e"
    },
    {
      "id": "f48928af-47f8-4352-ad13-1e48a70ad204",
      "text": "Vâng, người công chính sẽ xưng tụng danh Chúa,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:19.990Z",
      "updatedAt": "2025-09-03T02:39:19.990Z",
      "chapterId": "f5c9da67-b791-4df8-b3c7-7d51b401de8e"
    },
    {
      "id": "fefbabb3-8e23-44dc-a3b7-c4ec554045f5",
      "text": "kẻ ngay lành được ở trước Thánh Nhan.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:20.004Z",
      "updatedAt": "2025-09-03T02:39:20.004Z",
      "chapterId": "f5c9da67-b791-4df8-b3c7-7d51b401de8e"
    }
  ],
