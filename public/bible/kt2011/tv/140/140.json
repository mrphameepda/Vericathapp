    },
    {
      "id": "e2c60b46-91d6-47ae-b57a-002e9cdd52b6",
      "content": "*Ai ca này của cá nhân* là lời khẩn cầu của tác giả bị kẻ thù độc ác mưu hại. Vì muốn thoát khỏi hoàn cảnh bi đát đó, tác giả nài xin Đức Chúa bênh vực chở che. Có bốn phần trong Tv 140 : **1**) Xin Đức Chúa cứu giúp và bảo vệ (cc. 2-6) ; **2**) Tuyên xưng Đức Chúa là Thiên Chúa, là sức mạnh (cc. 7-9) ; **3**) Xin Đức Chúa giáng hoạ xuống kẻ thù (cc. 10-12) ; **4**) Trông cậy vào Đức Chúa (cc. 13-14).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 61,
      "endOffset": 61,
      "createdAt": "2025-09-03T02:39:19.474Z",
      "updatedAt": "2025-09-03T02:39:19.474Z",
      "targetId": "9642ca6d-e9cd-49f9-8442-b1c3bae027e6",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "f5c9da67-b791-4df8-b3c7-7d51b401de8e"
    },
