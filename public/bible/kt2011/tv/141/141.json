{
  "chapter": {
    "id": "83a58cc5-c908-4357-8c0b-06f3403a4033",
    "number": 141,
    "createdAt": "2025-09-03T01:07:51.663Z",
    "updatedAt": "2025-09-03T01:07:51.663Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "7ac65687-a55e-49ed-9e26-2d8e2d754057",
      "text": "*Thánh vịnh. Của vua Đa-vít.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:39:25.111Z",
      "updatedAt": "2025-09-03T02:39:25.111Z",
      "chapterId": "83a58cc5-c908-4357-8c0b-06f3403a4033"
    },
    {
      "id": "1a69023c-790c-409d-9f68-7cceb7dd9693",
      "text": "Lạy CHÚA, con kêu lên cùng Chúa,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:25.165Z",
      "updatedAt": "2025-09-03T02:39:25.165Z",
      "chapterId": "83a58cc5-c908-4357-8c0b-06f3403a4033"
    },
    {
      "id": "5091333f-dd09-4c94-af3f-b302434c7185",
      "text": "xin Ngài mau đến phù trợ con.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:25.177Z",
      "updatedAt": "2025-09-03T02:39:25.177Z",
      "chapterId": "83a58cc5-c908-4357-8c0b-06f3403a4033"
    },
    {
      "id": "0fa6e43f-4cbc-4cfc-890e-3aef5dc31ecc",
      "text": "Xin lắng nghe lời con, khi con kêu lên Ngài.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 3,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:25.190Z",
      "updatedAt": "2025-09-03T02:39:25.190Z",
      "chapterId": "83a58cc5-c908-4357-8c0b-06f3403a4033"
    },
    {
      "id": "c32d046e-7110-420d-ac37-d5dacaced0d2",
      "text": "Ước chi lời con nguyện",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:25.217Z",
      "updatedAt": "2025-09-03T02:39:25.217Z",
      "chapterId": "83a58cc5-c908-4357-8c0b-06f3403a4033"
    },
    {
      "id": "76712401-264f-4bc6-bff5-9883ffcc5479",
      "text": "như hương trầm bay toả trước Thánh Nhan,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:25.231Z",
      "updatedAt": "2025-09-03T02:39:25.231Z",
      "chapterId": "83a58cc5-c908-4357-8c0b-06f3403a4033"
    },
    {
      "id": "ad7eabe7-aeac-4d67-9c40-69139272fb93",
      "text": "và tay con giơ lên",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:25.245Z",
      "updatedAt": "2025-09-03T02:39:25.245Z",
      "chapterId": "83a58cc5-c908-4357-8c0b-06f3403a4033"
    },
    {
      "id": "4ab2d730-0622-4a6c-aeee-5a3d010de7b4",
      "text": "được chấp nhận như của lễ ban chiều.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 3,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:25.289Z",
      "updatedAt": "2025-09-03T02:39:25.289Z",
      "chapterId": "83a58cc5-c908-4357-8c0b-06f3403a4033"
    },
    {
      "id": "aa4ed8fb-ecc9-4f52-b0b4-bb121ace144b",
      "text": "Xin canh giữ miệng con, lạy CHÚA,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:25.303Z",
      "updatedAt": "2025-09-03T02:39:25.303Z",
      "chapterId": "83a58cc5-c908-4357-8c0b-06f3403a4033"
    },
    {
      "id": "5ac063f5-90b1-4eeb-9b60-759c13b384ad",
      "text": "và trông chừng lưỡi con.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:25.330Z",
      "updatedAt": "2025-09-03T02:39:25.330Z",
      "chapterId": "83a58cc5-c908-4357-8c0b-06f3403a4033"
    },
    {
      "id": "c6d857eb-3812-4cee-a27e-965a03a1a674",
      "text": "Xin đừng để lòng con nghiêng về sự dữ,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:25.344Z",
      "updatedAt": "2025-09-03T02:39:25.344Z",
      "chapterId": "83a58cc5-c908-4357-8c0b-06f3403a4033"
    },
    {
      "id": "472162c2-eb06-4e96-a132-17c4cf5f6684",
      "text": "đừng để con làm điều ác với bọn gian tà.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:25.372Z",
      "updatedAt": "2025-09-03T02:39:25.372Z",
      "chapterId": "83a58cc5-c908-4357-8c0b-06f3403a4033"
    },
    {
      "id": "cd928802-f0a6-434f-b601-313ea5eb5abc",
      "text": "Yến tiệc của chúng, con chẳng thèm ăn.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:25.386Z",
      "updatedAt": "2025-09-03T02:39:25.386Z",
      "chapterId": "83a58cc5-c908-4357-8c0b-06f3403a4033"
    },
    {
      "id": "07db254d-d400-4cca-a764-c636572243d5",
      "text": "Người công chính cứ việc đánh con",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:25.401Z",
      "updatedAt": "2025-09-03T02:39:25.401Z",
      "chapterId": "83a58cc5-c908-4357-8c0b-06f3403a4033"
    },
    {
      "id": "ad163771-e464-4b9e-9a19-aabdf8c517e8",
      "text": "và lấy tình thương mà sửa dạy,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:25.414Z",
      "updatedAt": "2025-09-03T02:39:25.414Z",
      "chapterId": "83a58cc5-c908-4357-8c0b-06f3403a4033"
    },
    {
      "id": "ebc054df-fb95-44a8-bf69-fed7c19a87bd",
      "text": "nhưng dầu thơm kẻ dữ",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:25.428Z",
      "updatedAt": "2025-09-03T02:39:25.428Z",
      "chapterId": "83a58cc5-c908-4357-8c0b-06f3403a4033"
    },
    {
      "id": "3d7876c5-0e53-4f2d-ac2e-7d7512718222",
      "text": "con quyết chẳng cho xức trên đầu ;",
      "label": "5",
      "number": 5,
      "subVerseIndex": 3,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:25.441Z",
      "updatedAt": "2025-09-03T02:39:25.441Z",
      "chapterId": "83a58cc5-c908-4357-8c0b-06f3403a4033"
    },
    {
      "id": "dd23a436-6848-436a-b9f6-b283cec6072e",
      "text": "khi chúng làm điều ác, con vẫn luôn cầu nguyện.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 4,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:25.455Z",
      "updatedAt": "2025-09-03T02:39:25.455Z",
      "chapterId": "83a58cc5-c908-4357-8c0b-06f3403a4033"
    },
    {
      "id": "9aec71f5-a24f-4d21-a8db-d4126583e4a0",
      "text": "Thủ lãnh chúng giờ đây bị xô vào tảng đá,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:25.469Z",
      "updatedAt": "2025-09-03T02:39:25.469Z",
      "chapterId": "83a58cc5-c908-4357-8c0b-06f3403a4033"
    },
    {
      "id": "3e2cdbae-150c-46b9-b552-91532e1eaf55",
      "text": "họ đã từng hả dạ nghe tiếng con than rằng :",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:25.483Z",
      "updatedAt": "2025-09-03T02:39:25.483Z",
      "chapterId": "83a58cc5-c908-4357-8c0b-06f3403a4033"
    },
    {
      "id": "dd5e061c-35f7-4db2-9f3b-ba9884926a8e",
      "text": "“Xương chúng tôi nằm vung vãi trước miệng âm ty,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:25.497Z",
      "updatedAt": "2025-09-03T02:39:25.497Z",
      "chapterId": "83a58cc5-c908-4357-8c0b-06f3403a4033"
    },
    {
      "id": "bf267ece-9cb0-4667-8594-397d79ef8094",
      "text": "như thửa đất ngổn ngang vì kẻ đào người bới.”",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:25.510Z",
      "updatedAt": "2025-09-03T02:39:25.510Z",
      "chapterId": "83a58cc5-c908-4357-8c0b-06f3403a4033"
    },
    {
      "id": "65c9abc6-e7d2-4781-aadd-bc2b07b91345",
      "text": "Lạy CHÚA là Chúa Tể, con ngước mắt nhìn Ngài,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:25.525Z",
      "updatedAt": "2025-09-03T02:39:25.525Z",
      "chapterId": "83a58cc5-c908-4357-8c0b-06f3403a4033"
    },
    {
      "id": "def23826-dbae-4ed0-a1fc-99ed0d15bdb2",
      "text": "bên Ngài con ẩn náu, đừng để con thiệt mạng.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:25.539Z",
      "updatedAt": "2025-09-03T02:39:25.539Z",
      "chapterId": "83a58cc5-c908-4357-8c0b-06f3403a4033"
    },
    {
      "id": "9b50ef09-833c-42f3-b236-f1eb6cc273c3",
      "text": "Xin giữ con khỏi sa lưới chúng giăng,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:25.553Z",
      "updatedAt": "2025-09-03T02:39:25.553Z",
      "chapterId": "83a58cc5-c908-4357-8c0b-06f3403a4033"
    },
    {
      "id": "5341b4df-5fc0-4081-a18b-9c02068b924d",
      "text": "khỏi rơi vào cạm bẫy quân làm điều ác,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:25.581Z",
      "updatedAt": "2025-09-03T02:39:25.581Z",
      "chapterId": "83a58cc5-c908-4357-8c0b-06f3403a4033"
    },
    {
      "id": "c6222cd9-ed17-4ece-91dd-cff7b264b265",
      "text": "cho bọn ác nhân mắc bẫy chính chúng gài,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:25.595Z",
      "updatedAt": "2025-09-03T02:39:25.595Z",
      "chapterId": "83a58cc5-c908-4357-8c0b-06f3403a4033"
    },
    {
      "id": "3121e213-47af-4aeb-99c4-03033a3f22d5",
      "text": "còn con đây thì được thoát khỏi.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:25.623Z",
      "updatedAt": "2025-09-03T02:39:25.623Z",
      "chapterId": "83a58cc5-c908-4357-8c0b-06f3403a4033"
    }
  ],
  "marks": [
    {
      "id": "38b6a0bb-b910-40ff-a102-9fdf4027a4f8",
      "content": "Trong *ai ca này của cá nhân*, tác giả cầu xin Đức Chúa không để cho mình bị lôi kéo vào con đường tội lỗi và rơi vào cạm bẫy của ác nhân. Cấu trúc : **1**) Xin Đức Chúa đến phù trợ (cc. 1-2) ; **2**) Xin Đức Chúa đừng để bị lôi cuốn làm sự dữ (cc. 3-7) ; **3**) Xin khỏi sa cạm bẫy của ác nhân (cc. 8-10).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 52,
      "endOffset": 52,
      "createdAt": "2025-09-03T02:39:25.143Z",
      "updatedAt": "2025-09-03T02:39:25.143Z",
