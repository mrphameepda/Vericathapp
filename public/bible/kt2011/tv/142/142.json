{
  "chapter": {
    "id": "881f3125-619d-40be-b621-17b5b8417ac6",
    "number": 142,
    "createdAt": "2025-09-03T01:07:51.663Z",
    "updatedAt": "2025-09-03T01:07:51.663Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "fb15e7ae-ef6f-492a-ab4d-52edf9b8a4a8",
      "text": "*Thi khúc. Của vua Đa-vít. Khi vua Đa-vít ở trong hang. Cầu nguyện.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:39:31.379Z",
      "updatedAt": "2025-09-03T02:39:31.379Z",
      "chapterId": "881f3125-619d-40be-b621-17b5b8417ac6"
    },
    {
      "id": "08a29539-07fa-4c7f-bac9-ab9e86e99469",
      "text": "Tôi lớn tiếng kêu gào lên CHÚA,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:31.458Z",
      "updatedAt": "2025-09-03T02:39:31.458Z",
      "chapterId": "881f3125-619d-40be-b621-17b5b8417ac6"
    },
    {
      "id": "42d4184f-8703-4e02-9369-ae54a1242539",
      "text": "tôi lớn tiếng cầu khẩn CHÚA thương,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:31.471Z",
      "updatedAt": "2025-09-03T02:39:31.471Z",
      "chapterId": "881f3125-619d-40be-b621-17b5b8417ac6"
    },
    {
      "id": "4b97b52e-65d1-41f3-b7e0-337472956f76",
      "text": "lời than vãn, xin giãi bày lên Chúa,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:31.487Z",
      "updatedAt": "2025-09-03T02:39:31.487Z",
      "chapterId": "881f3125-619d-40be-b621-17b5b8417ac6"
    },
    {
      "id": "6424d379-571d-48c0-8b0f-6ad9acf3d9bf",
      "text": "nỗi ngặt nghèo, kể lể trước thiên nhan.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:31.501Z",
      "updatedAt": "2025-09-03T02:39:31.501Z",
      "chapterId": "881f3125-619d-40be-b621-17b5b8417ac6"
    },
    {
      "id": "e2cb6164-76c2-4dd0-8f08-6a7a643759dd",
      "text": "Lạy Chúa, khi hồn con tiêu hao mòn mỏi,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:31.515Z",
      "updatedAt": "2025-09-03T02:39:31.515Z",
      "chapterId": "881f3125-619d-40be-b621-17b5b8417ac6"
    },
    {
      "id": "4756eee9-0eba-4ad6-a5b4-8c6d3baf967e",
      "text": "thì chính Chúa đã am tường mọi nẻo con đi.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:31.529Z",
      "updatedAt": "2025-09-03T02:39:31.529Z",
      "chapterId": "881f3125-619d-40be-b621-17b5b8417ac6"
    },
    {
      "id": "89c2160a-ce59-4ec0-9664-6da2e21f5ae4",
      "text": "Trên quãng đường con đang tiến bước,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:31.542Z",
      "updatedAt": "2025-09-03T02:39:31.542Z",
      "chapterId": "881f3125-619d-40be-b621-17b5b8417ac6"
    },
    {
      "id": "aa931762-e95a-4dd0-a1d7-44ee8ffb8c50",
      "text": "người ta đã gài bẫy rình chờ.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 3,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:31.557Z",
      "updatedAt": "2025-09-03T02:39:31.557Z",
      "chapterId": "881f3125-619d-40be-b621-17b5b8417ac6"
    },
    {
      "id": "77261ff2-ad0a-4aad-9552-0007b3c49c18",
      "text": "Xin đưa mắt nhìn sang bên hữu :",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:31.571Z",
      "updatedAt": "2025-09-03T02:39:31.571Z",
      "chapterId": "881f3125-619d-40be-b621-17b5b8417ac6"
    },
    {
      "id": "9d77e88f-1770-47d5-a5f0-91027f7e9194",
      "text": "chẳng một ai thèm nhận biết con ;",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:31.614Z",
      "updatedAt": "2025-09-03T02:39:31.614Z",
      "chapterId": "881f3125-619d-40be-b621-17b5b8417ac6"
    },
    {
      "id": "545c224b-0848-43b1-9f3a-18f032389755",
      "text": "không chỗ nào cho con lánh nạn,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:31.629Z",
      "updatedAt": "2025-09-03T02:39:31.629Z",
      "chapterId": "881f3125-619d-40be-b621-17b5b8417ac6"
    },
    {
      "id": "57c1bfbc-c4ab-448b-a6e1-c4b6b01870ea",
      "text": "có ai buồn nghĩ tới mạng con đâu !",
      "label": "5",
      "number": 5,
      "subVerseIndex": 3,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:31.642Z",
      "updatedAt": "2025-09-03T02:39:31.642Z",
      "chapterId": "881f3125-619d-40be-b621-17b5b8417ac6"
    },
    {
      "id": "653d2cf8-847c-4f3c-b4bc-7f94f720f1a7",
      "text": "Lạy CHÚA, con kêu gào lên Chúa,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:31.656Z",
      "updatedAt": "2025-09-03T02:39:31.656Z",
      "chapterId": "881f3125-619d-40be-b621-17b5b8417ac6"
    },
    {
      "id": "a72789b4-86b5-4c2f-9781-52d12f774390",
      "text": "con thưa rằng : chính Ngài là nơi con trú ẩn,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:31.677Z",
      "updatedAt": "2025-09-03T02:39:31.677Z",
      "chapterId": "881f3125-619d-40be-b621-17b5b8417ac6"
    },
    {
      "id": "b4ab6a54-9a29-4826-b675-7d74e366237c",
      "text": "là phần của riêng con",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:31.704Z",
      "updatedAt": "2025-09-03T02:39:31.704Z",
      "chapterId": "881f3125-619d-40be-b621-17b5b8417ac6"
    },
    {
      "id": "42a9159f-e43d-4356-8f98-6012b1109e5e",
      "text": "trong cõi đất dành cho kẻ sống.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 3,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:31.718Z",
      "updatedAt": "2025-09-03T02:39:31.718Z",
      "chapterId": "881f3125-619d-40be-b621-17b5b8417ac6"
    },
    {
      "id": "f0d9bcb1-c5bd-4eed-8728-1bc0d3cd306b",
      "text": "Xin Ngài để ý nghe tiếng con kêu, vì con thật cùng khốn.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:31.731Z",
      "updatedAt": "2025-09-03T02:39:31.731Z",
      "chapterId": "881f3125-619d-40be-b621-17b5b8417ac6"
    },
    {
      "id": "731c26d7-10e6-4c54-ac10-bf253ed5537c",
      "text": "Xin cứu con khỏi những người bách hại,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:31.760Z",
      "updatedAt": "2025-09-03T02:39:31.760Z",
      "chapterId": "881f3125-619d-40be-b621-17b5b8417ac6"
    },
    {
      "id": "fd480744-a000-4277-8078-c79b11ae8953",
      "text": "bởi chúng mạnh hơn con.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:31.789Z",
      "updatedAt": "2025-09-03T02:39:31.789Z",
      "chapterId": "881f3125-619d-40be-b621-17b5b8417ac6"
    },
    {
      "id": "7bfcf41b-226d-4ee1-8654-b86cfbad2dc6",
      "text": "Xin đưa con ra khỏi chốn ngục tù,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:31.803Z",
      "updatedAt": "2025-09-03T02:39:31.803Z",
      "chapterId": "881f3125-619d-40be-b621-17b5b8417ac6"
    },
    {
      "id": "271bec48-bff1-49b8-9d8a-fe7387f136aa",
      "text": "để con cảm tạ danh thánh Chúa.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:31.830Z",
      "updatedAt": "2025-09-03T02:39:31.830Z",
      "chapterId": "881f3125-619d-40be-b621-17b5b8417ac6"
    },
    {
      "id": "76a60810-47d3-49b9-bdab-1eff73a0bec5",
      "text": "Bao kẻ lành xúm lại mừng con,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:31.859Z",
      "updatedAt": "2025-09-03T02:39:31.859Z",
      "chapterId": "881f3125-619d-40be-b621-17b5b8417ac6"
    },
    {
      "id": "12b76aa7-f4d7-4edf-a27a-4aaac5d6a159",
      "text": "vì con đã được Ngài thi ân giáng phúc.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 3,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:31.872Z",
      "updatedAt": "2025-09-03T02:39:31.872Z",
      "chapterId": "881f3125-619d-40be-b621-17b5b8417ac6"
    }
  ],
