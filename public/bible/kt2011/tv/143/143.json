{
  "chapter": {
    "id": "39061502-d8d9-44a7-a8be-63c5aa419e58",
    "number": 143,
    "createdAt": "2025-09-03T01:07:51.663Z",
    "updatedAt": "2025-09-03T01:07:51.663Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "2cbc3b1e-a201-4154-b298-73d327cc9998",
      "text": "*Thánh vịnh. Của vua Đa-vít.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:39:36.844Z",
      "updatedAt": "2025-09-03T02:39:36.844Z",
      "chapterId": "39061502-d8d9-44a7-a8be-63c5aa419e58"
    },
    {
      "id": "31b2fe02-cad6-43aa-b28e-09c499c77d71",
      "text": "Lạy CHÚA, xin nghe lời con khẩn nguyện,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:36.906Z",
      "updatedAt": "2025-09-03T02:39:36.906Z",
      "chapterId": "39061502-d8d9-44a7-a8be-63c5aa419e58"
    },
    {
      "id": "32fc52f0-c750-44d8-9d8f-a71e19f0b992",
      "text": "lắng nghe con nài van, bởi Ngài thành tín,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:36.926Z",
      "updatedAt": "2025-09-03T02:39:36.926Z",
      "chapterId": "39061502-d8d9-44a7-a8be-63c5aa419e58"
    },
    {
      "id": "a5f7e9f2-886f-48e4-b28a-2411516342c2",
      "text": "đáp lại lời con, vì Ngài công minh.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 3,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:36.940Z",
      "updatedAt": "2025-09-03T02:39:36.940Z",
      "chapterId": "39061502-d8d9-44a7-a8be-63c5aa419e58"
    },
    {
      "id": "f747389d-b8c6-44f3-b970-b4bf8e45bc45",
      "text": "xin chớ đòi tôi tớ ra xét xử, vì trước thánh nhan Ngài",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:36.967Z",
      "updatedAt": "2025-09-03T02:39:36.967Z",
      "chapterId": "39061502-d8d9-44a7-a8be-63c5aa419e58"
    },
    {
      "id": "c4b14bb4-4e6c-4550-98d0-2108e378483d",
      "text": "chẳng có người nào là công chính.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:36.982Z",
      "updatedAt": "2025-09-03T02:39:36.982Z",
      "chapterId": "39061502-d8d9-44a7-a8be-63c5aa419e58"
    },
    {
      "id": "e85c3cd1-7fa1-4f6a-8ce3-5480bb000a8e",
      "text": "Kẻ thù bách hại con, chà đạp con dưới đất,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:37.010Z",
      "updatedAt": "2025-09-03T02:39:37.010Z",
      "chapterId": "39061502-d8d9-44a7-a8be-63c5aa419e58"
    },
    {
      "id": "c6faf6c5-f91b-4c25-8dc4-c0f9eb85838c",
      "text": "đẩy vào chốn tối tăm, như những người đã chết từ bao thuở.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:37.025Z",
      "updatedAt": "2025-09-03T02:39:37.025Z",
      "chapterId": "39061502-d8d9-44a7-a8be-63c5aa419e58"
    },
    {
      "id": "ad6bf518-6c0a-48ae-aa54-bd9944c5ae93",
      "text": "Hơi thở con chỉ còn thoi thóp,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:37.056Z",
      "updatedAt": "2025-09-03T02:39:37.056Z",
      "chapterId": "39061502-d8d9-44a7-a8be-63c5aa419e58"
    },
    {
      "id": "1add7dad-3096-40bb-8cd2-db455c8c3eb0",
      "text": "nghe con tim giá lạnh trong mình.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:37.070Z",
      "updatedAt": "2025-09-03T02:39:37.070Z",
      "chapterId": "39061502-d8d9-44a7-a8be-63c5aa419e58"
    },
    {
      "id": "70f914b7-d553-4b38-bf22-6a43a3778f65",
      "text": "Nhớ ngày xưa tháng cũ, con hoài niệm mọi công trình của Chúa",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:37.084Z",
      "updatedAt": "2025-09-03T02:39:37.084Z",
      "chapterId": "39061502-d8d9-44a7-a8be-63c5aa419e58"
    },
    {
      "id": "a38fd607-ac8d-4aee-a468-64395ee96a0e",
      "text": "và gẫm suy việc tay Chúa làm nên.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:37.112Z",
      "updatedAt": "2025-09-03T02:39:37.112Z",
      "chapterId": "39061502-d8d9-44a7-a8be-63c5aa419e58"
    },
    {
      "id": "aa589964-6218-4e9b-be12-0e45d6e44fc8",
      "text": "Hai tay cầu Chúa giơ lên,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:37.126Z",
      "updatedAt": "2025-09-03T02:39:37.126Z",
      "chapterId": "39061502-d8d9-44a7-a8be-63c5aa419e58"
    },
    {
      "id": "1f193e72-48da-4eaa-9263-cad95f07c91a",
      "text": "hồn con khát Chúa như miền đất khô.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:37.155Z",
      "updatedAt": "2025-09-03T02:39:37.155Z",
      "chapterId": "39061502-d8d9-44a7-a8be-63c5aa419e58"
    },
    {
      "id": "36fa86ba-068b-4356-9475-389b5627656f",
      "text": "Xin mau đáp lời con, lạy CHÚA, hơi thở con nay đã hầu tàn.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:37.182Z",
      "updatedAt": "2025-09-03T02:39:37.182Z",
      "chapterId": "39061502-d8d9-44a7-a8be-63c5aa419e58"
    },
    {
      "id": "92fc6a63-b641-41f3-92e1-4317493a52b9",
      "text": "Xin đừng ẩn mặt đi, kẻo con hoá ra người thiên cổ.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:37.208Z",
      "updatedAt": "2025-09-03T02:39:37.208Z",
      "chapterId": "39061502-d8d9-44a7-a8be-63c5aa419e58"
    },
    {
      "id": "6398e8f5-1f20-4cfa-85bf-e8857df85033",
      "text": "Ngay từ buổi sớm mai,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:37.233Z",
      "updatedAt": "2025-09-03T02:39:37.233Z",
      "chapterId": "39061502-d8d9-44a7-a8be-63c5aa419e58"
    },
    {
      "id": "3ba7b474-a60e-4151-8864-682b56ee826f",
      "text": "xin cho con nghiệm thấy tình thương của Chúa,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:37.246Z",
      "updatedAt": "2025-09-03T02:39:37.246Z",
      "chapterId": "39061502-d8d9-44a7-a8be-63c5aa419e58"
    },
    {
      "id": "82eac750-a6d0-4d72-9cec-3997eb3e0585",
      "text": "vì con vẫn tin cậy nơi Ngài.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:37.260Z",
      "updatedAt": "2025-09-03T02:39:37.260Z",
      "chapterId": "39061502-d8d9-44a7-a8be-63c5aa419e58"
    },
    {
      "id": "2f69c6c3-5970-47b5-a9bb-1cab10530731",
      "text": "Xin chỉ dạy đường lối phải theo,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 3,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:37.274Z",
      "updatedAt": "2025-09-03T02:39:37.274Z",
      "chapterId": "39061502-d8d9-44a7-a8be-63c5aa419e58"
    },
    {
      "id": "b5651f97-fd00-4b94-bf96-0c16aefd8ab1",
      "text": "vì con nâng tâm hồn lên cùng Chúa.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 4,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:37.302Z",
      "updatedAt": "2025-09-03T02:39:37.302Z",
      "chapterId": "39061502-d8d9-44a7-a8be-63c5aa419e58"
    },
    {
      "id": "16320ba3-b9a8-49a3-b7e3-8e8c47cc62d9",
      "text": "Xin cứu con thoát khỏi địch thù,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:37.330Z",
      "updatedAt": "2025-09-03T02:39:37.330Z",
      "chapterId": "39061502-d8d9-44a7-a8be-63c5aa419e58"
    },
    {
      "id": "56c56026-469a-43bf-8f6e-0f1b2c67377c",
      "text": "lạy CHÚA, bên Ngài con trú ẩn.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:37.358Z",
      "updatedAt": "2025-09-03T02:39:37.358Z",
      "chapterId": "39061502-d8d9-44a7-a8be-63c5aa419e58"
    },
    {
      "id": "f88cd2d9-9ddf-4716-87b7-63ad14256d8e",
      "text": "Điều đẹp ý Ngài, xin dạy con thực hiện,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:37.372Z",
      "updatedAt": "2025-09-03T02:39:37.372Z",
      "chapterId": "39061502-d8d9-44a7-a8be-63c5aa419e58"
    },
    {
      "id": "4c5ea025-3c3c-41e7-a545-e4e5a20f18c3",
      "text": "bởi Ngài là Thiên Chúa của con.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:37.385Z",
      "updatedAt": "2025-09-03T02:39:37.385Z",
      "chapterId": "39061502-d8d9-44a7-a8be-63c5aa419e58"
    },
    {
      "id": "8a07f69e-b3d5-482b-87ca-b5f7977f0ba4",
      "text": "Xin thần khí tốt lành của Chúa",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:37.399Z",
      "updatedAt": "2025-09-03T02:39:37.399Z",
      "chapterId": "39061502-d8d9-44a7-a8be-63c5aa419e58"
    },
    {
      "id": "7751370f-1fbf-4d70-9d8f-9870d778ad84",
      "text": "dẫn con đi trên miền đất phẳng phiu.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 3,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:37.428Z",
      "updatedAt": "2025-09-03T02:39:37.428Z",
      "chapterId": "39061502-d8d9-44a7-a8be-63c5aa419e58"
    },
    {
      "id": "ac81169a-e5bd-4f1e-bee4-c472a4040ab8",
      "text": "Lạy CHÚA, vì danh dự của Ngài, xin cho con được sống.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:37.442Z",
      "updatedAt": "2025-09-03T02:39:37.442Z",
      "chapterId": "39061502-d8d9-44a7-a8be-63c5aa419e58"
    },
    {
      "id": "fb36ab35-32c5-454f-92ea-39c9dc51187b",
      "text": "Bởi vì Ngài công chính, xin cứu con khỏi bước ngặt nghèo.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:37.456Z",
      "updatedAt": "2025-09-03T02:39:37.456Z",
      "chapterId": "39061502-d8d9-44a7-a8be-63c5aa419e58"
    },
    {
      "id": "e51a381b-3247-490c-a0f4-4c4419f0b3c2",
      "text": "Vì Ngài vẫn một lòng thương mến,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:37.470Z",
      "updatedAt": "2025-09-03T02:39:37.470Z",
      "chapterId": "39061502-d8d9-44a7-a8be-63c5aa419e58"
    },
    {
      "id": "6ea3fc5d-05da-48c3-b170-bfc09e84e221",
      "text": "xin tiêu diệt những kẻ thù con.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:37.484Z",
      "updatedAt": "2025-09-03T02:39:37.484Z",
      "chapterId": "39061502-d8d9-44a7-a8be-63c5aa419e58"
    },
    {
      "id": "2e897f7f-7942-47ea-82dc-af8314a09231",
      "text": "Xin làm cho thù địch con chết hết,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:37.502Z",
      "updatedAt": "2025-09-03T02:39:37.502Z",
      "chapterId": "39061502-d8d9-44a7-a8be-63c5aa419e58"
    },
    {
      "id": "4e13d5fd-df5d-4c60-8ceb-7765698b1bb1",
      "text": "vì con là tôi tớ của Ngài.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 3,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:37.530Z",
      "updatedAt": "2025-09-03T02:39:37.530Z",
      "chapterId": "39061502-d8d9-44a7-a8be-63c5aa419e58"
    }
  ],
