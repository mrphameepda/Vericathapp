{
  "chapter": {
    "id": "4e666db1-9c10-44eb-8f38-bb287787bffd",
    "number": 144,
    "createdAt": "2025-09-03T01:07:51.663Z",
    "updatedAt": "2025-09-03T01:07:51.663Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "0b47ef3d-8134-42ce-a1c6-bcf3d582b4fe",
      "text": "*Của vua Đa-vít.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:39:42.586Z",
      "updatedAt": "2025-09-03T02:39:42.586Z",
      "chapterId": "4e666db1-9c10-44eb-8f38-bb287787bffd"
    },
    {
      "id": "03e3edd6-454e-4c5c-bced-7fee26237a4e",
      "text": "Chúc tụng CHÚA là núi đá cho tôi nương ẩn,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:42.639Z",
      "updatedAt": "2025-09-03T02:39:42.639Z",
      "chapterId": "4e666db1-9c10-44eb-8f38-bb287787bffd"
    },
    {
      "id": "8ab5ccf0-cc39-4875-a1bb-97099e54ec48",
      "text": "là Đấng dạy tôi nên người thiện chiến,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:42.664Z",
      "updatedAt": "2025-09-03T02:39:42.664Z",
      "chapterId": "4e666db1-9c10-44eb-8f38-bb287787bffd"
    },
    {
      "id": "16ac2511-2f8d-4b6e-837c-4bd3921d9b7b",
      "text": "luyện thành tay võ nghệ cao cường.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 3,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:42.678Z",
      "updatedAt": "2025-09-03T02:39:42.678Z",
      "chapterId": "4e666db1-9c10-44eb-8f38-bb287787bffd"
    },
    {
      "id": "989b246b-efdd-45ea-acf5-ec6ebd56ef0e",
      "text": "Chúa là đồng minh, là đồn luỹ che chở,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:42.692Z",
      "updatedAt": "2025-09-03T02:39:42.692Z",
      "chapterId": "4e666db1-9c10-44eb-8f38-bb287787bffd"
    },
    {
      "id": "49e5259f-0ace-4a91-8283-1a7437527d2f",
      "text": "là thành trì bảo vệ, là Đấng giải thoát tôi.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:42.706Z",
      "updatedAt": "2025-09-03T02:39:42.706Z",
      "chapterId": "4e666db1-9c10-44eb-8f38-bb287787bffd"
    },
    {
      "id": "77397608-f70b-4916-8ee6-f9f171604b72",
      "text": "Chúa là khiên mộc cho tôi ẩn núp,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:42.720Z",
      "updatedAt": "2025-09-03T02:39:42.720Z",
      "chapterId": "4e666db1-9c10-44eb-8f38-bb287787bffd"
    },
    {
      "id": "572d3f79-8e28-4f0e-83d3-e34d6e05c515",
      "text": "Người bắt chư dân quy phục quyền tôi.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 3,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:42.734Z",
      "updatedAt": "2025-09-03T02:39:42.734Z",
      "chapterId": "4e666db1-9c10-44eb-8f38-bb287787bffd"
    },
    {
      "id": "b5e27bdf-f0a9-43c0-ae86-204f2ddf25c2",
      "text": "Lạy CHÚA, con người có là chi, mà Chúa cần biết đến ?",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:42.752Z",
      "updatedAt": "2025-09-03T02:39:42.752Z",
      "chapterId": "4e666db1-9c10-44eb-8f38-bb287787bffd"
    },
    {
      "id": "e17dbb9e-4067-4c8a-bceb-00d6d7bb8b76",
      "text": "Phàm nhân đáng là gì, mà Chúa phải lưu tâm ?",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:42.782Z",
      "updatedAt": "2025-09-03T02:39:42.782Z",
      "chapterId": "4e666db1-9c10-44eb-8f38-bb287787bffd"
    },
    {
      "id": "fc6b42ca-5834-497e-a584-9897937f7664",
      "text": "Ấy con người khác chi hơi thở,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:42.794Z",
      "updatedAt": "2025-09-03T02:39:42.794Z",
      "chapterId": "4e666db1-9c10-44eb-8f38-bb287787bffd"
    },
    {
      "id": "9ca2e861-3558-4df4-98b0-8a7cc9b0e236",
      "text": "vùn vụt tuổi đời tựa bóng câu.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:42.820Z",
      "updatedAt": "2025-09-03T02:39:42.820Z",
      "chapterId": "4e666db1-9c10-44eb-8f38-bb287787bffd"
    },
    {
      "id": "1c21f62e-e054-4470-8545-c196ad42f517",
      "text": "Lạy CHÚA, xin nghiêng trời ngự xuống,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:42.848Z",
      "updatedAt": "2025-09-03T02:39:42.848Z",
      "chapterId": "4e666db1-9c10-44eb-8f38-bb287787bffd"
    },
    {
      "id": "51ca913a-311d-4637-a835-d0ab78c17437",
      "text": "chạm núi cao cho toả khói mịt mù ;",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:42.866Z",
      "updatedAt": "2025-09-03T02:39:42.866Z",
      "chapterId": "4e666db1-9c10-44eb-8f38-bb287787bffd"
    },
    {
      "id": "5ab6b4be-385a-4616-9c3e-d243f05a1364",
      "text": "xin tung chớp loà khiến địch quân tán loạn,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:42.880Z",
      "updatedAt": "2025-09-03T02:39:42.880Z",
      "chapterId": "4e666db1-9c10-44eb-8f38-bb287787bffd"
    },
    {
      "id": "f9298a0a-32d5-45ef-9553-adc506f4d33f",
      "text": "phóng tên bay làm chúng phải rã tan.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:42.894Z",
      "updatedAt": "2025-09-03T02:39:42.894Z",
      "chapterId": "4e666db1-9c10-44eb-8f38-bb287787bffd"
    },
    {
      "id": "ed1b8885-8dde-42c7-9ce3-1826023b03c0",
      "text": "Từ cao thẳm xin đưa tay giải thoát,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:42.908Z",
      "updatedAt": "2025-09-03T02:39:42.908Z",
      "chapterId": "4e666db1-9c10-44eb-8f38-bb287787bffd"
    },
    {
      "id": "874526f3-0788-45c2-845f-cee2a79e0b90",
      "text": "cứu con lên khỏi đáy nước mênh mông,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:42.921Z",
      "updatedAt": "2025-09-03T02:39:42.921Z",
      "chapterId": "4e666db1-9c10-44eb-8f38-bb287787bffd"
    },
    {
      "id": "0885f428-53d8-485f-a039-599b804848bb",
      "text": "khỏi thế lực nước ngoài.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:42.950Z",
      "updatedAt": "2025-09-03T02:39:42.950Z",
      "chapterId": "4e666db1-9c10-44eb-8f38-bb287787bffd"
    },
    {
      "id": "579b7e69-b6ac-441e-8bbf-2d080584df68",
      "text": "Miệng chúng nói toàn điều xảo trá,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:42.964Z",
      "updatedAt": "2025-09-03T02:39:42.964Z",
      "chapterId": "4e666db1-9c10-44eb-8f38-bb287787bffd"
    },
    {
      "id": "304ebd25-595c-4c05-8e4d-6144c98ba130",
      "text": "giơ tay thề chỉ biết thề gian !",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:42.978Z",
      "updatedAt": "2025-09-03T02:39:42.978Z",
      "chapterId": "4e666db1-9c10-44eb-8f38-bb287787bffd"
    },
    {
      "id": "05e2d56f-4923-4a23-b1fb-995adcad7626",
      "text": "Lạy Chúa Trời, xin dâng Chúa một bài ca mới,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:42.992Z",
      "updatedAt": "2025-09-03T02:39:42.992Z",
      "chapterId": "4e666db1-9c10-44eb-8f38-bb287787bffd"
    },
    {
      "id": "71d4208c-876e-4405-a1d2-ccd42d5a24f2",
      "text": "thập huyền cầm, con gảy đôi cung.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:43.006Z",
      "updatedAt": "2025-09-03T02:39:43.006Z",
      "chapterId": "4e666db1-9c10-44eb-8f38-bb287787bffd"
    },
    {
      "id": "10362b96-8224-4dc7-bfdb-13d51b896e57",
      "text": "Chính Ngài cho các vua thắng trận,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:43.020Z",
      "updatedAt": "2025-09-03T02:39:43.020Z",
      "chapterId": "4e666db1-9c10-44eb-8f38-bb287787bffd"
    },
    {
      "id": "c81701fd-0abc-4be8-a767-25f70882e37b",
      "text": "cứu mạng Đa-vít, kẻ trung thần,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:43.034Z",
      "updatedAt": "2025-09-03T02:39:43.034Z",
      "chapterId": "4e666db1-9c10-44eb-8f38-bb287787bffd"
    },
    {
      "id": "9bdcdb83-2090-4d0d-bf7c-205280b69871",
      "text": "khỏi lưỡi gươm ác nghiệt.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:43.062Z",
      "updatedAt": "2025-09-03T02:39:43.062Z",
      "chapterId": "4e666db1-9c10-44eb-8f38-bb287787bffd"
    },
    {
      "id": "22672adc-cfe8-45b9-b20e-59dfd96e961c",
      "text": "Xin cứu độ và giải thoát con khỏi thế lực nước ngoài ;",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:43.076Z",
      "updatedAt": "2025-09-03T02:39:43.076Z",
      "chapterId": "4e666db1-9c10-44eb-8f38-bb287787bffd"
    },
    {
      "id": "3bf7156b-16d7-4e39-b222-913a201f9e7b",
      "text": "miệng chúng nói toàn lời xảo trá,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:43.105Z",
      "updatedAt": "2025-09-03T02:39:43.105Z",
      "chapterId": "4e666db1-9c10-44eb-8f38-bb287787bffd"
    },
    {
      "id": "3dc0ada6-ef43-427e-aa59-e4bf082cde0a",
      "text": "giơ tay thề : chỉ biết thề gian.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:43.119Z",
      "updatedAt": "2025-09-03T02:39:43.119Z",
      "chapterId": "4e666db1-9c10-44eb-8f38-bb287787bffd"
    },
    {
      "id": "a708a49a-755b-498e-9882-2d681cfafe84",
      "text": "Mong đàn con trai ta mạnh như cây vừa lớn",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:43.133Z",
      "updatedAt": "2025-09-03T02:39:43.133Z",
      "chapterId": "4e666db1-9c10-44eb-8f38-bb287787bffd"
    },
    {
      "id": "ecb980a1-341d-468d-8852-d15f3de2f756",
      "text": "đang tuổi xuân mơn mởn ;",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:43.161Z",
      "updatedAt": "2025-09-03T02:39:43.161Z",
      "chapterId": "4e666db1-9c10-44eb-8f38-bb287787bffd"
    },
    {
      "id": "acad0b8b-0e00-41a6-b408-d9cd9b8075ef",
      "text": "mong bầy con gái ta đẹp như hình mỹ nữ",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:43.175Z",
      "updatedAt": "2025-09-03T02:39:43.175Z",
      "chapterId": "4e666db1-9c10-44eb-8f38-bb287787bffd"
    },
    {
      "id": "d235a923-dd48-441f-99e5-b1c6b5aa24a9",
      "text": "khắc trên cột đền đài.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 3,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:43.188Z",
      "updatedAt": "2025-09-03T02:39:43.188Z",
      "chapterId": "4e666db1-9c10-44eb-8f38-bb287787bffd"
    },
    {
      "id": "429d020c-8246-46c2-9104-210afcf15593",
      "text": "Mong sao kho lẫm ta đầy ứ đủ mọi thứ hoa màu.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:43.201Z",
      "updatedAt": "2025-09-03T02:39:43.201Z",
      "chapterId": "4e666db1-9c10-44eb-8f38-bb287787bffd"
    },
    {
      "id": "ea696648-f810-4576-b30d-bacceba873d5",
      "text": "Số chiên cừu tăng lên ngàn vạn",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:43.214Z",
      "updatedAt": "2025-09-03T02:39:43.214Z",
      "chapterId": "4e666db1-9c10-44eb-8f38-bb287787bffd"
    },
    {
      "id": "6f392c78-1f71-4096-98e8-7e07cddc56ec",
      "text": "tràn ngập khắp đồng quê.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:43.226Z",
      "updatedAt": "2025-09-03T02:39:43.226Z",
      "chapterId": "4e666db1-9c10-44eb-8f38-bb287787bffd"
    },
    {
      "id": "3a4b0dcb-8d39-4cd8-b24b-ebc3c776f134",
      "text": "Mong sao giống bò bê mập tròn béo tốt,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:43.239Z",
      "updatedAt": "2025-09-03T02:39:43.239Z",
      "chapterId": "4e666db1-9c10-44eb-8f38-bb287787bffd"
    },
    {
      "id": "4c15658c-57b4-444c-ace4-200167cb3817",
      "text": "không chết chóc lạc đàn ;",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:43.256Z",
      "updatedAt": "2025-09-03T02:39:43.256Z",
      "chapterId": "4e666db1-9c10-44eb-8f38-bb287787bffd"
    },
    {
      "id": "5dca0704-1d2c-4366-abe0-b23c7769883d",
      "text": "và mong sao đầu đường cuối phố",
      "label": "14",
      "number": 14,
      "subVerseIndex": 2,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:43.270Z",
