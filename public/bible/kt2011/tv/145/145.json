{
  "chapter": {
    "id": "e2556980-48f4-4e2a-b690-affc54742bc4",
    "number": 145,
    "createdAt": "2025-09-03T01:07:51.663Z",
    "updatedAt": "2025-09-03T01:07:51.663Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "cbd376a5-7164-4534-ade5-9c08cd1bbad8",
      "text": "*Ngợi khen. Của vua Đa-vít.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:39:48.188Z",
      "updatedAt": "2025-09-03T02:39:48.188Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "911d7fd7-605e-4fbc-a3c1-853aa2be6c8d",
      "text": "A-lép",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:39:48.253Z",
      "updatedAt": "2025-09-03T02:39:48.253Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "f13a99d3-5508-4701-8290-e11e8cc16dfa",
      "text": "Lạy Thiên Chúa con thờ là Vua của con,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:48.265Z",
      "updatedAt": "2025-09-03T02:39:48.265Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "da284b96-cf91-46a9-9b10-9ada50c8ea85",
      "text": "con nguyện tán dương Chúa",
      "label": "1",
      "number": 1,
      "subVerseIndex": 3,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:48.279Z",
      "updatedAt": "2025-09-03T02:39:48.279Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "07fc8178-1e54-4c0e-82c9-07382e44edd9",
      "text": "và chúc tụng Thánh Danh muôn thuở muôn đời.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 4,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:48.292Z",
      "updatedAt": "2025-09-03T02:39:48.292Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "1c60d808-8189-43c7-843e-ce4320c9ef0d",
      "text": "Bết",
      "label": "1",
      "number": 1,
      "subVerseIndex": 5,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:39:48.306Z",
      "updatedAt": "2025-09-03T02:39:48.306Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "e8250553-fa57-4a8d-8181-174c11164329",
      "text": "Ngày lại ngày, con xin chúc tụng Chúa",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:48.320Z",
      "updatedAt": "2025-09-03T02:39:48.320Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "6c812112-7d6b-44e9-8860-d18a8ead134f",
      "text": "và ca ngợi Thánh Danh muôn thuở muôn đời.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:48.334Z",
      "updatedAt": "2025-09-03T02:39:48.334Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "42064c3c-bc93-4dc3-96be-4d8bd99c0d5f",
      "text": "Ghi-men",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:39:48.348Z",
      "updatedAt": "2025-09-03T02:39:48.348Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "64fbf01f-54be-4829-8c2c-c0d0eed37bff",
      "text": "CHÚA thật cao cả, xứng muôn lời ca tụng.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:48.362Z",
      "updatedAt": "2025-09-03T02:39:48.362Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "84709915-2b1d-44af-9d5e-9873c1b75911",
      "text": "Người cao cả khôn dò khôn thấu.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:48.376Z",
      "updatedAt": "2025-09-03T02:39:48.376Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "5e014b78-35dc-4e05-a645-1df124527334",
      "text": "Đa-lét",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:39:48.390Z",
      "updatedAt": "2025-09-03T02:39:48.390Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "adbef98d-b61c-43af-90d1-577793469f82",
      "text": "Đời nọ tới đời kia, thiên hạ đề cao sự nghiệp Chúa",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:48.404Z",
      "updatedAt": "2025-09-03T02:39:48.404Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "6728bb95-d162-4aa5-8dbd-dfedce2bca6d",
      "text": "và truyền tụng những chiến công của Ngài,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:48.418Z",
      "updatedAt": "2025-09-03T02:39:48.418Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "83da7b5c-fcc1-45fa-9f94-a6942121dda4",
      "text": "Hê",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:39:48.432Z",
      "updatedAt": "2025-09-03T02:39:48.432Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "a5e177ec-a0ef-4f42-a86b-c04f68c30bf7",
      "text": "tuyên bố Ngài oai phong vinh hiển,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:48.446Z",
      "updatedAt": "2025-09-03T02:39:48.446Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "effdede9-f310-43c2-a7fe-c1d53661ae53",
      "text": "kể lại rằng : Ngài thực hiện những kỳ công,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:48.459Z",
      "updatedAt": "2025-09-03T02:39:48.459Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "79336a24-4285-4471-9e13-ad0c520c6c80",
      "text": "Vau",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:39:48.474Z",
      "updatedAt": "2025-09-03T02:39:48.474Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "ed2876a6-e57c-4b51-9c55-ce591b39ab93",
      "text": "bảo cho nhau : sức mạnh Ngài đáng sợ,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:48.488Z",
      "updatedAt": "2025-09-03T02:39:48.488Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "ab5abc2b-181d-4e32-939b-e6cf3c4deaf3",
      "text": "loan truyền rằng : Ngài cao cả lắm thay !",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:48.503Z",
      "updatedAt": "2025-09-03T02:39:48.503Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "2b5b0552-0525-471e-a4f6-f53be9342051",
      "text": "Da-in",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:39:48.517Z",
      "updatedAt": "2025-09-03T02:39:48.517Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "4b7725dd-8568-40c4-8f50-43f419226439",
      "text": "Nhắc nhở luôn : Ngài nhân ái vô cùng,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:48.531Z",
      "updatedAt": "2025-09-03T02:39:48.531Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "4e80b951-30a7-4b8f-bbb0-924f7b717ab1",
      "text": "hoan hô Ngài công chính.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:48.545Z",
      "updatedAt": "2025-09-03T02:39:48.545Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "b975a21e-9c9f-4a21-9719-9949d540f53f",
      "text": "Khết",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:39:48.573Z",
      "updatedAt": "2025-09-03T02:39:48.573Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "52f6e538-66b3-45c8-b5d8-b14880a30c8e",
      "text": "CHÚA là Đấng từ bi nhân hậu,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:48.587Z",
      "updatedAt": "2025-09-03T02:39:48.587Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "a956362f-007c-4348-94fe-4e32a58d72b3",
      "text": "Người chậm giận và giàu tình thương.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:48.615Z",
      "updatedAt": "2025-09-03T02:39:48.615Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "b9a8b09b-46ac-4841-99c2-1971d4329b47",
      "text": "Tết",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:39:48.631Z",
      "updatedAt": "2025-09-03T02:39:48.631Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "f9aaf132-75e3-4162-b1c2-b27c336e734d",
      "text": "CHÚA nhân ái đối với mọi người,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:48.645Z",
      "updatedAt": "2025-09-03T02:39:48.645Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "0c4ea358-7cda-4468-b48d-4b6db12b4674",
      "text": "tỏ lòng nhân hậu với muôn loài Chúa đã dựng nên.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:48.658Z",
      "updatedAt": "2025-09-03T02:39:48.658Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "b0a3428a-0409-4b8b-b54d-dcad2f4a9042",
      "text": "Giốt",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:39:48.673Z",
      "updatedAt": "2025-09-03T02:39:48.673Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "fbee6240-615e-41d4-9ee6-72504a72b417",
      "text": "Lạy CHÚA, muôn loài Chúa dựng nên phải dâng lời tán tạ,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:48.687Z",
      "updatedAt": "2025-09-03T02:39:48.687Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "475ef307-fbe2-4306-8a39-c5ba239516b5",
      "text": "kẻ hiếu trung phải chúc tụng Ngài,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:48.701Z",
      "updatedAt": "2025-09-03T02:39:48.701Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "688cae83-2345-41a9-898c-c648ff4da3e2",
      "text": "Cáp",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:39:48.715Z",
      "updatedAt": "2025-09-03T02:39:48.715Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "1e3ddf1b-0692-4bb5-a466-8d6487336a6b",
      "text": "nói lên rằng : triều đại Ngài vinh hiển,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:48.729Z",
      "updatedAt": "2025-09-03T02:39:48.729Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "b56cd652-77f4-4879-af94-0d5b33a98c9d",
      "text": "xưng tụng Ngài là Đấng quyền năng,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:48.756Z",
      "updatedAt": "2025-09-03T02:39:48.756Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "da861cf8-bd26-47f2-b568-d29ce9a4f83c",
      "text": "La-mét",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:39:48.772Z",
      "updatedAt": "2025-09-03T02:39:48.772Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "84d7d113-e05a-4528-8960-01e8475763b5",
      "text": "để nhân loại được tường những chiến công của Chúa,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:48.786Z",
      "updatedAt": "2025-09-03T02:39:48.786Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "705ab5fa-a765-46fa-8e02-a5c63a7a491c",
      "text": "và được biết triều đại Ngài rực rỡ vinh quang.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:48.799Z",
      "updatedAt": "2025-09-03T02:39:48.799Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "40ad9e8f-d16f-4532-b416-6ac04477f589",
      "text": "Mêm",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:39:48.813Z",
      "updatedAt": "2025-09-03T02:39:48.813Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "50756946-c81d-4900-add4-b9df405c9334",
      "text": "Triều đại Ngài : thiên niên vĩnh cửu,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:48.827Z",
      "updatedAt": "2025-09-03T02:39:48.827Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "bb309902-62d3-4327-9a16-e2285ccfd705",
      "text": "vương quyền Ngài vạn đại trường tồn.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:48.842Z",
      "updatedAt": "2025-09-03T02:39:48.842Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "c876790d-c627-4dfd-b517-b11fd401ddad",
      "text": "Chúa thành tín trong mọi lời Chúa phán,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:48.856Z",
      "updatedAt": "2025-09-03T02:39:48.856Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "7f6e93f5-5a1b-4fcf-98d3-0fcbe359dc94",
      "text": "đầy yêu thương trong mọi việc Người làm.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 3,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:48.870Z",
      "updatedAt": "2025-09-03T02:39:48.870Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "b604dd68-046f-467c-8b9e-32cf5fba2300",
      "text": "Xa-méc",
      "label": "13",
      "number": 13,
      "subVerseIndex": 4,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:39:48.899Z",
      "updatedAt": "2025-09-03T02:39:48.899Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "495acdbe-8a80-4eda-8fd5-b56caf3c743d",
      "text": "Ai quỵ ngã, CHÚA đều nâng dậy,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:48.913Z",
      "updatedAt": "2025-09-03T02:39:48.913Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "1492bdde-46f4-4d56-a26c-23840359809b",
      "text": "kẻ bị đè nén, Người cho đứng thẳng lên.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:48.926Z",
      "updatedAt": "2025-09-03T02:39:48.926Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "f6a1c180-f3b3-4b56-9e3d-b149de209a16",
      "text": "A-in",
      "label": "14",
      "number": 14,
      "subVerseIndex": 2,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:39:48.941Z",
      "updatedAt": "2025-09-03T02:39:48.941Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "4fd31854-93a2-431a-82d8-30f2ff04b323",
      "text": "Lạy Chúa, muôn loài ngước mắt trông lên Chúa,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:48.954Z",
      "updatedAt": "2025-09-03T02:39:48.954Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "2bbd1e9f-1376-4509-8e4f-c4f07437d5b2",
      "text": "và chính Ngài đúng bữa cho ăn.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:48.969Z",
      "updatedAt": "2025-09-03T02:39:48.969Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "0218b10a-573e-452f-94f0-ade9fbf8ba6a",
      "text": "Pê",
      "label": "15",
      "number": 15,
      "subVerseIndex": 2,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:39:48.995Z",
      "updatedAt": "2025-09-03T02:39:48.995Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "7f2f8a6f-02b4-46fb-8ae3-e37173b5e693",
      "text": "Khi Ngài rộng mở tay ban,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:49.008Z",
      "updatedAt": "2025-09-03T02:39:49.008Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "f41b081a-691a-489f-b071-69f2cc9c2c28",
      "text": "là bao sinh vật muôn vàn thoả thuê.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:49.022Z",
      "updatedAt": "2025-09-03T02:39:49.022Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "de100a7f-8e28-4914-b9bb-c65e6b956813",
      "text": "Xa-đê",
      "label": "16",
      "number": 16,
      "subVerseIndex": 2,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:39:49.036Z",
      "updatedAt": "2025-09-03T02:39:49.036Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "03c16625-ee5e-4a02-926a-be37322de2f4",
      "text": "CHÚA công minh trong mọi đường lối Chúa,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:49.049Z",
      "updatedAt": "2025-09-03T02:39:49.049Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "ef2e791c-244d-438e-aa84-adfb07494be0",
      "text": "đầy yêu thương trong mọi việc Người làm.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:49.062Z",
      "updatedAt": "2025-09-03T02:39:49.062Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "71440c00-de30-49fa-a1d0-3683eb40835f",
      "text": "Cốp",
      "label": "17",
      "number": 17,
      "subVerseIndex": 2,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:39:49.076Z",
      "updatedAt": "2025-09-03T02:39:49.076Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "082d221b-b95f-4dfe-916a-1856c77a6882",
      "text": "CHÚA gần gũi tất cả những ai cầu khẩn Chúa,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:49.090Z",
      "updatedAt": "2025-09-03T02:39:49.090Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "985f337b-1e6d-4623-af87-43cb865eeaff",
      "text": "mọi kẻ thành tâm cầu khẩn Người.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:49.104Z",
      "updatedAt": "2025-09-03T02:39:49.104Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "ac7637f9-06ea-490d-b165-30dfb5161f24",
      "text": "Rết",
      "label": "18",
      "number": 18,
      "subVerseIndex": 2,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:39:49.118Z",
      "updatedAt": "2025-09-03T02:39:49.118Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "09311b71-56b2-4fd6-b841-310218796c44",
      "text": "Kẻ kính sợ Người, Người cho toại nguyện,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:49.132Z",
      "updatedAt": "2025-09-03T02:39:49.132Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "b3e069b1-6572-4e45-839e-82e3052deef8",
      "text": "nghe tiếng họ kêu than, và ban ơn giải cứu,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:49.145Z",
      "updatedAt": "2025-09-03T02:39:49.145Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "7dce3380-2a8e-4c3e-aabc-ec7c737096f5",
      "text": "Sin",
      "label": "19",
      "number": 19,
      "subVerseIndex": 2,
      "paragraphNumber": 61,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:39:49.160Z",
      "updatedAt": "2025-09-03T02:39:49.160Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "ea90ecac-fd34-484b-837e-bc3022af36c8",
      "text": "CHÚA gìn giữ mọi kẻ mến yêu Người,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 62,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:49.174Z",
      "updatedAt": "2025-09-03T02:39:49.174Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "62b3edab-8ff2-4cd8-9fbb-b8e682a4141d",
      "text": "nhưng lại diệt trừ hết bọn ác nhân.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 63,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:49.187Z",
      "updatedAt": "2025-09-03T02:39:49.187Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "712ae1c9-ef68-44c6-b92a-d17957be5b59",
      "text": "Tau",
      "label": "20",
      "number": 20,
      "subVerseIndex": 2,
      "paragraphNumber": 64,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:39:49.199Z",
      "updatedAt": "2025-09-03T02:39:49.199Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "1d74c5ec-b1eb-401d-ab4f-a6f144b00024",
      "text": "Môi miệng tôi, hãy dâng lời ca ngợi CHÚA,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 65,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:49.210Z",
      "updatedAt": "2025-09-03T02:39:49.210Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "29f35c3a-1b1e-4bea-871f-35a7a41235aa",
      "text": "chúng sinh hết thảy, nào chúc tụng Thánh Danh",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 66,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:49.222Z",
      "updatedAt": "2025-09-03T02:39:49.222Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    },
    {
      "id": "73102413-b2ff-422e-90e8-f75714c30b35",
      "text": "đến muôn thuở muôn đời !",
      "label": "21",
      "number": 21,
      "subVerseIndex": 2,
      "paragraphNumber": 67,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:49.234Z",
      "updatedAt": "2025-09-03T02:39:49.234Z",
      "chapterId": "e2556980-48f4-4e2a-b690-affc54742bc4"
    }
  ],
