{
  "chapter": {
    "id": "e2f7e8dc-7e2b-489a-8300-928bd3511445",
    "number": 146,
    "createdAt": "2025-09-03T01:07:51.663Z",
    "updatedAt": "2025-09-03T01:07:51.663Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "2f0516b8-3310-4325-b867-713ea67c3293",
      "text": "Ha-lê-lui-a !",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:54.465Z",
      "updatedAt": "2025-09-03T02:39:54.465Z",
      "chapterId": "e2f7e8dc-7e2b-489a-8300-928bd3511445"
    },
    {
      "id": "3bc68cc4-b3f0-4d93-a28d-d327874bd1e4",
      "text": "Ca tụng CHÚA đi, hồn tôi hỡi !",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:54.516Z",
      "updatedAt": "2025-09-03T02:39:54.516Z",
      "chapterId": "e2f7e8dc-7e2b-489a-8300-928bd3511445"
    },
    {
      "id": "c128e1b6-812b-4dba-b466-3d7c5bde56b1",
      "text": "Suốt cuộc đời, tôi xin hát mừng CHÚA,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:54.530Z",
      "updatedAt": "2025-09-03T02:39:54.530Z",
      "chapterId": "e2f7e8dc-7e2b-489a-8300-928bd3511445"
    },
    {
      "id": "3b9fc3b1-16c2-42e1-b9d7-7ad833bd568f",
      "text": "sống bao lâu, nguyện đàn ca kính Chúa Trời.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:54.543Z",
      "updatedAt": "2025-09-03T02:39:54.543Z",
      "chapterId": "e2f7e8dc-7e2b-489a-8300-928bd3511445"
    },
    {
      "id": "9b9d01b1-a0ca-42ee-bd67-f0c0914eabc8",
      "text": "Đừng tin tưởng nơi hàng quyền thế,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:54.557Z",
      "updatedAt": "2025-09-03T02:39:54.557Z",
      "chapterId": "e2f7e8dc-7e2b-489a-8300-928bd3511445"
    },
    {
      "id": "dc8958e3-4e1c-4ffb-bd3f-769e69f10132",
      "text": "nơi người phàm chẳng cứu nổi ai.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:54.572Z",
      "updatedAt": "2025-09-03T02:39:54.572Z",
      "chapterId": "e2f7e8dc-7e2b-489a-8300-928bd3511445"
    },
    {
      "id": "85ab614e-58c4-43e2-bfe3-0d8350c4cd02",
      "text": "Họ tắt hơi là trở về cát bụi,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:54.586Z",
      "updatedAt": "2025-09-03T02:39:54.586Z",
      "chapterId": "e2f7e8dc-7e2b-489a-8300-928bd3511445"
    },
    {
      "id": "d68fde59-0b69-4d4f-9540-9e44d68a39d2",
      "text": "dự định bao điều : ngày ấy tiêu tan.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:54.600Z",
      "updatedAt": "2025-09-03T02:39:54.600Z",
      "chapterId": "e2f7e8dc-7e2b-489a-8300-928bd3511445"
    },
    {
      "id": "f55f5d78-1386-4ca6-89ac-c5d9aaaab204",
      "text": "Phúc thay người được Chúa Trời nhà Gia-cóp phù hộ",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:54.616Z",
      "updatedAt": "2025-09-03T02:39:54.616Z",
      "chapterId": "e2f7e8dc-7e2b-489a-8300-928bd3511445"
    },
    {
      "id": "8562912e-2650-467d-b545-4c59ca7072fc",
      "text": "và cậy trông CHÚA, Thiên Chúa họ thờ.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:54.648Z",
      "updatedAt": "2025-09-03T02:39:54.648Z",
      "chapterId": "e2f7e8dc-7e2b-489a-8300-928bd3511445"
    },
    {
      "id": "2596289c-c13a-468f-acd7-23052571b8d8",
      "text": "Người là Đấng tạo thành trời đất với biển khơi",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:54.662Z",
      "updatedAt": "2025-09-03T02:39:54.662Z",
      "chapterId": "e2f7e8dc-7e2b-489a-8300-928bd3511445"
    },
    {
      "id": "e40a1f97-8e20-4950-9b14-44f06e222abd",
      "text": "cùng muôn loài trong đó.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:54.679Z",
      "updatedAt": "2025-09-03T02:39:54.679Z",
      "chapterId": "e2f7e8dc-7e2b-489a-8300-928bd3511445"
    },
    {
      "id": "fab768b9-070a-4b8b-a6f1-05f24de47739",
      "text": "Người là Đấng giữ lòng trung tín mãi muôn đời,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:54.692Z",
      "updatedAt": "2025-09-03T02:39:54.692Z",
      "chapterId": "e2f7e8dc-7e2b-489a-8300-928bd3511445"
    },
    {
      "id": "8a7be2c3-042d-4fd1-bcf2-edc7bf15e2b9",
      "text": "xử công minh cho người bị áp bức,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:54.706Z",
      "updatedAt": "2025-09-03T02:39:54.706Z",
      "chapterId": "e2f7e8dc-7e2b-489a-8300-928bd3511445"
    },
    {
      "id": "06434fac-4278-41d8-9521-bb983fed0186",
      "text": "ban lương thực cho kẻ đói ăn.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:54.720Z",
      "updatedAt": "2025-09-03T02:39:54.720Z",
      "chapterId": "e2f7e8dc-7e2b-489a-8300-928bd3511445"
    },
    {
      "id": "337b8ea0-a9ad-4916-ad9c-0d2d9f6f95bb",
      "text": "CHÚA giải phóng những ai tù tội,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:54.734Z",
      "updatedAt": "2025-09-03T02:39:54.734Z",
      "chapterId": "e2f7e8dc-7e2b-489a-8300-928bd3511445"
    },
    {
      "id": "766945dc-0f3d-4787-bd9b-e61c0234df04",
      "text": "CHÚA mở mắt cho kẻ mù loà.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:54.762Z",
      "updatedAt": "2025-09-03T02:39:54.762Z",
      "chapterId": "e2f7e8dc-7e2b-489a-8300-928bd3511445"
    },
    {
      "id": "cc92095b-ae4b-497c-b483-51b65f186b34",
      "text": "CHÚA cho kẻ bị dìm xuống đứng thẳng lên,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:54.776Z",
      "updatedAt": "2025-09-03T02:39:54.776Z",
      "chapterId": "e2f7e8dc-7e2b-489a-8300-928bd3511445"
    },
    {
      "id": "5121f678-454b-4e8a-b2a9-8d44c4b226d1",
      "text": "CHÚA yêu chuộng những người công chính.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:54.805Z",
      "updatedAt": "2025-09-03T02:39:54.805Z",
      "chapterId": "e2f7e8dc-7e2b-489a-8300-928bd3511445"
    },
    {
      "id": "9b491c07-ff05-4334-817d-5c957560cd1d",
      "text": "CHÚA phù trợ những khách ngoại kiều,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:54.821Z",
      "updatedAt": "2025-09-03T02:39:54.821Z",
      "chapterId": "e2f7e8dc-7e2b-489a-8300-928bd3511445"
    },
    {
      "id": "11f7ea1f-6146-471f-bac2-af571418dbdc",
      "text": "Người nâng đỡ cô nhi quả phụ,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:54.853Z",
      "updatedAt": "2025-09-03T02:39:54.853Z",
      "chapterId": "e2f7e8dc-7e2b-489a-8300-928bd3511445"
    },
    {
      "id": "45ae92d5-103c-40de-a3cb-e49b9e1b6f72",
      "text": "nhưng phá vỡ mưu đồ bọn ác nhân.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:54.867Z",
      "updatedAt": "2025-09-03T02:39:54.867Z",
      "chapterId": "e2f7e8dc-7e2b-489a-8300-928bd3511445"
    },
    {
      "id": "33a4af0f-4524-4b38-90cb-9988f35a6171",
      "text": "CHÚA nắm giữ vương quyền muôn muôn thuở,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:54.881Z",
      "updatedAt": "2025-09-03T02:39:54.881Z",
      "chapterId": "e2f7e8dc-7e2b-489a-8300-928bd3511445"
    },
    {
      "id": "3d0482d2-45d3-4cb3-b66c-da3cdfcef9cd",
      "text": "Xi-on hỡi, Chúa Trời ngươi hiển trị ngàn đời.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:39:54.895Z",
      "updatedAt": "2025-09-03T02:39:54.895Z",
      "chapterId": "e2f7e8dc-7e2b-489a-8300-928bd3511445"
    }
  ],
  "marks": [
    {
      "id": "66a3a66f-ebb1-4349-a75b-fd6770208534",
      "content": "Trong *Tv hỗn hợp* này, tác giả ca tụng Đức Chúa là Thiên Chúa toàn năng, là Vua uy quyền hằng yêu mến người công chính và mọi kẻ bị thua thiệt trên đời. Tv được chia ra như sau : **1**) Cc. 1-2 ; **2**) Cc. 3-4 ; **3**) Cc. 5-9 ; **4**) C.10.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 43,
      "endOffset": 43,
      "createdAt": "2025-09-03T02:39:54.502Z",
