{
  "chapter": {
    "id": "93c777f3-6560-4e4b-a86e-37ac0e81db2f",
    "number": 147,
    "createdAt": "2025-09-03T01:07:51.663Z",
    "updatedAt": "2025-09-03T01:07:51.663Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "746c852f-ed8f-4512-bb73-67fcf79507db",
      "text": "Ha-lê-lui-a !",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:00.228Z",
      "updatedAt": "2025-09-03T02:40:00.228Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    },
    {
      "id": "60358114-c344-4a86-831d-ffe772e1ab40",
      "text": "Hãy ca ngợi CHÚA đi !",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:00.288Z",
      "updatedAt": "2025-09-03T02:40:00.288Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    },
    {
      "id": "073efd82-e23c-41b5-91d2-8126648bf119",
      "text": "Đàn hát mừng Thiên Chúa chúng ta, thú vị dường nào !",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:00.301Z",
      "updatedAt": "2025-09-03T02:40:00.301Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    },
    {
      "id": "7163e2df-8698-495e-aa7d-e77ac24820fa",
      "text": "Được tán tụng Người, thoả tình biết mấy !",
      "label": "1",
      "number": 1,
      "subVerseIndex": 3,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:00.328Z",
      "updatedAt": "2025-09-03T02:40:00.328Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    },
    {
      "id": "fd437cb7-1072-4dce-98d6-59125ac1851a",
      "text": "CHÚA là Đấng xây dựng lại Giê-ru-sa-lem,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:00.342Z",
      "updatedAt": "2025-09-03T02:40:00.342Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    },
    {
      "id": "f0987de1-0c99-4144-b044-75b86a07c9db",
      "text": "quy tụ dân Ít-ra-en tản lạc về.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:00.385Z",
      "updatedAt": "2025-09-03T02:40:00.385Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    },
    {
      "id": "2b8d97e7-63b8-4462-ab8d-9ac1df2814db",
      "text": "Người chữa trị bao cõi lòng tan vỡ,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:00.420Z",
      "updatedAt": "2025-09-03T02:40:00.420Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    },
    {
      "id": "f613a37d-2a68-49a7-9911-19b22450043d",
      "text": "những vết thương, băng bó cho lành.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:00.434Z",
      "updatedAt": "2025-09-03T02:40:00.434Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    },
    {
      "id": "ce4723d4-48bc-4b03-a012-a3c4b9b387a2",
      "text": "Người ấn định con số các vì sao,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:00.452Z",
      "updatedAt": "2025-09-03T02:40:00.452Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    },
    {
      "id": "f1f1d980-57ca-429c-b777-e40a4180d6b0",
      "text": "và đặt tên cho từng ngôi một.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:00.465Z",
      "updatedAt": "2025-09-03T02:40:00.465Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    },
    {
      "id": "c3b35197-4b9d-4267-9687-4e0e49b6a1f0",
      "text": "Chúa chúng ta thật là cao cả,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:00.481Z",
      "updatedAt": "2025-09-03T02:40:00.481Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    },
    {
      "id": "4e61181b-46ed-431b-91bc-620a7a5c14d8",
      "text": "uy lực vô biên, trí tuệ khôn lường !",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:00.495Z",
      "updatedAt": "2025-09-03T02:40:00.495Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    },
    {
      "id": "3c32d5d9-8d3a-4662-82eb-69aaa959b51c",
      "text": "Kẻ thấp hèn, CHÚA nâng đỡ dậy,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:00.506Z",
      "updatedAt": "2025-09-03T02:40:00.506Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    },
    {
      "id": "2ad16533-ee19-4f63-a797-be7b272f7a10",
      "text": "bọn gian ác, Người hạ xuống đất đen.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:00.529Z",
      "updatedAt": "2025-09-03T02:40:00.529Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    },
    {
      "id": "ac08f4e6-d321-445c-bae8-3710152728be",
      "text": "Hãy dâng CHÚA bài ca cảm tạ,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:00.540Z",
      "updatedAt": "2025-09-03T02:40:00.540Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    },
    {
      "id": "e5274a64-e8b5-4414-b84e-dec5bb4e049a",
      "text": "gảy khúc hạc cầm mừng Thiên Chúa chúng ta.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:00.551Z",
      "updatedAt": "2025-09-03T02:40:00.551Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    },
    {
      "id": "f4e77bd4-3078-495c-9d98-17436e2b2d18",
      "text": "Chúa kéo mây bao phủ che kín cả bầu trời,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:00.564Z",
      "updatedAt": "2025-09-03T02:40:00.564Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    },
    {
      "id": "cd03fa40-7459-4770-8ed7-073ef7bd5eaa",
      "text": "Người chuẩn bị cho mưa rơi xuống trên mặt đất.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:00.578Z",
      "updatedAt": "2025-09-03T02:40:00.578Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    },
    {
      "id": "052c37d0-b18e-4bcb-97e8-e6c3b22a62e0",
      "text": "Chúa khiến mọc cỏ xanh trên những miền đồi núi,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:00.592Z",
      "updatedAt": "2025-09-03T02:40:00.592Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    },
    {
      "id": "b47f794c-08bd-489e-94c7-8b883c3b15e9",
      "text": "và các loài thảo mộc cho người thế hưởng dùng.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 3,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:00.639Z",
      "updatedAt": "2025-09-03T02:40:00.639Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    },
    {
      "id": "233f38a7-3c46-4616-acd7-98dd7a58cf37",
      "text": "Chúa cho loài gia súc có đầy đủ thức ăn,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:00.653Z",
      "updatedAt": "2025-09-03T02:40:00.653Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    },
    {
      "id": "c8e0a5ae-5cfd-4511-be3f-10b27a547bb1",
      "text": "bầy quạ non kêu đói cũng luôn được no mồi.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:00.667Z",
      "updatedAt": "2025-09-03T02:40:00.667Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    },
    {
      "id": "673cd648-7cd7-420d-98fd-bf1895540f4c",
      "text": "Vó ngựa phi, Chúa không ưa chuộng,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:00.680Z",
      "updatedAt": "2025-09-03T02:40:00.680Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    },
    {
      "id": "7eb0d769-e25a-4321-9f13-608784bce909",
      "text": "chẳng thích gì chân kẻ chạy nhanh,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:00.694Z",
      "updatedAt": "2025-09-03T02:40:00.694Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    },
    {
      "id": "db9c82fc-4117-4a7b-90b4-9bee51781dac",
      "text": "nhưng ưa chuộng những ai kính sợ CHÚA,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:00.708Z",
      "updatedAt": "2025-09-03T02:40:00.708Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    },
    {
      "id": "aa1db377-5c58-4349-8fbf-ba5a9efa0a97",
      "text": "và trông cậy ở tình thương của Người.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:00.722Z",
      "updatedAt": "2025-09-03T02:40:00.722Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    },
    {
      "id": "b1373881-ce7b-4953-a877-9af5eadf880c",
      "text": "Giê-ru-sa-lem hỡi, nào tôn vinh CHÚA !",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:00.735Z",
      "updatedAt": "2025-09-03T02:40:00.735Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    },
    {
      "id": "cfbfead2-f098-4e56-b79d-a1bb4b8f9bdf",
      "text": "Này Xi-on, hãy ca ngợi Thiên Chúa của ngươi !",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:00.766Z",
      "updatedAt": "2025-09-03T02:40:00.766Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    },
    {
      "id": "fcb5abf3-2a1d-4006-b170-279638a9d3e2",
      "text": "Then cửa nhà ngươi, Chúa làm cho thêm chắc,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:00.794Z",
      "updatedAt": "2025-09-03T02:40:00.794Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    },
    {
      "id": "640049ae-7abf-4bce-89aa-b441e30f7d73",
      "text": "con cái trong thành, Người giáng phúc thi ân.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:00.808Z",
      "updatedAt": "2025-09-03T02:40:00.808Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    },
    {
      "id": "543637d2-cf70-4685-81e8-e2e34c45242a",
      "text": "Cõi biên cương, Người thiết lập hoà bình,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:00.821Z",
      "updatedAt": "2025-09-03T02:40:00.821Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    },
    {
      "id": "a191cd84-2d8a-4985-bc22-f81ac7dc31cc",
      "text": "và cho ngươi no đầy lúa mì tinh hảo.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:00.835Z",
      "updatedAt": "2025-09-03T02:40:00.835Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    },
    {
      "id": "d37515c0-7d28-4677-b435-86a12ea57ab4",
      "text": "Người tống đạt lệnh truyền xuống đất,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:00.849Z",
      "updatedAt": "2025-09-03T02:40:00.849Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    },
    {
      "id": "6e5848f6-169d-47a1-9810-99d5e4834ccd",
      "text": "lời phán ra, hoả tốc chạy đi.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:00.863Z",
      "updatedAt": "2025-09-03T02:40:00.863Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    },
    {
      "id": "add061a1-b08f-4df5-899b-00caf38adb5b",
      "text": "Tuyết tựa lông chiên, Chúa trải dài,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:00.878Z",
      "updatedAt": "2025-09-03T02:40:00.878Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    },
    {
      "id": "d9a67e90-405f-47bd-ab1e-c255fbdb758a",
      "text": "sương giá như tro, Người rải rắc.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:00.892Z",
      "updatedAt": "2025-09-03T02:40:00.892Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    },
    {
      "id": "91d2cdc6-0f86-44a7-b666-13ca4433cfbd",
      "text": "Làm mưa đá, Chúa tung từng miếng nhỏ,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:00.906Z",
      "updatedAt": "2025-09-03T02:40:00.906Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    },
    {
      "id": "d8ad8163-9a9e-4e57-966e-127656f9839d",
      "text": "chịu nổi làm sao giá lạnh của Người !",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:00.921Z",
      "updatedAt": "2025-09-03T02:40:00.921Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    },
    {
      "id": "74443753-41e4-439a-8b6f-ffeeddd452e7",
      "text": "Chúa phán một lời là băng giải tuyết tan,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:00.934Z",
      "updatedAt": "2025-09-03T02:40:00.934Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    },
    {
      "id": "f723cee8-1f67-4403-a99b-09ec5747394c",
      "text": "thổi gió lên nước liền tuôn chảy.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:00.948Z",
      "updatedAt": "2025-09-03T02:40:00.948Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    },
    {
      "id": "8d50baed-6a45-4322-b67e-1333944109ce",
      "text": "Chúa bày tỏ lời Người cho nhà Gia-cóp,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:00.964Z",
      "updatedAt": "2025-09-03T02:40:00.964Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    },
    {
      "id": "fe99c75c-e8c0-4922-b16f-3413d23d2266",
      "text": "chiếu chỉ luật điều cho Ít-ra-en.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:00.992Z",
      "updatedAt": "2025-09-03T02:40:00.992Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    },
    {
      "id": "40afbad6-a31e-4f84-a438-cbc95aa88ff7",
      "text": "Chúa không đối xử với dân nào như vậy,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:01.026Z",
      "updatedAt": "2025-09-03T02:40:01.026Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    },
    {
      "id": "556c9de4-4761-4546-84b2-0f78f151aad3",
      "text": "không cho họ biết những điều luật của Người.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:01.038Z",
      "updatedAt": "2025-09-03T02:40:01.038Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    },
    {
      "id": "35ff2e30-2b30-497d-9694-a511e4b31836",
      "text": "Ha-lê-lui-a !",
      "label": "20",
      "number": 20,
      "subVerseIndex": 2,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:01.051Z",
      "updatedAt": "2025-09-03T02:40:01.051Z",
      "chapterId": "93c777f3-6560-4e4b-a86e-37ac0e81db2f"
    }
  ],
