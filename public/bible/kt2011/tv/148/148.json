{
  "chapter": {
    "id": "2e3b24b9-7e06-4cb8-b5cd-69a3f85ca3da",
    "number": 148,
    "createdAt": "2025-09-03T01:07:51.663Z",
    "updatedAt": "2025-09-03T01:07:51.663Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "86b4e344-77f7-4c19-a3b4-87673961907e",
      "text": "Ha-lê-lui-a !",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:06.306Z",
      "updatedAt": "2025-09-03T02:40:06.306Z",
      "chapterId": "2e3b24b9-7e06-4cb8-b5cd-69a3f85ca3da"
    },
    {
      "id": "25e8f3c6-500f-43a0-8a98-082c625aaf73",
      "text": "Ca tụng CHÚA đi, tự cõi trời thăm thẳm,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:06.358Z",
      "updatedAt": "2025-09-03T02:40:06.358Z",
      "chapterId": "2e3b24b9-7e06-4cb8-b5cd-69a3f85ca3da"
    },
    {
      "id": "fc48cfdd-d4a0-49b4-af7c-dc4448ff3146",
      "text": "ca tụng Người, trên chốn cao xanh.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:06.372Z",
      "updatedAt": "2025-09-03T02:40:06.372Z",
      "chapterId": "2e3b24b9-7e06-4cb8-b5cd-69a3f85ca3da"
    },
    {
      "id": "0a000524-7b96-48c1-9f9b-5ea08785adea",
      "text": "Ca tụng Chúa đi, mọi sứ thần của Chúa,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:06.386Z",
      "updatedAt": "2025-09-03T02:40:06.386Z",
      "chapterId": "2e3b24b9-7e06-4cb8-b5cd-69a3f85ca3da"
    },
    {
      "id": "07791744-d642-4182-b931-e47960e6165f",
      "text": "ca tụng Người, hỡi toàn thể thiên binh !",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:06.413Z",
      "updatedAt": "2025-09-03T02:40:06.413Z",
      "chapterId": "2e3b24b9-7e06-4cb8-b5cd-69a3f85ca3da"
    },
    {
      "id": "f335c768-0ae9-42f3-88cc-ea820f5d81dc",
      "text": "Ca tụng Chúa đi, này vầng ô bóng nguyệt,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:06.429Z",
      "updatedAt": "2025-09-03T02:40:06.429Z",
      "chapterId": "2e3b24b9-7e06-4cb8-b5cd-69a3f85ca3da"
    },
    {
      "id": "a4e593b4-f5bf-444c-9c3c-5aec53eef839",
      "text": "ca tụng Người, muôn tinh tú rạng soi.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:06.443Z",
      "updatedAt": "2025-09-03T02:40:06.443Z",
      "chapterId": "2e3b24b9-7e06-4cb8-b5cd-69a3f85ca3da"
    },
    {
      "id": "0d498bea-f019-40fc-9e67-46ffc6e6348b",
      "text": "Ca tụng Chúa đi, hỡi cửu trùng cao vút,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:06.457Z",
      "updatedAt": "2025-09-03T02:40:06.457Z",
      "chapterId": "2e3b24b9-7e06-4cb8-b5cd-69a3f85ca3da"
    },
    {
      "id": "f8d6d6b1-0034-4ec2-b095-ae979e9eeb87",
      "text": "cả khối nước phía trên bầu trời.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:06.471Z",
      "updatedAt": "2025-09-03T02:40:06.471Z",
      "chapterId": "2e3b24b9-7e06-4cb8-b5cd-69a3f85ca3da"
    },
    {
      "id": "3a5c6c69-feea-42ad-bf06-19c4e081f1b5",
      "text": "Nào ca tụng thánh danh ĐỨC CHÚA,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:06.499Z",
      "updatedAt": "2025-09-03T02:40:06.499Z",
      "chapterId": "2e3b24b9-7e06-4cb8-b5cd-69a3f85ca3da"
    },
    {
      "id": "eb53a65e-fa85-4b1f-9984-f6a675856c8e",
      "text": "vì Người ra lệnh, là hết thảy được tạo thành ;",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:06.527Z",
      "updatedAt": "2025-09-03T02:40:06.527Z",
      "chapterId": "2e3b24b9-7e06-4cb8-b5cd-69a3f85ca3da"
    },
    {
      "id": "f1539433-32a5-497a-93d9-ef28a3ba08db",
      "text": "Người định nơi cho tất cả đến muôn đời muôn thuở,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:06.541Z",
      "updatedAt": "2025-09-03T02:40:06.541Z",
      "chapterId": "2e3b24b9-7e06-4cb8-b5cd-69a3f85ca3da"
    },
    {
      "id": "3dafbe60-58b2-4a12-9a41-a64c022e6746",
      "text": "ban truyền lề luật, luật đó chẳng hề qua.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:06.555Z",
      "updatedAt": "2025-09-03T02:40:06.555Z",
      "chapterId": "2e3b24b9-7e06-4cb8-b5cd-69a3f85ca3da"
    },
    {
      "id": "64eb8bed-8594-4e02-9fae-551dc5100467",
      "text": "Ca tụng CHÚA đi, từ mười phương đất,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:06.571Z",
      "updatedAt": "2025-09-03T02:40:06.571Z",
      "chapterId": "2e3b24b9-7e06-4cb8-b5cd-69a3f85ca3da"
    },
    {
      "id": "dce987bf-db2e-41e2-80a4-42dcd6417685",
      "text": "này thuỷ quái dị hình, này tất cả vực sâu,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:06.584Z",
      "updatedAt": "2025-09-03T02:40:06.584Z",
      "chapterId": "2e3b24b9-7e06-4cb8-b5cd-69a3f85ca3da"
    },
    {
      "id": "21afc585-86c3-44a2-8f04-9a9d6a70e9d9",
      "text": "lửa hồng mưa đá, tuyết trắng mây mù,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:06.598Z",
      "updatedAt": "2025-09-03T02:40:06.598Z",
      "chapterId": "2e3b24b9-7e06-4cb8-b5cd-69a3f85ca3da"
    },
    {
      "id": "63c38b20-4e12-44d0-8f79-038fec85ff72",
      "text": "ngọn cuồng phong, cấp thừa hành lời Chúa.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:06.628Z",
      "updatedAt": "2025-09-03T02:40:06.628Z",
      "chapterId": "2e3b24b9-7e06-4cb8-b5cd-69a3f85ca3da"
    },
    {
      "id": "dbbb8143-853c-42df-8d58-e6b30afd62fc",
      "text": "Núi với đồi trùng trùng điệp điệp,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:06.642Z",
      "updatedAt": "2025-09-03T02:40:06.642Z",
      "chapterId": "2e3b24b9-7e06-4cb8-b5cd-69a3f85ca3da"
    },
    {
      "id": "b3afe30a-a1dd-4c4e-a1dc-b394a451fe1f",
      "text": "cây ăn trái và đủ loại bá hương,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:06.657Z",
      "updatedAt": "2025-09-03T02:40:06.657Z",
      "chapterId": "2e3b24b9-7e06-4cb8-b5cd-69a3f85ca3da"
    },
    {
      "id": "27aeb60e-1508-47af-a504-cb1b27a37e7d",
      "text": "thú vật rừng hoang cùng là gia súc,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:06.672Z",
      "updatedAt": "2025-09-03T02:40:06.672Z",
      "chapterId": "2e3b24b9-7e06-4cb8-b5cd-69a3f85ca3da"
    },
    {
      "id": "504c89e2-6d4d-40ce-937a-92129c6430f1",
      "text": "loài bò sát và mọi giống chim trời.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:06.685Z",
      "updatedAt": "2025-09-03T02:40:06.685Z",
      "chapterId": "2e3b24b9-7e06-4cb8-b5cd-69a3f85ca3da"
    },
    {
      "id": "9602f423-6729-440e-a516-d6dc14d13b9c",
      "text": "Bậc vua chúa cũng như hàng lê thứ,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:06.700Z",
      "updatedAt": "2025-09-03T02:40:06.700Z",
      "chapterId": "2e3b24b9-7e06-4cb8-b5cd-69a3f85ca3da"
    },
    {
      "id": "a04a316a-c20f-4c0d-9a86-75a0d858a850",
      "text": "khanh tướng công hầu, thủ lãnh trần gian,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:06.714Z",
      "updatedAt": "2025-09-03T02:40:06.714Z",
      "chapterId": "2e3b24b9-7e06-4cb8-b5cd-69a3f85ca3da"
    },
    {
      "id": "2a103c95-cf89-4272-a68e-3031d34b37c6",
      "text": "ai là nam thanh, ai là nữ tú,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:06.734Z",
      "updatedAt": "2025-09-03T02:40:06.734Z",
      "chapterId": "2e3b24b9-7e06-4cb8-b5cd-69a3f85ca3da"
    },
    {
      "id": "e48cf1e8-e202-41f0-be57-68c0f7f83207",
      "text": "khắp mặt bô lão, khắp mặt nhi đồng !",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:06.747Z",
      "updatedAt": "2025-09-03T02:40:06.747Z",
      "chapterId": "2e3b24b9-7e06-4cb8-b5cd-69a3f85ca3da"
    },
    {
      "id": "684c8a97-ed36-4fc8-83f3-8e026d0a3faf",
      "text": "Nào ca tụng thánh danh Đức Chúa,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:06.763Z",
      "updatedAt": "2025-09-03T02:40:06.763Z",
      "chapterId": "2e3b24b9-7e06-4cb8-b5cd-69a3f85ca3da"
    },
    {
      "id": "47d035ed-e5ef-4ec7-8ac4-d8d9f6a8636a",
      "text": "vì thánh danh Người cao cả vô song,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:06.777Z",
      "updatedAt": "2025-09-03T02:40:06.777Z",
      "chapterId": "2e3b24b9-7e06-4cb8-b5cd-69a3f85ca3da"
    },
    {
      "id": "0ec88982-6668-4e1f-bec0-41819f6b6e59",
      "text": "và oai phong vượt quá đất trời.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:06.791Z",
      "updatedAt": "2025-09-03T02:40:06.791Z",
      "chapterId": "2e3b24b9-7e06-4cb8-b5cd-69a3f85ca3da"
    },
    {
      "id": "74404aaa-cf83-4148-97bf-a608fcaed869",
      "text": "Thế lực dân Người, Người đã nâng cao.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:06.820Z",
      "updatedAt": "2025-09-03T02:40:06.820Z",
      "chapterId": "2e3b24b9-7e06-4cb8-b5cd-69a3f85ca3da"
    },
    {
      "id": "c22f2e43-1f33-4b5b-afb7-a0da26545235",
      "text": "Đó là bài ca tụng của những ai hiếu trung với Chúa,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:06.834Z",
      "updatedAt": "2025-09-03T02:40:06.834Z",
      "chapterId": "2e3b24b9-7e06-4cb8-b5cd-69a3f85ca3da"
    },
    {
      "id": "47e05299-e984-4087-be0f-7a3be328fc51",
      "text": "của con cháu nhà Ít-ra-en, dân gần gũi với Người.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 2,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:06.848Z",
      "updatedAt": "2025-09-03T02:40:06.848Z",
      "chapterId": "2e3b24b9-7e06-4cb8-b5cd-69a3f85ca3da"
    },
    {
      "id": "82b87b8b-0360-4eaa-81f2-c3bba6b12748",
      "text": "Ha-lê-lui-a !",
      "label": "14",
      "number": 14,
      "subVerseIndex": 3,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:06.875Z",
      "updatedAt": "2025-09-03T02:40:06.875Z",
      "chapterId": "2e3b24b9-7e06-4cb8-b5cd-69a3f85ca3da"
    }
  ],
