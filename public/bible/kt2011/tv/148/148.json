    },
    {
      "id": "339bf51c-314a-4e62-bd92-779f61c6704a",
      "content": "*Thánh thi* này kêu mời hết mọi loài thụ tạo cùng chung lời ca ngợi Đức Chúa là Đấng Hoá Công, Chúa Tể vạn vật và Đức Chúa của Ít-ra-en. Cấu trúc : **1**) Kêu mời muôn loài muôn vật ở trên trời (cc. 1-6) ; **2**) Kêu mời các thụ tạo ở dưới đất (cc. 7-12) ; **3**) Lý do chính yếu thúc đẩy vạn vật ca ngợi Đức Chúa (cc. 13-14).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 52,
      "endOffset": 52,
      "createdAt": "2025-09-03T02:40:06.347Z",
      "updatedAt": "2025-09-03T02:40:06.347Z",
      "targetId": "513ce0de-166f-4718-a3f4-8f7f15fa0f46",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "2e3b24b9-7e06-4cb8-b5cd-69a3f85ca3da"
    },
    {
      "id": "d60276f1-ef72-49df-a181-6d1d5debeead",
      "content": "St 1,7; 7,11-12; G 38,37",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 3,
