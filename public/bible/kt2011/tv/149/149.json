{
  "chapter": {
    "id": "c3b65527-7fdf-40e5-bf67-9e7c36821546",
    "number": 149,
    "createdAt": "2025-09-03T01:07:51.663Z",
    "updatedAt": "2025-09-03T01:07:51.663Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "e0b95a24-9cb6-4058-82cb-dd17d9b22e3f",
      "text": "Ha-lê-lui-a !",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:12.231Z",
      "updatedAt": "2025-09-03T02:40:12.231Z",
      "chapterId": "c3b65527-7fdf-40e5-bf67-9e7c36821546"
    },
    {
      "id": "6529bcaa-08b0-48ce-8535-b766eb0e355d",
      "text": "Hát lên mừng CHÚA một bài ca mới,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:12.272Z",
      "updatedAt": "2025-09-03T02:40:12.272Z",
      "chapterId": "c3b65527-7fdf-40e5-bf67-9e7c36821546"
    },
    {
      "id": "f8c64049-6d79-4ad1-bf69-1aab802a0781",
      "text": "ngợi khen Người trong cộng đoàn những kẻ hiếu trung !",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:12.284Z",
      "updatedAt": "2025-09-03T02:40:12.284Z",
      "chapterId": "c3b65527-7fdf-40e5-bf67-9e7c36821546"
    },
    {
      "id": "a6aa7662-c392-45cc-b0a9-73903bad83e9",
      "text": "Hỡi Ít-ra-en, nào hoan hỷ,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:12.295Z",
      "updatedAt": "2025-09-03T02:40:12.295Z",
      "chapterId": "c3b65527-7fdf-40e5-bf67-9e7c36821546"
    },
    {
      "id": "e06c6aa9-dc32-44bc-9ffe-6d7c31d9c2f0",
      "text": "vì có Chúa là Đấng tạo thành ngươi.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:12.320Z",
      "updatedAt": "2025-09-03T02:40:12.320Z",
      "chapterId": "c3b65527-7fdf-40e5-bf67-9e7c36821546"
    },
    {
      "id": "918d80d7-6026-4dd4-ba3a-2be4e155a5a6",
      "text": "Con cái Xi-on, hãy nhảy mừng,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:12.334Z",
      "updatedAt": "2025-09-03T02:40:12.334Z",
      "chapterId": "c3b65527-7fdf-40e5-bf67-9e7c36821546"
    },
    {
      "id": "c5827c21-c846-4896-93bd-99bba66af0ff",
      "text": "vì được Chúa làm Vua hiển trị.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 3,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:12.362Z",
      "updatedAt": "2025-09-03T02:40:12.362Z",
      "chapterId": "c3b65527-7fdf-40e5-bf67-9e7c36821546"
    },
    {
      "id": "1f3dec04-3aaf-46b8-a79e-69a3fcc1bfd2",
      "text": "Mừng Thánh Danh, nào dâng điệu vũ,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:12.377Z",
      "updatedAt": "2025-09-03T02:40:12.377Z",
      "chapterId": "c3b65527-7fdf-40e5-bf67-9e7c36821546"
    },
    {
      "id": "80091f46-b606-47e3-88c8-b036605ad3f9",
      "text": "nhịp trống hoạ đàn theo khúc hoan ca.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:12.390Z",
      "updatedAt": "2025-09-03T02:40:12.390Z",
      "chapterId": "c3b65527-7fdf-40e5-bf67-9e7c36821546"
    },
    {
      "id": "167a0429-b9b9-4db9-a0c0-dc39752cd505",
      "text": "Bởi vì CHÚA mến chuộng dân Người,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:12.421Z",
      "updatedAt": "2025-09-03T02:40:12.421Z",
      "chapterId": "c3b65527-7fdf-40e5-bf67-9e7c36821546"
    },
    {
      "id": "73217ae9-3018-49b8-961b-2ed101ab1ebe",
      "text": "ban cho kẻ nghèo hèn được vẻ vang chiến thắng.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:12.437Z",
      "updatedAt": "2025-09-03T02:40:12.437Z",
      "chapterId": "c3b65527-7fdf-40e5-bf67-9e7c36821546"
    },
    {
      "id": "a1eabad9-e085-41b7-9ae7-665d9aec3c37",
      "text": "Kẻ hiếu trung hãy vui mừng rạng rỡ,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:12.451Z",
      "updatedAt": "2025-09-03T02:40:12.451Z",
      "chapterId": "c3b65527-7fdf-40e5-bf67-9e7c36821546"
    },
    {
      "id": "01d25efa-26ff-4d65-8b5e-1e0dafaebe28",
      "text": "nào phủ phục mà cất tiếng reo hò,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:12.465Z",
      "updatedAt": "2025-09-03T02:40:12.465Z",
      "chapterId": "c3b65527-7fdf-40e5-bf67-9e7c36821546"
    },
    {
      "id": "f9246a93-4683-4224-98c6-5cb33c689a8f",
      "text": "miệng vang lời tán dương Thiên Chúa,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:12.479Z",
      "updatedAt": "2025-09-03T02:40:12.479Z",
      "chapterId": "c3b65527-7fdf-40e5-bf67-9e7c36821546"
    },
    {
      "id": "e9e56c50-b9b2-45d2-b641-aa423419d69f",
      "text": "thanh gươm hai lưỡi, cầm chắc trong tay.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:12.493Z",
      "updatedAt": "2025-09-03T02:40:12.493Z",
      "chapterId": "c3b65527-7fdf-40e5-bf67-9e7c36821546"
    },
    {
      "id": "032aff88-aebf-4cad-a78b-f00eed7b5ec0",
      "text": "Để trả thù muôn nước và trừng trị chư dân,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:12.520Z",
      "updatedAt": "2025-09-03T02:40:12.520Z",
      "chapterId": "c3b65527-7fdf-40e5-bf67-9e7c36821546"
    },
    {
      "id": "7cae1ab9-6626-49aa-94ea-f692ee422fcc",
      "text": "để xiềng chân vua chúa và xích cổ vương hầu,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:12.534Z",
      "updatedAt": "2025-09-03T02:40:12.534Z",
      "chapterId": "c3b65527-7fdf-40e5-bf67-9e7c36821546"
    },
    {
      "id": "3a84c0f9-550b-4469-852b-47365b552aa6",
      "text": "để thi hành án phạt Chúa đã viết từ xưa.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:12.548Z",
      "updatedAt": "2025-09-03T02:40:12.548Z",
      "chapterId": "c3b65527-7fdf-40e5-bf67-9e7c36821546"
    },
    {
      "id": "52003a7e-b30b-4c0f-b0f8-0885db3ec114",
      "text": "Đó là niềm vinh dự cho mọi kẻ trung hiếu với Người.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:12.562Z",
      "updatedAt": "2025-09-03T02:40:12.562Z",
      "chapterId": "c3b65527-7fdf-40e5-bf67-9e7c36821546"
    },
    {
      "id": "9b1d66eb-58d1-4d38-88ba-dc2c7983e3aa",
      "text": "Ha-lê-lui-a !",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:12.575Z",
      "updatedAt": "2025-09-03T02:40:12.575Z",
      "chapterId": "c3b65527-7fdf-40e5-bf67-9e7c36821546"
    }
  ],
  "marks": [
    {
      "id": "379800c9-64d1-491e-bc50-39bc9ea82adf",
      "content": "Có lẽ *thánh thi* này mang tính cách cánh chung : loan báo hoặc cho thoáng thấy cuộc chiến cuối cùng dẫn tới sự chiến thắng khải hoàn của Đức Chúa. Có thể chia thánh thi làm hai phần : **1**) Ngợi khen Đức Chúa là Đấng Hoá Công và Vua vinh hiển (cc. 1-4) ; **2**) Ngợi khen Đức Chúa sẽ đưa dân của Người tới cuộc chiến thắng cánh chung (cc. 5-9).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 36,
      "endOffset": 36,
