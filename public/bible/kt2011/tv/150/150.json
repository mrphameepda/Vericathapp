{
  "chapter": {
    "id": "2bbc428f-f467-41b5-a4a6-e559baaf5941",
    "number": 150,
    "createdAt": "2025-09-03T01:07:51.663Z",
    "updatedAt": "2025-09-03T01:07:51.663Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "256d76e3-5143-4ce9-bd52-118828889e26",
      "text": "Ha-lê-lui-a !",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:17.128Z",
      "updatedAt": "2025-09-03T02:40:17.128Z",
      "chapterId": "2bbc428f-f467-41b5-a4a6-e559baaf5941"
    },
    {
      "id": "98d4d8b7-7761-48bb-8e4a-a4ccb3c268bc",
      "text": "Ca tụng Chúa đi, trong đền thánh Chúa,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:17.179Z",
      "updatedAt": "2025-09-03T02:40:17.179Z",
      "chapterId": "2bbc428f-f467-41b5-a4a6-e559baaf5941"
    },
    {
      "id": "347246a8-630a-4b00-99fc-35bb10f51b9a",
      "text": "ca tụng Người chốn cao thẳm uy linh.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:17.206Z",
      "updatedAt": "2025-09-03T02:40:17.206Z",
      "chapterId": "2bbc428f-f467-41b5-a4a6-e559baaf5941"
    },
    {
      "id": "53f7094c-5480-47a9-96d9-7c488bc53396",
      "text": "Ca tụng Chúa vì công trình hùng vĩ,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:17.220Z",
      "updatedAt": "2025-09-03T02:40:17.220Z",
      "chapterId": "2bbc428f-f467-41b5-a4a6-e559baaf5941"
    },
    {
      "id": "99ce71aa-ebfc-4de3-86c5-f6c1d8cdc7c3",
      "text": "ca tụng Người lẫm liệt uy phong.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:17.234Z",
      "updatedAt": "2025-09-03T02:40:17.234Z",
      "chapterId": "2bbc428f-f467-41b5-a4a6-e559baaf5941"
    },
    {
      "id": "3e509f5c-ee4e-44ff-bbb7-6ef3dacf4269",
      "text": "Ca tụng Chúa đi, rập theo tiếng tù và,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:17.248Z",
      "updatedAt": "2025-09-03T02:40:17.248Z",
      "chapterId": "2bbc428f-f467-41b5-a4a6-e559baaf5941"
    },
    {
      "id": "49c68fba-da4e-43ee-9529-df217195ce68",
      "text": "ca tụng Người, hoạ tiếng cầm tiếng sắt.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:17.262Z",
      "updatedAt": "2025-09-03T02:40:17.262Z",
      "chapterId": "2bbc428f-f467-41b5-a4a6-e559baaf5941"
    },
    {
      "id": "362ab49e-7302-42bb-bbb8-2b0ecc37894c",
      "text": "Ca tụng Chúa, bằng vũ điệu trống đưa,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:17.277Z",
      "updatedAt": "2025-09-03T02:40:17.277Z",
      "chapterId": "2bbc428f-f467-41b5-a4a6-e559baaf5941"
    },
    {
      "id": "77d56637-9c43-42ed-b1f2-73d4f75cce0b",
      "text": "ca tụng Người, theo cung đàn nhịp sáo.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:17.304Z",
      "updatedAt": "2025-09-03T02:40:17.304Z",
      "chapterId": "2bbc428f-f467-41b5-a4a6-e559baaf5941"
    },
    {
      "id": "6e4a585d-da52-419e-984a-8aef9e6b2b6b",
      "text": "Ca tụng Chúa đi, với chũm choẹ vang rền,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:17.318Z",
      "updatedAt": "2025-09-03T02:40:17.318Z",
      "chapterId": "2bbc428f-f467-41b5-a4a6-e559baaf5941"
    },
    {
      "id": "516b65fb-b43d-45bb-938d-fe20cf18a8e3",
      "text": "ca tụng Người cùng thanh la inh ỏi.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:17.331Z",
      "updatedAt": "2025-09-03T02:40:17.331Z",
      "chapterId": "2bbc428f-f467-41b5-a4a6-e559baaf5941"
    },
    {
      "id": "f779cded-81cd-4a02-8171-574ed2b685b9",
      "text": "Hỡi toàn thể chúng sinh, ca tụng CHÚA đi nào !",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:17.345Z",
      "updatedAt": "2025-09-03T02:40:17.345Z",
      "chapterId": "2bbc428f-f467-41b5-a4a6-e559baaf5941"
    },
    {
      "id": "a75a9ddc-49c4-4ae4-9c10-75c882300ab6",
      "text": "Ha-lê-lui-a !",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:40:17.360Z",
      "updatedAt": "2025-09-03T02:40:17.360Z",
      "chapterId": "2bbc428f-f467-41b5-a4a6-e559baaf5941"
    }
  ],
  "marks": [
    {
      "id": "26e3c58d-2c87-4099-befd-85fb1b1669ca",
      "content": "Trong *Thánh thi* này, *toàn thể chúng sinh* (c.6) được kêu mời góp phần vào buổi hoà nhạc vĩ đại để ngợi khen Thiên Chúa, Đấng “lẫm liệt uy phong” (c.2), vì những chiến công lừng lẫy của Người. Vinh tụng ca này kết thúc tập V gồm các Tv 107 – 150. Cấu trúc : **1**) Mời gọi ngợi khen Thiên Chúa (cc. 1-2) ; **2**) Ngợi khen Thiên Chúa với đủ thứ nhạc cụ (cc. 3-5) ; **3**) Kết : lặp lại lời mời gọi (c.6).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 22,
      "endOffset": 22,
      "createdAt": "2025-09-03T02:40:17.157Z",
      "updatedAt": "2025-09-03T02:40:17.157Z",
      "targetId": "305eb7fa-a4fc-4202-8ebb-e5772aecef52",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "2bbc428f-f467-41b5-a4a6-e559baaf5941"
    },
    {
