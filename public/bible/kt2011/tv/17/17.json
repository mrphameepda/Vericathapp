{
  "chapter": {
    "id": "5b07b725-298f-4ebe-9a14-f3f617960002",
    "number": 17,
    "createdAt": "2025-09-03T01:07:51.660Z",
    "updatedAt": "2025-09-03T01:07:51.660Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "3bf3f908-e412-40b1-9d0a-dd0c257df9a1",
      "text": "*Kinh nguyện của vua Đa-vít.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:26:10.425Z",
      "updatedAt": "2025-09-03T02:26:10.425Z",
      "chapterId": "5b07b725-298f-4ebe-9a14-f3f617960002"
    },
    {
      "id": "e1851ce1-f364-4516-8622-39a4a11a6b92",
      "text": "Lạy CHÚA, xin nghe con giãi bày lẽ phải,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:10.487Z",
      "updatedAt": "2025-09-03T02:26:10.487Z",
      "chapterId": "5b07b725-298f-4ebe-9a14-f3f617960002"
    },
    {
      "id": "c1e8a8d1-7319-4f1a-9ae8-27cbfaf10290",
      "text": "lời con than vãn, xin Ngài để ý ;",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:10.501Z",
      "updatedAt": "2025-09-03T02:26:10.501Z",
      "chapterId": "5b07b725-298f-4ebe-9a14-f3f617960002"
    },
    {
      "id": "945ac098-35f5-4bc7-8871-18329357a68f",
      "text": "xin lắng tai nghe tiếng nguyện cầu",
      "label": "1",
      "number": 1,
      "subVerseIndex": 3,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:10.515Z",
      "updatedAt": "2025-09-03T02:26:10.515Z",
      "chapterId": "5b07b725-298f-4ebe-9a14-f3f617960002"
    },
    {
      "id": "b4cc5402-36eb-4722-8a48-af4455c81cc9",
      "text": "thốt ra từ miệng lưỡi chẳng điêu ngoa.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 4,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:10.530Z",
      "updatedAt": "2025-09-03T02:26:10.530Z",
      "chapterId": "5b07b725-298f-4ebe-9a14-f3f617960002"
    },
    {
      "id": "138d2d01-2b6a-4f06-b38d-48899a6e913e",
      "text": "Con xin được Thánh Nhan soi xét",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:10.546Z",
      "updatedAt": "2025-09-03T02:26:10.546Z",
      "chapterId": "5b07b725-298f-4ebe-9a14-f3f617960002"
    },
    {
      "id": "dc4f4bb9-7501-4894-a833-3476b1e4582a",
      "text": "vì mắt Ngài thấy rõ điều chính trực.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:10.560Z",
      "updatedAt": "2025-09-03T02:26:10.560Z",
      "chapterId": "5b07b725-298f-4ebe-9a14-f3f617960002"
    },
    {
      "id": "d1120f0b-43ba-4cdd-b4e0-58febf6e63ef",
      "text": "Chúa có xét lòng con, thăm con giữa đêm trường,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:10.574Z",
      "updatedAt": "2025-09-03T02:26:10.574Z",
      "chapterId": "5b07b725-298f-4ebe-9a14-f3f617960002"
    },
    {
      "id": "accae091-abb9-490a-b7e7-049155ecbbb7",
      "text": "có thử con bằng lửa, cũng chẳng thấy điều gian.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:10.588Z",
      "updatedAt": "2025-09-03T02:26:10.588Z",
      "chapterId": "5b07b725-298f-4ebe-9a14-f3f617960002"
    },
    {
      "id": "697f63c4-4765-4c5b-bb61-a3df3b826df6",
      "text": "Con chẳng theo thói đời buông những lời sai trái.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:10.603Z",
      "updatedAt": "2025-09-03T02:26:10.603Z",
      "chapterId": "5b07b725-298f-4ebe-9a14-f3f617960002"
    },
    {
      "id": "0708145c-2846-44b5-b9d2-ed6e7c816278",
      "text": "Con tuân giữ mọi lời Chúa dạy,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:10.617Z",
      "updatedAt": "2025-09-03T02:26:10.617Z",
      "chapterId": "5b07b725-298f-4ebe-9a14-f3f617960002"
    },
    {
      "id": "9c01ae43-1d11-421e-bdad-bc242ba3c7d7",
      "text": "tránh xa đường lối kẻ bạo tàn,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:10.631Z",
      "updatedAt": "2025-09-03T02:26:10.631Z",
      "chapterId": "5b07b725-298f-4ebe-9a14-f3f617960002"
    },
    {
      "id": "a66f2592-0594-4520-bb00-0c391e267808",
      "text": "dõi vết chân Ngài, con không vấp ngã.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:10.659Z",
      "updatedAt": "2025-09-03T02:26:10.659Z",
      "chapterId": "5b07b725-298f-4ebe-9a14-f3f617960002"
    },
    {
      "id": "c600198f-5f4b-4f3c-93b4-fad565b272d2",
      "text": "Con kêu lên Ngài, lạy Thiên Chúa, vì Ngài đáp lời con.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:10.674Z",
      "updatedAt": "2025-09-03T02:26:10.674Z",
      "chapterId": "5b07b725-298f-4ebe-9a14-f3f617960002"
    },
    {
      "id": "6b8ab5be-c71d-4264-94f3-910fdf137778",
      "text": "Xin lắng tai và nghe tiếng con cầu.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:10.691Z",
      "updatedAt": "2025-09-03T02:26:10.691Z",
      "chapterId": "5b07b725-298f-4ebe-9a14-f3f617960002"
    },
    {
      "id": "fe13d878-a193-4bfe-9eee-bfea9d9a159e",
      "text": "Xin biểu lộ tình thương diệu kỳ của Chúa,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:10.723Z",
      "updatedAt": "2025-09-03T02:26:10.723Z",
      "chapterId": "5b07b725-298f-4ebe-9a14-f3f617960002"
    },
    {
      "id": "c0be3808-f449-488e-913d-77362272f711",
      "text": "Ngài cứu ai trú ẩn dưới cánh tay Ngài",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:10.755Z",
      "updatedAt": "2025-09-03T02:26:10.755Z",
      "chapterId": "5b07b725-298f-4ebe-9a14-f3f617960002"
    },
    {
      "id": "0d1c38f1-afef-409a-8d6e-da4e4c375dae",
      "text": "khỏi quân thù xông đánh.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:10.770Z",
      "updatedAt": "2025-09-03T02:26:10.770Z",
      "chapterId": "5b07b725-298f-4ebe-9a14-f3f617960002"
    },
    {
      "id": "d3200ded-30ef-4114-bb82-065f00493b7d",
      "text": "Xin giữ gìn con như thể con ngươi,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:10.783Z",
      "updatedAt": "2025-09-03T02:26:10.783Z",
      "chapterId": "5b07b725-298f-4ebe-9a14-f3f617960002"
    },
    {
      "id": "71936b67-cf08-4487-9884-a89e82c3aa70",
      "text": "dưới bóng Ngài, xin thương che chở,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:10.812Z",
      "updatedAt": "2025-09-03T02:26:10.812Z",
      "chapterId": "5b07b725-298f-4ebe-9a14-f3f617960002"
    },
    {
      "id": "5ba3c9a4-ee27-4100-b57c-5f143725d3e6",
      "text": "cho khỏi tay lũ ác nhân hãm hại,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:10.826Z",
      "updatedAt": "2025-09-03T02:26:10.826Z",
      "chapterId": "5b07b725-298f-4ebe-9a14-f3f617960002"
    },
    {
      "id": "badc1a0a-8e6b-4c88-8798-d0c54e93f1d9",
      "text": "thoát bọn tử thù tứ phía bủa vây.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:10.839Z",
      "updatedAt": "2025-09-03T02:26:10.839Z",
      "chapterId": "5b07b725-298f-4ebe-9a14-f3f617960002"
    },
    {
      "id": "86aa889c-57b1-48dd-9575-728d1f0f811b",
      "text": "Kẻ thù con lòng chai dạ đá,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:10.853Z",
      "updatedAt": "2025-09-03T02:26:10.853Z",
      "chapterId": "5b07b725-298f-4ebe-9a14-f3f617960002"
    },
    {
      "id": "7b21422c-da1c-4962-8799-b580b4bbc432",
      "text": "mở miệng ra là ngạo mạn khinh đời.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:10.867Z",
      "updatedAt": "2025-09-03T02:26:10.867Z",
      "chapterId": "5b07b725-298f-4ebe-9a14-f3f617960002"
    },
    {
      "id": "3e95c200-2cb5-4270-ae84-09985ea778ac",
      "text": "Rầm rập tới, kìa chúng đã bao quanh,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:10.881Z",
      "updatedAt": "2025-09-03T02:26:10.881Z",
      "chapterId": "5b07b725-298f-4ebe-9a14-f3f617960002"
    },
    {
      "id": "4a665e1b-fd58-4ea7-a8cd-38def2a834ab",
      "text": "mắt trừng trừng, như muốn quật con xuống đất,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:10.895Z",
      "updatedAt": "2025-09-03T02:26:10.895Z",
      "chapterId": "5b07b725-298f-4ebe-9a14-f3f617960002"
    },
    {
      "id": "31f4e1d2-4266-43ce-9d0c-c352b7748a6d",
      "text": "thật giống loài sư tử chực nuốt sống ăn tươi,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:10.909Z",
      "updatedAt": "2025-09-03T02:26:10.909Z",
      "chapterId": "5b07b725-298f-4ebe-9a14-f3f617960002"
    },
    {
      "id": "e17456e1-cf5b-4670-858d-a297e2c135c1",
      "text": "hệt như con mãnh thú rình rập ở bụi bờ.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:10.925Z",
      "updatedAt": "2025-09-03T02:26:10.925Z",
      "chapterId": "5b07b725-298f-4ebe-9a14-f3f617960002"
    },
    {
      "id": "3a8d09e2-56d8-41ea-a7c4-623e1501343f",
      "text": "Lạy CHÚA, xin đứng dậy,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:10.938Z",
      "updatedAt": "2025-09-03T02:26:10.938Z",
      "chapterId": "5b07b725-298f-4ebe-9a14-f3f617960002"
    },
    {
      "id": "3003d878-8e0b-44aa-916e-93def43af7f2",
      "text": "ra nghênh chiến, quật ngã quân thù,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:10.952Z",
      "updatedAt": "2025-09-03T02:26:10.952Z",
      "chapterId": "5b07b725-298f-4ebe-9a14-f3f617960002"
    },
    {
      "id": "34a764d4-897e-49dc-adaf-a996804f70dc",
      "text": "vung bảo kiếm, cứu mạng con cho khỏi ác nhân.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:10.967Z",
      "updatedAt": "2025-09-03T02:26:10.967Z",
      "chapterId": "5b07b725-298f-4ebe-9a14-f3f617960002"
    },
    {
      "id": "86dffc58-310e-4889-be3a-67a337862620",
      "text": "Lạy CHÚA, xin thẳng tay khai trừ bọn chúng",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:10.981Z",
      "updatedAt": "2025-09-03T02:26:10.981Z",
      "chapterId": "5b07b725-298f-4ebe-9a14-f3f617960002"
    },
    {
      "id": "3748b181-e0c1-4fab-a501-b2a35145cf64",
      "text": "khỏi thế giới loài người,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:10.996Z",
      "updatedAt": "2025-09-03T02:26:10.996Z",
      "chapterId": "5b07b725-298f-4ebe-9a14-f3f617960002"
    },
    {
      "id": "ffbdb52c-fa0a-45d1-b327-2df45d2c5e5e",
      "text": "khỏi thế giới loài người, khỏi chốn dương gian.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 2,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:11.010Z",
      "updatedAt": "2025-09-03T02:26:11.010Z",
      "chapterId": "5b07b725-298f-4ebe-9a14-f3f617960002"
    },
    {
      "id": "ed570912-36fd-4241-809f-dfb2b942d47f",
      "text": "Số phận chúng ở đời là như vậy.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 3,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:11.024Z",
      "updatedAt": "2025-09-03T02:26:11.024Z",
      "chapterId": "5b07b725-298f-4ebe-9a14-f3f617960002"
    },
    {
      "id": "c86c35dc-d0cd-44a3-be08-39d6cac05485",
      "text": "Án phạt Chúa đã dành,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 4,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:11.038Z",
      "updatedAt": "2025-09-03T02:26:11.038Z",
      "chapterId": "5b07b725-298f-4ebe-9a14-f3f617960002"
    },
    {
      "id": "61149bf7-2f76-455e-816d-f010b4935d07",
      "text": "xin Ngài bắt chúng nuốt cho đầy bụng,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 5,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:11.052Z",
      "updatedAt": "2025-09-03T02:26:11.052Z",
      "chapterId": "5b07b725-298f-4ebe-9a14-f3f617960002"
    },
    {
      "id": "bfe0daf0-aaa0-47a8-86d3-5974f5000d34",
      "text": "cả đàn con cũng được ăn thoả thích,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 6,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:11.067Z",
      "updatedAt": "2025-09-03T02:26:11.067Z",
      "chapterId": "5b07b725-298f-4ebe-9a14-f3f617960002"
    },
    {
      "id": "b2cec826-d9c5-4140-b12c-04323147eba3",
      "text": "phần còn lại, cho bầy cháu mai sau.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 7,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
