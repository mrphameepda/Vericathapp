{
  "chapter": {
    "id": "e0c0d3a5-b556-4af7-8cdd-80655a49dcb1",
    "number": 2,
    "createdAt": "2025-09-03T01:07:51.659Z",
    "updatedAt": "2025-09-03T01:07:51.659Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "e14017f8-1638-45bf-ab37-b802ca627540",
      "text": "Sao chư dân lại ồn ào náo động ?",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:45.103Z",
      "updatedAt": "2025-09-03T02:24:45.103Z",
      "chapterId": "e0c0d3a5-b556-4af7-8cdd-80655a49dcb1"
    },
    {
      "id": "47bdd119-86bf-4a5a-8a7a-b7a222a19237",
      "text": "Sao vạn quốc dám bày kế viển vông ?",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:45.156Z",
      "updatedAt": "2025-09-03T02:24:45.156Z",
      "chapterId": "e0c0d3a5-b556-4af7-8cdd-80655a49dcb1"
    },
    {
      "id": "a367db1c-e2a8-42a9-a086-e2963e763fd7",
      "text": "Vua chúa trần gian cùng nổi dậy,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:45.171Z",
      "updatedAt": "2025-09-03T02:24:45.171Z",
      "chapterId": "e0c0d3a5-b556-4af7-8cdd-80655a49dcb1"
    },
    {
      "id": "a46efd24-9950-49e5-bca4-a7f914d48bda",
      "text": "vương hầu khanh tướng rập mưu đồ",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:45.185Z",
      "updatedAt": "2025-09-03T02:24:45.185Z",
      "chapterId": "e0c0d3a5-b556-4af7-8cdd-80655a49dcb1"
    },
    {
      "id": "c5a70333-cadd-45bc-9615-288792ddacb3",
      "text": "chống lại ĐỨC CHÚA,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:45.199Z",
      "updatedAt": "2025-09-03T02:24:45.199Z",
      "chapterId": "e0c0d3a5-b556-4af7-8cdd-80655a49dcb1"
    },
    {
      "id": "a439c477-ab0b-46fc-9653-e347a2597c57",
      "text": "chống lại Đấng Người đã xức dầu phong vương.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 3,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:45.228Z",
      "updatedAt": "2025-09-03T02:24:45.228Z",
      "chapterId": "e0c0d3a5-b556-4af7-8cdd-80655a49dcb1"
    },
    {
      "id": "99e0d3e7-38a1-4860-b489-41639ab7911b",
      "text": "Chúng bảo nhau : “Xiềng xích họ, nào ta bẻ gãy,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:45.257Z",
      "updatedAt": "2025-09-03T02:24:45.257Z",
      "chapterId": "e0c0d3a5-b556-4af7-8cdd-80655a49dcb1"
    },
    {
      "id": "0d2eb75b-a855-4847-bbda-43d6c2e75a11",
      "text": "gông cùm họ, ta hãy quẳng đi !”",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:45.272Z",
      "updatedAt": "2025-09-03T02:24:45.272Z",
      "chapterId": "e0c0d3a5-b556-4af7-8cdd-80655a49dcb1"
    },
    {
      "id": "219d35a2-58a9-457d-a325-e5c0708c397c",
      "text": "Chúa ngự trời cao thấy thế bật cười,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:45.286Z",
      "updatedAt": "2025-09-03T02:24:45.286Z",
      "chapterId": "e0c0d3a5-b556-4af7-8cdd-80655a49dcb1"
    },
    {
      "id": "7cf8825c-690f-4ba6-a258-6bdab099203d",
      "text": "Người chế nhạo bọn chúng.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:45.300Z",
      "updatedAt": "2025-09-03T02:24:45.300Z",
      "chapterId": "e0c0d3a5-b556-4af7-8cdd-80655a49dcb1"
    },
    {
      "id": "0c93c0fe-e202-47f5-8286-cbe236cea296",
      "text": "Rồi nổi trận lôi đình, Người quát nạt,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:45.314Z",
      "updatedAt": "2025-09-03T02:24:45.314Z",
      "chapterId": "e0c0d3a5-b556-4af7-8cdd-80655a49dcb1"
    },
    {
      "id": "f0d4b703-6f6a-46e9-b4c0-9f5e45828fb9",
      "text": "trút cơn thịnh nộ, khiến chúng kinh hoàng,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:45.328Z",
      "updatedAt": "2025-09-03T02:24:45.328Z",
      "chapterId": "e0c0d3a5-b556-4af7-8cdd-80655a49dcb1"
    },
    {
      "id": "61e1569c-bbfa-4582-bd87-e7accb5d8be4",
      "text": "rằng : “Chính Ta đã đặt vị quân vương Ta tuyển chọn,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:45.346Z",
      "updatedAt": "2025-09-03T02:24:45.346Z",
      "chapterId": "e0c0d3a5-b556-4af7-8cdd-80655a49dcb1"
    },
    {
      "id": "8aa3d23f-289b-446c-a546-509fc54ba6bf",
      "text": "lên trị vì Xi-on, núi thánh của Ta.”",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:45.364Z",
      "updatedAt": "2025-09-03T02:24:45.364Z",
      "chapterId": "e0c0d3a5-b556-4af7-8cdd-80655a49dcb1"
    },
    {
      "id": "1e269b94-b1ca-4160-b793-f91c0825f472",
      "text": "Tân vương lên tiếng : Tôi xin đọc sắc phong của CHÚA,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:45.392Z",
      "updatedAt": "2025-09-03T02:24:45.392Z",
      "chapterId": "e0c0d3a5-b556-4af7-8cdd-80655a49dcb1"
    },
    {
      "id": "4c5ac3a2-ab54-4a6b-9a2b-1c27770d6789",
      "text": "Người phán bảo tôi rằng : “Con là con của Cha,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:45.406Z",
      "updatedAt": "2025-09-03T02:24:45.406Z",
      "chapterId": "e0c0d3a5-b556-4af7-8cdd-80655a49dcb1"
    },
    {
      "id": "be51ec62-6e99-435c-ac59-f4f40d885baa",
      "text": "ngày hôm nay Cha đã sinh ra con.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:45.420Z",
      "updatedAt": "2025-09-03T02:24:45.420Z",
      "chapterId": "e0c0d3a5-b556-4af7-8cdd-80655a49dcb1"
    },
    {
      "id": "1c3e66b8-f37f-40a0-88d1-271390435736",
      "text": "Con cứ xin, rồi Cha ban tặng",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:45.450Z",
      "updatedAt": "2025-09-03T02:24:45.450Z",
      "chapterId": "e0c0d3a5-b556-4af7-8cdd-80655a49dcb1"
    },
    {
      "id": "f2b08b64-0c2a-4af2-a8a0-01f2b134ca41",
      "text": "muôn dân nước làm sản nghiệp riêng,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:45.465Z",
      "updatedAt": "2025-09-03T02:24:45.465Z",
      "chapterId": "e0c0d3a5-b556-4af7-8cdd-80655a49dcb1"
    },
    {
      "id": "77285769-8cce-4118-82a9-281a9f7c3d00",
      "text": "toàn cõi đất làm phần lãnh địa.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:45.478Z",
      "updatedAt": "2025-09-03T02:24:45.478Z",
      "chapterId": "e0c0d3a5-b556-4af7-8cdd-80655a49dcb1"
    },
    {
      "id": "037a674f-d52e-4c39-add3-11ab5902c9fc",
      "text": "Con sẽ dùng trượng sắt đập chúng tan tành,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:45.492Z",
      "updatedAt": "2025-09-03T02:24:45.492Z",
      "chapterId": "e0c0d3a5-b556-4af7-8cdd-80655a49dcb1"
    },
    {
      "id": "35521a4a-68b1-4324-9f6b-b1ef56acdcc3",
      "text": "nghiền nát chúng như đồ sành đồ gốm.”",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:45.507Z",
      "updatedAt": "2025-09-03T02:24:45.507Z",
      "chapterId": "e0c0d3a5-b556-4af7-8cdd-80655a49dcb1"
    },
    {
      "id": "c2f4de5b-8e87-4f7e-a567-2c8e1ad7a46c",
      "text": "Vậy giờ đây, hỡi các vua chúa, hãy biết điều,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:45.537Z",
      "updatedAt": "2025-09-03T02:24:45.537Z",
      "chapterId": "e0c0d3a5-b556-4af7-8cdd-80655a49dcb1"
    },
    {
      "id": "da63695a-6498-4cd1-ab2d-d2b245eaeb0f",
      "text": "thủ lãnh trần gian, nào tỉnh ngộ !",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:45.568Z",
      "updatedAt": "2025-09-03T02:24:45.568Z",
      "chapterId": "e0c0d3a5-b556-4af7-8cdd-80655a49dcb1"
    },
    {
      "id": "50f4edab-cccd-4d82-8e69-8779950e9a53",
      "text": "Đem lòng kính sợ mà phụng thờ ĐỨC CHÚA,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:45.581Z",
      "updatedAt": "2025-09-03T02:24:45.581Z",
      "chapterId": "e0c0d3a5-b556-4af7-8cdd-80655a49dcb1"
    },
    {
      "id": "09fded9b-4d3c-4560-8405-40b0d9fe054d",
      "text": "hãy khiếp run phủ phục dưới chân Người !",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:45.604Z",
      "updatedAt": "2025-09-03T02:24:45.604Z",
      "chapterId": "e0c0d3a5-b556-4af7-8cdd-80655a49dcb1"
    },
    {
      "id": "4c5b80df-f2df-4739-93dc-a889543971eb",
      "text": "Kẻo Chúa nổi lôi đình là các ngươi mạt lộ,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:45.617Z",
      "updatedAt": "2025-09-03T02:24:45.617Z",
      "chapterId": "e0c0d3a5-b556-4af7-8cdd-80655a49dcb1"
    },
    {
      "id": "db9d7146-be3b-47d1-ab07-bc34ea6a394d",
      "text": "lửa giận của Người giây lát sẽ bừng lên !",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:45.632Z",
      "updatedAt": "2025-09-03T02:24:45.632Z",
      "chapterId": "e0c0d3a5-b556-4af7-8cdd-80655a49dcb1"
    },
    {
      "id": "40acaef5-eac4-4b9e-9858-7015d8679b1a",
      "text": "Còn những ai ẩn náu bên Người,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 3,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:45.646Z",
      "updatedAt": "2025-09-03T02:24:45.646Z",
      "chapterId": "e0c0d3a5-b556-4af7-8cdd-80655a49dcb1"
    },
    {
      "id": "25109e19-4031-4ff7-9bd8-fca4c266f86a",
      "text": "thật hạnh phúc dường bao !",
      "label": "12",
      "number": 12,
      "subVerseIndex": 4,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:24:45.660Z",
      "updatedAt": "2025-09-03T02:24:45.660Z",
      "chapterId": "e0c0d3a5-b556-4af7-8cdd-80655a49dcb1"
    }
  ],
  "marks": [
    {
      "id": "59e57e05-2ded-4a20-a184-24315577dee4",
      "content": "English: Messiah | French: Messie | Latin: Messia | Origin: &#924;&#949;&#963;&#963;&#953;&#945;&#962; | Vietnamese: Mê-si-a -- Ga 1,41 ; Lc 4,18",
      "kind": "MARK_KIND_FOOTNOTE",
