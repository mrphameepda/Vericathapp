{
  "chapter": {
    "id": "33f6d1db-b515-4549-b2b6-500163911d6b",
    "number": 20,
    "createdAt": "2025-09-03T01:07:51.660Z",
    "updatedAt": "2025-09-03T01:07:51.660Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "80fb0e82-e1a8-455b-bdb9-c62e7de21eb7",
      "text": "*Phần ca trưởng. Thánh vịnh. Của vua Đa-vít.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:26:28.991Z",
      "updatedAt": "2025-09-03T02:26:28.991Z",
      "chapterId": "33f6d1db-b515-4549-b2b6-500163911d6b"
    },
    {
      "id": "110d96b9-b692-4aa0-8ec6-e4cf5978b8e3",
      "text": "Ngày đức vua gặp bước gian truân,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:29.053Z",
      "updatedAt": "2025-09-03T02:26:29.053Z",
      "chapterId": "33f6d1db-b515-4549-b2b6-500163911d6b"
    },
    {
      "id": "ef183d87-62db-4681-bb9a-bf5f76c0886d",
      "text": "xin CHÚA đáp lời ngài.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:29.064Z",
      "updatedAt": "2025-09-03T02:26:29.064Z",
      "chapterId": "33f6d1db-b515-4549-b2b6-500163911d6b"
    },
    {
      "id": "79745e36-6f0b-480e-abb9-d3381398e59a",
      "text": "Nguyện danh Chúa Trời nhà Gia-cóp",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:29.077Z",
      "updatedAt": "2025-09-03T02:26:29.077Z",
      "chapterId": "33f6d1db-b515-4549-b2b6-500163911d6b"
    },
    {
      "id": "a8631486-4388-4cae-8273-0a6776dc2882",
      "text": "khấng phù hộ chở che.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 3,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:29.107Z",
      "updatedAt": "2025-09-03T02:26:29.107Z",
      "chapterId": "33f6d1db-b515-4549-b2b6-500163911d6b"
    },
    {
      "id": "8ca1ca34-5c85-47bc-a512-4a66a29308da",
      "text": "Từ thánh điện, cầu Chúa thương cứu trợ,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:29.127Z",
      "updatedAt": "2025-09-03T02:26:29.127Z",
      "chapterId": "33f6d1db-b515-4549-b2b6-500163911d6b"
    },
    {
      "id": "0551595c-88b9-41a2-b62f-e8edc9f0d5d1",
      "text": "từ Xi-on, nguyện Chúa đỡ nâng ngài.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:29.143Z",
      "updatedAt": "2025-09-03T02:26:29.143Z",
      "chapterId": "33f6d1db-b515-4549-b2b6-500163911d6b"
    },
    {
      "id": "86892175-3e4a-4449-95d7-e21b7188ca7f",
      "text": "Mong Chúa hằng nhớ đến mọi lễ phẩm ngài dâng,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:29.171Z",
      "updatedAt": "2025-09-03T02:26:29.171Z",
      "chapterId": "33f6d1db-b515-4549-b2b6-500163911d6b"
    },
    {
      "id": "1ed8b894-7ea6-4999-b40a-25ce7f800790",
      "text": "và hoan hỷ chấp nhận lễ toàn thiêu của ngài.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:29.186Z",
      "updatedAt": "2025-09-03T02:26:29.186Z",
      "chapterId": "33f6d1db-b515-4549-b2b6-500163911d6b"
    },
    {
      "id": "548ecba1-bf98-48f1-b235-6e28ec083f6d",
      "text": "Xin Chúa ban như lòng ngài ước nguyện,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:29.204Z",
      "updatedAt": "2025-09-03T02:26:29.204Z",
      "chapterId": "33f6d1db-b515-4549-b2b6-500163911d6b"
    },
    {
      "id": "eb50a6f1-5bca-4752-87d4-f7a167c45fb7",
      "text": "và cho mọi điều ngài toan tính được thành công.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:29.232Z",
      "updatedAt": "2025-09-03T02:26:29.232Z",
      "chapterId": "33f6d1db-b515-4549-b2b6-500163911d6b"
    },
    {
      "id": "398d6b07-0dc7-41c7-bb77-f92422e3df1d",
      "text": "Ước gì chúng tôi được hoan hô ngài chiến thắng,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:29.247Z",
      "updatedAt": "2025-09-03T02:26:29.247Z",
      "chapterId": "33f6d1db-b515-4549-b2b6-500163911d6b"
    },
    {
      "id": "2f4433d0-06fe-4380-9791-2dd7abd7e4c3",
      "text": "được phất cờ mừng danh Thiên Chúa chúng ta !",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:29.261Z",
      "updatedAt": "2025-09-03T02:26:29.261Z",
      "chapterId": "33f6d1db-b515-4549-b2b6-500163911d6b"
    },
    {
      "id": "1bec48ad-7458-4fc2-b2ce-e79f61f7d236",
      "text": "Ước gì CHÚA thoả mãn mọi điều ngài khấn xin !",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:29.277Z",
      "updatedAt": "2025-09-03T02:26:29.277Z",
      "chapterId": "33f6d1db-b515-4549-b2b6-500163911d6b"
    },
    {
      "id": "3f43a04a-8d61-4417-8e48-be45cd00aad5",
      "text": "Giờ đây tôi biết rằng : CHÚA đã ban chiến thắng",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:29.291Z",
      "updatedAt": "2025-09-03T02:26:29.291Z",
      "chapterId": "33f6d1db-b515-4549-b2b6-500163911d6b"
    },
    {
      "id": "98c1e7fc-9f7b-430d-993b-39dee6779f65",
      "text": "cho đấng Chúa xức dầu tấn phong.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:29.321Z",
      "updatedAt": "2025-09-03T02:26:29.321Z",
      "chapterId": "33f6d1db-b515-4549-b2b6-500163911d6b"
    },
    {
      "id": "07781f95-d5ae-493b-89aa-20c2d65145aa",
      "text": "Từ thánh cung cao thẳm, Chúa đã đáp lời người,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:29.335Z",
      "updatedAt": "2025-09-03T02:26:29.335Z",
      "chapterId": "33f6d1db-b515-4549-b2b6-500163911d6b"
    },
    {
      "id": "061df1e4-2f43-4c4a-83b8-ba947e1c0fa9",
      "text": "mà ra tay thực hiện những chiến thắng oai hùng.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 3,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:29.349Z",
      "updatedAt": "2025-09-03T02:26:29.349Z",
      "chapterId": "33f6d1db-b515-4549-b2b6-500163911d6b"
    },
    {
      "id": "3a11a81d-dae6-4a37-ab00-a7245bdb738d",
      "text": "Kẻ cậy chiến xa, người nhờ chiến mã,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:29.363Z",
      "updatedAt": "2025-09-03T02:26:29.363Z",
      "chapterId": "33f6d1db-b515-4549-b2b6-500163911d6b"
    },
    {
      "id": "7ba0d478-643b-4109-84f5-cd69ec31b6d5",
      "text": "phần chúng tôi,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:29.378Z",
      "updatedAt": "2025-09-03T02:26:29.378Z",
      "chapterId": "33f6d1db-b515-4549-b2b6-500163911d6b"
    },
    {
      "id": "5d961521-9269-4b15-85cd-b4ebf1311e3b",
      "text": "chỉ kêu cầu danh CHÚA là Thiên Chúa chúng tôi.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:29.392Z",
      "updatedAt": "2025-09-03T02:26:29.392Z",
      "chapterId": "33f6d1db-b515-4549-b2b6-500163911d6b"
    },
    {
      "id": "a09d03a3-984e-4d62-ad7b-71fb33ecfc70",
      "text": "Bọn chúng đều quỵ xuống té nhào,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:29.422Z",
      "updatedAt": "2025-09-03T02:26:29.422Z",
      "chapterId": "33f6d1db-b515-4549-b2b6-500163911d6b"
    },
    {
      "id": "83617023-204f-4b10-b89b-5a19842a98d1",
      "text": "còn chúng tôi vươn mình đứng vững.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:29.436Z",
      "updatedAt": "2025-09-03T02:26:29.436Z",
      "chapterId": "33f6d1db-b515-4549-b2b6-500163911d6b"
    },
    {
      "id": "63f1872d-c3c3-4f6f-884b-742a9418a256",
      "text": "Lạy CHÚA, xin giúp vua toàn thắng ;",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:29.452Z",
      "updatedAt": "2025-09-03T02:26:29.452Z",
      "chapterId": "33f6d1db-b515-4549-b2b6-500163911d6b"
    },
    {
      "id": "6253ca60-c38c-4431-be4a-937d5bf422f4",
      "text": "ngày chúng con cầu khẩn, nguyện xin Chúa đáp lời.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:29.466Z",
      "updatedAt": "2025-09-03T02:26:29.466Z",
      "chapterId": "33f6d1db-b515-4549-b2b6-500163911d6b"
    }
  ],
