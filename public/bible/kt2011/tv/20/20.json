      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "33f6d1db-b515-4549-b2b6-500163911d6b"
    },
    {
      "id": "1c85b6e8-bca1-40c8-aa2d-1209c6f1cf6b",
      "content": "Sau *lễ toàn thiêu* (c.4) và những lời cầu chúc, *ước nguyện* của dân, Thiên Chúa nhậm lời ngay, có lẽ bằng một lời sấm do một tư tế hoặc một thầy Lê-vi chuyển đạt.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "7",
      "sortOrder": 6,
      "startOffset": 21,
      "endOffset": 21,
      "createdAt": "2025-09-03T02:26:29.306Z",
      "updatedAt": "2025-09-03T02:26:29.306Z",
      "targetId": "3f43a04a-8d61-4417-8e48-be45cd00aad5",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "33f6d1db-b515-4549-b2b6-500163911d6b"
    },
    {
      "id": "32fca1c8-4379-4ecc-9f4e-bb0c3cd86c5b",
      "content": "Người đời dựa vào binh bị (*chiến xa, chiến mã*) để mong chiến thắng. Còn dân thì chỉ biết kêu cầu danh Thiên Chúa, tức là tin tưởng vào quyền năng của Người.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "8",
      "sortOrder": 7,
      "startOffset": 45,
      "endOffset": 45,
      "createdAt": "2025-09-03T02:26:29.407Z",
      "updatedAt": "2025-09-03T02:26:29.407Z",
      "targetId": "5d961521-9269-4b15-85cd-b4ebf1311e3b",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "33f6d1db-b515-4549-b2b6-500163911d6b"
    }
