{
  "chapter": {
    "id": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad",
    "number": 22,
    "createdAt": "2025-09-03T01:07:51.660Z",
    "updatedAt": "2025-09-03T01:07:51.660Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "6092351b-ab26-4a62-ba8b-b45812b314bd",
      "text": "*Phần ca trưởng. Theo điệu : Con nai hừng đông. Thánh vịnh. Của vua Đa-vít.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:26:40.943Z",
      "updatedAt": "2025-09-03T02:26:40.943Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "59272b96-b1df-402a-918d-2fe9b63f36cc",
      "text": "Lạy Chúa con thờ, muôn lạy Chúa,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.008Z",
      "updatedAt": "2025-09-03T02:26:41.008Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "a9a0d1d9-e6f5-4752-8b1f-93ff40a84a94",
      "text": "Ngài nỡ lòng ruồng bỏ con sao ?",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.032Z",
      "updatedAt": "2025-09-03T02:26:41.032Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "9eab5701-1d81-451e-8d4d-eee687709fe3",
      "text": "Dù con thảm thiết kêu gào,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.060Z",
      "updatedAt": "2025-09-03T02:26:41.060Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "7d019f7e-c0b6-449c-9c7f-9cc70a7f0f5d",
      "text": "nhưng ơn cứu độ nơi nao xa vời !",
      "label": "2",
      "number": 2,
      "subVerseIndex": 3,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.075Z",
      "updatedAt": "2025-09-03T02:26:41.075Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "ffdffb84-d602-4ea3-8ef0-ed1cc9c5f5af",
      "text": "Ngày kêu Chúa, không lời đáp ứng,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.088Z",
      "updatedAt": "2025-09-03T02:26:41.088Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "369f7de0-e803-409e-b3c2-743148c8bab9",
      "text": "đêm van Ngài mà cũng chẳng yên.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.103Z",
      "updatedAt": "2025-09-03T02:26:41.103Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "12bebd97-574c-4237-b503-5d947ba5b594",
      "text": "Thế nhưng Chúa ngự nơi đền,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.118Z",
      "updatedAt": "2025-09-03T02:26:41.118Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "ab6f8ae3-952b-465f-9d2c-4d6be56cc4d7",
      "text": "vinh quang của Ít-ra-en là Ngài.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.132Z",
      "updatedAt": "2025-09-03T02:26:41.132Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "e8197fb9-e2f6-4e91-ae12-b22fa83129b4",
      "text": "Xưa tổ phụ vẫn hoài cậy Chúa,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.181Z",
      "updatedAt": "2025-09-03T02:26:41.181Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "bf104d39-d00a-4772-99df-adada80130a2",
      "text": "họ cậy trông, Ngài đã độ trì,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.195Z",
      "updatedAt": "2025-09-03T02:26:41.195Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "366e51d6-8160-43fa-aa50-f4e96f8b8c3d",
      "text": "van nài liền được cứu nguy,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.211Z",
      "updatedAt": "2025-09-03T02:26:41.211Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "a9e850c1-e5de-4cb7-b229-acc0aad74c15",
      "text": "đã không thất vọng mỗi khi cậy Ngài.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.224Z",
      "updatedAt": "2025-09-03T02:26:41.224Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "2035fa4d-bf5c-43fc-9232-4718fd302274",
      "text": "Thân sâu bọ chứ người đâu phải,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.239Z",
      "updatedAt": "2025-09-03T02:26:41.239Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "addddc8b-b635-4890-8c50-06fc8564d4fd",
      "text": "con bị đời mắng chửi dể duôi,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.253Z",
      "updatedAt": "2025-09-03T02:26:41.253Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "f2f77e33-7295-4834-8730-99b6707dc40a",
      "text": "thấy con ai cũng chê cười,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.267Z",
      "updatedAt": "2025-09-03T02:26:41.267Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "af922d9d-5d17-4de9-a8f2-4c41b5522a22",
      "text": "lắc đầu bĩu mỏ buông lời mỉa mai :",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.281Z",
      "updatedAt": "2025-09-03T02:26:41.281Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "a9598e31-2e66-422f-a027-6453db888fdb",
      "text": "“Nó cậy CHÚA, mặc Người cứu nó !",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.295Z",
      "updatedAt": "2025-09-03T02:26:41.295Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "a3f9c749-5716-4db2-8200-d85072b7ed51",
      "text": "Người có thương, giải gỡ đi nào !”",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.310Z",
      "updatedAt": "2025-09-03T02:26:41.310Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "8df9fd73-97a9-46e2-9253-fe110c479bf7",
      "text": "Đưa con ra khỏi thai bào,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.324Z",
      "updatedAt": "2025-09-03T02:26:41.324Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "1a09c019-a5c3-4841-a66b-84bde30bb5d3",
      "text": "vòng tay mẹ ẵm Chúa trao an toàn.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.338Z",
      "updatedAt": "2025-09-03T02:26:41.338Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "30ca0bf7-ce92-4a86-8bb3-18676cb00a4a",
      "text": "Chào đời con được dâng cho Chúa,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.353Z",
      "updatedAt": "2025-09-03T02:26:41.353Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "3390237d-aacf-4d9f-8268-68e613a6eb6d",
      "text": "được Ngài là Chúa tự sơ sinh.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.367Z",
      "updatedAt": "2025-09-03T02:26:41.367Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "9df207bb-7164-4ecc-b723-2abf9169a72a",
      "text": "Xa con Ngài đứng sao đành,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.382Z",
      "updatedAt": "2025-09-03T02:26:41.382Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "b38db0d6-baf1-4291-9853-a392ca4e4126",
      "text": "nguy hiểm bên mình không kẻ giúp cho.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.396Z",
      "updatedAt": "2025-09-03T02:26:41.396Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "289821d2-a5fd-4331-87f7-1262c21297df",
      "text": "Quanh con cả đàn bò bao kín,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.410Z",
      "updatedAt": "2025-09-03T02:26:41.410Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "ddabfabe-6319-4586-8c8c-f47873eb3dff",
      "text": "thú Ba-san ùa đến bủa vây :",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.423Z",
      "updatedAt": "2025-09-03T02:26:41.423Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "29ce5854-a9d1-43a5-ad9a-b05566215855",
      "text": "Há mồm đe doạ gớm thay,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.452Z",
      "updatedAt": "2025-09-03T02:26:41.452Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "a7d58aa5-cc5c-4692-b954-6b2265459f7b",
      "text": "khác nào sư tử xé thây vang gầm.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.467Z",
      "updatedAt": "2025-09-03T02:26:41.467Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "f59384bc-d846-4be9-8e55-efe1e3dcc27b",
      "text": "Tưởng mình như tan dần ra nước,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.481Z",
      "updatedAt": "2025-09-03T02:26:41.481Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "8c5cb4d7-0251-4169-a60e-e090df27ac64",
      "text": "toàn thân con xương cốt rã rời,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.501Z",
      "updatedAt": "2025-09-03T02:26:41.501Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "1742bb2f-9b26-4ec6-8758-fae98c5bc5ad",
      "text": "con tim đau đớn bồi hồi,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 2,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.516Z",
      "updatedAt": "2025-09-03T02:26:41.516Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "5e695de3-c1b3-4106-85b7-4fcd871f2509",
      "text": "mềm như sáp chảy tơi bời ruột gan.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 3,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.530Z",
      "updatedAt": "2025-09-03T02:26:41.530Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "db6bd6fb-2dc4-4df5-88af-58684af0a254",
      "text": "Nghe cổ họng khô ran như ngói,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.544Z",
      "updatedAt": "2025-09-03T02:26:41.544Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "381a05b0-7ea0-4453-bfa7-4cacf63d568c",
      "text": "lưỡi với hàm dính lại cùng nhau,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.558Z",
      "updatedAt": "2025-09-03T02:26:41.558Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "735e73bf-8bcd-46f0-9f40-44a26cdc4de9",
      "text": "chốn tử vong Chúa đặt vào ;",
      "label": "16",
      "number": 16,
      "subVerseIndex": 2,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.572Z",
      "updatedAt": "2025-09-03T02:26:41.572Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "ba02681f-0370-4f03-b598-e1aacba10d23",
      "text": "quanh con bầy chó đã bao chặt rồi.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.586Z",
      "updatedAt": "2025-09-03T02:26:41.586Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "c77c0899-026c-4080-83ee-994ff0dd803c",
      "text": "Bọn ác đó trong ngoài vây bủa,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.600Z",
      "updatedAt": "2025-09-03T02:26:41.600Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "8c5a5cc5-c3dc-4359-98cc-0c4f4e7d7942",
      "text": "chúng đâm con thủng cả chân tay,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 2,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.614Z",
      "updatedAt": "2025-09-03T02:26:41.614Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "d69652b0-a9fd-4806-87d4-7938de27fc94",
      "text": "xương con đếm được vắn dài ;",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.628Z",
      "updatedAt": "2025-09-03T02:26:41.628Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "b4d7176e-eb83-41f5-b367-49cc81fd8a01",
      "text": "chúng đưa cặp mắt cứ hoài ngó xem.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.642Z",
      "updatedAt": "2025-09-03T02:26:41.642Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "67da9009-70ea-4de6-a0c4-4831d0fdc4b7",
      "text": "Áo mặc ngoài chúng đem chia chác,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.656Z",
      "updatedAt": "2025-09-03T02:26:41.656Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "ae0c70f4-e7d6-4c81-9010-0e2711e4b809",
      "text": "còn áo trong cũng bắt thăm luôn.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.670Z",
      "updatedAt": "2025-09-03T02:26:41.670Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "01144866-14ae-48ae-9091-ba65d598206e",
      "text": "Chúa là sức mạnh con nương,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.684Z",
      "updatedAt": "2025-09-03T02:26:41.684Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "5f109136-8ca1-4c35-a456-9ad02bbcf7ee",
      "text": "cứu mau, lạy CHÚA, xin đừng đứng xa.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.698Z",
      "updatedAt": "2025-09-03T02:26:41.698Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "bf5bf1c9-a1b2-4489-9eef-bfab1497c3e8",
      "text": "Xin cứu mạng khỏi sa lưỡi kiếm,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.713Z",
      "updatedAt": "2025-09-03T02:26:41.713Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "51789aa3-f8dc-4a26-ac96-8e0a026f7165",
      "text": "gỡ thân con thoát miệng chó rừng,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.745Z",
      "updatedAt": "2025-09-03T02:26:41.745Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "83936637-37d2-42f2-bc6f-3c061f696917",
      "text": "khỏi nanh sư tử hãi hùng,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.759Z",
      "updatedAt": "2025-09-03T02:26:41.759Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "ac8ea32c-7fd0-497f-a7d5-0f4ae0d15434",
      "text": "phận hèn khốn khổ thoát sừng trâu điên.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.773Z",
      "updatedAt": "2025-09-03T02:26:41.773Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "095224c6-78a1-41f5-a9ea-3ea0fa595c5f",
      "text": "Con nguyện sẽ loan truyền danh Chúa",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.786Z",
      "updatedAt": "2025-09-03T02:26:41.786Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "f6e446c7-a246-453b-acce-ffc854ed7ce6",
      "text": "cho anh em tất cả được hay,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.809Z",
      "updatedAt": "2025-09-03T02:26:41.809Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "e56de063-bcef-4aca-a026-ba3ee8715676",
      "text": "và trong đại hội dân Ngài,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 2,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.820Z",
      "updatedAt": "2025-09-03T02:26:41.820Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "840f2846-616c-4229-9f59-d93f608cbd3e",
      "text": "con xin dâng tiến một bài tán dương.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 3,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.831Z",
      "updatedAt": "2025-09-03T02:26:41.831Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "87419663-e565-4580-80bc-8ac2361ba357",
      "text": "Hỡi những ai kính sợ ĐỨC CHÚA,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.844Z",
      "updatedAt": "2025-09-03T02:26:41.844Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "ca6a07b1-83a8-4910-af43-6aa89856c0b9",
      "text": "hãy ca tụng Người đi !",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.871Z",
      "updatedAt": "2025-09-03T02:26:41.871Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "f7881111-e74d-4048-b53c-8b9c8c3a6d2a",
      "text": "Hỡi toàn thể giống nòi Gia-cóp,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 2,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.889Z",
      "updatedAt": "2025-09-03T02:26:41.889Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "41035b6c-8af5-4b0d-88c8-407d992c9568",
      "text": "nào hãy tôn vinh Người !",
      "label": "24",
      "number": 24,
      "subVerseIndex": 3,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.917Z",
      "updatedAt": "2025-09-03T02:26:41.917Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "ef0c1410-637a-4828-906d-9864ae152b54",
      "text": "Dòng dõi Ít-ra-en tất cả,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 4,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.936Z",
      "updatedAt": "2025-09-03T02:26:41.936Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "c1919c7e-89a4-4152-88ce-b1a3e8c0d9f3",
      "text": "nào một dạ khiếp oai !",
      "label": "24",
      "number": 24,
      "subVerseIndex": 5,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.959Z",
      "updatedAt": "2025-09-03T02:26:41.959Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "e71264f5-aee8-444b-9c42-fbc71b43c891",
      "text": "Bởi vì Chúa đã chẳng coi thường,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.971Z",
      "updatedAt": "2025-09-03T02:26:41.971Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "bf522d7d-53f1-4e7f-98d6-63ef731bf72a",
      "text": "chẳng khinh miệt kẻ nghèo hèn khốn khổ,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.983Z",
      "updatedAt": "2025-09-03T02:26:41.983Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "8793e35b-1766-48b4-b31b-51f177781796",
      "text": "cũng không đành ngoảnh mặt làm ngơ,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 2,
      "paragraphNumber": 61,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:41.995Z",
      "updatedAt": "2025-09-03T02:26:41.995Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "a948b150-3f6d-436d-b331-0e8c130d498d",
      "text": "nhưng đã thương nghe lời cầu cứu.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 3,
      "paragraphNumber": 62,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:42.008Z",
      "updatedAt": "2025-09-03T02:26:42.008Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "d4acca86-5cc0-4b8a-a351-f09acc4b5fa4",
      "text": "Chịu ơn Người, tôi dâng lời ca tụng,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 63,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:42.021Z",
      "updatedAt": "2025-09-03T02:26:42.021Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "3a428540-ea3e-4b30-8cfd-a67f80b60793",
      "text": "ngày đại hội toàn dân.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 64,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:42.036Z",
      "updatedAt": "2025-09-03T02:26:42.036Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "3d8296e2-fefd-4c96-868a-5b3313672582",
      "text": "Điều khấn nguyền, tôi xin giữ trọn",
      "label": "26",
      "number": 26,
      "subVerseIndex": 2,
      "paragraphNumber": 65,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:42.051Z",
      "updatedAt": "2025-09-03T02:26:42.051Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "405ff32b-27eb-49ff-bc85-543ef6d73f89",
      "text": "trước mặt những ai kính sợ Người.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 3,
      "paragraphNumber": 66,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:42.065Z",
      "updatedAt": "2025-09-03T02:26:42.065Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "b80949b1-a31f-45be-9109-972e42b3fe9e",
      "text": "Kẻ nghèo hèn được ăn uống thoả thuê,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 67,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:42.079Z",
      "updatedAt": "2025-09-03T02:26:42.079Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "b4786339-322d-44e7-871f-3c75b6cad655",
      "text": "người tìm CHÚA sẽ dâng lời ca tụng.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 68,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:42.092Z",
      "updatedAt": "2025-09-03T02:26:42.092Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "d17b7d98-0b72-44f9-a97a-0559c045c9bf",
      "text": "Cầu chúc họ vui sống ngàn đời.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 2,
      "paragraphNumber": 69,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:42.107Z",
      "updatedAt": "2025-09-03T02:26:42.107Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "f9cafffd-5c33-4c71-9ed3-f3a1a3367965",
      "text": "Toàn thế giới, muôn người nhớ lại",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 70,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:42.121Z",
      "updatedAt": "2025-09-03T02:26:42.121Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "28ba303b-b18f-4bba-8474-fc54db1ea905",
      "text": "và trở về cùng CHÚA.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 1,
      "paragraphNumber": 71,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:42.135Z",
      "updatedAt": "2025-09-03T02:26:42.135Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "5bed3367-4474-4236-9571-cd75b9d30e20",
      "text": "Mọi dân tộc dưới trần",
      "label": "28",
      "number": 28,
      "subVerseIndex": 2,
      "paragraphNumber": 72,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:42.149Z",
      "updatedAt": "2025-09-03T02:26:42.149Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "0b0705ed-98a9-4a60-a5eb-af353ab14701",
      "text": "phủ phục trước Tôn Nhan.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 3,
      "paragraphNumber": 73,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:42.163Z",
      "updatedAt": "2025-09-03T02:26:42.163Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "241218c9-72e4-42c1-ae6b-60a2fd733b92",
      "text": "Bởi vì CHÚA nắm quyền vương đế,",
      "label": "29",
      "number": 29,
      "subVerseIndex": 0,
      "paragraphNumber": 74,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:42.178Z",
      "updatedAt": "2025-09-03T02:26:42.178Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "9e2d09d6-6026-463d-85cb-31d8a6b224e9",
      "text": "Người thống trị chư dân.",
      "label": "29",
      "number": 29,
      "subVerseIndex": 1,
      "paragraphNumber": 75,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:42.191Z",
      "updatedAt": "2025-09-03T02:26:42.191Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "347427fc-d229-4339-b328-51c3c818c20e",
      "text": "Mọi kẻ ngủ yên trong lòng đất",
      "label": "30",
      "number": 30,
      "subVerseIndex": 0,
      "paragraphNumber": 76,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:42.205Z",
      "updatedAt": "2025-09-03T02:26:42.205Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "234c85cb-9d9e-4008-a380-4c672f3385fa",
      "text": "sẽ đều bái lạy một mình Người,",
      "label": "30",
      "number": 30,
      "subVerseIndex": 1,
      "paragraphNumber": 77,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:42.219Z",
      "updatedAt": "2025-09-03T02:26:42.219Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "739a223f-3d55-4eb2-ab0a-02b93bb25233",
      "text": "phàm những ai trở về cát bụi",
      "label": "30",
      "number": 30,
      "subVerseIndex": 2,
      "paragraphNumber": 78,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:42.233Z",
      "updatedAt": "2025-09-03T02:26:42.233Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "68311aed-9b7f-4646-b89a-77f89e11b36f",
      "text": "sẽ cùng phủ phục trước Thánh Nhan.",
      "label": "30",
      "number": 30,
      "subVerseIndex": 3,
      "paragraphNumber": 79,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:42.248Z",
      "updatedAt": "2025-09-03T02:26:42.248Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "ac551023-f5af-4d92-8b89-8b0c3391d6fc",
      "text": "Phần tôi, nguyện sẽ sống cho Chúa,",
      "label": "30",
      "number": 30,
      "subVerseIndex": 4,
      "paragraphNumber": 80,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:42.262Z",
      "updatedAt": "2025-09-03T02:26:42.262Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "45580576-d8a5-475c-835a-6c13fabee708",
      "text": "con cháu tôi sẽ phụng sự Người.",
      "label": "31",
      "number": 31,
      "subVerseIndex": 0,
      "paragraphNumber": 81,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:42.275Z",
      "updatedAt": "2025-09-03T02:26:42.275Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "f8adc3ac-65b1-4d61-bc5f-2fd55079f532",
      "text": "Thiên hạ sẽ nói về Đức Chúa",
      "label": "31",
      "number": 31,
      "subVerseIndex": 1,
      "paragraphNumber": 82,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:42.290Z",
      "updatedAt": "2025-09-03T02:26:42.290Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "4c5dd6ce-9b4f-4eb6-92fb-f5a7a3cdecb9",
      "text": "cho thế hệ tương lai,",
      "label": "31",
      "number": 31,
      "subVerseIndex": 2,
      "paragraphNumber": 83,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:42.305Z",
      "updatedAt": "2025-09-03T02:26:42.305Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "9ddcba53-675a-4477-b9b1-802099c80a66",
      "text": "truyền tụng cho hậu sinh đức công chính của Người,",
      "label": "32",
      "number": 32,
      "subVerseIndex": 0,
      "paragraphNumber": 84,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:42.318Z",
      "updatedAt": "2025-09-03T02:26:42.318Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "a962a8e3-a8c2-4f74-b61f-3523c89d8752",
      "text": "rằng : “Đức Chúa đã làm như vậy !”",
      "label": "32",
      "number": 32,
      "subVerseIndex": 1,
      "paragraphNumber": 85,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:42.333Z",
      "updatedAt": "2025-09-03T02:26:42.333Z",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    }
  ],
  "marks": [
    {
      "id": "909fc416-6aa4-4105-bfe9-1bbfd84bbdd1",
      "content": "English: Yahweh | French: SEIGNEUR | Latin: Dominus | Origin: &#1497;&#1456;&#1492;&#64331;&#1464;&#1492; | Vietnamese: ĐỨC CHÚA -- Danh của Thiên Chúa Ít-ra-en, St 2,4...",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 55,
      "endOffset": 55,
      "createdAt": "2025-09-03T02:26:40.975Z",
      "updatedAt": "2025-09-03T02:26:40.975Z",
      "targetId": "848ee025-a122-4f17-bad1-a99708d98947",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "8a9de328-5737-4f22-92b4-d50200762754",
      "content": "Có lẽ, điệu của Tv 22 này lấy từ bài hát mang tên *Con nai hừng đông*. Phần đầu của Tv này (cc. 2-22) là *một ai ca của cá nhân*. Sau thời lưu đày, cc. 28-32 đã được ghép vào để diễn tả những tâm tình tạ ơn của cộng đồng Ít-ra-en. Do đó, có thể chia Tv 22 làm hai phần : **1**) Lời than van kêu cứu của một người bị đau ốm và ngược đãi (cc. 2-22) ; **2**) Lời tạ ơn Thiên Chúa, rồi viễn tượng các dân nước sẽ nhận vương quyền của Thiên Chúa trên họ cũng như cái nhìn xa về thế hệ tương lai : họ cũng sẽ được nghe nói về Thiên Chúa (cc. 23-32).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 46,
      "endOffset": 46,
      "createdAt": "2025-09-03T02:26:40.986Z",
      "updatedAt": "2025-09-03T02:26:40.986Z",
      "targetId": "6092351b-ab26-4a62-ba8b-b45812b314bd",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "6d124a34-3d0a-43c2-82c2-70ac7fa5ee34",
      "content": "English: David | French: David | Latin: David | Origin: &#1491;&#1464;&#1493;&#1460;&#1491; | Vietnamese: Đa-vít -- 1 Sm 16,21-22",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 74,
      "endOffset": 74,
      "createdAt": "2025-09-03T02:26:40.997Z",
      "updatedAt": "2025-09-03T02:26:40.997Z",
      "targetId": "6092351b-ab26-4a62-ba8b-b45812b314bd",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "063ac6c0-03e5-46c2-8eaf-9fc7b610457f",
      "content": "Phần I (cc. 2-22) gồm hai đoạn : **1**) Những lời than van (cc. 2-3.7-9) và các lý do hy vọng (cc. 4-6.10-12) ; **2**) Tựa loài thú dữ, kẻ thù hung hãn cứ hoành hành khiến cho tác giả phải khiếp sợ và đau khổ ; trong hoàn cảnh đó, tác giả xin Thiên Chúa cứu nguy (cc. 13-22).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 31,
      "endOffset": 31,
      "createdAt": "2025-09-03T02:26:41.019Z",
      "updatedAt": "2025-09-03T02:26:41.019Z",
      "targetId": "59272b96-b1df-402a-918d-2fe9b63f36cc",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "e72a5820-b5a3-45dc-b960-4247281cc630",
      "content": "Thánh vịnh này là một trong những Thánh vịnh năng được Tân Ước trích dẫn : **1**) C.2 (*Lạy Chúa, Ngài nỡ lòng ruồng bỏ con sao ?*) : Mt 27,46 ; Mc 15,34 ; **2**) C.8 (*lắc đầu*) : Mt 27,39 ; Mc 15,29 ; **3**) C.9 (*Nó cậy Chúa, mặc Người cứu nó ! Người có thương, giải gỡ đi nào !*) : Mc 15,29 ; **4**) C.16 (*Nghe cổ họng khô ran như ngói* = khát nước) : Ga 19,28 ; **5**) C.19 (chia áo) : Mt 27,35 // Mc 15,24 // Lc 23,34 ; Ga 19,23-24 ; **6**) C.23 (*Con nguyện sẽ loan truyền danh Chúa ...*) : Hr 2,12.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "5",
      "sortOrder": 4,
      "startOffset": 29,
      "endOffset": 29,
      "createdAt": "2025-09-03T02:26:41.046Z",
      "updatedAt": "2025-09-03T02:26:41.046Z",
      "targetId": "a9a0d1d9-e6f5-4752-8b1f-93ff40a84a94",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "5fbdfa8b-e586-42d8-a694-29445f7a0f99",
      "content": "English: Yahweh | French: SEIGNEUR | Latin: Dominus | Origin: &#1497;&#1456;&#1492;&#64331;&#1464;&#1492; | Vietnamese: ĐỨC CHÚA -- Danh của Thiên Chúa Ít-ra-en, St 2,4...",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "6",
      "sortOrder": 5,
      "startOffset": 23,
      "endOffset": 23,
      "createdAt": "2025-09-03T02:26:41.146Z",
      "updatedAt": "2025-09-03T02:26:41.146Z",
      "targetId": "ab6f8ae3-952b-465f-9d2c-4d6be56cc4d7",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "1aacd38f-9d51-4fea-9eb8-1d6f8b01edbb",
      "content": "Nếu dịch sát câu này (*Chính Chúa là Đấng Thánh, Đấng ngự các lời ngợi khen của Ít-ra-en*), thì độc giả không thể nắm được ý nghĩa. Nên có nhiều cách dịch khác nhau : **1**) *Chúa là Đấng Thánh : Chúa ngự trị, Chúa là lời ca ngợi của Ít-ra-en* (Bản dịch đại kết TOB) ; **2**) *Chúa hiển ngự giữa lời ca ngợi của Ít-ra-en* (Nguyễn Thế Thuấn, Kahn) ; **3**) *Thế nhưng chính Chúa, Chúa ngự nơi Thánh điện, Chúa là lời ca ngợi của Ít-ra-en* (LXX, Osty) ; **4**) *Thế nhưng Chúa ngự nơi đền, vinh quang của Ít-ra-en là Ngài* (Bản dịch của Nhóm Phiên Dịch CGKPV đưa ra hai điểm riêng : “ngự *nơi đền*” ; “lời ca ngợi” biến thành “*vinh quang*”).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "7",
      "sortOrder": 6,
      "startOffset": 31,
      "endOffset": 31,
      "createdAt": "2025-09-03T02:26:41.160Z",
      "updatedAt": "2025-09-03T02:26:41.160Z",
      "targetId": "ab6f8ae3-952b-465f-9d2c-4d6be56cc4d7",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "308a4caa-5537-4697-8e5d-455cdfcc7582",
      "content": "English: Bashan | French: Bashân | Latin: Basan | Origin: &#64305;&#1464;&#64298;&#1464;&#1503; | Vietnamese: Ba-san -- Tv 68,16.23 ; Is 33,9",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "8",
