    },
    {
      "id": "dd482a1f-0f4e-41d4-894f-4d1e81b3c193",
      "content": "English: Sin | French: Sin | Latin: Sin | Origin: &#1505;&#1460;&#1497;&#1503; | Vietnamese: Xin 1 -- sa mạc trong cuộc Xuất hành, Xh 16,1 ; Ds 33,11-12",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "9",
      "sortOrder": 8,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:26:41.731Z",
      "updatedAt": "2025-09-03T02:26:41.731Z",
      "targetId": "bf5bf1c9-a1b2-4489-9eef-bfab1497c3e8",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "5fd7ce7a-a927-4bf1-9c40-f21ad1d836ad"
    },
    {
      "id": "6c5bac3b-4ec7-435c-b032-d264168e9e26",
      "content": "Phần II cũng gồm hai đoạn : **1**) Nghi lễ tạ ơn cử hành trong đại hội có đông người tham dự (cc. 23-27) ; **2**) Viễn tượng về các dân nước và các thế hệ trong tương lai (cc. 28-32).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "10",
      "sortOrder": 9,
      "startOffset": 35,
      "endOffset": 35,
      "createdAt": "2025-09-03T02:26:41.798Z",
      "updatedAt": "2025-09-03T02:26:41.798Z",
