{
  "chapter": {
    "id": "147e23ec-20d5-4409-8250-8111fdcaa9eb",
    "number": 24,
    "createdAt": "2025-09-03T01:07:51.660Z",
    "updatedAt": "2025-09-03T01:07:51.660Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "1e9cc9b8-f5fd-42c4-a7ac-b8ab6c84f17a",
      "text": "*Thánh vịnh. Của vua Đa-vít.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:26:53.175Z",
      "updatedAt": "2025-09-03T02:26:53.175Z",
      "chapterId": "147e23ec-20d5-4409-8250-8111fdcaa9eb"
    },
    {
      "id": "85708c0f-912d-456a-a740-c8207cb47d05",
      "text": "CHÚA làm chủ trái đất cùng muôn vật muôn loài,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:53.240Z",
      "updatedAt": "2025-09-03T02:26:53.240Z",
      "chapterId": "147e23ec-20d5-4409-8250-8111fdcaa9eb"
    },
    {
      "id": "4b20047c-a7f3-47cc-8d92-ef4219df86bf",
      "text": "làm chủ hoàn cầu với toàn thể dân cư.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:53.253Z",
      "updatedAt": "2025-09-03T02:26:53.253Z",
      "chapterId": "147e23ec-20d5-4409-8250-8111fdcaa9eb"
    },
    {
      "id": "1b64292a-4a36-436b-9eb5-d868f453d793",
      "text": "Nền trái đất, Người dựng trên biển cả,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:53.266Z",
      "updatedAt": "2025-09-03T02:26:53.266Z",
      "chapterId": "147e23ec-20d5-4409-8250-8111fdcaa9eb"
    },
    {
      "id": "05c0010a-64da-4f1a-9805-99b7e7f14199",
      "text": "đặt vững vàng trên làn nước mênh mông.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:53.280Z",
      "updatedAt": "2025-09-03T02:26:53.280Z",
      "chapterId": "147e23ec-20d5-4409-8250-8111fdcaa9eb"
    },
    {
      "id": "37d7862e-d114-46b5-9802-550a27e50455",
      "text": "Ai được lên núi CHÚA ?",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:53.309Z",
      "updatedAt": "2025-09-03T02:26:53.309Z",
      "chapterId": "147e23ec-20d5-4409-8250-8111fdcaa9eb"
    },
    {
      "id": "ec69c60d-5150-4cdf-a0a7-915a93da671b",
      "text": "Ai được ở trong đền thánh của Người ?",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:53.324Z",
      "updatedAt": "2025-09-03T02:26:53.324Z",
      "chapterId": "147e23ec-20d5-4409-8250-8111fdcaa9eb"
    },
    {
      "id": "ed551697-fc1c-48d5-a98d-a8840efa1e0f",
      "text": "Đó là kẻ tay sạch lòng thanh,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:53.338Z",
      "updatedAt": "2025-09-03T02:26:53.338Z",
      "chapterId": "147e23ec-20d5-4409-8250-8111fdcaa9eb"
    },
    {
      "id": "f9f165be-a595-47e8-b83c-0c13c867cc9b",
      "text": "chẳng mê theo ngẫu tượng, không thề gian thề dối.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:53.353Z",
      "updatedAt": "2025-09-03T02:26:53.353Z",
      "chapterId": "147e23ec-20d5-4409-8250-8111fdcaa9eb"
    },
    {
      "id": "de65fcfc-7727-4ea6-b652-3ed2c392be6d",
      "text": "Người ấy sẽ được CHÚA ban phúc lành,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:53.367Z",
      "updatedAt": "2025-09-03T02:26:53.367Z",
      "chapterId": "147e23ec-20d5-4409-8250-8111fdcaa9eb"
    },
    {
      "id": "1ab981d3-44af-4b31-a463-39d51cb32523",
      "text": "được Thiên Chúa cứu độ thưởng công xứng đáng.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:53.381Z",
      "updatedAt": "2025-09-03T02:26:53.381Z",
      "chapterId": "147e23ec-20d5-4409-8250-8111fdcaa9eb"
    },
    {
      "id": "681471ab-2ceb-4b9d-895c-e1e6d76d3673",
      "text": "Đây chính là dòng dõi những kẻ kiếm tìm Người,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:53.395Z",
      "updatedAt": "2025-09-03T02:26:53.395Z",
      "chapterId": "147e23ec-20d5-4409-8250-8111fdcaa9eb"
    },
    {
      "id": "432f9497-b063-49ea-b9d7-4d77df616dd2",
      "text": "tìm thánh nhan Thiên Chúa nhà Gia-cóp.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:53.409Z",
      "updatedAt": "2025-09-03T02:26:53.409Z",
      "chapterId": "147e23ec-20d5-4409-8250-8111fdcaa9eb"
    },
    {
      "id": "5ee94cf1-ab2a-4dc7-8b13-1dc1e9af42ac",
      "text": "Hỡi cửa đền, hãy cất cao lên,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:53.437Z",
      "updatedAt": "2025-09-03T02:26:53.437Z",
      "chapterId": "147e23ec-20d5-4409-8250-8111fdcaa9eb"
    },
    {
      "id": "9cbf7510-1c54-43f7-9996-407c4ec6866b",
      "text": "cao lên nữa, hỡi cửa đền cổ kính,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:53.451Z",
      "updatedAt": "2025-09-03T02:26:53.451Z",
      "chapterId": "147e23ec-20d5-4409-8250-8111fdcaa9eb"
    },
    {
      "id": "5c7984b8-b974-40d3-a025-e4740a7b0981",
      "text": "để Đức Vua vinh hiển ngự vào.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:53.468Z",
      "updatedAt": "2025-09-03T02:26:53.468Z",
      "chapterId": "147e23ec-20d5-4409-8250-8111fdcaa9eb"
    },
    {
      "id": "5c84c3e6-7c1e-4cdf-af52-1db6c167104b",
      "text": "Đức Vua vinh hiển đó là ai ?",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:53.486Z",
      "updatedAt": "2025-09-03T02:26:53.486Z",
      "chapterId": "147e23ec-20d5-4409-8250-8111fdcaa9eb"
    },
    {
      "id": "da25153b-9caf-44f3-86bb-b10ff9cccef9",
      "text": "Là ĐỨC CHÚA mạnh mẽ oai hùng",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:53.504Z",
      "updatedAt": "2025-09-03T02:26:53.504Z",
      "chapterId": "147e23ec-20d5-4409-8250-8111fdcaa9eb"
    },
    {
      "id": "f07833e3-6dde-4507-bf0f-aa672cc358b3",
      "text": "ĐỨC CHÚA oai hùng khi xuất trận.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:53.533Z",
      "updatedAt": "2025-09-03T02:26:53.533Z",
      "chapterId": "147e23ec-20d5-4409-8250-8111fdcaa9eb"
    },
    {
      "id": "4b828a8b-0f8c-4bd6-931e-ca83d2b61dc8",
      "text": "Hỡi cửa đền, hãy cất cao lên,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:53.561Z",
      "updatedAt": "2025-09-03T02:26:53.561Z",
      "chapterId": "147e23ec-20d5-4409-8250-8111fdcaa9eb"
    },
    {
      "id": "da8a9ed1-a775-4c38-aa9e-d69718eea387",
      "text": "cao lên nữa, hỡi cửa đền cổ kính,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:53.576Z",
      "updatedAt": "2025-09-03T02:26:53.576Z",
      "chapterId": "147e23ec-20d5-4409-8250-8111fdcaa9eb"
    },
    {
      "id": "c816a5ec-a2e2-47ff-a725-bd591d6b5abf",
      "text": "để Đức Vua vinh hiển ngự vào.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:53.590Z",
      "updatedAt": "2025-09-03T02:26:53.590Z",
      "chapterId": "147e23ec-20d5-4409-8250-8111fdcaa9eb"
    },
    {
      "id": "801ec6fe-972b-4bec-a7dd-8ec3cefb6086",
      "text": "Đức Vua vinh hiển đó là ai ?",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:53.604Z",
      "updatedAt": "2025-09-03T02:26:53.604Z",
      "chapterId": "147e23ec-20d5-4409-8250-8111fdcaa9eb"
    },
    {
      "id": "2b787365-9c59-47ef-a3a2-9555119329cb",
      "text": "Là Chúa Tể càn khôn : chính Người là Đức Vua vinh hiển.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:53.619Z",
      "updatedAt": "2025-09-03T02:26:53.619Z",
      "chapterId": "147e23ec-20d5-4409-8250-8111fdcaa9eb"
    }
  ],
  "marks": [
    {
