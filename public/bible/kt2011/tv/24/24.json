    },
    {
      "id": "6b93e84e-908b-47f2-b732-3af564c18c5a",
      "content": "Tv 24 là *một Thánh vịnh hỗn hợp* trong đó độc giả nhận thấy có những yếu tố về vương quyền của Thiên Chúa cũng như có những yếu tố giáo huấn (cc. 3-6). Thánh vịnh này gồm ba phần : **1**) Thánh thi kính Thiên Chúa là Đấng Hoá Công (cc. 1-2) ; **2**) Những điều kiện cần phải có để được vào ở trong Đền thánh (cc. 3-6) ; **3**) Bài thơ rất cổ xưa có lẽ liên quan đến Hòm Bia được rước về Giê-ru-sa-lem dưới thời vua Đa-vít (x. 2 Sm 6,12-16 ; Tv 68,25-28) (cc. 7-10).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 37,
      "endOffset": 37,
      "createdAt": "2025-09-03T02:26:53.217Z",
      "updatedAt": "2025-09-03T02:26:53.217Z",
      "targetId": "502c494b-b5d8-4a59-ba2d-28d68a33a213",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "147e23ec-20d5-4409-8250-8111fdcaa9eb"
    },
    {
      "id": "1de6bdd3-6121-4286-bb0b-f03fd9c8ad82",
      "content": "English: David | French: David | Latin: David | Origin: &#1491;&#1464;&#1493;&#1460;&#1491; | Vietnamese: Đa-vít -- 1 Sm 16,21-22",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 27,
      "endOffset": 27,
      "createdAt": "2025-09-03T02:26:53.228Z",
      "updatedAt": "2025-09-03T02:26:53.228Z",
      "targetId": "1e9cc9b8-f5fd-42c4-a7ac-b8ab6c84f17a",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "147e23ec-20d5-4409-8250-8111fdcaa9eb"
    },
    {
      "id": "b7f7becc-68b9-47bd-8d44-d3273596e380",
      "content": "Theo vũ trụ quan Thánh Kinh, trái đất, như một cái đĩa, được đặt trên một khối nước gọi là “Vực thẳm” nhờ những cột là núi non (x. Tv 136,6 ; G 38,4a.6).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 37,
      "endOffset": 37,
      "createdAt": "2025-09-03T02:26:53.295Z",
      "updatedAt": "2025-09-03T02:26:53.295Z",
      "targetId": "05c0010a-64da-4f1a-9805-99b7e7f14199",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "147e23ec-20d5-4409-8250-8111fdcaa9eb"
    },
