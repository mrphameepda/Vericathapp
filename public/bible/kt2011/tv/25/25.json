{
  "chapter": {
    "id": "439829ac-3169-4c0e-a70a-f02690b420f7",
    "number": 25,
    "createdAt": "2025-09-03T01:07:51.660Z",
    "updatedAt": "2025-09-03T01:07:51.660Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "4952e074-f8f0-4c2e-bc50-3034aec4d712",
      "text": "*Của vua Đa-vít.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:26:58.842Z",
      "updatedAt": "2025-09-03T02:26:58.842Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "48201913-1566-4b60-bcfd-5c8bbc7998bb",
      "text": "A-lép",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:26:58.919Z",
      "updatedAt": "2025-09-03T02:26:58.919Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "27252523-9545-448b-8a0e-3a80466d22d0",
      "text": "Lạy CHÚA, con nâng tâm hồn lên cùng CHÚA.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:58.932Z",
      "updatedAt": "2025-09-03T02:26:58.932Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "5280e690-84ed-4d17-bea1-f489454fa50f",
      "text": "Bết",
      "label": "1",
      "number": 1,
      "subVerseIndex": 3,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:26:58.946Z",
      "updatedAt": "2025-09-03T02:26:58.946Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "43e8d7d3-d5fd-4223-a536-4610c07cdbb6",
      "text": "Lạy Thiên Chúa của con, con tin tưởng nơi Ngài,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:58.960Z",
      "updatedAt": "2025-09-03T02:26:58.960Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "c5715ebc-9783-4f77-8c5e-3010d8c7bc3d",
      "text": "xin Ngài đừng để con tủi nhục,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:58.975Z",
      "updatedAt": "2025-09-03T02:26:58.975Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "8f171e8f-1f16-4b28-9748-b7dac8aa01a6",
      "text": "đừng để quân thù đắc chí nhạo cười con.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:58.989Z",
      "updatedAt": "2025-09-03T02:26:58.989Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "9293a8b4-fb0b-4d6f-93f0-bead1babfdb2",
      "text": "Ghi-men",
      "label": "2",
      "number": 2,
      "subVerseIndex": 3,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:26:59.003Z",
      "updatedAt": "2025-09-03T02:26:59.003Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "95e3a328-1826-47c7-a732-0df45c6e4cc7",
      "text": "Chẳng ai trông cậy Chúa,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:59.018Z",
      "updatedAt": "2025-09-03T02:26:59.018Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "10d9bee3-3d68-4fe8-a789-3b464440350c",
      "text": "mà lại phải nhục nhằn tủi hổ,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:59.032Z",
      "updatedAt": "2025-09-03T02:26:59.032Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "13337fe9-3b61-4f94-899f-9c3abc99543a",
      "text": "chỉ người nào tự dưng phản phúc",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:59.046Z",
      "updatedAt": "2025-09-03T02:26:59.046Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "afb7fced-03a1-43dd-a603-f49918f6bc5e",
      "text": "mới nhục nhằn tủi hổ mà thôi.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 3,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:59.061Z",
      "updatedAt": "2025-09-03T02:26:59.061Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "a8175e6c-87ab-4f33-874e-57e316452189",
      "text": "Đa-lét",
      "label": "3",
      "number": 3,
      "subVerseIndex": 4,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:26:59.078Z",
      "updatedAt": "2025-09-03T02:26:59.078Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "325ced30-b89a-43eb-8879-33632d42e2c0",
      "text": "Lạy CHÚA, đường nẻo Ngài, xin dạy cho con biết,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:59.093Z",
      "updatedAt": "2025-09-03T02:26:59.093Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "1c3f0adb-b345-47e5-84eb-2e2b49b5b183",
      "text": "lối đi của Ngài, xin chỉ bảo con.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:59.107Z",
      "updatedAt": "2025-09-03T02:26:59.107Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "f6f33c83-96ad-4b21-af21-4ff6e17f3fd7",
      "text": "Hê",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:26:59.136Z",
      "updatedAt": "2025-09-03T02:26:59.136Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "2a0b8fb4-a5ad-4405-a3b5-6140d1749245",
      "text": "Xin dẫn con đi theo đường chân lý của Ngài",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:59.150Z",
      "updatedAt": "2025-09-03T02:26:59.150Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "e99f7612-be03-498b-aac5-0a3e880da32e",
      "text": "và bảo ban dạy dỗ,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:59.179Z",
      "updatedAt": "2025-09-03T02:26:59.179Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "da42d7c2-411e-423a-937d-9678aa8d80dd",
      "text": "vì chính Ngài là Thiên Chúa cứu độ con.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:59.193Z",
      "updatedAt": "2025-09-03T02:26:59.193Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "d8bd6672-8717-47b6-bd71-ebdac9813aed",
      "text": "Sớm hôm con những cậy trông Ngài, bởi vì Ngài nhân ái.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 3,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:59.207Z",
      "updatedAt": "2025-09-03T02:26:59.207Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "ebf17f01-bea7-4a69-b5e6-42ffe81701fd",
      "text": "Da-in",
      "label": "5",
      "number": 5,
      "subVerseIndex": 4,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:26:59.223Z",
      "updatedAt": "2025-09-03T02:26:59.223Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "0d3939ff-3a34-4ad4-954d-333b6d898b30",
      "text": "Lạy CHÚA, xin nhớ lại nghĩa nặng với ân sâu",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:59.236Z",
      "updatedAt": "2025-09-03T02:26:59.236Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "99f87378-230f-4ea3-a481-d9293d8bc49c",
      "text": "Ngài đã từng biểu lộ từ muôn thuở muôn đời.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:59.250Z",
      "updatedAt": "2025-09-03T02:26:59.250Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "f63272d7-0153-4e03-b974-05a80f368dc4",
      "text": "Khết",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:26:59.261Z",
      "updatedAt": "2025-09-03T02:26:59.261Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "66a03181-d6c6-48ee-9d65-3340a6b65369",
      "text": "Tuổi xuân trót dại bao lầm lỗi, xin Ngài đừng nhớ đến,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:59.272Z",
      "updatedAt": "2025-09-03T02:26:59.272Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "c9a3f8d2-63f7-4366-8a32-934483e4b7a6",
      "text": "nhưng xin lấy tình thương mà nhớ đến con cùng.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:59.283Z",
      "updatedAt": "2025-09-03T02:26:59.283Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "fd82f24e-5dbf-4d02-b409-4f86b6268012",
      "text": "Tết",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:26:59.295Z",
      "updatedAt": "2025-09-03T02:26:59.295Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "1e3dbd8b-1d85-4930-ad75-7f12a86b0f82",
      "text": "CHÚA là Đấng nhân từ chính trực, chỉ lối cho tội nhân,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:59.308Z",
      "updatedAt": "2025-09-03T02:26:59.308Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "34570bc7-05f9-4fb4-8463-017ec4c6a88e",
      "text": "Giốt",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:26:59.322Z",
      "updatedAt": "2025-09-03T02:26:59.322Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "7ae1fbe8-097e-4e91-96ba-6939a2b03f53",
      "text": "dẫn kẻ nghèo hèn đi theo đường công chính,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:59.336Z",
      "updatedAt": "2025-09-03T02:26:59.336Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "76cddd08-80e7-416d-904a-354aac86f662",
      "text": "dạy cho biết đường lối của Người.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:59.351Z",
      "updatedAt": "2025-09-03T02:26:59.351Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "06eb5e0d-8003-4da0-b3b9-1397f3a6dcb0",
      "text": "Cáp",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:26:59.365Z",
      "updatedAt": "2025-09-03T02:26:59.365Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "d353ff02-ca3a-45cc-a917-1645baffead0",
      "text": "Tất cả đường lối CHÚA đều là yêu thương và thành tín",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:59.379Z",
      "updatedAt": "2025-09-03T02:26:59.379Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "90609c33-4e3c-4b8a-8b4e-c69a4fbedf7a",
      "text": "đối với những kẻ nào giữ giao ước và lề luật Chúa.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:59.393Z",
      "updatedAt": "2025-09-03T02:26:59.393Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "889c7724-ecec-494b-9246-fb4b416f4cef",
      "text": "La-mét",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:26:59.407Z",
      "updatedAt": "2025-09-03T02:26:59.407Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "215b0599-a536-4913-b410-d764cd0dba62",
      "text": "Lạy CHÚA, tội con thật nặng nề,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:59.421Z",
      "updatedAt": "2025-09-03T02:26:59.421Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "77778987-6a5f-4f80-a354-c7b2ba307998",
      "text": "vì danh Ngài, xin lượng thứ cho con.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:59.435Z",
      "updatedAt": "2025-09-03T02:26:59.435Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "54708554-e30f-4363-8e82-df859ff4f5b3",
      "text": "Mêm",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:26:59.449Z",
      "updatedAt": "2025-09-03T02:26:59.449Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "63dd4538-a509-4740-9133-b8c72a481fe7",
      "text": "Phàm ai kính sợ CHÚA,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:59.464Z",
      "updatedAt": "2025-09-03T02:26:59.464Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "a87e3525-9082-4246-9ea7-c7b4f94a488c",
      "text": "Người chỉ cho thấy đường phải chọn.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:59.478Z",
      "updatedAt": "2025-09-03T02:26:59.478Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "74c7efec-d3c9-4d00-b426-d9d8b9b8f1de",
      "text": "Nun",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:26:59.492Z",
      "updatedAt": "2025-09-03T02:26:59.492Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "31e46b04-aa63-4de4-9120-a9d0d8a15a45",
      "text": "Họ sẽ được an vui hạnh phúc một đời,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:59.520Z",
      "updatedAt": "2025-09-03T02:26:59.520Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "8f996199-d5aa-498b-b9fe-7abe5b546065",
      "text": "và con cháu thừa hưởng đất tổ tiên.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:59.534Z",
      "updatedAt": "2025-09-03T02:26:59.534Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "0c48ae56-af2d-462d-aafc-f4eee7dc16a5",
      "text": "Xa-méc",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:26:59.564Z",
      "updatedAt": "2025-09-03T02:26:59.564Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "a1cdd47b-a04e-4317-9da3-b929b998662d",
      "text": "CHÚA xử thân tình với những ai kính sợ Chúa",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:59.578Z",
      "updatedAt": "2025-09-03T02:26:59.578Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "2212f048-6d73-411a-b191-a60a751fe1fc",
      "text": "và cho họ biết giao ước của Người.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:59.592Z",
      "updatedAt": "2025-09-03T02:26:59.592Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "f56d2927-4a5d-4334-a94d-b56f6d34b9dc",
      "text": "A-in",
      "label": "14",
      "number": 14,
      "subVerseIndex": 2,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:26:59.606Z",
      "updatedAt": "2025-09-03T02:26:59.606Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "6fe5da1d-3f4a-4c4a-b6cb-4fe1fc02669b",
      "text": "Mắt tôi nhìn CHÚA không biết mỏi",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:59.620Z",
      "updatedAt": "2025-09-03T02:26:59.620Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "99f2c0d5-75bb-434b-acce-de61ac1d79de",
      "text": "vì chính Người sẽ gỡ chân tôi khỏi dò lưới.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:59.634Z",
      "updatedAt": "2025-09-03T02:26:59.634Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "bc80a5dc-5911-4d5f-85a9-e69472068cdc",
      "text": "Pê",
      "label": "15",
      "number": 15,
      "subVerseIndex": 2,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:26:59.648Z",
      "updatedAt": "2025-09-03T02:26:59.648Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "af295953-8ef7-43db-93fb-8d74c52058f2",
      "text": "Lạy Chúa, xin đoái nhìn và xót thương con,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:59.664Z",
      "updatedAt": "2025-09-03T02:26:59.664Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "b4c7055f-6c34-40b3-b372-a8cfd9596ed7",
      "text": "vì thân này bơ vơ khổ cực.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:59.678Z",
      "updatedAt": "2025-09-03T02:26:59.678Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "62d59700-831d-4da9-9511-cf9f9756aaf8",
      "text": "Xa-đê",
      "label": "16",
      "number": 16,
      "subVerseIndex": 2,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:26:59.692Z",
      "updatedAt": "2025-09-03T02:26:59.692Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "bcb8ee08-1386-44dd-943e-a7a24e0c835e",
      "text": "Lòng đau như thắt, xin làm cho thanh thoả,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:59.706Z",
      "updatedAt": "2025-09-03T02:26:59.706Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "d4a236f1-9168-4af9-95fd-a4fc75787fd6",
      "text": "và giải thoát con khỏi bước ngặt nghèo.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:59.720Z",
      "updatedAt": "2025-09-03T02:26:59.720Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "9c1b9edb-0cdc-4904-adc1-2ae5b7cd1118",
      "text": "Xin Chúa thấy cho cảnh lầm than khổ cực",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:59.733Z",
      "updatedAt": "2025-09-03T02:26:59.733Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "433a660d-7958-42d7-9cae-ad55d5080109",
      "text": "và tha thứ hết mọi tội con.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:59.768Z",
      "updatedAt": "2025-09-03T02:26:59.768Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "549ee798-8b5e-48cc-8322-2632eff83ad5",
      "text": "Rết",
      "label": "18",
      "number": 18,
      "subVerseIndex": 2,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:26:59.782Z",
      "updatedAt": "2025-09-03T02:26:59.782Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "8bef9ab1-4763-48d0-a622-bef414c5f1e3",
      "text": "Xin Chúa thấy cho : thù địch con đông vô kể,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:59.797Z",
      "updatedAt": "2025-09-03T02:26:59.797Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "96664641-866b-477b-ab14-98327e74f52f",
      "text": "chúng ghét thân này, ghét cay ghét đắng.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:59.824Z",
      "updatedAt": "2025-09-03T02:26:59.824Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "1eea5d12-6aff-4268-9800-c4da4f7e5106",
      "text": "Sin",
      "label": "19",
      "number": 19,
      "subVerseIndex": 2,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:26:59.838Z",
      "updatedAt": "2025-09-03T02:26:59.838Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "e5e8dc96-894c-4486-af02-de4a7ace035d",
      "text": "Xin bảo toàn sinh mạng và giải thoát con,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 61,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:59.852Z",
      "updatedAt": "2025-09-03T02:26:59.852Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "3ea579fb-943e-4f67-892d-6df75b7f5a9a",
      "text": "đừng để con tủi nhục, bởi vì con ẩn náu bên Ngài.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 62,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:59.880Z",
      "updatedAt": "2025-09-03T02:26:59.880Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "95e70d21-514a-4ee6-a920-47b3d6bc87cc",
      "text": "Tau",
      "label": "20",
      "number": 20,
      "subVerseIndex": 2,
      "paragraphNumber": 63,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:26:59.894Z",
      "updatedAt": "2025-09-03T02:26:59.894Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "11f5834e-25a6-46e9-b991-411c92908e86",
      "text": "Ước gì lòng trong sạch và ngay thẳng",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 64,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:59.908Z",
      "updatedAt": "2025-09-03T02:26:59.908Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "2760e2a0-2ae1-4847-9cdb-15d3189bfaaf",
      "text": "che chở giữ gìn con, vì con trông cậy Chúa.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 65,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:59.923Z",
      "updatedAt": "2025-09-03T02:26:59.923Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "109578a3-38fc-44ed-b7bc-8e03634f8d56",
      "text": "Lạy Thiên Chúa, xin Ngài cứu Ít-ra-en",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 66,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:59.937Z",
      "updatedAt": "2025-09-03T02:26:59.937Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "64296068-adf5-42a5-95ca-55449291757c",
      "text": "thoát mọi nỗi truân chuyên ngặt nghèo.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 67,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:26:59.962Z",
      "updatedAt": "2025-09-03T02:26:59.962Z",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    }
  ],
