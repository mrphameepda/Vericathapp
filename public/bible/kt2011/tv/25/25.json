    {
      "id": "f1f65b00-6157-424c-89af-d5015e6c4cd6",
      "content": "English: Nun | French: Noun | Latin: Nun | Origin: &#1504;&#64331;&#1503; | Vietnamese: Nun -- 1 Sb 7,27",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "6",
      "sortOrder": 5,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:26:59.506Z",
      "updatedAt": "2025-09-03T02:26:59.506Z",
      "targetId": "74c7efec-d3c9-4d00-b426-d9d8b9b8f1de",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "d2af1d0e-3fbf-4d51-a893-c13a33216477",
      "content": "C.13 diễn tả xác tín về phần thưởng ban cho người công chính (quan niệm thuộc trào lưu khôn ngoan trong Ít-ra-en). Câu này cũng cho thấy : những người trở về sau cuộc lưu đày hy vọng sẽ được hưởng đất tổ tiên phì nhiêu phong phú.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "7",
      "sortOrder": 6,
      "startOffset": 34,
      "endOffset": 34,
      "createdAt": "2025-09-03T02:26:59.549Z",
      "updatedAt": "2025-09-03T02:26:59.549Z",
      "targetId": "8f996199-d5aa-498b-b9fe-7abe5b546065",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "439829ac-3169-4c0e-a70a-f02690b420f7"
    },
    {
      "id": "3856a5f6-092f-4e57-be4d-80ac8eb7301e",
      "content": "English: Sin | French: Sin | Latin: Sin | Origin: &#1505;&#1460;&#1497;&#1503; | Vietnamese: Xin 1 -- sa mạc trong cuộc Xuất hành, Xh 16,1 ; Ds 33,11-12",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "8",
