{
  "chapter": {
    "id": "0dd84bea-72e9-4d05-b226-39d55557d514",
    "number": 26,
    "createdAt": "2025-09-03T01:07:51.660Z",
    "updatedAt": "2025-09-03T01:07:51.660Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "bac055c2-276b-4cc8-910a-3bc99eaca78b",
      "text": "*Của vua Đa-vít.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:27:05.012Z",
      "updatedAt": "2025-09-03T02:27:05.012Z",
      "chapterId": "0dd84bea-72e9-4d05-b226-39d55557d514"
    },
    {
      "id": "8e8abfe4-a570-4488-bae9-cb47de643b86",
      "text": "Lạy CHÚA, xin Ngài xử cho con, vì con sống vẹn toàn.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:05.066Z",
      "updatedAt": "2025-09-03T02:27:05.066Z",
      "chapterId": "0dd84bea-72e9-4d05-b226-39d55557d514"
    },
    {
      "id": "37b9c561-8a42-4fbb-973b-d8519b36f799",
      "text": "Con tin tưởng vào CHÚA, không do dự.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:05.078Z",
      "updatedAt": "2025-09-03T02:27:05.078Z",
      "chapterId": "0dd84bea-72e9-4d05-b226-39d55557d514"
    },
    {
      "id": "fe3ce7e9-5758-4c82-9241-e8d4ab1f23d0",
      "text": "Lạy CHÚA, xin dò xét và thử thách con,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:05.090Z",
      "updatedAt": "2025-09-03T02:27:05.090Z",
      "chapterId": "0dd84bea-72e9-4d05-b226-39d55557d514"
    },
    {
      "id": "27cfa0de-f4a1-4e11-b65a-7dc94b9a3ceb",
      "text": "tâm can này, xin đem thử lửa.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:05.104Z",
      "updatedAt": "2025-09-03T02:27:05.104Z",
      "chapterId": "0dd84bea-72e9-4d05-b226-39d55557d514"
    },
    {
      "id": "efee887a-fd15-454d-95d1-75e4190b8587",
      "text": "Vâng, con hằng nghĩ tới tình thương của Chúa",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:05.119Z",
      "updatedAt": "2025-09-03T02:27:05.119Z",
      "chapterId": "0dd84bea-72e9-4d05-b226-39d55557d514"
    },
    {
      "id": "14088871-6bac-4f34-b6fc-0dda1c052622",
      "text": "và sống theo chân lý của Ngài.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:05.139Z",
      "updatedAt": "2025-09-03T02:27:05.139Z",
      "chapterId": "0dd84bea-72e9-4d05-b226-39d55557d514"
    },
    {
      "id": "7e5f8aad-4330-4d6b-b3ba-a816eb606b9a",
      "text": "Con không ngồi chung với quân xảo trá,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:05.153Z",
      "updatedAt": "2025-09-03T02:27:05.153Z",
      "chapterId": "0dd84bea-72e9-4d05-b226-39d55557d514"
    },
    {
      "id": "b4d09791-7015-45d3-8abb-54275a8160d4",
      "text": "chẳng giao du cùng bọn giả hình,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:05.168Z",
      "updatedAt": "2025-09-03T02:27:05.168Z",
      "chapterId": "0dd84bea-72e9-4d05-b226-39d55557d514"
    },
    {
      "id": "7b8a983f-6216-4a44-8ff0-b94f282a1ab0",
      "text": "hằng gớm ghét bè lũ vô lương,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:05.182Z",
      "updatedAt": "2025-09-03T02:27:05.182Z",
      "chapterId": "0dd84bea-72e9-4d05-b226-39d55557d514"
    },
    {
      "id": "08927aa0-b161-48e4-9880-e2706b5a7647",
      "text": "không ngồi chung với phường gian ác.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:05.197Z",
      "updatedAt": "2025-09-03T02:27:05.197Z",
      "chapterId": "0dd84bea-72e9-4d05-b226-39d55557d514"
    },
    {
      "id": "45597681-858b-41a9-bea7-ab130aeb75f3",
      "text": "Lạy CHÚA, con rửa tay nói lên lòng vô tội",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:05.211Z",
      "updatedAt": "2025-09-03T02:27:05.211Z",
      "chapterId": "0dd84bea-72e9-4d05-b226-39d55557d514"
    },
    {
      "id": "f7df8953-6a71-4ab2-ad35-199cc2f576b3",
      "text": "và đi vòng quanh bàn thờ Chúa,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:05.226Z",
      "updatedAt": "2025-09-03T02:27:05.226Z",
      "chapterId": "0dd84bea-72e9-4d05-b226-39d55557d514"
    },
    {
      "id": "4572ffdb-a161-4032-968e-516bcdb4b5b4",
      "text": "để hát bài cảm tạ tri ân",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:05.258Z",
      "updatedAt": "2025-09-03T02:27:05.258Z",
      "chapterId": "0dd84bea-72e9-4d05-b226-39d55557d514"
    },
    {
      "id": "a88616be-9966-49fb-9379-70756cd486e4",
      "text": "và tường thuật mọi kỳ công của Ngài.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:05.272Z",
      "updatedAt": "2025-09-03T02:27:05.272Z",
      "chapterId": "0dd84bea-72e9-4d05-b226-39d55557d514"
    },
    {
      "id": "2d9c55c3-7a8a-4652-a047-f6638042cdc2",
      "text": "Lạy CHÚA, con mến yêu ngôi nhà Chúa ngự,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:05.286Z",
      "updatedAt": "2025-09-03T02:27:05.286Z",
      "chapterId": "0dd84bea-72e9-4d05-b226-39d55557d514"
    },
    {
      "id": "33f00552-cb1b-4ded-85d7-d358b9cc4529",
      "text": "mến yêu nơi rạng ngời vinh quang Chúa.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:05.300Z",
      "updatedAt": "2025-09-03T02:27:05.300Z",
      "chapterId": "0dd84bea-72e9-4d05-b226-39d55557d514"
    },
    {
      "id": "c1013442-706e-4187-baea-9e36faf666a6",
      "text": "Xin đừng bắt con đồng số kiếp với tội nhân,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:05.315Z",
      "updatedAt": "2025-09-03T02:27:05.315Z",
      "chapterId": "0dd84bea-72e9-4d05-b226-39d55557d514"
    },
    {
      "id": "ebbd7e7c-3f8a-4906-bcfa-d0260e048686",
      "text": "chung vận mệnh với phường khát máu.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:05.344Z",
      "updatedAt": "2025-09-03T02:27:05.344Z",
      "chapterId": "0dd84bea-72e9-4d05-b226-39d55557d514"
    },
    {
      "id": "75940148-f11e-43dd-b69f-ca6aade8957e",
      "text": "Tay chúng gây tội ác tày trời,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:05.357Z",
      "updatedAt": "2025-09-03T02:27:05.357Z",
      "chapterId": "0dd84bea-72e9-4d05-b226-39d55557d514"
    },
    {
      "id": "7c8d4041-394b-4b3f-be3a-b80ba2855680",
      "text": "riêng tay mặt đầy quà hối lộ.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:05.371Z",
      "updatedAt": "2025-09-03T02:27:05.371Z",
      "chapterId": "0dd84bea-72e9-4d05-b226-39d55557d514"
    },
    {
      "id": "0be5d2d1-ce33-45a9-a8de-c3a72afbbebb",
      "text": "Phần con đây, con sống vẹn toàn,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:05.386Z",
      "updatedAt": "2025-09-03T02:27:05.386Z",
      "chapterId": "0dd84bea-72e9-4d05-b226-39d55557d514"
    },
    {
      "id": "62dbc2c0-ab73-49a4-a0e5-1e438bab7677",
      "text": "xin giải thoát và xót thương con, lạy Chúa,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:05.400Z",
      "updatedAt": "2025-09-03T02:27:05.400Z",
      "chapterId": "0dd84bea-72e9-4d05-b226-39d55557d514"
    },
    {
      "id": "5390c9cd-898a-46b7-a8c6-f52035fbc260",
      "text": "trên mặt đất bằng, chân con đứng vững,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:05.415Z",
      "updatedAt": "2025-09-03T02:27:05.415Z",
      "chapterId": "0dd84bea-72e9-4d05-b226-39d55557d514"
    },
    {
      "id": "55622d39-c232-42b3-8a02-308236f15d1f",
      "text": "giữa lòng đại hội, con xin chúc tụng Ngài.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:05.432Z",
      "updatedAt": "2025-09-03T02:27:05.432Z",
      "chapterId": "0dd84bea-72e9-4d05-b226-39d55557d514"
    }
  ],
  "marks": [
    {
      "id": "81fc8d44-ae03-480f-8e9b-919f88a3f86a",
      "content": "Đây là *một ai ca của cá nhân*. Cấu trúc của ai ca này là một kiểu đối ngẫu tréo (chiasme) : **1**) Cc. 1-3 (A) ; **2**) Cc. 4-5 (B) ; **3**) Cc. 6-8 (C) ; **4**) Cc. 9-10 (B’) ; **5**) Cc. 11-12 (A’). Cc. 6-8 hợp thành phần giữa ; A đối chiếu với A’ (x. 1b và 11a), B đối chiếu với B’.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 44,
      "endOffset": 44,
      "createdAt": "2025-09-03T02:27:05.043Z",
      "updatedAt": "2025-09-03T02:27:05.043Z",
      "targetId": "91eb30aa-622a-4f9b-b8c2-12f50ca5fa1c",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "0dd84bea-72e9-4d05-b226-39d55557d514"
    },
    {
      "id": "9c350f7a-bc90-4a72-917f-bb1c70955e44",
      "content": "English: David | French: David | Latin: David | Origin: &#1491;&#1464;&#1493;&#1460;&#1491; | Vietnamese: Đa-vít -- 1 Sm 16,21-22",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 15,
      "endOffset": 15,
      "createdAt": "2025-09-03T02:27:05.054Z",
      "updatedAt": "2025-09-03T02:27:05.054Z",
      "targetId": "bac055c2-276b-4cc8-910a-3bc99eaca78b",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "0dd84bea-72e9-4d05-b226-39d55557d514"
    },
    {
      "id": "0d7e4e80-e8bf-4904-8176-cf816453471b",
      "content": "Cử chỉ *rửa tay* (c.6a) là dấu diễn tả tình trạng vô tội của tác giả. Tình trạng này khác hẳn với tình trạng và cách sống của tội nhân nói trong c.10 (*tay gây tội ác tầy trời, tay mặt đầy quà hối lộ*). Lề Luật cấm nhận quà hối lộ : Xh 23,8 ; Đnl 16,19 ; 27,25). Thành ngữ *đi vòng quanh bàn thờ* ám chỉ cuộc kiệu đi vòng quanh bàn thờ của Thiên Chúa tại Đền Thờ Giê-ru-sa-lem.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 29,
      "endOffset": 29,
      "createdAt": "2025-09-03T02:27:05.240Z",
      "updatedAt": "2025-09-03T02:27:05.240Z",
      "targetId": "f7df8953-6a71-4ab2-ad35-199cc2f576b3",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "0dd84bea-72e9-4d05-b226-39d55557d514"
    },
    {
      "id": "5ceae01a-2b4e-435c-a156-77825288a644",
      "content": "English: Sin | French: Sin | Latin: Sin | Origin: &#1505;&#1460;&#1497;&#1503; | Vietnamese: Xin 1 -- sa mạc trong cuộc Xuất hành, Xh 16,1 ; Ds 33,11-12",
      "kind": "MARK_KIND_FOOTNOTE",
