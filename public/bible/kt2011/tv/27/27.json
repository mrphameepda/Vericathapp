{
  "chapter": {
    "id": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7",
    "number": 27,
    "createdAt": "2025-09-03T01:07:51.660Z",
    "updatedAt": "2025-09-03T01:07:51.660Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "8dc9c2de-af7f-49f5-8913-2af196169b36",
      "text": "*Của vua Đa-vít.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:27:10.690Z",
      "updatedAt": "2025-09-03T02:27:10.690Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    },
    {
      "id": "2f1db24d-bf59-4e01-8871-a674c094ea95",
      "text": "CHÚA là nguồn ánh sáng và ơn cứu độ của tôi,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:10.755Z",
      "updatedAt": "2025-09-03T02:27:10.755Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    },
    {
      "id": "45214f80-8b92-4e17-87a7-eed75c17c264",
      "text": "tôi còn sợ người nào ?",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:10.768Z",
      "updatedAt": "2025-09-03T02:27:10.768Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    },
    {
      "id": "e6a29c9e-6631-4a90-b091-d922cf47615a",
      "text": "CHÚA là thành luỹ bảo vệ đời tôi,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 3,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:10.782Z",
      "updatedAt": "2025-09-03T02:27:10.782Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    },
    {
      "id": "3ad81ca2-405a-4341-954e-77688dc0ccfc",
      "text": "tôi khiếp gì ai nữa ?",
      "label": "1",
      "number": 1,
      "subVerseIndex": 4,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:10.795Z",
      "updatedAt": "2025-09-03T02:27:10.795Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    },
    {
      "id": "f9e822a9-df97-4605-907b-edb7e1a01d31",
      "text": "Khi ác nhân xông vào, định nuốt sống thân tôi,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:10.809Z",
      "updatedAt": "2025-09-03T02:27:10.809Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    },
    {
      "id": "13876af8-152f-40ea-b065-a14bcd6d061f",
      "text": "ai ngờ chính đối phương, chính những thù địch ấy,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:10.824Z",
      "updatedAt": "2025-09-03T02:27:10.824Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    },
    {
      "id": "bbc8f5ae-f28f-4495-8f75-5d0f60074577",
      "text": "lại lảo đảo té nhào.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:10.838Z",
      "updatedAt": "2025-09-03T02:27:10.838Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    },
    {
      "id": "935fed42-0a24-449f-a3c9-aa85bc1f4a96",
      "text": "Dù cả một đạo quân vây đánh, lòng tôi chẳng sợ gì.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:10.852Z",
      "updatedAt": "2025-09-03T02:27:10.852Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    },
    {
      "id": "3e6f1613-757f-4a8c-8bae-71431f01034a",
      "text": "Dù có phải lâm vào chiến trận, tôi vẫn cứ cậy tin.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:10.867Z",
      "updatedAt": "2025-09-03T02:27:10.867Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    },
    {
      "id": "187ad398-710b-4eac-8fe6-0209549c5950",
      "text": "Một điều tôi kiếm tôi xin,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:10.880Z",
      "updatedAt": "2025-09-03T02:27:10.880Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    },
    {
      "id": "56e82e61-3174-4e7d-bc3f-4c2fd5006de8",
      "text": "là luôn được ở trong đền CHÚA tôi",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:10.894Z",
      "updatedAt": "2025-09-03T02:27:10.894Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    },
    {
      "id": "7b9805d9-05f9-4cdf-b118-98348b064b7d",
      "text": "mọi ngày trong suốt cuộc đời,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:10.909Z",
      "updatedAt": "2025-09-03T02:27:10.909Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    },
    {
      "id": "91ccac66-d87d-4899-b96e-02712e2f142a",
      "text": "để chiêm ngưỡng CHÚA tuyệt vời cao sang,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 3,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:10.923Z",
      "updatedAt": "2025-09-03T02:27:10.923Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    },
    {
      "id": "da81b23f-bc13-42b5-a3cb-489a60dd178b",
      "text": "ngắm xem thánh điện huy hoàng.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 4,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:10.938Z",
      "updatedAt": "2025-09-03T02:27:10.938Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    },
    {
      "id": "36c1f570-2bd7-49d9-9b50-2ef6a4aa0556",
      "text": "Ngày tôi gặp tai ương hoạn nạn,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:10.952Z",
      "updatedAt": "2025-09-03T02:27:10.952Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    },
    {
      "id": "487f6ebb-2035-4bb0-be17-c45618bc37e5",
      "text": "Người che chở tôi trong lều thánh,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:10.966Z",
      "updatedAt": "2025-09-03T02:27:10.966Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    },
    {
      "id": "18a53268-3110-4a54-aa85-5d8067365d71",
      "text": "đem giấu tôi thật kín trong nhà,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:10.980Z",
      "updatedAt": "2025-09-03T02:27:10.980Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    },
    {
      "id": "a13cc0c7-3da8-4b78-b7c9-716ddd0a67d8",
      "text": "đặt an toàn trên tảng đá cao.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 3,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:10.995Z",
      "updatedAt": "2025-09-03T02:27:10.995Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    },
    {
      "id": "43fb9ff5-22f7-4534-97cc-f0c9098a817f",
      "text": "Nên giờ đây tôi ngẩng đầu đắc ý,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:11.024Z",
      "updatedAt": "2025-09-03T02:27:11.024Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    },
    {
      "id": "b8c42393-50e4-48ae-9d0a-7cf1d004b7f6",
      "text": "nhìn quân thù vây bủa chung quanh.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:11.038Z",
      "updatedAt": "2025-09-03T02:27:11.038Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    },
    {
      "id": "88a4f460-0cbc-424a-862e-17e6cd7a88a5",
      "text": "Tôi sẽ dâng lễ tế trong thánh điện,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:11.052Z",
      "updatedAt": "2025-09-03T02:27:11.052Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    },
    {
      "id": "22ad74f1-5a70-48c4-9c2e-4007d49bee94",
      "text": "lễ tạ ơn, nhã nhạc vang lừng,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 3,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:11.066Z",
      "updatedAt": "2025-09-03T02:27:11.066Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    },
    {
      "id": "c93b4561-33c2-421e-a045-d24c553cc87a",
      "text": "tôi sẽ đàn ca mừng kính CHÚA.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 4,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:11.094Z",
      "updatedAt": "2025-09-03T02:27:11.094Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    },
    {
      "id": "820355b5-5ae0-4ec8-9bcd-7045f8adf8c8",
      "text": "Lạy CHÚA, cúi xin Ngài nghe tiếng con kêu,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:11.109Z",
      "updatedAt": "2025-09-03T02:27:11.109Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    },
    {
      "id": "340697f3-b3f7-4ace-a339-29b1bd2d214e",
      "text": "xin thương tình đáp lại.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:11.123Z",
      "updatedAt": "2025-09-03T02:27:11.123Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    },
    {
      "id": "bf844a49-e3f8-485b-9679-06ca02eed053",
      "text": "Nghĩ về Ngài, lòng con tự nhủ : hãy tìm kiếm Thánh Nhan.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:11.139Z",
      "updatedAt": "2025-09-03T02:27:11.139Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    },
    {
      "id": "03d2b050-3953-47f0-817e-fc4d5d8d74b9",
      "text": "Lạy CHÚA, con tìm thánh nhan Ngài,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:11.156Z",
      "updatedAt": "2025-09-03T02:27:11.156Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    },
    {
      "id": "9a71b83d-b8c6-43c2-8ca2-0bb3f5c8803d",
      "text": "xin Ngài đừng ẩn mặt.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:11.170Z",
      "updatedAt": "2025-09-03T02:27:11.170Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    },
    {
      "id": "18657627-7faf-4196-8ad8-41dddc04c34e",
      "text": "Tôi tớ Ngài đây, xin đừng giận mà ruồng rẫy,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:11.184Z",
      "updatedAt": "2025-09-03T02:27:11.184Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    },
    {
      "id": "9ea8aa77-2a80-417c-804d-4ab415757af7",
      "text": "chính Ngài là Đấng phù trợ con.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:11.198Z",
      "updatedAt": "2025-09-03T02:27:11.198Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    },
    {
      "id": "8ce5fe95-a863-4c32-a960-a3535f82c3f3",
      "text": "Xin chớ bỏ rơi, xin đừng xua đuổi,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 3,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:11.212Z",
      "updatedAt": "2025-09-03T02:27:11.212Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    },
    {
      "id": "cbe75eed-b076-4e73-96f8-3f6b8ab61c11",
      "text": "lạy Thiên Chúa, Đấng cứu độ con.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 4,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:11.242Z",
      "updatedAt": "2025-09-03T02:27:11.242Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    },
    {
      "id": "58692f73-5943-4022-8323-1af0f61f173c",
      "text": "Dầu cha mẹ có bỏ con đi nữa,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:11.256Z",
      "updatedAt": "2025-09-03T02:27:11.256Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    },
    {
      "id": "21f6388f-a5ca-4d3c-89cb-5010c43d4671",
      "text": "thì hãy còn có CHÚA đón nhận con.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:11.270Z",
      "updatedAt": "2025-09-03T02:27:11.270Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    },
    {
      "id": "a4ade28f-72e0-4d4e-921b-7b67fd2aa548",
      "text": "Xin dạy con đường nẻo Ngài, lạy CHÚA,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:11.284Z",
      "updatedAt": "2025-09-03T02:27:11.284Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    },
    {
      "id": "d67935c6-a9c7-4d78-a1c7-3f6c9ebbaa91",
      "text": "dẫn con đi trên lối phẳng phiu,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:11.313Z",
      "updatedAt": "2025-09-03T02:27:11.313Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    },
    {
      "id": "2d7ef199-ea54-4fe5-abe1-4cc1d438283d",
      "text": "vì có những người đang rình rập.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:11.328Z",
      "updatedAt": "2025-09-03T02:27:11.328Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    },
    {
      "id": "49247ffc-c54f-46a1-8594-ce3ccff1ac16",
      "text": "Xin đừng phó mặc con cho kẻ thù hung hãn,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:11.341Z",
      "updatedAt": "2025-09-03T02:27:11.341Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    },
    {
      "id": "f6616001-54bc-4e10-8ec2-0e896fa908b4",
      "text": "vì lũ chứng gian đứng dậy tố con,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:11.371Z",
      "updatedAt": "2025-09-03T02:27:11.371Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    },
    {
      "id": "3b1fba83-610a-413f-8b7e-79eaeee448f1",
      "text": "giương bộ mặt hằm hằm sát khí.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:11.385Z",
      "updatedAt": "2025-09-03T02:27:11.385Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    },
    {
      "id": "184f0cc7-1557-4771-8260-d5fbee057177",
      "text": "Tôi vững vàng tin tưởng",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:11.403Z",
      "updatedAt": "2025-09-03T02:27:11.403Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    },
    {
      "id": "4d3fe356-6b1a-4dc8-bbd7-e60325db67d6",
      "text": "sẽ được thấy ân lộc CHÚA ban trong cõi đất dành cho kẻ sống.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:11.417Z",
      "updatedAt": "2025-09-03T02:27:11.417Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    },
    {
      "id": "ff9aa359-f5bf-4d87-9ad3-2a4c82aebd4a",
      "text": "Hãy cậy trông vào CHÚA, mạnh bạo lên, can đảm lên nào !",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:11.431Z",
      "updatedAt": "2025-09-03T02:27:11.431Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    },
    {
      "id": "c6e99d5c-d2b9-429b-90e7-047287881b5d",
      "text": "Hãy cậy trông vào CHÚA.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:11.445Z",
      "updatedAt": "2025-09-03T02:27:11.445Z",
      "chapterId": "bfe29bc2-3efe-49bc-bdfd-ef5069e0b6a7"
    }
  ],
