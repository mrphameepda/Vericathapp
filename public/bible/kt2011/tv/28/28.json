{
  "chapter": {
    "id": "d89f58d0-ebb1-4b0a-845d-47ed23eae209",
    "number": 28,
    "createdAt": "2025-09-03T01:07:51.660Z",
    "updatedAt": "2025-09-03T01:07:51.660Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "7c9f9048-15c9-419e-bf2e-8a3f6e4dd3bf",
      "text": "*Của vua Đa-vít.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:27:16.727Z",
      "updatedAt": "2025-09-03T02:27:16.727Z",
      "chapterId": "d89f58d0-ebb1-4b0a-845d-47ed23eae209"
    },
    {
      "id": "bade0e20-97a8-4f1f-a594-012d6db3d8c8",
      "text": "Lạy CHÚA là núi đá cho con trú ẩn,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:16.776Z",
      "updatedAt": "2025-09-03T02:27:16.776Z",
      "chapterId": "d89f58d0-ebb1-4b0a-845d-47ed23eae209"
    },
    {
      "id": "fe8a2409-1cf4-42df-96fc-f14dd1fba450",
      "text": "con kêu lên Ngài, xin đừng nỡ giả điếc làm ngơ.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:16.787Z",
      "updatedAt": "2025-09-03T02:27:16.787Z",
      "chapterId": "d89f58d0-ebb1-4b0a-845d-47ed23eae209"
    },
    {
      "id": "03e7bf81-a0df-42a1-8273-d8f56498372c",
      "text": "Vì nếu Ngài cứ im hơi lặng tiếng,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 3,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:16.798Z",
      "updatedAt": "2025-09-03T02:27:16.798Z",
      "chapterId": "d89f58d0-ebb1-4b0a-845d-47ed23eae209"
    },
    {
      "id": "db65f258-d46e-4c1d-a4f5-df19a0b70445",
      "text": "thì con sẽ giống như kẻ đã xuống mồ.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 4,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:16.810Z",
      "updatedAt": "2025-09-03T02:27:16.810Z",
      "chapterId": "d89f58d0-ebb1-4b0a-845d-47ed23eae209"
    },
    {
      "id": "1dd82141-722b-43a6-b866-7d620eb9108e",
      "text": "Khi con hướng về nơi cực thánh",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:16.823Z",
      "updatedAt": "2025-09-03T02:27:16.823Z",
      "chapterId": "d89f58d0-ebb1-4b0a-845d-47ed23eae209"
    },
    {
      "id": "da2eb4ea-cd8f-4d2a-baf4-19b7440b6d26",
      "text": "giơ đôi tay cầu cứu van nài,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:16.837Z",
      "updatedAt": "2025-09-03T02:27:16.837Z",
      "chapterId": "d89f58d0-ebb1-4b0a-845d-47ed23eae209"
    },
    {
      "id": "d9c1df6b-d620-4db4-bf2a-f236c966207c",
      "text": "xin Ngài nghe tiếng con khẩn nguyện.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:16.861Z",
      "updatedAt": "2025-09-03T02:27:16.861Z",
      "chapterId": "d89f58d0-ebb1-4b0a-845d-47ed23eae209"
    },
    {
      "id": "dd0f102c-98fa-4254-85d2-1eb3178ef03c",
      "text": "Xin Chúa đừng bắt con phải chết",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:16.888Z",
      "updatedAt": "2025-09-03T02:27:16.888Z",
      "chapterId": "d89f58d0-ebb1-4b0a-845d-47ed23eae209"
    },
    {
      "id": "a5cf5947-de68-4235-b362-c11cd72fdffc",
      "text": "cùng quân tội lỗi, với bọn ác nhân.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:16.917Z",
      "updatedAt": "2025-09-03T02:27:16.917Z",
      "chapterId": "d89f58d0-ebb1-4b0a-845d-47ed23eae209"
    },
    {
      "id": "5b2b6983-4175-461e-8644-028ce29c73fe",
      "text": "Miệng thì những nói bình an,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:16.933Z",
      "updatedAt": "2025-09-03T02:27:16.933Z",
      "chapterId": "d89f58d0-ebb1-4b0a-845d-47ed23eae209"
    },
    {
      "id": "b9ec6bf2-7f80-4e02-a66d-f92e54c8e659",
      "text": "mà lòng thâm độc chỉ toan hại người.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 3,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:16.948Z",
      "updatedAt": "2025-09-03T02:27:16.948Z",
      "chapterId": "d89f58d0-ebb1-4b0a-845d-47ed23eae209"
    },
    {
      "id": "781042be-6f0e-4ca1-bb1a-4dace7997b2c",
      "text": "Xin đối xử với chúng xứng với việc chúng làm,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:16.962Z",
      "updatedAt": "2025-09-03T02:27:16.962Z",
      "chapterId": "d89f58d0-ebb1-4b0a-845d-47ed23eae209"
    },
    {
      "id": "7d513896-c038-4b91-a562-f24a31b26f2a",
      "text": "xứng với những hành vi xấu xa của chúng.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:16.991Z",
      "updatedAt": "2025-09-03T02:27:16.991Z",
      "chapterId": "d89f58d0-ebb1-4b0a-845d-47ed23eae209"
    },
    {
      "id": "a289ff33-647c-4d2b-9b11-30fdf8ec6bbf",
      "text": "Xin đối xử với chúng xứng với những gì tay chúng làm ra,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:17.003Z",
      "updatedAt": "2025-09-03T02:27:17.003Z",
      "chapterId": "d89f58d0-ebb1-4b0a-845d-47ed23eae209"
    },
    {
      "id": "ef2c0eee-37e7-4de0-9484-29b8bc97423e",
      "text": "trả cho chúng như chúng đáng tội.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 3,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:17.026Z",
      "updatedAt": "2025-09-03T02:27:17.026Z",
      "chapterId": "d89f58d0-ebb1-4b0a-845d-47ed23eae209"
    },
    {
      "id": "7ed51be2-ed65-4e2d-af58-7d920c808a63",
      "text": "Vì chúng chẳng quan tâm đến việc CHÚA làm,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:17.037Z",
      "updatedAt": "2025-09-03T02:27:17.037Z",
      "chapterId": "d89f58d0-ebb1-4b0a-845d-47ed23eae209"
    },
    {
      "id": "e160a525-dbda-46db-a4ab-e29700785c21",
      "text": "và những công trình tay CHÚA thực hiện.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:17.048Z",
      "updatedAt": "2025-09-03T02:27:17.048Z",
      "chapterId": "d89f58d0-ebb1-4b0a-845d-47ed23eae209"
    },
    {
      "id": "f29fef97-79fe-4f11-920b-9dc077597939",
      "text": "Ước chi Người quật ngã chúng và không đỡ chúng lên.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:17.059Z",
      "updatedAt": "2025-09-03T02:27:17.059Z",
      "chapterId": "d89f58d0-ebb1-4b0a-845d-47ed23eae209"
    },
    {
      "id": "d7bd28db-e6c6-4d16-939b-071f361572c8",
      "text": "Chúc tụng CHÚA vì Người nghe tiếng tôi khẩn nguyện,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:17.072Z",
      "updatedAt": "2025-09-03T02:27:17.072Z",
      "chapterId": "d89f58d0-ebb1-4b0a-845d-47ed23eae209"
    },
    {
      "id": "65866066-ff8d-4851-b5cf-8c9f07e93211",
      "text": "CHÚA là sức mạnh, là khiên mộc chở che tôi,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:17.092Z",
      "updatedAt": "2025-09-03T02:27:17.092Z",
      "chapterId": "d89f58d0-ebb1-4b0a-845d-47ed23eae209"
    },
    {
      "id": "f15b61f1-1211-4b66-a054-b4ab11cb316e",
      "text": "lòng tôi đặt tin tưởng nơi Người.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:17.106Z",
      "updatedAt": "2025-09-03T02:27:17.106Z",
      "chapterId": "d89f58d0-ebb1-4b0a-845d-47ed23eae209"
    },
    {
      "id": "5627fe4d-fe3e-4e7e-8c51-26dc2de6b2dd",
      "text": "Tôi đã được Người thương trợ giúp,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:17.121Z",
      "updatedAt": "2025-09-03T02:27:17.121Z",
      "chapterId": "d89f58d0-ebb1-4b0a-845d-47ed23eae209"
    },
    {
      "id": "3f00766c-e4fa-4772-961f-b7bbf886f0f4",
      "text": "nên lòng tôi vui mừng hoan hỷ, cất cao tiếng hát tạ ơn Người.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 3,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:17.135Z",
      "updatedAt": "2025-09-03T02:27:17.135Z",
      "chapterId": "d89f58d0-ebb1-4b0a-845d-47ed23eae209"
    },
    {
      "id": "edac5d7c-c0b6-499e-b2f0-57280f0df4a4",
      "text": "CHÚA là sức mạnh cho dân Chúa, là thành trì cứu độ",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:17.149Z",
      "updatedAt": "2025-09-03T02:27:17.149Z",
      "chapterId": "d89f58d0-ebb1-4b0a-845d-47ed23eae209"
    },
    {
      "id": "54699c03-db86-4fc4-89b5-b2324139913e",
      "text": "cho đấng Người đã xức dầu tấn phong.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:17.163Z",
      "updatedAt": "2025-09-03T02:27:17.163Z",
      "chapterId": "d89f58d0-ebb1-4b0a-845d-47ed23eae209"
    },
    {
      "id": "fbb4edf7-1746-49f8-a424-3c83ec7eaedf",
      "text": "Lạy Chúa, xin cứu độ dân Ngài,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:17.178Z",
      "updatedAt": "2025-09-03T02:27:17.178Z",
      "chapterId": "d89f58d0-ebb1-4b0a-845d-47ed23eae209"
    },
    {
      "id": "75eaec22-682d-484a-9a45-f927531d9c41",
      "text": "trên gia nghiệp này, giáng muôn phúc cả,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:17.196Z",
      "updatedAt": "2025-09-03T02:27:17.196Z",
      "chapterId": "d89f58d0-ebb1-4b0a-845d-47ed23eae209"
    },
    {
      "id": "d57a750c-cb21-409f-bd85-6ba096f2590c",
      "text": "dẫn dắt nâng niu đến muôn đời.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:17.210Z",
      "updatedAt": "2025-09-03T02:27:17.210Z",
      "chapterId": "d89f58d0-ebb1-4b0a-845d-47ed23eae209"
    }
  ],
