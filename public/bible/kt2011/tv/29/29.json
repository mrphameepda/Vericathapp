    },
    {
      "id": "11e96a2e-f003-4a14-997d-b5e4be4f5b31",
      "content": "G 37,2-5",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:27:22.951Z",
      "updatedAt": "2025-09-03T02:27:22.951Z",
      "targetId": "3e597d08-3d38-4d0e-a706-1e50b3292690",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "0cfde249-bfad-4ced-8ab3-a365fd552536"
    },
    {
      "id": "1af939c9-e3f3-4b76-b2a1-726cd998ef27",
      "content": "Thiên Chúa có quyền tối thượng trên triều đình thiên quốc (cc. 1-2). Không gì và không ai có thể đương đầu với sức mạnh tuyệt đối đó : sấm sét nổ rền vang ; phong ba bão táp đánh gãy cây cối lớn mạnh nhất (*ngàn hương bá Li-băng* : c.5 ; *rặng sồi*, *cây cao rừng rậm* : c.9ab), làm rung rinh *dãy Li-băng*, *đỉnh Xia-giôn* (= núi Khéc-môn : x. Đnl 3,9). Cây cối lớn mạnh tượng trưng cho các đối thủ của Thiên Chúa.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 10,
      "endOffset": 10,
      "createdAt": "2025-09-03T02:27:22.895Z",
      "updatedAt": "2025-09-03T02:27:22.895Z",
      "targetId": "bd601087-3d4f-4e19-aa4f-a802365057bd",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "0cfde249-bfad-4ced-8ab3-a365fd552536"
    },
