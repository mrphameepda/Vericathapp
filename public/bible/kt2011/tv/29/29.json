{
  "chapter": {
    "id": "0cfde249-bfad-4ced-8ab3-a365fd552536",
    "number": 29,
    "createdAt": "2025-09-03T01:07:51.660Z",
    "updatedAt": "2025-09-03T01:07:51.660Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "87882235-77cc-43bf-aa44-362228699c02",
      "text": "*Thánh vịnh. Của vua Đa-vít.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:27:22.757Z",
      "updatedAt": "2025-09-03T02:27:22.757Z",
      "chapterId": "0cfde249-bfad-4ced-8ab3-a365fd552536"
    },
    {
      "id": "8425a382-7326-4369-9c65-9a463b571ce9",
      "text": "Hãy dâng CHÚA, hỡi chư thần chư thánh,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:22.810Z",
      "updatedAt": "2025-09-03T02:27:22.810Z",
      "chapterId": "0cfde249-bfad-4ced-8ab3-a365fd552536"
    },
    {
      "id": "9568efbe-457f-41a9-aedd-c6a0d23352b1",
      "text": "dâng CHÚA quyền lực và vinh quang.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:22.822Z",
      "updatedAt": "2025-09-03T02:27:22.822Z",
      "chapterId": "0cfde249-bfad-4ced-8ab3-a365fd552536"
    },
    {
      "id": "8da7295d-555f-485a-927b-02598bb0b675",
      "text": "Hãy dâng CHÚA vinh quang xứng danh Người,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:22.838Z",
      "updatedAt": "2025-09-03T02:27:22.838Z",
      "chapterId": "0cfde249-bfad-4ced-8ab3-a365fd552536"
    },
    {
      "id": "643c0bc3-87cf-4b33-9841-9ba42980ad0a",
      "text": "và thờ lạy CHÚA uy nghiêm thánh thiện.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:22.866Z",
      "updatedAt": "2025-09-03T02:27:22.866Z",
      "chapterId": "0cfde249-bfad-4ced-8ab3-a365fd552536"
    },
    {
      "id": "bd601087-3d4f-4e19-aa4f-a802365057bd",
      "text": "Tiếng CHÚA rền vang trên sóng nước,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:22.880Z",
      "updatedAt": "2025-09-03T02:27:22.880Z",
      "chapterId": "0cfde249-bfad-4ced-8ab3-a365fd552536"
    },
    {
      "id": "81ae5b09-566c-43f8-8481-a7aae59d6b56",
      "text": "Thiên Chúa hiển vinh cho sấm nổ ầm ầm,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:22.909Z",
      "updatedAt": "2025-09-03T02:27:22.909Z",
      "chapterId": "0cfde249-bfad-4ced-8ab3-a365fd552536"
    },
    {
      "id": "c4a317c4-6c48-4845-a24d-63704029ebff",
      "text": "CHÚA ngự trên nước lũ mênh mông.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:22.923Z",
      "updatedAt": "2025-09-03T02:27:22.923Z",
      "chapterId": "0cfde249-bfad-4ced-8ab3-a365fd552536"
    },
    {
      "id": "3e597d08-3d38-4d0e-a706-1e50b3292690",
      "text": "Tiếng CHÚA thật hùng mạnh !",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:22.937Z",
      "updatedAt": "2025-09-03T02:27:22.937Z",
      "chapterId": "0cfde249-bfad-4ced-8ab3-a365fd552536"
    },
    {
      "id": "7e72b32e-96d9-46af-81b8-e5902eb37f2d",
      "text": "Tiếng CHÚA thật uy nghiêm !",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:22.970Z",
      "updatedAt": "2025-09-03T02:27:22.970Z",
      "chapterId": "0cfde249-bfad-4ced-8ab3-a365fd552536"
    },
    {
      "id": "7b3fc177-3024-4cef-ad4a-a4cc24498b0b",
      "text": "Tiếng CHÚA đánh gãy ngàn hương bá,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:22.984Z",
      "updatedAt": "2025-09-03T02:27:22.984Z",
      "chapterId": "0cfde249-bfad-4ced-8ab3-a365fd552536"
    },
    {
      "id": "db78be22-d2be-49d9-b9b2-bdae4903ffe2",
      "text": "CHÚA đánh gãy ngàn hương bá Li-băng.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:22.997Z",
      "updatedAt": "2025-09-03T02:27:22.997Z",
      "chapterId": "0cfde249-bfad-4ced-8ab3-a365fd552536"
    },
    {
      "id": "c2191fd5-a721-49ac-ba4a-d1d94fc6e838",
      "text": "Người làm cho dãy Li-băng thành như bê nhảy nhót,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:23.022Z",
      "updatedAt": "2025-09-03T02:27:23.022Z",
      "chapterId": "0cfde249-bfad-4ced-8ab3-a365fd552536"
    },
    {
      "id": "9cc5f893-5c9f-46d4-bd27-142cd8b3d204",
      "text": "đỉnh Xia-giôn khác nào nghé tung tăng.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:23.052Z",
      "updatedAt": "2025-09-03T02:27:23.052Z",
      "chapterId": "0cfde249-bfad-4ced-8ab3-a365fd552536"
    },
    {
      "id": "cdca8b54-7f0f-4267-9165-55d95e5501b8",
      "text": "Tiếng CHÚA phóng ra ngàn tia lửa,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:23.084Z",
      "updatedAt": "2025-09-03T02:27:23.084Z",
      "chapterId": "0cfde249-bfad-4ced-8ab3-a365fd552536"
    },
    {
      "id": "77688176-faf3-4aa1-837a-bab7018a5805",
      "text": "tiếng CHÚA lay động vùng sa mạc,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:23.097Z",
      "updatedAt": "2025-09-03T02:27:23.097Z",
      "chapterId": "0cfde249-bfad-4ced-8ab3-a365fd552536"
    },
    {
      "id": "ac06e844-3478-4f1e-b73b-dbb3d9677686",
      "text": "lay động vùng sa mạc Ca-đê.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:23.109Z",
      "updatedAt": "2025-09-03T02:27:23.109Z",
      "chapterId": "0cfde249-bfad-4ced-8ab3-a365fd552536"
    },
    {
      "id": "6d76a779-0cc6-481c-a6f5-c1b471cd5c51",
      "text": "Tiếng CHÚA lay động cả rặng sồi,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:23.131Z",
      "updatedAt": "2025-09-03T02:27:23.131Z",
      "chapterId": "0cfde249-bfad-4ced-8ab3-a365fd552536"
    },
    {
      "id": "ab880519-9e1a-45cc-a9e4-ccabcd2b68a6",
      "text": "tuốt trụi lá cây cao rừng rậm.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:23.142Z",
      "updatedAt": "2025-09-03T02:27:23.142Z",
      "chapterId": "0cfde249-bfad-4ced-8ab3-a365fd552536"
    },
    {
      "id": "e2d08582-b6f5-423b-8857-8f404da5d0b4",
      "text": "Còn trong thánh điện Người,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:23.153Z",
      "updatedAt": "2025-09-03T02:27:23.153Z",
      "chapterId": "0cfde249-bfad-4ced-8ab3-a365fd552536"
    },
    {
      "id": "b4fcc37e-4ba1-4c9f-ae89-a865f684465c",
      "text": "tất cả cùng hô : “Vinh danh Chúa !”",
      "label": "9",
      "number": 9,
      "subVerseIndex": 3,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:23.164Z",
      "updatedAt": "2025-09-03T02:27:23.164Z",
      "chapterId": "0cfde249-bfad-4ced-8ab3-a365fd552536"
    },
    {
      "id": "4a470aed-7e1f-46e3-b477-84428ba0d3f2",
      "text": "CHÚA ngự trị trên cơn hồng thuỷ,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:23.177Z",
      "updatedAt": "2025-09-03T02:27:23.177Z",
      "chapterId": "0cfde249-bfad-4ced-8ab3-a365fd552536"
    },
    {
      "id": "11636b6e-b24e-4d54-89f1-478991edebce",
      "text": "CHÚA là Vua ngự trị muôn đời.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:23.192Z",
      "updatedAt": "2025-09-03T02:27:23.192Z",
      "chapterId": "0cfde249-bfad-4ced-8ab3-a365fd552536"
    },
    {
      "id": "944df040-a8de-48d2-9df2-60841dff0509",
      "text": "Xin CHÚA ban quyền lực cho dân CHÚA,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:23.208Z",
      "updatedAt": "2025-09-03T02:27:23.208Z",
      "chapterId": "0cfde249-bfad-4ced-8ab3-a365fd552536"
    },
    {
      "id": "369c68df-a332-4555-9c55-5535db43bc5b",
      "text": "tuôn đổ phúc lành cho dân hưởng bình an.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:23.237Z",
      "updatedAt": "2025-09-03T02:27:23.237Z",
      "chapterId": "0cfde249-bfad-4ced-8ab3-a365fd552536"
    }
  ],
  "marks": [
    {
      "id": "435a6afa-4661-409f-8daa-378e634021b9",
      "content": "Tv 29 là *một thánh thi*, được coi như một trong những Thánh vịnh cổ xưa nhất. Sau lời kêu gọi triều đình thiên quốc (cc. 1-2), tác giả nói đến *tiếng Chúa* (= “Gôl yhwh”, được sử dụng bảy lần) (cc. 3-9b) để miêu tả vinh quang của Đức Chúa. Thánh vịnh kết thúc bằng lời tung hô chúc tụng Người (cc. 9c-10) và lời cầu xin Người ban phúc lành cho dân (c.11).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 48,
      "endOffset": 48,
      "createdAt": "2025-09-03T02:27:22.787Z",
      "updatedAt": "2025-09-03T02:27:22.787Z",
      "targetId": "1bee036d-86ee-485f-a303-5e7ef63b2277",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "0cfde249-bfad-4ced-8ab3-a365fd552536"
    },
    {
      "id": "a16ce56a-7e8c-4bbc-9ac2-1f9cfdb2a34a",
