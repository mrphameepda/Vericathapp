{
  "chapter": {
    "id": "bd59e21b-2054-4605-a34b-449a7ad47f13",
    "number": 30,
    "createdAt": "2025-09-03T01:07:51.660Z",
    "updatedAt": "2025-09-03T01:07:51.660Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "6fa6edf6-05ec-4beb-90b8-c5bae667b0a0",
      "text": "*Thánh vịnh. Thánh ca vào dịp lễ khánh thành Nhà. Của vua Đa-vít.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:27:28.801Z",
      "updatedAt": "2025-09-03T02:27:28.801Z",
      "chapterId": "bd59e21b-2054-4605-a34b-449a7ad47f13"
    },
    {
      "id": "c1782ed2-3acf-4c68-b650-ca2bee2e2340",
      "text": "Lạy CHÚA, con xin tán dương Ngài,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:28.870Z",
      "updatedAt": "2025-09-03T02:27:28.870Z",
      "chapterId": "bd59e21b-2054-4605-a34b-449a7ad47f13"
    },
    {
      "id": "bc16ec4e-6621-4e66-b69c-be7c75369578",
      "text": "vì đã thương cứu vớt,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:28.884Z",
      "updatedAt": "2025-09-03T02:27:28.884Z",
      "chapterId": "bd59e21b-2054-4605-a34b-449a7ad47f13"
    },
    {
      "id": "3c57f2ea-1493-4912-b63d-40bcad14029b",
      "text": "không để quân thù đắc chí nhạo cười con.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:28.898Z",
      "updatedAt": "2025-09-03T02:27:28.898Z",
      "chapterId": "bd59e21b-2054-4605-a34b-449a7ad47f13"
    },
    {
      "id": "ed4eb691-36bd-48c3-8ac2-b57d35f76a44",
      "text": "Lạy CHÚA là Thiên Chúa con thờ,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:28.912Z",
      "updatedAt": "2025-09-03T02:27:28.912Z",
      "chapterId": "bd59e21b-2054-4605-a34b-449a7ad47f13"
    },
    {
      "id": "38848df7-f97e-4f66-8904-c1af7d797de2",
      "text": "con kêu lên cùng Chúa, và Ngài đã cho con bình phục.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:28.927Z",
      "updatedAt": "2025-09-03T02:27:28.927Z",
      "chapterId": "bd59e21b-2054-4605-a34b-449a7ad47f13"
    },
    {
      "id": "5e901bba-76a5-49af-9b57-08a596c6606f",
      "text": "Lạy CHÚA, từ âm phủ Ngài đã kéo con lên,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:28.942Z",
      "updatedAt": "2025-09-03T02:27:28.942Z",
      "chapterId": "bd59e21b-2054-4605-a34b-449a7ad47f13"
    },
    {
      "id": "7659bbb5-b77f-46e5-8f1c-770f19f317bb",
      "text": "tưởng đã xuống mồ mà Ngài thương cứu sống.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:28.957Z",
      "updatedAt": "2025-09-03T02:27:28.957Z",
      "chapterId": "bd59e21b-2054-4605-a34b-449a7ad47f13"
    },
    {
      "id": "9a81097f-dd29-4319-93a9-7b8ca054cd7d",
      "text": "Hỡi những kẻ tín trung, hãy đàn ca mừng CHÚA,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:28.971Z",
      "updatedAt": "2025-09-03T02:27:28.971Z",
      "chapterId": "bd59e21b-2054-4605-a34b-449a7ad47f13"
    },
    {
      "id": "98155b36-b349-4fa1-a88f-54ff38c80429",
      "text": "cảm tạ thánh danh Người.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:28.985Z",
      "updatedAt": "2025-09-03T02:27:28.985Z",
      "chapterId": "bd59e21b-2054-4605-a34b-449a7ad47f13"
    },
    {
      "id": "73065024-7e18-4063-b411-f5511c5b25aa",
      "text": "Người nổi giận, giận trong giây lát,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:28.999Z",
      "updatedAt": "2025-09-03T02:27:28.999Z",
      "chapterId": "bd59e21b-2054-4605-a34b-449a7ad47f13"
    },
    {
      "id": "69a0ab0a-9d66-4de2-a2fc-504db07736d9",
      "text": "nhưng yêu thương, thương suốt cả đời.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:29.026Z",
      "updatedAt": "2025-09-03T02:27:29.026Z",
      "chapterId": "bd59e21b-2054-4605-a34b-449a7ad47f13"
    },
    {
      "id": "c331ef55-6c64-4c8f-af54-fc650a15d9be",
      "text": "Lệ có rơi khi màn đêm buông xuống,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:29.040Z",
      "updatedAt": "2025-09-03T02:27:29.040Z",
      "chapterId": "bd59e21b-2054-4605-a34b-449a7ad47f13"
    },
    {
      "id": "8c6f8185-d78a-46a9-91a0-944115fa2b9e",
      "text": "hừng đông về đã vọng tiếng hò reo.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 3,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:29.054Z",
      "updatedAt": "2025-09-03T02:27:29.054Z",
      "chapterId": "bd59e21b-2054-4605-a34b-449a7ad47f13"
    },
    {
      "id": "ad4a1698-51fa-488c-9a48-dc76c21b9e77",
      "text": "Thuở được yên vui, có lần tôi tự nhủ :",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:29.068Z",
      "updatedAt": "2025-09-03T02:27:29.068Z",
      "chapterId": "bd59e21b-2054-4605-a34b-449a7ad47f13"
    },
    {
      "id": "1458d38e-d41b-4ad7-9ba4-caec9e2a2a11",
      "text": "mình sẽ chẳng bao giờ nao núng !",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:29.083Z",
      "updatedAt": "2025-09-03T02:27:29.083Z",
      "chapterId": "bd59e21b-2054-4605-a34b-449a7ad47f13"
    },
    {
      "id": "57ebc1f1-4d0d-4c04-89ad-b4b089f04f3c",
      "text": "Lạy CHÚA, vì yêu thương,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:29.100Z",
      "updatedAt": "2025-09-03T02:27:29.100Z",
      "chapterId": "bd59e21b-2054-4605-a34b-449a7ad47f13"
    },
    {
      "id": "eb59fcf2-8aeb-46ae-8a0a-07793dcbfd0a",
      "text": "Ngài đã đặt con trên núi an toàn.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:29.118Z",
      "updatedAt": "2025-09-03T02:27:29.118Z",
      "chapterId": "bd59e21b-2054-4605-a34b-449a7ad47f13"
    },
    {
      "id": "6cfaa257-70dc-4274-b55a-db426960384b",
      "text": "Nhưng khi Ngài vừa ẩn mặt đi,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:29.132Z",
      "updatedAt": "2025-09-03T02:27:29.132Z",
      "chapterId": "bd59e21b-2054-4605-a34b-449a7ad47f13"
    },
    {
      "id": "3402c186-bfff-4773-aa25-dcaad6b92fb6",
      "text": "con liền thấy bàng hoàng sợ hãi.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 3,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:29.147Z",
      "updatedAt": "2025-09-03T02:27:29.147Z",
      "chapterId": "bd59e21b-2054-4605-a34b-449a7ad47f13"
    },
    {
      "id": "637ac18d-a2bb-4f4b-83b1-0771933a1192",
      "text": "Lạy CHÚA, con đã kêu lên Ngài,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:29.161Z",
      "updatedAt": "2025-09-03T02:27:29.161Z",
      "chapterId": "bd59e21b-2054-4605-a34b-449a7ad47f13"
    },
    {
      "id": "16220cba-00dd-4e59-9b7d-6687722470da",
      "text": "năn nỉ với Ngài là Chúa của con.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:29.174Z",
      "updatedAt": "2025-09-03T02:27:29.174Z",
      "chapterId": "bd59e21b-2054-4605-a34b-449a7ad47f13"
    },
    {
      "id": "7fa792ab-34fa-4446-9ef5-45139a285fd2",
      "text": "Chúa được lợi gì khi con phải chết,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:29.188Z",
      "updatedAt": "2025-09-03T02:27:29.188Z",
      "chapterId": "bd59e21b-2054-4605-a34b-449a7ad47f13"
    },
    {
      "id": "48087774-5031-4470-9f89-c583bf04ce81",
      "text": "được ích chi nếu con phải xuống mồ ?",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:29.200Z",
      "updatedAt": "2025-09-03T02:27:29.200Z",
      "chapterId": "bd59e21b-2054-4605-a34b-449a7ad47f13"
    },
    {
      "id": "d0df27ca-6f10-4e9b-8255-c80ad82853d3",
      "text": "Nắm tro tàn làm sao ca tụng Chúa",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:29.212Z",
      "updatedAt": "2025-09-03T02:27:29.212Z",
      "chapterId": "bd59e21b-2054-4605-a34b-449a7ad47f13"
    },
    {
      "id": "fd093cad-e070-4caa-b777-5bdfefaf1203",
      "text": "và tuyên dương lòng thành tín của Ngài.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 3,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:29.224Z",
      "updatedAt": "2025-09-03T02:27:29.224Z",
      "chapterId": "bd59e21b-2054-4605-a34b-449a7ad47f13"
    },
    {
      "id": "061ee41e-9773-4915-a62b-ef13c45d7dbe",
      "text": "Lạy CHÚA, xin lắng nghe và xót thương con,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:29.238Z",
      "updatedAt": "2025-09-03T02:27:29.238Z",
      "chapterId": "bd59e21b-2054-4605-a34b-449a7ad47f13"
    },
    {
      "id": "a06710ba-7c53-454c-9f63-f157f078fbc2",
      "text": "lạy CHÚA, xin phù trì nâng đỡ.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:29.253Z",
      "updatedAt": "2025-09-03T02:27:29.253Z",
      "chapterId": "bd59e21b-2054-4605-a34b-449a7ad47f13"
    },
    {
      "id": "d1b46b29-10fb-4757-9257-92f352f03e30",
      "text": "Khúc ai ca, Chúa đổi thành vũ điệu,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:29.267Z",
      "updatedAt": "2025-09-03T02:27:29.267Z",
      "chapterId": "bd59e21b-2054-4605-a34b-449a7ad47f13"
    },
    {
      "id": "f5fac1d9-44f2-4905-979b-04285b1665a3",
      "text": "cởi áo sô, mặc cho con lễ phục huy hoàng.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:29.297Z",
      "updatedAt": "2025-09-03T02:27:29.297Z",
      "chapterId": "bd59e21b-2054-4605-a34b-449a7ad47f13"
    },
    {
      "id": "96554b5b-20e4-4bfc-9a23-0e85a448140b",
      "text": "Vì thế, tâm hồn con ca ngợi Chúa, và không hề nín lặng.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:29.310Z",
      "updatedAt": "2025-09-03T02:27:29.310Z",
      "chapterId": "bd59e21b-2054-4605-a34b-449a7ad47f13"
    },
    {
      "id": "1a225188-100e-4777-9524-54d60e976e8a",
      "text": "Lạy CHÚA là Thiên Chúa con thờ,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:29.324Z",
      "updatedAt": "2025-09-03T02:27:29.324Z",
      "chapterId": "bd59e21b-2054-4605-a34b-449a7ad47f13"
    },
    {
      "id": "6c1d32ca-ea71-434a-8b21-0dfe27f5ed33",
      "text": "xin tạ ơn Ngài mãi mãi ngàn thu.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:29.339Z",
      "updatedAt": "2025-09-03T02:27:29.339Z",
      "chapterId": "bd59e21b-2054-4605-a34b-449a7ad47f13"
    }
  ],
  "marks": [
    {
      "id": "e0112fd0-0458-4025-841e-343b8f8fe335",
      "content": "English: Yahweh | French: SEIGNEUR | Latin: Dominus | Origin: &#1497;&#1456;&#1492;&#64331;&#1464;&#1492; | Vietnamese: ĐỨC CHÚA -- Danh của Thiên Chúa Ít-ra-en, St 2,4...",
      "kind": "MARK_KIND_FOOTNOTE",
