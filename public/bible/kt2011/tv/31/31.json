{
  "chapter": {
    "id": "7a469f07-adec-4e59-997e-a66ee053a4f3",
    "number": 31,
    "createdAt": "2025-09-03T01:07:51.660Z",
    "updatedAt": "2025-09-03T01:07:51.660Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "039c1522-5771-4972-afd6-4fa4780bcc1c",
      "text": "*Phần ca trưởng. Thánh vịnh. Của vua Đa-vít.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:27:34.580Z",
      "updatedAt": "2025-09-03T02:27:34.580Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "0bd018db-5041-4e74-9b6e-511912547a0c",
      "text": "Con ẩn náu bên Ngài, lạy CHÚA,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:34.631Z",
      "updatedAt": "2025-09-03T02:27:34.631Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "15058ce3-7380-4a4d-a39f-c23349210712",
      "text": "xin đừng để con phải tủi nhục bao giờ.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:34.642Z",
      "updatedAt": "2025-09-03T02:27:34.642Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "7d7f2cb6-64f2-4704-8a9d-7e0d06fb4232",
      "text": "Bởi vì Ngài công chính, xin giải thoát con,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:34.655Z",
      "updatedAt": "2025-09-03T02:27:34.655Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "82dbe818-4677-42a8-b5ac-8e2988b70cfe",
      "text": "ghé tai nghe và mau mau cứu chữa.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:34.668Z",
      "updatedAt": "2025-09-03T02:27:34.668Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "08772d84-7cd7-4613-8035-c3c43e2856a5",
      "text": "Xin Ngài nên như núi đá cho con trú ẩn,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:34.681Z",
      "updatedAt": "2025-09-03T02:27:34.681Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "639a01c4-8117-49cb-974f-3becd8267311",
      "text": "như thành trì để cứu độ con.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:34.710Z",
      "updatedAt": "2025-09-03T02:27:34.710Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "25c6b1a3-da5b-47a1-8b47-38ebf0b06dfa",
      "text": "Núi đá và thành luỹ bảo vệ con, chính là Chúa.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:34.724Z",
      "updatedAt": "2025-09-03T02:27:34.724Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "a812f6a6-c287-465b-82a0-ffc0cb583ca7",
      "text": "Vì danh dự Ngài, xin dẫn đường chỉ lối cho con.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:34.738Z",
      "updatedAt": "2025-09-03T02:27:34.738Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "460cf98c-90d8-4fbc-ae76-d26a95330d9e",
      "text": "Lưới kẻ thù giăng, xin gỡ con ra khỏi,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:34.759Z",
      "updatedAt": "2025-09-03T02:27:34.759Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "56fd034f-e7c5-4484-893e-c413ed3131ad",
      "text": "vì nơi con trú ẩn, chính là Ngài.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:34.775Z",
      "updatedAt": "2025-09-03T02:27:34.775Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "bb26cd0e-1737-4ffc-9187-8da93a77429d",
      "text": "Trong tay Ngài, con xin phó thác hồn con,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:34.788Z",
      "updatedAt": "2025-09-03T02:27:34.788Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "eced7cc8-99c7-49ec-87f8-b88d7e677457",
      "text": "Ngài đã cứu chuộc con, lạy CHÚA TRỜI thành tín.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:34.800Z",
      "updatedAt": "2025-09-03T02:27:34.800Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "1f625046-d867-4f54-94da-3996aa8e6ccb",
      "text": "Ngài ghét bọn thờ thần hư ảo,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:34.823Z",
      "updatedAt": "2025-09-03T02:27:34.823Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "c6a8d207-a354-4c73-b962-cc84f91e1562",
      "text": "phần con đây, lạy CHÚA, chỉ tin tưởng nơi Ngài.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:34.839Z",
      "updatedAt": "2025-09-03T02:27:34.839Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "c0622126-7c73-4947-94ff-b963bff5c08f",
      "text": "Được Ngài thương, con vui mừng hớn hở,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:34.855Z",
      "updatedAt": "2025-09-03T02:27:34.855Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "84d43b68-b76c-4388-a04f-06255f0109e4",
      "text": "vì Ngài đã đoái nhìn phận con cùng khốn.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:34.869Z",
      "updatedAt": "2025-09-03T02:27:34.869Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "cc0c8067-d492-4585-85d5-566b21ef4790",
      "text": "Con lâm cảnh ngặt nghèo, Ngài lo lắng chăm nom,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:34.886Z",
      "updatedAt": "2025-09-03T02:27:34.886Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "f071a357-66b4-4b5c-adce-131afbc95b3b",
      "text": "chẳng trao nộp thân này vào tay thù địch,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:34.900Z",
      "updatedAt": "2025-09-03T02:27:34.900Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "093e2615-68e1-4d5b-ab6f-88d138bc8f3c",
      "text": "nhưng cho con rộng bước thênh thang.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:34.917Z",
      "updatedAt": "2025-09-03T02:27:34.917Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "89946358-9240-4c88-b961-683ee11b6a2f",
      "text": "Xin xót thương, lạy CHÚA,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:34.934Z",
      "updatedAt": "2025-09-03T02:27:34.934Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "ab403899-0a9f-4141-b252-4431805a2a25",
      "text": "bởi vì con lâm cảnh ngặt nghèo,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:34.962Z",
      "updatedAt": "2025-09-03T02:27:34.962Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "6525e813-bfea-4293-b124-a22a8b095ea9",
      "text": "quá sầu đau, mắt đà mòn mỏi,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:34.980Z",
      "updatedAt": "2025-09-03T02:27:34.980Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "bff57b6a-14c8-4b6d-ab8b-6df2276f7e9a",
      "text": "hồn ảo não và thân hình tiều tuỵ.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 3,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:34.994Z",
      "updatedAt": "2025-09-03T02:27:34.994Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "63c5df84-9c6e-4e32-b71a-9d111dad634e",
      "text": "Đời tiêu hao trong nỗi u buồn",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:35.008Z",
      "updatedAt": "2025-09-03T02:27:35.008Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "118b82c7-fbd8-4cf0-9870-33a3bccbc041",
      "text": "và tháng năm tàn lụi giữa tiếng thở than.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:35.022Z",
      "updatedAt": "2025-09-03T02:27:35.022Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "f116381a-d217-40b9-b6b2-4ca91858ae0e",
      "text": "Con kiệt lực vì gặp bước khốn cùng, gân cốt con rời rã.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:35.035Z",
      "updatedAt": "2025-09-03T02:27:35.035Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "aa313f5e-e7c2-47d0-91cf-553f775e8f5c",
      "text": "Con đã nên trò cười cho thù địch",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:35.047Z",
      "updatedAt": "2025-09-03T02:27:35.047Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "96964fb9-99a0-4459-882f-fa5739c55eec",
      "text": "và cho cả hàng xóm láng giềng.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:35.061Z",
      "updatedAt": "2025-09-03T02:27:35.061Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "320ad78b-2ba5-4428-91dd-02f2370a0c52",
      "text": "Bạn bè thân thích đều kinh hãi,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:35.074Z",
      "updatedAt": "2025-09-03T02:27:35.074Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "cbf289da-e7d2-4eff-bfce-d2a834e54acf",
      "text": "thấy con ngoài đường, ai cũng tránh xa.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 3,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:35.088Z",
      "updatedAt": "2025-09-03T02:27:35.088Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "28534dbc-a621-4429-9874-feac1a460c9b",
      "text": "Bị lãng quên, như kẻ chết không người tưởng nhớ,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:35.102Z",
      "updatedAt": "2025-09-03T02:27:35.102Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "981bdb60-a86f-4b47-8d7b-c29ad960fb0d",
      "text": "con hoá thành đồ hư vất bỏ.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:35.116Z",
      "updatedAt": "2025-09-03T02:27:35.116Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "6b6f052f-ca2f-4184-a099-1beee15cc6de",
      "text": "Con nghe thấy những lời độc địa của bao người,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:35.130Z",
      "updatedAt": "2025-09-03T02:27:35.130Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "d09bbb45-9283-408f-a11e-2fb560d34030",
      "text": "nhìn chung quanh : toàn những điều khủng khiếp.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:35.145Z",
      "updatedAt": "2025-09-03T02:27:35.145Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "f9ec8763-9fb0-47f7-ba19-01232a1e7c75",
      "text": "Chúng toa rập chống con, và mưu toan lấy mạng.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 2,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:35.176Z",
      "updatedAt": "2025-09-03T02:27:35.176Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "91a70f9f-f15a-48da-9feb-453acdefb8be",
      "text": "Nhưng con đây vẫn tin tưởng nơi Ngài, lạy CHÚA,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:35.190Z",
      "updatedAt": "2025-09-03T02:27:35.190Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "25cc6a07-a23e-4d9b-bfd7-005be2cdb716",
      "text": "dám thưa rằng : Ngài là Thượng Đế của con.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:35.204Z",
      "updatedAt": "2025-09-03T02:27:35.204Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "26125fc1-279c-4bdd-99f5-fbac8eea4157",
      "text": "Số phận con ở trong tay ngài.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:35.218Z",
      "updatedAt": "2025-09-03T02:27:35.218Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "69322e2e-fa75-4516-9a91-a0a4365cb9dd",
      "text": "Xin giải thoát con khỏi tay địch thủ,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:35.234Z",
      "updatedAt": "2025-09-03T02:27:35.234Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "7da1dd35-e15a-4078-aaba-572584df7988",
      "text": "khỏi người bách hại con.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 2,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:35.263Z",
      "updatedAt": "2025-09-03T02:27:35.263Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "a16e7749-751f-47fe-adcb-5648b0c31191",
      "text": "Xin toả ánh tôn nhan rạng ngời",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:35.276Z",
      "updatedAt": "2025-09-03T02:27:35.276Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "4492fe90-9846-47a3-93d8-f5dbb7f728d9",
      "text": "trên tôi tớ Ngài đây, và lấy tình thương mà cứu độ.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:35.306Z",
      "updatedAt": "2025-09-03T02:27:35.306Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "3f9787bc-0d95-44b5-8a27-1d64fd90a50b",
      "text": "Lạy CHÚA, xin đừng để con phải nhục nhã, vì đã kêu cầu Ngài,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:35.335Z",
      "updatedAt": "2025-09-03T02:27:35.335Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "9de26c09-22f8-4699-9dce-cbd3a736f2ed",
      "text": "Nhưng ước gì ác nhân phải nhục nhã",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:35.350Z",
      "updatedAt": "2025-09-03T02:27:35.350Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "8498ed99-baa0-464e-815c-172aa09dde95",
      "text": "mà ngậm miệng sa xuống âm ty.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 2,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:35.364Z",
      "updatedAt": "2025-09-03T02:27:35.364Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "f2c98fb4-cd27-45c2-bc43-4ef93740772b",
      "text": "Cho phường điêu ngoa phải câm họng ;",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:35.379Z",
      "updatedAt": "2025-09-03T02:27:35.379Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "60cf9d5c-05a9-42a6-b4f1-406942b84d0d",
      "text": "chúng kiêu ngạo khinh đời, buông những lời hỗn xược",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:35.395Z",
      "updatedAt": "2025-09-03T02:27:35.395Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "59ea0203-bbc6-4bbf-bb15-c3271d877b8f",
      "text": "chống lại người công chính.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 2,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:35.410Z",
      "updatedAt": "2025-09-03T02:27:35.410Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "e6006e56-e14f-4083-aa0a-85a4c4c16e84",
      "text": "Lạy Chúa, cao cả thay tấm lòng nhân hậu,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:35.426Z",
      "updatedAt": "2025-09-03T02:27:35.426Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "6d277b38-248f-4ab3-99a5-7d380b2d7346",
      "text": "Chúa dành cho kẻ kính sợ Ngài,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:35.440Z",
      "updatedAt": "2025-09-03T02:27:35.440Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "49aa09a0-b39d-421c-9a67-0aa09a199350",
      "text": "và thi thố trước mặt phàm nhân",
      "label": "20",
      "number": 20,
      "subVerseIndex": 2,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:35.454Z",
      "updatedAt": "2025-09-03T02:27:35.454Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "13979eee-30af-4e60-9519-432a4c5214e0",
      "text": "cho ai tìm đến Ngài nương náu.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 3,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:35.468Z",
      "updatedAt": "2025-09-03T02:27:35.468Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "7abc78bc-cde3-4b35-a94b-11216fae8ca0",
      "text": "Bên Thánh Nhan, Ngài giấu họ kỹ càng",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:35.482Z",
      "updatedAt": "2025-09-03T02:27:35.482Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "131f22ec-490c-43bd-87b5-1117e6c9c2a2",
      "text": "khỏi người đời mưu hại.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:35.496Z",
      "updatedAt": "2025-09-03T02:27:35.496Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "a8730dc6-dbcf-4fb9-94ce-c651f8ce2c50",
      "text": "Ngài che chở họ trong lều thánh, xa tầm lưỡi thị phi.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 2,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:35.510Z",
      "updatedAt": "2025-09-03T02:27:35.510Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "3342dde9-e3dd-4391-a83d-8a91ab8f4ebc",
      "text": "Chúc tụng CHÚA đã tỏ tình thương kỳ diệu đối với con",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:35.525Z",
      "updatedAt": "2025-09-03T02:27:35.525Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "1047697c-27ab-4cea-bd6f-8de778fa2517",
      "text": "trong thành trì vững chắc.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:35.540Z",
      "updatedAt": "2025-09-03T02:27:35.540Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "3f2f4c87-b6ac-45a0-89bd-3763db78c696",
      "text": "Vậy mà con đã nói vì hốt hoảng :",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:35.555Z",
      "updatedAt": "2025-09-03T02:27:35.555Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "262280e9-eb61-48c1-88dd-88f6ab101304",
      "text": "“Con bị đuổi đi khuất mắt Chúa rồi !”",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:35.569Z",
      "updatedAt": "2025-09-03T02:27:35.569Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "da47e6c5-8bfb-42aa-b5ec-dddcf4da037a",
      "text": "Thế nhưng Ngài đã nghe tiếng nài van",
      "label": "23",
      "number": 23,
      "subVerseIndex": 2,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:35.597Z",
      "updatedAt": "2025-09-03T02:27:35.597Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "84721f73-a6b3-4ddd-bb69-ddf91e475e71",
      "text": "trong ngày con kêu cứu.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 3,
      "paragraphNumber": 61,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:35.611Z",
      "updatedAt": "2025-09-03T02:27:35.611Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "afd45138-a207-4c20-b91c-fb27f27c90db",
      "text": "Hết mọi người hiếu trung với Chúa,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 62,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:35.626Z",
      "updatedAt": "2025-09-03T02:27:35.626Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "ebeb2c0d-4613-439f-9970-22b8f3cbb96c",
      "text": "hãy yêu mến CHÚA đi !",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 63,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:35.640Z",
      "updatedAt": "2025-09-03T02:27:35.640Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "4bdc8bda-18f9-43d2-a51c-4c14b86955f3",
      "text": "CHÚA giữ gìn những ai thành tín",
      "label": "24",
      "number": 24,
      "subVerseIndex": 2,
      "paragraphNumber": 64,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:35.655Z",
      "updatedAt": "2025-09-03T02:27:35.655Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "388b6bd6-0788-4464-9e02-523221b02bc2",
      "text": "nhưng thẳng tay trừng trị người ăn ở kiêu căng.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 3,
      "paragraphNumber": 65,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:35.668Z",
      "updatedAt": "2025-09-03T02:27:35.668Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "12fb0cdb-1436-4817-a7bf-a66dacdb1333",
      "text": "Hỡi mọi người cậy trông vào CHÚA,",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 66,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:35.683Z",
      "updatedAt": "2025-09-03T02:27:35.683Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "429d1ab5-da30-4de2-830f-fe3c7425bec2",
      "text": "mạnh bạo lên, can đảm lên nào !",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 67,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:35.697Z",
      "updatedAt": "2025-09-03T02:27:35.697Z",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    }
  ],
  "marks": [
    {
      "id": "d5b99914-ec1d-4f22-83a3-b884247b1d19",
      "content": "*Ai ca này của cá nhân* miêu tả tình trạng khốn khổ của tác giả là một người đau ốm, bị kẻ thù độc ác nhạo cười và tìm cách giết hại, bị bạn hữu láng giềng lánh xa. Tác giả khẩn nài Thiên Chúa đến trợ giúp. Niềm hy vọng về ơn trợ giúp đó vững mạnh đến mức tác giả coi mình như đã được nhậm lời rồi. Ai ca này chia làm hai phần : Hình như *phần I* (cc. 2-19) được soạn thảo theo kiểu đối ngẫu tréo : **1**) Cầu nguyện (cc. 2-5) ; **2**) Tin tưởng (cc. 6-9) ; **3**) Than vãn (cc. 10-14) ; **4**) Tin tưởng (c.15) ; **5**) Cầu nguyện (cc. 16-19). Trong phần I, 1 đối chiếu với 5 ; 2 đối chiếu với 4 ; 3 ở giữa. *Phần II* (cc. 20-25) chia làm hai đoạn : **1**) Chúc tụng Thiên Chúa (cc. 20-23) ; **2**) Kêu gọi các tín hữu yêu mến Thiên Chúa và cậy trông vào Người (cc. 24-25).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 59,
      "endOffset": 59,
      "createdAt": "2025-09-03T02:27:34.608Z",
      "updatedAt": "2025-09-03T02:27:34.608Z",
