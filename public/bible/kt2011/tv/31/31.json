    },
    {
      "id": "a8a2c206-a03c-46a2-9dde-db5ab3c2f4e9",
      "content": "English: Sin | French: Sin | Latin: Sin | Origin: &#1505;&#1460;&#1497;&#1503; | Vietnamese: Xin 1 -- sa mạc trong cuộc Xuất hành, Xh 16,1 ; Ds 33,11-12",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:27:34.696Z",
      "updatedAt": "2025-09-03T02:27:34.696Z",
      "targetId": "08772d84-7cd7-4613-8035-c3c43e2856a5",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "7a469f07-adec-4e59-997e-a66ee053a4f3"
    },
    {
      "id": "144d1c4f-9de3-4c35-94e1-eeed69b6f6d9",
      "content": "*Hồn* là hơi thở, là sinh mạng. Lc 23,46 lấy lại lời này nhằm diễn tả niềm cậy trông thanh thản của Đức Giê-su và thái độ của Người hoàn toàn chấp nhận cái chết.",
