{
  "chapter": {
    "id": "f076c28d-f699-40eb-b1e8-b098a4c4dee4",
    "number": 32,
    "createdAt": "2025-09-03T01:07:51.660Z",
    "updatedAt": "2025-09-03T01:07:51.660Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "3bc345f8-8d10-4f18-a766-bbe79d9d4660",
      "text": "*Của vua Đa-vít. Thi khúc.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:27:40.790Z",
      "updatedAt": "2025-09-03T02:27:40.790Z",
      "chapterId": "f076c28d-f699-40eb-b1e8-b098a4c4dee4"
    },
    {
      "id": "253eb920-fb16-4c25-92a4-bd27c3f24d65",
      "text": "Hạnh phúc thay, kẻ lỗi lầm mà được tha thứ,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:40.852Z",
      "updatedAt": "2025-09-03T02:27:40.852Z",
      "chapterId": "f076c28d-f699-40eb-b1e8-b098a4c4dee4"
    },
    {
      "id": "c0d1f48d-0eaa-4272-b94a-a091d8b21210",
      "text": "người có tội mà được khoan dung.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:40.865Z",
      "updatedAt": "2025-09-03T02:27:40.865Z",
      "chapterId": "f076c28d-f699-40eb-b1e8-b098a4c4dee4"
    },
    {
      "id": "c558c228-616e-4840-b076-0a6e45b5462b",
      "text": "Hạnh phúc thay, người CHÚA không hạch tội,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:40.879Z",
      "updatedAt": "2025-09-03T02:27:40.879Z",
      "chapterId": "f076c28d-f699-40eb-b1e8-b098a4c4dee4"
    },
    {
      "id": "4d62318d-d95d-49ab-84e5-1996288b8c7f",
      "text": "và lòng trí chẳng chút gian tà.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:40.908Z",
      "updatedAt": "2025-09-03T02:27:40.908Z",
      "chapterId": "f076c28d-f699-40eb-b1e8-b098a4c4dee4"
    },
    {
      "id": "f3fab1e5-a032-425b-bb87-802a053828eb",
      "text": "Bao lâu con lặng thinh không thú lỗi,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:40.922Z",
      "updatedAt": "2025-09-03T02:27:40.922Z",
      "chapterId": "f076c28d-f699-40eb-b1e8-b098a4c4dee4"
    },
    {
      "id": "d103210c-80e2-4c09-b856-71bfb3cc4d6f",
      "text": "thì gân cốt rã rời, cả ngày con gào thét.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:40.936Z",
      "updatedAt": "2025-09-03T02:27:40.936Z",
      "chapterId": "f076c28d-f699-40eb-b1e8-b098a4c4dee4"
    },
    {
      "id": "98401228-e944-461f-a3b2-0f310bf97b70",
      "text": "Vì ngày đêm con bị tay Ngài đè nặng,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:40.951Z",
      "updatedAt": "2025-09-03T02:27:40.951Z",
      "chapterId": "f076c28d-f699-40eb-b1e8-b098a4c4dee4"
    },
    {
      "id": "1611644b-8956-40c5-80a4-2fb032febe5f",
      "text": "nên sức lực hao mòn, như bị nắng mùa hè thiêu đốt.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:40.965Z",
      "updatedAt": "2025-09-03T02:27:40.965Z",
      "chapterId": "f076c28d-f699-40eb-b1e8-b098a4c4dee4"
    },
    {
      "id": "96b734c0-0bad-43d1-9816-2a51c30b067b",
      "text": "Bởi thế, con đã xưng tội ra với Ngài,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:40.979Z",
      "updatedAt": "2025-09-03T02:27:40.979Z",
      "chapterId": "f076c28d-f699-40eb-b1e8-b098a4c4dee4"
    },
    {
      "id": "6d34de50-732c-4222-a5bf-6ccced9e1ffc",
      "text": "chẳng giấu Ngài lầm lỗi của con.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:40.994Z",
      "updatedAt": "2025-09-03T02:27:40.994Z",
      "chapterId": "f076c28d-f699-40eb-b1e8-b098a4c4dee4"
    },
    {
      "id": "1395bd9d-2101-412a-ba64-719d4c34c51e",
      "text": "Con tự nhủ : “Nào ta đi thú tội với Chúa”,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:41.007Z",
      "updatedAt": "2025-09-03T02:27:41.007Z",
      "chapterId": "f076c28d-f699-40eb-b1e8-b098a4c4dee4"
    },
    {
      "id": "cb40ffd1-e1c6-466b-a731-5451261937bb",
      "text": "và chính Ngài đã tha thứ tội vạ cho con.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 3,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:41.038Z",
      "updatedAt": "2025-09-03T02:27:41.038Z",
      "chapterId": "f076c28d-f699-40eb-b1e8-b098a4c4dee4"
    },
    {
      "id": "a08ea246-211c-4462-84c5-acf3b90590ef",
      "text": "Vì thế, ai là người hiếu trung với Chúa",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:41.053Z",
      "updatedAt": "2025-09-03T02:27:41.053Z",
      "chapterId": "f076c28d-f699-40eb-b1e8-b098a4c4dee4"
    },
    {
      "id": "17c7b04b-0c7d-45a9-a692-8a9a67310990",
      "text": "sẽ kêu cầu Ngài lúc gặp cảnh gian truân ;",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:41.067Z",
      "updatedAt": "2025-09-03T02:27:41.067Z",
      "chapterId": "f076c28d-f699-40eb-b1e8-b098a4c4dee4"
    },
    {
      "id": "687b8f41-4cdd-47eb-9c77-1ec3c5438576",
      "text": "cho dầu nước lũ có ngập tràn",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:41.081Z",
      "updatedAt": "2025-09-03T02:27:41.081Z",
      "chapterId": "f076c28d-f699-40eb-b1e8-b098a4c4dee4"
    },
    {
      "id": "4b1bfb43-2171-4952-9aad-c218f4454e0c",
      "text": "cũng không dâng tới họ.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 3,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:41.096Z",
      "updatedAt": "2025-09-03T02:27:41.096Z",
      "chapterId": "f076c28d-f699-40eb-b1e8-b098a4c4dee4"
    },
    {
      "id": "c174c092-233f-4ac3-a1e9-ad8a67f3ea53",
      "text": "Chính Chúa là nơi con ẩn náu,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:41.110Z",
      "updatedAt": "2025-09-03T02:27:41.110Z",
      "chapterId": "f076c28d-f699-40eb-b1e8-b098a4c4dee4"
    },
    {
      "id": "992f1593-97fa-4311-9686-3894333b9feb",
      "text": "giữ gìn con khỏi bước ngặt nghèo.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:41.125Z",
      "updatedAt": "2025-09-03T02:27:41.125Z",
      "chapterId": "f076c28d-f699-40eb-b1e8-b098a4c4dee4"
    },
    {
      "id": "585ea72c-9d5e-4d1b-ad84-b784ae2ac5b1",
      "text": "Khắp bốn bề, Chúa làm trổi vang lên",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:41.139Z",
      "updatedAt": "2025-09-03T02:27:41.139Z",
      "chapterId": "f076c28d-f699-40eb-b1e8-b098a4c4dee4"
    },
    {
      "id": "f62618ab-ebe1-44dc-9564-5aea2082f2f6",
      "text": "những khúc ca mừng con được giải thoát.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 3,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:41.157Z",
      "updatedAt": "2025-09-03T02:27:41.157Z",
      "chapterId": "f076c28d-f699-40eb-b1e8-b098a4c4dee4"
    },
    {
      "id": "a05076fa-8510-488d-aaf2-a6015acaf1d0",
      "text": "Chúa rằng : “Này đây Ta răn dạy,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:41.171Z",
      "updatedAt": "2025-09-03T02:27:41.171Z",
      "chapterId": "f076c28d-f699-40eb-b1e8-b098a4c4dee4"
    },
    {
      "id": "63fa3a6b-7e0a-4000-bcea-40b853299e11",
      "text": "chỉ cho con biết đường lối phải theo,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:41.185Z",
      "updatedAt": "2025-09-03T02:27:41.185Z",
      "chapterId": "f076c28d-f699-40eb-b1e8-b098a4c4dee4"
    },
    {
      "id": "54e38f9a-2c7d-4694-bb5a-243dd56baf40",
      "text": "để mắt nhìn con, Ta ban lời khuyên nhủ.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:41.199Z",
      "updatedAt": "2025-09-03T02:27:41.199Z",
      "chapterId": "f076c28d-f699-40eb-b1e8-b098a4c4dee4"
    },
    {
      "id": "9fe34a88-63cf-4365-bc7f-d61da41b8cd7",
      "text": "Đừng bắt chước lừa ngựa, giống vô tri,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:41.214Z",
      "updatedAt": "2025-09-03T02:27:41.214Z",
      "chapterId": "f076c28d-f699-40eb-b1e8-b098a4c4dee4"
    },
    {
      "id": "6fc18ccf-617c-4c51-85f5-0487098fd8c0",
      "text": "phải chế ngự bằng dây cương hàm thiếc,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:41.228Z",
      "updatedAt": "2025-09-03T02:27:41.228Z",
      "chapterId": "f076c28d-f699-40eb-b1e8-b098a4c4dee4"
    },
    {
      "id": "73dcc881-83e0-4caf-b67f-3b72d1c8e8ca",
      "text": "nếu không, nó chẳng chịu đến gần.”",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:41.244Z",
      "updatedAt": "2025-09-03T02:27:41.244Z",
      "chapterId": "f076c28d-f699-40eb-b1e8-b098a4c4dee4"
    },
    {
      "id": "dce7aaaf-318c-42ab-ba78-0118327527b9",
      "text": "Bao đau khổ sẵn chờ kẻ dữ,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:41.260Z",
      "updatedAt": "2025-09-03T02:27:41.260Z",
      "chapterId": "f076c28d-f699-40eb-b1e8-b098a4c4dee4"
    },
    {
      "id": "ebcdb784-cf7b-4b43-8226-35d8b13fc04e",
      "text": "còn ai tin cậy CHÚA, luôn được Người ấp ủ thương yêu.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:41.274Z",
      "updatedAt": "2025-09-03T02:27:41.274Z",
      "chapterId": "f076c28d-f699-40eb-b1e8-b098a4c4dee4"
    },
    {
      "id": "f65b004b-c031-410e-9897-cb3af9d4a932",
      "text": "Hỡi những người công chính,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:41.291Z",
      "updatedAt": "2025-09-03T02:27:41.291Z",
      "chapterId": "f076c28d-f699-40eb-b1e8-b098a4c4dee4"
    },
    {
      "id": "a03fe82b-3723-45df-8c04-4b51f8c43976",
      "text": "hãy vui lên trong CHÚA, hãy nhảy mừng.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:41.322Z",
      "updatedAt": "2025-09-03T02:27:41.322Z",
      "chapterId": "f076c28d-f699-40eb-b1e8-b098a4c4dee4"
    },
    {
      "id": "402e7822-9558-434e-a82c-8d4e5ee7017e",
      "text": "Mọi tâm hồn ngay thẳng, nào cất tiếng hò reo.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:41.336Z",
      "updatedAt": "2025-09-03T02:27:41.336Z",
      "chapterId": "f076c28d-f699-40eb-b1e8-b098a4c4dee4"
    }
  ],
  "marks": [
    {
      "id": "f8878d31-0c90-4adb-bab0-2dc987e1c37a",
      "content": "Trong Thánh vịnh *tạ ơn này của cá nhân*, tội nhân lâu ngày bị nỗi lo âu và đau khổ giày vò, tìm thấy lại bình an sau khi thú nhận tội lỗi. Vì nhấn mạnh đến chuyện xưng thú tội lỗi (x. cc. 1-2.3.5), nên Tv 32 này cũng được coi như Thánh vịnh thứ 2 (sau Tv 6) trong số bảy *Thánh vịnh sám hối*. Cấu trúc : **1**) Nhập đề (*Hạnh phúc thay*) (cc. 1-2) ; **2**) Bị tội lỗi đè nặng lương tâm và hết sức mỏi mệt, tội nhân cảm thấy cần xưng thú tội lỗi, nhận được từ Thiên Chúa ơn tha thứ và niềm vui (cc. 3-7) ; **3**) Sấm ngôn của Thiên Chúa (cc. 8-10) ; **4**) Mời gọi các tín hữu diễn tả niềm vui và ca ngợi Thiên Chúa (c.11).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 52,
      "endOffset": 52,
      "createdAt": "2025-09-03T02:27:40.825Z",
      "updatedAt": "2025-09-03T02:27:40.825Z",
      "targetId": "19c4024d-ea3f-47be-93e6-ec557af08908",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "f076c28d-f699-40eb-b1e8-b098a4c4dee4"
    },
