    },
    {
      "id": "3c655b17-6591-4013-918d-013f51c12579",
      "text": "Xin đổ tình thương xuống chúng con, lạy CHÚA,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:47.694Z",
      "updatedAt": "2025-09-03T02:27:47.694Z",
      "chapterId": "53626496-9274-4ef3-b215-b31110fbd9dd"
    },
    {
      "id": "e2eafe7d-598e-4388-a62c-cf7918020bbf",
      "text": "như chúng con hằng trông cậy nơi Ngài.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:47.723Z",
