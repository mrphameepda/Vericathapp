{
  "chapter": {
    "id": "53626496-9274-4ef3-b215-b31110fbd9dd",
    "number": 33,
    "createdAt": "2025-09-03T01:07:51.660Z",
    "updatedAt": "2025-09-03T01:07:51.660Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "3acca7b1-8239-4bfc-93d8-c5dd72fdefe1",
      "text": "Người công chính, hãy reo hò mừng CHÚA,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:46.945Z",
      "updatedAt": "2025-09-03T02:27:46.945Z",
      "chapterId": "53626496-9274-4ef3-b215-b31110fbd9dd"
    },
    {
      "id": "863e18d8-226d-4804-8624-e4b367710207",
      "text": "kẻ ngay lành, nào cất tiếng ngợi khen.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:47.024Z",
      "updatedAt": "2025-09-03T02:27:47.024Z",
      "chapterId": "53626496-9274-4ef3-b215-b31110fbd9dd"
    },
    {
      "id": "09a62fe8-3f8a-4035-9a94-611ae33eabfe",
      "text": "Tạ ơn CHÚA, gieo vạn tiếng đàn cầm,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:47.041Z",
      "updatedAt": "2025-09-03T02:27:47.041Z",
      "chapterId": "53626496-9274-4ef3-b215-b31110fbd9dd"
    },
    {
      "id": "25860d03-d21c-4b9e-a86c-e3bd2a89b27d",
      "text": "kính mừng Người, gảy muôn cung đàn sắt.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:47.056Z",
      "updatedAt": "2025-09-03T02:27:47.056Z",
      "chapterId": "53626496-9274-4ef3-b215-b31110fbd9dd"
    },
    {
      "id": "73bf1964-5834-446b-a769-a500c3425e5c",
      "text": "Nào dâng Chúa một khúc tân ca,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:47.070Z",
      "updatedAt": "2025-09-03T02:27:47.070Z",
      "chapterId": "53626496-9274-4ef3-b215-b31110fbd9dd"
    },
    {
      "id": "f70a9bcd-01e4-4169-b6dc-f4e02e8f3d38",
      "text": "rập tiếng hoan hô, nhã nhạc vang lừng.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:47.098Z",
      "updatedAt": "2025-09-03T02:27:47.098Z",
      "chapterId": "53626496-9274-4ef3-b215-b31110fbd9dd"
    },
    {
      "id": "a1f48b08-abde-4f08-b688-77f883145186",
      "text": "Vì lời CHÚA phán quả là ngay thẳng,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:47.112Z",
      "updatedAt": "2025-09-03T02:27:47.112Z",
      "chapterId": "53626496-9274-4ef3-b215-b31110fbd9dd"
    },
    {
      "id": "0caaaea2-86ad-46ca-8237-9f728e95b673",
      "text": "mọi việc Chúa làm đều đáng cậy tin.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:47.127Z",
      "updatedAt": "2025-09-03T02:27:47.127Z",
      "chapterId": "53626496-9274-4ef3-b215-b31110fbd9dd"
    },
    {
      "id": "323c7da6-7190-48e8-ba26-7c864b2fe6ae",
      "text": "Chúa yêu thích điều công minh chính trực,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:47.141Z",
      "updatedAt": "2025-09-03T02:27:47.141Z",
      "chapterId": "53626496-9274-4ef3-b215-b31110fbd9dd"
    },
    {
      "id": "60d4f0d6-1fcf-4650-81f5-3c66f52bd3d8",
      "text": "tình thương CHÚA chan hoà mặt đất.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:47.157Z",
      "updatedAt": "2025-09-03T02:27:47.157Z",
      "chapterId": "53626496-9274-4ef3-b215-b31110fbd9dd"
    },
    {
      "id": "3519afe9-ff91-45ba-846b-7fc25de0b670",
      "text": "Một lời CHÚA phán làm ra chín tầng trời,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:47.188Z",
      "updatedAt": "2025-09-03T02:27:47.188Z",
      "chapterId": "53626496-9274-4ef3-b215-b31110fbd9dd"
    },
    {
      "id": "ab25aa6a-6552-4b42-82a1-539ca4515871",
      "text": "một hơi Chúa thở tạo thành muôn tinh tú.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:47.202Z",
      "updatedAt": "2025-09-03T02:27:47.202Z",
      "chapterId": "53626496-9274-4ef3-b215-b31110fbd9dd"
    },
    {
      "id": "1caf4fcf-681a-418d-b2ca-4fb92aee034e",
      "text": "Chúa dồn đại dương về một chỗ,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:47.230Z",
      "updatedAt": "2025-09-03T02:27:47.230Z",
      "chapterId": "53626496-9274-4ef3-b215-b31110fbd9dd"
    },
    {
      "id": "34165b5e-ea32-4467-a717-ec28e3b02446",
      "text": "Người đem biển cả trữ vào kho.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:47.253Z",
      "updatedAt": "2025-09-03T02:27:47.253Z",
      "chapterId": "53626496-9274-4ef3-b215-b31110fbd9dd"
    },
    {
      "id": "0d4c9088-4d35-44f3-9b1c-c7e695bb7b8e",
      "text": "Cả địa cầu phải kính sợ CHÚA,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:47.268Z",
      "updatedAt": "2025-09-03T02:27:47.268Z",
      "chapterId": "53626496-9274-4ef3-b215-b31110fbd9dd"
    },
    {
      "id": "0fae939b-7808-4e46-bdea-59cd007e6502",
      "text": "mọi thế nhân hãy khiếp oai Người.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:47.282Z",
      "updatedAt": "2025-09-03T02:27:47.282Z",
      "chapterId": "53626496-9274-4ef3-b215-b31110fbd9dd"
    },
    {
      "id": "0ec2545b-679b-44c6-ba29-88b83b1727fb",
      "text": "Vì Người đã phán, và muôn loài xuất hiện,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:47.297Z",
      "updatedAt": "2025-09-03T02:27:47.297Z",
      "chapterId": "53626496-9274-4ef3-b215-b31110fbd9dd"
    },
    {
      "id": "263fc0ae-6e3c-4d03-ad85-fbb5d4e75fd3",
      "text": "Người ra lệnh truyền, tất cả được dựng nên.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:47.311Z",
      "updatedAt": "2025-09-03T02:27:47.311Z",
      "chapterId": "53626496-9274-4ef3-b215-b31110fbd9dd"
    },
    {
      "id": "ab59870c-8b14-4398-9c00-dcbf188f68a4",
      "text": "CHÚA đảo lộn chương trình muôn nước,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:47.325Z",
      "updatedAt": "2025-09-03T02:27:47.325Z",
      "chapterId": "53626496-9274-4ef3-b215-b31110fbd9dd"
    },
    {
      "id": "4a512bef-f668-49f4-9930-93f115727df3",
      "text": "Người phá tan ý định chư dân.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:47.339Z",
      "updatedAt": "2025-09-03T02:27:47.339Z",
      "chapterId": "53626496-9274-4ef3-b215-b31110fbd9dd"
    },
    {
      "id": "9a4f448b-3ad8-40eb-b2c3-3e97401864e5",
      "text": "Chương trình CHÚA ngàn năm bền vững,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:47.354Z",
      "updatedAt": "2025-09-03T02:27:47.354Z",
      "chapterId": "53626496-9274-4ef3-b215-b31110fbd9dd"
    },
    {
      "id": "a800ce64-505e-4293-93e4-a5bb54dfca68",
      "text": "ý định của lòng Người vạn kiếp trường tồn.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:47.368Z",
      "updatedAt": "2025-09-03T02:27:47.368Z",
      "chapterId": "53626496-9274-4ef3-b215-b31110fbd9dd"
    },
    {
      "id": "a5f09e90-a0d7-445f-be02-04a29dece78b",
      "text": "Hạnh phúc thay quốc gia được CHÚA làm Chúa Tể,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:47.382Z",
      "updatedAt": "2025-09-03T02:27:47.382Z",
      "chapterId": "53626496-9274-4ef3-b215-b31110fbd9dd"
    },
    {
      "id": "f5a7affa-18a8-44d1-b4cb-a5c954a28cfd",
      "text": "hạnh phúc thay dân nào Người chọn làm gia nghiệp.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:47.398Z",
      "updatedAt": "2025-09-03T02:27:47.398Z",
      "chapterId": "53626496-9274-4ef3-b215-b31110fbd9dd"
    },
    {
      "id": "effd383e-29f3-49ad-a4a9-d3f14e3b3acb",
      "text": "Từ trời cao nhìn xuống, CHÚA thấy hết mọi người.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:47.443Z",
      "updatedAt": "2025-09-03T02:27:47.443Z",
      "chapterId": "53626496-9274-4ef3-b215-b31110fbd9dd"
    },
    {
      "id": "4fdc9e95-fe75-4807-97be-96780cb0f0c2",
      "text": "Từ thiên cung Chúa ngự, Chúa dõi theo người thế.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:47.457Z",
      "updatedAt": "2025-09-03T02:27:47.457Z",
      "chapterId": "53626496-9274-4ef3-b215-b31110fbd9dd"
    },
    {
      "id": "e3f90e26-dc22-44e1-85a4-7edc1a3e78de",
      "text": "Lòng mỗi người, chính Chúa dựng nên,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:47.473Z",
      "updatedAt": "2025-09-03T02:27:47.473Z",
      "chapterId": "53626496-9274-4ef3-b215-b31110fbd9dd"
    },
    {
      "id": "16dae72a-7ad9-4922-8e38-1079ee6699a4",
      "text": "việc họ làm, Chúa thông suốt cả.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:47.487Z",
      "updatedAt": "2025-09-03T02:27:47.487Z",
      "chapterId": "53626496-9274-4ef3-b215-b31110fbd9dd"
    },
    {
      "id": "0b6d0791-fccd-450c-8f8c-13d6b7018e5f",
      "text": "Vua thắng trận đâu phải bởi hùng binh,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:47.501Z",
      "updatedAt": "2025-09-03T02:27:47.501Z",
      "chapterId": "53626496-9274-4ef3-b215-b31110fbd9dd"
    },
    {
      "id": "80a160cb-d6bb-49ae-8a87-4e66a192b834",
      "text": "tráng sĩ thoát nguy đâu nhờ dũng lực.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:47.516Z",
      "updatedAt": "2025-09-03T02:27:47.516Z",
      "chapterId": "53626496-9274-4ef3-b215-b31110fbd9dd"
    },
    {
      "id": "39ac0c43-83e6-4168-8bcf-dd02a419271e",
      "text": "Hão huyền thay, mong thắng nhờ chiến mã,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:47.546Z",
      "updatedAt": "2025-09-03T02:27:47.546Z",
      "chapterId": "53626496-9274-4ef3-b215-b31110fbd9dd"
    },
    {
      "id": "5bb18e9b-38dc-46c1-8701-5cef831da25e",
      "text": "nó mạnh đến đâu cũng không cứu nổi người.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:47.561Z",
      "updatedAt": "2025-09-03T02:27:47.561Z",
      "chapterId": "53626496-9274-4ef3-b215-b31110fbd9dd"
    },
    {
      "id": "b2a220c3-79cf-4b3e-aac7-987bb958c4db",
      "text": "CHÚA để mắt trông nom người kính sợ Chúa,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:47.575Z",
      "updatedAt": "2025-09-03T02:27:47.575Z",
      "chapterId": "53626496-9274-4ef3-b215-b31110fbd9dd"
    },
    {
      "id": "9f05344e-b1e7-49b0-921c-1b2f1156f4ce",
      "text": "kẻ trông cậy vào lòng Chúa yêu thương,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:47.589Z",
      "updatedAt": "2025-09-03T02:27:47.589Z",
      "chapterId": "53626496-9274-4ef3-b215-b31110fbd9dd"
    },
    {
      "id": "3c11766c-e22e-44cd-9b24-641280188c01",
      "text": "hầu cứu họ khỏi tay thần chết",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:47.603Z",
      "updatedAt": "2025-09-03T02:27:47.603Z",
      "chapterId": "53626496-9274-4ef3-b215-b31110fbd9dd"
    },
    {
      "id": "f75461d9-d83c-42d4-ab79-c244a1b0bf84",
      "text": "và nuôi sống trong buổi cơ hàn.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:47.619Z",
      "updatedAt": "2025-09-03T02:27:47.619Z",
      "chapterId": "53626496-9274-4ef3-b215-b31110fbd9dd"
    },
    {
      "id": "c77fadff-47e2-4c70-a935-382331ff85c8",
      "text": "Tâm hồn chúng tôi đợi trông CHÚA,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:47.634Z",
      "updatedAt": "2025-09-03T02:27:47.634Z",
      "chapterId": "53626496-9274-4ef3-b215-b31110fbd9dd"
    },
    {
      "id": "f3dafcb4-af23-415e-86c8-bcd9b17c0c00",
      "text": "bởi Người luôn che chở phù trì.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:47.648Z",
      "updatedAt": "2025-09-03T02:27:47.648Z",
      "chapterId": "53626496-9274-4ef3-b215-b31110fbd9dd"
    },
    {
      "id": "fbe0eeb1-23ad-4fc3-b663-1dc2804e4687",
      "text": "Vâng, có Người, chúng tôi mừng rỡ,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:47.662Z",
      "updatedAt": "2025-09-03T02:27:47.662Z",
