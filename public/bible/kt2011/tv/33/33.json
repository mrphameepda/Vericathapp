    {
      "id": "38cdc7e5-a987-4ef3-9fbd-a73ec0435086",
      "text": "vì hằng tin tưởng ở Thánh Danh.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
