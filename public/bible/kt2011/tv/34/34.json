{
  "chapter": {
    "id": "3beb1939-2a1f-4bb2-9928-9366d61302c4",
    "number": 34,
    "createdAt": "2025-09-03T01:07:51.660Z",
    "updatedAt": "2025-09-03T01:07:51.660Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "d9ceb0d6-2b24-4fbc-af0a-7913f50c8ef1",
      "text": "*Của vua Đa-vít. Khi ông giả điên trước mặt vua A-vi-me-léc, ông bị đuổi và ra đi.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:27:53.040Z",
      "updatedAt": "2025-09-03T02:27:53.040Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "18390621-6197-4524-bc7b-e17cc69d2ed3",
      "text": "A-lép",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:27:53.115Z",
      "updatedAt": "2025-09-03T02:27:53.115Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "abb17363-4189-42af-a467-61ae19d7dfc2",
      "text": "Tôi sẽ không ngừng chúc tụng CHÚA,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:53.130Z",
      "updatedAt": "2025-09-03T02:27:53.130Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "aeba53c0-10bf-402f-9f4a-8307c919984e",
      "text": "câu hát mừng Người chẳng ngớt trên môi.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:53.145Z",
      "updatedAt": "2025-09-03T02:27:53.145Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "2ac17bab-0e4f-4bb1-bda8-d36d49ce1924",
      "text": "Bết",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:27:53.159Z",
      "updatedAt": "2025-09-03T02:27:53.159Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "55b2212f-f2fe-4828-9914-90247826ec08",
      "text": "Linh hồn tôi hãnh diện vì CHÚA",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:53.173Z",
      "updatedAt": "2025-09-03T02:27:53.173Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "df37cb6d-f317-44a3-8010-628693bd0b84",
      "text": "xin các bạn nghèo nghe tôi nói mà vui lên.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:53.188Z",
      "updatedAt": "2025-09-03T02:27:53.188Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "9ae9f56e-4878-4a75-b77e-f412c9c93c7e",
      "text": "Ghi-men",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:27:53.203Z",
      "updatedAt": "2025-09-03T02:27:53.203Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "ff24349f-5ef4-4018-a912-23cdcb53c17e",
      "text": "Hãy cùng tôi ngợi khen ĐỨC CHÚA,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:53.217Z",
      "updatedAt": "2025-09-03T02:27:53.217Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "52112206-9505-406c-a1e8-6556498f7e89",
      "text": "ta đồng thanh tán tụng danh Người.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:53.254Z",
      "updatedAt": "2025-09-03T02:27:53.254Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "b2f3f202-edb7-4efd-ba62-6e293397de5e",
      "text": "Đa-lét",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:27:53.266Z",
      "updatedAt": "2025-09-03T02:27:53.266Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "c79a3919-01af-4eac-86f0-f741e9fe834e",
      "text": "Tôi đã tìm kiếm CHÚA, và Người đáp lại,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:53.278Z",
      "updatedAt": "2025-09-03T02:27:53.278Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "56217794-d2c1-4d8d-8f61-7e8740f509e9",
      "text": "giải thoát cho khỏi mọi nỗi kinh hoàng.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:53.292Z",
      "updatedAt": "2025-09-03T02:27:53.292Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "e8266e56-ba3d-416f-a32a-7c0a50f4632b",
      "text": "Hê",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:27:53.306Z",
      "updatedAt": "2025-09-03T02:27:53.306Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "b23e1a63-1e84-47c7-9f5d-b46748f6d8c5",
      "text": "Ai nhìn lên CHÚA sẽ vui tươi hớn hở,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:53.321Z",
      "updatedAt": "2025-09-03T02:27:53.321Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "816365ce-13ab-4c53-9777-95dd38a98d59",
      "text": "không bao giờ bẽ mặt hổ ngươi.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:53.335Z",
      "updatedAt": "2025-09-03T02:27:53.335Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "ae9d036b-0fb3-40ce-8f90-a8991421f4c7",
      "text": "Da-in",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:27:53.348Z",
      "updatedAt": "2025-09-03T02:27:53.348Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "4224fd90-03d5-4c66-80d9-d86751df0c89",
      "text": "Kẻ nghèo này kêu lên và CHÚA đã nhậm lời,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:53.362Z",
      "updatedAt": "2025-09-03T02:27:53.362Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "2ace29fe-5f74-46a5-ba11-e462db41a578",
      "text": "cứu cho khỏi mọi cơn nguy khốn.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:53.377Z",
      "updatedAt": "2025-09-03T02:27:53.377Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "bc79021b-ea38-47ec-a9ce-0614fd950426",
      "text": "Khết",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:27:53.391Z",
      "updatedAt": "2025-09-03T02:27:53.391Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "9c38f62e-f87e-4745-8edc-0f21ef243ad8",
      "text": "Sứ thần của CHÚA đóng trại chung quanh",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:53.406Z",
      "updatedAt": "2025-09-03T02:27:53.406Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "5c084631-9964-4d16-8f9c-6001818b2f93",
      "text": "để giải thoát những ai kính sợ Người.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:53.434Z",
      "updatedAt": "2025-09-03T02:27:53.434Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "02226500-ebd2-445f-8679-1f82f240bbf5",
      "text": "Tết",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:27:53.448Z",
      "updatedAt": "2025-09-03T02:27:53.448Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "7f6177ff-d72a-4d0a-ae00-7bebe187bba5",
      "text": "Hãy nghiệm xem CHÚA tốt lành biết mấy :",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:53.462Z",
      "updatedAt": "2025-09-03T02:27:53.462Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "3bba5803-56cf-4ea8-890b-15ee24215b0d",
      "text": "hạnh phúc thay kẻ ẩn náu bên Người !",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:53.492Z",
      "updatedAt": "2025-09-03T02:27:53.492Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "a51168b7-1aa9-4ba9-8ef4-3deb072ff962",
      "text": "Giốt",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:27:53.506Z",
      "updatedAt": "2025-09-03T02:27:53.506Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "89b26322-2c35-4bcc-9367-a6ded12dd9ee",
      "text": "Kính sợ CHÚA đi, đoàn dân thánh hỡi,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:53.519Z",
      "updatedAt": "2025-09-03T02:27:53.519Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "ad9d55bb-7799-40c7-95da-be49a44a7575",
      "text": "vì ai kính sợ Người chẳng thiếu thốn chi.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:53.533Z",
      "updatedAt": "2025-09-03T02:27:53.533Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "55e61ab3-8ef0-487b-baee-80fb11cf7329",
      "text": "Cáp",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:27:53.546Z",
      "updatedAt": "2025-09-03T02:27:53.546Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "a2caf2de-1da3-4092-b3d5-88e303a5a47e",
      "text": "Kẻ giàu sang phải bần cùng đói khổ,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:53.560Z",
      "updatedAt": "2025-09-03T02:27:53.560Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "0ba5abbb-84a5-4a93-9733-a7491b5a3a62",
      "text": "còn ai tìm kiếm CHÚA chẳng thiếu của gì.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:53.575Z",
      "updatedAt": "2025-09-03T02:27:53.575Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "a7adefe3-227a-4edc-9689-3e5291fe0778",
      "text": "La-mét",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:27:53.591Z",
      "updatedAt": "2025-09-03T02:27:53.591Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "a2f91bfa-bd61-4cfe-b909-56a0a1520b72",
      "text": "Các con ơi, hãy đến mà nghe,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:53.604Z",
      "updatedAt": "2025-09-03T02:27:53.604Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "3eb7707a-d79b-45cd-b1f9-f6759c3a453f",
      "text": "ta sẽ dạy cho biết đường kính sợ CHÚA.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:53.653Z",
      "updatedAt": "2025-09-03T02:27:53.653Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "1b39faa1-9a2d-4e63-bd5c-d513e3b366c5",
      "text": "Mêm",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:27:53.670Z",
      "updatedAt": "2025-09-03T02:27:53.670Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "2c036366-48e9-410a-9085-cd734ecc4b74",
      "text": "Ai là người thiết tha được sống,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:53.684Z",
      "updatedAt": "2025-09-03T02:27:53.684Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "dd698da2-abd3-47c5-86e2-f4f9b4e043bc",
      "text": "ước ao hưởng chuỗi ngày hạnh phúc chứa chan ?",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:53.712Z",
      "updatedAt": "2025-09-03T02:27:53.712Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "9a96c8c5-184d-4d4e-9911-6e54053468ef",
      "text": "Nun",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:27:53.726Z",
      "updatedAt": "2025-09-03T02:27:53.726Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "e403d515-4d21-4855-872d-bf537b8562a8",
      "text": "Phải giữ mồm giữ miệng, đừng nói lời gian ác điêu ngoa ;",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:53.758Z",
      "updatedAt": "2025-09-03T02:27:53.758Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "a1710624-3b3c-41b8-866b-38b23507684a",
      "text": "Xa-méc",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:27:53.776Z",
      "updatedAt": "2025-09-03T02:27:53.776Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "5f233096-6323-4f08-9926-21a41d900e07",
      "text": "hãy làm lành lánh dữ, tìm kiếm bình an, ăn ở thuận hoà.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:53.792Z",
      "updatedAt": "2025-09-03T02:27:53.792Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "b867ab79-2240-49da-ab47-a56298700e77",
      "text": "Pê",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:27:53.806Z",
      "updatedAt": "2025-09-03T02:27:53.806Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "167d009e-154b-4a5f-912a-e146c1a2b984",
      "text": "nhưng để mắt nhìn người chính trực",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:53.870Z",
      "updatedAt": "2025-09-03T02:27:53.870Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "0baecbfb-a742-479d-ac50-13cff5064c6b",
      "text": "và lắng tai nghe tiếng họ kêu.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:53.884Z",
      "updatedAt": "2025-09-03T02:27:53.884Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "50b582e9-fe04-44af-8c33-580cb529ca80",
      "text": "Xa-đê",
      "label": "16",
      "number": 16,
      "subVerseIndex": 2,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:27:53.898Z",
      "updatedAt": "2025-09-03T02:27:53.898Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "8f20ef9f-eb4f-405a-9cc0-32f2847cff37",
      "text": "CHÚA đối đầu với quân gian ác,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:53.819Z",
      "updatedAt": "2025-09-03T02:27:53.819Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "9f908c61-b7b0-4ba3-a850-d9885ccdf8b7",
      "text": "xoá nhoà tên tuổi chúng trên đời,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:53.837Z",
      "updatedAt": "2025-09-03T02:27:53.837Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "b5ae4585-5ce9-47a3-abf7-e7d322bf3ee9",
      "text": "A-in",
      "label": "17",
      "number": 17,
      "subVerseIndex": 2,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:27:53.850Z",
      "updatedAt": "2025-09-03T02:27:53.850Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "1db2e3ac-fbce-4789-84d0-5a129cfa9f26",
      "text": "Họ kêu xin, và CHÚA đã nhậm lời,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:53.912Z",
      "updatedAt": "2025-09-03T02:27:53.912Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "1e2982e0-04bf-4857-907d-235c6d6f1808",
      "text": "giải thoát khỏi mọi cơn nguy khốn.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:53.926Z",
      "updatedAt": "2025-09-03T02:27:53.926Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "9c997d60-2d1e-42c0-a4c7-2e4891657dd6",
      "text": "Cốp",
      "label": "18",
      "number": 18,
      "subVerseIndex": 2,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:27:53.942Z",
      "updatedAt": "2025-09-03T02:27:53.942Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "2bb60a8c-449f-4481-a190-ec7cb0926001",
      "text": "CHÚA gần gũi những tấm lòng tan vỡ,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:53.957Z",
      "updatedAt": "2025-09-03T02:27:53.957Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "e9f58077-4d9f-4da9-a54c-324390d81e8a",
      "text": "cứu những tâm thần thất vọng ê chề.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:53.986Z",
      "updatedAt": "2025-09-03T02:27:53.986Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "3fbfc591-fbd3-4abc-99c3-831cb7af49ca",
      "text": "Rết",
      "label": "19",
      "number": 19,
      "subVerseIndex": 2,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:27:54.001Z",
      "updatedAt": "2025-09-03T02:27:54.001Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "ab3a997d-8cae-4d61-8e27-25ee2b4b1679",
      "text": "Người công chính gặp nhiều nỗi gian truân,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:54.016Z",
      "updatedAt": "2025-09-03T02:27:54.016Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "f6c4e5ea-406a-463c-b6a2-ab75cff05830",
      "text": "nhưng CHÚA giúp họ luôn thoát khỏi.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:54.030Z",
      "updatedAt": "2025-09-03T02:27:54.030Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "f48f0acf-1139-45d9-ab7b-c9d827747fb2",
      "text": "Sin",
      "label": "20",
      "number": 20,
      "subVerseIndex": 2,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:27:54.045Z",
      "updatedAt": "2025-09-03T02:27:54.045Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "39d34bcf-0a64-4686-87b8-895ad62732cd",
      "text": "Xương cốt họ đều được CHÚA giữ gìn,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:54.057Z",
      "updatedAt": "2025-09-03T02:27:54.057Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "5ce7be95-3af1-485d-9f4c-35b73e3c5dd5",
      "text": "dầu một khúc cũng không giập gãy.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:54.068Z",
      "updatedAt": "2025-09-03T02:27:54.068Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "169d1b45-07bd-4dff-b8df-ce3801a2ee04",
      "text": "Tau",
      "label": "21",
      "number": 21,
      "subVerseIndex": 2,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:27:54.091Z",
      "updatedAt": "2025-09-03T02:27:54.091Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "a0026cbe-79e2-4aec-bbba-5cee35a79661",
      "text": "Quân gian ác chết vì tội ác,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:54.108Z",
      "updatedAt": "2025-09-03T02:27:54.108Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "49e5e36c-41a7-4b40-b8b3-be2eeb5a323d",
      "text": "kẻ ghét người lành chuốc án phạt vào thân.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 61,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:54.123Z",
      "updatedAt": "2025-09-03T02:27:54.123Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "5bfcc0c1-26f9-43ba-a014-fcf0a626516e",
      "text": "CHÚA cứu mạng các người tôi tớ,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 62,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:54.138Z",
      "updatedAt": "2025-09-03T02:27:54.138Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    },
    {
      "id": "4c52949d-92be-4a82-963a-f2aee3d6f10a",
      "text": "ai ẩn thân bên Chúa không bị phạt bao giờ.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 63,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:54.152Z",
      "updatedAt": "2025-09-03T02:27:54.152Z",
      "chapterId": "3beb1939-2a1f-4bb2-9928-9366d61302c4"
    }
  ],
