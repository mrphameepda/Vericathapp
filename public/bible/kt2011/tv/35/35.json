{
  "chapter": {
    "id": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da",
    "number": 35,
    "createdAt": "2025-09-03T01:07:51.660Z",
    "updatedAt": "2025-09-03T01:07:51.660Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "4d0ea949-3a20-4a6d-ba4b-2bfb43241161",
      "text": "*Của vua Đa-vít.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:27:59.608Z",
      "updatedAt": "2025-09-03T02:27:59.608Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "75b8efbe-fe52-42ae-82e4-b1c65b46a3a5",
      "text": "Lạy CHÚA, kẻ tố con, xin Ngài tố lại,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:59.671Z",
      "updatedAt": "2025-09-03T02:27:59.671Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "38fcf87f-cbff-4a10-8e41-f55bd6147eae",
      "text": "kẻ đánh con, xin Ngài đánh nó.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:59.684Z",
      "updatedAt": "2025-09-03T02:27:59.684Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "dde0c8e5-4203-4508-988a-206f8028d0bf",
      "text": "Cầm mộc khiên, xin đứng dậy phù trì,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:59.698Z",
      "updatedAt": "2025-09-03T02:27:59.698Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "8b88186f-3355-4839-b21d-4fa9176fae93",
      "text": "vung gươm giáo chống lại những người bắt bớ con,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:59.712Z",
      "updatedAt": "2025-09-03T02:27:59.712Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "bbe0a5bd-fa41-4fd6-be14-9c27ea539628",
      "text": "xin nói với con rằng : “Ta là Đấng cứu độ ngươi.”",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:59.727Z",
      "updatedAt": "2025-09-03T02:27:59.727Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "9298664f-28bb-4b79-ad86-f34cc7675fb2",
      "text": "Chớ gì những ai tìm hại mạng sống con",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:59.741Z",
      "updatedAt": "2025-09-03T02:27:59.741Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "36d0da1c-f515-4f7b-8f8d-028801abdeca",
      "text": "phải xấu hổ thẹn thùng,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:59.784Z",
      "updatedAt": "2025-09-03T02:27:59.784Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "3ed226fd-52c5-40a0-aacd-a667e5556556",
      "text": "kẻ tính kế hại con",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:59.798Z",
      "updatedAt": "2025-09-03T02:27:59.798Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "aa91f175-dc54-4f91-83ac-0a193baf8e12",
      "text": "phải tháo lui nhục nhã !",
      "label": "4",
      "number": 4,
      "subVerseIndex": 3,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:59.812Z",
      "updatedAt": "2025-09-03T02:27:59.812Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "2345304f-acbe-4acf-ab9c-99e51a0afc33",
      "text": "Chớ gì chúng nên như trấu gió thổi bay,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:59.827Z",
      "updatedAt": "2025-09-03T02:27:59.827Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "c5343b61-c4d4-4ad4-95bf-d4acd87e3dbd",
      "text": "khi chúng bị thiên thần CHÚA xua đuổi !",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:59.841Z",
      "updatedAt": "2025-09-03T02:27:59.841Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "c52133a9-fae1-42dc-9534-b94b1eea37b9",
      "text": "Chớ gì đường chúng đi nên tối tăm trơn trượt,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:59.854Z",
      "updatedAt": "2025-09-03T02:27:59.854Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "0066cf4c-d15b-47d1-8476-ccb5564a3bd5",
      "text": "khi chúng bị thiên thần CHÚA rượt theo !",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:59.884Z",
      "updatedAt": "2025-09-03T02:27:59.884Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "2c4a55c1-7655-4f3d-a399-3dce979eb40e",
      "text": "Vì vô cớ chúng đã giăng lưới, vô cớ chúng đào hố hại con.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:59.898Z",
      "updatedAt": "2025-09-03T02:27:59.898Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "e4a41781-286b-4962-a720-c3be77aebe85",
      "text": "Chớ gì tai hoạ bất ngờ ập trên chúng,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:59.912Z",
      "updatedAt": "2025-09-03T02:27:59.912Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "b0b080b7-dd4c-40f7-932b-2c8d31aee608",
      "text": "lưới chúng giăng, cho chúng mắc vào,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:59.942Z",
      "updatedAt": "2025-09-03T02:27:59.942Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "aae3c74b-0f7d-4be9-b1d5-75e1177a34e8",
      "text": "cho chúng gặp phải tai hoạ đó !",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:59.961Z",
      "updatedAt": "2025-09-03T02:27:59.961Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "af217a23-015f-4777-8020-f984a701391e",
      "text": "Hồn tôi sẽ vui mừng trong CHÚA,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:59.974Z",
      "updatedAt": "2025-09-03T02:27:59.974Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "b8b85955-d1b9-4f00-b25e-e12c1c8cce35",
      "text": "hoan hỷ vì Người cứu thoát tôi.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:27:59.988Z",
      "updatedAt": "2025-09-03T02:27:59.988Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "c4bbf74e-5821-471b-b1ea-65750aab484a",
      "text": "Tự thâm tâm, tôi sẽ nói lên rằng :",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.005Z",
      "updatedAt": "2025-09-03T02:28:00.005Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "459f1d94-b220-445f-8b36-1accbd2e5dd8",
      "text": "“Ai ví được như Ngài, lạy CHÚA ?",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.020Z",
      "updatedAt": "2025-09-03T02:28:00.020Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "42ffd0ca-a462-44c6-ae4c-5ac5b34723e3",
      "text": "Ngài cứu kẻ nghèo hèn khỏi tay người mạnh thế,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.048Z",
      "updatedAt": "2025-09-03T02:28:00.048Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "1a88cb2e-2cf8-486b-a3cc-c9e4ea2bc4e2",
      "text": "và cứu kẻ túng thiếu nghèo hèn khỏi tay quân bóc lột.”",
      "label": "10",
      "number": 10,
      "subVerseIndex": 3,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.060Z",
      "updatedAt": "2025-09-03T02:28:00.060Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "36b84daa-8ca9-4f72-a3ca-3841055fe3f3",
      "text": "Bọn chứng nhân giả dối đứng lên,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.072Z",
      "updatedAt": "2025-09-03T02:28:00.072Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "40d82800-78a8-4d47-a1f5-b0a7d70807cb",
      "text": "hạch hỏi tôi những điều tôi chẳng biết.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.085Z",
      "updatedAt": "2025-09-03T02:28:00.085Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "83d8944e-5f0e-4e8e-a667-f33b04881391",
      "text": "Chúng lấy oán đền ơn, này thân tôi trơ trọi một mình.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.098Z",
      "updatedAt": "2025-09-03T02:28:00.098Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "2cc6a4d6-0d77-4840-b937-92154e24ac03",
      "text": "Nhưng phần tôi, những ngày chúng đau yếu,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.122Z",
      "updatedAt": "2025-09-03T02:28:00.122Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "c5f07065-b6ba-487b-82d5-8a1eb6e6b60c",
      "text": "tôi đã từng khoác áo nhặm vào thân,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.136Z",
      "updatedAt": "2025-09-03T02:28:00.136Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "3a7cc12e-d405-4d54-b54d-9b84ab2f2b84",
      "text": "lại ăn chay để hãm mình phạt xác,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.149Z",
      "updatedAt": "2025-09-03T02:28:00.149Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "9680ae3d-c916-4167-89a4-eef0b6563f3d",
      "text": "lòng tôi ấp ủ câu kinh lời nguyện,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 3,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.164Z",
      "updatedAt": "2025-09-03T02:28:00.164Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "72d299b0-18f7-4399-b665-bb989e08b37e",
      "text": "như cầu cho bạn hữu anh em.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.178Z",
      "updatedAt": "2025-09-03T02:28:00.178Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "0ce58909-7257-4ec2-86c6-52b76d2607f4",
      "text": "Tôi lang thang như người khóc mẹ,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.191Z",
      "updatedAt": "2025-09-03T02:28:00.191Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "410439bb-32bb-448b-97cd-e8fa1d3fc46f",
      "text": "tôi tủi buồn cúi mặt xuống mà đi.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 2,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.205Z",
      "updatedAt": "2025-09-03T02:28:00.205Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "0ca11c76-bd3b-4076-880e-427566cd3206",
      "text": "Thế mà khi tôi vừa vấp ngã,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.221Z",
      "updatedAt": "2025-09-03T02:28:00.221Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "ceeeabcb-6f9b-4e3a-9f3e-fdd7a1cec2ad",
      "text": "chúng vui mừng tụ hội với nhau.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.235Z",
      "updatedAt": "2025-09-03T02:28:00.235Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "6a870c8d-60bc-4d4a-924b-b35c639ce1d7",
      "text": "Người lạ mặt cũng xúm vào đập đánh",
      "label": "15",
      "number": 15,
      "subVerseIndex": 2,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.249Z",
      "updatedAt": "2025-09-03T02:28:00.249Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "e56adb22-7b1b-4fe6-a4a3-58241ef4c0fc",
      "text": "và cấu xé không ngừng.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 3,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.264Z",
      "updatedAt": "2025-09-03T02:28:00.264Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "126767a3-7fd6-4597-965f-afb4889269b7",
      "text": "Chúng khiêu khích tôi và nặng lời chế nhạo,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.278Z",
      "updatedAt": "2025-09-03T02:28:00.278Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "c7c02712-ec49-4172-b9fc-b08056268707",
      "text": "lại hằm hè nghiến lợi nghiến răng.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.292Z",
      "updatedAt": "2025-09-03T02:28:00.292Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "02e62800-aac0-4b54-a97b-50f52b7995fe",
      "text": "Lạy Chúa, sao Chúa đành nhìn như vậy mãi ?",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.306Z",
      "updatedAt": "2025-09-03T02:28:00.306Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "2cbf7976-e665-4f11-a62c-142212bd4a83",
      "text": "Xin cứu mạng con khỏi thú dữ đang gầm gừ,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.321Z",
      "updatedAt": "2025-09-03T02:28:00.321Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "6b420bf2-e570-4b56-b3df-14092fdde25d",
      "text": "cứu mạng duy nhất này khỏi bầy sư tử.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 2,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.350Z",
      "updatedAt": "2025-09-03T02:28:00.350Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "840b9007-754a-4c7c-aaeb-55adf85eb9a4",
      "text": "Giữa lòng đại hội, con sẽ tạ ơn Chúa,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.364Z",
      "updatedAt": "2025-09-03T02:28:00.364Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "3b13c07f-a246-4216-a6f1-6cbf42a4cb6f",
      "text": "trước mặt quần chúng, con sẽ tán dương Ngài.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.380Z",
      "updatedAt": "2025-09-03T02:28:00.380Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "7c822038-e8da-4890-907c-cbc5d7548385",
      "text": "Xin đừng để bọn thù con vô lý được đắc chí nhạo cười,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.394Z",
      "updatedAt": "2025-09-03T02:28:00.394Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "8c864bfb-ed3d-444c-a9ab-fe8370f22ea8",
      "text": "và những kẻ vô cớ ghét con nháy nhau mà chế giễu.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.425Z",
      "updatedAt": "2025-09-03T02:28:00.425Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "1032cdd3-f4cd-4319-a727-0bb097c35347",
      "text": "Vì chúng chẳng nói đến hoà bình,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.458Z",
      "updatedAt": "2025-09-03T02:28:00.458Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "3ee0e5ad-3b81-4aa2-b4a2-df19b4cfb295",
      "text": "lại vu cáo những kẻ hiền lành trong xứ sở.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.474Z",
      "updatedAt": "2025-09-03T02:28:00.474Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "a4b77729-6fc6-40be-a213-4c25b5388f0b",
      "text": "Chúng to mồm chế giễu con :",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.486Z",
      "updatedAt": "2025-09-03T02:28:00.486Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "0e065760-53b9-44d8-84a4-592412a68464",
      "text": "“A ha ! Mắt ta đã thấy rồi !”",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.500Z",
      "updatedAt": "2025-09-03T02:28:00.500Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "b74c62ad-ca85-44d0-9ed5-0cfe7b90e09e",
      "text": "Lạy CHÚA, Ngài thấy rồi, xin đừng nín lặng,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.515Z",
      "updatedAt": "2025-09-03T02:28:00.515Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "43d04c66-630e-4d78-baf5-2c6da5f934ea",
      "text": "lạy Chúa, xin đừng nỡ đứng xa.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.527Z",
      "updatedAt": "2025-09-03T02:28:00.527Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "fcd7ffaa-d656-41cd-a3fe-0597e011edb7",
      "text": "Xin thức dậy, đứng lên xét xử, và biện hộ cho con,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.538Z",
      "updatedAt": "2025-09-03T02:28:00.538Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "258f3ac8-08e5-474e-a6bc-55ab2c175841",
      "text": "lạy Thiên Chúa, lạy Chúa con thờ.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.564Z",
      "updatedAt": "2025-09-03T02:28:00.564Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "1ebc2269-beeb-4611-b269-3e79a066d6ac",
      "text": "Lạy CHÚA là Thiên Chúa con thờ,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.578Z",
      "updatedAt": "2025-09-03T02:28:00.578Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "f0b881de-4c9a-4c41-ad57-4ea0b4a070e7",
      "text": "xin xử cho con theo lẽ công bằng của Chúa,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.592Z",
      "updatedAt": "2025-09-03T02:28:00.592Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "fc9904f6-b70a-4e08-b7c7-12fae6bf4f43",
      "text": "đừng để chúng đắc chí nhạo cười con.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 2,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.606Z",
      "updatedAt": "2025-09-03T02:28:00.606Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "5bf4d581-37d8-43a1-8417-cf6720e40f3b",
      "text": "Xin đừng để chúng nghĩ thầm trong bụng :",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.621Z",
      "updatedAt": "2025-09-03T02:28:00.621Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "959338f6-00bb-4e39-acf9-da079ed97bdd",
      "text": "“A ha ! Ta đã toại nguyện rồi !”",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.649Z",
      "updatedAt": "2025-09-03T02:28:00.649Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "1782acff-48ea-4484-a283-d3bdb8ab83b0",
      "text": "Xin đừng cho chúng nói :",
      "label": "25",
      "number": 25,
      "subVerseIndex": 2,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.660Z",
      "updatedAt": "2025-09-03T02:28:00.660Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "e362a4c5-20ea-4f9d-b077-ba9e56b0bc3e",
      "text": "“Ta nuốt trửng nó rồi !”",
      "label": "25",
      "number": 25,
      "subVerseIndex": 3,
      "paragraphNumber": 61,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.682Z",
      "updatedAt": "2025-09-03T02:28:00.682Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "db89bb7b-3723-4b3e-895f-6789a3b8dcea",
      "text": "Những kẻ đắc chí vì con mắc hoạ,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 62,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.697Z",
      "updatedAt": "2025-09-03T02:28:00.697Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "da1900f1-b3bb-46c4-8d2e-5644a2ee785d",
      "text": "cho chúng đều xấu hổ nhục nhằn !",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 63,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.708Z",
      "updatedAt": "2025-09-03T02:28:00.708Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "4ed44f76-81f7-4d63-937c-b53de28ecef5",
      "text": "Những kẻ lên mặt với con,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 2,
      "paragraphNumber": 64,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.730Z",
      "updatedAt": "2025-09-03T02:28:00.730Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "e16df54d-e288-48b5-8c1a-23448ae99c73",
      "text": "cho chúng phải ê chề nhuốc nha xấu hổ !",
      "label": "26",
      "number": 26,
      "subVerseIndex": 3,
      "paragraphNumber": 65,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.740Z",
      "updatedAt": "2025-09-03T02:28:00.740Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "55d632f9-5a93-49ba-90cd-ebb4ea79414a",
      "text": "Còn những người nào muốn thấy con được minh oan,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 66,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.751Z",
      "updatedAt": "2025-09-03T02:28:00.751Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "657f47f9-2600-4520-8a92-91462662aa39",
      "text": "chớ gì họ reo mừng hoan hỷ,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 67,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.762Z",
      "updatedAt": "2025-09-03T02:28:00.762Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "fcbe2ec9-27c0-493e-bd1f-f14404b5f6aa",
      "text": "và luôn luôn nói rằng : “ĐỨC CHÚA vĩ đại thay !",
      "label": "27",
      "number": 27,
      "subVerseIndex": 2,
      "paragraphNumber": 68,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.774Z",
      "updatedAt": "2025-09-03T02:28:00.774Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "c2334230-c4de-49ac-9d5e-a3bc8ac9f104",
      "text": "Người những muốn kẻ tôi trung được an lành.”",
      "label": "27",
      "number": 27,
      "subVerseIndex": 3,
      "paragraphNumber": 69,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.802Z",
      "updatedAt": "2025-09-03T02:28:00.802Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "c9543070-2b51-4f24-bb83-5b71fb039ec1",
      "text": "Miệng lưỡi con sẽ nhẩm đi nhắc lại : “Ngài là Đấng công chính”",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 70,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.816Z",
      "updatedAt": "2025-09-03T02:28:00.816Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    },
    {
      "id": "694c6f7b-0954-4968-8c4f-0cbabd37103f",
      "text": "và suốt ngày, con sẽ ca ngợi tán dương.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 1,
      "paragraphNumber": 71,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:00.830Z",
      "updatedAt": "2025-09-03T02:28:00.830Z",
      "chapterId": "bec2e8a1-2e86-496f-a6d8-9c9c6940b7da"
    }
  ],
