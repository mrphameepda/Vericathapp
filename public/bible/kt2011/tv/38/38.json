{
  "chapter": {
    "id": "11b45056-c374-40d4-927a-c72c0e26084d",
    "number": 38,
    "createdAt": "2025-09-03T01:07:51.660Z",
    "updatedAt": "2025-09-03T01:07:51.660Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "7d07d86b-14ec-47fa-9d41-b968edbd946e",
      "text": "*Thánh vịnh. Của vua Đa-vít. Để tưởng nhớ.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:28:18.389Z",
      "updatedAt": "2025-09-03T02:28:18.389Z",
      "chapterId": "11b45056-c374-40d4-927a-c72c0e26084d"
    },
    {
      "id": "0b0c5abf-105d-4f14-9c06-a62d1f991e4a",
      "text": "Lạy CHÚA, xin đừng trách mắng con khi thịnh nộ,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:18.440Z",
      "updatedAt": "2025-09-03T02:28:18.440Z",
      "chapterId": "11b45056-c374-40d4-927a-c72c0e26084d"
    },
    {
      "id": "6524585d-4b29-43be-a56a-58fbb8a60818",
      "text": "đừng sửa trị con lúc nổi lôi đình.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:18.452Z",
      "updatedAt": "2025-09-03T02:28:18.452Z",
      "chapterId": "11b45056-c374-40d4-927a-c72c0e26084d"
    },
    {
      "id": "cf8823d8-5510-46ad-add1-4354d3e800cd",
      "text": "Trên mình con, những mũi tên Ngài cắm ngập,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:18.466Z",
      "updatedAt": "2025-09-03T02:28:18.466Z",
      "chapterId": "11b45056-c374-40d4-927a-c72c0e26084d"
    },
    {
      "id": "7dd80466-870d-447c-a7eb-c727c4838fc2",
      "text": "bàn tay Ngài giáng nặng xuống thân con.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:18.494Z",
      "updatedAt": "2025-09-03T02:28:18.494Z",
      "chapterId": "11b45056-c374-40d4-927a-c72c0e26084d"
    },
    {
      "id": "10d689bc-a2db-449e-849f-e4dc2ab15932",
      "text": "Chính vì Chúa giận, mà da thịt con không chỗ nào lành ;",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:18.509Z",
      "updatedAt": "2025-09-03T02:28:18.509Z",
      "chapterId": "11b45056-c374-40d4-927a-c72c0e26084d"
    },
    {
      "id": "d5129726-67b9-44d1-8634-2a8f21bb4993",
      "text": "vì tội lỗi của con, mà xương con chẳng nơi đâu nguyên vẹn.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:18.523Z",
      "updatedAt": "2025-09-03T02:28:18.523Z",
      "chapterId": "11b45056-c374-40d4-927a-c72c0e26084d"
    },
    {
      "id": "97e34505-19c0-4f54-9706-f52a4575120b",
      "text": "Tội chồng chất ngập đầu ngập cổ",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:18.552Z",
      "updatedAt": "2025-09-03T02:28:18.552Z",
      "chapterId": "11b45056-c374-40d4-927a-c72c0e26084d"
    },
    {
      "id": "28b4924c-ce63-4114-9825-978494046f5b",
      "text": "như gánh nặng vượt quá sức con.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:18.566Z",
      "updatedAt": "2025-09-03T02:28:18.566Z",
      "chapterId": "11b45056-c374-40d4-927a-c72c0e26084d"
    },
    {
      "id": "19a5f507-2a45-41c8-a620-99dce1c54aa4",
      "text": "Vết thương con nặng mùi, rữa nát",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:18.580Z",
      "updatedAt": "2025-09-03T02:28:18.580Z",
      "chapterId": "11b45056-c374-40d4-927a-c72c0e26084d"
    },
    {
      "id": "09c37b11-8426-4743-8607-b72b739eed39",
      "text": "bởi vì con điên cuồng ;",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:18.595Z",
      "updatedAt": "2025-09-03T02:28:18.595Z",
      "chapterId": "11b45056-c374-40d4-927a-c72c0e26084d"
    },
    {
      "id": "7e2a134e-9edb-4bfb-bdc6-fe9684c2e1ba",
      "text": "thân lom khom, rã rời, kiệt sức,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:18.609Z",
      "updatedAt": "2025-09-03T02:28:18.609Z",
      "chapterId": "11b45056-c374-40d4-927a-c72c0e26084d"
    },
    {
      "id": "142f555c-0487-46f2-9b2e-70252bd2cc24",
      "text": "suốt cả ngày con thiểu não lang thang.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:18.623Z",
      "updatedAt": "2025-09-03T02:28:18.623Z",
      "chapterId": "11b45056-c374-40d4-927a-c72c0e26084d"
    },
    {
      "id": "71172d51-c4bd-4394-8706-6daa55b8bed7",
      "text": "Ngang lưng đầy lửa bỏng, da thịt con không chỗ nào lành.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:18.636Z",
      "updatedAt": "2025-09-03T02:28:18.636Z",
      "chapterId": "11b45056-c374-40d4-927a-c72c0e26084d"
    },
    {
      "id": "11e4a47b-ab89-4e9a-83e5-0c4914aadc65",
      "text": "Bị suy nhược, nát tan, kiệt sức,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:18.650Z",
      "updatedAt": "2025-09-03T02:28:18.650Z",
      "chapterId": "11b45056-c374-40d4-927a-c72c0e26084d"
    },
    {
      "id": "07a207da-1edf-4603-9407-380d552f4a40",
      "text": "tim thét gào thì miệng phải rống lên.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:18.665Z",
      "updatedAt": "2025-09-03T02:28:18.665Z",
      "chapterId": "11b45056-c374-40d4-927a-c72c0e26084d"
    },
    {
      "id": "b46f1c3d-3ce9-4236-95c5-4f92b0642646",
      "text": "Lạy Chúa, ước vọng của con, Chúa đều thấu tỏ,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:18.681Z",
      "updatedAt": "2025-09-03T02:28:18.681Z",
      "chapterId": "11b45056-c374-40d4-927a-c72c0e26084d"
    },
    {
      "id": "ee3b3234-386e-49e4-9452-693b221463ed",
      "text": "tiếng con than thở, làm sao Chúa chẳng tường !",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:18.695Z",
      "updatedAt": "2025-09-03T02:28:18.695Z",
      "chapterId": "11b45056-c374-40d4-927a-c72c0e26084d"
    },
    {
      "id": "6491e354-4fa3-4088-a3cd-b90e56267542",
      "text": "Tim hồi hộp, sức con đã kiệt,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:18.709Z",
      "updatedAt": "2025-09-03T02:28:18.709Z",
      "chapterId": "11b45056-c374-40d4-927a-c72c0e26084d"
    },
    {
      "id": "8474598f-13d6-4b7c-a424-68e6c56eee62",
      "text": "mắt cũng chẳng còn sáng như xưa.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:18.722Z",
      "updatedAt": "2025-09-03T02:28:18.722Z",
      "chapterId": "11b45056-c374-40d4-927a-c72c0e26084d"
    },
    {
      "id": "82e0b8ed-306c-402c-b3c8-8c1fd52ab224",
      "text": "Con bị tai ương, người thân kẻ nghĩa chẳng tới gần,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:18.736Z",
      "updatedAt": "2025-09-03T02:28:18.736Z",
      "chapterId": "11b45056-c374-40d4-927a-c72c0e26084d"
    },
    {
      "id": "8c053f38-104e-4394-8aaa-cf6873073842",
      "text": "bà con ruột thịt cũng đứng xa.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:18.765Z",
      "updatedAt": "2025-09-03T02:28:18.765Z",
      "chapterId": "11b45056-c374-40d4-927a-c72c0e26084d"
    },
    {
      "id": "b8b73941-e910-4d99-9ec7-89e68a88526d",
      "text": "Kẻ tìm giết con bủa giăng cạm bẫy,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:18.779Z",
      "updatedAt": "2025-09-03T02:28:18.779Z",
      "chapterId": "11b45056-c374-40d4-927a-c72c0e26084d"
    },
    {
      "id": "57347473-92e3-4331-8bce-a982515e3735",
      "text": "đứa mưu hại con buông lời độc địa,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:18.807Z",
      "updatedAt": "2025-09-03T02:28:18.807Z",
      "chapterId": "11b45056-c374-40d4-927a-c72c0e26084d"
    },
    {
      "id": "35953a3a-d453-4261-ab64-8bdf9633179b",
      "text": "suốt ngày chúng nghĩ kế phỉnh gạt con.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:18.827Z",
      "updatedAt": "2025-09-03T02:28:18.827Z",
      "chapterId": "11b45056-c374-40d4-927a-c72c0e26084d"
    },
    {
      "id": "152d58da-2e8c-4b8e-b617-4bcc710554fb",
      "text": "Phần con, như kẻ điếc chẳng nghe gì,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:18.842Z",
      "updatedAt": "2025-09-03T02:28:18.842Z",
      "chapterId": "11b45056-c374-40d4-927a-c72c0e26084d"
    },
    {
      "id": "010d77a7-4ecc-4c6d-8c65-50c91762bc2f",
      "text": "tựa người câm, không hề mở miệng,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:18.856Z",
      "updatedAt": "2025-09-03T02:28:18.856Z",
      "chapterId": "11b45056-c374-40d4-927a-c72c0e26084d"
    },
    {
      "id": "25c26f66-1d47-46b0-936b-09b87e3e5932",
      "text": "cầm bằng kẻ không nghe chi hết,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:18.870Z",
      "updatedAt": "2025-09-03T02:28:18.870Z",
      "chapterId": "11b45056-c374-40d4-927a-c72c0e26084d"
    },
    {
      "id": "6670803d-ba8b-4968-a302-879a902048bb",
      "text": "chẳng một lời đối đáp ngoài môi.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:18.887Z",
      "updatedAt": "2025-09-03T02:28:18.887Z",
      "chapterId": "11b45056-c374-40d4-927a-c72c0e26084d"
    },
    {
      "id": "bdfbddc9-7a11-4240-ad9a-1bf550c1636c",
      "text": "Lạy CHÚA, nơi Ngài con trông cậy ;",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:18.901Z",
      "updatedAt": "2025-09-03T02:28:18.901Z",
      "chapterId": "11b45056-c374-40d4-927a-c72c0e26084d"
    },
    {
      "id": "a10d73f5-a94e-4358-9336-c24baa193dc3",
      "text": "lạy Chúa là Thiên Chúa của con, chính Chúa sẽ đáp lời.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:18.916Z",
      "updatedAt": "2025-09-03T02:28:18.916Z",
      "chapterId": "11b45056-c374-40d4-927a-c72c0e26084d"
    },
    {
      "id": "ad946a57-5c88-4906-a108-2e316889616f",
      "text": "Con nói : “Ước gì bọn chúng đừng đắc chí nhạo cười con,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:18.931Z",
      "updatedAt": "2025-09-03T02:28:18.931Z",
      "chapterId": "11b45056-c374-40d4-927a-c72c0e26084d"
    },
    {
      "id": "123d0dcd-4d59-47ee-8e56-5ad9b3a74b21",
      "text": "cũng đừng lên mặt khi chân con lảo đảo.”",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:18.960Z",
      "updatedAt": "2025-09-03T02:28:18.960Z",
      "chapterId": "11b45056-c374-40d4-927a-c72c0e26084d"
    },
    {
      "id": "b9c1a2d4-b6dc-4ec0-955f-7d0e1b26e104",
      "text": "Thật thì con đã gần quỵ ngã,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:18.974Z",
      "updatedAt": "2025-09-03T02:28:18.974Z",
      "chapterId": "11b45056-c374-40d4-927a-c72c0e26084d"
    },
    {
      "id": "fe3a2570-001e-4b19-9c8e-6e59e8a25367",
      "text": "nỗi khổ đau hằng canh cánh bên lòng.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:18.988Z",
      "updatedAt": "2025-09-03T02:28:18.988Z",
      "chapterId": "11b45056-c374-40d4-927a-c72c0e26084d"
    },
    {
      "id": "a600adc8-87ac-4c9d-932b-56265096c2a3",
      "text": "Tội đã phạm, con xin xưng thú,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:19.003Z",
      "updatedAt": "2025-09-03T02:28:19.003Z",
      "chapterId": "11b45056-c374-40d4-927a-c72c0e26084d"
    },
    {
      "id": "cc9906d2-cb79-43b1-b8cf-4e03aea3e044",
      "text": "lỗi lầm vương phải, con áy náy băn khoăn.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:19.032Z",
      "updatedAt": "2025-09-03T02:28:19.032Z",
      "chapterId": "11b45056-c374-40d4-927a-c72c0e26084d"
    },
    {
      "id": "eebba58a-45ba-409c-8f61-ab72abe8e57e",
      "text": "Kẻ vô cớ thù con đều mạnh thế,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:19.045Z",
      "updatedAt": "2025-09-03T02:28:19.045Z",
      "chapterId": "11b45056-c374-40d4-927a-c72c0e26084d"
    },
    {
      "id": "3f86ccb6-9c33-4b3a-9a5c-2c68b9abcb33",
      "text": "người vô lý ghét con thật quá nhiều !",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:19.059Z",
      "updatedAt": "2025-09-03T02:28:19.059Z",
      "chapterId": "11b45056-c374-40d4-927a-c72c0e26084d"
    },
    {
      "id": "f89d5891-6b9d-4a33-ad0c-fdaf8cc191b4",
      "text": "Con làm ơn thì chúng trả oán,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:19.073Z",
      "updatedAt": "2025-09-03T02:28:19.073Z",
      "chapterId": "11b45056-c374-40d4-927a-c72c0e26084d"
    },
    {
      "id": "fb6f7106-831b-4763-b399-ef093b35e6c6",
      "text": "con theo đuổi điều lành, chúng lại tố cáo con.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:19.100Z",
      "updatedAt": "2025-09-03T02:28:19.100Z",
      "chapterId": "11b45056-c374-40d4-927a-c72c0e26084d"
    },
    {
      "id": "572be582-8c04-4246-9906-bb35a1d060a1",
      "text": "Muôn lạy CHÚA, xin đừng bỏ mặc,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:19.113Z",
      "updatedAt": "2025-09-03T02:28:19.113Z",
      "chapterId": "11b45056-c374-40d4-927a-c72c0e26084d"
    },
    {
      "id": "1b5c9b7c-aa10-41c3-af95-89cf0e777761",
      "text": "đừng nỡ xa con, lạy Thiên Chúa con thờ.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:19.140Z",
      "updatedAt": "2025-09-03T02:28:19.140Z",
      "chapterId": "11b45056-c374-40d4-927a-c72c0e26084d"
    },
    {
      "id": "583b22b8-2525-4f87-a525-4eabf81a5b2a",
      "text": "Lạy Chúa cứu độ con, xin Ngài mau phù trợ.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:19.153Z",
      "updatedAt": "2025-09-03T02:28:19.153Z",
      "chapterId": "11b45056-c374-40d4-927a-c72c0e26084d"
    }
  ],
  "marks": [
    {
      "id": "b82b38db-b944-4afe-98dc-c48a21bd64ee",
      "content": "Tv này là *một ai ca của cá nhân*, là *Tv* thứ ba trong bảy Tv *sám hối* (Tv 6 ; 32 ; 38 ; 51 ; 102 ; 130 ; 143). Lâm bệnh nặng (có lẽ đó là bệnh phong : x. 4.6.8.11.12), tác giả Thánh vịnh chạy đến cùng Thiên Chúa, tâm hồn tràn ngập niềm tin tưởng. Tác giả cũng không ngại công khai xưng thú tội lỗi mình ra (c.19). Tội lỗi ấy đã khiến Thiên Chúa phải nổi cơn thịnh nộ. Mặc dầu thế, tác giả vẫn nài xin Thiên Chúa đừng bỏ rơi mình và mau đến phù trợ. Tv này chia làm bốn phần : **1**) Nỗi đau khổ của tác giả do bệnh tật và tội lỗi gây ra (cc. 2-9) ; **2**) Phản ứng của những người khác và của tác giả (cc. 10-15) ; **3**) Tác giả lặp lại các chủ đề : đau khổ, tội lỗi, đối phương (cc. 16-21) ; **4**) Cầu xin Thiên Chúa đến phù trợ (cc. 22-23).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 54,
      "endOffset": 54,
      "createdAt": "2025-09-03T02:28:18.418Z",
