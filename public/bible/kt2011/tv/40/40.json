{
  "chapter": {
    "id": "f023ff04-e754-4500-826b-76f128e1e776",
    "number": 40,
    "createdAt": "2025-09-03T01:07:51.660Z",
    "updatedAt": "2025-09-03T01:07:51.660Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "09fb9b2a-0fb1-46b7-aef8-4f43b94ff0f8",
      "text": "*Phần ca trưởng. Của vua Đa-vít. Thánh vịnh.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:28:31.386Z",
      "updatedAt": "2025-09-03T02:28:31.386Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "0b346b09-d275-40c3-99a7-084b820e4f53",
      "text": "Tôi đã hết lòng trông đợi CHÚA,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:31.447Z",
      "updatedAt": "2025-09-03T02:28:31.447Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "6d50583c-bb12-4e8c-b9b2-f4a02cbc9747",
      "text": "Người nghiêng mình xuống và nghe tiếng tôi kêu.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:31.459Z",
      "updatedAt": "2025-09-03T02:28:31.459Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "78874d66-28a8-4b5f-a9aa-9b1b1e8f7082",
      "text": "Người kéo tôi ra khỏi hố diệt vong,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:31.471Z",
      "updatedAt": "2025-09-03T02:28:31.471Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "b89a1049-0966-4584-a662-80b11b34deeb",
      "text": "khỏi vũng lầy nhơ nhớp,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:31.486Z",
      "updatedAt": "2025-09-03T02:28:31.486Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "21a52eea-dd60-4670-b938-56ae4e722002",
      "text": "đặt chân tôi đứng trên tảng đá,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:31.535Z",
      "updatedAt": "2025-09-03T02:28:31.535Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "fe215a5e-31f9-4941-bb30-e91bd6b57928",
      "text": "làm cho tôi bước đi vững vàng.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 3,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:31.548Z",
      "updatedAt": "2025-09-03T02:28:31.548Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "97f3131b-7832-4ce6-b78c-f299d53e0aa7",
      "text": "Chúa cho miệng tôi hát bài ca mới,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:31.566Z",
      "updatedAt": "2025-09-03T02:28:31.566Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "9f30e184-bbb4-4a40-8b05-e26806ba27e2",
      "text": "bài ca tụng Thiên Chúa chúng ta.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:31.594Z",
      "updatedAt": "2025-09-03T02:28:31.594Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "456e2a9b-7187-4368-8b41-6919e80f6f46",
      "text": "Thấy thế, nhiều người sẽ kính sợ",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:31.608Z",
      "updatedAt": "2025-09-03T02:28:31.608Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "af0d6d1c-2688-4020-bd27-f5c831c1776e",
      "text": "và tin tưởng vào CHÚA.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 3,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:31.622Z",
      "updatedAt": "2025-09-03T02:28:31.622Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "dcc710dd-f0a9-4ffe-a166-76a90fede610",
      "text": "Phúc thay người đặt tin tưởng nơi CHÚA,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:31.639Z",
      "updatedAt": "2025-09-03T02:28:31.639Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "17f13242-6f03-4f86-9f0d-3717d83e2d69",
      "text": "chẳng vào hùa với bọn kiêu căng",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:31.667Z",
      "updatedAt": "2025-09-03T02:28:31.667Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "81800b4f-3eab-4f02-81d1-6e6fba5cdf46",
      "text": "và những kẻ theo đường gian ác.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:31.682Z",
      "updatedAt": "2025-09-03T02:28:31.682Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "f82e28fc-5049-41bc-8260-7b2a05548984",
      "text": "Lạy CHÚA là Thiên Chúa con thờ,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:31.696Z",
      "updatedAt": "2025-09-03T02:28:31.696Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "877fb246-a1c7-4bde-8b34-82da89aff4e7",
      "text": "những kỳ công Ngài đã thực hiện",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:31.711Z",
      "updatedAt": "2025-09-03T02:28:31.711Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "d5593c63-afdd-4a5f-abf2-88936d400a06",
      "text": "và những điều Ngài dự định cho chúng con :",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:31.725Z",
      "updatedAt": "2025-09-03T02:28:31.725Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "890ee06f-3146-4ca3-900f-b110989fd125",
      "text": "thật là nhiều vô kể !",
      "label": "6",
      "number": 6,
      "subVerseIndex": 3,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:31.740Z",
      "updatedAt": "2025-09-03T02:28:31.740Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "f390b490-65bc-44b1-bd50-a27c78367710",
      "text": "Không một ai sánh được như Ngài.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 4,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:31.754Z",
      "updatedAt": "2025-09-03T02:28:31.754Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "3f21456a-e73f-46a2-8b2a-23d2c2831a78",
      "text": "Dầu con muốn loan đi kể lại,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 5,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:31.774Z",
      "updatedAt": "2025-09-03T02:28:31.774Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "e1966ed3-94e5-4087-8de4-17889473e804",
      "text": "nhưng quá nhiều, đếm nổi làm sao !",
      "label": "6",
      "number": 6,
      "subVerseIndex": 6,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:31.788Z",
      "updatedAt": "2025-09-03T02:28:31.788Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "1b1c689e-836f-47ec-b999-d897c8ebf0cd",
      "text": "Chúa chẳng thích gì tế phẩm và lễ vật,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:31.805Z",
      "updatedAt": "2025-09-03T02:28:31.805Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "bb759508-ef24-49bb-b101-b8b9b39cb3de",
      "text": "nhưng đã mở tai con ;",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:31.834Z",
      "updatedAt": "2025-09-03T02:28:31.834Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "4166f6ef-a5f1-4249-835e-207ccd4d5603",
      "text": "lễ toàn thiêu và lễ xá tội, Chúa không đòi,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:31.849Z",
      "updatedAt": "2025-09-03T02:28:31.849Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "fa1d4b73-3ba3-4074-89a0-d73721983557",
      "text": "con liền thưa : “Này con xin đến !",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:31.877Z",
      "updatedAt": "2025-09-03T02:28:31.877Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "b77d40f5-6844-4bba-90b9-82ace713c87f",
      "text": "Trong sách có lời chép về con",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:31.891Z",
      "updatedAt": "2025-09-03T02:28:31.891Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "fc61bff6-cb84-485a-9572-13901f2fba15",
      "text": "rằng : con thích làm theo thánh ý,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:31.905Z",
      "updatedAt": "2025-09-03T02:28:31.905Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "69d1d31b-8380-4101-a3e8-d290063594a6",
      "text": "và ấp ủ luật Chúa trong lòng, lạy Thiên Chúa của con.”",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:31.922Z",
      "updatedAt": "2025-09-03T02:28:31.922Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "445041ca-9589-48ea-9fc1-f5b05098bde1",
      "text": "Đức công chính của Ngài,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:31.940Z",
      "updatedAt": "2025-09-03T02:28:31.940Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "258a4517-8eb7-4b51-a1f0-9add30604a46",
      "text": "con loan truyền giữa lòng đại hội ;",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:31.955Z",
      "updatedAt": "2025-09-03T02:28:31.955Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "1c28fd76-2203-4971-8ec3-4ed4d4329453",
      "text": "lạy CHÚA, Ngài từng biết : con đâu có ngậm miệng làm thinh.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:31.983Z",
      "updatedAt": "2025-09-03T02:28:31.983Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "f8c09e29-64d5-4e7e-a746-f9cd415c139b",
      "text": "Đức công chính của Ngài,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:32.001Z",
      "updatedAt": "2025-09-03T02:28:32.001Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "7f77645f-539f-4a43-a35e-9740197c1c09",
      "text": "con chẳng giữ riêng lòng mình biết ;",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:32.014Z",
      "updatedAt": "2025-09-03T02:28:32.014Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "8d4ac0dc-2009-4a86-8689-d04e8aa7cd76",
      "text": "nhưng con đã nói lên đức trung tín và ơn cứu độ của Ngài,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:32.028Z",
      "updatedAt": "2025-09-03T02:28:32.028Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "21898e06-cb04-499e-94dc-43375a1481a1",
      "text": "chẳng giấu giếm chi cùng đại hội",
      "label": "11",
      "number": 11,
      "subVerseIndex": 3,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:32.043Z",
      "updatedAt": "2025-09-03T02:28:32.043Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "935e317f-069a-41a8-a976-7ee69293f4e7",
      "text": "rằng Ngài thành tín và yêu thương.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 4,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:32.057Z",
      "updatedAt": "2025-09-03T02:28:32.057Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "627cd9b5-0c6b-4328-9b9b-43879011c455",
      "text": "Phần Ngài, muôn lạy CHÚA,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:32.071Z",
      "updatedAt": "2025-09-03T02:28:32.071Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "3bb63644-15fd-4c9c-946b-776294bb3820",
      "text": "xin chớ ngừng âu yếm cảm thương con.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:32.085Z",
      "updatedAt": "2025-09-03T02:28:32.085Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "d294954f-9a93-497c-8445-c5d80ff28498",
      "text": "Lòng thành tín và yêu thương của Ngài sẽ giữ gìn con mãi.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:32.099Z",
      "updatedAt": "2025-09-03T02:28:32.099Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "c5ed36ae-4cf9-42b8-92d1-d08c54ecc881",
      "text": "Tai hoạ bủa vây con hằng hà sa số,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:32.113Z",
      "updatedAt": "2025-09-03T02:28:32.113Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "8f2f63c1-a2aa-42e6-b897-8f4505df1d28",
      "text": "tội ác con đổ xuống trên mình, làm tối tăm mặt mũi,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:32.125Z",
      "updatedAt": "2025-09-03T02:28:32.125Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "4befe6bc-f1ef-4e96-b113-43d70979f904",
      "text": "thật nhiều hơn cả tóc trên đầu, khiến rụng rời tâm trí.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:32.138Z",
      "updatedAt": "2025-09-03T02:28:32.138Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "61acc6ba-c283-4cbc-b8d5-3401679f572e",
      "text": "Lạy CHÚA, xin thương tình cứu con,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:32.151Z",
      "updatedAt": "2025-09-03T02:28:32.151Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "915f2365-942d-4ff8-8cdd-3d48be754775",
      "text": "muôn lạy CHÚA, xin mau phù trợ !",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:32.193Z",
      "updatedAt": "2025-09-03T02:28:32.193Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "67a828a6-8126-4142-a5cf-c322919ea349",
      "text": "Ước gì những kẻ tìm cướp mạng sống con,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:32.209Z",
      "updatedAt": "2025-09-03T02:28:32.209Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "c6a8ae5e-43cb-4575-a3b2-d96f3ca09b73",
      "text": "đều phải nhơ nhuốc thẹn thùng !",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:32.222Z",
      "updatedAt": "2025-09-03T02:28:32.222Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "43c58455-1514-4086-ad5d-a2b04d8ce276",
      "text": "Ước gì bọn đắc chí vì con mắc hoạ",
      "label": "15",
      "number": 15,
      "subVerseIndex": 2,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:32.236Z",
      "updatedAt": "2025-09-03T02:28:32.236Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "83fbc2c2-95b0-4ea2-8bd7-7eed7c244c9f",
      "text": "phải tháo lui nhục nhã !",
      "label": "15",
      "number": 15,
      "subVerseIndex": 3,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:32.251Z",
      "updatedAt": "2025-09-03T02:28:32.251Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "130cfc73-11c4-452f-a460-c78705b32a97",
      "text": "Những đứa cười ha hả nhạo con",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:32.265Z",
      "updatedAt": "2025-09-03T02:28:32.265Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "638bac7a-bfd9-4385-bd0b-a32e8d99da27",
      "text": "phải thẹn thùng chết điếng !",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:32.292Z",
      "updatedAt": "2025-09-03T02:28:32.292Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "ccf888b3-6e67-4d46-9517-a5b853629356",
      "text": "Ước chi mọi kẻ tìm kiếm Chúa,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:32.308Z",
      "updatedAt": "2025-09-03T02:28:32.308Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "8fa6199e-f2f3-413d-94fb-deb7f3870630",
      "text": "đều mừng vui hoan hỷ trong Ngài !",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:32.322Z",
      "updatedAt": "2025-09-03T02:28:32.322Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "eb293f1a-e343-4a5a-81e7-f0b25a935ca8",
      "text": "Và những ai cảm mến ơn Ngài tế độ",
      "label": "17",
      "number": 17,
      "subVerseIndex": 2,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:32.336Z",
      "updatedAt": "2025-09-03T02:28:32.336Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "36681677-df0e-4373-9e9f-cfc69866580e",
      "text": "luôn nói rằng : “ĐỨC CHÚA vĩ đại thay !”",
      "label": "17",
      "number": 17,
      "subVerseIndex": 3,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:32.350Z",
      "updatedAt": "2025-09-03T02:28:32.350Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "6d83043e-49f0-43b5-8e31-ad971a55e06f",
      "text": "Thân phận con khốn khổ nghèo hèn,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:32.378Z",
      "updatedAt": "2025-09-03T02:28:32.378Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "2133ee54-8efb-4a96-ab3e-fbf39a449bfa",
      "text": "nhưng Chúa hằng nghĩ tới.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:32.393Z",
      "updatedAt": "2025-09-03T02:28:32.393Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "f14a53b6-ed7e-4f50-9046-e497be8bfc12",
      "text": "Ngài là Đấng phù trợ, là Đấng giải thoát con,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 2,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:32.406Z",
      "updatedAt": "2025-09-03T02:28:32.406Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    },
    {
      "id": "3add06f8-8a84-4c92-ae95-c5e25169615a",
      "text": "lạy Thiên Chúa con thờ, xin đừng trì hoãn !",
      "label": "18",
      "number": 18,
      "subVerseIndex": 3,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:32.419Z",
      "updatedAt": "2025-09-03T02:28:32.419Z",
      "chapterId": "f023ff04-e754-4500-826b-76f128e1e776"
    }
  ],
