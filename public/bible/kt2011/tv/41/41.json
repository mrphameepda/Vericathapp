    {
      "id": "2fcb20af-7e83-4223-a951-3893e5d8df31",
      "content": "Tv 31,12-14",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 0,
      "endOffset": 0,
