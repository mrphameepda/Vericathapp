{
  "chapter": {
    "id": "26009c7d-9170-4d00-949f-f29f8da053de",
    "number": 41,
    "createdAt": "2025-09-03T01:07:51.660Z",
    "updatedAt": "2025-09-03T01:07:51.660Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "55c751ca-3e44-4160-99a9-2fab0b0688ed",
      "text": "*Phần ca trưởng. Thánh vịnh. Của vua Đa-vít.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:28:38.462Z",
      "updatedAt": "2025-09-03T02:28:38.462Z",
      "chapterId": "26009c7d-9170-4d00-949f-f29f8da053de"
    },
    {
      "id": "57ccca86-b404-4924-982b-d00b4ca4434f",
      "text": "Phúc thay kẻ lưu tâm đến người nghèo khổ :",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:38.521Z",
      "updatedAt": "2025-09-03T02:28:38.521Z",
      "chapterId": "26009c7d-9170-4d00-949f-f29f8da053de"
    },
    {
      "id": "8ecc0ee9-00bd-4845-9149-40d2d96aa847",
      "text": "trong ngày hoạn nạn, sẽ được CHÚA cứu nguy.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:38.535Z",
      "updatedAt": "2025-09-03T02:28:38.535Z",
      "chapterId": "26009c7d-9170-4d00-949f-f29f8da053de"
    },
    {
      "id": "cd0634ea-9372-4e3d-b392-4dbd76e89c14",
      "text": "CHÚA bảo vệ và giữ gìn mạng sống,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:38.549Z",
      "updatedAt": "2025-09-03T02:28:38.549Z",
      "chapterId": "26009c7d-9170-4d00-949f-f29f8da053de"
    },
    {
      "id": "74eafadd-89f9-458e-badc-69afcbce5195",
      "text": "lại ban cho hạnh phúc trên đời,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:38.564Z",
      "updatedAt": "2025-09-03T02:28:38.564Z",
      "chapterId": "26009c7d-9170-4d00-949f-f29f8da053de"
    },
    {
      "id": "e00440c5-4d72-4751-86d4-b3c01254dc58",
      "text": "không trao họ cho địch thù hung hãn.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:38.578Z",
      "updatedAt": "2025-09-03T02:28:38.578Z",
      "chapterId": "26009c7d-9170-4d00-949f-f29f8da053de"
    },
    {
      "id": "22f80b8f-f27a-4213-883f-abd2fcee52da",
      "text": "Người chăm nom khi liệt giường liệt chiếu,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:38.609Z",
      "updatedAt": "2025-09-03T02:28:38.609Z",
      "chapterId": "26009c7d-9170-4d00-949f-f29f8da053de"
    },
    {
      "id": "ae66cfc9-eea3-44cc-830b-bb0ffddcde2e",
      "text": "lúc bệnh hoạn, Người chữa cho lành.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:38.623Z",
      "updatedAt": "2025-09-03T02:28:38.623Z",
      "chapterId": "26009c7d-9170-4d00-949f-f29f8da053de"
    },
    {
      "id": "4fb2454e-2a9e-4474-8d1e-c3c19ed457a5",
      "text": "Con đã thưa cùng Chúa :",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:38.637Z",
      "updatedAt": "2025-09-03T02:28:38.637Z",
      "chapterId": "26009c7d-9170-4d00-949f-f29f8da053de"
    },
    {
      "id": "c22430eb-2de0-4c19-ab10-97caa3e91c85",
      "text": "Lạy CHÚA, xin thương xót và chữa lành con,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:38.652Z",
      "updatedAt": "2025-09-03T02:28:38.652Z",
      "chapterId": "26009c7d-9170-4d00-949f-f29f8da053de"
    },
    {
      "id": "d00bc846-fc4b-441e-9e35-5d1669ad2da9",
      "text": "quả thật con đắc tội với Ngài.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:38.666Z",
      "updatedAt": "2025-09-03T02:28:38.666Z",
      "chapterId": "26009c7d-9170-4d00-949f-f29f8da053de"
    },
    {
      "id": "164c2af4-56b1-40f8-83f0-e5fc39fa974a",
      "text": "Lũ địch thù buông câu nguyền rủa",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:38.697Z",
      "updatedAt": "2025-09-03T02:28:38.697Z",
      "chapterId": "26009c7d-9170-4d00-949f-f29f8da053de"
    },
    {
      "id": "b86bec92-3fd7-4cf4-b1db-b80db105da3e",
      "text": "bao giờ nó mới chết, cho tên tuổi xoá nhoà ?",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:38.726Z",
      "updatedAt": "2025-09-03T02:28:38.726Z",
      "chapterId": "26009c7d-9170-4d00-949f-f29f8da053de"
    },
    {
      "id": "6816ed59-3d7d-4232-be3a-63550418e2f0",
      "text": "Kẻ đến thăm, miệng nói lời giả dối,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:38.741Z",
      "updatedAt": "2025-09-03T02:28:38.741Z",
      "chapterId": "26009c7d-9170-4d00-949f-f29f8da053de"
    },
    {
      "id": "4afabf89-e137-4bb7-bcee-f201b5514e3e",
      "text": "nhưng chủ ý thâu tin độc địa,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:38.755Z",
      "updatedAt": "2025-09-03T02:28:38.755Z",
      "chapterId": "26009c7d-9170-4d00-949f-f29f8da053de"
    },
    {
      "id": "999ec928-9335-4300-8373-0d273962d013",
      "text": "vừa ra khỏi nhà, đã vội rêu rao.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:38.769Z",
      "updatedAt": "2025-09-03T02:28:38.769Z",
      "chapterId": "26009c7d-9170-4d00-949f-f29f8da053de"
    },
    {
      "id": "61d593c2-4461-4aaf-98f6-fdadb69350e6",
      "text": "Mọi kẻ ghét con đều bàn tán thì thào,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:38.782Z",
      "updatedAt": "2025-09-03T02:28:38.782Z",
      "chapterId": "26009c7d-9170-4d00-949f-f29f8da053de"
    },
    {
      "id": "9b9808a1-8727-436a-9c59-fb26f7c9bb37",
      "text": "tưởng tượng con mắc bệnh gì ghê gớm :",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:38.796Z",
      "updatedAt": "2025-09-03T02:28:38.796Z",
      "chapterId": "26009c7d-9170-4d00-949f-f29f8da053de"
    },
    {
      "id": "03f9c067-d030-4903-9eac-476277c84640",
      "text": "“Chứng nan y thâm nhập nó rồi,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:38.811Z",
      "updatedAt": "2025-09-03T02:28:38.811Z",
      "chapterId": "26009c7d-9170-4d00-949f-f29f8da053de"
    },
    {
      "id": "6fa43e9c-bf61-4e44-bca3-95957a60c181",
      "text": "đã liệt giường là không dậy nổi đâu !”",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:38.826Z",
      "updatedAt": "2025-09-03T02:28:38.826Z",
      "chapterId": "26009c7d-9170-4d00-949f-f29f8da053de"
    },
    {
      "id": "65a4b5c9-cba0-443b-b81d-44c11dd6dece",
      "text": "Cả người bạn thân con hằng tin cậy,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:38.840Z",
      "updatedAt": "2025-09-03T02:28:38.840Z",
      "chapterId": "26009c7d-9170-4d00-949f-f29f8da053de"
    },
    {
      "id": "a945cd14-be96-4717-8017-21b89e54cb2b",
      "text": "đã cùng con chia cơm sẻ bánh,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:38.868Z",
      "updatedAt": "2025-09-03T02:28:38.868Z",
      "chapterId": "26009c7d-9170-4d00-949f-f29f8da053de"
    },
    {
      "id": "9e1360e3-9f0f-479a-bfe9-1feaed6e25ce",
      "text": "mà nay cũng giơ gót đạp con !",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:38.882Z",
      "updatedAt": "2025-09-03T02:28:38.882Z",
      "chapterId": "26009c7d-9170-4d00-949f-f29f8da053de"
    },
    {
      "id": "9e02631a-aa61-4149-9695-d1c0fef1a003",
      "text": "Nhưng phần Ngài, lạy CHÚA,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:38.911Z",
      "updatedAt": "2025-09-03T02:28:38.911Z",
      "chapterId": "26009c7d-9170-4d00-949f-f29f8da053de"
    },
    {
      "id": "328d1f77-6bae-4035-9acf-b5428debeb5e",
      "text": "xin thương xót và nâng con trỗi dậy,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:38.925Z",
      "updatedAt": "2025-09-03T02:28:38.925Z",
      "chapterId": "26009c7d-9170-4d00-949f-f29f8da053de"
    },
    {
      "id": "da3862cc-2340-445a-9da8-74ddd3ceabbd",
      "text": "để con trả chúng mối hận này.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:38.939Z",
      "updatedAt": "2025-09-03T02:28:38.939Z",
      "chapterId": "26009c7d-9170-4d00-949f-f29f8da053de"
    },
    {
      "id": "936c03f7-5c9c-4af2-9782-8b6e7f468971",
      "text": "Con sẽ nhận biết rằng Chúa thương con thật,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:38.956Z",
      "updatedAt": "2025-09-03T02:28:38.956Z",
      "chapterId": "26009c7d-9170-4d00-949f-f29f8da053de"
    },
    {
      "id": "2d7eeb85-f6b6-438a-8ee3-d0db72470d49",
      "text": "nếu kẻ thù không đắc thắng hò reo.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:38.970Z",
      "updatedAt": "2025-09-03T02:28:38.970Z",
      "chapterId": "26009c7d-9170-4d00-949f-f29f8da053de"
    },
    {
      "id": "9f88d828-4514-47eb-95d2-48ec2e39b9d6",
      "text": "Chúa nâng đỡ con vì con vô tội,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:38.983Z",
      "updatedAt": "2025-09-03T02:28:38.983Z",
      "chapterId": "26009c7d-9170-4d00-949f-f29f8da053de"
    },
    {
      "id": "1ff3b868-3220-4d1f-b8db-f5d0ecdb563b",
      "text": "và đặt con ở mãi trước nhan Ngài.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:38.997Z",
      "updatedAt": "2025-09-03T02:28:38.997Z",
      "chapterId": "26009c7d-9170-4d00-949f-f29f8da053de"
    },
    {
      "id": "e783f52d-1e4c-448f-af49-dc151afb3376",
      "text": "Chúc tụng ĐỨC CHÚA là Thiên Chúa Ít-ra-en,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:39.011Z",
      "updatedAt": "2025-09-03T02:28:39.011Z",
      "chapterId": "26009c7d-9170-4d00-949f-f29f8da053de"
    },
    {
      "id": "3aa5ed9a-ed31-448e-8b4b-a610f94b6330",
      "text": "từ muôn thuở cho đến muôn đời. A-men. A-men.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:39.082Z",
      "updatedAt": "2025-09-03T02:28:39.082Z",
      "chapterId": "26009c7d-9170-4d00-949f-f29f8da053de"
    }
  ],
  "marks": [
    {
      "id": "c664a8d8-5a63-45ea-a9ad-ff3a63eac6ec",
      "content": "Trong *ai ca này của cá nhân*, một bệnh nhân bị bạn thân phản bội, bị nhóm địch thù chê ghét, nguyền rủa, xử ác, nên xin Thiên Chúa dủ lòng thương xót, chữa lành (cc. 5.11) và trả thù cho mình bị xúc phạm vì thái độ lăng nhục và cách đối xử độc ác của họ (c.11). – Cấu trúc của Tv này là cấu trúc theo kiểu đối ngẫu tréo (A đối chiếu với A”; B đối chiếu với B”) : A- Lời dẫn nhập mang tính cách giáo huấn (cc. 2-4) ; B- Lời cầu nguyện của tác giả (c.5) ; C- Lời nói và hành động phản trắc của nhóm địch thù (cc. 6-10) ; B”Lời cầu nguyện của tác giả (c.11) ; A”Kết luận mang tính cách giáo huấn (cc. 12-13). C.14 là một vinh tụng ca kết thúc tập I (Tv 1 – Tv 41).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 32,
      "endOffset": 32,
      "createdAt": "2025-09-03T02:28:38.492Z",
      "updatedAt": "2025-09-03T02:28:38.492Z",
      "targetId": "0b925498-f64a-4665-8963-70d59ff1ee7d",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "26009c7d-9170-4d00-949f-f29f8da053de"
    },
    {
      "id": "1b5c4d0c-bf29-4e80-b26f-b6d5c2e49f3e",
