    {
      "id": "04a9df4f-e347-4273-b306-2dfd71906d50",
      "content": "Tác giả khẩn khoản nài xin Thiên Chúa can thiệp để xử công minh cho mình, chống lại *phường bất nghĩa*, chống lại *người xảo trá gian tà* (Tv 43,1).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 33,
      "endOffset": 33,
      "createdAt": "2025-09-03T02:28:56.098Z",
