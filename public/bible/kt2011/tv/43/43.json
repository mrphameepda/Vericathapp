{
  "chapter": {
    "id": "00f4f867-3acf-436d-bb58-293fccb88c74",
    "number": 43,
    "createdAt": "2025-09-03T01:07:51.660Z",
    "updatedAt": "2025-09-03T01:07:51.660Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "0e6d2e5a-3cda-4070-8bb2-39020454b935",
      "text": "Lạy Chúa Trời, xin xử cho con,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:55.977Z",
      "updatedAt": "2025-09-03T02:28:55.977Z",
      "chapterId": "00f4f867-3acf-436d-bb58-293fccb88c74"
    },
    {
      "id": "15f04887-23ac-4d8a-95e9-bf073f5818bc",
      "text": "biện hộ cho con chống lại phường bất nghĩa,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:56.005Z",
      "updatedAt": "2025-09-03T02:28:56.005Z",
      "chapterId": "00f4f867-3acf-436d-bb58-293fccb88c74"
    },
    {
      "id": "f6372e05-8f7d-41e1-b8fc-c8556f1cb0ba",
      "text": "xin cứu con thoát khỏi người xảo trá gian tà.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:56.029Z",
      "updatedAt": "2025-09-03T02:28:56.029Z",
      "chapterId": "00f4f867-3acf-436d-bb58-293fccb88c74"
    },
    {
      "id": "88fabea3-95ba-4a11-84ba-89530c5e691e",
      "text": "Chính Ngài là Thiên Chúa bảo vệ con,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:56.042Z",
      "updatedAt": "2025-09-03T02:28:56.042Z",
      "chapterId": "00f4f867-3acf-436d-bb58-293fccb88c74"
    },
    {
      "id": "4d55f8d6-192b-48b3-b795-80d365f1080c",
      "text": "sao Ngài đành xua đuổi ?",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:56.056Z",
      "updatedAt": "2025-09-03T02:28:56.056Z",
      "chapterId": "00f4f867-3acf-436d-bb58-293fccb88c74"
    },
    {
      "id": "ba20b324-647c-410a-b8f0-b69bfbf68c72",
      "text": "Sao con phải lang thang tiều tuỵ,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:56.070Z",
      "updatedAt": "2025-09-03T02:28:56.070Z",
      "chapterId": "00f4f867-3acf-436d-bb58-293fccb88c74"
    },
    {
      "id": "243f8e18-3af9-40f4-8b24-59eb4d677591",
      "text": "bị quân thù áp bức mãi không thôi ?",
      "label": "2",
      "number": 2,
      "subVerseIndex": 3,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:56.083Z",
      "updatedAt": "2025-09-03T02:28:56.083Z",
      "chapterId": "00f4f867-3acf-436d-bb58-293fccb88c74"
    },
    {
      "id": "11f1545b-d586-4994-82d8-3326d9f0b297",
      "text": "Xin Ngài thương sai phái ánh sáng và chân lý của Ngài,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:56.113Z",
      "updatedAt": "2025-09-03T02:28:56.113Z",
      "chapterId": "00f4f867-3acf-436d-bb58-293fccb88c74"
    },
    {
      "id": "3849bbf1-162b-45e8-b5e0-0268b7923bfc",
      "text": "để soi đường dẫn lối con đi về núi thánh, lên đền Ngài ngự.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:56.156Z",
      "updatedAt": "2025-09-03T02:28:56.156Z",
      "chapterId": "00f4f867-3acf-436d-bb58-293fccb88c74"
    },
    {
      "id": "1164a39d-2f8d-46f8-8635-9e96803a86cc",
      "text": "Con sẽ bước tới bàn thờ Thiên Chúa,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:56.168Z",
      "updatedAt": "2025-09-03T02:28:56.168Z",
      "chapterId": "00f4f867-3acf-436d-bb58-293fccb88c74"
    },
    {
      "id": "71ea0cba-c205-475a-a5b7-8f65921ab690",
      "text": "tới gặp Thiên Chúa, nguồn vui của lòng con.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:56.181Z",
      "updatedAt": "2025-09-03T02:28:56.181Z",
      "chapterId": "00f4f867-3acf-436d-bb58-293fccb88c74"
    },
    {
      "id": "fc24708f-c086-44f5-996a-91addee91a00",
      "text": "Con gảy đàn dâng câu cảm tạ,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:56.193Z",
      "updatedAt": "2025-09-03T02:28:56.193Z",
      "chapterId": "00f4f867-3acf-436d-bb58-293fccb88c74"
    },
    {
      "id": "f8b586fa-e784-4e04-8b0d-1d89125d7993",
      "text": "lạy Chúa là Thiên Chúa con thờ.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 3,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:56.206Z",
      "updatedAt": "2025-09-03T02:28:56.206Z",
      "chapterId": "00f4f867-3acf-436d-bb58-293fccb88c74"
    },
    {
      "id": "3fd2a8c3-95bc-43e1-a364-fd947b062b77",
      "text": "Hồn tôi hỡi, cớ sao phiền muộn,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:56.221Z",
      "updatedAt": "2025-09-03T02:28:56.221Z",
      "chapterId": "00f4f867-3acf-436d-bb58-293fccb88c74"
    },
    {
      "id": "803f9edf-46dd-4785-b0a1-b1cb1271ba5f",
      "text": "xót xa phận mình mãi làm chi ?",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:56.251Z",
      "updatedAt": "2025-09-03T02:28:56.251Z",
      "chapterId": "00f4f867-3acf-436d-bb58-293fccb88c74"
    },
    {
      "id": "c6a2717b-3ded-4d00-ba36-b9299b7455f6",
      "text": "Hãy cậy trông Thiên Chúa, tôi còn tán tụng Người,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:56.265Z",
      "updatedAt": "2025-09-03T02:28:56.265Z",
      "chapterId": "00f4f867-3acf-436d-bb58-293fccb88c74"
    },
    {
      "id": "a29264c4-78e5-4795-9713-cb4ac7e495ba",
      "text": "Người là Đấng cứu độ, là Thiên Chúa của tôi.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 3,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:28:56.279Z",
      "updatedAt": "2025-09-03T02:28:56.279Z",
      "chapterId": "00f4f867-3acf-436d-bb58-293fccb88c74"
    }
  ],
