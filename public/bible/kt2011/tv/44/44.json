{
  "chapter": {
    "id": "c197c565-399d-4eb8-b10b-82c2621d836e",
    "number": 44,
    "createdAt": "2025-09-03T01:07:51.660Z",
    "updatedAt": "2025-09-03T01:07:51.660Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "09dbfb57-90a5-433f-930f-41d660c90037",
      "text": "*Phần ca trưởng. Của con cái ông Cô-rắc. Thi khúc.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:29:06.208Z",
      "updatedAt": "2025-09-03T02:29:06.208Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "1ddc1edf-6554-495d-a7bf-9218994d1efb",
      "text": "Lạy Thiên Chúa, tai chúng con đã từng được nghe",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:06.257Z",
      "updatedAt": "2025-09-03T02:29:06.257Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "6820303b-3033-4887-943c-982b210d2227",
      "text": "truyện cha ông vẫn thường kể lại",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:06.268Z",
      "updatedAt": "2025-09-03T02:29:06.268Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "4e597342-d38b-4492-9df2-b26909856e76",
      "text": "về công trình Chúa đã làm nên",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:06.292Z",
      "updatedAt": "2025-09-03T02:29:06.292Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "9b0e1398-92e6-482c-a595-708056102f89",
      "text": "thời các cụ thuở xa xưa ấy,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 3,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:06.307Z",
      "updatedAt": "2025-09-03T02:29:06.307Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "4236350e-4667-4d1e-a9e6-7216ed780c8e",
      "text": "rằng tự tay Ngài trục xuất chư dân,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:06.322Z",
      "updatedAt": "2025-09-03T02:29:06.322Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "8a114e9a-5524-43af-b6aa-b65b3274743a",
      "text": "còn họ, Ngài đem trồng vào đất chúng ;",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:06.350Z",
      "updatedAt": "2025-09-03T02:29:06.350Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "d77636b4-2bc2-4a6b-b71c-a05aeca4723a",
      "text": "Ngài làm tiêu hao nhiều nước nhiều miền",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:06.379Z",
      "updatedAt": "2025-09-03T02:29:06.379Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "53a699f4-7c93-4fd9-a083-7c39c5576926",
      "text": "và cho họ được thêm lớn mạnh.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 3,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:06.394Z",
      "updatedAt": "2025-09-03T02:29:06.394Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "be683381-8923-4fff-b52f-f7525e65a1bd",
      "text": "Vì đâu có phải nhờ gươm giáo mà họ chiếm đất đai,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:06.413Z",
      "updatedAt": "2025-09-03T02:29:06.413Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "e81e1bd2-6ab0-46c6-8944-316ae23b9a41",
      "text": "đâu phải cánh tay họ đem được thắng lợi về.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:06.427Z",
      "updatedAt": "2025-09-03T02:29:06.427Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "0c656468-9d11-403d-b077-324b5afb612b",
      "text": "Nhưng chính là nhờ tay hữu Chúa,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:06.442Z",
      "updatedAt": "2025-09-03T02:29:06.442Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "f6e942ff-015e-4ae3-8873-716d4a8e2e27",
      "text": "tay mạnh mẽ và ánh tôn nhan Ngài, vì Ngài yêu thích họ.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 3,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:06.456Z",
      "updatedAt": "2025-09-03T02:29:06.456Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "0fb1d285-2efb-4df1-b9a1-58f13cf17f2a",
      "text": "Chính Ngài là Vua, là Thiên Chúa của con,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:06.470Z",
      "updatedAt": "2025-09-03T02:29:06.470Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "c789d813-4d5b-4c4a-8d98-bfe57896512d",
      "text": "đã cho nhà Gia-cóp toàn công thắng trận.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:06.490Z",
      "updatedAt": "2025-09-03T02:29:06.490Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "ef62aef4-6f1e-4a65-ac5b-ba6b45738d83",
      "text": "Ngài trợ lực, chúng con quật ngã quân thù,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:06.518Z",
      "updatedAt": "2025-09-03T02:29:06.518Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "d1657121-d897-4e4d-9345-0e7e53101694",
      "text": "nhờ danh Ngài, chúng con chà đạp đối phương.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:06.531Z",
      "updatedAt": "2025-09-03T02:29:06.531Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "684ff98f-88bf-4942-a0b7-a2bb3a2d616b",
      "text": "Con chẳng có cậy tài cung nỏ,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:06.547Z",
      "updatedAt": "2025-09-03T02:29:06.547Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "eef58038-a5ab-4f3c-a779-3b9784879660",
      "text": "cứu được mình, đâu bởi gươm đao.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:06.569Z",
      "updatedAt": "2025-09-03T02:29:06.569Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "193e2250-24e5-4a86-bb65-4b0c67ad70c3",
      "text": "Nhưng chính Ngài cứu khỏi địch thù",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:06.583Z",
      "updatedAt": "2025-09-03T02:29:06.583Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "f589f830-452f-4445-b31c-17c442e5a094",
      "text": "làm kẻ ghét chúng con phải nhục nhã.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:06.597Z",
      "updatedAt": "2025-09-03T02:29:06.597Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "c4345d5c-abf7-42a8-b990-8c92648f7bbd",
      "text": "Nhờ Thiên Chúa, chúng con hằng nở mày nở mặt,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:06.611Z",
      "updatedAt": "2025-09-03T02:29:06.611Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "7385af42-cff4-4a67-8af9-71d9bcb466cd",
      "text": "mãi ngàn thu, xin tán tụng danh Ngài.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:06.625Z",
      "updatedAt": "2025-09-03T02:29:06.625Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "bee8fbb3-6387-47fb-a060-7155e1abe9a2",
      "text": "Thế mà Ngài bỏ rơi, hạ nhục chúng con,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:06.641Z",
      "updatedAt": "2025-09-03T02:29:06.641Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "aaffee3b-9b76-43c3-a050-f62d101df256",
      "text": "với quân đội nhà, Ngài chẳng còn xuất trận,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:06.655Z",
      "updatedAt": "2025-09-03T02:29:06.655Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "87367336-805f-4275-884c-b54927ff75b5",
      "text": "làm chúng con thua giặc chạy dài,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:06.684Z",
      "updatedAt": "2025-09-03T02:29:06.684Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "9c4ac77e-a863-48dc-8b92-797f26f91f14",
      "text": "kẻ ghét chúng con cứ mặc tình cướp phá.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:06.698Z",
      "updatedAt": "2025-09-03T02:29:06.698Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "9edb97ba-7911-438c-ad4b-b1e4eaae1353",
      "text": "Ngài thí chúng con tựa bầy chiên thịt,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:06.713Z",
      "updatedAt": "2025-09-03T02:29:06.713Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "bf10674d-bcf2-4428-b781-254790a315af",
      "text": "bắt tản lạc đi giữa ngoại bang.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:06.727Z",
      "updatedAt": "2025-09-03T02:29:06.727Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "5cf551fc-586e-4853-ac12-7e386e985792",
      "text": "Ấy dân Ngài, Ngài đem bán rẻ,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:06.755Z",
      "updatedAt": "2025-09-03T02:29:06.755Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "3364bd20-ae20-4753-8699-0a68eaf1078c",
      "text": "giá cả thế này, lợi lộc gì đâu !",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:06.785Z",
      "updatedAt": "2025-09-03T02:29:06.785Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "af1ca148-639d-40db-8ed7-17d1a1ea32c4",
      "text": "Ngài để cho láng giềng thoá mạ,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:06.803Z",
      "updatedAt": "2025-09-03T02:29:06.803Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "9c4cd9d2-039b-429c-a3ce-f47aff0e7bf8",
      "text": "kẻ chung quanh phỉ báng chê bai.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:06.817Z",
      "updatedAt": "2025-09-03T02:29:06.817Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "4035ed1e-0744-4244-b7a7-b9d6822db4f2",
      "text": "Ngài làm cho chúng con nên trò cười cho dân ngoại,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:06.835Z",
      "updatedAt": "2025-09-03T02:29:06.835Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "2111a5ed-fb49-44c0-a500-6749922837c2",
      "text": "chúng lắc đầu, tỏ vẻ khinh khi.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:06.853Z",
      "updatedAt": "2025-09-03T02:29:06.853Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "567bb614-3acc-4280-aaaa-60bdfe3b92ed",
      "text": "Điều sỉ nhục cứ ngày ngày ám ảnh,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:06.868Z",
      "updatedAt": "2025-09-03T02:29:06.868Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "d1b8012a-6830-4a17-af85-c0d42c5a846e",
      "text": "quá hổ ngươi, đâu còn mặt mũi nào !",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:06.882Z",
      "updatedAt": "2025-09-03T02:29:06.882Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "29ac7bae-078a-4879-9a95-07be5a2a5a6e",
      "text": "Nghe thoá mạ, nghe lộng ngôn kêu réo,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:06.896Z",
      "updatedAt": "2025-09-03T02:29:06.896Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "be1e0931-69e3-486e-a809-91262ddbf8ed",
      "text": "thấy địch thù, thấy oán hận hờn căm.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:06.925Z",
      "updatedAt": "2025-09-03T02:29:06.925Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "eac21809-e73a-4cdd-b073-6e7279d9a001",
      "text": "Cơ sự đã xảy ra như vậy,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:06.939Z",
      "updatedAt": "2025-09-03T02:29:06.939Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "1a6213f5-0707-4ade-8a2b-fa7e274051cb",
      "text": "chúng con nào đã quên lãng Chúa cho cam,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:06.967Z",
      "updatedAt": "2025-09-03T02:29:06.967Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "f88c60f5-2429-4ca1-ad33-c366b1621c66",
      "text": "hay đã thất trung cùng giao ước của Ngài,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 2,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:06.983Z",
      "updatedAt": "2025-09-03T02:29:06.983Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "8baa9cfa-46c1-4619-a67c-96b228178666",
      "text": "hoặc đã dám manh tâm bỏ Chúa,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:06.997Z",
      "updatedAt": "2025-09-03T02:29:06.997Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "50a58b63-7f99-4840-8069-c946b4ffe22f",
      "text": "nẻo đường Ngài, chân chẳng bước theo,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:07.010Z",
      "updatedAt": "2025-09-03T02:29:07.010Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "43e5dfb8-a09d-4ca2-9d6e-08cc8b4f077a",
      "text": "mà Chúa lại đẩy vào hang sói,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:07.024Z",
      "updatedAt": "2025-09-03T02:29:07.024Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "4a26d100-359b-4582-b847-972d38eb7003",
      "text": "khiến bóng tử thần phủ lấp chúng con.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:07.038Z",
      "updatedAt": "2025-09-03T02:29:07.038Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "87f901a8-15fa-40df-8a90-3a374a8a2fb5",
      "text": "Còn ví thử chúng con đã quên danh Chúa,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:07.053Z",
      "updatedAt": "2025-09-03T02:29:07.053Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "799c7873-abec-4900-9736-ccd4c072501b",
      "text": "mà giơ tay vái lạy tà thần,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:07.068Z",
      "updatedAt": "2025-09-03T02:29:07.068Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "9e589de8-670c-4a10-9c0f-14477b0fef97",
      "text": "há Thiên Chúa lại chẳng tường chẳng rõ ?",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:07.083Z",
      "updatedAt": "2025-09-03T02:29:07.083Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "bfc782fe-7dd1-412c-9803-facd1ab290d5",
      "text": "Ngài biết thừa mọi bí ẩn tâm can !",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:07.097Z",
      "updatedAt": "2025-09-03T02:29:07.097Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "5d4d0b55-7824-4ee0-9a15-1b3075338f2a",
      "text": "Âu cũng vì Ngài, mà mỗi ngày chúng con bị giết,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:07.111Z",
      "updatedAt": "2025-09-03T02:29:07.111Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "aa61c033-9ab2-40a3-87cb-d8e79aebde8d",
      "text": "bị coi như bầy cừu để sát sinh.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:07.125Z",
      "updatedAt": "2025-09-03T02:29:07.125Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "86ba2f06-7d4d-495f-9d5f-168050035cee",
      "text": "Lạy Chúa, xin tỉnh giấc ! Ngài cứ ngủ được sao ?",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:07.139Z",
      "updatedAt": "2025-09-03T02:29:07.139Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "38700301-853c-4292-b211-823e884da5ed",
      "text": "Xin trỗi dậy đi nào, đừng đuổi xua mãi mãi !",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:07.153Z",
      "updatedAt": "2025-09-03T02:29:07.153Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "cacadfe4-4ff9-41ea-b4e9-5d30cae70d01",
      "text": "Sao Ngài còn ẩn mặt, quên rằng chúng con bị khổ cực đoạ đày ?",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:07.182Z",
      "updatedAt": "2025-09-03T02:29:07.182Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "20ea4338-b3f1-4275-a37c-69325379737a",
      "text": "Mạng chúng con chôn vùi trong cát bụi,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:07.195Z",
      "updatedAt": "2025-09-03T02:29:07.195Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "19a82b0d-964d-4338-a658-3ae5982cbe4d",
      "text": "tấm thân này nằm bẹp dưới bùn đen.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:07.207Z",
      "updatedAt": "2025-09-03T02:29:07.207Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "b1313b2a-c2b3-4436-bbb9-bf1561d1500c",
      "text": "Dám xin Ngài đứng lên phù giúp,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:07.232Z",
      "updatedAt": "2025-09-03T02:29:07.232Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    },
    {
      "id": "50132c62-36df-4c5c-9c22-95874b95c9c1",
      "text": "lấy tình thương cứu chuộc dân Ngài.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:07.245Z",
      "updatedAt": "2025-09-03T02:29:07.245Z",
      "chapterId": "c197c565-399d-4eb8-b10b-82c2621d836e"
    }
  ],
  "marks": [
    {
      "id": "762460ba-5f91-4a82-9505-2737609a5c6e",
      "content": "*Ai ca này của tập thể* chia làm bốn phần : **1**) Tác giả tuyên xưng đức tin vào Thiên Chúa là Đấng giải thoát và ban chiến thắng (cc. 2-9) ; **2**) Cộng đoàn Ít-ra-en than van rên siết (cc. 10-17) ; **3**) Ít-ra-en suy nghĩ về những tai hoạ đang xảy ra (cc. 18-23) ; **4**) Tác giả xin Thiên Chúa ra tay trợ giúp (cc. 24-27).",
