{
  "chapter": {
    "id": "d5849744-1945-4cfa-9186-1d22be142b93",
    "number": 45,
    "createdAt": "2025-09-03T01:07:51.660Z",
    "updatedAt": "2025-09-03T01:07:51.660Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "17b07221-50bd-404e-8089-e267fb160d92",
      "text": "*Phần ca trưởng. Theo điệu : Những bông huệ. Của con cái ông Cô-rắc. Thi khúc. Tình ca.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:29:15.134Z",
      "updatedAt": "2025-09-03T02:29:15.134Z",
      "chapterId": "d5849744-1945-4cfa-9186-1d22be142b93"
    },
    {
      "id": "7ed8b564-01e8-4eca-a916-c06016202da6",
      "text": "Lòng trào dâng những lời cẩm tú,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:15.191Z",
      "updatedAt": "2025-09-03T02:29:15.191Z",
      "chapterId": "d5849744-1945-4cfa-9186-1d22be142b93"
    },
    {
      "id": "2417ef49-3a53-482c-baba-6cb755b4d443",
      "text": "miệng ngâm thơ mừng chúc thánh quân,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:15.202Z",
      "updatedAt": "2025-09-03T02:29:15.202Z",
      "chapterId": "d5849744-1945-4cfa-9186-1d22be142b93"
    },
    {
      "id": "ea6598cb-4ef7-4a4a-834c-0e91a2b49c1c",
      "text": "lưỡi tôi ví tựa tay người phóng bút.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:15.214Z",
      "updatedAt": "2025-09-03T02:29:15.214Z",
      "chapterId": "d5849744-1945-4cfa-9186-1d22be142b93"
    },
    {
      "id": "9f8cc022-be36-4fb4-8356-ac49a5f5cdc8",
      "text": "Giữa thế nhân, ngài vô song tuyệt mỹ,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:15.229Z",
      "updatedAt": "2025-09-03T02:29:15.229Z",
      "chapterId": "d5849744-1945-4cfa-9186-1d22be142b93"
    },
    {
      "id": "d7b7b4fd-b5fb-43d3-898f-14c341752e88",
      "text": "nét duyên tươi thắm nở môi ngài,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:15.245Z",
      "updatedAt": "2025-09-03T02:29:15.245Z",
      "chapterId": "d5849744-1945-4cfa-9186-1d22be142b93"
    },
    {
      "id": "d671f862-32d9-41d8-9947-bfb6c5b20307",
      "text": "nên ngài được Thiên Chúa ban phúc lành mãi mãi.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:15.289Z",
      "updatedAt": "2025-09-03T02:29:15.289Z",
      "chapterId": "d5849744-1945-4cfa-9186-1d22be142b93"
    },
    {
      "id": "22c6d014-361e-41ff-86ef-d361eea65489",
      "text": "Bảo kiếm hãy đeo lưng, này kiện tướng,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:15.304Z",
      "updatedAt": "2025-09-03T02:29:15.304Z",
      "chapterId": "d5849744-1945-4cfa-9186-1d22be142b93"
    },
    {
      "id": "7e14c29f-8443-4e71-8a06-39d8368ad877",
      "text": "lẫm liệt oai hùng, hãy phóng ngựa tiến lên",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:15.318Z",
      "updatedAt": "2025-09-03T02:29:15.318Z",
      "chapterId": "d5849744-1945-4cfa-9186-1d22be142b93"
    },
    {
      "id": "8ff87882-5d1d-497c-8687-6a9840cf76a4",
      "text": "bênh sự thật, lòng nhân và công lý.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:15.335Z",
      "updatedAt": "2025-09-03T02:29:15.335Z",
      "chapterId": "d5849744-1945-4cfa-9186-1d22be142b93"
    },
    {
      "id": "b5ce5139-14ee-4f39-83a6-07c04524f00b",
      "text": "Tay hữu ngài rắc gieo kinh hãi,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:15.349Z",
      "updatedAt": "2025-09-03T02:29:15.349Z",
      "chapterId": "d5849744-1945-4cfa-9186-1d22be142b93"
    },
    {
      "id": "e14ecb3a-3acf-462b-871f-9a99bc9685ac",
      "text": "tên nhọn vừa buông, dân gục ngã dưới chân ngài,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:15.363Z",
      "updatedAt": "2025-09-03T02:29:15.363Z",
      "chapterId": "d5849744-1945-4cfa-9186-1d22be142b93"
    },
    {
      "id": "47001224-c141-40a0-b6a7-b6f316bbfa35",
      "text": "địch thủ vương triều bị bắn trúng tim.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:15.378Z",
      "updatedAt": "2025-09-03T02:29:15.378Z",
      "chapterId": "d5849744-1945-4cfa-9186-1d22be142b93"
    },
    {
      "id": "61571cfd-981d-4555-8376-1f2bed434e76",
      "text": "Ngôi báu Thiên Chúa tặng ban cho ngài",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:15.392Z",
      "updatedAt": "2025-09-03T02:29:15.392Z",
      "chapterId": "d5849744-1945-4cfa-9186-1d22be142b93"
    },
    {
      "id": "fe2a4de2-92d4-4030-8c86-b985a4ebd818",
      "text": "sẽ trường tồn vạn kỷ,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:15.406Z",
      "updatedAt": "2025-09-03T02:29:15.406Z",
      "chapterId": "d5849744-1945-4cfa-9186-1d22be142b93"
    },
    {
      "id": "f4261165-fbc5-46d0-8d5a-4a128415e679",
      "text": "vương trượng ngài, vương trượng công minh ;",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:15.420Z",
      "updatedAt": "2025-09-03T02:29:15.420Z",
      "chapterId": "d5849744-1945-4cfa-9186-1d22be142b93"
    },
    {
      "id": "129c666a-6cc7-4521-b838-855db6e5559a",
      "text": "ngài ưa điều chính trực, ghét điều gian ác.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:15.434Z",
      "updatedAt": "2025-09-03T02:29:15.434Z",
      "chapterId": "d5849744-1945-4cfa-9186-1d22be142b93"
    },
    {
      "id": "2d2ce9f6-c648-4341-acce-35b95b1cfcee",
      "text": "Chính vì vậy, Thiên Chúa là Thiên Chúa của ngài",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:15.448Z",
      "updatedAt": "2025-09-03T02:29:15.448Z",
      "chapterId": "d5849744-1945-4cfa-9186-1d22be142b93"
    },
    {
      "id": "72bf5abc-b4a5-43ca-ac71-218a9f1d8098",
      "text": "đã tôn phong ngài vượt trổi các đồng liêu",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:15.463Z",
      "updatedAt": "2025-09-03T02:29:15.463Z",
      "chapterId": "d5849744-1945-4cfa-9186-1d22be142b93"
    },
    {
      "id": "97a1a0cf-ef25-4cb2-9324-77804398f33c",
      "text": "mà xức cho dầu thơm hoan lạc.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 3,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:15.477Z",
      "updatedAt": "2025-09-03T02:29:15.477Z",
      "chapterId": "d5849744-1945-4cfa-9186-1d22be142b93"
    },
    {
      "id": "fdd54829-4fda-4b71-84b7-a50f9ef16d48",
      "text": "Quế trầm một dược, hương toả long bào,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:15.491Z",
      "updatedAt": "2025-09-03T02:29:15.491Z",
      "chapterId": "d5849744-1945-4cfa-9186-1d22be142b93"
    },
    {
      "id": "530ba5d7-176e-44a3-bcb5-418ce3c60f0f",
      "text": "nhã nhạc điện ngà khiến ngài vui thoả.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:15.507Z",
      "updatedAt": "2025-09-03T02:29:15.507Z",
      "chapterId": "d5849744-1945-4cfa-9186-1d22be142b93"
    },
    {
      "id": "a0bc3b1c-1a7c-4706-bd8d-a1695e429e3d",
      "text": "Hàng cung nữ, có những vì công chúa,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:15.528Z",
      "updatedAt": "2025-09-03T02:29:15.528Z",
      "chapterId": "d5849744-1945-4cfa-9186-1d22be142b93"
    },
    {
      "id": "f8aafff1-24de-48a7-b020-bc98fb3ea0b2",
      "text": "bên hữu ngài, hoàng hậu sánh vai,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:15.542Z",
      "updatedAt": "2025-09-03T02:29:15.542Z",
      "chapterId": "d5849744-1945-4cfa-9186-1d22be142b93"
    },
    {
      "id": "657186aa-2d4b-4bfb-aaab-53411de0b905",
      "text": "trang điểm vàng Ô-phia lộng lẫy.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:15.563Z",
      "updatedAt": "2025-09-03T02:29:15.563Z",
      "chapterId": "d5849744-1945-4cfa-9186-1d22be142b93"
    },
    {
      "id": "a9330cc8-36d1-4f06-a7ad-a5942d9ad6c6",
      "text": "Tôn nương hỡi, xin hãy nghe nào,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:15.587Z",
      "updatedAt": "2025-09-03T02:29:15.587Z",
      "chapterId": "d5849744-1945-4cfa-9186-1d22be142b93"
    },
    {
      "id": "5d8779ca-6d0c-48d8-bf49-5da3eea4397d",
      "text": "đưa mắt nhìn và hãy lắng tai,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:15.608Z",
      "updatedAt": "2025-09-03T02:29:15.608Z",
      "chapterId": "d5849744-1945-4cfa-9186-1d22be142b93"
    },
    {
      "id": "249cb042-0205-4ca1-a987-bf6f5c8f01a4",
      "text": "quên dân tộc, quên đi nhà thân phụ.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:15.619Z",
      "updatedAt": "2025-09-03T02:29:15.619Z",
      "chapterId": "d5849744-1945-4cfa-9186-1d22be142b93"
    },
    {
      "id": "b1902b66-320f-4c53-9e75-dd76f328e667",
      "text": "Sắc nước hương trời, Quân Vương sủng ái,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:15.640Z",
      "updatedAt": "2025-09-03T02:29:15.640Z",
      "chapterId": "d5849744-1945-4cfa-9186-1d22be142b93"
    },
    {
      "id": "b0a5a671-d135-4270-ab09-68a730dc6544",
      "text": "hãy vào phục lạy : “Người là Chúa của bà.”",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:15.651Z",
      "updatedAt": "2025-09-03T02:29:15.651Z",
      "chapterId": "d5849744-1945-4cfa-9186-1d22be142b93"
    },
    {
      "id": "85e97455-ce43-4e74-9c18-21573300ea58",
      "text": "Thiếu nữ thành Tia mang lễ tới,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:15.663Z",
      "updatedAt": "2025-09-03T02:29:15.663Z",
      "chapterId": "d5849744-1945-4cfa-9186-1d22be142b93"
    },
    {
      "id": "1f9384c4-fb69-4764-9f8f-1c07218374a1",
      "text": "phú hào trong xứ đến cầu ân.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:15.704Z",
      "updatedAt": "2025-09-03T02:29:15.704Z",
      "chapterId": "d5849744-1945-4cfa-9186-1d22be142b93"
    },
    {
      "id": "fd7a1eb4-5bc7-4a90-8350-504f40ed2404",
      "text": "Đẹp lộng lẫy, này đây công chúa,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:15.718Z",
      "updatedAt": "2025-09-03T02:29:15.718Z",
      "chapterId": "d5849744-1945-4cfa-9186-1d22be142b93"
    },
    {
      "id": "998afcfc-d6f0-4b7f-a24d-9157aa506b02",
      "text": "mặc xiêm y dệt gấm thêu vàng,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:15.732Z",
      "updatedAt": "2025-09-03T02:29:15.732Z",
      "chapterId": "d5849744-1945-4cfa-9186-1d22be142b93"
    },
    {
      "id": "3486cd5a-4418-4930-a6cd-6d521c95c556",
      "text": "phục sức huy hoàng, được dẫn tới Quân Vương,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:15.746Z",
      "updatedAt": "2025-09-03T02:29:15.746Z",
      "chapterId": "d5849744-1945-4cfa-9186-1d22be142b93"
    },
    {
      "id": "e27719f0-570a-4787-9aaf-dec391a67418",
      "text": "cùng các trinh nữ theo sau hầu cận.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:15.761Z",
      "updatedAt": "2025-09-03T02:29:15.761Z",
      "chapterId": "d5849744-1945-4cfa-9186-1d22be142b93"
    },
    {
      "id": "6e546523-5234-4271-af32-318665990a6a",
      "text": "Lòng hoan hỷ, đoàn người tiến bước,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:15.775Z",
      "updatedAt": "2025-09-03T02:29:15.775Z",
      "chapterId": "d5849744-1945-4cfa-9186-1d22be142b93"
    },
    {
      "id": "dbc1233b-8813-405a-b11a-5a531180805a",
      "text": "vẻ tưng bừng, vào tận hoàng cung.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:15.790Z",
      "updatedAt": "2025-09-03T02:29:15.790Z",
      "chapterId": "d5849744-1945-4cfa-9186-1d22be142b93"
    },
    {
      "id": "81979389-5f88-4376-8a6d-b556fc1f704f",
      "text": "Con cái ngài sẽ nối dòng tiên đế,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:15.807Z",
      "updatedAt": "2025-09-03T02:29:15.807Z",
      "chapterId": "d5849744-1945-4cfa-9186-1d22be142b93"
    },
    {
      "id": "7abc7619-267d-41e4-a49a-5574a13934cd",
      "text": "ngài phong làm vương bá khắp trần gian.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:15.821Z",
      "updatedAt": "2025-09-03T02:29:15.821Z",
      "chapterId": "d5849744-1945-4cfa-9186-1d22be142b93"
    },
    {
      "id": "a5417b52-2e1a-445a-a3c4-b4c82e7f756f",
      "text": "Danh thơm ngài, thần xin truyền tụng",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:15.835Z",
      "updatedAt": "2025-09-03T02:29:15.835Z",
      "chapterId": "d5849744-1945-4cfa-9186-1d22be142b93"
    },
    {
      "id": "5c15942f-7d9a-40b7-9995-7af4e454b944",
      "text": "thế hệ này tới thế hệ kia.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:15.849Z",
      "updatedAt": "2025-09-03T02:29:15.849Z",
      "chapterId": "d5849744-1945-4cfa-9186-1d22be142b93"
    },
    {
      "id": "0f3e1b24-1e57-4b9d-9c71-29b4d2f25207",
      "text": "Vì thế, dân dân sẽ nức lòng ca ngợi,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 2,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:15.864Z",
      "updatedAt": "2025-09-03T02:29:15.864Z",
      "chapterId": "d5849744-1945-4cfa-9186-1d22be142b93"
    },
    {
      "id": "2ee7d397-3bdd-49a5-a976-2b9bb221ac0b",
      "text": "tiếng ngợi ca bất tận muôn đời.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 3,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:15.880Z",
      "updatedAt": "2025-09-03T02:29:15.880Z",
      "chapterId": "d5849744-1945-4cfa-9186-1d22be142b93"
    }
  ],
  "marks": [
    {
      "id": "a6f08974-2be3-4181-a782-411956342ff1",
      "content": "Thánh vịnh 45 là *một Thánh vịnh về nhà vua và về Đấng Mê-si-a*. Chắc bài ca này đã được soạn thảo nhằm mừng lễ thành hôn giữa một vua Ít-ra-en và một công chúa ngoại quốc có lẽ gốc thành Tia (x. Tv 45,11c.13). Khó mà xác định được danh tính của nhà vua và công chúa ngoại quốc được nói đến trong Thánh vịnh. Truyền thống Do-thái và Ki-tô giáo hiểu về hôn lễ của Vua Mê-si-a với Ít-ra-en, hình ảnh của Hội Thánh. Thánh vịnh 45 gồm những phần sau đây : **1**) Nhập đề (c.2) ; **2**) Về tân lang là nhà vua (cc. 3-10) ; **3**) Về tân nương (cc. 11-16) ; **4**) Kết luận (cc. 17-18).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 40,
      "endOffset": 40,
      "createdAt": "2025-09-03T02:29:15.165Z",
      "updatedAt": "2025-09-03T02:29:15.165Z",
