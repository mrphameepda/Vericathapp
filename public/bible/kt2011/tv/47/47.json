{
  "chapter": {
    "id": "c4722ef7-ace2-4413-81c3-bed5715b6d7d",
    "number": 47,
    "createdAt": "2025-09-03T01:07:51.660Z",
    "updatedAt": "2025-09-03T01:07:51.660Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "1ebab1b8-227c-4eb6-9693-5eee197467fa",
      "text": "*Phần ca trưởng. Của con cái ông Cô-rắc. Thánh vịnh.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:29:28.627Z",
      "updatedAt": "2025-09-03T02:29:28.627Z",
      "chapterId": "c4722ef7-ace2-4413-81c3-bed5715b6d7d"
    },
    {
      "id": "984a7c7a-5297-43d1-91f5-69e755a8797d",
      "text": "Vỗ tay đi nào, muôn dân hỡi !",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:28.676Z",
      "updatedAt": "2025-09-03T02:29:28.676Z",
      "chapterId": "c4722ef7-ace2-4413-81c3-bed5715b6d7d"
    },
    {
      "id": "412cdcb2-ac63-4804-b973-629f0988e3f9",
      "text": "Mừng Thiên Chúa, hãy cất tiếng hò reo !",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:28.697Z",
      "updatedAt": "2025-09-03T02:29:28.697Z",
      "chapterId": "c4722ef7-ace2-4413-81c3-bed5715b6d7d"
    },
    {
      "id": "4dc97c5b-465e-4aea-a002-5c852067b7b9",
      "text": "Vì ĐỨC CHÚA là Đấng Tối Cao, Đấng khả uý,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:28.708Z",
      "updatedAt": "2025-09-03T02:29:28.708Z",
      "chapterId": "c4722ef7-ace2-4413-81c3-bed5715b6d7d"
    },
    {
      "id": "43bd65e3-ef84-4376-ae8b-23ee9b1c6b41",
      "text": "là Vua Cả thống trị khắp địa cầu.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:28.745Z",
      "updatedAt": "2025-09-03T02:29:28.745Z",
      "chapterId": "c4722ef7-ace2-4413-81c3-bed5715b6d7d"
    },
    {
      "id": "a6a60abe-88e7-4399-af06-7fcc6378e50c",
      "text": "Chính Người bắt muôn dân muôn nước",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:28.773Z",
      "updatedAt": "2025-09-03T02:29:28.773Z",
      "chapterId": "c4722ef7-ace2-4413-81c3-bed5715b6d7d"
    },
    {
      "id": "e6ba7753-2a5f-47cf-9abe-153784930991",
      "text": "phải phục quyền và quỵ luỵ chúng tôi.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:28.787Z",
      "updatedAt": "2025-09-03T02:29:28.787Z",
      "chapterId": "c4722ef7-ace2-4413-81c3-bed5715b6d7d"
    },
    {
      "id": "ed5173f7-9f38-4fa8-997f-ee2aafca2550",
      "text": "Người chọn lựa cho chúng tôi phần cơ nghiệp,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:28.802Z",
      "updatedAt": "2025-09-03T02:29:28.802Z",
      "chapterId": "c4722ef7-ace2-4413-81c3-bed5715b6d7d"
    },
    {
      "id": "63b4eb7f-93a6-415c-8cd5-cf22c58600b1",
      "text": "cơ nghiệp làm cho kẻ Người thương là Gia-cóp",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:28.817Z",
      "updatedAt": "2025-09-03T02:29:28.817Z",
      "chapterId": "c4722ef7-ace2-4413-81c3-bed5715b6d7d"
    },
    {
      "id": "5a47fb92-3cf6-4d29-b11d-78867245e7fc",
      "text": "được nở mặt nở mày.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:28.845Z",
      "updatedAt": "2025-09-03T02:29:28.845Z",
      "chapterId": "c4722ef7-ace2-4413-81c3-bed5715b6d7d"
    },
    {
      "id": "7814ec14-d56a-462d-bc36-df4ced30f4ec",
      "text": "Thiên Chúa ngự lên, rộn rã tiếng hò reo,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:28.873Z",
      "updatedAt": "2025-09-03T02:29:28.873Z",
      "chapterId": "c4722ef7-ace2-4413-81c3-bed5715b6d7d"
    },
    {
      "id": "fc6b863b-12d4-402c-a999-8a7b554ba6ec",
      "text": "CHÚA ngự lên, vang dội tiếng tù và.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:28.886Z",
      "updatedAt": "2025-09-03T02:29:28.886Z",
      "chapterId": "c4722ef7-ace2-4413-81c3-bed5715b6d7d"
    },
    {
      "id": "2bd0c129-20eb-49f4-8c9e-913ec2bbdd5b",
      "text": "Hãy đàn ca, đàn ca lên mừng Thiên Chúa,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:28.915Z",
      "updatedAt": "2025-09-03T02:29:28.915Z",
      "chapterId": "c4722ef7-ace2-4413-81c3-bed5715b6d7d"
    },
    {
      "id": "e47d7e3a-5cc2-48ae-9403-f7d72ee737b0",
      "text": "đàn ca lên nào, đàn ca nữa kính Vua ta !",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:28.941Z",
      "updatedAt": "2025-09-03T02:29:28.941Z",
      "chapterId": "c4722ef7-ace2-4413-81c3-bed5715b6d7d"
    },
    {
      "id": "8deb1bc4-bfff-4d75-bac7-897d6b48ce9a",
      "text": "Thiên Chúa là Vua toàn cõi địa cầu,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:28.954Z",
      "updatedAt": "2025-09-03T02:29:28.954Z",
      "chapterId": "c4722ef7-ace2-4413-81c3-bed5715b6d7d"
    },
    {
      "id": "cd3634bd-bec2-46be-885e-5277c30c9b40",
      "text": "hãy dâng Người khúc đàn ca tuyệt mỹ.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:28.966Z",
      "updatedAt": "2025-09-03T02:29:28.966Z",
      "chapterId": "c4722ef7-ace2-4413-81c3-bed5715b6d7d"
    },
    {
      "id": "3277af08-4f64-4964-9713-ab4c643ea203",
      "text": "Thiên Chúa là Vua thống trị chư dân,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:28.979Z",
      "updatedAt": "2025-09-03T02:29:28.979Z",
      "chapterId": "c4722ef7-ace2-4413-81c3-bed5715b6d7d"
    },
    {
      "id": "0524b202-aedb-4644-900a-c8528c6a74fe",
      "text": "Thiên Chúa ngự trên toà uy linh cao cả.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:28.992Z",
      "updatedAt": "2025-09-03T02:29:28.992Z",
      "chapterId": "c4722ef7-ace2-4413-81c3-bed5715b6d7d"
    },
    {
      "id": "29e1ee19-6a75-4256-a4a2-d294eb994850",
      "text": "Kìa vương hầu các dân tề tựu",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:29.020Z",
      "updatedAt": "2025-09-03T02:29:29.020Z",
      "chapterId": "c4722ef7-ace2-4413-81c3-bed5715b6d7d"
    },
    {
      "id": "9c939de2-dd17-4dfc-88ae-03f029c17151",
      "text": "cùng dân Thiên Chúa, Chúa của Áp-ra-ham.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:29.034Z",
      "updatedAt": "2025-09-03T02:29:29.034Z",
      "chapterId": "c4722ef7-ace2-4413-81c3-bed5715b6d7d"
    },
    {
      "id": "3f148841-44c1-494e-9a89-2df17d059f0e",
      "text": "Mọi thủ lãnh trần gian thuộc quyền Thiên Chúa,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:29.062Z",
      "updatedAt": "2025-09-03T02:29:29.062Z",
      "chapterId": "c4722ef7-ace2-4413-81c3-bed5715b6d7d"
    },
    {
      "id": "fd0b8a7c-9e16-491b-8ff7-62bcc79e0b6b",
      "text": "Đấng siêu việt ngàn trùng.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 3,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:29.090Z",
      "updatedAt": "2025-09-03T02:29:29.090Z",
      "chapterId": "c4722ef7-ace2-4413-81c3-bed5715b6d7d"
    }
  ],
  "marks": [
    {
      "id": "8bae0709-ec22-4e5e-8fa1-bbfa109902fe",
      "content": "Tv 47 là Tv đầu tiên trong các *Tv về vương quyền của Thiên Chúa* (các Tv 47, 93, 96, 97, 98, 99). Cấu trúc của Tv : **1**) Lời kêu mời muôn dân tham dự buổi lễ mừng Thiên Chúa (c.2) ; **2**) Những cuộc chiến thắng của Thiên Chúa (cc. 3-5) ; **3**) Thiên Chúa ngự lên Đền Thờ Giê-ru-sa-lem (cc. 6-8) ; **4**) Vương quyền của Thiên Chúa trên mọi dân tộc (cc. 9-10).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
