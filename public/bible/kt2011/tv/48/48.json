{
  "chapter": {
    "id": "601a435c-3c4d-40ce-9eaf-86073a580205",
    "number": 48,
    "createdAt": "2025-09-03T01:07:51.660Z",
    "updatedAt": "2025-09-03T01:07:51.660Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "2dd83c39-3a1a-456c-ba6d-e786c6087fbd",
      "text": "*Thánh ca. Thánh vịnh. Của con cái ông Cô-rắc.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:29:35.053Z",
      "updatedAt": "2025-09-03T02:29:35.053Z",
      "chapterId": "601a435c-3c4d-40ce-9eaf-86073a580205"
    },
    {
      "id": "4fc08874-713a-400a-a639-ce0c3a80663f",
      "text": "Cao cả thay ĐỨC CHÚA là Thiên Chúa chúng ta,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:35.118Z",
      "updatedAt": "2025-09-03T02:29:35.118Z",
      "chapterId": "601a435c-3c4d-40ce-9eaf-86073a580205"
    },
    {
      "id": "03412395-5b6f-441a-99f3-28ff5b5e431f",
      "text": "Đấng thật xứng muôn lời ca tụng",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:35.149Z",
      "updatedAt": "2025-09-03T02:29:35.149Z",
      "chapterId": "601a435c-3c4d-40ce-9eaf-86073a580205"
    },
    {
      "id": "815ccb13-0065-4317-b209-f0380b06afec",
      "text": "trong thành đô của Người !",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:35.163Z",
      "updatedAt": "2025-09-03T02:29:35.163Z",
      "chapterId": "601a435c-3c4d-40ce-9eaf-86073a580205"
    },
    {
      "id": "391cc7a5-36b3-4adc-9431-851a2d40713d",
      "text": "Núi thánh Người thật nguy nga hùng vĩ,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:35.191Z",
      "updatedAt": "2025-09-03T02:29:35.191Z",
      "chapterId": "601a435c-3c4d-40ce-9eaf-86073a580205"
    },
    {
      "id": "6a79e415-528f-45f8-9e9e-e9b31cc3354d",
      "text": "là niềm vui cho toàn thể địa cầu.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:35.205Z",
      "updatedAt": "2025-09-03T02:29:35.205Z",
      "chapterId": "601a435c-3c4d-40ce-9eaf-86073a580205"
    },
    {
      "id": "567a66ce-9a5e-4828-baa4-00972f24183d",
      "text": "Núi Xi-on, bồng lai cực bắc,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:35.219Z",
      "updatedAt": "2025-09-03T02:29:35.219Z",
      "chapterId": "601a435c-3c4d-40ce-9eaf-86073a580205"
    },
    {
      "id": "4d252791-8ed6-4ee1-baff-11a16923aef6",
      "text": "là kinh thành của Đức Đại Vương.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 3,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:35.268Z",
      "updatedAt": "2025-09-03T02:29:35.268Z",
      "chapterId": "601a435c-3c4d-40ce-9eaf-86073a580205"
    },
    {
      "id": "c42bfceb-6c7c-47dd-93ff-390eadb7ecb1",
      "text": "Giữa các lâu đài của Xi-on,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:35.284Z",
      "updatedAt": "2025-09-03T02:29:35.284Z",
      "chapterId": "601a435c-3c4d-40ce-9eaf-86073a580205"
    },
    {
      "id": "0da85312-3ee1-4000-87ad-7a2dbbc89fc0",
      "text": "Thiên Chúa tỏ ra chính Người là thành luỹ.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:35.312Z",
      "updatedAt": "2025-09-03T02:29:35.312Z",
      "chapterId": "601a435c-3c4d-40ce-9eaf-86073a580205"
    },
    {
      "id": "76862149-1f42-4b89-939d-5dcc33d706b5",
      "text": "Kìa vua chúa toa rập với nhau,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:35.326Z",
      "updatedAt": "2025-09-03T02:29:35.326Z",
      "chapterId": "601a435c-3c4d-40ce-9eaf-86073a580205"
    },
    {
      "id": "9d060586-7530-4d06-b97c-63ab1405a35c",
      "text": "cùng tiến quân một lúc.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:35.346Z",
      "updatedAt": "2025-09-03T02:29:35.346Z",
      "chapterId": "601a435c-3c4d-40ce-9eaf-86073a580205"
    },
    {
      "id": "0ee7e5e4-19a3-4e2e-b5d2-3aaddac1578e",
      "text": "Nhưng mới thấy thành đã sững sờ kinh ngạc,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:35.360Z",
      "updatedAt": "2025-09-03T02:29:35.360Z",
      "chapterId": "601a435c-3c4d-40ce-9eaf-86073a580205"
    },
    {
      "id": "e3010244-e3e2-466a-bdfd-dcd74a545c4d",
      "text": "quá hãi hùng, bỏ chạy thoát thân.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:35.375Z",
      "updatedAt": "2025-09-03T02:29:35.375Z",
      "chapterId": "601a435c-3c4d-40ce-9eaf-86073a580205"
    },
    {
      "id": "f682586a-e9f3-44a8-a9ad-f7be65b98faa",
      "text": "Chúng run khiếp, chạy đi chẳng nổi,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:35.418Z",
      "updatedAt": "2025-09-03T02:29:35.418Z",
      "chapterId": "601a435c-3c4d-40ce-9eaf-86073a580205"
    },
    {
      "id": "2088f102-2cfd-40a4-97a5-f8a584f52a46",
      "text": "quằn quại như phụ nữ sắp sinh con.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:35.431Z",
      "updatedAt": "2025-09-03T02:29:35.431Z",
      "chapterId": "601a435c-3c4d-40ce-9eaf-86073a580205"
    },
    {
      "id": "677bfde9-034c-43b2-acde-e0429fa8e09a",
      "text": "Quay cuồng như những chiếc tàu trên biển cả",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:35.446Z",
      "updatedAt": "2025-09-03T02:29:35.446Z",
      "chapterId": "601a435c-3c4d-40ce-9eaf-86073a580205"
    },
    {
      "id": "3c645a32-c26d-4b85-8048-a1bc3b9dcedf",
      "text": "bị bão đánh tan tành.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:35.474Z",
      "updatedAt": "2025-09-03T02:29:35.474Z",
      "chapterId": "601a435c-3c4d-40ce-9eaf-86073a580205"
    },
    {
      "id": "81cf5aa7-ce89-468a-8f95-4fe5a21a6cea",
      "text": "Chuyện xưa tai nghe, giờ đây mắt thấy,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:35.488Z",
      "updatedAt": "2025-09-03T02:29:35.488Z",
      "chapterId": "601a435c-3c4d-40ce-9eaf-86073a580205"
    },
    {
      "id": "0cde5446-b6c4-4f12-a053-bb04babffd70",
      "text": "trong thành trì Chúa Tể càn khôn,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:35.502Z",
      "updatedAt": "2025-09-03T02:29:35.502Z",
      "chapterId": "601a435c-3c4d-40ce-9eaf-86073a580205"
    },
    {
      "id": "c6138ada-9f65-4419-89ea-ae7fc0696905",
      "text": "trong thành trì Thiên Chúa, Chúa ta thờ ;",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:35.517Z",
      "updatedAt": "2025-09-03T02:29:35.517Z",
      "chapterId": "601a435c-3c4d-40ce-9eaf-86073a580205"
    },
    {
      "id": "a9e09de7-9ec5-4875-b75d-d060bf628da6",
      "text": "Người củng cố thành đô đến muôn đời muôn thuở.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 3,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:35.531Z",
      "updatedAt": "2025-09-03T02:29:35.531Z",
      "chapterId": "601a435c-3c4d-40ce-9eaf-86073a580205"
    },
    {
      "id": "6cd347cb-da86-43ea-9128-908bc0a9613c",
      "text": "Lạy Thiên Chúa, giữa nơi đền thánh,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:35.547Z",
      "updatedAt": "2025-09-03T02:29:35.547Z",
      "chapterId": "601a435c-3c4d-40ce-9eaf-86073a580205"
    },
    {
      "id": "018833df-b964-4688-a91a-38197e34d233",
      "text": "chúng con hồi tưởng lại tình Chúa yêu thương.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:35.561Z",
      "updatedAt": "2025-09-03T02:29:35.561Z",
      "chapterId": "601a435c-3c4d-40ce-9eaf-86073a580205"
    },
    {
      "id": "2e512729-cbd8-42d6-a248-7b133e169d98",
      "text": "Danh thánh Chúa gần xa truyền tụng,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:35.575Z",
      "updatedAt": "2025-09-03T02:29:35.575Z",
      "chapterId": "601a435c-3c4d-40ce-9eaf-86073a580205"
    },
    {
      "id": "23f72368-1625-45e3-8597-015c0cde22d3",
      "text": "tiếng ngợi khen Ngài khắp cõi lừng vang.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:35.603Z",
      "updatedAt": "2025-09-03T02:29:35.603Z",
      "chapterId": "601a435c-3c4d-40ce-9eaf-86073a580205"
    },
    {
      "id": "a51a4770-7018-41e1-a7b8-d48dacd8c04e",
      "text": "Tay hữu Chúa thi hành công lý,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:35.618Z",
      "updatedAt": "2025-09-03T02:29:35.618Z",
      "chapterId": "601a435c-3c4d-40ce-9eaf-86073a580205"
    },
    {
      "id": "6cad798f-b121-4557-9d88-e876a6b1c36a",
      "text": "khiến núi Xi-on tưng bừng hoan hỷ ;",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:35.638Z",
      "updatedAt": "2025-09-03T02:29:35.638Z",
      "chapterId": "601a435c-3c4d-40ce-9eaf-86073a580205"
    },
    {
      "id": "243683af-5028-46a2-a12a-07eea62b9b11",
      "text": "thành thị miền Giu-đa hớn hở nhảy mừng",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:35.667Z",
      "updatedAt": "2025-09-03T02:29:35.667Z",
      "chapterId": "601a435c-3c4d-40ce-9eaf-86073a580205"
    },
    {
      "id": "56b329c0-9438-4998-9985-248bdc061411",
      "text": "vì những điều Ngài đã phán quyết.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:35.699Z",
      "updatedAt": "2025-09-03T02:29:35.699Z",
      "chapterId": "601a435c-3c4d-40ce-9eaf-86073a580205"
    },
    {
      "id": "94d4a7b1-9346-4b9d-b03c-c233943ad20c",
      "text": "Hãy đi vòng Xi-on, dọc theo tường luỹ,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:35.713Z",
      "updatedAt": "2025-09-03T02:29:35.713Z",
      "chapterId": "601a435c-3c4d-40ce-9eaf-86073a580205"
    },
    {
      "id": "e13687fd-4616-4f56-b507-f47b02e02c7e",
      "text": "đếm tháp canh, xem được bao nhiêu ;",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:35.756Z",
      "updatedAt": "2025-09-03T02:29:35.756Z",
      "chapterId": "601a435c-3c4d-40ce-9eaf-86073a580205"
    },
    {
      "id": "196ebf27-5a82-4235-9ecc-cae1c231ff41",
      "text": "hãy để tâm quan sát tường thành, các lâu đài, ngắm xem cho tỏ.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:35.785Z",
      "updatedAt": "2025-09-03T02:29:35.785Z",
      "chapterId": "601a435c-3c4d-40ce-9eaf-86073a580205"
    },
    {
      "id": "916212e8-5896-411f-984a-ff888b097dce",
      "text": "Rồi kể lại cho thế hệ tương lai",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:35.798Z",
      "updatedAt": "2025-09-03T02:29:35.798Z",
      "chapterId": "601a435c-3c4d-40ce-9eaf-86073a580205"
    },
    {
      "id": "84e4c4a3-6a93-4663-8c7c-486a74d0e144",
      "text": "rằng : chính Người là Thiên Chúa,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:35.812Z",
      "updatedAt": "2025-09-03T02:29:35.812Z",
      "chapterId": "601a435c-3c4d-40ce-9eaf-86073a580205"
    },
    {
      "id": "0c05a409-a02f-4e5e-821a-149044a633eb",
      "text": "đời đời là Thiên Chúa chúng ta,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:35.827Z",
      "updatedAt": "2025-09-03T02:29:35.827Z",
      "chapterId": "601a435c-3c4d-40ce-9eaf-86073a580205"
    },
    {
      "id": "21486e7c-acfc-477f-b328-847c39981faf",
      "text": "Người lãnh đạo chúng ta đến muôn thuở.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 2,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:35.841Z",
      "updatedAt": "2025-09-03T02:29:35.841Z",
      "chapterId": "601a435c-3c4d-40ce-9eaf-86073a580205"
    }
  ],
