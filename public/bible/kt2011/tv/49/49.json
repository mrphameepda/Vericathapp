    },
    {
      "id": "fecb3725-c1db-4a59-81c3-bfd1a57210de",
      "content": "Hc 11,19",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:29:42.099Z",
      "updatedAt": "2025-09-03T02:29:42.099Z",
      "targetId": "c479178c-f0e5-41c3-9d5b-b3dc41931893",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "3d590efa-16a5-4d95-9fc3-705660c970e0",
      "content": "Cc. 2-5 mang vài nét thuộc văn chương khôn ngoan (nhập đề long trọng nhằm gây sự chú ý đến giáo huấn sắp đưa ra : x. Tv 78,1-4 ; Đnl 32,1 ; Is 1,2 – các từ sử dụng : *lời hay lẽ phải, câu khéo điều khôn, câu ngạn ngữ, nhiệm mầu* = những điều bí ẩn).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 34,
      "endOffset": 34,
      "createdAt": "2025-09-03T02:29:41.917Z",
      "updatedAt": "2025-09-03T02:29:41.917Z",
      "targetId": "b52da063-9f73-4d2e-bdf3-413b83e32cd0",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "8a44f1b8-07b6-4c28-aa97-4e39ae1af341",
      "content": "Gv 3,19",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 0,
      "endOffset": 0,
      "createdAt": "2025-09-03T02:29:42.241Z",
      "updatedAt": "2025-09-03T02:29:42.241Z",
      "targetId": "2910266f-08e7-4a9b-822c-b96a8a7e830a",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "479e7022-62c6-457e-b684-51099419c7d6",
      "content": "Vì giá chuộc (*giá thục hồi*) tính mạng con người quá cao hoặc cho dù giá đó có cao mấy đi nữa, con người vẫn phải chết : đó là một quy luật tất nhiên.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 32,
      "endOffset": 32,
      "createdAt": "2025-09-03T02:29:42.039Z",
      "updatedAt": "2025-09-03T02:29:42.039Z",
      "targetId": "56902b8c-5854-4c49-9be0-c87b0f82b9a0",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "a58366a2-1f95-47f3-ab29-0959ba7e2489",
      "content": "Hs 13,14",
      "kind": "MARK_KIND_REFERENCE",
      "label": "4@",
      "sortOrder": 3,
      "startOffset": 25,
      "endOffset": 25,
      "createdAt": "2025-09-03T02:29:42.396Z",
      "updatedAt": "2025-09-03T02:29:42.396Z",
      "targetId": "24ebc3fa-267f-46dc-b9e8-3e5746daab87",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "77991f50-0ae7-46a0-9f2c-1a77263debab",
      "content": "ds : *Nhưng Chúa Trời sẽ chuộc mạng tôi khỏi tay âm phủ ; phải, Người sẽ lấy tôi đi*. Thay vì *tay*, có vài bản dịch là *nanh vuốt* hoặc *quyền lực*. Tác giả Tv 49 này không có ý khẳng định : người công chính sẽ không phải chết. Nhưng tác giả quả quyết là người công chính sẽ được cứu khỏi quyền lực âm phủ. Ý tưởng này dọn đường và sẽ dẫn tới đạo lý về linh hồn bất tử (x. Kn 3,1-9) và về thân xác sẽ sống lại (x. Is 26,19 ; Đn 12,2 ; 2 Mcb 7,9.11.14.23.29. 36 ; 12,43-44 ; 14,46).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "5",
      "sortOrder": 4,
      "startOffset": 31,
      "endOffset": 31,
      "createdAt": "2025-09-03T02:29:42.381Z",
      "updatedAt": "2025-09-03T02:29:42.381Z",
      "targetId": "24ebc3fa-267f-46dc-b9e8-3e5746daab87",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
