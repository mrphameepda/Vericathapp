{
  "chapter": {
    "id": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3",
    "number": 49,
    "createdAt": "2025-09-03T01:07:51.660Z",
    "updatedAt": "2025-09-03T01:07:51.660Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "d0ca9eac-0c55-46b2-b282-a67d53c304f3",
      "text": "*Phần ca trưởng. Của con cái ông Cô-rắc. Thánh vịnh.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:29:41.742Z",
      "updatedAt": "2025-09-03T02:29:41.742Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "1cdaedd7-00e4-43d4-9faf-8db0af2b28bf",
      "text": "Hãy nghe đây, ngàn muôn dân hỡi,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:41.794Z",
      "updatedAt": "2025-09-03T02:29:41.794Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "bd9c1d6b-3bb2-41f1-b223-7e48516d9cae",
      "text": "lắng tai nào, hết thảy thế nhân,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:41.807Z",
      "updatedAt": "2025-09-03T02:29:41.807Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "f05d4a0d-fbcd-439a-9c48-cb4f65c7436e",
      "text": "cả thường dân lẫn người quyền quý,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:41.821Z",
      "updatedAt": "2025-09-03T02:29:41.821Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "1dd51a61-1ff0-4749-a80f-7ecc886dab40",
      "text": "hạng phú gia với kẻ cơ bần.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:41.836Z",
      "updatedAt": "2025-09-03T02:29:41.836Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "25076987-f34f-4178-bbdf-fba5332456d5",
      "text": "Miệng tôi nói lời hay lẽ phải,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:41.852Z",
      "updatedAt": "2025-09-03T02:29:41.852Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "7dcbe7f0-214c-413d-a822-fc4da93bdb1f",
      "text": "lòng gẫm suy câu khéo điều khôn,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:41.866Z",
      "updatedAt": "2025-09-03T02:29:41.866Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "8ac0cedf-6ed0-48b3-97b4-fb78f240870c",
      "text": "tai lắng nghe nhịp câu ngạn ngữ,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:41.880Z",
      "updatedAt": "2025-09-03T02:29:41.880Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "b52da063-9f73-4d2e-bdf3-413b83e32cd0",
      "text": "mượn phím đàn giải nghĩa nhiệm mầu.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:41.901Z",
      "updatedAt": "2025-09-03T02:29:41.901Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "fb435bfb-6549-43a6-a411-6d1a86305ad0",
      "text": "Ngày vận hạn cớ chi phải sợ,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:41.928Z",
      "updatedAt": "2025-09-03T02:29:41.928Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "aa0e0d0a-b5e8-46ac-bb85-8dc94658ed74",
      "text": "lúc bọn gian manh theo sát bủa vây tôi ?",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:41.939Z",
      "updatedAt": "2025-09-03T02:29:41.939Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "7b8f2122-d664-4744-a9de-10e9987ba30f",
      "text": "Chúng cậy vào của cải,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:41.951Z",
      "updatedAt": "2025-09-03T02:29:41.951Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "4aad8962-5bba-4b97-80d9-b98fdae30496",
      "text": "lại vênh vang bởi lắm bạc tiền.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:41.975Z",
      "updatedAt": "2025-09-03T02:29:41.975Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "37d20945-57ba-4fcd-a6e8-d3f4176696be",
      "text": "Nhưng nào có ai tự chuộc nổi mình",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:41.986Z",
      "updatedAt": "2025-09-03T02:29:41.986Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "75777ca5-fba7-4a66-b24a-a60eafa10da3",
      "text": "và trả được giá thục hồi cho Thiên Chúa ?",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:41.998Z",
      "updatedAt": "2025-09-03T02:29:41.998Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "b3fdee5c-b91f-4915-be2d-bf94f6e6805d",
      "text": "Mạng người dù giá cao mấy nữa,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:42.010Z",
      "updatedAt": "2025-09-03T02:29:42.010Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "56902b8c-5854-4c49-9be0-c87b0f82b9a0",
      "text": "thì rồi ra cũng chấm dứt đời đời.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:42.024Z",
      "updatedAt": "2025-09-03T02:29:42.024Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "05c40e84-5403-456f-a4f9-b6f86645ba9c",
      "text": "Nào phàm nhân sống mãi được sao",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:42.053Z",
      "updatedAt": "2025-09-03T02:29:42.053Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "e3e43295-5348-49a1-b0e7-34c557287edd",
      "text": "mà chẳng phải đến ngày tận số ?",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:42.067Z",
      "updatedAt": "2025-09-03T02:29:42.067Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "c479178c-f0e5-41c3-9d5b-b3dc41931893",
      "text": "Kìa thiên hạ thấy người khôn cũng chết,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:42.085Z",
      "updatedAt": "2025-09-03T02:29:42.085Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "0a15af25-9410-4469-98d0-00ae0823050c",
      "text": "kẻ ngu đần dại dột cũng tiêu vong,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:42.115Z",
      "updatedAt": "2025-09-03T02:29:42.115Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "d96309db-2e9a-4fab-b800-c4ba29de34fb",
      "text": "bỏ lại tài sản mình cho người khác.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:42.129Z",
      "updatedAt": "2025-09-03T02:29:42.129Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "6cf8e5ec-bd7b-400c-ad7c-c240815c2633",
      "text": "Tuy họ lấy tên mình mà đặt cho miền này xứ nọ,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:42.143Z",
      "updatedAt": "2025-09-03T02:29:42.143Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "67823a86-47b7-4cc1-b414-d26797afbca7",
      "text": "nhưng ba tấc đất mới thật là nhà,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:42.157Z",
      "updatedAt": "2025-09-03T02:29:42.157Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "50be67a4-a324-494e-aa03-4f510ee7c0f1",
      "text": "nơi họ ở muôn đời muôn kiếp.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:42.170Z",
      "updatedAt": "2025-09-03T02:29:42.170Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "6467436a-3765-4f7f-ae0c-1de420fb772d",
      "text": "Dù sống trong danh vọng,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:42.185Z",
      "updatedAt": "2025-09-03T02:29:42.185Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "eadaeef1-2675-4155-8bcb-18e5f626dd2e",
      "text": "con người cũng không thể trường tồn ;",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:42.199Z",
      "updatedAt": "2025-09-03T02:29:42.199Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "54920de5-692b-4887-84d4-61de1e11bc0a",
      "text": "thật nó chẳng khác chi",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:42.214Z",
      "updatedAt": "2025-09-03T02:29:42.214Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "2910266f-08e7-4a9b-822c-b96a8a7e830a",
      "text": "con vật một ngày kia phải chết.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 3,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:42.228Z",
      "updatedAt": "2025-09-03T02:29:42.228Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "9af22ee2-e906-455a-b944-c0f102951270",
      "text": "Phường tự mãn tự kiêu, số phận là thế đó,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:42.254Z",
      "updatedAt": "2025-09-03T02:29:42.254Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "d82f2b42-9e6a-45ee-9c5f-3c41c732a2d8",
      "text": "bọn ỷ tài khéo nói, hậu vận chính là đây.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:42.266Z",
      "updatedAt": "2025-09-03T02:29:42.266Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "69b1bfee-0502-4ff1-afd5-e2e74e63a59f",
      "text": "Như đoàn vật nhốt trong âm phủ,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:42.282Z",
      "updatedAt": "2025-09-03T02:29:42.282Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "0cd46ba7-5b10-482d-9661-ea1070f320b8",
      "text": "chính tử thần canh giữ chăn nuôi,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:42.295Z",
      "updatedAt": "2025-09-03T02:29:42.295Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "5cc4413b-f18e-462c-9ba3-707c1f0facf3",
      "text": "chúng nhào thẳng xuống nơi huyệt mả,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 2,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:42.309Z",
      "updatedAt": "2025-09-03T02:29:42.309Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "c39ef51b-a891-41e1-b93e-959123bd96ad",
      "text": "sẽ tiêu tan cả đến hình hài,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 3,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:42.323Z",
      "updatedAt": "2025-09-03T02:29:42.323Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "d47c1860-55f5-43ac-a383-623178048a5d",
      "text": "chốn âm phủ thành nơi cư ngụ.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 4,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:42.337Z",
      "updatedAt": "2025-09-03T02:29:42.337Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "4f796348-e2f0-42e2-8997-8091374e2d1f",
      "text": "Nhưng Chúa Trời sẽ chuộc mạng tôi,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:42.352Z",
      "updatedAt": "2025-09-03T02:29:42.352Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "24ebc3fa-267f-46dc-b9e8-3e5746daab87",
      "text": "gỡ tôi ra khỏi quyền lực âm phủ.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:42.366Z",
      "updatedAt": "2025-09-03T02:29:42.366Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "5e511b5e-e04f-4a29-bf7d-ad5ca7982236",
      "text": "Đừng sợ chi khi có kẻ phát tài,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:42.410Z",
      "updatedAt": "2025-09-03T02:29:42.410Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "b8d51646-53e5-462d-aef2-3524969834c8",
      "text": "hoặc cửa nhà tăng thêm vẻ phong lưu,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:42.424Z",
      "updatedAt": "2025-09-03T02:29:42.424Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "0eec5b37-9a57-4069-a112-958738374efc",
      "text": "vì khi chết, nó đâu mang được cả,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:42.437Z",
      "updatedAt": "2025-09-03T02:29:42.437Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "1b10bf74-28e9-4791-83af-b861b99afb98",
      "text": "kiếp vinh hoa chẳng theo xuống mộ phần.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:42.468Z",
      "updatedAt": "2025-09-03T02:29:42.468Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "b27655a3-411e-4088-811f-d17f9b2be9f4",
      "text": "Lúc sinh thời, nó tự hào tự đắc :",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:42.484Z",
      "updatedAt": "2025-09-03T02:29:42.484Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "33c0e912-b432-4c54-a0dc-90f7d29ee180",
      "text": "“Mình làm nên, thiên hạ tán dương mình !”",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:42.497Z",
      "updatedAt": "2025-09-03T02:29:42.497Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "3039e366-1536-41a0-bbd9-5afccd0d06cc",
      "text": "Nhưng rồi nó cùng tổ tiên về chung kiếp,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:42.512Z",
      "updatedAt": "2025-09-03T02:29:42.512Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "9bb613dd-d58c-44c0-be7e-6f5889697217",
      "text": "chẳng bao giờ còn được thấy ánh dương !",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:42.526Z",
      "updatedAt": "2025-09-03T02:29:42.526Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "5aa19681-3020-4e06-a9b6-f71740ce7307",
      "text": "Dù sống trong danh vọng,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:42.540Z",
      "updatedAt": "2025-09-03T02:29:42.540Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "93748d74-9e18-4fad-8262-5df5456846ce",
      "text": "con người cũng không hiểu biết gì ;",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:42.557Z",
      "updatedAt": "2025-09-03T02:29:42.557Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "d0d61ca1-b590-429d-a45a-fa55de8fac7f",
      "text": "thật nó chẳng khác chi",
      "label": "21",
      "number": 21,
      "subVerseIndex": 2,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:42.570Z",
      "updatedAt": "2025-09-03T02:29:42.570Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "40a83433-8a44-4d7f-9374-4bbc2ba85f29",
      "text": "con vật một ngày kia phải chết.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 3,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:42.587Z",
      "updatedAt": "2025-09-03T02:29:42.587Z",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    }
  ],
  "marks": [
    {
      "id": "39041add-523e-4baf-b45b-1b1c6a78849a",
      "content": "Đây là *một Thánh vịnh giáo huấn* về cuộc sống thịnh vượng và hạnh phúc bề ngoài của ác nhân, và về cái chết là biến cố không ai tránh nổi. Cái chết làm cho ác nhân phải bỏ lại tất cả. Cuộc đời là phù vân ; của cải, danh vọng cũng là phù vân. Thánh vịnh 49 này gồm những phần sau đây : **1**) Nhập đề : lời kêu gọi của tác giả là nhà hiền triết (cc. 2-5) ; **2**) Cái chết, số phận chung cho mọi người (cc. 6-14) ; **3**) Thiên Chúa, Đấng giải thoát tôi trung của Người khỏi quyền lực âm phủ (cc. 15-16) ; **4**) Bài học thực tiễn (cc. 17-21).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 26,
      "endOffset": 26,
      "createdAt": "2025-09-03T02:29:41.771Z",
      "updatedAt": "2025-09-03T02:29:41.771Z",
      "targetId": "c362303c-75cd-46de-a538-bab641c97005",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "8dec4fc5-317c-4331-bc2f-2a94068d4fd3"
    },
    {
      "id": "69a0808f-2020-441d-8c6f-362849be9719",
      "content": "Gr 9,22; Lc 12,16-21",
