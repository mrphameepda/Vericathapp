{
  "chapter": {
    "id": "7deac555-87a6-4f92-8402-aa29ad15dff6",
    "number": 50,
    "createdAt": "2025-09-03T01:07:51.660Z",
    "updatedAt": "2025-09-03T01:07:51.660Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "2ca78d26-f1ea-4a9b-b24e-0f4e15f11b1e",
      "text": "*Thánh vịnh của ông A-xáp.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:29:48.155Z",
      "updatedAt": "2025-09-03T02:29:48.155Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "5b7595c6-b90b-40e4-900e-8e00993bd5cc",
      "text": "ĐỨC CHÚA, Thượng Đế chí tôn, nay Người lên tiếng,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.207Z",
      "updatedAt": "2025-09-03T02:29:48.207Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "e2fdd52b-2729-43a2-8529-6546946b06c8",
      "text": "từ khắp cõi đông tây, Người triệu tập hoàn cầu.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.229Z",
      "updatedAt": "2025-09-03T02:29:48.229Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "50921e32-621d-4490-b27a-c47a5f5ec6ae",
      "text": "Tại Xi-on, cảnh sắc tuyệt vời, Thiên Chúa hiển minh,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.240Z",
      "updatedAt": "2025-09-03T02:29:48.240Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "09e5989c-358f-40cf-8d70-88d23d3dd5e5",
      "text": "Thiên Chúa ta ngự đến, Người không nín lặng.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.281Z",
      "updatedAt": "2025-09-03T02:29:48.281Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "8c8c5bcf-fe29-4c1f-b264-c362f31f71e0",
      "text": "Hàng tiền đạo : kìa lửa hồng thiêu đốt,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.295Z",
      "updatedAt": "2025-09-03T02:29:48.295Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "f760e27b-cc26-49d9-8057-da10168013c0",
      "text": "quân tả hữu : đây bạo vũ cuồng phong.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.309Z",
      "updatedAt": "2025-09-03T02:29:48.309Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "d6883dee-2dc4-4a26-aa33-fe7b6d22e14f",
      "text": "Chúa hạ lệnh đòi trời cao đất thấp",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.339Z",
      "updatedAt": "2025-09-03T02:29:48.339Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "9692f1f8-df99-4def-976f-9fc7be0417ac",
      "text": "phải ra phiên toà nghe Chúa xử dân Người.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.361Z",
      "updatedAt": "2025-09-03T02:29:48.361Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "1028dc3d-d6b8-4008-a79c-d8b4b5284b44",
      "text": "Rằng : “Hãy triệu tập cho Ta những người trung hiếu,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.375Z",
      "updatedAt": "2025-09-03T02:29:48.375Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "67a52172-2172-484a-8273-1af9fce1769c",
      "text": "những người đã giao ước với Ta bằng hy lễ.”",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.389Z",
      "updatedAt": "2025-09-03T02:29:48.389Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "64db10f8-e68b-4cf3-a419-da1c883bebc7",
      "text": "Các tầng trời tuyên bố Chúa công minh,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.404Z",
      "updatedAt": "2025-09-03T02:29:48.404Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "6afd649f-9e76-4271-8eaf-b1da4b29febd",
      "text": "vì chính Người sẽ đứng ra xét xử.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.418Z",
      "updatedAt": "2025-09-03T02:29:48.418Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "c4c0ce09-2bee-491b-acfb-16cab2f37b13",
      "text": "“Dân Ta hỡi, nghe đây Ta phán dạy,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.432Z",
      "updatedAt": "2025-09-03T02:29:48.432Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "7de79262-7f03-4b77-9d90-592c4e6e6866",
      "text": "này Ít-ra-en, Ta dẫn chứng tố ngươi.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.459Z",
      "updatedAt": "2025-09-03T02:29:48.459Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "7d3792e8-3113-4431-8423-d4f26618de4b",
      "text": "Ta là Thượng Đế, là Chúa ngươi thờ,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.488Z",
      "updatedAt": "2025-09-03T02:29:48.488Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "b8f10ac4-5e07-4d24-9d58-1be277c24fcf",
      "text": "“Ta chẳng trách cứ ngươi về hy lễ ;",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.505Z",
      "updatedAt": "2025-09-03T02:29:48.505Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "c3b7ccc9-c6f3-440c-b200-d292e6666937",
      "text": "lễ toàn thiêu của ngươi",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.519Z",
      "updatedAt": "2025-09-03T02:29:48.519Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "18a87b08-1094-4fce-a7e8-5ff3a9cf2f44",
      "text": "hằng nghi ngút trước mặt Ta đêm ngày.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.534Z",
      "updatedAt": "2025-09-03T02:29:48.534Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "b51a52f2-0041-487a-96a2-fd9b1f7c11ab",
      "text": "“Bò của ngươi, Ta nào có thiết ;",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.548Z",
      "updatedAt": "2025-09-03T02:29:48.548Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "08e5bb9d-f30c-42ce-a089-fb70f1578aba",
      "text": "chiên của ngươi, chẳng lẽ Ta ham !",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.564Z",
      "updatedAt": "2025-09-03T02:29:48.564Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "1a4e4615-450c-4fc0-84eb-dd22accbb5a7",
      "text": "Vì thú rừng là của Ta hết thảy,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.578Z",
      "updatedAt": "2025-09-03T02:29:48.578Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "e3195fdc-1006-4f65-835c-1d6b92aa14f3",
      "text": "cả ngàn muôn loài vật núi đồi.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.592Z",
      "updatedAt": "2025-09-03T02:29:48.592Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "eee4a801-0180-4d55-aeda-f279bd127d29",
      "text": "Mọi thứ chim trời, Ta đều biết rõ,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.606Z",
      "updatedAt": "2025-09-03T02:29:48.606Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "55756887-9655-494b-81c9-cb2d6c9a4c85",
      "text": "động vật nơi hoang dã thuộc về Ta.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.622Z",
      "updatedAt": "2025-09-03T02:29:48.622Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "04d58944-ca12-43f8-bfb4-d1f03317249a",
      "text": "Ta mà đói, Ta đâu cần nói ngươi hay,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.650Z",
      "updatedAt": "2025-09-03T02:29:48.650Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "ac2d115e-348d-4b2c-ba63-10b90bf7b381",
      "text": "vì trái đất với mọi loài, chính Ta làm chủ.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.666Z",
      "updatedAt": "2025-09-03T02:29:48.666Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "d596c011-e1ee-4b36-8f21-a71d4966962e",
      "text": "Thịt bò há là thức Ta ăn ?",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.680Z",
      "updatedAt": "2025-09-03T02:29:48.680Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "330f950b-19ff-44d2-aee3-07de99c65211",
      "text": "Máu chiên há là đồ Ta uống ?",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.694Z",
      "updatedAt": "2025-09-03T02:29:48.694Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "fe09e20f-9735-4a5c-a112-3e0ad1be3732",
      "text": "“Hãy tiến dâng Thiên Chúa lời tạ ơn làm hy lễ,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.708Z",
      "updatedAt": "2025-09-03T02:29:48.708Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "d6983d15-4314-4268-85e0-4a272522c4b0",
      "text": "giữ trọn điều khấn nguyền cùng Đấng Tối Cao.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.752Z",
      "updatedAt": "2025-09-03T02:29:48.752Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "aa6579b5-7fe9-4af4-8228-86db76c5a03f",
      "text": "Hãy kêu cầu Ta trong ngày cùng khốn,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.781Z",
      "updatedAt": "2025-09-03T02:29:48.781Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "b1f05dff-d2f5-47d0-a0af-e734851be69e",
      "text": "Ta sẽ giải thoát, và ngươi sẽ làm hiển danh Ta.”",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.796Z",
      "updatedAt": "2025-09-03T02:29:48.796Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "32438cec-b352-4fac-ada3-eae76ce7b026",
      "text": "Với kẻ gian ác, Thiên Chúa phán bảo rằng :",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.810Z",
      "updatedAt": "2025-09-03T02:29:48.810Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "7f113ecf-cf56-4bba-993a-3ee3f127f502",
      "text": "“Thánh chỉ của Ta, sao ngươi thường nhắc nhở,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.824Z",
      "updatedAt": "2025-09-03T02:29:48.824Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "39a629af-7cd5-4810-b73e-534004b412d8",
      "text": "mở miệng ra là chữ thánh ước trên môi ?",
      "label": "16",
      "number": 16,
      "subVerseIndex": 2,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.838Z",
      "updatedAt": "2025-09-03T02:29:48.838Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "cb36b32c-d511-45a9-8527-0d43134e608e",
      "text": "“Nhưng chính ngươi lại ghét điều sửa dạy,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.853Z",
      "updatedAt": "2025-09-03T02:29:48.853Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "4056b00d-4479-4211-9ed5-62b387fb8b61",
      "text": "lời Ta truyền, đem vất bỏ sau lưng.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.868Z",
      "updatedAt": "2025-09-03T02:29:48.868Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "a3b0e457-4511-4512-84af-8f8d9963ec87",
      "text": "Gặp tên trộm đạo, ngươi hùa theo nó,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.882Z",
      "updatedAt": "2025-09-03T02:29:48.882Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "0bf0a08d-c142-467c-9cc1-0b2c58fcf5d9",
      "text": "với bọn gian dâm, cũng lại thông đồng.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.897Z",
      "updatedAt": "2025-09-03T02:29:48.897Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "10ab5b82-e832-4138-9f20-02934a28e8d9",
      "text": "Miệng tha hồ nói năng ác độc,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.912Z",
      "updatedAt": "2025-09-03T02:29:48.912Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "6f0c1c02-5aab-427f-962e-19f323ee2daf",
      "text": "ba tấc lưỡi đặt điều xảo trá ;",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.926Z",
      "updatedAt": "2025-09-03T02:29:48.926Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "ac5a43e0-017f-4b70-928e-061063fcdb7d",
      "text": "hễ ngồi lê là bới xấu anh em",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.940Z",
      "updatedAt": "2025-09-03T02:29:48.940Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "67d5aed8-fd55-4db8-a7e0-c7e886b75117",
      "text": "và bêu diếu cả người ruột thịt.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.954Z",
      "updatedAt": "2025-09-03T02:29:48.954Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "e2a620fa-f49a-4365-aea0-6a1d830f16fb",
      "text": "“Ngươi làm thế, chẳng lẽ Ta thinh lặng,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.969Z",
      "updatedAt": "2025-09-03T02:29:48.969Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "40906f41-cd93-4066-aa4e-432c147e6e12",
      "text": "ngươi tưởng rằng Ta cũng giống ngươi sao ?",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.983Z",
      "updatedAt": "2025-09-03T02:29:48.983Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "9e626ff9-d546-4f22-892d-532a380b4b75",
      "text": "Này đây Ta khiển trách,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 2,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:48.998Z",
      "updatedAt": "2025-09-03T02:29:48.998Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "a15fe923-71dd-471e-9222-839f1ad0e523",
      "text": "những tội kia, Ta vạch rõ ngươi xem.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 3,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:49.011Z",
      "updatedAt": "2025-09-03T02:29:49.011Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "f4481e41-7ce9-4767-8e23-d02e10f7752d",
      "text": "“Hỡi những người lãng quên Thượng Đế,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:49.027Z",
      "updatedAt": "2025-09-03T02:29:49.027Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "05d900f7-0908-4feb-aa80-bc4da173158b",
      "text": "gắng mà hiểu cho tường,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:49.041Z",
      "updatedAt": "2025-09-03T02:29:49.041Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "af69a362-3c66-4e3f-8d63-a444f29bc805",
      "text": "kẻo rồi Ta xé nát, chẳng còn ai cứu thoát được đâu !",
      "label": "22",
      "number": 22,
      "subVerseIndex": 2,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:49.056Z",
      "updatedAt": "2025-09-03T02:29:49.056Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "19e87e31-eb08-4c0b-a4ff-31263eeeab52",
      "text": "“Kẻ dâng lời tạ ơn làm hy lễ sẽ làm hiển danh Ta.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:49.070Z",
      "updatedAt": "2025-09-03T02:29:49.070Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    },
    {
      "id": "ffad9d09-ab68-4f5b-9ca0-d7d47fbeb379",
      "text": "Ai sống đời hoàn hảo, Ta cho hưởng ơn cứu độ Chúa Trời.”",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:29:49.084Z",
      "updatedAt": "2025-09-03T02:29:49.084Z",
      "chapterId": "7deac555-87a6-4f92-8402-aa29ad15dff6"
    }
  ],
  "marks": [
    {
      "id": "c3bdfe25-a392-4e0d-b517-90d96b81abc4",
      "content": "Tv 50 thuộc loại các *Tv ngôn sứ* (81 ; 95,7b-11). Có thể chia Tv làm bốn phần : **1**) Nhập đề long trọng (miêu tả cuộc thần hiện) (cc. 1-6) ; **2**) Thái độ của Thiên Chúa chống lại những kẻ dùng các nghi lễ bên ngoài để che giấu đời sống luân lý xấu xa hoặc để thúc đẩy Thiên Chúa đương nhiên đáp lại lòng quảng đại của họ (cc. 7-15) ; **3**) Thiên Chúa sẽ vạch rõ những tội kể trong đoạn này : vi phạm giao ước, ăn cắp ăn trộm, tà dâm, ngoại tình, ăn nói ác độc, đặt điều nói xấu (cc. 16-22a) ; **4**) Kết luận (cc. 22b-23).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
