{
  "chapter": {
    "id": "1a284c90-93b5-4924-9991-8023bcef6215",
    "number": 52,
    "createdAt": "2025-09-03T01:07:51.660Z",
    "updatedAt": "2025-09-03T01:07:51.660Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "e3042c50-f425-4e16-9012-ca451adef189",
      "text": "*Phần ca trưởng. Thi khúc. Của vua Đa-vít.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:30:01.248Z",
      "updatedAt": "2025-09-03T02:30:01.248Z",
      "chapterId": "1a284c90-93b5-4924-9991-8023bcef6215"
    },
    {
      "id": "1a1081f8-969c-47ae-9fbb-80dee5d57bc7",
      "text": "*Khi Đô-ếch, người Ê-đôm, đến báo cho vua Sa-un rằng : “Đa-vít đến gặp ông A-khi-me-léc !”*",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 1,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:30:01.298Z",
      "updatedAt": "2025-09-03T02:30:01.298Z",
      "chapterId": "1a284c90-93b5-4924-9991-8023bcef6215"
    },
    {
      "id": "3cba952a-ff1a-462a-87f4-92b5a19ad798",
      "text": "Hỡi kẻ gian hùng, khoe chi tội ác ?",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:01.392Z",
      "updatedAt": "2025-09-03T02:30:01.392Z",
      "chapterId": "1a284c90-93b5-4924-9991-8023bcef6215"
    },
    {
      "id": "9fd1a298-bb35-480c-a962-3fc9f3aec52d",
      "text": "Suốt ngày ngươi tính kế hại người !",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:01.407Z",
      "updatedAt": "2025-09-03T02:30:01.407Z",
      "chapterId": "1a284c90-93b5-4924-9991-8023bcef6215"
    },
    {
      "id": "caf70b37-2a85-479c-a548-54dd266b904b",
      "text": "Này hỡi tên chuyên nghề lừa đảo,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:01.421Z",
      "updatedAt": "2025-09-03T02:30:01.421Z",
      "chapterId": "1a284c90-93b5-4924-9991-8023bcef6215"
    },
    {
      "id": "c08119fb-7cef-4dfe-b854-441aa3e41f2b",
      "text": "lưỡi ngươi khác nào dao sắc bén.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:01.435Z",
      "updatedAt": "2025-09-03T02:30:01.435Z",
      "chapterId": "1a284c90-93b5-4924-9991-8023bcef6215"
    },
    {
      "id": "63b80e59-941a-401b-9d37-a4d9dfeebe79",
      "text": "Ngươi ưa điều dữ hơn điều lành.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:01.464Z",
      "updatedAt": "2025-09-03T02:30:01.464Z",
      "chapterId": "1a284c90-93b5-4924-9991-8023bcef6215"
    },
    {
      "id": "058fb17a-12a9-4625-8b6f-6ba1b23ae1ba",
      "text": "chuộng điều gian dối hơn sự thật.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:01.478Z",
      "updatedAt": "2025-09-03T02:30:01.478Z",
      "chapterId": "1a284c90-93b5-4924-9991-8023bcef6215"
    },
    {
      "id": "4b5fd22c-42c3-4ee9-9c9c-7e1665634511",
      "text": "Ngươi thích nói toàn lời độc ác,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:01.493Z",
      "updatedAt": "2025-09-03T02:30:01.493Z",
      "chapterId": "1a284c90-93b5-4924-9991-8023bcef6215"
    },
    {
      "id": "490ea6a1-7237-41a1-a97f-cdaa2a0e769e",
      "text": "ôi miệng lưỡi điêu ngoa !",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:01.507Z",
      "updatedAt": "2025-09-03T02:30:01.507Z",
      "chapterId": "1a284c90-93b5-4924-9991-8023bcef6215"
    },
    {
      "id": "a9038a9d-ec80-4ce8-8e18-81db983c9046",
      "text": "Nên Chúa Trời sẽ tiêu diệt ngươi vĩnh viễn,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:01.525Z",
      "updatedAt": "2025-09-03T02:30:01.525Z",
      "chapterId": "1a284c90-93b5-4924-9991-8023bcef6215"
    },
    {
      "id": "1bd6205d-c553-4f89-8e86-469f96df1794",
      "text": "lượm ngươi đi, đem vất khỏi lều,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:01.552Z",
      "updatedAt": "2025-09-03T02:30:01.552Z",
      "chapterId": "1a284c90-93b5-4924-9991-8023bcef6215"
    },
    {
      "id": "8da847dc-c323-4ff0-b680-7fadd08c00d0",
      "text": "và bứng gốc khỏi nơi dương thế.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:01.569Z",
      "updatedAt": "2025-09-03T02:30:01.569Z",
      "chapterId": "1a284c90-93b5-4924-9991-8023bcef6215"
    },
    {
      "id": "9046913f-28cd-4a9b-9b57-b906a26379d6",
      "text": "Nhìn thấy vậy, chính nhân sợ hãi,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:01.582Z",
      "updatedAt": "2025-09-03T02:30:01.582Z",
      "chapterId": "1a284c90-93b5-4924-9991-8023bcef6215"
    },
    {
      "id": "71ae030c-b936-4f1e-8efa-ed25178c10b4",
      "text": "nhạo cười rằng : nó đích thị là người",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:01.597Z",
      "updatedAt": "2025-09-03T02:30:01.597Z",
      "chapterId": "1a284c90-93b5-4924-9991-8023bcef6215"
    },
    {
      "id": "4e3a0cf8-e4f9-4cb5-b6c0-e9494cf0548b",
      "text": "chẳng lấy Chúa làm nơi ẩn náu,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:01.610Z",
      "updatedAt": "2025-09-03T02:30:01.610Z",
      "chapterId": "1a284c90-93b5-4924-9991-8023bcef6215"
    },
    {
      "id": "7ccf104d-db44-4e27-8d00-b17a1bb98015",
      "text": "nhưng chỉ tin cậy vào đống tiền đống của",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:01.625Z",
      "updatedAt": "2025-09-03T02:30:01.625Z",
      "chapterId": "1a284c90-93b5-4924-9991-8023bcef6215"
    },
    {
      "id": "4d6ba2eb-e3bd-417f-b780-0fa57d012616",
      "text": "và khoe khoang mưu độc của mình.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 3,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:01.655Z",
      "updatedAt": "2025-09-03T02:30:01.655Z",
      "chapterId": "1a284c90-93b5-4924-9991-8023bcef6215"
    },
    {
      "id": "213dddce-0f11-4a59-a9e3-32b67e60537a",
      "text": "Còn phần tôi,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:01.670Z",
      "updatedAt": "2025-09-03T02:30:01.670Z",
      "chapterId": "1a284c90-93b5-4924-9991-8023bcef6215"
    },
    {
      "id": "8171ed65-bfab-4a41-9239-ebc27cdc46e4",
      "text": "khác gì cây ô-liu xanh rờn trong nhà Thiên Chúa,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:01.684Z",
      "updatedAt": "2025-09-03T02:30:01.684Z",
      "chapterId": "1a284c90-93b5-4924-9991-8023bcef6215"
    },
    {
      "id": "4198b560-61c4-440f-801c-f1d18f0b0b0f",
      "text": "tôi tin cậy vào tình thương Thiên Chúa",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:01.713Z",
      "updatedAt": "2025-09-03T02:30:01.713Z",
      "chapterId": "1a284c90-93b5-4924-9991-8023bcef6215"
    },
    {
      "id": "40559f4e-ec8a-4eba-8def-e36b19ff2bac",
      "text": "mãi mãi đến muôn đời.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 3,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:01.741Z",
      "updatedAt": "2025-09-03T02:30:01.741Z",
      "chapterId": "1a284c90-93b5-4924-9991-8023bcef6215"
    },
    {
      "id": "1b25db7b-8e58-47aa-a31e-01c10adf39f4",
      "text": "Lạy Chúa, con nguyện tạ ơn Ngài luôn mãi, vì Ngài đã ra tay.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:01.755Z",
      "updatedAt": "2025-09-03T02:30:01.755Z",
      "chapterId": "1a284c90-93b5-4924-9991-8023bcef6215"
    },
    {
      "id": "5e7b6384-c36b-4e79-9d14-143e79949ec4",
      "text": "Trước mặt những người hiếu trung với Chúa,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:01.769Z",
      "updatedAt": "2025-09-03T02:30:01.769Z",
      "chapterId": "1a284c90-93b5-4924-9991-8023bcef6215"
    },
    {
      "id": "51847cc2-a5c1-4dfa-becd-cfe64dc1717b",
      "text": "con trông đợi danh Ngài, vì danh Ngài thiện hảo.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:01.783Z",
      "updatedAt": "2025-09-03T02:30:01.783Z",
      "chapterId": "1a284c90-93b5-4924-9991-8023bcef6215"
    }
  ],
  "marks": [
    {
      "id": "f7991ae9-ae6d-4474-8625-337ff0916466",
      "content": "Đây là *một Tv giáo huấn*. Nhưng cũng có học giả cho rằng Tv 52 là một Tv hỗn hợp : Tv vừa là một Tv giáo huấn mang tính cách khuyên răn về mặt luân lý, vừa là một ai ca của cá nhân. Tv chia làm hai phần chính : **1**) Lời đả kích kẻ quyền thế bất lương (lừa đảo, gian dối, điêu ngoa) (cc. 3-9) ; **2**) Số phận may mắn của người ẩn náu bên Chúa, tin cậy vào Người (cc. 10-11).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 46,
      "endOffset": 46,
      "createdAt": "2025-09-03T02:30:01.276Z",
