{
  "chapter": {
    "id": "5f744ae6-6a3e-4b25-a458-7d931c3b938a",
    "number": 53,
    "createdAt": "2025-09-03T01:07:51.660Z",
    "updatedAt": "2025-09-03T01:07:51.660Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "fe3b9a93-d4d0-45df-b631-ae6e3043ccd5",
      "text": "*Phần ca trưởng. Cho cơn bệnh. Thi khúc. Của vua Đa-vít.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:30:07.226Z",
      "updatedAt": "2025-09-03T02:30:07.226Z",
      "chapterId": "5f744ae6-6a3e-4b25-a458-7d931c3b938a"
    },
    {
      "id": "9a24c38b-bda1-4581-be7c-6e00b5bcd00d",
      "text": "Kẻ ngu si tự nhủ : “Làm chi có Chúa Trời !”",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:07.277Z",
      "updatedAt": "2025-09-03T02:30:07.277Z",
      "chapterId": "5f744ae6-6a3e-4b25-a458-7d931c3b938a"
    },
    {
      "id": "8ce2a81e-5d01-4209-a849-06e1f74ed0bf",
      "text": "Chúng đã ra hư đốn, làm những điều ghê tởm,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:07.302Z",
      "updatedAt": "2025-09-03T02:30:07.302Z",
      "chapterId": "5f744ae6-6a3e-4b25-a458-7d931c3b938a"
    },
    {
      "id": "0a8cad25-7ad9-4116-a334-9caefad6f664",
      "text": "chẳng có một ai làm điều thiện.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:07.316Z",
      "updatedAt": "2025-09-03T02:30:07.316Z",
      "chapterId": "5f744ae6-6a3e-4b25-a458-7d931c3b938a"
    },
    {
      "id": "ff2510ea-bb7c-48a0-b658-bc01b0081d63",
      "text": "Từ trời cao Thiên Chúa nhìn xuống loài người,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:07.330Z",
      "updatedAt": "2025-09-03T02:30:07.330Z",
      "chapterId": "5f744ae6-6a3e-4b25-a458-7d931c3b938a"
    },
    {
      "id": "00f63dde-f582-4878-9a8f-67bc40a539d5",
      "text": "xem ai là kẻ có lương tri, biết kiếm tìm Thiên Chúa.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:07.344Z",
      "updatedAt": "2025-09-03T02:30:07.344Z",
      "chapterId": "5f744ae6-6a3e-4b25-a458-7d931c3b938a"
    },
    {
      "id": "c63229b6-cb55-46af-a766-da21ed386b87",
      "text": "Người người đã lìa xa chính lộ,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:07.358Z",
      "updatedAt": "2025-09-03T02:30:07.358Z",
      "chapterId": "5f744ae6-6a3e-4b25-a458-7d931c3b938a"
    },
    {
      "id": "70aff37a-7f2b-4cc6-9db4-f3eedb466dc5",
      "text": "chỉ biết theo nhau làm chuyện suy đồi,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:07.372Z",
      "updatedAt": "2025-09-03T02:30:07.372Z",
      "chapterId": "5f744ae6-6a3e-4b25-a458-7d931c3b938a"
    },
    {
      "id": "03fd3aa4-1acb-4e9c-9086-d55f33955751",
      "text": "chẳng có một ai làm điều thiện,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:07.386Z",
      "updatedAt": "2025-09-03T02:30:07.386Z",
      "chapterId": "5f744ae6-6a3e-4b25-a458-7d931c3b938a"
    },
    {
      "id": "fee367f0-3a1b-4218-9e42-9004ddefce90",
      "text": "dẫu một người cũng không.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 3,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:07.401Z",
      "updatedAt": "2025-09-03T02:30:07.401Z",
      "chapterId": "5f744ae6-6a3e-4b25-a458-7d931c3b938a"
    },
    {
      "id": "921e5181-92fe-4dff-9041-bbf22c943275",
      "text": "Những kẻ làm điều ác, kẻ sống trên xương máu đồng bào ta,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:07.415Z",
      "updatedAt": "2025-09-03T02:30:07.415Z",
      "chapterId": "5f744ae6-6a3e-4b25-a458-7d931c3b938a"
    },
    {
      "id": "c4139308-5edb-4014-b284-422480e50c04",
      "text": "kẻ không cầu khẩn Thiên Chúa, há chẳng hiểu biết gì ?",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:07.429Z",
      "updatedAt": "2025-09-03T02:30:07.429Z",
      "chapterId": "5f744ae6-6a3e-4b25-a458-7d931c3b938a"
    },
    {
      "id": "cb151d7c-da7b-41b6-b2fa-f05efd7603a4",
      "text": "Này chúng phải kinh hoàng sợ hãi,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:07.443Z",
      "updatedAt": "2025-09-03T02:30:07.443Z",
      "chapterId": "5f744ae6-6a3e-4b25-a458-7d931c3b938a"
    },
    {
      "id": "70648bf5-344c-4a15-8c57-6a5d2b0006aa",
      "text": "khi chẳng có chi phải kinh hoàng,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:07.457Z",
      "updatedAt": "2025-09-03T02:30:07.457Z",
      "chapterId": "5f744ae6-6a3e-4b25-a458-7d931c3b938a"
    },
    {
      "id": "68d7d581-ac24-4e01-886c-6a0f4c5fc8d5",
      "text": "vì Thiên Chúa làm tan xương nát thịt",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:07.471Z",
      "updatedAt": "2025-09-03T02:30:07.471Z",
      "chapterId": "5f744ae6-6a3e-4b25-a458-7d931c3b938a"
    },
    {
      "id": "4b90fb02-fbfa-4685-ab13-41de12e864cf",
      "text": "những kẻ nào vây hãm dân Ta.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 3,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:07.485Z",
      "updatedAt": "2025-09-03T02:30:07.485Z",
      "chapterId": "5f744ae6-6a3e-4b25-a458-7d931c3b938a"
    },
    {
      "id": "5d1b6639-af97-4c19-8934-384a20c1459f",
      "text": "Chúng sẽ phải thẹn thùng, vì Thiên Chúa đã ruồng bỏ chúng.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 4,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:07.515Z",
      "updatedAt": "2025-09-03T02:30:07.515Z",
      "chapterId": "5f744ae6-6a3e-4b25-a458-7d931c3b938a"
    },
    {
      "id": "ee93f26b-eb1d-49c5-a255-0af2f5fb7883",
      "text": "Từ Xi-on, ai sẽ đem lại ơn cứu độ cho Ít-ra-en ?",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:07.529Z",
      "updatedAt": "2025-09-03T02:30:07.529Z",
      "chapterId": "5f744ae6-6a3e-4b25-a458-7d931c3b938a"
    },
    {
      "id": "fc42fb18-fe10-482c-a614-60b73e7b04a2",
      "text": "Khi Chúa đổi vận mệnh dân Người,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:07.573Z",
      "updatedAt": "2025-09-03T02:30:07.573Z",
      "chapterId": "5f744ae6-6a3e-4b25-a458-7d931c3b938a"
    },
    {
      "id": "a3400b3e-f3d1-4c97-98ca-17a9e3f9c224",
      "text": "nhà Gia-cóp vui mừng biết mấy,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:07.584Z",
      "updatedAt": "2025-09-03T02:30:07.584Z",
      "chapterId": "5f744ae6-6a3e-4b25-a458-7d931c3b938a"
    },
    {
      "id": "571b6bb5-457c-42a7-84d5-fb9eaa348f69",
      "text": "dân Ít-ra-en hớn hở dường bao !",
      "label": "7",
      "number": 7,
      "subVerseIndex": 3,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:07.607Z",
      "updatedAt": "2025-09-03T02:30:07.607Z",
      "chapterId": "5f744ae6-6a3e-4b25-a458-7d931c3b938a"
    }
  ],
