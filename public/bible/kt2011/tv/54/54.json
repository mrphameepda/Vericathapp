{
  "chapter": {
    "id": "742e56f1-d3aa-4e11-b185-04739b9f7928",
    "number": 54,
    "createdAt": "2025-09-03T01:07:51.660Z",
    "updatedAt": "2025-09-03T01:07:51.660Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "b6e2a307-e033-47b1-bf57-b7f3997696dc",
      "text": "*Phần ca trưởng. Theo huyền cầm. Thi khúc. Của vua Đa-vít.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:30:12.762Z",
      "updatedAt": "2025-09-03T02:30:12.762Z",
      "chapterId": "742e56f1-d3aa-4e11-b185-04739b9f7928"
    },
    {
      "id": "a788f278-4cb8-4c52-b948-4c3eca0d1ff4",
      "text": "*Nhân vụ dân Díp đến gặp vua Sa-un và thưa : “Này, Đa-vít lại không ẩn núp nơi chúng tôi đó sao ?”*",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 1,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:30:12.825Z",
      "updatedAt": "2025-09-03T02:30:12.825Z",
      "chapterId": "742e56f1-d3aa-4e11-b185-04739b9f7928"
    },
    {
      "id": "849cacc9-5492-457c-a0ca-b810101dd24f",
      "text": "Lạy Thiên Chúa, xin dùng uy danh mà cứu độ,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:12.880Z",
      "updatedAt": "2025-09-03T02:30:12.880Z",
      "chapterId": "742e56f1-d3aa-4e11-b185-04739b9f7928"
    },
    {
      "id": "807cdd5f-ef8d-45d9-b910-1238568d6591",
      "text": "lấy quyền năng Ngài mà xử cho con.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:12.894Z",
      "updatedAt": "2025-09-03T02:30:12.894Z",
      "chapterId": "742e56f1-d3aa-4e11-b185-04739b9f7928"
    },
    {
      "id": "6e703b26-1df6-4e24-acdd-732e2fad430c",
      "text": "Lạy Thiên Chúa, xin nghe con nguyện cầu,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:12.908Z",
      "updatedAt": "2025-09-03T02:30:12.908Z",
      "chapterId": "742e56f1-d3aa-4e11-b185-04739b9f7928"
    },
    {
      "id": "880a6f5c-a62e-48ca-b930-8333efdb05d5",
      "text": "lắng tai nghe lời con thưa gửi.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:12.923Z",
      "updatedAt": "2025-09-03T02:30:12.923Z",
      "chapterId": "742e56f1-d3aa-4e11-b185-04739b9f7928"
    },
    {
      "id": "87e7aaf2-26f1-4ad8-a8df-1f26f4bf37ca",
      "text": "Phường kiêu ngạo nổi lên chống đối,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:12.937Z",
      "updatedAt": "2025-09-03T02:30:12.937Z",
      "chapterId": "742e56f1-d3aa-4e11-b185-04739b9f7928"
    },
    {
      "id": "5c1800d0-4395-49c2-90e5-82d181a5c7d5",
      "text": "bọn hung tàn tìm hại mạng sống con,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:12.965Z",
      "updatedAt": "2025-09-03T02:30:12.965Z",
      "chapterId": "742e56f1-d3aa-4e11-b185-04739b9f7928"
    },
    {
      "id": "4021f497-676a-476b-8b0b-0d3559aad902",
      "text": "chúng không kể gì đến Thiên Chúa.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:12.980Z",
      "updatedAt": "2025-09-03T02:30:12.980Z",
      "chapterId": "742e56f1-d3aa-4e11-b185-04739b9f7928"
    },
    {
      "id": "b62f5466-1079-4457-b61a-c022b8cbb6ff",
      "text": "Nhưng này có Thiên Chúa phù trì,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:12.994Z",
      "updatedAt": "2025-09-03T02:30:12.994Z",
      "chapterId": "742e56f1-d3aa-4e11-b185-04739b9f7928"
    },
    {
      "id": "1acc6936-2e5b-4398-b60e-e6225e3b3cc9",
      "text": "thân con đây, Chúa hằng nâng đỡ.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:13.008Z",
      "updatedAt": "2025-09-03T02:30:13.008Z",
      "chapterId": "742e56f1-d3aa-4e11-b185-04739b9f7928"
    },
    {
      "id": "20bcb8f8-2342-4bba-87f8-a6e1e29b5dee",
      "text": "Ước chi điều ác quật lại kẻ rình hại con,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:13.022Z",
      "updatedAt": "2025-09-03T02:30:13.022Z",
      "chapterId": "742e56f1-d3aa-4e11-b185-04739b9f7928"
    },
    {
      "id": "d55178b1-86a3-49d0-a878-fcb3f297c910",
      "text": "vì Ngài thành tín, xin tiêu diệt chúng.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:13.051Z",
      "updatedAt": "2025-09-03T02:30:13.051Z",
      "chapterId": "742e56f1-d3aa-4e11-b185-04739b9f7928"
    },
    {
      "id": "eead93cb-8bf2-4026-a225-9acfdc640a16",
      "text": "Con tự nguyện dâng Ngài lễ tế,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:13.065Z",
      "updatedAt": "2025-09-03T02:30:13.065Z",
      "chapterId": "742e56f1-d3aa-4e11-b185-04739b9f7928"
    },
    {
      "id": "222261ce-e2ab-4f9d-bca1-6c0f87b70493",
      "text": "lạy CHÚA, con xưng tụng danh Ngài,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:13.094Z",
      "updatedAt": "2025-09-03T02:30:13.094Z",
      "chapterId": "742e56f1-d3aa-4e11-b185-04739b9f7928"
    },
    {
      "id": "4a9eb82b-2705-498b-af9f-c979506f3373",
      "text": "thật danh Ngài thiện hảo,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:13.108Z",
      "updatedAt": "2025-09-03T02:30:13.108Z",
      "chapterId": "742e56f1-d3aa-4e11-b185-04739b9f7928"
    },
    {
      "id": "88b40960-aae7-47bc-bea5-2e9ad5b36b92",
      "text": "vì Chúa giải thoát con khỏi mọi gian nguy,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:13.136Z",
      "updatedAt": "2025-09-03T02:30:13.136Z",
      "chapterId": "742e56f1-d3aa-4e11-b185-04739b9f7928"
    },
    {
      "id": "1616b3f6-068d-483a-a1ba-d56c1ad456e7",
      "text": "và con đã dám nghênh bọn địch thù.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:13.152Z",
      "updatedAt": "2025-09-03T02:30:13.152Z",
      "chapterId": "742e56f1-d3aa-4e11-b185-04739b9f7928"
    }
  ],
