{
  "chapter": {
    "id": "ec40e693-cfb3-407e-ad52-6209d8768534",
    "number": 55,
    "createdAt": "2025-09-03T01:07:51.660Z",
    "updatedAt": "2025-09-03T01:07:51.660Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "db893011-4ae0-4379-8bec-be9169c6459d",
      "text": "*Phần ca trưởng. Theo huyền cầm. Thi khúc. Của vua Đa-vít.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:30:18.273Z",
      "updatedAt": "2025-09-03T02:30:18.273Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "e1acd4b5-6716-485a-893c-51e73c4f5a3e",
      "text": "Lạy Chúa Trời, xin lắng nghe lời con cầu nguyện,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:18.323Z",
      "updatedAt": "2025-09-03T02:30:18.323Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "47458f03-59c6-444f-99e1-0985799c2c63",
      "text": "con khẩn nài, xin đừng nỡ làm ngơ,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:18.346Z",
      "updatedAt": "2025-09-03T02:30:18.346Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "7473f288-7923-4f72-a104-3acfe4e197f2",
      "text": "xin để ý đến con và thương đáp lại.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:18.358Z",
      "updatedAt": "2025-09-03T02:30:18.358Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "3ff825af-d056-41ca-9175-81df6202acff",
      "text": "Con kêu than, thốt ra lời lảm nhảm,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:18.372Z",
      "updatedAt": "2025-09-03T02:30:18.372Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "8e765953-15f8-4ffa-9875-9c1fcd467fcd",
      "text": "lòng xao xuyến bởi địch thù thét gào, bởi ác nhân hà hiếp.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:18.387Z",
      "updatedAt": "2025-09-03T02:30:18.387Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "7162401c-dc01-45fd-a8e4-83bdcaa66d42",
      "text": "Trên thân này, chúng gieo tai giáng hoạ,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:18.401Z",
      "updatedAt": "2025-09-03T02:30:18.401Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "09688039-939e-4d95-97a6-b348045d7e27",
      "text": "nộ khí hằm hằm, xông đến hại con.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:18.415Z",
      "updatedAt": "2025-09-03T02:30:18.415Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "2fbd9dee-8700-424c-8215-c45baeb3645a",
      "text": "Nghe trong mình tim đau thắt lại,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:18.429Z",
      "updatedAt": "2025-09-03T02:30:18.429Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "d21dc594-85d3-48b9-9149-d3f53ad898d5",
      "text": "bóng tử thần khủng khiếp chụp xuống con.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:18.444Z",
      "updatedAt": "2025-09-03T02:30:18.444Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "d85229c7-e6c3-49c0-b0a0-a0a75861d6e2",
      "text": "Bao run sợ nhập cả vào người,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:18.472Z",
      "updatedAt": "2025-09-03T02:30:18.472Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "f6562706-f2bc-4ebf-afd4-8dd29be71ada",
      "text": "cơn kinh hãi tư bề phủ lấp.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:18.486Z",
      "updatedAt": "2025-09-03T02:30:18.486Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "87aa540c-b0a8-48ba-9b76-2cdcb7cd1be0",
      "text": "Con tự nhủ : “Phải chi được đôi cánh bồ câu",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:18.500Z",
      "updatedAt": "2025-09-03T02:30:18.500Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "d004e6ec-4d3f-4ca6-91d7-7655c73b6f70",
      "text": "để bay bổng tìm nơi an nghỉ !",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:18.514Z",
      "updatedAt": "2025-09-03T02:30:18.514Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "d99757ea-6edc-4059-9d4e-d9e1a1e8e697",
      "text": "Tôi sẽ lánh đi mãi tận chốn xa vời, vào ở trong sa mạc.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:18.529Z",
      "updatedAt": "2025-09-03T02:30:18.529Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "2e8caa7e-bce9-4333-9b77-31cba7c2fd40",
      "text": "Tôi sẽ vội tìm nơi ẩn trú, tránh khỏi cơn dông tố bão bùng.”",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:18.544Z",
      "updatedAt": "2025-09-03T02:30:18.544Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "dba67e71-3991-45a3-ab88-ac0fd559b0d6",
      "text": "Lạy Chúa, xin Ngài gây xáo trộn",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:18.571Z",
      "updatedAt": "2025-09-03T02:30:18.571Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "bcb859df-44e1-4905-ab56-cbaee42fe43b",
      "text": "và làm cho ngôn ngữ chúng bất đồng,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:18.599Z",
      "updatedAt": "2025-09-03T02:30:18.599Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "363bddbe-103e-4cda-b572-dd3881816bda",
      "text": "vì trong thành, con chỉ thấy bạo hành và tranh tụng",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:18.614Z",
      "updatedAt": "2025-09-03T02:30:18.614Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "5887faa5-58d0-4847-bda2-b615614f5628",
      "text": "rảo quanh trên tường luỹ suốt ngày đêm.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:18.628Z",
      "updatedAt": "2025-09-03T02:30:18.628Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "d182d1cb-aed6-476b-bd4e-d8d509e63d82",
      "text": "Khắp nội thành, toàn bất công bạo tàn xảo kế,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:18.642Z",
      "updatedAt": "2025-09-03T02:30:18.642Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "85817ceb-fd12-4cff-8b89-0bfbe3d3d558",
      "text": "nơi phố phường, chẳng hề vắng chước độc mưu thâm.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:18.656Z",
      "updatedAt": "2025-09-03T02:30:18.656Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "9870adab-701d-4c65-8a89-35df01787685",
      "text": "Giả như tên địch thù phỉ báng, thì tôi cũng cam lòng,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:18.670Z",
      "updatedAt": "2025-09-03T02:30:18.670Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "5deac989-e32f-416a-8025-2fc7e96065be",
      "text": "hay kẻ ghét ghen lên mày lên mặt, tôi có thể lánh đi.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:18.684Z",
      "updatedAt": "2025-09-03T02:30:18.684Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "f4d3d1a3-a341-447b-ae23-311fc090a652",
      "text": "Nhưng đây lại là bạn, người đồng vai đồng vế,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:18.698Z",
      "updatedAt": "2025-09-03T02:30:18.698Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "c69219ed-a605-4e0b-8a2f-4fa3d023b757",
      "text": "chỗ thân tình tâm phúc với tôi,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:18.727Z",
      "updatedAt": "2025-09-03T02:30:18.727Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "5d59d33d-d319-4577-b1bd-aafc27659448",
      "text": "đã cùng tôi chia ngọt sẻ bùi,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:18.755Z",
      "updatedAt": "2025-09-03T02:30:18.755Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "a6b1abc2-1502-4b9f-8cf8-349f490daee0",
      "text": "trong đền Thiên Chúa, giữa hội vui cùng sánh bước.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:18.769Z",
      "updatedAt": "2025-09-03T02:30:18.769Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "a07e7996-36fd-4d53-a460-469d86503ada",
      "text": "Ước chi tử thần chụp ngay xuống chúng,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:18.784Z",
      "updatedAt": "2025-09-03T02:30:18.784Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "8bc995fe-dbab-42da-b01a-584c49b76416",
      "text": "và chúng bị chôn sống dưới âm ty,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:18.798Z",
      "updatedAt": "2025-09-03T02:30:18.798Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "5f0eb499-13ca-4468-ab0b-f2cf4156b711",
      "text": "vì tội ác ở trong nhà chúng, ở ngay trong lòng chúng !",
      "label": "16",
      "number": 16,
      "subVerseIndex": 2,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:18.845Z",
      "updatedAt": "2025-09-03T02:30:18.845Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "43cb7af5-5ec5-45e3-acce-b0e92e9c6ede",
      "text": "Phần tôi, tôi kêu khấn Chúa Trời, CHÚA sẽ thương cứu độ.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:18.858Z",
      "updatedAt": "2025-09-03T02:30:18.858Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "d7024221-2284-4b50-a18c-1642070c42f5",
      "text": "Sớm trưa chiều, tôi than sầu rên rỉ, Người sẽ nghe tiếng tôi.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:18.874Z",
      "updatedAt": "2025-09-03T02:30:18.874Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "03d78652-44b2-4bf4-89b8-f7a0023bdfba",
      "text": "Người sẽ cứu tôi cho tính mạng an toàn",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:18.902Z",
      "updatedAt": "2025-09-03T02:30:18.902Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "65e4c0ba-de6d-4d8d-a843-fd2470a1a1e6",
      "text": "khỏi bọn người xông đánh, vì nhiều kẻ chống tôi.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:18.916Z",
      "updatedAt": "2025-09-03T02:30:18.916Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "14b6128c-d55a-4e04-8665-aa37cb9c1332",
      "text": "Thiên Chúa là Đấng hiển trị tự muôn đời,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:18.930Z",
      "updatedAt": "2025-09-03T02:30:18.930Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "7679020a-a155-4a52-8ac4-40f08638c206",
      "text": "sẽ nghe tiếng tôi và hạ nhục chúng,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:18.945Z",
      "updatedAt": "2025-09-03T02:30:18.945Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "9ed62d13-eabf-4371-ba29-7e6b4b3148c9",
      "text": "vì chúng không cải quá tự tân,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 2,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:18.958Z",
      "updatedAt": "2025-09-03T02:30:18.958Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "a0b75796-f06f-4f80-b57d-e64256d79cd7",
      "text": "cũng chẳng hề kính sợ Chúa Trời,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 3,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:18.972Z",
      "updatedAt": "2025-09-03T02:30:18.972Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "0c9b902a-ed20-47e8-ba6a-60bd9b73bb70",
      "text": "tên phản phúc ra tay hại người thân nghĩa,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:18.988Z",
      "updatedAt": "2025-09-03T02:30:18.988Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "52b11888-38bc-4aeb-9d22-93e9c6e06a42",
      "text": "lại lỗi ước quên thề ;",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:19.002Z",
      "updatedAt": "2025-09-03T02:30:19.002Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "79ec282f-751f-4fc4-8d5d-69dc9c17d4bc",
      "text": "miệng nói năng ngọt xớt, lòng chỉ muốn chiến tranh,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:19.016Z",
      "updatedAt": "2025-09-03T02:30:19.016Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "71a7677d-26c2-4c07-8c49-574a80828149",
      "text": "lời trơn tru hơn mỡ, mà bén nhọn như gươm.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:19.033Z",
      "updatedAt": "2025-09-03T02:30:19.033Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "a040df8d-92e1-4249-b8cb-36f2ff7d3e93",
      "text": "Hãy trút nhẹ gánh lo vào tay CHÚA,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:19.050Z",
      "updatedAt": "2025-09-03T02:30:19.050Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "daffdd6d-84ac-47ff-aa92-2bb9beb36f9b",
      "text": "Người sẽ đỡ đần cho,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:19.078Z",
      "updatedAt": "2025-09-03T02:30:19.078Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "3d5adca1-95cf-43b9-994a-e99de0c5c322",
      "text": "chẳng để chính nhân phải nghiêng ngửa bao giờ.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 2,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:19.092Z",
      "updatedAt": "2025-09-03T02:30:19.092Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "7a5c6940-d202-42b1-b145-e7b74ee8ecda",
      "text": "Lạy Thiên Chúa, chính Ngài sẽ đẩy chúng vào hố diệt vong.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:19.106Z",
      "updatedAt": "2025-09-03T02:30:19.106Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "bf7e55b9-504b-47f7-89c0-39c19734098f",
      "text": "Phường khát máu và chuyên lường gạt",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:19.121Z",
      "updatedAt": "2025-09-03T02:30:19.121Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "881c0910-ec11-456f-a4a6-a100e8862fdc",
      "text": "chẳng có sống được nửa đời đâu !",
      "label": "24",
      "number": 24,
      "subVerseIndex": 2,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:19.135Z",
      "updatedAt": "2025-09-03T02:30:19.135Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    },
    {
      "id": "9a691057-898c-47cf-9fea-d8e953881cf9",
      "text": "Phần con đây con tin tưởng nơi Ngài.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 3,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:19.148Z",
      "updatedAt": "2025-09-03T02:30:19.148Z",
      "chapterId": "ec40e693-cfb3-407e-ad52-6209d8768534"
    }
  ],
  "marks": [
    {
      "id": "aef396bc-9fb4-4105-8a00-e38dfeecf5a1",
      "content": "*Ai ca này của cá nhân* phản ánh một tâm trạng phức tạp của tác giả. Tình trạng văn bản lại mập mờ ở số câu. Vì thế, không dễ tìm ra cấu trúc của Tv 55. Sau đây là một trong những cách phân chia Tv : **1**) Lời cầu khẩn ở phần đầu Tv (cc. 2-3a) ; **2**) Lời kêu than (cc. 3b-16) ; **3**) Lòng trông cậy tin tưởng vào Thiên Chúa (cc. 17-22) ; **4**) Kết luận (cc. 23-24).",
      "kind": "MARK_KIND_FOOTNOTE",
