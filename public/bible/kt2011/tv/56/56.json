    {
      "id": "d6458742-d2aa-4192-b18e-49d807489aed",
      "content": "Tv bắt đầu với lời kêu gọi Thiên Chúa tỏ lòng nhân hậu đối với tác giả lâm cảnh khốn cùng. Đó là đặc điểm của các ai ca.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "6",
      "sortOrder": 5,
      "startOffset": 39,
      "endOffset": 39,
      "createdAt": "2025-09-03T02:30:24.307Z",
