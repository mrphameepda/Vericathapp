{
  "chapter": {
    "id": "5aa57a64-764e-44bd-a7e0-88cd737ff182",
    "number": 56,
    "createdAt": "2025-09-03T01:07:51.660Z",
    "updatedAt": "2025-09-03T01:07:51.660Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "818e32ea-e3a7-47f5-a241-08e109c3936c",
      "text": "*Phần ca trưởng. Theo cung “áp bức của các vương công xa lạ”. Của vua Đa-vít. Se sẽ. Khi quân Phi-li-tinh tra tay hại ông ở Gát.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:30:24.212Z",
      "updatedAt": "2025-09-03T02:30:24.212Z",
      "chapterId": "5aa57a64-764e-44bd-a7e0-88cd737ff182"
    },
    {
      "id": "c4fd6daf-9760-4b3a-8f98-c42342cbe89a",
      "text": "Xin thương xót con cùng, lạy Thiên Chúa,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:24.284Z",
      "updatedAt": "2025-09-03T02:30:24.284Z",
      "chapterId": "5aa57a64-764e-44bd-a7e0-88cd737ff182"
    },
    {
      "id": "ee10642f-a8ff-4f31-9b39-8dbe46424a46",
      "text": "vì người ta giày xéo thân con, và suốt ngày tấn công chèn ép.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:24.321Z",
      "updatedAt": "2025-09-03T02:30:24.321Z",
      "chapterId": "5aa57a64-764e-44bd-a7e0-88cd737ff182"
    },
    {
      "id": "06a8b025-2486-4878-90c4-aa01aceab15d",
      "text": "Địch thù con giày xéo suốt ngày, bè lũ tấn công nhiều vô kể.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:24.335Z",
      "updatedAt": "2025-09-03T02:30:24.335Z",
      "chapterId": "5aa57a64-764e-44bd-a7e0-88cd737ff182"
    },
    {
      "id": "ae8c896a-5b47-454a-9e02-f4949a6a028e",
      "text": "Ôi lạy Đấng Tối Cao,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:24.350Z",
      "updatedAt": "2025-09-03T02:30:24.350Z",
      "chapterId": "5aa57a64-764e-44bd-a7e0-88cd737ff182"
    },
    {
      "id": "d54c1dab-7d9f-4830-ad27-29906f1b389e",
      "text": "trong ngày con sợ hãi, con tin tưởng vào Ngài.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:24.379Z",
      "updatedAt": "2025-09-03T02:30:24.379Z",
      "chapterId": "5aa57a64-764e-44bd-a7e0-88cd737ff182"
    },
    {
      "id": "35253e91-0d04-47ae-afcb-3e389ad166ac",
      "text": "Tôi tin tưởng vào Thiên Chúa và ca tụng lời Người.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:24.394Z",
      "updatedAt": "2025-09-03T02:30:24.394Z",
      "chapterId": "5aa57a64-764e-44bd-a7e0-88cd737ff182"
    },
    {
      "id": "c36cc66d-8631-484b-80ad-6aca0ac9119a",
      "text": "Tôi tin tưởng vào Thiên Chúa và không còn sợ hãi.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:24.437Z",
      "updatedAt": "2025-09-03T02:30:24.437Z",
      "chapterId": "5aa57a64-764e-44bd-a7e0-88cd737ff182"
    },
    {
      "id": "2b610125-b7d7-449e-99f2-7d0f70edd881",
      "text": "Phàm nhân làm gì nổi được tôi ?",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:24.457Z",
      "updatedAt": "2025-09-03T02:30:24.457Z",
      "chapterId": "5aa57a64-764e-44bd-a7e0-88cd737ff182"
    },
    {
      "id": "eaa9a590-aef9-4b29-9740-e21d3abf8b2c",
      "text": "Lạy Chúa, suốt ngày chúng phá rối việc con làm",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:24.471Z",
      "updatedAt": "2025-09-03T02:30:24.471Z",
      "chapterId": "5aa57a64-764e-44bd-a7e0-88cd737ff182"
    },
    {
      "id": "3df88213-fd6d-44c3-9f5a-788f33004f59",
      "text": "và chỉ nghĩ đến chuyện hại con.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:24.487Z",
      "updatedAt": "2025-09-03T02:30:24.487Z",
      "chapterId": "5aa57a64-764e-44bd-a7e0-88cd737ff182"
    },
    {
      "id": "5567e0a8-9780-49f8-810f-5be81e0bb9bb",
      "text": "Chúng tụ tập, rình mò, theo dõi con từng bước",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:24.501Z",
      "updatedAt": "2025-09-03T02:30:24.501Z",
      "chapterId": "5aa57a64-764e-44bd-a7e0-88cd737ff182"
    },
    {
      "id": "95010fcb-9234-434b-bded-ac8f712f6e6f",
      "text": "để tìm hại mạng con.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:24.516Z",
      "updatedAt": "2025-09-03T02:30:24.516Z",
      "chapterId": "5aa57a64-764e-44bd-a7e0-88cd737ff182"
    },
    {
      "id": "d88093e0-dc3d-4b76-8898-5bc9a70162a2",
      "text": "Vì tội ác chúng làm, xin loại trừ chúng.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:24.530Z",
      "updatedAt": "2025-09-03T02:30:24.530Z",
      "chapterId": "5aa57a64-764e-44bd-a7e0-88cd737ff182"
    },
    {
      "id": "58567e64-794f-4597-bf7f-e968cc49e089",
      "text": "Lạy Thiên Chúa, trong cơn lôi đình, xin quật ngã chư dân.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:24.544Z",
      "updatedAt": "2025-09-03T02:30:24.544Z",
      "chapterId": "5aa57a64-764e-44bd-a7e0-88cd737ff182"
    },
    {
      "id": "66ca15fc-9b0f-4d3f-bcfd-2613684c437b",
      "text": "Bước đường con lận đận, chính Ngài đã đếm rồi.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:24.559Z",
      "updatedAt": "2025-09-03T02:30:24.559Z",
      "chapterId": "5aa57a64-764e-44bd-a7e0-88cd737ff182"
    },
    {
      "id": "2ade1ec7-ecac-4d99-8d21-837d79c37295",
      "text": "Xin lấy vò mà đựng nước mắt con.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:24.594Z",
      "updatedAt": "2025-09-03T02:30:24.594Z",
      "chapterId": "5aa57a64-764e-44bd-a7e0-88cd737ff182"
    },
    {
      "id": "2336241b-8232-4829-b7ec-603b65d2e671",
      "text": "Nào Ngài đã chẳng ghi tất cả vào sổ sách ?",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:24.622Z",
      "updatedAt": "2025-09-03T02:30:24.622Z",
      "chapterId": "5aa57a64-764e-44bd-a7e0-88cd737ff182"
    },
    {
      "id": "f54d806e-0fdc-4178-8bf0-6d3d329a021c",
      "text": "Địch thù phải tháo lui vào ngày tôi cầu cứu.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:24.634Z",
      "updatedAt": "2025-09-03T02:30:24.634Z",
      "chapterId": "5aa57a64-764e-44bd-a7e0-88cd737ff182"
    },
    {
      "id": "a2d500ba-32d2-4922-89b6-4777aad65941",
      "text": "Tôi biết rằng : Thiên Chúa ở bên tôi.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:24.650Z",
      "updatedAt": "2025-09-03T02:30:24.650Z",
      "chapterId": "5aa57a64-764e-44bd-a7e0-88cd737ff182"
    },
    {
      "id": "80a59e16-d946-4d26-ae59-93208406d78b",
      "text": "Tôi tin tưởng vào Thiên Chúa và ca tụng lời Người ;",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:24.662Z",
      "updatedAt": "2025-09-03T02:30:24.662Z",
      "chapterId": "5aa57a64-764e-44bd-a7e0-88cd737ff182"
    },
    {
      "id": "32378fe4-8bca-4124-87ed-6bf578f6dc1c",
      "text": "tôi ca tụng lời CHÚA.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:24.678Z",
      "updatedAt": "2025-09-03T02:30:24.678Z",
      "chapterId": "5aa57a64-764e-44bd-a7e0-88cd737ff182"
    },
    {
      "id": "cb1259ca-d2ae-4141-8752-1ed2dade9083",
      "text": "Tôi tin tưởng vào Thiên Chúa và không còn sợ hãi ;",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:24.695Z",
      "updatedAt": "2025-09-03T02:30:24.695Z",
      "chapterId": "5aa57a64-764e-44bd-a7e0-88cd737ff182"
    },
    {
      "id": "83bc3662-8362-4a53-b022-9e5801176219",
      "text": "phàm nhân làm gì nổi được tôi ?",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:24.723Z",
      "updatedAt": "2025-09-03T02:30:24.723Z",
      "chapterId": "5aa57a64-764e-44bd-a7e0-88cd737ff182"
    },
    {
      "id": "ca89503f-0e41-409f-812d-3f40974cb6b9",
      "text": "Lạy Thiên Chúa, lời khấn hứa cùng Ngài, con xin giữ,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:24.737Z",
      "updatedAt": "2025-09-03T02:30:24.737Z",
      "chapterId": "5aa57a64-764e-44bd-a7e0-88cd737ff182"
    },
    {
      "id": "b25bafa4-d3f8-4bee-a4c7-54d01779c15a",
      "text": "lễ tạ ơn, nguyện sẽ dâng Ngài,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:24.751Z",
      "updatedAt": "2025-09-03T02:30:24.751Z",
      "chapterId": "5aa57a64-764e-44bd-a7e0-88cd737ff182"
    },
    {
      "id": "53ef2529-a8bd-480a-84a2-b71596154b25",
      "text": "vì Ngài cứu mạng con khỏi chết,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:24.765Z",
      "updatedAt": "2025-09-03T02:30:24.765Z",
      "chapterId": "5aa57a64-764e-44bd-a7e0-88cd737ff182"
    },
    {
      "id": "41add075-31b6-40ea-9411-97909e7a5b36",
      "text": "lại ngăn ngừa kẻo phải hụt chân,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:24.780Z",
      "updatedAt": "2025-09-03T02:30:24.780Z",
      "chapterId": "5aa57a64-764e-44bd-a7e0-88cd737ff182"
    },
    {
      "id": "2f63ba62-35e4-499e-93d3-1cdaba708aae",
      "text": "để con bước đi trước mặt Ngài trong ánh sáng dành cho kẻ sống.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 2,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:24.808Z",
      "updatedAt": "2025-09-03T02:30:24.808Z",
      "chapterId": "5aa57a64-764e-44bd-a7e0-88cd737ff182"
    }
  ],
  "marks": [
    {
      "id": "75729b36-86d3-4a52-9a2c-e9352fd400f7",
      "content": "Chắc phần cuối của c.1 ám chỉ câu chuyện ông Đa-vít chạy sang Gát để tránh vua Sa-un (x. 1 Sm 21,11-13 ; 27,1-4 ; ...). Không thấy bản văn nói là quân Phi-li-tinh bắt giữ ông Đa-vít ở Gát. Hai câu điệp ca (cc. 5 và 11-12) cho thấy : *ai ca này của cá nhân* chia làm ba phần : **1**) Lời kêu cứu, lời than van và lòng tin tưởng vào Thiên Chúa (cc. 2-5) ; **2**) Lời than van và niềm trông cậy Thiên Chúa (cc. 6-12) ; **3**) Lễ tạ ơn dâng lên Thiên Chúa (cc. 13-14).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 35,
      "endOffset": 35,
      "createdAt": "2025-09-03T02:30:24.241Z",
      "updatedAt": "2025-09-03T02:30:24.241Z",
      "targetId": "b30ea82f-0b6b-4976-9f70-4a8c0a13b651",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "5aa57a64-764e-44bd-a7e0-88cd737ff182"
    },
