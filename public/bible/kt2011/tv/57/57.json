{
  "chapter": {
    "id": "e6782acb-ad2f-4cbb-977b-06d815a3ed77",
    "number": 57,
    "createdAt": "2025-09-03T01:07:51.661Z",
    "updatedAt": "2025-09-03T01:07:51.661Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "bb8a52c8-3937-4f7a-91ac-99cf2def46c6",
      "text": "*Phần ca trưởng. “Xin đừng phá đổ”. Của vua Đa-vít. Se sẽ. Khi ông chạy vào hang, trốn vua Sa-un.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:30:30.016Z",
      "updatedAt": "2025-09-03T02:30:30.016Z",
      "chapterId": "e6782acb-ad2f-4cbb-977b-06d815a3ed77"
    },
    {
      "id": "8b6b4790-b360-4fa7-8848-6c2fd184b27b",
      "text": "Xin thương xót con cùng, lạy Thiên Chúa,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:30.093Z",
      "updatedAt": "2025-09-03T02:30:30.093Z",
      "chapterId": "e6782acb-ad2f-4cbb-977b-06d815a3ed77"
    },
    {
      "id": "dea80a93-3778-4b90-80ea-52d3b759afe0",
      "text": "xin Ngài thương xót con,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:30.121Z",
      "updatedAt": "2025-09-03T02:30:30.121Z",
      "chapterId": "e6782acb-ad2f-4cbb-977b-06d815a3ed77"
    },
    {
      "id": "b2fdcf39-5c96-4c8e-935a-ff257e32b7f2",
      "text": "này con đến ẩn náu bên Ngài ;",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:30.135Z",
      "updatedAt": "2025-09-03T02:30:30.135Z",
      "chapterId": "e6782acb-ad2f-4cbb-977b-06d815a3ed77"
    },
    {
      "id": "cb099339-1b3b-4dbe-bef6-cdd5f4fd451a",
      "text": "dưới bóng Ngài, này con ẩn náu,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 3,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:30.149Z",
      "updatedAt": "2025-09-03T02:30:30.149Z",
      "chapterId": "e6782acb-ad2f-4cbb-977b-06d815a3ed77"
    },
    {
      "id": "818db6fd-4b1a-41e4-9b26-7399dc7d0385",
      "text": "tới khi nào hết tai hoạ khổ đau.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 4,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:30.164Z",
      "updatedAt": "2025-09-03T02:30:30.164Z",
      "chapterId": "e6782acb-ad2f-4cbb-977b-06d815a3ed77"
    },
    {
      "id": "46ad0e2a-c6cf-4be9-9f76-39735767d5de",
      "text": "Tôi kêu cầu Chúa Tối Cao,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:30.178Z",
      "updatedAt": "2025-09-03T02:30:30.178Z",
      "chapterId": "e6782acb-ad2f-4cbb-977b-06d815a3ed77"
    },
    {
      "id": "c3743eee-e8ca-4f79-95c6-c922a3c36639",
      "text": "Chúa ban ơn phúc dồi dào cho tôi.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:30.191Z",
      "updatedAt": "2025-09-03T02:30:30.191Z",
      "chapterId": "e6782acb-ad2f-4cbb-977b-06d815a3ed77"
    },
    {
      "id": "fd3c0794-1546-43d5-8b54-2a8c00e5a446",
      "text": "Tự trời xanh, mong Người đưa tay giải thoát,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:30.205Z",
      "updatedAt": "2025-09-03T02:30:30.205Z",
      "chapterId": "e6782acb-ad2f-4cbb-977b-06d815a3ed77"
    },
    {
      "id": "d784d06f-d513-4794-acbf-95a9e6a96864",
      "text": "hạ nhục kẻ thù tấn công tôi.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:30.220Z",
      "updatedAt": "2025-09-03T02:30:30.220Z",
      "chapterId": "e6782acb-ad2f-4cbb-977b-06d815a3ed77"
    },
    {
      "id": "9fa959f9-133d-4a40-91ef-ec726ea5ae27",
      "text": "Xin Chúa Trời gửi xuống",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:30.234Z",
      "updatedAt": "2025-09-03T02:30:30.234Z",
      "chapterId": "e6782acb-ad2f-4cbb-977b-06d815a3ed77"
    },
    {
      "id": "931af8e1-071c-427b-ba75-f90d0afc4b03",
      "text": "tình thương và lòng thành tín của Người.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 3,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:30.267Z",
      "updatedAt": "2025-09-03T02:30:30.267Z",
      "chapterId": "e6782acb-ad2f-4cbb-977b-06d815a3ed77"
    },
    {
      "id": "b65aaa86-3166-49a4-aca4-4e8ee03b8707",
      "text": "Tôi phải nằm giữa bầy sư tử, loài thú ăn thịt người ;",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:30.297Z",
      "updatedAt": "2025-09-03T02:30:30.297Z",
      "chapterId": "e6782acb-ad2f-4cbb-977b-06d815a3ed77"
    },
    {
      "id": "a3971e9a-5d00-4c4c-b1b0-1ae2c5b9fce3",
      "text": "nanh vuốt chúng là đầu tên mũi giáo,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:30.323Z",
      "updatedAt": "2025-09-03T02:30:30.323Z",
      "chapterId": "e6782acb-ad2f-4cbb-977b-06d815a3ed77"
    },
    {
      "id": "86a9adf5-eeea-49e7-9006-d635105a2f05",
      "text": "lưỡi thì sắc bén tựa gươm đao.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:30.335Z",
      "updatedAt": "2025-09-03T02:30:30.335Z",
      "chapterId": "e6782acb-ad2f-4cbb-977b-06d815a3ed77"
    },
    {
      "id": "37b9b322-98e2-4f9a-9173-d75d8fd1c49d",
      "text": "Lạy Thiên Chúa, xin biểu thị uy phong khắp cõi trời",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:30.347Z",
      "updatedAt": "2025-09-03T02:30:30.347Z",
      "chapterId": "e6782acb-ad2f-4cbb-977b-06d815a3ed77"
    },
    {
      "id": "8c027768-6bfc-4c1e-b4c1-c4222c2920cc",
      "text": "và chiếu toả vinh quang đầy mặt đất.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:30.371Z",
      "updatedAt": "2025-09-03T02:30:30.371Z",
      "chapterId": "e6782acb-ad2f-4cbb-977b-06d815a3ed77"
    },
    {
      "id": "134e59e3-6a56-4e23-be23-d78da7e77a01",
      "text": "Dưới chân con, chúng đã giăng lưới sẵn,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:30.399Z",
      "updatedAt": "2025-09-03T02:30:30.399Z",
      "chapterId": "e6782acb-ad2f-4cbb-977b-06d815a3ed77"
    },
    {
      "id": "75c2878d-23ce-42eb-a3bc-1fb904603e7d",
      "text": "cho con phải mắc vào.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:30.426Z",
      "updatedAt": "2025-09-03T02:30:30.426Z",
      "chapterId": "e6782acb-ad2f-4cbb-977b-06d815a3ed77"
    },
    {
      "id": "bf9a012a-5c6d-46d2-b3e4-91839158a5a2",
      "text": "Trước mặt con, chúng đào hầm đào hố,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:30.440Z",
      "updatedAt": "2025-09-03T02:30:30.440Z",
      "chapterId": "e6782acb-ad2f-4cbb-977b-06d815a3ed77"
    },
    {
      "id": "5b8ff564-59f5-4060-9bf1-1bd0a0dbdf8f",
      "text": "chính chúng lại sa chân.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 3,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:30.454Z",
      "updatedAt": "2025-09-03T02:30:30.454Z",
      "chapterId": "e6782acb-ad2f-4cbb-977b-06d815a3ed77"
    },
    {
      "id": "b462b8fd-06f2-4a24-aa5d-27c4189c8b76",
      "text": "Con an lòng, lạy Thiên Chúa, con vững dạ an lòng,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:30.468Z",
      "updatedAt": "2025-09-03T02:30:30.468Z",
      "chapterId": "e6782acb-ad2f-4cbb-977b-06d815a3ed77"
    },
    {
      "id": "ebb248a1-024c-4adb-9bf0-9fa02cd11920",
      "text": "này con xin đàn hát xướng ca.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:30.482Z",
      "updatedAt": "2025-09-03T02:30:30.482Z",
      "chapterId": "e6782acb-ad2f-4cbb-977b-06d815a3ed77"
    },
    {
      "id": "54284490-69b5-4be8-a0f2-fec98ea7665c",
      "text": "Thức dậy đi, hồn tôi hỡi,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:30.496Z",
      "updatedAt": "2025-09-03T02:30:30.496Z",
      "chapterId": "e6782acb-ad2f-4cbb-977b-06d815a3ed77"
    },
    {
      "id": "1f792b40-9fd8-49fb-8b10-d76cf3b39f54",
      "text": "thức dậy đi, hỡi đàn sắt đàn cầm,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:30.510Z",
      "updatedAt": "2025-09-03T02:30:30.510Z",
      "chapterId": "e6782acb-ad2f-4cbb-977b-06d815a3ed77"
    },
    {
      "id": "2b6c40d9-5e94-4869-a374-2c4aec715bf8",
      "text": "tôi còn đánh thức cả bình minh.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 3,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:30.526Z",
      "updatedAt": "2025-09-03T02:30:30.526Z",
      "chapterId": "e6782acb-ad2f-4cbb-977b-06d815a3ed77"
    },
    {
      "id": "72dc0ed6-fb84-4135-88f0-f848bdffe8e3",
      "text": "Lạy Thiên Chúa, trước mặt chư dân, con dâng lời cảm tạ,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:30.540Z",
      "updatedAt": "2025-09-03T02:30:30.540Z",
      "chapterId": "e6782acb-ad2f-4cbb-977b-06d815a3ed77"
    },
    {
      "id": "7f56e57b-89bb-4451-ac0d-629420de5d96",
      "text": "giữa lòng muôn nước, con đàn hát xướng ca.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:30.553Z",
      "updatedAt": "2025-09-03T02:30:30.553Z",
      "chapterId": "e6782acb-ad2f-4cbb-977b-06d815a3ed77"
    },
    {
      "id": "420f7c49-8e5e-49dc-9be8-335ccb4ee4e5",
      "text": "Vì tình thương của Ngài cao ngất trời xanh,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:30.568Z",
      "updatedAt": "2025-09-03T02:30:30.568Z",
      "chapterId": "e6782acb-ad2f-4cbb-977b-06d815a3ed77"
    },
    {
      "id": "6551bad3-af21-4dcd-a529-25ce571686c5",
      "text": "và lòng thành tín vượt ngàn mây thẳm.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:30.595Z",
      "updatedAt": "2025-09-03T02:30:30.595Z",
      "chapterId": "e6782acb-ad2f-4cbb-977b-06d815a3ed77"
    },
    {
      "id": "436b03ee-581c-42a0-9f74-b25b02e7ef19",
      "text": "Lạy Thiên Chúa, xin biểu thị uy phong khắp cõi trời",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:30.609Z",
      "updatedAt": "2025-09-03T02:30:30.609Z",
      "chapterId": "e6782acb-ad2f-4cbb-977b-06d815a3ed77"
    },
    {
      "id": "96b8a899-ceb8-4873-9160-43e68969d80a",
      "text": "và chiếu toả vinh quang đầy mặt đất.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:30.624Z",
      "updatedAt": "2025-09-03T02:30:30.624Z",
      "chapterId": "e6782acb-ad2f-4cbb-977b-06d815a3ed77"
    }
  ],
