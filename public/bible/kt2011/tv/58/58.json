{
  "chapter": {
    "id": "f61915c9-f280-4ab1-bb20-effce01ad859",
    "number": 58,
    "createdAt": "2025-09-03T01:07:51.661Z",
    "updatedAt": "2025-09-03T01:07:51.661Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "8a267f0c-e880-465a-b08e-09a65daf8e03",
      "text": "*Phần ca trưởng. “Xin đừng phá đổ”. Của vua Đa-vít. Se sẽ.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:30:35.647Z",
      "updatedAt": "2025-09-03T02:30:35.647Z",
      "chapterId": "f61915c9-f280-4ab1-bb20-effce01ad859"
    },
    {
      "id": "62e59d30-0bce-4e5f-a8a2-720edb70e324",
      "text": "Hỡi những kẻ quyền thế,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:35.708Z",
      "updatedAt": "2025-09-03T02:30:35.708Z",
      "chapterId": "f61915c9-f280-4ab1-bb20-effce01ad859"
    },
    {
      "id": "db3906d5-8a69-421f-8266-8e8bc2914766",
      "text": "có thực các người phán quyết công minh,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:35.737Z",
      "updatedAt": "2025-09-03T02:30:35.737Z",
      "chapterId": "f61915c9-f280-4ab1-bb20-effce01ad859"
    },
    {
      "id": "eec4f0d4-559f-4ff3-b6c6-dbc7a9906e58",
      "text": "xét xử người ta theo đường chính trực ?",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:35.752Z",
      "updatedAt": "2025-09-03T02:30:35.752Z",
      "chapterId": "f61915c9-f280-4ab1-bb20-effce01ad859"
    },
    {
      "id": "33192840-9500-4950-8e42-c947b1e68e1a",
      "text": "Các người chủ tâm làm điều bất chính,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:35.766Z",
      "updatedAt": "2025-09-03T02:30:35.766Z",
      "chapterId": "f61915c9-f280-4ab1-bb20-effce01ad859"
    },
    {
      "id": "a977fca1-30e1-42c2-ae8a-532260390427",
      "text": "ra tay bạo hành trên đất này.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:35.780Z",
      "updatedAt": "2025-09-03T02:30:35.780Z",
      "chapterId": "f61915c9-f280-4ab1-bb20-effce01ad859"
    },
    {
      "id": "2082f3be-428a-4bbf-a71b-56e6ed1fd54c",
      "text": "Bọn ác nhân lạc lối từ khi lọt lòng mẹ,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:35.796Z",
      "updatedAt": "2025-09-03T02:30:35.796Z",
      "chapterId": "f61915c9-f280-4ab1-bb20-effce01ad859"
    },
    {
      "id": "aab09ea4-fd78-44d2-bb35-1275b11b4201",
      "text": "phường gian dối lầm đường ngay thuở mới sinh ra.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:35.809Z",
      "updatedAt": "2025-09-03T02:30:35.809Z",
      "chapterId": "f61915c9-f280-4ab1-bb20-effce01ad859"
    },
    {
      "id": "6d23af4f-6364-4f6c-9f0e-13e882adebcb",
      "text": "Nọc của chúng khác nào nọc rắn,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:35.824Z",
      "updatedAt": "2025-09-03T02:30:35.824Z",
      "chapterId": "f61915c9-f280-4ab1-bb20-effce01ad859"
    },
    {
      "id": "4d1af4fb-398d-4eb0-a50f-e431a9436cb9",
      "text": "chúng như hổ mang điếc bịt tai",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:35.854Z",
      "updatedAt": "2025-09-03T02:30:35.854Z",
      "chapterId": "f61915c9-f280-4ab1-bb20-effce01ad859"
    },
    {
      "id": "cd51d2ff-32a0-42fc-85f2-f17cf75f7ec8",
      "text": "chẳng thèm nghe tiếng người dụ rắn,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:35.869Z",
      "updatedAt": "2025-09-03T02:30:35.869Z",
      "chapterId": "f61915c9-f280-4ab1-bb20-effce01ad859"
    },
    {
      "id": "c87619db-5085-42d3-91d8-9ced3e1fffe0",
      "text": "người thạo nghề thôi miên.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:35.897Z",
      "updatedAt": "2025-09-03T02:30:35.897Z",
      "chapterId": "f61915c9-f280-4ab1-bb20-effce01ad859"
    },
    {
      "id": "5ad36159-99e1-47e8-ae17-f69a0eeeb380",
      "text": "Lạy Thiên Chúa, xin đánh chúng bể miệng gãy răng,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:35.928Z",
      "updatedAt": "2025-09-03T02:30:35.928Z",
      "chapterId": "f61915c9-f280-4ab1-bb20-effce01ad859"
    },
    {
      "id": "0314e1a5-816f-4d83-bc71-d43f66cc6b61",
      "text": "lạy CHÚA, xin bẻ nanh của bầy sư tử.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:35.945Z",
      "updatedAt": "2025-09-03T02:30:35.945Z",
      "chapterId": "f61915c9-f280-4ab1-bb20-effce01ad859"
    },
    {
      "id": "b2ccf446-267e-4d57-a3e2-e13eb5bd3539",
      "text": "Xin cho chúng biến đi như nước chảy",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:35.959Z",
      "updatedAt": "2025-09-03T02:30:35.959Z",
      "chapterId": "f61915c9-f280-4ab1-bb20-effce01ad859"
    },
    {
      "id": "48b72afc-5bcf-469f-a6ce-ecafb6393211",
      "text": "và héo tàn như cỏ đạp dưới chân,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:35.987Z",
      "updatedAt": "2025-09-03T02:30:35.987Z",
      "chapterId": "f61915c9-f280-4ab1-bb20-effce01ad859"
    },
    {
      "id": "591bdcd3-d391-4dd4-a259-1625ebe3be39",
      "text": "như ốc sên vừa bò vừa rữa",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:36.002Z",
      "updatedAt": "2025-09-03T02:30:36.002Z",
      "chapterId": "f61915c9-f280-4ab1-bb20-effce01ad859"
    },
    {
      "id": "2c0db75b-de0e-487c-bdc1-28e6eb774c88",
      "text": "như trẻ sinh non không thấy ánh mặt trời.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:36.016Z",
      "updatedAt": "2025-09-03T02:30:36.016Z",
      "chapterId": "f61915c9-f280-4ab1-bb20-effce01ad859"
    },
    {
      "id": "809ed6e8-f2ac-4b84-a4fd-6d8c4abe9424",
      "text": "Ước gì lửa giận của Chúa cuốn chúng đi",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:36.047Z",
      "updatedAt": "2025-09-03T02:30:36.047Z",
      "chapterId": "f61915c9-f280-4ab1-bb20-effce01ad859"
    },
    {
      "id": "3fc4d3ec-e0cb-4b20-8395-74a9d4ba4755",
      "text": "nhanh hơn lửa gai bén tới nồi.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:36.062Z",
      "updatedAt": "2025-09-03T02:30:36.062Z",
      "chapterId": "f61915c9-f280-4ab1-bb20-effce01ad859"
    },
    {
      "id": "b3a47317-1b94-473d-b21c-76fca6fc3e90",
      "text": "Người công chính sẽ vui mừng thấy Chúa trả oán,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:36.091Z",
      "updatedAt": "2025-09-03T02:30:36.091Z",
      "chapterId": "f61915c9-f280-4ab1-bb20-effce01ad859"
    },
    {
      "id": "318fcd00-f8b3-46a2-aca6-d97f08f2c498",
      "text": "họ sẽ rửa chân trong máu ác nhân.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:36.105Z",
      "updatedAt": "2025-09-03T02:30:36.105Z",
      "chapterId": "f61915c9-f280-4ab1-bb20-effce01ad859"
    },
    {
      "id": "00a21694-7342-4867-92c6-c6c0844fdbc2",
      "text": "Thiên hạ sẽ nói rằng :",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:36.120Z",
      "updatedAt": "2025-09-03T02:30:36.120Z",
      "chapterId": "f61915c9-f280-4ab1-bb20-effce01ad859"
    },
    {
      "id": "b0358054-198d-43be-9747-4c135dca7e02",
      "text": "“Quả thật có phần thưởng dành cho người công chính,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:36.136Z",
      "updatedAt": "2025-09-03T02:30:36.136Z",
      "chapterId": "f61915c9-f280-4ab1-bb20-effce01ad859"
    },
    {
      "id": "c968a330-b1d2-4483-9ec3-5659f51c6965",
      "text": "quả thật có Thiên Chúa xét xử trên địa cầu.”",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:36.150Z",
      "updatedAt": "2025-09-03T02:30:36.150Z",
      "chapterId": "f61915c9-f280-4ab1-bb20-effce01ad859"
    }
  ],
  "marks": [
    {
      "id": "584c2678-9314-48d9-8b9a-275d790e22f1",
      "content": "*Ai ca này của tập thể* gồm những phần sau đây : **1**) Lời ngỏ trực tiếp với các thẩm phán xấu (cc. 2-3) ; **2**) Đoạn này miêu tả hành động gian ác của họ (cc. 4-6) ; **3**) Lời cầu xin mang tính cách nguyền rủa (cc. 7-10) ; **4**) Thiên Chúa trả oán cho người công chính (cc. 11-12).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 51,
      "endOffset": 51,
