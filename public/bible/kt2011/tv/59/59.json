{
  "chapter": {
    "id": "60142198-312c-4e19-85cc-d135d1d81894",
    "number": 59,
    "createdAt": "2025-09-03T01:07:51.661Z",
    "updatedAt": "2025-09-03T01:07:51.661Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "fe9afa01-01ee-43d3-ac78-ecb0e5caa519",
      "text": "*Phần ca trưởng. “Xin đừng phá đổ.” Của vua Đa-vít. Se sẽ. Khi vua Sa-un sai người canh giữ nhà ông để hãm hại ông.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:30:41.377Z",
      "updatedAt": "2025-09-03T02:30:41.377Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "b47e1f91-689e-4f85-8633-08052eec408e",
      "text": "Lạy Thiên Chúa của con, xin cứu con khỏi lũ địch thù,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:41.470Z",
      "updatedAt": "2025-09-03T02:30:41.470Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "f59b9c81-dec9-4340-b020-76e9623f8f96",
      "text": "bênh đỡ con chống lại kẻ tấn công,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:41.484Z",
      "updatedAt": "2025-09-03T02:30:41.484Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "82ba74cc-278b-427a-9483-69ba9e7a2723",
      "text": "cứu vớt con khỏi phường gian ác,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:41.498Z",
      "updatedAt": "2025-09-03T02:30:41.498Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "ed05dfb3-cbd7-48f1-9c2c-94d2140b0ea4",
      "text": "giải thoát con khỏi bọn giết người.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:41.513Z",
      "updatedAt": "2025-09-03T02:30:41.513Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "7f92afd6-634c-40ad-b57a-7469f1dceb35",
      "text": "Kìa mạng con, chúng rình hãm hại,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:41.528Z",
      "updatedAt": "2025-09-03T02:30:41.528Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "cb84a262-9b23-4a1a-848a-f54261bbda55",
      "text": "lũ cường quyền xúm lại chống con.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:41.556Z",
      "updatedAt": "2025-09-03T02:30:41.556Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "c812ad76-c982-4a84-bf66-fcaab90730a6",
      "text": "Lạy CHÚA, con đâu có tội có lỗi gì, có làm chi lầm lỡ,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:41.570Z",
      "updatedAt": "2025-09-03T02:30:41.570Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "eaff9d6b-a26a-4541-bdee-c6faa63b7cb2",
      "text": "mà chúng cũng xông vào dàn trận.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:41.584Z",
      "updatedAt": "2025-09-03T02:30:41.584Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "e715a060-0e49-4887-8d25-4f8a20fc8f18",
      "text": "Xin Ngài thức dậy, đến với con, và xin nhìn xem đó.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:41.600Z",
      "updatedAt": "2025-09-03T02:30:41.600Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "390bc5f8-be21-434f-b17c-5888aff16c81",
      "text": "Lạy CHÚA là Chúa Tể càn khôn,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:41.628Z",
      "updatedAt": "2025-09-03T02:30:41.628Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "377e0d8b-1fec-4255-854b-e2d11347b9ad",
      "text": "là Thiên Chúa nhà Ít-ra-en,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:41.642Z",
      "updatedAt": "2025-09-03T02:30:41.642Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "e7206c53-0dec-4457-a92d-9457477a0adb",
      "text": "xin đứng lên trừng trị chư dân,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:41.671Z",
      "updatedAt": "2025-09-03T02:30:41.671Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "739cfd32-739d-473e-9021-55080acd5250",
      "text": "đừng thương hại một kẻ nào dã tâm phản phúc.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 3,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:41.685Z",
      "updatedAt": "2025-09-03T02:30:41.685Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "f17b715d-8d85-4d0d-b405-7395bbef3425",
      "text": "Chiều đến, chúng trở lại",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:41.699Z",
      "updatedAt": "2025-09-03T02:30:41.699Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "b775f73c-c13b-40a6-9581-f25a99301ab2",
      "text": "tru lên như chó và chạy rông khắp thành.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:41.713Z",
      "updatedAt": "2025-09-03T02:30:41.713Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "9881445a-8c8d-41e6-9b87-ef89cb97b7a6",
      "text": "Này chúng ba hoa sùi bọt mép, lưỡi kiếm ở đầu môi.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:41.742Z",
      "updatedAt": "2025-09-03T02:30:41.742Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "859b6cc4-039a-4eae-93f6-f7a84d8a8a2a",
      "text": "Chúng nói : “Nào ai nghe thấy được ?”",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:41.756Z",
      "updatedAt": "2025-09-03T02:30:41.756Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "3733cc06-ee3d-43b7-aff6-b4f8d82f24bc",
      "text": "Nhưng phần Ngài, lạy CHÚA, Ngài chê cười chúng,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:41.770Z",
      "updatedAt": "2025-09-03T02:30:41.770Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "ab0edbf8-b983-42b9-a7e0-059f46b7c9fa",
      "text": "Ngài nhạo báng chư dân.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:41.784Z",
      "updatedAt": "2025-09-03T02:30:41.784Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "f4d3232c-741f-496a-8c3d-377534960ff0",
      "text": "Lạy Thiên Chúa là sức mạnh của con,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:41.800Z",
      "updatedAt": "2025-09-03T02:30:41.800Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "b8125d43-4655-4e55-b3f9-79cb0d1021f9",
      "text": "con ngước mắt nhìn Ngài,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:41.814Z",
      "updatedAt": "2025-09-03T02:30:41.814Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "f25aa92e-0876-4082-8b8e-2928217d83eb",
      "text": "bởi Ngài là thành luỹ bảo vệ con.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:41.829Z",
      "updatedAt": "2025-09-03T02:30:41.829Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "17241b3f-4777-44db-92b0-701a74c03bcf",
      "text": "Thiên Chúa, Đấng đầy lòng yêu mến, sẽ đến phù hộ tôi ;",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:41.843Z",
      "updatedAt": "2025-09-03T02:30:41.843Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "f4ee628e-585c-4355-ad1b-f0f6c8e8131c",
      "text": "Thiên Chúa sẽ cho tôi nghênh bọn địch thù.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:41.857Z",
      "updatedAt": "2025-09-03T02:30:41.857Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "0d9f803e-906e-4d3e-88f5-3c5d0e2efac3",
      "text": "Xin Chúa đừng giết chúng,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:41.872Z",
      "updatedAt": "2025-09-03T02:30:41.872Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "2b200e60-2322-4d65-84fe-58b157e3bfab",
      "text": "kẻo dân của con lãng quên đi.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:41.914Z",
      "updatedAt": "2025-09-03T02:30:41.914Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "324d9836-0a19-4e18-adf0-c898f0c58d56",
      "text": "Lạy Chúa là khiên mộc của chúng con,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:41.930Z",
      "updatedAt": "2025-09-03T02:30:41.930Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "236f18c8-5573-4c2a-a595-aea1b5bcc5c7",
      "text": "xin dùng sức mạnh bắt chúng phải lang thang,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 3,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:41.944Z",
      "updatedAt": "2025-09-03T02:30:41.944Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "06942a60-adf8-41c7-914d-4680e1773149",
      "text": "và xin quật ngã chúng.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 4,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:41.974Z",
      "updatedAt": "2025-09-03T02:30:41.974Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "b112aed1-1b00-4a1c-99cf-8d3b3e9c145c",
      "text": "Mở miệng ra là chúng nói điều tội lỗi,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:41.987Z",
      "updatedAt": "2025-09-03T02:30:41.987Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "c1d51127-33e9-4098-bf57-c44c7333e76b",
      "text": "ước gì chúng bị hại vì thói kiêu căng của mình,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:42.003Z",
      "updatedAt": "2025-09-03T02:30:42.003Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "9f738c42-9988-4ca5-b2cd-5e68f8952618",
      "text": "vì lộng ngôn phạm thượng, vì ăn gian nói dối.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:42.017Z",
      "updatedAt": "2025-09-03T02:30:42.017Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "d6672985-ae92-4cff-b39b-7c9c4c618ff8",
      "text": "Trong cơn thịnh nộ, xin tiêu diệt chúng đi,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:42.030Z",
      "updatedAt": "2025-09-03T02:30:42.030Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "f7f63d24-55f9-4a8b-9cad-999ba91e0785",
      "text": "xin tiêu diệt, để chúng không còn nữa,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:42.045Z",
      "updatedAt": "2025-09-03T02:30:42.045Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "e81de4a1-6e9d-400f-9623-26f217ffc2a8",
      "text": "cho thiên hạ biết rằng :",
      "label": "14",
      "number": 14,
      "subVerseIndex": 2,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:42.059Z",
      "updatedAt": "2025-09-03T02:30:42.059Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "219b2649-6b7f-4272-ad06-b5be814d9f51",
      "text": "Thiên Chúa thống trị nhà Gia-cóp, và khắp cõi địa cầu.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 3,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:42.074Z",
      "updatedAt": "2025-09-03T02:30:42.074Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "85805539-dbbe-42d6-bcab-758e39672762",
      "text": "Chiều đến, chúng trở lại,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:42.117Z",
      "updatedAt": "2025-09-03T02:30:42.117Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "e085a497-8dda-4f94-b4ca-1bcdc0cfb344",
      "text": "tru lên như chó và chạy rông khắp thành.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:42.133Z",
      "updatedAt": "2025-09-03T02:30:42.133Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "382d28c7-9d29-4cce-b0d3-a03d784f8653",
      "text": "Chúng lang thang tìm kiếm của ăn,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:42.145Z",
      "updatedAt": "2025-09-03T02:30:42.145Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "8621825d-65b2-43da-8320-2a4abd309d1b",
      "text": "chúng gầm gừ khi không no bụng.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:42.159Z",
      "updatedAt": "2025-09-03T02:30:42.159Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "ce687041-1681-43c3-a9d2-d4186599c83b",
      "text": "Lạy Chúa, sức mạnh Ngài, con xin mừng hát,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:42.174Z",
      "updatedAt": "2025-09-03T02:30:42.174Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "8ee4b689-8182-41e5-a599-1e5a1e834bc5",
      "text": "tình thương Ngài, sớm sớm nguyện tung hô,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:42.187Z",
      "updatedAt": "2025-09-03T02:30:42.187Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "4724036c-cca4-48c0-a589-367a44ee9f8e",
      "text": "bởi con được Chúa nên đồn nên luỹ,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 2,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:42.201Z",
      "updatedAt": "2025-09-03T02:30:42.201Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "1564824b-c16b-463f-b11a-b300ddd3a7eb",
      "text": "chốn con nương mình trong buổi gian truân.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 3,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:42.215Z",
      "updatedAt": "2025-09-03T02:30:42.215Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "7551ebd2-5be3-47a4-8057-76402874476b",
      "text": "Lạy Chúa là sức mạnh của con, xin đàn hát mừng Ngài,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:42.230Z",
      "updatedAt": "2025-09-03T02:30:42.230Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "582c9264-8f1b-4c4d-ae78-d65983f7e3d5",
      "text": "bởi Ngài là thành luỹ bảo vệ con,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:42.244Z",
      "updatedAt": "2025-09-03T02:30:42.244Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    },
    {
      "id": "1e637b8f-2bb7-4774-8a23-a185533432cb",
      "text": "lạy Thiên Chúa, Đấng đầy lòng yêu mến.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 2,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:42.258Z",
      "updatedAt": "2025-09-03T02:30:42.258Z",
      "chapterId": "60142198-312c-4e19-85cc-d135d1d81894"
    }
  ],
