{
  "chapter": {
    "id": "5d0c0072-b946-41f7-8ef2-977d565f92e0",
    "number": 60,
    "createdAt": "2025-09-03T01:07:51.661Z",
    "updatedAt": "2025-09-03T01:07:51.661Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "94ac459b-22b8-4c59-a3f3-f23103af9fa1",
      "text": "*Phần ca trưởng. Theo điệu : Bông huệ chứng ước. Se sẽ. Của vua Đa-vít. Để dạy.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:30:48.230Z",
      "updatedAt": "2025-09-03T02:30:48.230Z",
      "chapterId": "5d0c0072-b946-41f7-8ef2-977d565f92e0"
    },
    {
      "id": "f01550d8-1a0e-4169-89f9-48122190deb4",
      "text": "*Khi ông đánh dân A-ram Na-ha-ra-gim và A-ram Xô-va, và khi ông Giô-áp trở lại đánh thắng Ê-đôm trong thung lũng Muối : mười hai ngàn người.*",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 1,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:30:48.285Z",
      "updatedAt": "2025-09-03T02:30:48.285Z",
      "chapterId": "5d0c0072-b946-41f7-8ef2-977d565f92e0"
    },
    {
      "id": "7e1cd1cd-72c8-4afb-8e4c-b29085f8ecad",
      "text": "Lạy Thiên Chúa, Ngài đã ruồng bỏ chúng con",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:48.355Z",
      "updatedAt": "2025-09-03T02:30:48.355Z",
      "chapterId": "5d0c0072-b946-41f7-8ef2-977d565f92e0"
    },
    {
      "id": "221d243e-d5f4-4aa9-b87a-a9b2590693c8",
      "text": "và làm cho tan nát ;",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:48.367Z",
      "updatedAt": "2025-09-03T02:30:48.367Z",
      "chapterId": "5d0c0072-b946-41f7-8ef2-977d565f92e0"
    },
    {
      "id": "0d4a238c-ece1-4ccf-95ec-f93777592854",
      "text": "Ngài đã từng nổi cơn thịnh nộ,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:48.380Z",
      "updatedAt": "2025-09-03T02:30:48.380Z",
      "chapterId": "5d0c0072-b946-41f7-8ef2-977d565f92e0"
    },
    {
      "id": "8ece502f-e197-445a-8736-1714897976f5",
      "text": "nhưng xin trở lại với chúng con !",
      "label": "3",
      "number": 3,
      "subVerseIndex": 3,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:48.393Z",
      "updatedAt": "2025-09-03T02:30:48.393Z",
      "chapterId": "5d0c0072-b946-41f7-8ef2-977d565f92e0"
    },
    {
      "id": "d9f77b59-7b60-4c3a-8ff8-8acddcd817ae",
      "text": "Chúa đã làm cho đất chuyển rung và nứt nẻ,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:48.406Z",
      "updatedAt": "2025-09-03T02:30:48.406Z",
      "chapterId": "5d0c0072-b946-41f7-8ef2-977d565f92e0"
    },
    {
      "id": "d380493a-7cc0-49f0-9d9c-68c0f7a43685",
      "text": "xin hàn gắn lại cho khỏi lung lay.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:48.422Z",
      "updatedAt": "2025-09-03T02:30:48.422Z",
      "chapterId": "5d0c0072-b946-41f7-8ef2-977d565f92e0"
    },
    {
      "id": "35e3a371-a8d0-4575-901e-41985d2553b8",
      "text": "Dân Ngài, Ngài bắt nếm chua cay,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:48.436Z",
      "updatedAt": "2025-09-03T02:30:48.436Z",
      "chapterId": "5d0c0072-b946-41f7-8ef2-977d565f92e0"
    },
    {
      "id": "9214d3c8-5d9d-487b-b84a-be3853b25953",
      "text": "ép chúng con cạn chén nồng choáng váng.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:48.450Z",
      "updatedAt": "2025-09-03T02:30:48.450Z",
      "chapterId": "5d0c0072-b946-41f7-8ef2-977d565f92e0"
    },
    {
      "id": "213495b2-aaa1-4665-a193-3155ef49700f",
      "text": "Ngài phất cờ hiệu cho kẻ kính sợ Ngài,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:48.462Z",
      "updatedAt": "2025-09-03T02:30:48.462Z",
      "chapterId": "5d0c0072-b946-41f7-8ef2-977d565f92e0"
    },
    {
      "id": "23384f53-6a84-474f-a07e-435a31daa52b",
      "text": "để họ thoát mũi tên xạ thủ.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:48.473Z",
      "updatedAt": "2025-09-03T02:30:48.473Z",
      "chapterId": "5d0c0072-b946-41f7-8ef2-977d565f92e0"
    },
    {
      "id": "e8db9d76-7833-4a84-936d-94f32ce8e7e8",
      "text": "Xin ra tay cứu độ, và đáp lời chúng con,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:48.484Z",
      "updatedAt": "2025-09-03T02:30:48.484Z",
      "chapterId": "5d0c0072-b946-41f7-8ef2-977d565f92e0"
    },
    {
      "id": "4764336e-044c-424e-8af0-930bcbade1c3",
      "text": "để những kẻ Ngài yêu thương được ơn giải thoát.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:48.507Z",
      "updatedAt": "2025-09-03T02:30:48.507Z",
      "chapterId": "5d0c0072-b946-41f7-8ef2-977d565f92e0"
    },
    {
      "id": "37e0ea18-592c-4cd0-b5f6-dfccb9709a70",
      "text": "Trong thánh điện, Chúa Trời tuyên phán :",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:48.521Z",
      "updatedAt": "2025-09-03T02:30:48.521Z",
      "chapterId": "5d0c0072-b946-41f7-8ef2-977d565f92e0"
    },
    {
      "id": "98e0e8de-e1bd-4177-987a-2df76c3c2034",
      "text": "“Khấp khởi mừng, Ta chia cắt Si-khem,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:48.552Z",
      "updatedAt": "2025-09-03T02:30:48.552Z",
      "chapterId": "5d0c0072-b946-41f7-8ef2-977d565f92e0"
    },
    {
      "id": "c91959c2-8a5f-4076-8287-c83c6d8060f7",
      "text": "Ta đo đạc cả đồng bằng Xúc-cốt.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:48.581Z",
      "updatedAt": "2025-09-03T02:30:48.581Z",
      "chapterId": "5d0c0072-b946-41f7-8ef2-977d565f92e0"
    },
    {
      "id": "ea646ab5-9804-43b5-8056-758b88f2131b",
      "text": "Ga-la-át về Ta, Mơ-na-se cũng về Ta,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:48.623Z",
      "updatedAt": "2025-09-03T02:30:48.623Z",
      "chapterId": "5d0c0072-b946-41f7-8ef2-977d565f92e0"
    },
    {
      "id": "8918ad0b-cda2-430e-8d62-45443e014ae6",
      "text": "Ta lấy Ép-ra-im làm mũ chiến đội đầu,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:48.672Z",
      "updatedAt": "2025-09-03T02:30:48.672Z",
      "chapterId": "5d0c0072-b946-41f7-8ef2-977d565f92e0"
    },
    {
      "id": "d8909234-8936-41a2-950c-b3303be416df",
      "text": "lấy Giu-đa làm cây gậy chỉ huy.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:48.703Z",
      "updatedAt": "2025-09-03T02:30:48.703Z",
      "chapterId": "5d0c0072-b946-41f7-8ef2-977d565f92e0"
    },
    {
      "id": "6da597b0-91fe-452e-a8fb-a67db45a3b3e",
      "text": "Mô-áp là chậu Ta tắm rửa,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:48.746Z",
      "updatedAt": "2025-09-03T02:30:48.746Z",
      "chapterId": "5d0c0072-b946-41f7-8ef2-977d565f92e0"
    },
    {
      "id": "63fd95ab-996e-4183-8dd9-cdef8c4fe2f3",
      "text": "Ê-đôm là chỗ Ta liệng giày,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:48.774Z",
      "updatedAt": "2025-09-03T02:30:48.774Z",
      "chapterId": "5d0c0072-b946-41f7-8ef2-977d565f92e0"
    },
    {
      "id": "07320947-590d-4a5d-88a4-e00c4d5d9d3b",
      "text": "đánh bại Phi-li-tinh, Ta reo mừng thắng trận.”",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:48.803Z",
      "updatedAt": "2025-09-03T02:30:48.803Z",
      "chapterId": "5d0c0072-b946-41f7-8ef2-977d565f92e0"
    },
    {
      "id": "4fb88c18-9576-4215-8557-48348ab6a481",
      "text": "Lạy Thiên Chúa, ai sẽ đưa con vào thành kiên cố,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:48.852Z",
      "updatedAt": "2025-09-03T02:30:48.852Z",
      "chapterId": "5d0c0072-b946-41f7-8ef2-977d565f92e0"
    },
    {
      "id": "fc971c77-243a-47bb-a7e7-abdd9380d6db",
      "text": "ai sẽ dắt con đến tận Ê-đôm ?",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:48.867Z",
      "updatedAt": "2025-09-03T02:30:48.867Z",
      "chapterId": "5d0c0072-b946-41f7-8ef2-977d565f92e0"
    },
    {
      "id": "98b549f2-b5e1-44f6-9b6f-6ec03549bea2",
      "text": "Há chẳng phải chính Ngài,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:48.914Z",
      "updatedAt": "2025-09-03T02:30:48.914Z",
      "chapterId": "5d0c0072-b946-41f7-8ef2-977d565f92e0"
    },
    {
      "id": "1fcdd737-5273-4a4c-9717-f41037b336bc",
      "text": "Đấng đã từng ruồng bỏ chúng con,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:48.929Z",
      "updatedAt": "2025-09-03T02:30:48.929Z",
      "chapterId": "5d0c0072-b946-41f7-8ef2-977d565f92e0"
    },
    {
      "id": "75b3ce9f-9b45-4502-9354-d210053b0baf",
      "text": "chẳng còn dẫn ba quân xuất trận ?",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:48.943Z",
      "updatedAt": "2025-09-03T02:30:48.943Z",
      "chapterId": "5d0c0072-b946-41f7-8ef2-977d565f92e0"
    },
    {
      "id": "3c55ba48-60b3-44ce-9c13-c9e952cd0f64",
      "text": "Xin Ngài thương cứu viện cho chúng con thoát khỏi quân thù,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:48.971Z",
      "updatedAt": "2025-09-03T02:30:48.971Z",
      "chapterId": "5d0c0072-b946-41f7-8ef2-977d565f92e0"
    },
    {
      "id": "44beff06-5b8e-4576-916f-099f605da8dd",
      "text": "chứ người phàm giúp đỡ chỉ bằng không.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:48.999Z",
      "updatedAt": "2025-09-03T02:30:48.999Z",
      "chapterId": "5d0c0072-b946-41f7-8ef2-977d565f92e0"
    },
    {
      "id": "3e26e4e0-00a1-4443-943c-3e7dee7875de",
      "text": "Có Thiên Chúa, ta sẽ trổ tài oanh liệt,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:49.013Z",
      "updatedAt": "2025-09-03T02:30:49.013Z",
      "chapterId": "5d0c0072-b946-41f7-8ef2-977d565f92e0"
    },
    {
      "id": "cb145b82-a67e-41a9-8968-c567bf36aa5c",
      "text": "chính Người chà đạp kẻ thù ta.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:49.027Z",
      "updatedAt": "2025-09-03T02:30:49.027Z",
      "chapterId": "5d0c0072-b946-41f7-8ef2-977d565f92e0"
    }
  ],
  "marks": [
    {
      "id": "6be4169c-5208-49c8-b6bf-f2da0aea0675",
      "content": "Đọc *ai ca này của tập thể* với lời sấm ngôn sứ, độc giả có thể đoán một phần nào bối cảnh lịch sử sau đây. Dân Ít-ra-en bị thất trận nặng nề (cc. 3.5) và đã thoát khỏi cảnh diệt vong nhờ chạy trốn (c.6). Thiên Chúa dùng một sấm ngôn (cc. 8-10) để đáp lại lời cầu khẩn của dân. Sấm ngôn cho thấy : dân Ít-ra-en sẽ thu hồi được phần đất đai đã mất ; hơn nữa, lãnh thổ của dân sẽ mở rộng. Vì thế, cuộc chiến sẽ tiếp diễn (cc. 13-14). Cấu trúc của Tv 60 : **1**) Ai ca của tập thể (cc. 3-6) ; **2**) Câu chuyển mạch (c.7) ; **3**) Lời sấm ngôn sứ (cc. 8-10) ; **4**) Lời cầu xin (cc. 11-13) ; **5**) Câu kết (c.14).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 42,
      "endOffset": 42,
      "createdAt": "2025-09-03T02:30:48.260Z",
      "updatedAt": "2025-09-03T02:30:48.260Z",
      "targetId": "a19fd107-0268-4626-a79b-2fff77df729d",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "5d0c0072-b946-41f7-8ef2-977d565f92e0"
    },
    {
      "id": "c6a9d171-9593-4df3-99c3-47041d3a12f2",
      "content": "English: David | French: David | Latin: David | Origin: &#1491;&#1464;&#1493;&#1460;&#1491; | Vietnamese: Đa-vít -- 1 Sm 16,21-22",
      "kind": "MARK_KIND_FOOTNOTE",
