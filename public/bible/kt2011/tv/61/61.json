    {
      "id": "0b7898b9-3f74-4400-b7e5-8b0a6c9007d9",
      "content": "Tv 66,13",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 19,
      "endOffset": 19,
      "createdAt": "2025-09-03T02:30:54.564Z",
      "updatedAt": "2025-09-03T02:30:54.564Z",
