{
  "chapter": {
    "id": "26cccc74-0eb3-4e84-ba1a-bce915bf06ff",
    "number": 61,
    "createdAt": "2025-09-03T01:07:51.661Z",
    "updatedAt": "2025-09-03T01:07:51.661Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "c8945746-fdd8-4678-9ebc-2021b18de003",
      "text": "*Phần ca trưởng. Theo huyền cầm. Của vua Đa-vít.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:30:54.277Z",
      "updatedAt": "2025-09-03T02:30:54.277Z",
      "chapterId": "26cccc74-0eb3-4e84-ba1a-bce915bf06ff"
    },
    {
      "id": "e1d0814c-1a4e-4c0a-8729-7bb4232c763d",
      "text": "Lạy Chúa Trời, xin nghe tiếng kêu van,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:54.320Z",
      "updatedAt": "2025-09-03T02:30:54.320Z",
      "chapterId": "26cccc74-0eb3-4e84-ba1a-bce915bf06ff"
    },
    {
      "id": "f6e5a110-0ae2-436b-8b0f-402f7e8321d4",
      "text": "và lưu ý đến lời con thỉnh nguyện.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:54.331Z",
      "updatedAt": "2025-09-03T02:30:54.331Z",
      "chapterId": "26cccc74-0eb3-4e84-ba1a-bce915bf06ff"
    },
    {
      "id": "b34815c3-96ab-425b-a972-7eccaa9d9844",
      "text": "Từ cùng cõi địa cầu, con kêu lên Chúa,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:54.341Z",
      "updatedAt": "2025-09-03T02:30:54.341Z",
      "chapterId": "26cccc74-0eb3-4e84-ba1a-bce915bf06ff"
    },
    {
      "id": "d620d506-b3e7-4a03-b59c-bb98ef40f243",
      "text": "tâm thần đang mòn mỏi rã rời.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:54.351Z",
      "updatedAt": "2025-09-03T02:30:54.351Z",
      "chapterId": "26cccc74-0eb3-4e84-ba1a-bce915bf06ff"
    },
    {
      "id": "72dc0e32-ff1e-44ad-9ce7-2d9462070691",
      "text": "Trên tảng đá kia cao vòi vọi, xin Ngài dẫn con lên.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:54.361Z",
      "updatedAt": "2025-09-03T02:30:54.361Z",
      "chapterId": "26cccc74-0eb3-4e84-ba1a-bce915bf06ff"
    },
    {
      "id": "5ff5c329-2c15-4b76-8694-ea68773d6bb3",
      "text": "Vì Chúa là nơi con vào trú ẩn,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:54.381Z",
      "updatedAt": "2025-09-03T02:30:54.381Z",
      "chapterId": "26cccc74-0eb3-4e84-ba1a-bce915bf06ff"
    },
    {
      "id": "a162067c-c85e-4333-8a39-7874ba65bbe4",
      "text": "luỹ sắt thành đồng chống lại địch quân.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:54.391Z",
      "updatedAt": "2025-09-03T02:30:54.391Z",
      "chapterId": "26cccc74-0eb3-4e84-ba1a-bce915bf06ff"
    },
    {
      "id": "74bb5872-7f29-442f-a359-55cd539fafa0",
      "text": "Ước gì con được ở mãi trong lều thánh,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:54.401Z",
      "updatedAt": "2025-09-03T02:30:54.401Z",
      "chapterId": "26cccc74-0eb3-4e84-ba1a-bce915bf06ff"
    },
    {
      "id": "43b41716-e4f7-47ff-9f6e-38a754eef85a",
      "text": "được chở che dưới cánh tay Ngài.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:54.411Z",
      "updatedAt": "2025-09-03T02:30:54.411Z",
      "chapterId": "26cccc74-0eb3-4e84-ba1a-bce915bf06ff"
    },
    {
      "id": "ce4644b0-25ec-4ecc-a786-acca34446a1b",
      "text": "Vâng chính Ngài, lạy Thiên Chúa,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:54.424Z",
      "updatedAt": "2025-09-03T02:30:54.424Z",
      "chapterId": "26cccc74-0eb3-4e84-ba1a-bce915bf06ff"
    },
    {
      "id": "52f7b835-3831-40c1-b698-ba6767622610",
      "text": "đã nghe lời khấn nguyện của con,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:54.434Z",
      "updatedAt": "2025-09-03T02:30:54.434Z",
      "chapterId": "26cccc74-0eb3-4e84-ba1a-bce915bf06ff"
    },
    {
      "id": "ac81fe53-73de-44a3-b3b4-79f4128ab6d0",
      "text": "lại cho con thừa hưởng",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:54.444Z",
      "updatedAt": "2025-09-03T02:30:54.444Z",
      "chapterId": "26cccc74-0eb3-4e84-ba1a-bce915bf06ff"
    },
    {
      "id": "214bf441-6179-45e5-8d5c-18f2eb8dc545",
      "text": "cơ nghiệp dành cho ai kính sợ danh Ngài.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 3,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:54.454Z",
      "updatedAt": "2025-09-03T02:30:54.454Z",
      "chapterId": "26cccc74-0eb3-4e84-ba1a-bce915bf06ff"
    },
    {
      "id": "ddc41218-f77c-4b96-a667-5f15720cd99a",
      "text": "Lạy Thiên Chúa, xin gia tăng tuổi thọ",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:54.467Z",
      "updatedAt": "2025-09-03T02:30:54.467Z",
      "chapterId": "26cccc74-0eb3-4e84-ba1a-bce915bf06ff"
    },
    {
      "id": "b1164d02-f114-4a3d-af18-10bb32799dcd",
      "text": "cho đức vua sống mãi ngàn năm,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:54.480Z",
      "updatedAt": "2025-09-03T02:30:54.480Z",
      "chapterId": "26cccc74-0eb3-4e84-ba1a-bce915bf06ff"
    },
    {
      "id": "936b8bca-2ce6-45b8-a318-177724c0fb11",
      "text": "hiển trị muôn đời trước Nhan Thánh,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:54.490Z",
      "updatedAt": "2025-09-03T02:30:54.490Z",
      "chapterId": "26cccc74-0eb3-4e84-ba1a-bce915bf06ff"
    },
    {
      "id": "d427dfe9-68cc-4e5d-95dc-e5535c0f44db",
      "text": "được ân tình tín nghĩa chở che.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:54.510Z",
      "updatedAt": "2025-09-03T02:30:54.510Z",
      "chapterId": "26cccc74-0eb3-4e84-ba1a-bce915bf06ff"
    },
    {
      "id": "83b1c23e-811c-4599-b201-43975b4134c6",
      "text": "Bấy giờ con mãi mãi đàn ca mừng Danh Thánh,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:54.536Z",
      "updatedAt": "2025-09-03T02:30:54.536Z",
      "chapterId": "26cccc74-0eb3-4e84-ba1a-bce915bf06ff"
    },
    {
      "id": "60d0f2ce-9daf-423d-9f32-e10fba981082",
      "text": "ngày lại ngày, xin giữ trọn lời nguyền.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:54.549Z",
      "updatedAt": "2025-09-03T02:30:54.549Z",
      "chapterId": "26cccc74-0eb3-4e84-ba1a-bce915bf06ff"
    }
  ],
  "marks": [
    {
      "id": "273a66f4-680a-4bd9-a2b3-14ca95b6794b",
      "content": "Tv này là *một ai ca của cá nhân*, là lời cầu nguyện của một người Ít-ra-en đạo đức (một thầy Lê-vi hoặc một người đau ốm) sống xa đền thờ Giê-ru-sa-lem, lúc ấy lâm vào một hoàn cảnh khó khăn. Sau đó, có lời cầu cho nhà vua đi kèm theo (cc. 7-8). Tv này chia làm bốn phần : **1**) Lời cầu nguyện kêu van của tác giả (cc. 2-3) ; **2**) Lòng trông cậy đặt vào Thiên Chúa là Đấng nghe lời khấn nguyện của người kêu xin (cc. 4-6) ; **3**) Lời cầu cho nhà vua được sống thọ và cầm quyền trị nước lâu dài (cc. 7-8).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 36,
      "endOffset": 36,
      "createdAt": "2025-09-03T02:30:54.297Z",
      "updatedAt": "2025-09-03T02:30:54.297Z",
      "targetId": "f5d74b7a-4a93-4b7a-8c06-166b8ee5a370",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "26cccc74-0eb3-4e84-ba1a-bce915bf06ff"
    },
