{
  "chapter": {
    "id": "7445e858-a372-464b-86b8-e4f4f6d88ec3",
    "number": 62,
    "createdAt": "2025-09-03T01:07:51.661Z",
    "updatedAt": "2025-09-03T01:07:51.661Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "2ed75587-b6da-479c-90ea-ddae694e5ed8",
      "text": "*Phần ca trưởng. Giơ-đu-thun. Thánh vịnh. Của vua Đa-vít.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:30:59.364Z",
      "updatedAt": "2025-09-03T02:30:59.364Z",
      "chapterId": "7445e858-a372-464b-86b8-e4f4f6d88ec3"
    },
    {
      "id": "ef2b17e1-4c48-4d05-b721-c063f0be0a46",
      "text": "Chỉ trong Thiên Chúa mà thôi,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:59.426Z",
      "updatedAt": "2025-09-03T02:30:59.426Z",
      "chapterId": "7445e858-a372-464b-86b8-e4f4f6d88ec3"
    },
    {
      "id": "7612e476-f3a1-45bc-a5fb-d08c0cd94d6e",
      "text": "hồn tôi mới được nghỉ ngơi yên hàn.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:59.437Z",
      "updatedAt": "2025-09-03T02:30:59.437Z",
      "chapterId": "7445e858-a372-464b-86b8-e4f4f6d88ec3"
    },
    {
      "id": "111ed070-7212-4a0e-9785-e73769e0b195",
      "text": "Ơn cứu độ tôi bởi Người mà đến,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:59.451Z",
      "updatedAt": "2025-09-03T02:30:59.451Z",
      "chapterId": "7445e858-a372-464b-86b8-e4f4f6d88ec3"
    },
    {
      "id": "1d8279df-1a01-4de2-953f-2b1a43066384",
      "text": "duy Người là núi đá, là ơn cứu độ của tôi,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:59.482Z",
      "updatedAt": "2025-09-03T02:30:59.482Z",
      "chapterId": "7445e858-a372-464b-86b8-e4f4f6d88ec3"
    },
    {
      "id": "9edfe4dd-7156-4977-a29d-d4d3a9bb7a51",
      "text": "là thành luỹ chở che : tôi chẳng hề nao núng.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:59.510Z",
      "updatedAt": "2025-09-03T02:30:59.510Z",
      "chapterId": "7445e858-a372-464b-86b8-e4f4f6d88ec3"
    },
    {
      "id": "e3310837-5134-4bd6-ab56-9f87bc393630",
      "text": "Tới bao giờ các ngươi còn xúm lại",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:59.524Z",
      "updatedAt": "2025-09-03T02:30:59.524Z",
      "chapterId": "7445e858-a372-464b-86b8-e4f4f6d88ec3"
    },
    {
      "id": "bc5668d0-81c8-4ba8-a6e3-3df29fbc7033",
      "text": "để xông vào quật ngã một người ?",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:59.537Z",
      "updatedAt": "2025-09-03T02:30:59.537Z",
      "chapterId": "7445e858-a372-464b-86b8-e4f4f6d88ec3"
    },
    {
      "id": "069f89b1-8682-427d-983e-9d3d68c15852",
      "text": "Hắn đã như bức tường xiêu đổ,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:59.552Z",
      "updatedAt": "2025-09-03T02:30:59.552Z",
      "chapterId": "7445e858-a372-464b-86b8-e4f4f6d88ec3"
    },
    {
      "id": "661c6776-3088-402d-b99b-cd399915f584",
      "text": "như hàng rào đến lúc ngả nghiêng.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 3,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:59.568Z",
      "updatedAt": "2025-09-03T02:30:59.568Z",
      "chapterId": "7445e858-a372-464b-86b8-e4f4f6d88ec3"
    },
    {
      "id": "c6ab6116-c7fa-415b-86d1-be0565d2e3a3",
      "text": "Con người ấy, chúng chỉ mưu hạ bệ,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:59.584Z",
      "updatedAt": "2025-09-03T02:30:59.584Z",
      "chapterId": "7445e858-a372-464b-86b8-e4f4f6d88ec3"
    },
    {
      "id": "3f11675a-5cb6-4f28-8026-27dcaec4905d",
      "text": "chúng thoả lòng vì đã nói dối nói gian.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:59.598Z",
      "updatedAt": "2025-09-03T02:30:59.598Z",
      "chapterId": "7445e858-a372-464b-86b8-e4f4f6d88ec3"
    },
    {
      "id": "5e7b53e3-025e-46a0-9328-953c85adedec",
      "text": "Miệng thì chúc phúc cầu an,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:59.612Z",
      "updatedAt": "2025-09-03T02:30:59.612Z",
      "chapterId": "7445e858-a372-464b-86b8-e4f4f6d88ec3"
    },
    {
      "id": "f640f1ce-9a6b-4aad-87ca-6b18f8441a1f",
      "text": "mà lòng nguyền rủa chứa chan những lời.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 3,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:59.626Z",
      "updatedAt": "2025-09-03T02:30:59.626Z",
      "chapterId": "7445e858-a372-464b-86b8-e4f4f6d88ec3"
    },
    {
      "id": "8285b964-fbe9-4fb1-b154-71a62a0f2672",
      "text": "Chỉ trong Thiên Chúa mà thôi,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:59.640Z",
      "updatedAt": "2025-09-03T02:30:59.640Z",
      "chapterId": "7445e858-a372-464b-86b8-e4f4f6d88ec3"
    },
    {
      "id": "11a5c62c-f108-4cae-9a55-4b765b3192cb",
      "text": "này hồn tôi hãy nghỉ ngơi yên hàn.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:59.654Z",
      "updatedAt": "2025-09-03T02:30:59.654Z",
      "chapterId": "7445e858-a372-464b-86b8-e4f4f6d88ec3"
    },
    {
      "id": "4bb17df8-bb1d-454c-8bbb-543f2b4ad9c2",
      "text": "Vì hy vọng của tôi bởi Người mà đến,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:59.667Z",
      "updatedAt": "2025-09-03T02:30:59.667Z",
      "chapterId": "7445e858-a372-464b-86b8-e4f4f6d88ec3"
    },
    {
      "id": "9dff7c99-3de0-45e4-8393-6e46ab393d22",
      "text": "duy Người là núi đá, là ơn cứu độ của tôi,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:59.681Z",
      "updatedAt": "2025-09-03T02:30:59.681Z",
      "chapterId": "7445e858-a372-464b-86b8-e4f4f6d88ec3"
    },
    {
      "id": "4cfdaf8c-d272-419c-a1df-642a850e7f18",
      "text": "là thành luỹ chở che : tôi chẳng hề nao núng.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:59.710Z",
      "updatedAt": "2025-09-03T02:30:59.710Z",
      "chapterId": "7445e858-a372-464b-86b8-e4f4f6d88ec3"
    },
    {
      "id": "6b532f9c-8c13-4615-a531-509fcf988958",
      "text": "Nhờ Thiên Chúa, tôi được cứu độ và vinh quang,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:59.724Z",
      "updatedAt": "2025-09-03T02:30:59.724Z",
      "chapterId": "7445e858-a372-464b-86b8-e4f4f6d88ec3"
    },
    {
      "id": "66c35356-53d6-4381-99f3-b09e09a650a3",
      "text": "Người là núi đá vững vàng,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:59.737Z",
      "updatedAt": "2025-09-03T02:30:59.737Z",
      "chapterId": "7445e858-a372-464b-86b8-e4f4f6d88ec3"
    },
    {
      "id": "b98a328b-d8a0-48ab-919d-6b382356c15b",
      "text": "ở bên Thiên Chúa tôi hằng ẩn thân.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:59.751Z",
      "updatedAt": "2025-09-03T02:30:59.751Z",
      "chapterId": "7445e858-a372-464b-86b8-e4f4f6d88ec3"
    },
    {
      "id": "29f0c29b-e7b3-401b-b6d7-8eace9896342",
      "text": "Hỡi dân ta, hãy tin tưởng vào Người luôn mãi,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:59.779Z",
      "updatedAt": "2025-09-03T02:30:59.779Z",
      "chapterId": "7445e858-a372-464b-86b8-e4f4f6d88ec3"
    },
    {
      "id": "bb675b6b-c16c-49f8-878c-81e864980153",
      "text": "trước mặt Người, hãy thổ lộ tâm can :",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:59.808Z",
      "updatedAt": "2025-09-03T02:30:59.808Z",
      "chapterId": "7445e858-a372-464b-86b8-e4f4f6d88ec3"
    },
    {
      "id": "aac7c274-b50e-4b91-b0f3-13ef361e2bd6",
      "text": "Thiên Chúa là nơi ta ẩn náu.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:59.827Z",
      "updatedAt": "2025-09-03T02:30:59.827Z",
      "chapterId": "7445e858-a372-464b-86b8-e4f4f6d88ec3"
    },
    {
      "id": "9366b175-e65a-480b-b641-1ae004c1184e",
      "text": "Kẻ thường dân âu chỉ là hơi thở,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:59.839Z",
      "updatedAt": "2025-09-03T02:30:59.839Z",
      "chapterId": "7445e858-a372-464b-86b8-e4f4f6d88ec3"
    },
    {
      "id": "0a957c6b-7b7b-4c87-a059-77850fb5fb7a",
      "text": "người quyền quý đều ví tựa ảo huyền,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:59.851Z",
      "updatedAt": "2025-09-03T02:30:59.851Z",
      "chapterId": "7445e858-a372-464b-86b8-e4f4f6d88ec3"
    },
    {
      "id": "e51afada-55df-4fc8-ab23-61a40f6e73a2",
      "text": "đứng cả lên cân cũng chẳng tày mây khói.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:59.863Z",
      "updatedAt": "2025-09-03T02:30:59.863Z",
      "chapterId": "7445e858-a372-464b-86b8-e4f4f6d88ec3"
    },
    {
      "id": "27b0c78c-cee8-48e3-9365-fded36a33c2b",
      "text": "Đừng tin tưởng ở trò áp bức nữa,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:59.878Z",
      "updatedAt": "2025-09-03T02:30:59.878Z",
      "chapterId": "7445e858-a372-464b-86b8-e4f4f6d88ec3"
    },
    {
      "id": "75f7a291-209d-45ed-b451-7bb40ff01d3d",
      "text": "chớ hoài công cậy ngón bóc lột người !",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:59.912Z",
      "updatedAt": "2025-09-03T02:30:59.912Z",
      "chapterId": "7445e858-a372-464b-86b8-e4f4f6d88ec3"
    },
    {
      "id": "31aee3ea-9e57-42a1-95d3-29994196b142",
      "text": "Tiền tài dẫu sinh sôi nảy nở,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:59.926Z",
      "updatedAt": "2025-09-03T02:30:59.926Z",
      "chapterId": "7445e858-a372-464b-86b8-e4f4f6d88ec3"
    },
    {
      "id": "75cbef71-55bf-4f2d-affd-1138833b70d2",
      "text": "lòng chẳng nên gắn bó làm chi.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 3,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:59.939Z",
      "updatedAt": "2025-09-03T02:30:59.939Z",
      "chapterId": "7445e858-a372-464b-86b8-e4f4f6d88ec3"
    },
    {
      "id": "28b828ba-1e07-477a-bd76-f32e475d1019",
      "text": "Lạy Thiên Chúa, một lần Ngài phán dạy,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:59.953Z",
      "updatedAt": "2025-09-03T02:30:59.953Z",
      "chapterId": "7445e858-a372-464b-86b8-e4f4f6d88ec3"
    },
    {
      "id": "c04d53e1-3eaa-4211-8160-b2d2cb60dc1f",
      "text": "con nghe được hai điều,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:59.968Z",
      "updatedAt": "2025-09-03T02:30:59.968Z",
      "chapterId": "7445e858-a372-464b-86b8-e4f4f6d88ec3"
    },
    {
      "id": "6b6ed580-51dd-467b-8798-3144e7434322",
      "text": "rằng : Ngài nắm quyền uy",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:59.982Z",
      "updatedAt": "2025-09-03T02:30:59.982Z",
      "chapterId": "7445e858-a372-464b-86b8-e4f4f6d88ec3"
    },
    {
      "id": "28f591a1-3ec9-4319-a0b3-79fe815953f3",
      "text": "và giàu lòng nhân hậu ;",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:30:59.996Z",
      "updatedAt": "2025-09-03T02:30:59.996Z",
      "chapterId": "7445e858-a372-464b-86b8-e4f4f6d88ec3"
    },
    {
      "id": "3c71f41c-7592-460a-a521-d03b834dd55c",
      "text": "rằng : Ngài theo tội phúc mà thưởng phạt mỗi người.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:00.010Z",
      "updatedAt": "2025-09-03T02:31:00.010Z",
      "chapterId": "7445e858-a372-464b-86b8-e4f4f6d88ec3"
    }
  ],
  "marks": [
    {
      "id": "3d2e8479-be57-4370-b19b-ad742df23f66",
      "content": "*Tv tín nhiệm* này gồm những phần sau đây : **1**) Niềm tin tưởng đặt vào Thiên Chúa (cc. 2-3) ; **2**) Các địch thù quấy nhiễu (cc. 4-5) ; **3**) Niềm tin tưởng đặt vào Thiên Chúa (cc. 6-9) ; **4**) Đừng tin tưởng vào con người, vào bạo lực cũng như tiền tài (cc. 10-11) ; **5**) Lời sấm của Thiên Chúa (cc. 12-13).",
