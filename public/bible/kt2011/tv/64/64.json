{
  "chapter": {
    "id": "44043a4d-d023-4ed2-bf92-18fb005cd48c",
    "number": 64,
    "createdAt": "2025-09-03T01:07:51.661Z",
    "updatedAt": "2025-09-03T01:07:51.661Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "61b0ac05-e0b1-41b3-8dbf-d02aae90e08e",
      "text": "*Phần ca trưởng. Thánh vịnh. Của vua Đa-vít.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:31:10.976Z",
      "updatedAt": "2025-09-03T02:31:10.976Z",
      "chapterId": "44043a4d-d023-4ed2-bf92-18fb005cd48c"
    },
    {
      "id": "0c231100-7879-4d99-a691-b32590b49a0a",
      "text": "Lạy Chúa Trời, xin nghe tiếng thở than,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:11.026Z",
      "updatedAt": "2025-09-03T02:31:11.026Z",
      "chapterId": "44043a4d-d023-4ed2-bf92-18fb005cd48c"
    },
    {
      "id": "c9a3acf7-b5e7-4f0a-b7e1-34ed0148d0fa",
      "text": "gìn giữ mạng con khỏi quân thù khủng bố,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:11.037Z",
      "updatedAt": "2025-09-03T02:31:11.037Z",
      "chapterId": "44043a4d-d023-4ed2-bf92-18fb005cd48c"
    },
    {
      "id": "39f1ac46-20f7-4ea6-8016-dfce14fa21fa",
      "text": "Này kẻ ác mưu đồ, chúng ồn ào tác hại, xin giấu kỹ con đi.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:11.049Z",
      "updatedAt": "2025-09-03T02:31:11.049Z",
      "chapterId": "44043a4d-d023-4ed2-bf92-18fb005cd48c"
    },
    {
      "id": "89700487-d03a-4c1d-9029-a53eaedb4a1b",
      "text": "Chúng mài lưỡi như mài gươm sắc,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:11.062Z",
      "updatedAt": "2025-09-03T02:31:11.062Z",
      "chapterId": "44043a4d-d023-4ed2-bf92-18fb005cd48c"
    },
    {
      "id": "7a8d79ac-e6fb-471e-a477-387b4d87b3f4",
      "text": "lời thâm độc tựa tên lắp vào cung,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:11.079Z",
      "updatedAt": "2025-09-03T02:31:11.079Z",
      "chapterId": "44043a4d-d023-4ed2-bf92-18fb005cd48c"
    },
    {
      "id": "3ed5a591-e2c9-4085-845a-2fe81fde87df",
      "text": "bắn trộm người vô tội,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:11.107Z",
      "updatedAt": "2025-09-03T02:31:11.107Z",
      "chapterId": "44043a4d-d023-4ed2-bf92-18fb005cd48c"
    },
    {
      "id": "e7db33f8-9cd4-4115-84e3-db056af0790c",
      "text": "bắn thình lình mà chẳng sợ chi.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:11.121Z",
      "updatedAt": "2025-09-03T02:31:11.121Z",
      "chapterId": "44043a4d-d023-4ed2-bf92-18fb005cd48c"
    },
    {
      "id": "29218c6f-c37e-4248-9e37-c2d4b2836562",
      "text": "Chúng quyết tâm làm điều độc dữ,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:11.150Z",
      "updatedAt": "2025-09-03T02:31:11.150Z",
      "chapterId": "44043a4d-d023-4ed2-bf92-18fb005cd48c"
    },
    {
      "id": "edb8d863-4bd4-4611-8386-ee0b4f04d674",
      "text": "bàn luận xem gài bẫy thế nào,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:11.164Z",
      "updatedAt": "2025-09-03T02:31:11.164Z",
      "chapterId": "44043a4d-d023-4ed2-bf92-18fb005cd48c"
    },
    {
      "id": "65c2d2ae-4dde-4b7b-b6cd-6f75ea2151d7",
      "text": "rồi nhỏ to : “Ai mà thấy được ?”",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:11.192Z",
      "updatedAt": "2025-09-03T02:31:11.192Z",
      "chapterId": "44043a4d-d023-4ed2-bf92-18fb005cd48c"
    },
    {
      "id": "f280517b-e446-47f8-afda-175bcbc8cd96",
      "text": "Bày kế lập mưu làm điều ác,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:11.212Z",
      "updatedAt": "2025-09-03T02:31:11.212Z",
      "chapterId": "44043a4d-d023-4ed2-bf92-18fb005cd48c"
    },
    {
      "id": "5460d9ec-ba67-4686-9eb2-ec9dc3257a5e",
      "text": "chúng hoàn thành kế hoạch đã mưu toan.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:11.226Z",
      "updatedAt": "2025-09-03T02:31:11.226Z",
      "chapterId": "44043a4d-d023-4ed2-bf92-18fb005cd48c"
    },
    {
      "id": "350c491c-b3c1-421e-9dfb-7d84dbe7dcd4",
      "text": "Thâm hiểm biết bao lòng dạ người đời !",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:11.240Z",
      "updatedAt": "2025-09-03T02:31:11.240Z",
      "chapterId": "44043a4d-d023-4ed2-bf92-18fb005cd48c"
    },
    {
      "id": "52f44754-7060-4a94-b8e5-d56f7c33a407",
      "text": "Nhưng Thiên Chúa lại bắn tên vào chúng,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:11.254Z",
      "updatedAt": "2025-09-03T02:31:11.254Z",
      "chapterId": "44043a4d-d023-4ed2-bf92-18fb005cd48c"
    },
    {
      "id": "27930df8-a78e-437d-927f-b5297b45a588",
      "text": "thình lình chúng đã bị trúng thương.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:11.269Z",
      "updatedAt": "2025-09-03T02:31:11.269Z",
      "chapterId": "44043a4d-d023-4ed2-bf92-18fb005cd48c"
    },
    {
      "id": "b9f9a1a6-b703-4b14-b566-e48fcb05883c",
      "text": "Tấc lưỡi mình hại mình là thế !",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:11.283Z",
      "updatedAt": "2025-09-03T02:31:11.283Z",
      "chapterId": "44043a4d-d023-4ed2-bf92-18fb005cd48c"
    },
    {
      "id": "a3a52b6e-b543-4b29-82e7-045e091864c5",
      "text": "Thiên hạ xem, ai cũng lắc đầu.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:11.297Z",
      "updatedAt": "2025-09-03T02:31:11.297Z",
      "chapterId": "44043a4d-d023-4ed2-bf92-18fb005cd48c"
    },
    {
      "id": "f66f891e-b08a-4536-bb2c-70c99a003ef4",
      "text": "Hết thảy mọi người đều kính sợ,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:11.311Z",
      "updatedAt": "2025-09-03T02:31:11.311Z",
      "chapterId": "44043a4d-d023-4ed2-bf92-18fb005cd48c"
    },
    {
      "id": "d5083311-777a-4886-b4c4-e6b3efd4fadd",
      "text": "họ sẽ loan truyền hành động của Thiên Chúa",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:11.325Z",
      "updatedAt": "2025-09-03T02:31:11.325Z",
      "chapterId": "44043a4d-d023-4ed2-bf92-18fb005cd48c"
    },
    {
      "id": "45e23d3b-9cf1-4348-aa96-39c7b005b8e1",
      "text": "và hiểu ngay những việc Người làm.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:11.339Z",
      "updatedAt": "2025-09-03T02:31:11.339Z",
      "chapterId": "44043a4d-d023-4ed2-bf92-18fb005cd48c"
    },
    {
      "id": "8aff26f8-75e4-4fd0-84eb-aeaaaab6154b",
      "text": "Người công chính sẽ vui mừng trong CHÚA",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:11.353Z",
      "updatedAt": "2025-09-03T02:31:11.353Z",
      "chapterId": "44043a4d-d023-4ed2-bf92-18fb005cd48c"
    },
    {
      "id": "ab185388-f532-4e38-a610-94189c430e5a",
      "text": "và ẩn náu bên Người.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:11.367Z",
      "updatedAt": "2025-09-03T02:31:11.367Z",
      "chapterId": "44043a4d-d023-4ed2-bf92-18fb005cd48c"
    },
    {
      "id": "7a245cfa-d923-4e64-979c-b61937c97c8c",
      "text": "Mọi tấm lòng chính trực đều lấy thế làm vinh.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:11.381Z",
      "updatedAt": "2025-09-03T02:31:11.381Z",
      "chapterId": "44043a4d-d023-4ed2-bf92-18fb005cd48c"
    }
  ],
  "marks": [
    {
      "id": "91366aaa-511f-4f27-86fa-ac9e7650a1d9",
      "content": "*Ai ca này của cá nhân* bắt đầu với lời tác giả khẩn nài Thiên Chúa bảo vệ tính mạng mình khỏi quân thù tìm cách làm hại (cc. 2-3). Rồi sau khi miêu tả ý đồ và những hành động độc ác của họ (cc. 4-7), tác giả cho thấy Thiên Chúa ra tay can thiệp để chống lại họ (cc. 8-10). Thánh vịnh kết thúc bằng một câu diễn tả niềm vui của người công chính (c.11).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 53,
      "endOffset": 53,
      "createdAt": "2025-09-03T02:31:11.005Z",
      "updatedAt": "2025-09-03T02:31:11.005Z",
      "targetId": "b3bcdb4a-7028-46f6-b8b3-82a472f9dda6",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "44043a4d-d023-4ed2-bf92-18fb005cd48c"
    },
    {
      "id": "75e1cc20-64db-46e1-9c7c-8aedeccbc5c8",
