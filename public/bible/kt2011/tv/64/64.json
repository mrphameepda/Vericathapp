    {
      "id": "14e540e3-77b7-4db2-af3e-deaae8ef4e04",
      "content": "Is 29,15",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 13,
      "endOffset": 13,
      "createdAt": "2025-09-03T02:31:11.179Z",
      "updatedAt": "2025-09-03T02:31:11.179Z",
      "targetId": "edb8d863-4bd4-4611-8386-ee0b4f04d674",
      "targetType": "MARK_TARGET_TYPE_VERSE",
