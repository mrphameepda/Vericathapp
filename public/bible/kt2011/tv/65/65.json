{
  "chapter": {
    "id": "fb5c1787-616a-4eec-80f1-f7db7243d543",
    "number": 65,
    "createdAt": "2025-09-03T01:07:51.661Z",
    "updatedAt": "2025-09-03T01:07:51.661Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "056456d7-7210-4281-a269-2fee63d29d4c",
      "text": "*Phần ca trưởng. Thánh vịnh. Của vua Đa-vít. Thánh ca.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:31:16.548Z",
      "updatedAt": "2025-09-03T02:31:16.548Z",
      "chapterId": "fb5c1787-616a-4eec-80f1-f7db7243d543"
    },
    {
      "id": "1f61856c-877a-446e-a8e2-34a7c31f7eec",
      "text": "Lạy Thiên Chúa,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:16.602Z",
      "updatedAt": "2025-09-03T02:31:16.602Z",
      "chapterId": "fb5c1787-616a-4eec-80f1-f7db7243d543"
    },
    {
      "id": "c594ee11-2da2-4cd5-a72f-45b16d0b5025",
      "text": "ca tụng Ngài ở Xi-on, thật là chính đáng,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:16.617Z",
      "updatedAt": "2025-09-03T02:31:16.617Z",
      "chapterId": "fb5c1787-616a-4eec-80f1-f7db7243d543"
    },
    {
      "id": "b8251f08-2e96-42f0-9037-df7fcbcf487d",
      "text": "điều khấn hứa cùng Ngài, phải lo giữ trọn.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:16.645Z",
      "updatedAt": "2025-09-03T02:31:16.645Z",
      "chapterId": "fb5c1787-616a-4eec-80f1-f7db7243d543"
    },
    {
      "id": "e9345bdd-bbde-49ba-b04a-f25579226593",
      "text": "Chúa là Đấng nghe lời cầu khẩn,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:16.658Z",
      "updatedAt": "2025-09-03T02:31:16.658Z",
      "chapterId": "fb5c1787-616a-4eec-80f1-f7db7243d543"
    },
    {
      "id": "954c07a6-5544-4949-838b-f7685cf6df23",
      "text": "mọi phàm nhân sẽ đến với Ngài,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:16.673Z",
      "updatedAt": "2025-09-03T02:31:16.673Z",
      "chapterId": "fb5c1787-616a-4eec-80f1-f7db7243d543"
    },
    {
      "id": "f955f513-f575-4539-814c-fdbc5f4d41df",
      "text": "thân mang đầy tội lỗi ;",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:16.687Z",
      "updatedAt": "2025-09-03T02:31:16.687Z",
      "chapterId": "fb5c1787-616a-4eec-80f1-f7db7243d543"
    },
    {
      "id": "dfae7a31-7d17-4129-916b-02826aefdef3",
      "text": "bao tội ác đè bẹp chúng con,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:16.701Z",
      "updatedAt": "2025-09-03T02:31:16.701Z",
      "chapterId": "fb5c1787-616a-4eec-80f1-f7db7243d543"
    },
    {
      "id": "4378a6d6-20da-47c9-a91b-17a08843b8d1",
      "text": "nhưng phần Chúa, Chúa tha thứ cả.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:16.715Z",
      "updatedAt": "2025-09-03T02:31:16.715Z",
      "chapterId": "fb5c1787-616a-4eec-80f1-f7db7243d543"
    },
    {
      "id": "bf13bdb9-131d-4645-ba46-b0930dc6dcd0",
      "text": "Phúc thay kẻ được Ngài tuyển chọn",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:16.743Z",
      "updatedAt": "2025-09-03T02:31:16.743Z",
      "chapterId": "fb5c1787-616a-4eec-80f1-f7db7243d543"
    },
    {
      "id": "e5ad9599-bddc-4dfe-97fc-a0e48cfc51d1",
      "text": "và cho ở tại khuôn viên đền Ngài.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:16.757Z",
      "updatedAt": "2025-09-03T02:31:16.757Z",
      "chapterId": "fb5c1787-616a-4eec-80f1-f7db7243d543"
    },
    {
      "id": "a095b2d1-35ca-4405-9a63-81221c85ec37",
      "text": "Ân huệ nhà Chúa, chúng con tận hưởng,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:16.771Z",
      "updatedAt": "2025-09-03T02:31:16.771Z",
      "chapterId": "fb5c1787-616a-4eec-80f1-f7db7243d543"
    },
    {
      "id": "c216de65-ea8c-441c-8dd7-3e32097d514f",
      "text": "lộc thánh đền Ngài, lại được đầy no.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 3,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:16.785Z",
      "updatedAt": "2025-09-03T02:31:16.785Z",
      "chapterId": "fb5c1787-616a-4eec-80f1-f7db7243d543"
    },
    {
      "id": "a4a78889-420d-433b-ab70-0b421e33c559",
      "text": "Ngài công minh đáp lại lời chúng con",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:16.799Z",
      "updatedAt": "2025-09-03T02:31:16.799Z",
      "chapterId": "fb5c1787-616a-4eec-80f1-f7db7243d543"
    },
    {
      "id": "dc31fd89-5a64-44bd-8750-376b5ff122d4",
      "text": "bằng những việc lạ lùng kinh hãi,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:16.813Z",
      "updatedAt": "2025-09-03T02:31:16.813Z",
      "chapterId": "fb5c1787-616a-4eec-80f1-f7db7243d543"
    },
    {
      "id": "65d221fc-93fb-4e45-84e2-c85b6f5ea4f2",
      "text": "lạy Chúa Trời, Đấng cứu độ chúng con,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:16.827Z",
      "updatedAt": "2025-09-03T02:31:16.827Z",
      "chapterId": "fb5c1787-616a-4eec-80f1-f7db7243d543"
    },
    {
      "id": "db55faac-c01f-4512-bd6c-3efadc6bae76",
      "text": "Ngài là niềm hy vọng của toàn cõi đất",
      "label": "6",
      "number": 6,
      "subVerseIndex": 3,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:16.841Z",
      "updatedAt": "2025-09-03T02:31:16.841Z",
      "chapterId": "fb5c1787-616a-4eec-80f1-f7db7243d543"
    },
    {
      "id": "e02a7066-8dd9-4ba4-b316-d96ffa73bebf",
      "text": "và hải đảo xa vời.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 4,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:16.855Z",
      "updatedAt": "2025-09-03T02:31:16.855Z",
      "chapterId": "fb5c1787-616a-4eec-80f1-f7db7243d543"
    },
    {
      "id": "43ee7709-f52d-44ad-a9de-47b44abca489",
      "text": "Ngài dùng sức mạnh đặt núi non vững chãi,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:16.884Z",
      "updatedAt": "2025-09-03T02:31:16.884Z",
      "chapterId": "fb5c1787-616a-4eec-80f1-f7db7243d543"
    },
    {
      "id": "a00ea573-830f-40a9-a801-b6c9be61ac99",
      "text": "lấy uy dũng mà thắt ngang lưng.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:16.919Z",
      "updatedAt": "2025-09-03T02:31:16.919Z",
      "chapterId": "fb5c1787-616a-4eec-80f1-f7db7243d543"
    },
    {
      "id": "d05b76aa-4da3-48a8-bd4d-1de5bb06131a",
      "text": "Biển cả gầm vang, sóng cồn gào thét,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:16.933Z",
      "updatedAt": "2025-09-03T02:31:16.933Z",
      "chapterId": "fb5c1787-616a-4eec-80f1-f7db7243d543"
    },
    {
      "id": "712422a7-a0f5-4d40-8aae-29ad7f8deb8b",
      "text": "người muôn nước náo động xôn xao :",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:16.947Z",
      "updatedAt": "2025-09-03T02:31:16.947Z",
      "chapterId": "fb5c1787-616a-4eec-80f1-f7db7243d543"
    },
    {
      "id": "5459adc1-22b5-40e8-82f3-5b69f9a66cbc",
      "text": "Ngài khiến tất cả phải im hơi lặng tiếng.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:16.961Z",
      "updatedAt": "2025-09-03T02:31:16.961Z",
      "chapterId": "fb5c1787-616a-4eec-80f1-f7db7243d543"
    },
    {
      "id": "2f183cee-bf24-4340-b26e-a7dba3ff4b4b",
      "text": "Dân cư trên khắp cùng trái đất",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:16.989Z",
      "updatedAt": "2025-09-03T02:31:16.989Z",
      "chapterId": "fb5c1787-616a-4eec-80f1-f7db7243d543"
    },
    {
      "id": "052bd512-aed8-4e9f-b1ef-1a00accb6925",
      "text": "thấy kỳ công của Ngài, phải khiếp oai.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:17.003Z",
      "updatedAt": "2025-09-03T02:31:17.003Z",
      "chapterId": "fb5c1787-616a-4eec-80f1-f7db7243d543"
    },
    {
      "id": "d7319bba-14e8-4ae9-a6fc-5197cd2af0d3",
      "text": "Ngài làm vang tiếng reo cười,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:17.017Z",
      "updatedAt": "2025-09-03T02:31:17.017Z",
      "chapterId": "fb5c1787-616a-4eec-80f1-f7db7243d543"
    },
    {
      "id": "b5d9901c-d5c3-4e97-8abe-6d1aa9f04821",
      "text": "cửa đông sáng sớm, cửa đoài chiều hôm.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 3,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:17.031Z",
      "updatedAt": "2025-09-03T02:31:17.031Z",
      "chapterId": "fb5c1787-616a-4eec-80f1-f7db7243d543"
    },
    {
      "id": "76a26a70-c7d1-4269-8fd5-68386f410b11",
      "text": "Thăm trái đất, Ngài tuôn mưa móc,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:17.065Z",
      "updatedAt": "2025-09-03T02:31:17.065Z",
      "chapterId": "fb5c1787-616a-4eec-80f1-f7db7243d543"
    },
    {
      "id": "14242ad1-1918-4cb4-9742-759c7ea78dd4",
      "text": "cho ngập tràn phú túc giàu sang,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:17.092Z",
      "updatedAt": "2025-09-03T02:31:17.092Z",
      "chapterId": "fb5c1787-616a-4eec-80f1-f7db7243d543"
    },
    {
      "id": "474fdc10-4049-444c-8b10-d261e51ef8bd",
      "text": "suối trời trữ nước mênh mang,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:17.106Z",
      "updatedAt": "2025-09-03T02:31:17.106Z",
      "chapterId": "fb5c1787-616a-4eec-80f1-f7db7243d543"
    },
    {
      "id": "289bf920-c92c-4ae8-b743-0146c525de15",
      "text": "dọn đất sẵn sàng đón lúa trổ bông.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 3,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:17.121Z",
      "updatedAt": "2025-09-03T02:31:17.121Z",
      "chapterId": "fb5c1787-616a-4eec-80f1-f7db7243d543"
    },
    {
      "id": "c0a1cb21-30c6-4005-8996-57e4e7d853e5",
      "text": "Tưới từng luống, san từng mô đất,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:17.135Z",
      "updatedAt": "2025-09-03T02:31:17.135Z",
      "chapterId": "fb5c1787-616a-4eec-80f1-f7db7243d543"
    },
    {
      "id": "e563c401-c219-4879-96f8-dd009fd1c376",
      "text": "khiến dầm mưa cho hạt nẩy mầm,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:17.149Z",
      "updatedAt": "2025-09-03T02:31:17.149Z",
      "chapterId": "fb5c1787-616a-4eec-80f1-f7db7243d543"
    },
    {
      "id": "60978c99-2dbe-46fb-8e54-5030c08167b7",
      "text": "bốn mùa Chúa đổ hồng ân,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:17.162Z",
      "updatedAt": "2025-09-03T02:31:17.162Z",
      "chapterId": "fb5c1787-616a-4eec-80f1-f7db7243d543"
    },
    {
      "id": "6c5faa55-d209-4d78-83f9-b1ba2a7ee43a",
      "text": "Ngài gieo mầu mỡ ngập tràn lối đi.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:17.180Z",
      "updatedAt": "2025-09-03T02:31:17.180Z",
      "chapterId": "fb5c1787-616a-4eec-80f1-f7db7243d543"
    },
    {
      "id": "cfbf7691-a07d-4ade-8647-fab9720cd86e",
      "text": "Vùng hoang địa xanh rì ngọn cỏ,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:17.208Z",
      "updatedAt": "2025-09-03T02:31:17.208Z",
      "chapterId": "fb5c1787-616a-4eec-80f1-f7db7243d543"
    },
    {
      "id": "9eea3557-6b93-4a91-aec8-e31629c8543a",
      "text": "cảnh núi đồi hớn hở tươi xinh,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:17.221Z",
      "updatedAt": "2025-09-03T02:31:17.221Z",
      "chapterId": "fb5c1787-616a-4eec-80f1-f7db7243d543"
    },
    {
      "id": "8f3faae2-13be-4887-9737-b33f38aaddd8",
      "text": "chiên cừu phủ trắng đồng xanh,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:17.236Z",
      "updatedAt": "2025-09-03T02:31:17.236Z",
      "chapterId": "fb5c1787-616a-4eec-80f1-f7db7243d543"
    },
    {
      "id": "939f0dcf-1aa1-4b5f-89e2-3dede418f045",
      "text": "lúa vàng dưới lũng rung rinh dạt dào,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
