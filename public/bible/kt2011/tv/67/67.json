{
  "chapter": {
    "id": "698e65a7-ff54-4110-84f2-f53380c0c926",
    "number": 67,
    "createdAt": "2025-09-03T01:07:51.661Z",
    "updatedAt": "2025-09-03T01:07:51.661Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "5f7b46cd-81c2-4d3a-a608-f0bee59cdd10",
      "text": "*Phần ca trưởng. Theo huyền cầm. Thánh vịnh. Thánh ca.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:31:27.718Z",
      "updatedAt": "2025-09-03T02:31:27.718Z",
      "chapterId": "698e65a7-ff54-4110-84f2-f53380c0c926"
    },
    {
      "id": "41b7c824-0ce2-4451-854e-7d3628518e91",
      "text": "Nguyện Chúa Trời rủ thương và chúc phúc,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:27.758Z",
      "updatedAt": "2025-09-03T02:31:27.758Z",
      "chapterId": "698e65a7-ff54-4110-84f2-f53380c0c926"
    },
    {
      "id": "880e6c84-cdb1-44e3-922d-8833115a1a33",
      "text": "xin toả ánh tôn nhan rạng ngời trên chúng con,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:27.781Z",
      "updatedAt": "2025-09-03T02:31:27.781Z",
      "chapterId": "698e65a7-ff54-4110-84f2-f53380c0c926"
    },
    {
      "id": "06e71a7d-4855-4723-817e-b6935f202254",
      "text": "cho cả hoàn cầu biết đường lối Chúa,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:27.809Z",
      "updatedAt": "2025-09-03T02:31:27.809Z",
      "chapterId": "698e65a7-ff54-4110-84f2-f53380c0c926"
    },
    {
      "id": "934ac350-6dc9-481f-8b5c-b2c95809343d",
      "text": "và muôn nước biết ơn cứu độ của Ngài.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:27.822Z",
      "updatedAt": "2025-09-03T02:31:27.822Z",
      "chapterId": "698e65a7-ff54-4110-84f2-f53380c0c926"
    },
    {
      "id": "33dc1803-44f9-4980-a8ed-0aa2ef5bfb73",
      "text": "Ước gì chư dân cảm tạ Ngài, lạy Thiên Chúa,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:27.850Z",
      "updatedAt": "2025-09-03T02:31:27.850Z",
      "chapterId": "698e65a7-ff54-4110-84f2-f53380c0c926"
    },
    {
      "id": "e7ae5de1-5bd8-46c5-8542-32d07e0e6575",
      "text": "chư dân phải đồng thanh cảm tạ Ngài !",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:27.864Z",
      "updatedAt": "2025-09-03T02:31:27.864Z",
      "chapterId": "698e65a7-ff54-4110-84f2-f53380c0c926"
    },
    {
      "id": "d190cc13-d42a-4a4b-a114-d190b4732787",
      "text": "Ước gì muôn nước reo hò mừng rỡ,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:27.877Z",
      "updatedAt": "2025-09-03T02:31:27.877Z",
      "chapterId": "698e65a7-ff54-4110-84f2-f53380c0c926"
    },
    {
      "id": "ab2985bf-6bf6-4933-9055-09588d387bf2",
      "text": "vì Chúa cai trị cả hoàn cầu theo lẽ công minh,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:27.895Z",
      "updatedAt": "2025-09-03T02:31:27.895Z",
      "chapterId": "698e65a7-ff54-4110-84f2-f53380c0c926"
    },
    {
      "id": "263f7e92-51f7-4603-b66a-21424175170c",
      "text": "Người cai trị muôn nước theo đường chính trực",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:27.909Z",
      "updatedAt": "2025-09-03T02:31:27.909Z",
      "chapterId": "698e65a7-ff54-4110-84f2-f53380c0c926"
    },
    {
      "id": "514f487d-5005-4816-8301-11ab7838bd7f",
      "text": "và lãnh đạo muôn dân trên mặt đất này.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 3,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:27.923Z",
      "updatedAt": "2025-09-03T02:31:27.923Z",
      "chapterId": "698e65a7-ff54-4110-84f2-f53380c0c926"
    },
    {
      "id": "efdd1b9e-29e3-4380-8237-2254aaf22291",
      "text": "Ước gì chư dân cảm tạ Ngài, lạy Thiên Chúa,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:27.937Z",
      "updatedAt": "2025-09-03T02:31:27.937Z",
      "chapterId": "698e65a7-ff54-4110-84f2-f53380c0c926"
    },
    {
      "id": "5fc56ef1-fc2d-4d10-a42d-fe4d4c69f9e2",
      "text": "chư dân phải đồng thanh cảm tạ Ngài.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:27.951Z",
      "updatedAt": "2025-09-03T02:31:27.951Z",
      "chapterId": "698e65a7-ff54-4110-84f2-f53380c0c926"
    },
    {
      "id": "bd8b7096-f5ec-4fa6-93a9-51473e9c36e6",
      "text": "Đất đã sinh ra mùa màng hoa trái :",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:27.964Z",
      "updatedAt": "2025-09-03T02:31:27.964Z",
      "chapterId": "698e65a7-ff54-4110-84f2-f53380c0c926"
    },
    {
      "id": "3a1efb32-f853-4a6a-bea2-61dc1d970f95",
      "text": "Chúa Trời, Chúa chúng ta, đã ban phúc lộc.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:27.991Z",
      "updatedAt": "2025-09-03T02:31:27.991Z",
      "chapterId": "698e65a7-ff54-4110-84f2-f53380c0c926"
    },
    {
      "id": "1b382f57-beb8-4f56-985d-6045515aa5c3",
      "text": "Nguyện Chúa Trời ban phúc lộc cho ta !",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:28.003Z",
      "updatedAt": "2025-09-03T02:31:28.003Z",
      "chapterId": "698e65a7-ff54-4110-84f2-f53380c0c926"
    },
    {
      "id": "a1274468-a53a-480e-b38c-382966d7bbef",
      "text": "Ước chi toàn cõi đất kính sợ Người !",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:28.014Z",
      "updatedAt": "2025-09-03T02:31:28.014Z",
      "chapterId": "698e65a7-ff54-4110-84f2-f53380c0c926"
    }
  ],
  "marks": [
    {
      "id": "71c6bbc3-3c75-4c10-84b4-2d4b7f595b20",
      "content": "Theo phần đông các nhà chú giải, Tv này thuộc loại *tạ ơn của tập thể*. Có lẽ Tv này đã được soạn thảo để dùng trong lễ Nhà Tạm vào cuối mùa thu hoạch hoa trái (x. c.7) nhằm cảm tạ Thiên Chúa. Một điệp ca được lặp lại hai lần (c.4 và c.6) cho thấy : Tv chia làm ba phần : **1**) Cc. 2-4 ; **2**) Cc. 5-6 ; **3**) Cc. 7-8.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 46,
      "endOffset": 46,
      "createdAt": "2025-09-03T02:31:27.747Z",
