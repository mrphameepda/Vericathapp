{
  "chapter": {
    "id": "f4f61905-2aa0-4185-80ac-e134b53707f2",
    "number": 7,
    "createdAt": "2025-09-03T01:07:51.659Z",
    "updatedAt": "2025-09-03T01:07:51.659Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "6fc39d9b-8614-4061-b266-e2f141c56acf",
      "text": "*Lời than vãn. Của vua Đa-vít hát lên trước ĐỨC CHÚA về vụ tên Cút thuộc chi tộc Ben-gia-min.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:25:13.736Z",
      "updatedAt": "2025-09-03T02:25:13.736Z",
      "chapterId": "f4f61905-2aa0-4185-80ac-e134b53707f2"
    },
    {
      "id": "1e95f843-6893-4860-9ad3-f4c2f46a7831",
      "text": "Lạy CHÚA là Thiên Chúa của con, con ẩn náu bên Ngài.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:13.800Z",
      "updatedAt": "2025-09-03T02:25:13.800Z",
      "chapterId": "f4f61905-2aa0-4185-80ac-e134b53707f2"
    },
    {
      "id": "d0cbfc0c-69ee-45e5-83aa-29bcac3bce5f",
      "text": "Xin cứu vớt và giải thoát con",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:13.811Z",
      "updatedAt": "2025-09-03T02:25:13.811Z",
      "chapterId": "f4f61905-2aa0-4185-80ac-e134b53707f2"
    },
    {
      "id": "06dbcbe9-15cd-438c-a941-b9f576ba5a1a",
      "text": "khỏi tay mọi người đang đuổi bắt,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:13.834Z",
      "updatedAt": "2025-09-03T02:25:13.834Z",
      "chapterId": "f4f61905-2aa0-4185-80ac-e134b53707f2"
    },
    {
      "id": "6c1887e2-7d1f-4a92-b0ae-b27f5dfef06a",
      "text": "kẻo họ vồ lấy con, xé nát như sư tử,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:13.845Z",
      "updatedAt": "2025-09-03T02:25:13.845Z",
      "chapterId": "f4f61905-2aa0-4185-80ac-e134b53707f2"
    },
    {
      "id": "7dab8399-726b-44d5-93ea-e7af46c4e0eb",
      "text": "mà không người giải thoát.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:13.872Z",
      "updatedAt": "2025-09-03T02:25:13.872Z",
      "chapterId": "f4f61905-2aa0-4185-80ac-e134b53707f2"
    },
    {
      "id": "7413e388-32f7-4ed9-89cc-510c7fa2ed7f",
      "text": "Lạy CHÚA là Thiên Chúa của con, nếu con đã lỗi lầm,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:13.886Z",
      "updatedAt": "2025-09-03T02:25:13.886Z",
      "chapterId": "f4f61905-2aa0-4185-80ac-e134b53707f2"
    },
    {
      "id": "c15395ce-39d8-4bb9-911f-c1002886aecb",
      "text": "nếu tay con đã làm điều bất chính,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:13.900Z",
      "updatedAt": "2025-09-03T02:25:13.900Z",
      "chapterId": "f4f61905-2aa0-4185-80ac-e134b53707f2"
    },
    {
      "id": "41942215-e42b-4c16-8d5b-9cbef87ac00c",
      "text": "nếu con đã hại người thân nghĩa",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:13.914Z",
      "updatedAt": "2025-09-03T02:25:13.914Z",
      "chapterId": "f4f61905-2aa0-4185-80ac-e134b53707f2"
    },
    {
      "id": "80f6b4b4-4b63-4ab0-ac9f-bc8e983dfb6b",
      "text": "hoặc vô cớ bóc lột quân thù,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:13.928Z",
      "updatedAt": "2025-09-03T02:25:13.928Z",
      "chapterId": "f4f61905-2aa0-4185-80ac-e134b53707f2"
    },
    {
      "id": "68fa39dd-6d12-47ce-8931-2daec8bc9ad7",
      "text": "thì chớ chi thù địch rượt đuổi và bắt con,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:13.942Z",
      "updatedAt": "2025-09-03T02:25:13.942Z",
      "chapterId": "f4f61905-2aa0-4185-80ac-e134b53707f2"
    },
    {
      "id": "9591e25d-c2c0-45b5-ac7c-5a56cc8cf87b",
      "text": "chà đạp mạng sống con dưới đất,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:13.956Z",
      "updatedAt": "2025-09-03T02:25:13.956Z",
      "chapterId": "f4f61905-2aa0-4185-80ac-e134b53707f2"
    },
    {
      "id": "d210a94e-53d3-4c2a-9945-ce1549d8d678",
      "text": "chôn vùi danh dự xuống bùn đen.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:13.972Z",
      "updatedAt": "2025-09-03T02:25:13.972Z",
      "chapterId": "f4f61905-2aa0-4185-80ac-e134b53707f2"
    },
    {
      "id": "e59e1683-4531-4bff-a7ee-54ed0b6472b7",
      "text": "Lạy CHÚA, trong cơn thịnh nộ, xin đứng lên",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:13.986Z",
      "updatedAt": "2025-09-03T02:25:13.986Z",
      "chapterId": "f4f61905-2aa0-4185-80ac-e134b53707f2"
    },
    {
      "id": "9361c047-a731-4ebb-b3e6-30ce069ef0d3",
      "text": "chế ngự lũ quân thù hung hãn.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:14.001Z",
      "updatedAt": "2025-09-03T02:25:14.001Z",
      "chapterId": "f4f61905-2aa0-4185-80ac-e134b53707f2"
    },
    {
      "id": "27462c5b-3fc4-4681-b592-fb754a83b74a",
      "text": "Xin Ngài thức dậy bênh vực con,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:14.015Z",
      "updatedAt": "2025-09-03T02:25:14.015Z",
      "chapterId": "f4f61905-2aa0-4185-80ac-e134b53707f2"
    },
    {
      "id": "500243a4-7019-41f3-b992-01ae8eaef113",
      "text": "Ngài là Đấng cầm cân nảy mực.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 3,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:14.043Z",
      "updatedAt": "2025-09-03T02:25:14.043Z",
      "chapterId": "f4f61905-2aa0-4185-80ac-e134b53707f2"
    },
    {
      "id": "c237fe5a-4b57-44fc-9e0c-180a90fa659f",
      "text": "Chớ gì các dân họp nhau lại quanh Ngài,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:14.057Z",
      "updatedAt": "2025-09-03T02:25:14.057Z",
      "chapterId": "f4f61905-2aa0-4185-80ac-e134b53707f2"
    },
    {
      "id": "490519ed-2ef8-4ec8-b79f-83ce380622fc",
      "text": "xin Ngài ngự chốn cao xanh thống trị chúng.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:14.071Z",
      "updatedAt": "2025-09-03T02:25:14.071Z",
      "chapterId": "f4f61905-2aa0-4185-80ac-e134b53707f2"
    },
    {
      "id": "a39a767d-a4ea-45a2-b174-19e105e7e705",
      "text": "Lạy CHÚA là Đấng xét xử muôn dân nước,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:14.085Z",
      "updatedAt": "2025-09-03T02:25:14.085Z",
      "chapterId": "f4f61905-2aa0-4185-80ac-e134b53707f2"
    },
    {
      "id": "7c2fe46a-ad9c-440a-a709-dd2731a239bb",
      "text": "xin CHÚA xử cho con, vì con công chính và vô tội.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:14.100Z",
      "updatedAt": "2025-09-03T02:25:14.100Z",
      "chapterId": "f4f61905-2aa0-4185-80ac-e134b53707f2"
    },
    {
      "id": "8de7527d-cfa3-4c84-9ed8-b302f64a4c49",
      "text": "Lạy Thiên Chúa công minh,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:14.113Z",
      "updatedAt": "2025-09-03T02:25:14.113Z",
      "chapterId": "f4f61905-2aa0-4185-80ac-e134b53707f2"
    },
    {
      "id": "cbe415c6-2b05-46c0-9988-88ab8c123103",
      "text": "Chúa dò thấu lòng dạ con người,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:14.127Z",
      "updatedAt": "2025-09-03T02:25:14.127Z",
      "chapterId": "f4f61905-2aa0-4185-80ac-e134b53707f2"
    },
    {
      "id": "1e823ec9-8934-43d3-ba47-eebe49444bd0",
      "text": "xin làm cho bọn ác nhân hết đường tác hại",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:14.149Z",
      "updatedAt": "2025-09-03T02:25:14.149Z",
      "chapterId": "f4f61905-2aa0-4185-80ac-e134b53707f2"
    },
    {
      "id": "233f1d86-9f27-4422-a1e5-f18cdce4db9a",
      "text": "và cho người công chính được vững vàng.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 3,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:14.160Z",
      "updatedAt": "2025-09-03T02:25:14.160Z",
      "chapterId": "f4f61905-2aa0-4185-80ac-e134b53707f2"
    },
    {
      "id": "2ead18d9-446d-4048-b884-05fa0c16fe29",
      "text": "Khiên mộc che chở tôi là Thiên Chúa,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:14.170Z",
      "updatedAt": "2025-09-03T02:25:14.170Z",
      "chapterId": "f4f61905-2aa0-4185-80ac-e134b53707f2"
    },
    {
      "id": "9c351f8a-1bce-4f8f-b0ac-696c347e3cf6",
      "text": "Đấng cứu độ những ai có lòng ngay thẳng.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:14.180Z",
      "updatedAt": "2025-09-03T02:25:14.180Z",
      "chapterId": "f4f61905-2aa0-4185-80ac-e134b53707f2"
    },
    {
      "id": "f15b35d3-f526-4f5f-8e3d-efa80ae8f849",
      "text": "Thiên Chúa là thẩm phán công minh,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:14.190Z",
      "updatedAt": "2025-09-03T02:25:14.190Z",
      "chapterId": "f4f61905-2aa0-4185-80ac-e134b53707f2"
    },
    {
      "id": "34be285d-78ef-40a2-b51f-de4dea8516c7",
      "text": "ngày ngày Chúa đe doạ",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:14.201Z",
      "updatedAt": "2025-09-03T02:25:14.201Z",
      "chapterId": "f4f61905-2aa0-4185-80ac-e134b53707f2"
    },
    {
      "id": "58f20d5d-1db7-4776-807a-3165c44cca09",
      "text": "nếu thế nhân không trở lại cùng Người.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:14.211Z",
      "updatedAt": "2025-09-03T02:25:14.211Z",
      "chapterId": "f4f61905-2aa0-4185-80ac-e134b53707f2"
    },
    {
      "id": "0c8cf5c0-3413-4ceb-a817-c36835744ec1",
      "text": "Kẻ ác mài gươm trương nỏ sẵn sàng,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:14.224Z",
      "updatedAt": "2025-09-03T02:25:14.224Z",
      "chapterId": "f4f61905-2aa0-4185-80ac-e134b53707f2"
    },
    {
      "id": "7a3fcaac-e92c-4f47-8723-c6b9785465a3",
      "text": "nó chuẩn bị vũ khí sát nhân,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:14.235Z",
      "updatedAt": "2025-09-03T02:25:14.235Z",
      "chapterId": "f4f61905-2aa0-4185-80ac-e134b53707f2"
    },
    {
      "id": "fa39f3cc-6ffe-400a-b334-0b5075226b35",
      "text": "lấy mũi tên biến thành tên lửa, chính là để hại mình.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:14.245Z",
      "updatedAt": "2025-09-03T02:25:14.245Z",
      "chapterId": "f4f61905-2aa0-4185-80ac-e134b53707f2"
    },
    {
      "id": "6404f30e-c09a-49e0-b5a0-caae3d7554d2",
      "text": "Kìa nó manh tâm làm điều bất chính,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:14.255Z",
      "updatedAt": "2025-09-03T02:25:14.255Z",
      "chapterId": "f4f61905-2aa0-4185-80ac-e134b53707f2"
    },
    {
      "id": "d4c5ca99-2759-4761-af8b-c431dc00815f",
      "text": "cưu mang điều ác hại, ắt phải sinh ra chuyện gian tà.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:14.269Z",
      "updatedAt": "2025-09-03T02:25:14.269Z",
      "chapterId": "f4f61905-2aa0-4185-80ac-e134b53707f2"
    },
    {
      "id": "f4991aeb-fee0-488a-a774-392b1934d03f",
      "text": "Nó đào hầm đào hố, chính nó lại sa chân.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:14.282Z",
      "updatedAt": "2025-09-03T02:25:14.282Z",
      "chapterId": "f4f61905-2aa0-4185-80ac-e134b53707f2"
    },
    {
      "id": "c06674a2-55ac-4cec-947b-e6d206fe0448",
      "text": "Hại người chẳng hoá hại thân,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:14.297Z",
      "updatedAt": "2025-09-03T02:25:14.297Z",
      "chapterId": "f4f61905-2aa0-4185-80ac-e134b53707f2"
    },
    {
      "id": "73358ab3-9d0e-4a2e-9692-18d67f7981eb",
      "text": "gậy ông đập xuống lại dần lưng ông.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:14.314Z",
      "updatedAt": "2025-09-03T02:25:14.314Z",
      "chapterId": "f4f61905-2aa0-4185-80ac-e134b53707f2"
    },
    {
      "id": "90302d7c-1998-4e65-bd34-4feaee2e5e65",
      "text": "Tôi xin tạ ơn CHÚA, bởi vì Người công minh chính trực,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:14.355Z",
      "updatedAt": "2025-09-03T02:25:14.355Z",
      "chapterId": "f4f61905-2aa0-4185-80ac-e134b53707f2"
    },
    {
      "id": "d1104c7f-b593-4ffd-8ee0-797356d6d56b",
      "text": "tôi đàn ca mừng danh CHÚA Tối Cao.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:14.370Z",
      "updatedAt": "2025-09-03T02:25:14.370Z",
      "chapterId": "f4f61905-2aa0-4185-80ac-e134b53707f2"
    }
  ],
  "marks": [
    {
      "id": "baabb6a9-0c3f-4ae0-9e16-938861a53992",
      "content": "Tv 7 thuộc số các *ai ca của cá nhân*. Bố cục : **1**) Lời kêu xin Thiên Chúa đến giải cứu (cc. 2-3) ; **2**) Lời tác giả Tv cam đoan về sự vô tội của mình (cc. 4-6) ; **3**) Lời kêu xin Thiên Chúa can thiệp để làm sáng tỏ lẽ công bình, để minh oan (cc. 7-10) ; **4**) Lòng trông cậy vào Thiên Chúa là Đấng cứu thoát và cũng là vị Thẩm phán công minh (cc. 11-13a) ; **5**) Xác tín về sự thất bại và sụp đổ của đối phương có ác tâm (cc. 13b-17) ; **6**) Lời tạ ơn Thiên Chúa (cc. 6-18).",
