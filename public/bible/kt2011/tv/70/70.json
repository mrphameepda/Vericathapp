    {
      "id": "70d0bf45-c524-44f6-9758-5233805a158a",
      "content": "C.2 được sử dụng như công thức bắt đầu một giờ kinh phụng vụ.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 30,
      "endOffset": 30,
      "createdAt": "2025-09-03T02:31:48.060Z",
      "updatedAt": "2025-09-03T02:31:48.060Z",
      "targetId": "14132686-bdad-4528-9712-a8c53c01c34e",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1552f61f-2765-4e49-8515-b624f4da2906"
    },
    {
      "id": "5566f7b4-d405-44ef-89f0-9f8d45719737",
      "content": "C.6 (câu cuối) lặp lại ý của c.2 (câu đầu) theo một hình thức khác. Như thế, hai câu đó hợp thành một thứ “inclusio”.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
