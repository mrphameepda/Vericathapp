{
  "chapter": {
    "id": "1552f61f-2765-4e49-8515-b624f4da2906",
    "number": 70,
    "createdAt": "2025-09-03T01:07:51.661Z",
    "updatedAt": "2025-09-03T01:07:51.661Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "d7c74aee-1a57-4c9b-842f-48649e76b49a",
      "text": "*Phần ca trưởng. Của vua Đa-vít. Để tưởng nhớ.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:31:47.990Z",
      "updatedAt": "2025-09-03T02:31:47.990Z",
      "chapterId": "1552f61f-2765-4e49-8515-b624f4da2906"
    },
    {
      "id": "f9af2390-d07c-4db5-9768-0aa21ec3f4c0",
      "text": "Lạy Chúa Trời, xin đến cứu con,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:48.039Z",
      "updatedAt": "2025-09-03T02:31:48.039Z",
      "chapterId": "1552f61f-2765-4e49-8515-b624f4da2906"
    },
    {
      "id": "14132686-bdad-4528-9712-a8c53c01c34e",
      "text": "muôn lạy CHÚA, xin mau phù trợ !",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:48.049Z",
      "updatedAt": "2025-09-03T02:31:48.049Z",
      "chapterId": "1552f61f-2765-4e49-8515-b624f4da2906"
    },
    {
      "id": "20754d41-5561-4cc1-9c8b-34313a263bf8",
      "text": "Ước gì những kẻ tìm hại mạng sống con",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:48.071Z",
      "updatedAt": "2025-09-03T02:31:48.071Z",
      "chapterId": "1552f61f-2765-4e49-8515-b624f4da2906"
    },
    {
      "id": "8c9057ad-aece-4c9c-9138-4add2595f269",
      "text": "phải nhơ nhuốc thẹn thùng !",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:48.097Z",
      "updatedAt": "2025-09-03T02:31:48.097Z",
      "chapterId": "1552f61f-2765-4e49-8515-b624f4da2906"
    },
    {
      "id": "5101a5eb-95ae-4144-a6bb-9ee7306ee03e",
      "text": "Ước gì bọn đắc chí vì con mắc hoạ",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:48.111Z",
      "updatedAt": "2025-09-03T02:31:48.111Z",
      "chapterId": "1552f61f-2765-4e49-8515-b624f4da2906"
    },
    {
      "id": "c876744e-2e83-4c98-b4a0-5ce7cc90fdcb",
      "text": "phải tháo lui nhục nhã !",
      "label": "3",
      "number": 3,
      "subVerseIndex": 3,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:48.125Z",
      "updatedAt": "2025-09-03T02:31:48.125Z",
      "chapterId": "1552f61f-2765-4e49-8515-b624f4da2906"
    },
    {
      "id": "c4a2a637-1d1c-448f-ac42-a747cc0bfe36",
      "text": "Những đứa cười ha hả nhạo con",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:48.138Z",
      "updatedAt": "2025-09-03T02:31:48.138Z",
      "chapterId": "1552f61f-2765-4e49-8515-b624f4da2906"
    },
    {
      "id": "1488e3af-0505-46f9-83e8-1f10b2de71b4",
      "text": "phải quay gót thẹn thùng !",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:48.152Z",
      "updatedAt": "2025-09-03T02:31:48.152Z",
      "chapterId": "1552f61f-2765-4e49-8515-b624f4da2906"
    },
    {
      "id": "cf31a90d-b65c-4fcd-8123-bce30fcdaef1",
      "text": "Ước chi mọi kẻ tìm kiếm Chúa",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:48.166Z",
      "updatedAt": "2025-09-03T02:31:48.166Z",
      "chapterId": "1552f61f-2765-4e49-8515-b624f4da2906"
    },
    {
      "id": "81167bee-209f-4e7d-98fe-b59aa4c1c3bd",
      "text": "đều mừng vui hoan hỷ trong Ngài !",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:48.181Z",
      "updatedAt": "2025-09-03T02:31:48.181Z",
      "chapterId": "1552f61f-2765-4e49-8515-b624f4da2906"
    },
    {
      "id": "f0e23482-cd42-49bd-892a-3c3ff1f92d47",
      "text": "Và những ai cảm mến ơn Ngài tế độ",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:48.195Z",
      "updatedAt": "2025-09-03T02:31:48.195Z",
      "chapterId": "1552f61f-2765-4e49-8515-b624f4da2906"
    },
    {
      "id": "d5090c77-a36f-4775-bdd3-be7283a2371f",
      "text": "luôn nói rằng : “Thiên Chúa vĩ đại thay !”",
      "label": "5",
      "number": 5,
      "subVerseIndex": 3,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:48.209Z",
      "updatedAt": "2025-09-03T02:31:48.209Z",
      "chapterId": "1552f61f-2765-4e49-8515-b624f4da2906"
    },
    {
      "id": "b0280290-8df8-4611-be57-1f76af37779e",
      "text": "Thân phận con khốn khổ nghèo hèn,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:48.223Z",
      "updatedAt": "2025-09-03T02:31:48.223Z",
      "chapterId": "1552f61f-2765-4e49-8515-b624f4da2906"
    },
    {
      "id": "5a12941b-f738-435e-ba90-557e65b5d603",
      "text": "xin mau đến cùng con, lạy Thiên Chúa !",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:48.237Z",
      "updatedAt": "2025-09-03T02:31:48.237Z",
      "chapterId": "1552f61f-2765-4e49-8515-b624f4da2906"
    },
    {
      "id": "3904da67-1832-4f48-b285-8b753a5e0003",
      "text": "Ngài là Đấng phù trợ, là Đấng giải thoát con,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:48.250Z",
      "updatedAt": "2025-09-03T02:31:48.250Z",
      "chapterId": "1552f61f-2765-4e49-8515-b624f4da2906"
    },
    {
      "id": "56128fae-a58f-4c6d-8203-de843ee3470e",
      "text": "muôn lạy CHÚA, xin đừng trì hoãn.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 3,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:48.264Z",
      "updatedAt": "2025-09-03T02:31:48.264Z",
      "chapterId": "1552f61f-2765-4e49-8515-b624f4da2906"
    }
  ],
  "marks": [
    {
      "id": "70d95a12-6a1e-4909-93c5-380a64144391",
      "content": "Tv 70 là *một ai ca của cá nhân*, lặp lại Tv 40,14-18 ngoại trừ một vài điểm khác biệt. Cấu trúc của ai ca là như sau : **1**) Nhập đề (c.2) ; **2**) Lời nguyền rủa các kẻ thù (cc. 3-4) ; **3**) Lời cầu chúc những người tìm kiếm Thiên Chúa (c.5) ; **4**) Lời cầu khẩn kết thúc ai ca (c.6).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 41,
      "endOffset": 41,
      "createdAt": "2025-09-03T02:31:48.018Z",
