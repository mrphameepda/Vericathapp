      "targetId": "9d666401-2760-4d95-9f5c-01fe4bf738d3",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "d3e25541-077e-4a5e-aa75-fd88d65ae91e",
      "content": "English: Sin | French: Sin | Latin: Sin | Origin: &#1505;&#1460;&#1497;&#1503; | Vietnamese: Xin 1 -- sa mạc trong cuộc Xuất hành, Xh 16,1 ; Ds 33,11-12",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "5",
      "sortOrder": 4,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:31:55.029Z",
      "updatedAt": "2025-09-03T02:31:55.029Z",
      "targetId": "98f6e652-ae2f-4e32-8b12-113df1a6551d",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "b8be896d-dfc7-42ab-bf65-4072ee7912fa",
      "content": "X. c.18a. Tuổi già hạnh phúc là một trong những điều Thiên Chúa dành cho người công chính (x. St 15,15 ; 25,8 ; Tl 8,32).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "6",
      "sortOrder": 5,
      "startOffset": 30,
