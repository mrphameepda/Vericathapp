{
  "chapter": {
    "id": "0425fee6-b28a-4b22-ae17-882d3f1e9037",
    "number": 71,
    "createdAt": "2025-09-03T01:07:51.661Z",
    "updatedAt": "2025-09-03T01:07:51.661Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "21de4639-bd3d-48e0-8030-c13ab8f3f437",
      "text": "Con ẩn náu bên Ngài, lạy CHÚA,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:54.659Z",
      "updatedAt": "2025-09-03T02:31:54.659Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "57c4f9a2-14a9-4b7b-a625-9e0d7f61e2c2",
      "text": "xin đừng để con phải tủi nhục bao giờ.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:54.712Z",
      "updatedAt": "2025-09-03T02:31:54.712Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "1f0b71b6-bac2-4f30-9d03-c42e3c5302b9",
      "text": "Vì Ngài công chính, xin cứu vớt và giải thoát con,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:54.725Z",
      "updatedAt": "2025-09-03T02:31:54.725Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "e6cd4e4f-238c-49a3-a876-0935f670314b",
      "text": "ghé tai nghe và thương cứu độ.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:54.739Z",
      "updatedAt": "2025-09-03T02:31:54.739Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "d9ba1d38-9eb3-4156-bd26-868c280f0937",
      "text": "Xin Ngài nên như núi đá cho con trú ẩn,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:54.752Z",
      "updatedAt": "2025-09-03T02:31:54.752Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "cd4efcdb-d196-4d8c-80d0-73f13173a908",
      "text": "như thành trì để cứu độ con,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:54.780Z",
      "updatedAt": "2025-09-03T02:31:54.780Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "6e5456bd-a80d-45fa-945f-75893d09c863",
      "text": "núi đá và thành trì bảo vệ con, chính là Ngài.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:54.794Z",
      "updatedAt": "2025-09-03T02:31:54.794Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "ff12b5e3-dc82-4beb-8222-132ef825409a",
      "text": "Lạy Thiên Chúa, xin giải thoát con khỏi bàn tay kẻ dữ,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:54.823Z",
      "updatedAt": "2025-09-03T02:31:54.823Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "d856cce1-fc73-4d3f-8b20-51f3a5cd4fd3",
      "text": "khỏi móng vuốt phường nham hiểm và bọn dã man.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:54.836Z",
      "updatedAt": "2025-09-03T02:31:54.836Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "ebc4bd3c-bccd-4c32-b167-571f9f7ed5dd",
      "text": "Vì lạy Chúa, chính Ngài là Đấng con trông đợi,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:54.850Z",
      "updatedAt": "2025-09-03T02:31:54.850Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "9d666401-2760-4d95-9f5c-01fe4bf738d3",
      "text": "lạy ĐỨC CHÚA, chính Ngài là Đấng con tin tưởng",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:54.864Z",
      "updatedAt": "2025-09-03T02:31:54.864Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "75137fe0-d942-4599-9226-dff9e546c5ef",
      "text": "ngay từ độ thanh xuân.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:54.892Z",
      "updatedAt": "2025-09-03T02:31:54.892Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "c5170dd1-e815-439f-ae37-b9d35a07bd05",
      "text": "Từ thuở sơ sinh, con nương tựa vào Ngài,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:54.906Z",
      "updatedAt": "2025-09-03T02:31:54.906Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "4bcd7fff-5775-4602-9676-75f5d624090e",
      "text": "Ngài đã kéo con ra khỏi lòng mẹ,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:54.926Z",
      "updatedAt": "2025-09-03T02:31:54.926Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "4779a45a-8f5a-4683-8de8-558f086520ac",
      "text": "con ca tụng Ngài chẳng khi ngơi.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:54.943Z",
      "updatedAt": "2025-09-03T02:31:54.943Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "345537a3-3a20-44cd-9ef6-0a7f390482ad",
      "text": "Con đã gây thắc mắc cho bao người,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:54.960Z",
      "updatedAt": "2025-09-03T02:31:54.960Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "54a32a13-f8e1-4038-95b6-56e42bde6ad9",
      "text": "nhưng Chúa là nơi vững chắc cho con vào trú ẩn.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:54.973Z",
      "updatedAt": "2025-09-03T02:31:54.973Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "67d19d57-aa96-4d8b-9bf1-5c7b8504b7f0",
      "text": "Miệng chứa chan lời tán tụng Chúa,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:54.987Z",
      "updatedAt": "2025-09-03T02:31:54.987Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "2d2d449a-8d5d-497b-ad0d-2a9e416d1bbe",
      "text": "suốt ngày con chẳng ngớt tôn vinh.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.001Z",
      "updatedAt": "2025-09-03T02:31:55.001Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "98f6e652-ae2f-4e32-8b12-113df1a6551d",
      "text": "Xin đừng sa thải con lúc tuổi đà xế bóng,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.014Z",
      "updatedAt": "2025-09-03T02:31:55.014Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "b1061056-8c48-411e-9d69-623263c1ff7d",
      "text": "chớ bỏ rơi khi sức lực suy tàn.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.042Z",
      "updatedAt": "2025-09-03T02:31:55.042Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "155faf40-3f37-48df-b656-8a8f1c45d4b4",
      "text": "Vì thù địch nặng lời chống đối,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.071Z",
      "updatedAt": "2025-09-03T02:31:55.071Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "3d44333b-7632-4f89-9641-db94766fbc59",
      "text": "quân rình hại mạng con đã nhất trí bày mưu,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.085Z",
      "updatedAt": "2025-09-03T02:31:55.085Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "00b25aba-d772-4882-b8dd-e739df646502",
      "text": "bảo nhau rằng : “Thiên Chúa bỏ hắn rồi, cứ truy nã,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.099Z",
      "updatedAt": "2025-09-03T02:31:55.099Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "bef633b5-311a-4c56-b9fd-9c4dee9b1af4",
      "text": "bắt hắn đi, chẳng có ai cứu hắn đâu mà !”",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.114Z",
      "updatedAt": "2025-09-03T02:31:55.114Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "5b5e7a39-c7b1-41cc-80fb-9503c8081ec2",
      "text": "Lạy Thiên Chúa, xin đừng nỡ xa con,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.128Z",
      "updatedAt": "2025-09-03T02:31:55.128Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "48f61b64-4ac8-4496-9987-5473f22c74b2",
      "text": "lạy Thiên Chúa, xin Ngài mau trợ giúp !",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.156Z",
      "updatedAt": "2025-09-03T02:31:55.156Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "0237605c-129d-48a5-9f11-c429a94da912",
      "text": "Ước chi những người muốn hại mạng sống con",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.170Z",
      "updatedAt": "2025-09-03T02:31:55.170Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "21d1e9af-5002-406d-97fe-46713e7c3904",
      "text": "đều phải chết nhục nhã ê chề ;",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.184Z",
      "updatedAt": "2025-09-03T02:31:55.184Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "032b462f-cda6-48ca-a74a-ad07e0fa8a0c",
      "text": "kẻ tìm cách gây hoạ cho con",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.198Z",
      "updatedAt": "2025-09-03T02:31:55.198Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "a4721003-cc35-4b27-b018-4173f09bfc23",
      "text": "phải muôn vàn nhuốc nhơ xấu hổ.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 3,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.212Z",
      "updatedAt": "2025-09-03T02:31:55.212Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "aa2ccfc8-0279-4283-9a4d-5a5100584422",
      "text": "Phần con đây, vẫn một bề trông cậy,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.225Z",
      "updatedAt": "2025-09-03T02:31:55.225Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "bd0cf919-72e9-4124-80eb-c7f5dfcdee67",
      "text": "và gia tăng lời tán tụng Ngài.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.239Z",
      "updatedAt": "2025-09-03T02:31:55.239Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "e0c0c3a4-5055-4986-b8f5-fa14cbca3e07",
      "text": "Miệng con công bố Ngài chính trực,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.253Z",
      "updatedAt": "2025-09-03T02:31:55.253Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "67e834ca-810b-4c04-b4c8-59c5b6eda500",
      "text": "suốt ngày tường thuật ơn cứu độ Ngài ban,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.267Z",
      "updatedAt": "2025-09-03T02:31:55.267Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "4768d136-55c9-4200-87d6-5581dae7f0f5",
      "text": "ơn của Ngài, nhiều khôn xiết kể !",
      "label": "15",
      "number": 15,
      "subVerseIndex": 2,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.282Z",
      "updatedAt": "2025-09-03T02:31:55.282Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "a3d0dfbd-9423-4cf0-8471-54bc7e0c1c66",
      "text": "Con thuật lại bao chiến công của CHÚA,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.295Z",
      "updatedAt": "2025-09-03T02:31:55.295Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "afe19f95-d2bb-4e8e-9681-29c838d1269d",
      "text": "nhắc nhở rằng : chỉ mình Ngài chính trực công minh.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.309Z",
      "updatedAt": "2025-09-03T02:31:55.309Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "1a8b2b0f-6451-434e-99b1-5c885a883e87",
      "text": "Từ độ thanh xuân, lạy Thiên Chúa,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.323Z",
      "updatedAt": "2025-09-03T02:31:55.323Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "5a9ffab5-0e04-4acd-8965-8ae4567737c6",
      "text": "con đã được Ngài thương dạy dỗ.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.338Z",
      "updatedAt": "2025-09-03T02:31:55.338Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "d586e055-64b9-4391-ac17-25ba37007ed5",
      "text": "Tới giờ này, con vẫn truyền rao vĩ nghiệp của Ngài.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 2,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.352Z",
      "updatedAt": "2025-09-03T02:31:55.352Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "5af78275-4390-4846-a526-5ab7728b024f",
      "text": "Cả lúc con già nua, da mồi tóc bạc,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.365Z",
      "updatedAt": "2025-09-03T02:31:55.365Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "2c51f08c-05d3-4fe2-93e1-5fcafd04715d",
      "text": "lạy Thiên Chúa, xin đừng bỏ rơi con,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.379Z",
      "updatedAt": "2025-09-03T02:31:55.379Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "f405f2dc-81c2-40a4-9a9f-c802f9c99df6",
      "text": "để con tường thuật quyền năng của Chúa",
      "label": "18",
      "number": 18,
      "subVerseIndex": 2,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.393Z",
      "updatedAt": "2025-09-03T02:31:55.393Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "eadfb734-d7bf-4d91-b03e-4c6ba019519d",
      "text": "cho thế hệ này được rõ,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 3,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.407Z",
      "updatedAt": "2025-09-03T02:31:55.407Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "7db68d1c-ca14-4b91-9ad1-4b7d950a96f6",
      "text": "và dũng lực của Ngài",
      "label": "18",
      "number": 18,
      "subVerseIndex": 4,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.435Z",
      "updatedAt": "2025-09-03T02:31:55.435Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "1cc67306-fcc5-416e-b80d-ff0920207be7",
      "text": "cho thế hệ mai sau.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 5,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.448Z",
      "updatedAt": "2025-09-03T02:31:55.448Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "5aafa75c-2bb0-440f-b5cb-54aef84711f1",
      "text": "Lạy Thiên Chúa, đức chính trực của Ngài cao vời vợi,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.461Z",
      "updatedAt": "2025-09-03T02:31:55.461Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "e6273d2b-7664-4033-902c-f72448faaed4",
      "text": "Ngài đã làm những việc lớn lao,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.479Z",
      "updatedAt": "2025-09-03T02:31:55.479Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "19598713-4dfd-4859-9bec-120fde696fc8",
      "text": "lạy Thiên Chúa, nào ai sánh tày !",
      "label": "19",
      "number": 19,
      "subVerseIndex": 2,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.489Z",
      "updatedAt": "2025-09-03T02:31:55.489Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "a738c758-09ba-4684-b97a-1805786be23e",
      "text": "Ngài đã bắt con nếm mùi tân khổ,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.503Z",
      "updatedAt": "2025-09-03T02:31:55.503Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "812d11ba-c2ba-4362-9020-f13e2db59eeb",
      "text": "chính Ngài sẽ cho con được hoàn sinh",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.513Z",
      "updatedAt": "2025-09-03T02:31:55.513Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "dde61880-9d16-419d-a57a-2e06e9fbb262",
      "text": "và kéo ra khỏi vực sâu lòng đất.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 2,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.524Z",
      "updatedAt": "2025-09-03T02:31:55.524Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "12b65035-69d1-4b19-a693-b893fb21f810",
      "text": "Phần vinh hoa, Ngài sẽ ban nhiều, và trở lại vỗ về an ủi.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.534Z",
      "updatedAt": "2025-09-03T02:31:55.534Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "997fc543-de1a-4726-89e2-48da446ad1ea",
      "text": "Lạy Thiên Chúa, con dạo khúc hạc cầm",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.545Z",
      "updatedAt": "2025-09-03T02:31:55.545Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "057df462-2a06-49c2-8cbe-1642c55b441c",
      "text": "tạ ơn Ngài thành tín.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.556Z",
      "updatedAt": "2025-09-03T02:31:55.556Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "e17c190a-325e-4240-b1a4-ff8ba743ed5b",
      "text": "Gảy cung tỳ bà, con ngâm vịnh",
      "label": "22",
      "number": 22,
      "subVerseIndex": 2,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.568Z",
      "updatedAt": "2025-09-03T02:31:55.568Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "7801b73d-94d9-4fca-b90d-4880a8013b45",
      "text": "kính dâng Ngài, lạy Đức Thánh của Ít-ra-en.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 3,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.580Z",
      "updatedAt": "2025-09-03T02:31:55.580Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "d47697a1-188c-4d5f-b773-ad50f00f0fe4",
      "text": "Miệng con sẽ reo hò theo nhịp đàn mừng Chúa.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.608Z",
      "updatedAt": "2025-09-03T02:31:55.608Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "e1965373-8272-4510-8202-8ffc7284da73",
      "text": "Hồn con nữa, hồn con Ngài cứu chuộc,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.622Z",
      "updatedAt": "2025-09-03T02:31:55.622Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "868eedf1-fe32-4b3c-b7a2-cce7507f94b6",
      "text": "cũng vui sướng hò reo.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 2,
      "paragraphNumber": 60,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.637Z",
      "updatedAt": "2025-09-03T02:31:55.637Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "5a26a189-8de6-4450-ae52-7e3a8894dad1",
      "text": "Và suốt ngày con nhẩm đi nhắc lại :",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 61,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.651Z",
      "updatedAt": "2025-09-03T02:31:55.651Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "514a1451-dbd5-432c-939a-6e2629ae0633",
      "text": "quả thật Ngài công chính !",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 62,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.665Z",
      "updatedAt": "2025-09-03T02:31:55.665Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    },
    {
      "id": "7d2d7771-10db-485a-9a5c-8916c0f9abf4",
      "text": "Vì những kẻ tìm cách gây hoạ cho con sẽ xấu hổ thẹn thùng.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 2,
      "paragraphNumber": 63,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:31:55.679Z",
      "updatedAt": "2025-09-03T02:31:55.679Z",
      "chapterId": "0425fee6-b28a-4b22-ae17-882d3f1e9037"
    }
  ],
  "marks": [
    {
      "id": "275220b8-aaab-404c-8882-9183fa2a6407",
      "content": "Bị kẻ thù độc ác và lắm mưu mẹo tìm đủ cách làm hại, một cụ già (cc. 5.9.17.18) khẩn khoản nài xin Thiên Chúa duy trì sự sống (c.20) và bảo vệ tính mạng mình. Ngoài lời khẩn cầu dâng lên Thiên Chúa, *ai ca này của cá nhân* cũng chứa đựng những lời ca ngợi Thiên Chúa hoặc những lời hứa sẽ ngợi khen Người trong tương lai (x. cc. 8.14-18.22-24). Về cấu trúc, có thể coi cc. 1-2 như nhập đề và cc. 22-24 như kết luận của Tv ; còn các phần của thân bài (cc. 3-21), thì khó mà phân chia cách rõ ràng được. Tuy nhiên, có thể dựa vào những ý tưởng giống nhau hoặc ăn khớp nhau để phân chia các phần của thân bài như sau : 3-6 ; 7-13 ; 14-21.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
