{
  "chapter": {
    "id": "12c29593-c4f7-4567-b950-3a729b56bc87",
    "number": 73,
    "createdAt": "2025-09-03T01:07:51.661Z",
    "updatedAt": "2025-09-03T01:07:51.661Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "360e12c2-ee1c-4b9e-9966-f715860df1c2",
      "text": "*Thánh vịnh. Của ông A-xáp.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:32:07.372Z",
      "updatedAt": "2025-09-03T02:32:07.372Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "07d3dcd6-c823-455d-b708-0d9040a29d6d",
      "text": "Thiên Chúa nhân hậu biết dường nào với nhà Ít-ra-en,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:07.428Z",
      "updatedAt": "2025-09-03T02:32:07.428Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "832a1e12-991e-47cf-ac21-f12a76767df2",
      "text": "với những kẻ có lòng trong sạch !",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:07.456Z",
      "updatedAt": "2025-09-03T02:32:07.456Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "96eb3c53-79c3-4051-b596-eabb5e686f5a",
      "text": "Thế mà tôi đã gần như hụt bước,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:07.482Z",
      "updatedAt": "2025-09-03T02:32:07.482Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "9a6fc72d-077e-4935-8f5d-9138aefb64a7",
      "text": "một chút nữa là tôi phải trượt chân,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:07.493Z",
      "updatedAt": "2025-09-03T02:32:07.493Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "8451d78e-3dd7-4f62-be79-2f9805d2d6d5",
      "text": "bởi ganh tị những người lên mặt",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:07.505Z",
      "updatedAt": "2025-09-03T02:32:07.505Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "e3816ec5-9227-4c33-af29-0325ef878787",
      "text": "và thấy ác nhân thịnh đạt hoài.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:07.529Z",
      "updatedAt": "2025-09-03T02:32:07.529Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "b396c385-9962-4f3f-b1d9-78b0ae98721e",
      "text": "Quả là chúng không nếm mùi tân khổ,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:07.549Z",
      "updatedAt": "2025-09-03T02:32:07.549Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "c823799d-16ad-4af4-bc2a-443cd9ebe974",
      "text": "chúng có thân hình mạnh mẽ phương phi,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:07.562Z",
      "updatedAt": "2025-09-03T02:32:07.562Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "a0a18884-d0de-4997-8004-bece9e8030d5",
      "text": "không hề vất vả như ai khác,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:07.589Z",
      "updatedAt": "2025-09-03T02:32:07.589Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "1403e47a-1602-4ed9-b833-492e591f1ae5",
      "text": "chẳng bị tai ương giống người đời.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:07.603Z",
      "updatedAt": "2025-09-03T02:32:07.603Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "719dee63-cf24-49b2-a721-3988aeb7d599",
      "text": "Vì vậy, chúng lấy vẻ kiêu căng làm vòng đeo cổ,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:07.617Z",
      "updatedAt": "2025-09-03T02:32:07.617Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "d750033b-08ea-4075-be57-d9f379aba6b7",
      "text": "lấy thói bạo tàn làm áo che thân.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:07.630Z",
      "updatedAt": "2025-09-03T02:32:07.630Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "9fb2b9fa-632d-49a5-aae1-5a9215414f51",
      "text": "Xác đầy mỡ tiết ra toàn gian ác,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:07.644Z",
      "updatedAt": "2025-09-03T02:32:07.644Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "c8dd9d90-ea34-4add-a909-02ffb862dd05",
      "text": "và tâm địa chan chứa những mưu mô.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:07.673Z",
      "updatedAt": "2025-09-03T02:32:07.673Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "55759df9-f654-4280-9abe-4a59f56e074f",
      "text": "Chúng chế giễu, buông lời thâm độc,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:07.690Z",
      "updatedAt": "2025-09-03T02:32:07.690Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "550fd27c-217b-4194-b18e-f3568cf6e31c",
      "text": "lại kiêu căng bàn chuyện ức hiếp người ;",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:07.704Z",
      "updatedAt": "2025-09-03T02:32:07.704Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "02bdcee3-6c1f-4613-aa69-6b7e2c221f73",
      "text": "miệng chẳng từ xúc phạm trời cao,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:07.718Z",
      "updatedAt": "2025-09-03T02:32:07.718Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "e209ef95-dddf-45cb-92a1-bab857b95612",
      "text": "lưỡi tự do tung hoành cõi đất.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:07.732Z",
      "updatedAt": "2025-09-03T02:32:07.732Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "44fd0a58-be8d-4a34-acc5-6523e0bda4d6",
      "text": "Nên dân ta hướng về chúng cả,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:07.747Z",
      "updatedAt": "2025-09-03T02:32:07.747Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "b4b0291f-688f-42af-98b1-081553ed0b00",
      "text": "lời chúng thốt ra, hăm hở nuốt vào.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:07.761Z",
      "updatedAt": "2025-09-03T02:32:07.761Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "b11ca1a8-9561-4e63-a880-cec767b629ff",
      "text": "Chúng bảo : “Chúa Trời đâu có biết,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:07.775Z",
      "updatedAt": "2025-09-03T02:32:07.775Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "f9e5888b-2436-408e-a24d-1eb946da961f",
      "text": "Đấng Tối Cao nào hiểu chuyện chi !”",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:07.803Z",
      "updatedAt": "2025-09-03T02:32:07.803Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "26b795ae-b7e2-48ed-8590-d9b2f1611f7b",
      "text": "Ác nhân như vậy đó,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:07.832Z",
      "updatedAt": "2025-09-03T02:32:07.832Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "e369e2c5-9a4f-4e61-a241-8236b9647676",
      "text": "chúng vẫn cứ an nhàn, thu tích thêm của cải.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:07.846Z",
      "updatedAt": "2025-09-03T02:32:07.846Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "84286150-58ce-4860-8cdb-e0e58d1c2d62",
      "text": "Lạy Chúa, như thế là con đã uổng công",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:07.860Z",
      "updatedAt": "2025-09-03T02:32:07.860Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "9a3b2744-29b5-4c38-95e5-abe262f6c98c",
      "text": "giữ lòng trong trắng, giữ tay thanh sạch !",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:07.874Z",
      "updatedAt": "2025-09-03T02:32:07.874Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "1a591099-260a-4b07-9a67-5ef097f876f3",
      "text": "Suốt ngày con bị đòn bị đánh,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:07.887Z",
      "updatedAt": "2025-09-03T02:32:07.887Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "886a72f4-1ef5-4ec9-ab1d-f492cc1a9005",
      "text": "mỗi sớm mai hình phạt sẵn chờ.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:07.901Z",
      "updatedAt": "2025-09-03T02:32:07.901Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "e4cdcbf6-0f6c-4b24-a171-7215709c56b1",
      "text": "Giả như con tự nhủ : mình nói năng như chúng,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:07.915Z",
      "updatedAt": "2025-09-03T02:32:07.915Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "b478bfac-5a7b-4c65-9089-165616e94ac2",
      "text": "thì con đã thất trung với giống dòng con Chúa.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:07.929Z",
      "updatedAt": "2025-09-03T02:32:07.929Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "65516273-ffca-442c-a24f-cff1bb4dcebe",
      "text": "Nên con mới gẫm suy để hiểu chuyện này,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:07.942Z",
      "updatedAt": "2025-09-03T02:32:07.942Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "b398faaf-36fd-4e26-9b47-fecc60a975e6",
      "text": "nhưng đối với con thật là vất vả ;",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:07.956Z",
      "updatedAt": "2025-09-03T02:32:07.956Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "bed12f08-74d2-4eb2-b92c-63262268ac4e",
      "text": "cho tới ngày được vào trong thánh điện,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:07.970Z",
      "updatedAt": "2025-09-03T02:32:07.970Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "ac3ae50b-cc58-42ae-8476-12616d884e95",
      "text": "con mới am tường hậu vận chúng ra sao.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:07.984Z",
      "updatedAt": "2025-09-03T02:32:07.984Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "7dfff228-beb5-46dc-ad26-909a73e7a417",
      "text": "Quả Ngài đặt chúng vào nơi trơn trượt,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:07.998Z",
      "updatedAt": "2025-09-03T02:32:07.998Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "6992acd6-13c1-48eb-9bd7-8ee5910cedb3",
      "text": "đẩy cho rơi vào cảnh điêu tàn.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:08.026Z",
      "updatedAt": "2025-09-03T02:32:08.026Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "59cfce64-aa2e-4840-8509-feac02ff6ac6",
      "text": "Trong nháy mắt, hỡi ôi, chúng đã sụp đổ rồi,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:08.041Z",
      "updatedAt": "2025-09-03T02:32:08.041Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "91a5b836-ae20-4829-86a3-600c27565481",
      "text": "nỗi kinh hoàng ập xuống, cuốn mất cả tăm hơi !",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:08.055Z",
      "updatedAt": "2025-09-03T02:32:08.055Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "cd7173bd-3ac6-4a2d-8e81-121ee77a8874",
      "text": "Lạy Chúa, khi tỉnh giấc, Ngài xua đuổi hình ảnh chúng đi,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:08.069Z",
      "updatedAt": "2025-09-03T02:32:08.069Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "f6eae7c4-7702-4098-8f3d-68a47f0e2fc7",
      "text": "như giấc mộng phai mờ lúc người ta thức dậy.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:08.083Z",
      "updatedAt": "2025-09-03T02:32:08.083Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "5d0fe512-c2d4-4370-8162-830fa9e358d6",
      "text": "Khi lòng con ngậm hờn cay đắng",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:08.112Z",
      "updatedAt": "2025-09-03T02:32:08.112Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "fb694ecd-78ff-4e53-8b88-9170d042e837",
      "text": "và nỗi đớn đau thấu tận ruột gan,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:08.126Z",
      "updatedAt": "2025-09-03T02:32:08.126Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "c07b42e4-8ca6-46f3-859e-cb00499f7a76",
      "text": "con quả đã ngu si chẳng hiểu,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:08.153Z",
      "updatedAt": "2025-09-03T02:32:08.153Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "45de4861-a5ec-4e42-8a16-98b436ebdbc7",
      "text": "trước mặt Ngài, như thú vật nào hơn !",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:08.167Z",
      "updatedAt": "2025-09-03T02:32:08.167Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "5e0961c0-60b0-4421-8c8f-2ab586804c7b",
      "text": "Thật con ở với Chúa luôn,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:08.182Z",
      "updatedAt": "2025-09-03T02:32:08.182Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "b633f95d-0aa8-4ce4-bb48-c2432bcf2f6c",
      "text": "tay con Ngài nắm chẳng buông chẳng rời,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:08.196Z",
      "updatedAt": "2025-09-03T02:32:08.196Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "15c28224-078b-4fbe-afc4-e214c3fcd05b",
      "text": "dắt dìu khuyên nhủ bao lời,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:08.224Z",
      "updatedAt": "2025-09-03T02:32:08.224Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "51389f6c-c9d1-49a9-87bf-484dc7bd9246",
      "text": "một mai đưa tới rạng ngời quang vinh.",
      "label": "24",
      "number": 24,
      "subVerseIndex": 1,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:08.237Z",
      "updatedAt": "2025-09-03T02:32:08.237Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "8fdbe46c-29f3-4e6b-8086-10510a9bf25f",
      "text": "Con còn ai chốn trời xanh ?",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:08.251Z",
      "updatedAt": "2025-09-03T02:32:08.251Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "61aadd15-c3a4-4155-ae5c-508eb358ee2b",
      "text": "bên Ngài thế sự thật tình chẳng ham.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 1,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:08.265Z",
      "updatedAt": "2025-09-03T02:32:08.265Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "1dea13ee-bcd9-4885-a47f-6b8953c1dccd",
      "text": "Dẫu cho hồn xác suy tàn,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:08.279Z",
      "updatedAt": "2025-09-03T02:32:08.279Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "26b38cde-4fb5-44c1-bff7-7d75adc4a84e",
      "text": "thì nơi ẩn náu, kỷ phần lòng con,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 1,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:08.294Z",
      "updatedAt": "2025-09-03T02:32:08.294Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "0130f986-f182-407a-9350-01efe6701732",
      "text": "muôn đời là Chúa cao tôn.",
      "label": "26",
      "number": 26,
      "subVerseIndex": 2,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:08.321Z",
      "updatedAt": "2025-09-03T02:32:08.321Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "73c25b8c-a97b-498d-a6ad-974c9965ca02",
      "text": "Kìa ai xa Chúa, sẽ mai một hết,",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 54,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:08.335Z",
      "updatedAt": "2025-09-03T02:32:08.335Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "b4a0490a-c898-4bb0-abb2-973317603649",
      "text": "những kẻ phụ Ngài, Ngài diệt cả đi.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 1,
      "paragraphNumber": 55,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:08.349Z",
      "updatedAt": "2025-09-03T02:32:08.349Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "eb29390e-41f8-4101-9a28-1b02b38e3bd0",
      "text": "Còn hạnh phúc của con là ở kề bên Chúa,",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 56,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:08.363Z",
      "updatedAt": "2025-09-03T02:32:08.363Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "aacd81e4-88bb-415c-a9f8-db201d2b066c",
      "text": "chốn ẩn thân đặt ở Chúa Trời.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 1,
      "paragraphNumber": 57,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:08.377Z",
      "updatedAt": "2025-09-03T02:32:08.377Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "7ae0ef9d-8c7e-4116-97da-ffdd4ef4a331",
      "text": "Mọi việc Ngài làm, con xin kể lại",
      "label": "28",
      "number": 28,
      "subVerseIndex": 2,
      "paragraphNumber": 58,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:08.391Z",
      "updatedAt": "2025-09-03T02:32:08.391Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    },
    {
      "id": "8018160e-ab24-495f-857a-a2b95f4698e8",
      "text": "nơi cửa vào thành thánh Xi-on.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 3,
      "paragraphNumber": 59,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:08.404Z",
      "updatedAt": "2025-09-03T02:32:08.404Z",
      "chapterId": "12c29593-c4f7-4567-b950-3a729b56bc87"
    }
  ],
  "marks": [
    {
      "id": "e4a106fb-bf0d-40e2-9da5-da0b2293fb34",
      "content": "Bị giao động bởi cuộc sống hạnh phúc của ác nhân, tác giả thắc mắc đặt vấn đề và cuối cùng hình như tìm ra được giải pháp. *Tv giáo huấn* này chia ra như sau : **1**) Nhập đề (cc. 1-3) ; **2**) Vấn đề gây thắc mắc : ác nhân vẫn thịnh đạt, vẫn sống phây phây và tiếp tục hoành hành (cc. 4-12) ; **3**) Hoàn cảnh của người công chính (cc. 13-17) ; **4**) Hạnh phúc chóng tàn của ác nhân (cc. 18-20) ; **5**) Thiên Chúa là nơi ẩn náu cho người công chính (cc. 21-26) ; **6**) Số phận của ác nhân và của người công chính (cc. 27-28).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 45,
      "endOffset": 45,
      "createdAt": "2025-09-03T02:32:07.401Z",
      "updatedAt": "2025-09-03T02:32:07.401Z",
