{
  "chapter": {
    "id": "8ef2236b-f286-40ce-a993-19957e570ca4",
    "number": 74,
    "createdAt": "2025-09-03T01:07:51.661Z",
    "updatedAt": "2025-09-03T01:07:51.661Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "b3bb9696-63d5-4a21-b518-40c8aff0eeed",
      "text": "*Thi khúc. Của ông A-xáp.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:32:13.515Z",
      "updatedAt": "2025-09-03T02:32:13.515Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "d9c4cdf0-8eba-4c6e-b8ca-07e75048246b",
      "text": "Lạy Chúa Trời, sao cứ mãi bỏ rơi,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:13.557Z",
      "updatedAt": "2025-09-03T02:32:13.557Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "bc963c0c-4e3c-4c51-b73a-c3cf2f80b799",
      "text": "sao bừng bừng nổi giận",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:13.568Z",
      "updatedAt": "2025-09-03T02:32:13.568Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "c868207a-6654-4380-a3ef-6bf536cc9088",
      "text": "với đoàn chiên Ngài hằng chăn dắt ?",
      "label": "1",
      "number": 1,
      "subVerseIndex": 3,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:13.579Z",
      "updatedAt": "2025-09-03T02:32:13.579Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "07990dd6-ba19-4717-8314-6368f5447df0",
      "text": "Xin nhớ đến đoàn dân Ngài quy tụ thuở ban đầu,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:13.597Z",
      "updatedAt": "2025-09-03T02:32:13.597Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "0736a8f6-29ac-4a31-86b6-170537ae09e9",
      "text": "chi tộc Ngài chuộc lấy làm sản nghiệp riêng,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:13.654Z",
      "updatedAt": "2025-09-03T02:32:13.654Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "423b90c6-ba36-43bf-b6b9-61daac1a1705",
      "text": "và núi Xi-on, nơi Ngài ngự trị.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:13.668Z",
      "updatedAt": "2025-09-03T02:32:13.668Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "4efe117b-e743-4768-869c-aba978fc7e8e",
      "text": "Xin đặt bước vào chốn điêu tàn vạn cổ.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:13.702Z",
      "updatedAt": "2025-09-03T02:32:13.702Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "9af04d1d-3f03-4a82-ae5c-07cb3285aceb",
      "text": "Trong thánh điện, quân thù đã phá đổ tan hoang.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:13.730Z",
      "updatedAt": "2025-09-03T02:32:13.730Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "30aeb885-9fac-4c8c-acd5-b7f384541dce",
      "text": "Chính chỗ xưa từng làm nơi hội họp,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:13.744Z",
      "updatedAt": "2025-09-03T02:32:13.744Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "45631ce1-de79-41f9-9783-2e6e208c3c2e",
      "text": "nay đối phương ầm ĩ thét gào ;",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:13.758Z",
      "updatedAt": "2025-09-03T02:32:13.758Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "a51152f4-c747-45f6-a613-3217f245026d",
      "text": "chúng trương cờ làm hiệu kỳ chiến thắng.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:13.772Z",
      "updatedAt": "2025-09-03T02:32:13.772Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "ddda42c1-26de-4922-96d8-57cb57ff5611",
      "text": "Chúng như những kẻ múa rìu trong rừng rậm,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:13.786Z",
      "updatedAt": "2025-09-03T02:32:13.786Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "5eb4d492-520f-425d-8981-844a27ebdcde",
      "text": "vồ búa vung lên, đập tan nát cửa đền.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:13.798Z",
      "updatedAt": "2025-09-03T02:32:13.798Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "28b59302-0b11-4d46-a3aa-69475c7d3fb3",
      "text": "Thánh điện Ngài, chúng châm lửa đốt,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:13.810Z",
      "updatedAt": "2025-09-03T02:32:13.810Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "473584e6-fcc3-41ca-9c2f-3b04b2235a93",
      "text": "đền thờ Thánh Danh,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:13.833Z",
      "updatedAt": "2025-09-03T02:32:13.833Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "5b7816b8-c323-4aeb-a0ce-6f094ed380f5",
      "text": "chúng xúc phạm, chúng san bằng ;",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:13.845Z",
      "updatedAt": "2025-09-03T02:32:13.845Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "e6f28eb5-d5ad-4ccc-a64f-5f27fada0d5c",
      "text": "rồi tự nhủ : “Mình phá hết đi !”",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:13.857Z",
      "updatedAt": "2025-09-03T02:32:13.857Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "e1a6cca2-6f2e-4151-b3ed-7a2fe5b64968",
      "text": "Trong cả xứ, chúng thiêu huỷ mọi nơi thờ phượng.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:13.870Z",
      "updatedAt": "2025-09-03T02:32:13.870Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "d0526bd2-26ff-4bad-8b97-371a3257199a",
      "text": "Dấu lạ xưa, chúng con đâu thấy nữa,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:13.900Z",
      "updatedAt": "2025-09-03T02:32:13.900Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "c0453166-f997-490b-975c-1b4e8d47cc1f",
      "text": "ngôn sứ cũng chẳng còn.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:13.914Z",
      "updatedAt": "2025-09-03T02:32:13.914Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "efff6d42-0967-47a8-aa7b-5b8e24b06d4e",
      "text": "Mãi đến khi nao, ai nào có biết ?",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:13.928Z",
      "updatedAt": "2025-09-03T02:32:13.928Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "5bbdf5a0-e84d-4eac-95c5-5693cc19ab41",
      "text": "Lạy Thiên Chúa, tới bao giờ đối phương còn phỉ báng ?",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:13.942Z",
      "updatedAt": "2025-09-03T02:32:13.942Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "23a2a6cf-9bd7-4b63-a340-d04553d004d1",
      "text": "Địch quân cứ nhục mạ danh Ngài mãi mãi sao ?",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:13.956Z",
      "updatedAt": "2025-09-03T02:32:13.956Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "af7b2ca9-e4f4-429e-b9e6-2fac6822be7f",
      "text": "Cánh tay Ngài, cánh tay dũng mãnh,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:13.969Z",
      "updatedAt": "2025-09-03T02:32:13.969Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "f78a02a0-bc25-45f3-b3ed-127ef22f0b07",
      "text": "sao Ngài rút lại, chẳng can thiệp gì ?",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:13.998Z",
      "updatedAt": "2025-09-03T02:32:13.998Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "59e4c485-5011-42b0-8a01-8d79b5fb6a42",
      "text": "Thế mà lạy Thiên Chúa, Vua chúng con từ muôn thuở,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:14.012Z",
      "updatedAt": "2025-09-03T02:32:14.012Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "501a53f5-fac7-47ed-b216-f08ab62a3440",
      "text": "Đấng từng chiến thắng trên toàn cõi địa cầu,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:14.042Z",
      "updatedAt": "2025-09-03T02:32:14.042Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "52683b86-5e58-4ee6-8d28-3938176ae8c2",
      "text": "chính Ngài đã ra oai xẻ đôi lòng biển,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:14.056Z",
      "updatedAt": "2025-09-03T02:32:14.056Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "7fc22773-f4d9-4e0c-8610-4ccb1f3be175",
      "text": "trên làn nước biếc, Ngài đập vỡ sọ thuồng luồng ;",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:14.084Z",
      "updatedAt": "2025-09-03T02:32:14.084Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "03ec83e5-4320-4529-9ad5-2f34e4c84333",
      "text": "chính Ngài đã nghiền nát bảy đầu con giao long,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:14.099Z",
      "updatedAt": "2025-09-03T02:32:14.099Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "383b9f73-16a1-40de-95f3-b43d7a1ab322",
      "text": "vứt nó làm mồi cho thuỷ quái ;",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:14.112Z",
      "updatedAt": "2025-09-03T02:32:14.112Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "f8cb5794-e947-4147-a01b-d286686542c2",
      "text": "chính Ngài đã khơi nguồn cho suối tuôn thác đổ,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:14.126Z",
      "updatedAt": "2025-09-03T02:32:14.126Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "3bf8564a-c993-4fe7-8794-2ff37df5adc3",
      "text": "chính Ngài làm cạn khô sông đang chảy dạt dào.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:14.140Z",
      "updatedAt": "2025-09-03T02:32:14.140Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "e6ceb0e8-462d-49c2-8d20-f6a0ddf32cd8",
      "text": "Ngày là của Chúa, đêm cũng là của Chúa ;",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:14.169Z",
      "updatedAt": "2025-09-03T02:32:14.169Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "16c2921d-b07d-4f80-b648-a6394e667a4d",
      "text": "chính Ngài sắp đặt tinh tú cùng thái dương ;",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:14.183Z",
      "updatedAt": "2025-09-03T02:32:14.183Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "376e6be3-8d2e-4f0d-afb4-0ef0eda5f479",
      "text": "chính Ngài vạch biên cương cho cõi đất,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:14.197Z",
      "updatedAt": "2025-09-03T02:32:14.197Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "327bbd6b-ffdc-4df7-92e5-7d808a32b5b9",
      "text": "thời hạ tiết đông, cũng chính Ngài thiết lập.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:14.225Z",
      "updatedAt": "2025-09-03T02:32:14.225Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "103708e4-94a8-4801-9595-0b925b61edb7",
      "text": "Lạy CHÚA, xin nhớ cho : thù địch phỉ báng Ngài,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:14.239Z",
      "updatedAt": "2025-09-03T02:32:14.239Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "744c2048-3344-435b-a78e-ecd683bdb11e",
      "text": "lũ dân điên rồ nhục mạ Thánh Danh.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:14.253Z",
      "updatedAt": "2025-09-03T02:32:14.253Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "85a09d97-1510-46b9-ba82-45af115d7e8e",
      "text": "Thân phận bồ câu, xin đừng trao cho thú dữ,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:14.267Z",
      "updatedAt": "2025-09-03T02:32:14.267Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "012fa6a6-3f64-477a-907d-7170557403dd",
      "text": "đừng mãi mãi quên đi mạng sống dân nghèo khổ của Ngài.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:14.296Z",
      "updatedAt": "2025-09-03T02:32:14.296Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "07efce13-28a6-4104-a5f3-b3eaf1eec95e",
      "text": "Giao ước thuở xưa, xin nhìn lại,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:14.313Z",
      "updatedAt": "2025-09-03T02:32:14.313Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "521c17c2-5736-4ad7-98de-58a840f57696",
      "text": "bởi vì khắp hang cùng ngõ hẻm,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:14.327Z",
      "updatedAt": "2025-09-03T02:32:14.327Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "a842b58a-3e42-45eb-bf53-857a3b92cc26",
      "text": "chỉ thấy sào huyệt quân bạo tàn.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 2,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:14.340Z",
      "updatedAt": "2025-09-03T02:32:14.340Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "90ffc7e2-54c8-4c1e-8f6b-3ed85f9b8a39",
      "text": "Xin chớ để người bị áp bức phải ra về tủi hổ,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:14.354Z",
      "updatedAt": "2025-09-03T02:32:14.354Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "638c0866-7bf6-4352-abb2-089d9f69b532",
      "text": "nhưng xin cho kẻ nghèo người khổ được ca ngợi Thánh Danh.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:14.383Z",
      "updatedAt": "2025-09-03T02:32:14.383Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "da24048f-bcbc-4fb0-bbaf-2516a017b0c3",
      "text": "Lạy Thiên Chúa, xin đứng lên biện hộ cho Ngài ;",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:14.398Z",
      "updatedAt": "2025-09-03T02:32:14.398Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "e99a6940-d680-4d33-ab6e-9de3d8079895",
      "text": "xin Chúa nhớ lại rằng :",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:14.411Z",
      "updatedAt": "2025-09-03T02:32:14.411Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "114c9f5c-0641-4ea1-a8e5-442b7b2cdd95",
      "text": "quân điên dại ngày ngày phỉ báng Chúa.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 2,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:14.426Z",
      "updatedAt": "2025-09-03T02:32:14.426Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "a2d45667-ec26-45f1-b932-73dfbcaee92b",
      "text": "Xin đừng quên tiếng kẻ thù Chúa hò la,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:14.440Z",
      "updatedAt": "2025-09-03T02:32:14.440Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    },
    {
      "id": "137fcbb2-79fe-4aea-b67d-80f95f19ebeb",
      "text": "tiếng quân địch thét gào vang lên mãi.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:14.464Z",
      "updatedAt": "2025-09-03T02:32:14.464Z",
      "chapterId": "8ef2236b-f286-40ce-a993-19957e570ca4"
    }
  ],
