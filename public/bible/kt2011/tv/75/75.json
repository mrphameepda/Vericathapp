{
  "chapter": {
    "id": "d52394d0-a2ef-45b9-94b0-5051e42aa99c",
    "number": 75,
    "createdAt": "2025-09-03T01:07:51.661Z",
    "updatedAt": "2025-09-03T01:07:51.661Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "14935ff2-fb3c-4459-9709-45ce61404011",
      "text": "*Phần ca trưởng. “Xin đừng phá đổ.” Thánh vịnh. Của ông A-xáp. Thánh ca.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:32:19.953Z",
      "updatedAt": "2025-09-03T02:32:19.953Z",
      "chapterId": "d52394d0-a2ef-45b9-94b0-5051e42aa99c"
    },
    {
      "id": "a0a36ea1-d09d-4e4d-a784-1377c89f72b5",
      "text": "Lạy Thiên Chúa, chúng con xin tạ ơn Ngài,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:20.006Z",
      "updatedAt": "2025-09-03T02:32:20.006Z",
      "chapterId": "d52394d0-a2ef-45b9-94b0-5051e42aa99c"
    },
    {
      "id": "d1c4d2aa-adc3-4f5a-9b32-d23ba85066f4",
      "text": "tạ ơn Ngài và cầu khẩn Thánh Danh,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:20.019Z",
      "updatedAt": "2025-09-03T02:32:20.019Z",
      "chapterId": "d52394d0-a2ef-45b9-94b0-5051e42aa99c"
    },
    {
      "id": "532be188-526c-468f-8696-cf6b077bfbad",
      "text": "kỳ công Ngài, chúng con xin kể lại.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:20.033Z",
      "updatedAt": "2025-09-03T02:32:20.033Z",
      "chapterId": "d52394d0-a2ef-45b9-94b0-5051e42aa99c"
    },
    {
      "id": "67e038c8-f40a-40f5-a2d2-5f0ad91995a4",
      "text": "Chúa phán : “Vào thời Ta ấn định, Ta sẽ xử công minh.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:20.046Z",
      "updatedAt": "2025-09-03T02:32:20.046Z",
      "chapterId": "d52394d0-a2ef-45b9-94b0-5051e42aa99c"
    },
    {
      "id": "5e6fedf3-5329-4675-bf1f-25e4cadb77b3",
      "text": "Mặt đất cùng toàn thể dân cư, dù rung chuyển,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:20.060Z",
      "updatedAt": "2025-09-03T02:32:20.060Z",
      "chapterId": "d52394d0-a2ef-45b9-94b0-5051e42aa99c"
    },
    {
      "id": "924d1266-541a-464b-91c7-09c9bb013548",
      "text": "chính Ta đã làm cho cột trụ nó vững rồi.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:20.074Z",
      "updatedAt": "2025-09-03T02:32:20.074Z",
      "chapterId": "d52394d0-a2ef-45b9-94b0-5051e42aa99c"
    },
    {
      "id": "52139620-809f-4dcb-8b20-757c9b3e6a3d",
      "text": "Ta bảo lũ kiêu căng : ‘Đừng kiêu ngạo !’",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:20.088Z",
      "updatedAt": "2025-09-03T02:32:20.088Z",
      "chapterId": "d52394d0-a2ef-45b9-94b0-5051e42aa99c"
    },
    {
      "id": "3f54bd2b-804f-457b-925b-efb404c35395",
      "text": "Bảo phường tội lỗi : ‘Chớ dương oai !",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:20.102Z",
      "updatedAt": "2025-09-03T02:32:20.102Z",
      "chapterId": "d52394d0-a2ef-45b9-94b0-5051e42aa99c"
    },
    {
      "id": "f7240fbb-8b63-4afb-b47d-0b793575ee6d",
      "text": "Này chớ dương oai ngạo với Trời,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:20.116Z",
      "updatedAt": "2025-09-03T02:32:20.116Z",
      "chapterId": "d52394d0-a2ef-45b9-94b0-5051e42aa99c"
    },
    {
      "id": "368d2487-9510-4e78-a56f-d10edb7fd38c",
      "text": "ăn nói ngang tàng khinh cả Chúa’.”",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:20.130Z",
      "updatedAt": "2025-09-03T02:32:20.130Z",
      "chapterId": "d52394d0-a2ef-45b9-94b0-5051e42aa99c"
    },
    {
      "id": "b722a12b-983b-46c8-b9a9-8dd52a91cd37",
      "text": "Vì chẳng có chi tự đông đoài hay sa mạc",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:20.158Z",
      "updatedAt": "2025-09-03T02:32:20.158Z",
      "chapterId": "d52394d0-a2ef-45b9-94b0-5051e42aa99c"
    },
    {
      "id": "51cf0685-d78d-4a2e-8b74-83d69bbd216a",
      "text": "làm cho ai được cất nhắc lên.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:20.173Z",
      "updatedAt": "2025-09-03T02:32:20.173Z",
      "chapterId": "d52394d0-a2ef-45b9-94b0-5051e42aa99c"
    },
    {
      "id": "b66c4419-9096-4402-9480-f9f8292726ee",
      "text": "Chỉ Thiên Chúa mới là thẩm phán,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:20.186Z",
      "updatedAt": "2025-09-03T02:32:20.186Z",
      "chapterId": "d52394d0-a2ef-45b9-94b0-5051e42aa99c"
    },
    {
      "id": "0c51731f-7329-46c5-b06d-253ff5f81d68",
      "text": "Chúa hạ bệ người này, cất nhắc kẻ kia.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:20.200Z",
      "updatedAt": "2025-09-03T02:32:20.200Z",
      "chapterId": "d52394d0-a2ef-45b9-94b0-5051e42aa99c"
    },
    {
      "id": "1464d8fb-bbed-4064-bf67-501135f1d73b",
      "text": "Vì này tay CHÚA cầm chén rượu,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:20.228Z",
      "updatedAt": "2025-09-03T02:32:20.228Z",
      "chapterId": "d52394d0-a2ef-45b9-94b0-5051e42aa99c"
    },
    {
      "id": "2dfb271b-666f-4ee4-baef-28ba47a9ca17",
      "text": "chén rượu đầy mùi vị đắng cay,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:20.271Z",
      "updatedAt": "2025-09-03T02:32:20.271Z",
      "chapterId": "d52394d0-a2ef-45b9-94b0-5051e42aa99c"
    },
    {
      "id": "cd03dfe4-a99a-479a-b045-fd1d45d943d9",
      "text": "rót cho bọn gian ác trên đời,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:20.285Z",
      "updatedAt": "2025-09-03T02:32:20.285Z",
      "chapterId": "d52394d0-a2ef-45b9-94b0-5051e42aa99c"
    },
    {
      "id": "d5f50fbb-704c-4e09-b210-a98f18ad5376",
      "text": "tất cả đều phải uống, uống không chừa cặn.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 3,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:20.299Z",
      "updatedAt": "2025-09-03T02:32:20.299Z",
      "chapterId": "d52394d0-a2ef-45b9-94b0-5051e42aa99c"
    },
    {
      "id": "6ff0754c-340d-4e01-bbd8-3b45e7903bde",
      "text": "Phần tôi đây, sẽ hoan hỷ muôn đời",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:20.313Z",
      "updatedAt": "2025-09-03T02:32:20.313Z",
      "chapterId": "d52394d0-a2ef-45b9-94b0-5051e42aa99c"
    },
    {
      "id": "0be849c5-7f28-42e5-831a-ebada2b8f19b",
      "text": "và đàn ca kính Chúa nhà Gia-cóp.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:20.327Z",
      "updatedAt": "2025-09-03T02:32:20.327Z",
      "chapterId": "d52394d0-a2ef-45b9-94b0-5051e42aa99c"
    },
    {
      "id": "9817cde6-ba85-4058-ac01-eeac73067ba6",
      "text": "Tôi sẽ đập tan uy quyền kẻ dữ,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:20.356Z",
      "updatedAt": "2025-09-03T02:32:20.356Z",
      "chapterId": "d52394d0-a2ef-45b9-94b0-5051e42aa99c"
    },
    {
      "id": "70ecfea8-3588-497a-8530-9870d4582743",
      "text": "còn uy thế người lành sẽ được nâng cao.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:20.370Z",
      "updatedAt": "2025-09-03T02:32:20.370Z",
      "chapterId": "d52394d0-a2ef-45b9-94b0-5051e42aa99c"
    }
  ],
  "marks": [
    {
      "id": "7ea035b7-1261-4f0e-abde-4e83ba45ed06",
      "content": "Đây là *một thánh thi* ca ngợi Thiên Chúa là Thẩm Phán công minh. Thánh thi này gồm các phần sau đây : **1**) Nhập đề (c.2) ; **2**) Sấm ngôn của Thiên Chúa (cc. 3-6) ; **3**) Thiên Chúa hành quyền xét xử mọi người (cc. 7-9) ; **4**) Ca ngợi Thiên Chúa nhà Gia-cóp (cc. 10-11).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 44,
      "endOffset": 44,
      "createdAt": "2025-09-03T02:32:19.974Z",
      "updatedAt": "2025-09-03T02:32:19.974Z",
