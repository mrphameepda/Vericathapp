{
  "chapter": {
    "id": "bc2d8955-646d-4c8d-9e4b-f04997f2ab92",
    "number": 76,
    "createdAt": "2025-09-03T01:07:51.661Z",
    "updatedAt": "2025-09-03T01:07:51.661Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "771564a1-d3f2-46b6-be7b-54729632fccc",
      "text": "*Phần ca trưởng. Theo huyền cầm. Thánh vịnh. Của ông A-xáp. Thánh ca.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:32:25.950Z",
      "updatedAt": "2025-09-03T02:32:25.950Z",
      "chapterId": "bc2d8955-646d-4c8d-9e4b-f04997f2ab92"
    },
    {
      "id": "06af54ef-31b0-4fde-8b1d-e1decdeeefb5",
      "text": "Miền Giu-đa nức tiếng Chúa Trời,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:26Z",
      "updatedAt": "2025-09-03T02:32:26Z",
      "chapterId": "bc2d8955-646d-4c8d-9e4b-f04997f2ab92"
    },
    {
      "id": "0fe1f699-0db0-4f01-9509-c57e8dcf390f",
      "text": "tại Ít-ra-en, danh Người cao cả.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:26.026Z",
      "updatedAt": "2025-09-03T02:32:26.026Z",
      "chapterId": "bc2d8955-646d-4c8d-9e4b-f04997f2ab92"
    },
    {
      "id": "a4bcd3d8-33c0-454e-8b34-a408c5cea46b",
      "text": "Chúa đã cắm lều ở Sa-lem, núi Xi-on là nơi Chúa ngự.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:26.053Z",
      "updatedAt": "2025-09-03T02:32:26.053Z",
      "chapterId": "bc2d8955-646d-4c8d-9e4b-f04997f2ab92"
    },
    {
      "id": "687b7c38-ca0b-4145-8884-e05d22a33d75",
      "text": "Chính tại đó, Người bẻ gãy cung tên,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:26.109Z",
      "updatedAt": "2025-09-03T02:32:26.109Z",
      "chapterId": "bc2d8955-646d-4c8d-9e4b-f04997f2ab92"
    },
    {
      "id": "0ea9418f-a698-4a05-900d-1f71dedecd92",
      "text": "khiên mộc gươm đao, mọi vũ khí.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:26.122Z",
      "updatedAt": "2025-09-03T02:32:26.122Z",
      "chapterId": "bc2d8955-646d-4c8d-9e4b-f04997f2ab92"
    },
    {
      "id": "904c75ce-7678-4833-8f9e-54c86f86f607",
      "text": "Lạy Chúa, Ngài quả là lẫm liệt oai hùng,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:26.136Z",
      "updatedAt": "2025-09-03T02:32:26.136Z",
      "chapterId": "bc2d8955-646d-4c8d-9e4b-f04997f2ab92"
    },
    {
      "id": "e87608e6-3bbe-44a3-926e-f3a98163d163",
      "text": "vì chiến lợi phẩm thu về từng núi,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:26.150Z",
      "updatedAt": "2025-09-03T02:32:26.150Z",
      "chapterId": "bc2d8955-646d-4c8d-9e4b-f04997f2ab92"
    },
    {
      "id": "c020e42e-bb3b-42ad-9535-503afcc4341a",
      "text": "đoạt của lớp anh hùng mê mệt ngủ say",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:26.168Z",
      "updatedAt": "2025-09-03T02:32:26.168Z",
      "chapterId": "bc2d8955-646d-4c8d-9e4b-f04997f2ab92"
    },
    {
      "id": "caac54c6-1621-4bc8-8de3-17dc1028b1e5",
      "text": "và đoàn dũng sĩ cánh tay rời rã.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:26.196Z",
      "updatedAt": "2025-09-03T02:32:26.196Z",
      "chapterId": "bc2d8955-646d-4c8d-9e4b-f04997f2ab92"
    },
    {
      "id": "07cdc992-8bb4-4784-a996-16741bcf73c4",
      "text": "Lạy Chúa nhà Gia-cóp, Chúa thị uy",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:26.210Z",
      "updatedAt": "2025-09-03T02:32:26.210Z",
      "chapterId": "bc2d8955-646d-4c8d-9e4b-f04997f2ab92"
    },
    {
      "id": "32d2385a-6071-4123-afc0-872025900dfb",
      "text": "là ngựa xe đứng liền tại chỗ.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:26.239Z",
      "updatedAt": "2025-09-03T02:32:26.239Z",
      "chapterId": "bc2d8955-646d-4c8d-9e4b-f04997f2ab92"
    },
    {
      "id": "50d5097e-8caf-4929-b6a6-3a729a776a42",
      "text": "Quả thật Ngài đáng sợ !",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:26.253Z",
      "updatedAt": "2025-09-03T02:32:26.253Z",
      "chapterId": "bc2d8955-646d-4c8d-9e4b-f04997f2ab92"
    },
    {
      "id": "b7a5bb2c-3c62-4e7c-8b2c-4a5d91fbe9f0",
      "text": "Trong lúc Ngài nổi trận lôi đình,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:26.267Z",
      "updatedAt": "2025-09-03T02:32:26.267Z",
      "chapterId": "bc2d8955-646d-4c8d-9e4b-f04997f2ab92"
    },
    {
      "id": "10591b72-b29d-46e2-b4ad-e10133e21f37",
      "text": "nào ai đứng vững trước Thánh Nhan ?",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:26.281Z",
      "updatedAt": "2025-09-03T02:32:26.281Z",
      "chapterId": "bc2d8955-646d-4c8d-9e4b-f04997f2ab92"
    },
    {
      "id": "8918e6e4-01a5-418e-a25a-22329c26029b",
      "text": "Tự chốn trời cao, Ngài tuyên án :",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:26.295Z",
      "updatedAt": "2025-09-03T02:32:26.295Z",
      "chapterId": "bc2d8955-646d-4c8d-9e4b-f04997f2ab92"
    },
    {
      "id": "8d0cc364-2d44-41ed-93be-da67df643600",
      "text": "trái đất này kinh hãi lặng yên,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:26.308Z",
      "updatedAt": "2025-09-03T02:32:26.308Z",
      "chapterId": "bc2d8955-646d-4c8d-9e4b-f04997f2ab92"
    },
    {
      "id": "64f6160c-5c12-4f92-a777-8480b4983c5e",
      "text": "khi Chúa Trời đứng lên xét xử,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:26.323Z",
      "updatedAt": "2025-09-03T02:32:26.323Z",
      "chapterId": "bc2d8955-646d-4c8d-9e4b-f04997f2ab92"
    },
    {
      "id": "e9cb713b-5e0c-4e98-9102-aa64c5bd6e60",
      "text": "cứu mọi kẻ nghèo hèn chốn dương gian.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:26.336Z",
      "updatedAt": "2025-09-03T02:32:26.336Z",
      "chapterId": "bc2d8955-646d-4c8d-9e4b-f04997f2ab92"
    },
    {
      "id": "e7022470-8eba-4a92-b244-ea759480ba13",
      "text": "Cả cơn giận phàm nhân cũng thành lời ca tụng,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:26.365Z",
      "updatedAt": "2025-09-03T02:32:26.365Z",
      "chapterId": "bc2d8955-646d-4c8d-9e4b-f04997f2ab92"
    },
    {
      "id": "5c796cc2-d41c-4bc5-af53-ff118a0d7486",
      "text": "kẻ thoát lôi đình sẽ mở hội mừng Ngài.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:26.380Z",
      "updatedAt": "2025-09-03T02:32:26.380Z",
      "chapterId": "bc2d8955-646d-4c8d-9e4b-f04997f2ab92"
    },
    {
      "id": "baa47c14-802f-4674-b073-2bc2d5bd0c46",
      "text": "Hãy khấn nguyền và giữ y lời hứa",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:26.394Z",
      "updatedAt": "2025-09-03T02:32:26.394Z",
      "chapterId": "bc2d8955-646d-4c8d-9e4b-f04997f2ab92"
    },
    {
      "id": "db190dbf-e133-49cd-8b9b-5edc191f07b4",
      "text": "với CHÚA là Thiên Chúa các ngươi.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:26.408Z",
      "updatedAt": "2025-09-03T02:32:26.408Z",
      "chapterId": "bc2d8955-646d-4c8d-9e4b-f04997f2ab92"
    },
    {
      "id": "8bca6077-7c47-4cb2-81d3-4955a33460a9",
      "text": "Kẻ hầu cận Đấng khả tôn khả uý",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:26.422Z",
      "updatedAt": "2025-09-03T02:32:26.422Z",
      "chapterId": "bc2d8955-646d-4c8d-9e4b-f04997f2ab92"
    },
    {
      "id": "0b8af881-98ed-4bf7-a7b1-548de671997d",
      "text": "hãy đem lễ vật tiến dâng Người.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 3,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:26.436Z",
      "updatedAt": "2025-09-03T02:32:26.436Z",
      "chapterId": "bc2d8955-646d-4c8d-9e4b-f04997f2ab92"
    },
    {
      "id": "dccbea98-face-49c6-9009-a2d5033a2c3a",
      "text": "Người đập tan khí thế bao thủ lãnh,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:26.450Z",
      "updatedAt": "2025-09-03T02:32:26.450Z",
      "chapterId": "bc2d8955-646d-4c8d-9e4b-f04997f2ab92"
    },
    {
      "id": "6638abcb-96a5-4e98-8fc5-a84b6e55c1b7",
      "text": "gây kinh hoàng cho vua chúa trần gian.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:26.463Z",
      "updatedAt": "2025-09-03T02:32:26.463Z",
      "chapterId": "bc2d8955-646d-4c8d-9e4b-f04997f2ab92"
    }
  ],
  "marks": [
    {
      "id": "7395be07-9bf0-4691-b3d1-84b50ef43f58",
      "content": "Đây là *một* trong ba *Tv về Xi-on* thuộc tập III (Tv 84 và Tv 87). Tv này ca ngợi, tạ ơn Thiên Chúa sau một cuộc chiến thắng (cc. 4-8). Có thể đó là cuộc chiến thắng vua Át-sua là Xan-khê-ríp ở Giê-ru-sa-lem vào năm 701 tCN (x. 2 V 19,35). Lời tạ ơn dâng lên Thiên Chúa là Đấng đứng lên xét xử, tuyên án ... để *cứu mọi kẻ nghèo hèn* (cc. 9-10). Tv 76 chia làm bốn phần : **1**) Cc. 2-4 ; **2**) Cc. 5-7 ; **3**) Cc 8-10 ; **4**) Cc. 11-13.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 36,
      "endOffset": 36,
      "createdAt": "2025-09-03T02:32:25.978Z",
      "updatedAt": "2025-09-03T02:32:25.978Z",
      "targetId": "623e5821-96de-4ded-8ad3-3577d9428c3b",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "bc2d8955-646d-4c8d-9e4b-f04997f2ab92"
    },
