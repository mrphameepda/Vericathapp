    {
      "id": "b3119ca5-caeb-4f5e-94c8-8346925fc023",
      "content": "C.3a chỉ Đền Thờ Giê-ru-sa-lem.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "6",
      "sortOrder": 5,
      "startOffset": 24,
      "endOffset": 24,
      "createdAt": "2025-09-03T02:32:26.081Z",
      "updatedAt": "2025-09-03T02:32:26.081Z",
