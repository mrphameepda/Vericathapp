{
  "chapter": {
    "id": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0",
    "number": 77,
    "createdAt": "2025-09-03T01:07:51.661Z",
    "updatedAt": "2025-09-03T01:07:51.661Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "e32ba0aa-8e47-468c-9397-8fece4a40494",
      "text": "*Phần ca trưởng... Giơ-đu-thun. Của ông A-xáp. Thánh vịnh.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:32:31.940Z",
      "updatedAt": "2025-09-03T02:32:31.940Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    },
    {
      "id": "edc2dcfa-d98f-493d-9c39-cdc0e64f6fda",
      "text": "Tôi cất lời kêu lên cùng Chúa,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:32.012Z",
      "updatedAt": "2025-09-03T02:32:32.012Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    },
    {
      "id": "d6dfb40c-cfed-4bae-83dd-5af26dfbe5df",
      "text": "lời tôi kêu Chúa, xin Người lắng nghe.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:32.040Z",
      "updatedAt": "2025-09-03T02:32:32.040Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    },
    {
      "id": "e6568130-d6bb-4093-9bf5-1babd1a92c45",
      "text": "Ngày khốn quẫn, tôi tìm kiếm Chúa,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:32.054Z",
      "updatedAt": "2025-09-03T02:32:32.054Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    },
    {
      "id": "bd5579b2-5246-4d28-84ef-fc946ab65f40",
      "text": "tay vươn lên không biết mỏi lúc đêm trường,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:32.083Z",
      "updatedAt": "2025-09-03T02:32:32.083Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    },
    {
      "id": "f2d40246-8356-4f6b-b33b-52e12a345718",
      "text": "hồn tôi nào có thiết lời an ủi !",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:32.097Z",
      "updatedAt": "2025-09-03T02:32:32.097Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    },
    {
      "id": "cee6d05a-bb2c-4d8d-b021-fc3214998aaf",
      "text": "Tưởng nhớ Chúa, tôi thở vắn than dài,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:32.110Z",
      "updatedAt": "2025-09-03T02:32:32.110Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    },
    {
      "id": "d39189e1-3f61-4c60-8dd1-7fd43457c645",
      "text": "suy gẫm hoài nên khí lực tiêu hao.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:32.124Z",
      "updatedAt": "2025-09-03T02:32:32.124Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    },
    {
      "id": "e40014a7-f5c6-458c-8868-cbce90f70f8c",
      "text": "Lạy Chúa, Ngài không để con khép mi chợp mắt,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:32.138Z",
      "updatedAt": "2025-09-03T02:32:32.138Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    },
    {
      "id": "7b1015fe-12a8-48fe-b960-43ae75e79acb",
      "text": "lòng xao xuyến, con chẳng nói nên lời.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:32.152Z",
      "updatedAt": "2025-09-03T02:32:32.152Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    },
    {
      "id": "0ee325a5-04cc-4eab-8b99-a616edb21014",
      "text": "Hồi tưởng lại bao ngày xa cũ,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:32.166Z",
      "updatedAt": "2025-09-03T02:32:32.166Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    },
    {
      "id": "37be7d37-9804-4749-971d-972f4e1585a2",
      "text": "tâm hồn ấp ủ những năm xưa,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:32.193Z",
      "updatedAt": "2025-09-03T02:32:32.193Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    },
    {
      "id": "a6231776-1134-4a80-a6e8-4e7d1cea8f63",
      "text": "suốt canh khuya, trong dạ nhủ thầm,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:32.221Z",
      "updatedAt": "2025-09-03T02:32:32.221Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    },
    {
      "id": "bc9749c8-66d3-42e8-a3a5-fa70ff682208",
      "text": "và suy gẫm, trí lòng con tự hỏi :",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:32.235Z",
      "updatedAt": "2025-09-03T02:32:32.235Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    },
    {
      "id": "65e5012b-277e-49ee-8be0-03dc9444220c",
      "text": "Phải chăng Chúa ruồng bỏ đến muôn đời,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:32.250Z",
      "updatedAt": "2025-09-03T02:32:32.250Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    },
    {
      "id": "6f09d81e-f9d7-44c5-a381-0b38bba821ac",
      "text": "chẳng bao giờ còn rủ lòng thương đoái ?",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:32.264Z",
      "updatedAt": "2025-09-03T02:32:32.264Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    },
    {
      "id": "a006c469-aeef-42d4-af7f-83949dc2ff44",
      "text": "Tình yêu Chúa phải chăng nay cạn hẳn",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:32.277Z",
      "updatedAt": "2025-09-03T02:32:32.277Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    },
    {
      "id": "077b1dba-0eb5-43ba-a121-89ebcfbcde0b",
      "text": "và thánh ngôn chấm dứt đời đời ?",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:32.291Z",
      "updatedAt": "2025-09-03T02:32:32.291Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    },
    {
      "id": "77c6d1d1-51e8-4f00-9b38-bcfd143edbe4",
      "text": "Hay Thiên Chúa đã quên thương xót,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:32.305Z",
      "updatedAt": "2025-09-03T02:32:32.305Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    },
    {
      "id": "13e0fad6-f016-4f76-ae6c-8a9ef013a8ea",
      "text": "vì giận hờn mà khép kín từ tâm ?",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:32.320Z",
      "updatedAt": "2025-09-03T02:32:32.320Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    },
    {
      "id": "926e0cf1-e6cc-47d7-9bd0-152a456ee34f",
      "text": "Tôi tự bảo : điều làm tôi đau đớn",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:32.334Z",
      "updatedAt": "2025-09-03T02:32:32.334Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    },
    {
      "id": "e0e5fd9f-d525-4ef7-957d-ccf0ac1b56de",
      "text": "là Đấng Tối Cao chẳng còn ra tay nữa.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:32.348Z",
      "updatedAt": "2025-09-03T02:32:32.348Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    },
    {
      "id": "40643030-6de7-4d5b-8dd0-96aa352e1f8e",
      "text": "Lạy CHÚA, con tưởng nhớ bao việc Ngài làm,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:32.376Z",
      "updatedAt": "2025-09-03T02:32:32.376Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    },
    {
      "id": "a3e069dc-af4d-4a4f-b41d-60dc0025afba",
      "text": "tưởng nhớ những kỳ công thuở trước.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:32.390Z",
      "updatedAt": "2025-09-03T02:32:32.390Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    },
    {
      "id": "03c04c76-696b-4cb6-9024-4829af819f6c",
      "text": "Mọi hành động của Ngài, con nhẩm đi nhắc lại,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:32.404Z",
      "updatedAt": "2025-09-03T02:32:32.404Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    },
    {
      "id": "e7529c95-7649-4189-8106-1c3268520132",
      "text": "sự nghiệp Ngài, con sẽ gẫm suy.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:32.418Z",
      "updatedAt": "2025-09-03T02:32:32.418Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    },
    {
      "id": "04553fe4-9ccb-4c35-910c-dcd0f5cfc12a",
      "text": "Lạy Thiên Chúa, đường lối Ngài quả là thánh thiện,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:32.432Z",
      "updatedAt": "2025-09-03T02:32:32.432Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    },
    {
      "id": "453b3ea6-262c-43e5-9f5f-fa748b3cf386",
      "text": "có thần nào cao cả như Thiên Chúa ?",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:32.446Z",
      "updatedAt": "2025-09-03T02:32:32.446Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    },
    {
      "id": "bb7d748b-ab8c-4498-9f90-6cb7f20a8a5b",
      "text": "Chính Ngài là vị Thần thực hiện những kỳ công,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:32.459Z",
      "updatedAt": "2025-09-03T02:32:32.459Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    },
    {
      "id": "c72c259c-a42a-4c37-bd87-d95a3a860d92",
      "text": "biểu dương sức mạnh giữa muôn vàn dân nước.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:32.473Z",
      "updatedAt": "2025-09-03T02:32:32.473Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    },
    {
      "id": "adb732f6-9d1d-4d81-8d2f-507bbdd6acc5",
      "text": "Tay Chúa đã cứu chuộc dân Ngài",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:32.488Z",
      "updatedAt": "2025-09-03T02:32:32.488Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    },
    {
      "id": "d9cb1679-bc81-467e-928d-f1c28ed792f7",
      "text": "là giống nòi Gia-cóp và Giu-se.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:32.502Z",
      "updatedAt": "2025-09-03T02:32:32.502Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    },
    {
      "id": "c996aaa1-e582-42f8-bce0-9c21eb288743",
      "text": "Nước đã thấy Ngài, lạy Thiên Chúa,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:32.538Z",
      "updatedAt": "2025-09-03T02:32:32.538Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    },
    {
      "id": "9d494b8e-388c-46eb-b5db-dff24adcd18a",
      "text": "thấy Ngài, nước rùng mình khiếp sợ,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:32.561Z",
      "updatedAt": "2025-09-03T02:32:32.561Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    },
    {
      "id": "f981a425-2cc3-4fe6-8106-c68d62962660",
      "text": "cả vực sâu cũng run rẩy kinh hoàng.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 2,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:32.574Z",
      "updatedAt": "2025-09-03T02:32:32.574Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    },
    {
      "id": "a5a35e65-046b-4a83-a0de-5c5e142fc8c3",
      "text": "Mây tầng đổ mưa, mây tầng vang tiếng,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:32.587Z",
      "updatedAt": "2025-09-03T02:32:32.587Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    },
    {
      "id": "daeb4c08-6a41-4659-82ee-18834d7233c6",
      "text": "ngang dọc khắp trời, tên lửa Ngài bay.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:32.601Z",
      "updatedAt": "2025-09-03T02:32:32.601Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    },
    {
      "id": "3471862e-b379-4dae-b943-d24a65ef92ea",
      "text": "Tiếng sấm của Chúa ầm ầm vang dội,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
