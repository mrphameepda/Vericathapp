    },
    {
      "id": "1f75bd4c-8752-4375-b218-94468b033bb2",
      "text": "ánh chớp chói loà soi sáng thế gian,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:32.641Z",
      "updatedAt": "2025-09-03T02:32:32.641Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    },
    {
      "id": "000d04c8-0dfb-4f5b-8927-c353fbc36620",
      "text": "khắp địa cầu lung lay rung chuyển.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 2,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:32.655Z",
      "updatedAt": "2025-09-03T02:32:32.655Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    },
    {
      "id": "e3279779-6903-416b-ba52-fc0155e1e451",
      "text": "Đường của Chúa băng qua biển rộng,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:32.668Z",
      "updatedAt": "2025-09-03T02:32:32.668Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    },
    {
      "id": "fc8a5eb3-0a3d-4044-8a67-8756df016b90",
      "text": "lối của Ngài rẽ nước mênh mông,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:32.681Z",
      "updatedAt": "2025-09-03T02:32:32.681Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    },
    {
      "id": "5afe621d-7302-4329-890c-5ffbad6da852",
      "text": "mà chẳng ai nhận thấy vết chân Ngài.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 2,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:32.695Z",
      "updatedAt": "2025-09-03T02:32:32.695Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    },
    {
      "id": "b596faa0-2098-4a75-ac70-7dc2a56eec7d",
      "text": "Chúa dùng bàn tay của Mô-sê và A-ha-ron",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:32.708Z",
      "updatedAt": "2025-09-03T02:32:32.708Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    },
    {
      "id": "6fb7a0cb-8beb-408f-900b-b31b59dd5ce9",
      "text": "mà lãnh đạo dân riêng của Chúa,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:32.748Z",
      "updatedAt": "2025-09-03T02:32:32.748Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    },
    {
      "id": "a6d55dda-6559-4286-be7c-8b890ce9ad89",
      "text": "như dẫn dắt đoàn chiên.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 2,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:32.762Z",
      "updatedAt": "2025-09-03T02:32:32.762Z",
      "chapterId": "d8e876cb-c2c4-4dc6-8aa8-b975a75681b0"
    }
  ],
