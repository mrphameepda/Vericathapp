    },
    {
      "id": "0ea66c29-1b2b-463d-a9af-1e003307c689",
      "text": "Phần chúng con là dân của Ngài, đoàn chiên Ngài chăn dắt,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:48.150Z",
      "updatedAt": "2025-09-03T02:32:48.150Z",
      "chapterId": "8db90fed-0f3d-4451-8592-3c80d7e87598"
    },
    {
      "id": "33db9d24-300f-409a-bee3-38ddf51cabd3",
      "text": "chúng con sẽ tạ ơn Ngài mãi mãi",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:48.180Z",
      "updatedAt": "2025-09-03T02:32:48.180Z",
      "chapterId": "8db90fed-0f3d-4451-8592-3c80d7e87598"
    },
    {
      "id": "04b50aa0-35ec-446e-a831-2607beae54c4",
      "text": "và dâng lời ca tụng đến muôn thuở muôn đời.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:48.194Z",
