{
  "chapter": {
    "id": "8db90fed-0f3d-4451-8592-3c80d7e87598",
    "number": 79,
    "createdAt": "2025-09-03T01:07:51.661Z",
    "updatedAt": "2025-09-03T01:07:51.661Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "1e034c61-6566-47c8-ad9f-372f7d0f2136",
      "text": "*Thánh vịnh. Của ông A-xáp.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:32:47.351Z",
      "updatedAt": "2025-09-03T02:32:47.351Z",
      "chapterId": "8db90fed-0f3d-4451-8592-3c80d7e87598"
    },
    {
      "id": "5b1a48dd-6948-4925-8251-67ee64d98232",
      "text": "Lạy Thiên Chúa, dân ngoại đã xâm lăng lãnh địa Ngài ;",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:47.418Z",
      "updatedAt": "2025-09-03T02:32:47.418Z",
      "chapterId": "8db90fed-0f3d-4451-8592-3c80d7e87598"
    },
    {
      "id": "3a66ed31-943d-4d46-a811-cdabc07b28fc",
      "text": "chúng làm ô uế cả nơi thánh điện,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:47.432Z",
      "updatedAt": "2025-09-03T02:32:47.432Z",
      "chapterId": "8db90fed-0f3d-4451-8592-3c80d7e87598"
    },
    {
      "id": "7dd4a23f-aada-4887-a8d3-5b2a85ad5593",
      "text": "phá huỷ Giê-ru-sa-lem thành đống tro tàn ;",
      "label": "1",
      "number": 1,
      "subVerseIndex": 3,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:47.446Z",
      "updatedAt": "2025-09-03T02:32:47.446Z",
      "chapterId": "8db90fed-0f3d-4451-8592-3c80d7e87598"
    },
    {
      "id": "5b07c053-ad4e-4017-932e-2601d2165778",
      "text": "tử thi những người tôi tớ Chúa,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:47.474Z",
      "updatedAt": "2025-09-03T02:32:47.474Z",
      "chapterId": "8db90fed-0f3d-4451-8592-3c80d7e87598"
    },
    {
      "id": "11905129-2fc1-4298-beaf-cd17354806b7",
      "text": "chúng đem liệng cho chim trời ăn ;",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:47.502Z",
      "updatedAt": "2025-09-03T02:32:47.502Z",
      "chapterId": "8db90fed-0f3d-4451-8592-3c80d7e87598"
    },
    {
      "id": "df1979c9-e26e-4f0a-8877-69d754f14ecc",
      "text": "xác những kẻ hiếu trung với Ngài,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:47.517Z",
      "updatedAt": "2025-09-03T02:32:47.517Z",
      "chapterId": "8db90fed-0f3d-4451-8592-3c80d7e87598"
    },
    {
      "id": "47fae6f1-dfe5-487c-a49e-e01730324688",
      "text": "lại quẳng làm mồi cho dã thú.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 3,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:47.530Z",
      "updatedAt": "2025-09-03T02:32:47.530Z",
      "chapterId": "8db90fed-0f3d-4451-8592-3c80d7e87598"
    },
    {
      "id": "251eaf4e-654e-4176-8716-cd588e31e88e",
      "text": "Quanh khắp cả Giê-ru-sa-lem",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:47.544Z",
      "updatedAt": "2025-09-03T02:32:47.544Z",
      "chapterId": "8db90fed-0f3d-4451-8592-3c80d7e87598"
    },
    {
      "id": "11ca01cd-1de7-48e2-8d0b-d974f2c30ed6",
      "text": "chúng đổ máu dân Ngài như nước chảy,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:47.572Z",
      "updatedAt": "2025-09-03T02:32:47.572Z",
      "chapterId": "8db90fed-0f3d-4451-8592-3c80d7e87598"
    },
    {
      "id": "0a51761d-3a35-4c36-a2af-04cc65000efe",
      "text": "người chết chẳng ai chôn.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:47.586Z",
      "updatedAt": "2025-09-03T02:32:47.586Z",
      "chapterId": "8db90fed-0f3d-4451-8592-3c80d7e87598"
    },
    {
      "id": "f9f557ad-ce18-4b6c-965c-426d6f53678e",
      "text": "Chúng con bị láng giềng thoá mạ",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:47.601Z",
      "updatedAt": "2025-09-03T02:32:47.601Z",
      "chapterId": "8db90fed-0f3d-4451-8592-3c80d7e87598"
    },
    {
      "id": "85a5575c-010e-4863-bb5c-20263ae12027",
      "text": "người chung quanh phỉ báng nhạo cười.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:47.616Z",
      "updatedAt": "2025-09-03T02:32:47.616Z",
      "chapterId": "8db90fed-0f3d-4451-8592-3c80d7e87598"
    },
    {
      "id": "c37ad0c2-9c56-4517-9bae-40d8d3895a1f",
      "text": "Đến bao giờ, lạy CHÚA, Ngài còn nổi giận,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:47.644Z",
      "updatedAt": "2025-09-03T02:32:47.644Z",
      "chapterId": "8db90fed-0f3d-4451-8592-3c80d7e87598"
    },
    {
      "id": "f5feeed9-6591-4710-a1c3-e8db2a436bf0",
      "text": "Ngài nổi giận mãi sao ?",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:47.665Z",
      "updatedAt": "2025-09-03T02:32:47.665Z",
      "chapterId": "8db90fed-0f3d-4451-8592-3c80d7e87598"
    },
    {
      "id": "a3054a16-d826-40ae-bd40-f8f549a11500",
      "text": "Đến bao giờ lòng ghen còn cháy bừng như lửa ?",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:47.679Z",
      "updatedAt": "2025-09-03T02:32:47.679Z",
      "chapterId": "8db90fed-0f3d-4451-8592-3c80d7e87598"
    },
    {
      "id": "7a12cda7-6a75-467c-907c-34cd503bf5a3",
      "text": "Xin giáng trận lôi đình",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:47.706Z",
      "updatedAt": "2025-09-03T02:32:47.706Z",
      "chapterId": "8db90fed-0f3d-4451-8592-3c80d7e87598"
    },
    {
      "id": "cc54e46d-7093-4b6f-baf5-b84f90340a09",
      "text": "xuống đầu các dân ngoại đã không nhận biết Ngài,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:47.749Z",
      "updatedAt": "2025-09-03T02:32:47.749Z",
      "chapterId": "8db90fed-0f3d-4451-8592-3c80d7e87598"
    },
    {
      "id": "dc1f1aab-d290-4f2c-ba4e-3493531387f1",
      "text": "và trên các vương quốc chẳng kêu cầu Thánh Danh,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:47.764Z",
      "updatedAt": "2025-09-03T02:32:47.764Z",
      "chapterId": "8db90fed-0f3d-4451-8592-3c80d7e87598"
    },
    {
      "id": "bdbb401f-eef8-41a4-a6dc-7c6cf6c7b42e",
      "text": "vì chúng đã tiêu diệt nhà Gia-cóp,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:47.778Z",
      "updatedAt": "2025-09-03T02:32:47.778Z",
      "chapterId": "8db90fed-0f3d-4451-8592-3c80d7e87598"
    },
    {
      "id": "03369e8b-fe0e-4bd3-8015-2d1320371ce6",
      "text": "tàn phá cả đất đai.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:47.806Z",
      "updatedAt": "2025-09-03T02:32:47.806Z",
      "chapterId": "8db90fed-0f3d-4451-8592-3c80d7e87598"
    },
    {
      "id": "f9aa201d-d017-4296-affd-ec915168adf9",
      "text": "Tội tiền nhân, xin Chúa đừng nhớ mãi",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:47.820Z",
      "updatedAt": "2025-09-03T02:32:47.820Z",
      "chapterId": "8db90fed-0f3d-4451-8592-3c80d7e87598"
    },
    {
      "id": "acb57f5b-0bd5-445d-b2e9-898524c4536b",
      "text": "mà trừng phạt chúng con.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:47.833Z",
      "updatedAt": "2025-09-03T02:32:47.833Z",
      "chapterId": "8db90fed-0f3d-4451-8592-3c80d7e87598"
    },
    {
      "id": "d5d99de9-4827-45ac-af1d-136eb2d6fb1d",
      "text": "Xin rủ lòng thương mau đến giúp,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:47.847Z",
      "updatedAt": "2025-09-03T02:32:47.847Z",
      "chapterId": "8db90fed-0f3d-4451-8592-3c80d7e87598"
    },
    {
      "id": "0cb42c40-a727-406e-81cc-82c0cd5ce19f",
      "text": "vì chúng con đã khổ quá nhiều.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 3,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:47.875Z",
      "updatedAt": "2025-09-03T02:32:47.875Z",
      "chapterId": "8db90fed-0f3d-4451-8592-3c80d7e87598"
    },
    {
      "id": "bb581927-f349-48ef-bde7-74b95832b0a8",
      "text": "Lạy Chúa Trời, Đấng cứu độ chúng con,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:47.889Z",
      "updatedAt": "2025-09-03T02:32:47.889Z",
      "chapterId": "8db90fed-0f3d-4451-8592-3c80d7e87598"
    },
    {
      "id": "1f1db4ec-a036-4bc5-a37c-c6511308c0d1",
      "text": "xin Ngài thương phù trợ, để danh Ngài rạng rỡ.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:47.903Z",
      "updatedAt": "2025-09-03T02:32:47.903Z",
      "chapterId": "8db90fed-0f3d-4451-8592-3c80d7e87598"
    },
    {
      "id": "bdf95ffe-6e52-44c8-bb11-e6b80776f31e",
      "text": "Xin giải thoát chúng con, và thứ tha tội lỗi,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:47.916Z",
      "updatedAt": "2025-09-03T02:32:47.916Z",
      "chapterId": "8db90fed-0f3d-4451-8592-3c80d7e87598"
    },
    {
      "id": "e610cb2e-5c54-4376-a0c3-b3bff384598a",
      "text": "vì danh dự của Ngài.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 3,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:47.945Z",
      "updatedAt": "2025-09-03T02:32:47.945Z",
      "chapterId": "8db90fed-0f3d-4451-8592-3c80d7e87598"
    },
    {
      "id": "8e737bc2-20b5-4b60-980a-63ae6875b20f",
      "text": "Sao Ngài để cho dân ngoại nói :",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:47.976Z",
      "updatedAt": "2025-09-03T02:32:47.976Z",
      "chapterId": "8db90fed-0f3d-4451-8592-3c80d7e87598"
    },
    {
      "id": "201ee975-4a4a-4e98-8ae2-aa999b08bd62",
      "text": "“Thiên Chúa chúng ở đâu ?”",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:47.990Z",
      "updatedAt": "2025-09-03T02:32:47.990Z",
      "chapterId": "8db90fed-0f3d-4451-8592-3c80d7e87598"
    },
    {
      "id": "685ba040-8b8d-4766-ad25-71080fb6a86e",
      "text": "Ước gì chúng con thấy nhãn tiền :",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:48.018Z",
      "updatedAt": "2025-09-03T02:32:48.018Z",
      "chapterId": "8db90fed-0f3d-4451-8592-3c80d7e87598"
    },
    {
      "id": "69e00b3b-4e32-4afc-9660-f4cf09cd6647",
      "text": "Ngài làm cho chư dân nhận biết",
      "label": "10",
      "number": 10,
      "subVerseIndex": 3,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:48.032Z",
      "updatedAt": "2025-09-03T02:32:48.032Z",
      "chapterId": "8db90fed-0f3d-4451-8592-3c80d7e87598"
    },
    {
      "id": "6e82af4b-d4fa-4f8e-8dac-fd64fe6c9d75",
      "text": "rằng chúng phải đền nợ máu tôi tớ Ngài,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 4,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:48.049Z",
      "updatedAt": "2025-09-03T02:32:48.049Z",
      "chapterId": "8db90fed-0f3d-4451-8592-3c80d7e87598"
    },
    {
      "id": "2a17a756-3374-48f8-abcc-639cac8038ed",
      "text": "máu chúng đã đổ ra.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 5,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:48.066Z",
      "updatedAt": "2025-09-03T02:32:48.066Z",
      "chapterId": "8db90fed-0f3d-4451-8592-3c80d7e87598"
    },
    {
      "id": "042e8490-6c55-4853-8187-fc2eee045c80",
      "text": "Ước gì tiếng tù nhân rên siết vọng lên thấu tai Ngài.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:48.081Z",
      "updatedAt": "2025-09-03T02:32:48.081Z",
      "chapterId": "8db90fed-0f3d-4451-8592-3c80d7e87598"
    },
    {
      "id": "1f17c3e4-3474-4a2b-9f50-7c78e994a63d",
      "text": "Xin giơ tay hùng mạnh cứu sống những người mang án tử.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:48.095Z",
      "updatedAt": "2025-09-03T02:32:48.095Z",
      "chapterId": "8db90fed-0f3d-4451-8592-3c80d7e87598"
    },
    {
      "id": "78af4840-9fe3-4009-b4f5-7648c247cd8d",
      "text": "Lạy Chúa, kẻ láng giềng chúng con đã lăng nhục Chúa,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:48.122Z",
      "updatedAt": "2025-09-03T02:32:48.122Z",
      "chapterId": "8db90fed-0f3d-4451-8592-3c80d7e87598"
    },
    {
      "id": "af19e83b-2ca0-41bf-b754-005702c73a14",
      "text": "xin trả báo cho bản thân chúng gấp bảy lần.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
