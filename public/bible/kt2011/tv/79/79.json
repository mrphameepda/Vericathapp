    {
      "id": "31ada260-f694-4956-a6a7-c83118bf2341",
      "content": "Tác giả Tv vừa công nhận đoàn dân hiện tại là thế hệ tội lỗi, vừa ý thức rằng hoàn cảnh bi đát hiện nay cũng là hậu quả của quá khứ (c.8 : *tội tiền nhân*).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "12",
      "sortOrder": 11,
      "startOffset": 19,
      "endOffset": 19,
      "createdAt": "2025-09-03T02:32:47.962Z",
      "updatedAt": "2025-09-03T02:32:47.962Z",
      "targetId": "e610cb2e-5c54-4376-a0c3-b3bff384598a",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "8db90fed-0f3d-4451-8592-3c80d7e87598"
    },
    {
      "id": "84d60243-b0a5-4cf6-8a98-dc5580f47b14",
      "content": "Đây thường là lý do nêu lên để xin Thiên Chúa can thiệp (x. Tv 42,4.11 ; 115,2).",
