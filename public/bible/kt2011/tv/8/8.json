{
  "chapter": {
    "id": "0e7e8a77-4a56-4396-a11e-e3be53c8fb04",
    "number": 8,
    "createdAt": "2025-09-03T01:07:51.660Z",
    "updatedAt": "2025-09-03T01:07:51.660Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "f516806d-985c-4865-843f-7418ffd13712",
      "text": "*Phần ca trưởng. Có hoạ đàn thành Gát. Thánh vịnh. Của vua Đa-vít.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:25:19.717Z",
      "updatedAt": "2025-09-03T02:25:19.717Z",
      "chapterId": "0e7e8a77-4a56-4396-a11e-e3be53c8fb04"
    },
    {
      "id": "f637ce04-2835-4245-9926-bbbb9af43046",
      "text": "Lạy ĐỨC CHÚA là Chúa chúng con,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:19.789Z",
      "updatedAt": "2025-09-03T02:25:19.789Z",
      "chapterId": "0e7e8a77-4a56-4396-a11e-e3be53c8fb04"
    },
    {
      "id": "e41bfcf4-9a43-4d3d-bae0-f6bbc0754a35",
      "text": "lẫy lừng thay danh Chúa trên khắp cả địa cầu !",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:19.809Z",
      "updatedAt": "2025-09-03T02:25:19.809Z",
      "chapterId": "0e7e8a77-4a56-4396-a11e-e3be53c8fb04"
    },
    {
      "id": "9bb59a6c-564a-448f-a03a-ff94666f2c67",
      "text": "Uy phong Ngài vượt quá trời cao.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:19.820Z",
      "updatedAt": "2025-09-03T02:25:19.820Z",
      "chapterId": "0e7e8a77-4a56-4396-a11e-e3be53c8fb04"
    },
    {
      "id": "e1173146-977c-4705-b974-a7ab443f8d43",
      "text": "Ngài cho miệng con thơ trẻ nhỏ",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:19.830Z",
      "updatedAt": "2025-09-03T02:25:19.830Z",
      "chapterId": "0e7e8a77-4a56-4396-a11e-e3be53c8fb04"
    },
    {
      "id": "684695e1-fbd0-4804-9409-2732adf3472c",
      "text": "cất tiếng ngợi khen đối lại địch thù,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:19.841Z",
      "updatedAt": "2025-09-03T02:25:19.841Z",
      "chapterId": "0e7e8a77-4a56-4396-a11e-e3be53c8fb04"
    },
    {
      "id": "e36aed04-be3c-47a9-ba65-b4cef3653a36",
      "text": "khiến kẻ thù quân nghịch phải tiêu tan.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:19.865Z",
      "updatedAt": "2025-09-03T02:25:19.865Z",
      "chapterId": "0e7e8a77-4a56-4396-a11e-e3be53c8fb04"
    },
    {
      "id": "07d9f8aa-65d1-4a94-8af3-e8ed15067725",
      "text": "Ngắm tầng trời tay Chúa sáng tạo,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:19.882Z",
      "updatedAt": "2025-09-03T02:25:19.882Z",
      "chapterId": "0e7e8a77-4a56-4396-a11e-e3be53c8fb04"
    },
    {
      "id": "ac493497-feaa-45b9-9f30-e31f69b8d0b4",
      "text": "muôn trăng sao Chúa đã an bài,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:19.893Z",
      "updatedAt": "2025-09-03T02:25:19.893Z",
      "chapterId": "0e7e8a77-4a56-4396-a11e-e3be53c8fb04"
    },
    {
      "id": "51dc3e4b-9336-4940-ad33-a009bed5cb78",
      "text": "thì con người là chi, mà Chúa cần nhớ đến,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:19.905Z",
      "updatedAt": "2025-09-03T02:25:19.905Z",
      "chapterId": "0e7e8a77-4a56-4396-a11e-e3be53c8fb04"
    },
    {
      "id": "b5cb0c2d-0cda-48c2-8ee5-44c1636d9ede",
      "text": "phàm nhân là gì, mà Chúa phải bận tâm ?",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:19.920Z",
      "updatedAt": "2025-09-03T02:25:19.920Z",
      "chapterId": "0e7e8a77-4a56-4396-a11e-e3be53c8fb04"
    },
    {
      "id": "abc38a86-1219-4eda-8b33-3c681ab2627f",
      "text": "Chúa cho con người chẳng thua kém thần linh là mấy,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:19.944Z",
      "updatedAt": "2025-09-03T02:25:19.944Z",
      "chapterId": "0e7e8a77-4a56-4396-a11e-e3be53c8fb04"
    },
    {
      "id": "af1a8d63-848e-48b9-8fcc-b7c8c575a8de",
      "text": "ban vinh quang danh dự làm mũ triều thiên,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:19.971Z",
      "updatedAt": "2025-09-03T02:25:19.971Z",
      "chapterId": "0e7e8a77-4a56-4396-a11e-e3be53c8fb04"
    },
    {
      "id": "add0449a-fb4e-4b56-ab0c-a6aa39439dfc",
      "text": "cho làm chủ công trình tay Chúa sáng tạo,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:19.983Z",
      "updatedAt": "2025-09-03T02:25:19.983Z",
      "chapterId": "0e7e8a77-4a56-4396-a11e-e3be53c8fb04"
    },
    {
      "id": "ea80d3f6-6791-4c96-b847-db12771d78d5",
      "text": "đặt muôn loài muôn sự dưới chân :",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:19.995Z",
      "updatedAt": "2025-09-03T02:25:19.995Z",
      "chapterId": "0e7e8a77-4a56-4396-a11e-e3be53c8fb04"
    },
    {
      "id": "bcfc42f8-4627-4488-abf1-77c2cadfbd9c",
      "text": "Nào chiên bò đủ loại, nào thú vật ngoài đồng,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:20.006Z",
      "updatedAt": "2025-09-03T02:25:20.006Z",
      "chapterId": "0e7e8a77-4a56-4396-a11e-e3be53c8fb04"
    },
    {
      "id": "69940f47-8143-4941-b630-bfc479903454",
      "text": "nào chim trời cá biển, mọi loài ngang dọc khắp trùng dương.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:20.018Z",
      "updatedAt": "2025-09-03T02:25:20.018Z",
      "chapterId": "0e7e8a77-4a56-4396-a11e-e3be53c8fb04"
    },
    {
      "id": "9c92e439-d330-427a-b6a3-ae11fcfd1973",
      "text": "Lạy ĐỨC CHÚA là Chúa chúng con,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:20.041Z",
      "updatedAt": "2025-09-03T02:25:20.041Z",
      "chapterId": "0e7e8a77-4a56-4396-a11e-e3be53c8fb04"
    },
    {
      "id": "d5875c07-040a-433a-aff4-4e5052acfe7d",
      "text": "lẫy lừng thay danh Chúa trên khắp cả địa cầu !",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:20.064Z",
      "updatedAt": "2025-09-03T02:25:20.064Z",
      "chapterId": "0e7e8a77-4a56-4396-a11e-e3be53c8fb04"
    }
  ],
