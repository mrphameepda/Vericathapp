      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "562cf15d-1a9f-4201-96bd-42994ae9db0a",
      "content": "English: Gog | French: Gog | Latin: Gog | Origin: &#1490;&#1468;&#64331;&#1490; | Vietnamese: Gốc 1 -- một người Rưu-vên dòng dõi ông Giô-ên, 1 Sb 5,4",
