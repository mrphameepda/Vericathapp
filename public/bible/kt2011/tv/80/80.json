{
  "chapter": {
    "id": "11d41876-f1ea-4c63-9744-ec03cc370de8",
    "number": 80,
    "createdAt": "2025-09-03T01:07:51.661Z",
    "updatedAt": "2025-09-03T01:07:51.661Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "b1b0266b-365b-4a50-82c9-1b865c113975",
      "text": "*Phần ca trưởng. Theo điệu : Bông huệ chứng ước. Của ông A-xáp. Thánh vịnh.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:32:53.630Z",
      "updatedAt": "2025-09-03T02:32:53.630Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "66be0544-636a-41bd-a5b8-13ec86913a91",
      "text": "Lạy Mục Tử nhà Ít-ra-en,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:53.688Z",
      "updatedAt": "2025-09-03T02:32:53.688Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "7ecec9c4-f971-44d4-a599-33aa976b94d4",
      "text": "Ngài là Đấng chăn giữ nhà Giu-se",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:53.716Z",
      "updatedAt": "2025-09-03T02:32:53.716Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "334e5162-970c-47cc-a69f-9984ee780509",
      "text": "như chăn giữ chiên cừu, xin hãy lắng tai nghe !",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:53.744Z",
      "updatedAt": "2025-09-03T02:32:53.744Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "ee546523-3191-41d4-bcd0-f939d3057962",
      "text": "Ngài là Đấng ngự trên các Kê-ru-bim,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 3,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:53.759Z",
      "updatedAt": "2025-09-03T02:32:53.759Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "28e2a9b5-880d-407b-993b-3a5ac0bca007",
      "text": "xin giãi sáng hiển linh cho dòng dõi Ép-ra-im,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:53.772Z",
      "updatedAt": "2025-09-03T02:32:53.772Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "ded16117-e20a-44ba-a012-d33cdb5a68f9",
      "text": "Ben-gia-min và Mơ-na-se được thấy.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:53.801Z",
      "updatedAt": "2025-09-03T02:32:53.801Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "e824c75d-becc-4290-a10c-743c23b70775",
      "text": "Xin khơi dậy uy dũng của Ngài,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:53.858Z",
      "updatedAt": "2025-09-03T02:32:53.858Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "36f0d765-9c67-4049-877c-9ee7ae6624fa",
      "text": "đến cùng chúng con và thương cứu độ.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 3,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:53.888Z",
      "updatedAt": "2025-09-03T02:32:53.888Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "54295736-a861-4301-ae40-896f1b79ce55",
      "text": "Lạy Thiên Chúa, xin phục hồi chúng con,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:53.902Z",
      "updatedAt": "2025-09-03T02:32:53.902Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "afa86bf2-13c7-494e-908c-b4d4e6c3f248",
      "text": "xin toả ánh tôn nhan rạng ngời",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:53.915Z",
      "updatedAt": "2025-09-03T02:32:53.915Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "6626eaf2-977b-4755-9b86-0b236b14520b",
      "text": "để chúng con được ơn cứu độ.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:53.930Z",
      "updatedAt": "2025-09-03T02:32:53.930Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "5750349b-5190-4aab-929b-1f1e869554b2",
      "text": "Lạy CHÚA là Chúa Tể càn khôn,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:53.943Z",
      "updatedAt": "2025-09-03T02:32:53.943Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "402e32f4-a8dc-479f-9291-f368fde3a1ad",
      "text": "đến khi nao Chúa còn nóng giận,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:53.957Z",
      "updatedAt": "2025-09-03T02:32:53.957Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "bd0a7f0e-2cb2-4f90-a8cc-80d8db1d0d5d",
      "text": "chẳng màng chi lời dân Chúa nguyện cầu ?",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:53.971Z",
      "updatedAt": "2025-09-03T02:32:53.971Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "8544fe63-6afa-4203-a1a1-8c11545add80",
      "text": "Cơm Ngài cho ăn chỉ là châu luỵ,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:53.986Z",
      "updatedAt": "2025-09-03T02:32:53.986Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "172ffaf1-b99c-41e7-9d14-8ac846b1083b",
      "text": "nước Ngài cho uống là suối lệ chứa chan.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:54Z",
      "updatedAt": "2025-09-03T02:32:54Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "a3ae38ff-dec8-4108-b034-d91cfc770690",
      "text": "Ngài đã khiến chúng con thành cớ",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:54.026Z",
      "updatedAt": "2025-09-03T02:32:54.026Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "adeb8857-3153-4372-8f3b-73a29d1e6cb4",
      "text": "cho lân bang cãi cọ tranh giành,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:54.038Z",
      "updatedAt": "2025-09-03T02:32:54.038Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "05040019-5e11-4ac0-9002-e1592f1c2b76",
      "text": "cho thù địch nhạo cười chế giễu.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:54.062Z",
      "updatedAt": "2025-09-03T02:32:54.062Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "6459f520-543c-49d0-939f-87de88e46a90",
      "text": "Lạy Chúa Tể càn khôn, xin phục hồi chúng con,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:54.091Z",
      "updatedAt": "2025-09-03T02:32:54.091Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "45d9f307-9192-436a-8bcc-d86884b7c279",
      "text": "xin toả ánh tôn nhan rạng ngời",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:54.104Z",
      "updatedAt": "2025-09-03T02:32:54.104Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "3aa85284-fd9d-4b75-aac6-6e980048a4a7",
      "text": "để chúng con được ơn cứu độ.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:54.119Z",
      "updatedAt": "2025-09-03T02:32:54.119Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "e7261523-4283-4e26-869a-0630c44eca5d",
      "text": "Gốc nho này, Chúa bứng từ Ai-cập,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:54.135Z",
      "updatedAt": "2025-09-03T02:32:54.135Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "fa4268b6-bec7-41df-a3a7-de0816d58e6b",
      "text": "đuổi chư dân, lấy chỗ mà trồng,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:54.208Z",
      "updatedAt": "2025-09-03T02:32:54.208Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "ca5c0fdc-8bde-4c79-921c-f432dac72b27",
      "text": "Chúa khẩn hoang bốn bề quang đãng,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:54.222Z",
      "updatedAt": "2025-09-03T02:32:54.222Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "c50e69e6-ec72-4d69-bdcb-e2a0299dd754",
      "text": "cho bén rễ sâu và lan rộng khắp nơi.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:54.236Z",
      "updatedAt": "2025-09-03T02:32:54.236Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "f85d649e-c487-4e6f-9619-91ce8c8dc920",
      "text": "Bóng um tùm phủ xanh đầu núi,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:54.252Z",
      "updatedAt": "2025-09-03T02:32:54.252Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "d82a6121-702d-43ed-8668-1e3794485edc",
      "text": "cành sum sê rợp bá hương thần,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:54.266Z",
      "updatedAt": "2025-09-03T02:32:54.266Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "49ef5804-61f1-46a6-bd9f-51576ec0b0d7",
      "text": "nhánh vươn dài tới phía đại dương,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:54.279Z",
      "updatedAt": "2025-09-03T02:32:54.279Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "8fe3ebef-bfb2-4ff0-b794-043936e64bdc",
      "text": "chồi mọc xa đến tận miền Sông Cả.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:54.294Z",
      "updatedAt": "2025-09-03T02:32:54.294Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "c81818fb-1d28-4eeb-a55f-6c79195611af",
      "text": "Tường rào nó, vậy sao Ngài phá đổ ?",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:54.321Z",
      "updatedAt": "2025-09-03T02:32:54.321Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "1836c1dc-8e59-415f-a582-fe2dab5ce9b0",
      "text": "Khách qua đường mặc sức hái mà ăn !",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:54.349Z",
      "updatedAt": "2025-09-03T02:32:54.349Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "bab0021f-a567-40ea-9f40-cf577f3ee6a0",
      "text": "Heo rừng vào phá phách,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:54.363Z",
      "updatedAt": "2025-09-03T02:32:54.363Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "64b0a1f9-5df0-4c1f-9664-d343fdbd7b4d",
      "text": "dã thú gặm tan hoang.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:54.377Z",
      "updatedAt": "2025-09-03T02:32:54.377Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "9caf4b24-7432-446e-bf4e-3ff821f64be3",
      "text": "Lạy Chúa Tể càn khôn, xin trở lại,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:54.392Z",
      "updatedAt": "2025-09-03T02:32:54.392Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "72733887-611d-460b-87d0-f992624ea607",
      "text": "tự cõi trời, xin ngó xuống mà xem,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:54.407Z",
      "updatedAt": "2025-09-03T02:32:54.407Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "d543316a-3e5b-4931-a4bd-8b1417ead930",
      "text": "xin Ngài thăm nom vườn nho cũ,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 2,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:54.420Z",
      "updatedAt": "2025-09-03T02:32:54.420Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "e5c9c232-0086-4655-8f3f-e5996eaf33a9",
      "text": "bảo vệ cây tay hữu Chúa đã trồng,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:54.434Z",
      "updatedAt": "2025-09-03T02:32:54.434Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "c18bafa2-9ace-4968-9606-927016dc3640",
      "text": "và chồi non được Ngài ban sức mạnh.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:54.448Z",
      "updatedAt": "2025-09-03T02:32:54.448Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "3d785877-9a63-4bce-a293-74ba5fe68506",
      "text": "Những người đã hoả thiêu chặt phá,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:54.463Z",
      "updatedAt": "2025-09-03T02:32:54.463Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "00c9e721-8d0c-47c6-83d4-afb6a138a7ce",
      "text": "Ngài nghiêm sắc mặt là chúng phải tiêu tan.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:54.480Z",
      "updatedAt": "2025-09-03T02:32:54.480Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "fb3d2e50-9a71-4849-98b4-901a0682e23f",
      "text": "Xin giơ tay bênh vực Đấng đang ngồi bên hữu",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:54.497Z",
      "updatedAt": "2025-09-03T02:32:54.497Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "914d291e-6f95-4cab-aeb4-c2f7935ce981",
      "text": "là con người được Chúa ban sức mạnh.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:54.527Z",
      "updatedAt": "2025-09-03T02:32:54.527Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "47d562e5-e033-4f2b-b43f-a74234642fae",
      "text": "Chúng con nguyền chẳng xa Chúa nữa đâu,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:54.542Z",
      "updatedAt": "2025-09-03T02:32:54.542Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "aca21486-4cec-4234-8163-2929d0df10d7",
      "text": "cúi xin Ngài ban cho được sống,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:54.556Z",
      "updatedAt": "2025-09-03T02:32:54.556Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "c06a6abe-7b56-46e4-bbd6-e59de0d9e4d4",
      "text": "để chúng con xưng tụng danh Ngài.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 2,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:54.571Z",
      "updatedAt": "2025-09-03T02:32:54.571Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "ae0388cc-c38d-4fc8-9ceb-5545edda79b3",
      "text": "Lạy CHÚA là Chúa Tể càn khôn,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:54.585Z",
      "updatedAt": "2025-09-03T02:32:54.585Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "81590b8e-aa2b-4526-b492-56d0c08e3be6",
      "text": "xin phục hồi chúng con,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:54.598Z",
      "updatedAt": "2025-09-03T02:32:54.598Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "0c372f7e-0388-4b6c-92a7-a47050f2a8f1",
      "text": "xin toả ánh tôn nhan rạng ngời",
      "label": "20",
      "number": 20,
      "subVerseIndex": 2,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:54.612Z",
      "updatedAt": "2025-09-03T02:32:54.612Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "e1aa1744-2bc6-467f-b2cd-4f84cbfe876f",
      "text": "để chúng con được ơn cứu độ.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 3,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:32:54.626Z",
      "updatedAt": "2025-09-03T02:32:54.626Z",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    }
  ],
  "marks": [
    {
      "id": "3528154e-68e2-45f4-beb3-d549b305df46",
      "content": "Trong *ai ca này của tập thể*, độc giả có thể thấy : dân Ít-ra-en đã gặp phải những tai hoạ lớn (cc. 13-14.17a). Những tai hoạ lớn đó có thể là hai biến cố : Sa-ma-ri bị thất thủ năm 721 tCN và thành Giê-ru-sa-lem bị chiếm đóng năm 587 tCN (hoặc năm 586 tCN). Trong cơn quẫn bách đó, dân Chúa nhắc lại lòng ưu ái của Thiên Chúa trong quá khứ và xin Người ra tay cứu giúp, nhằm phục hồi Ít-ra-en (chiếm lại những vùng đất thuộc vương quốc miền Bắc thời xưa và lấy lại ranh giới cũ dưới triều vua Đa-vít). Cấu trúc của Tv 80 : **1**) Cc. 2-4 : cc. 2-3 và c.4 ; **2**) Cc. 5-8 : cc. 5-7 và c.8 ; **3**) Cc. 9-14 : cc. 9-12 và cc. 13-14 ; **4**) Cc. 15-20 : cc. 15-17 và cc. 18-19. Cấu trúc này dựa vào điệp khúc trong cc. 4.8.20 và c.15.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 57,
      "endOffset": 57,
      "createdAt": "2025-09-03T02:32:53.663Z",
