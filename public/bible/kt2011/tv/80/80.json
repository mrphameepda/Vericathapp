      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "11d41876-f1ea-4c63-9744-ec03cc370de8"
    },
    {
      "id": "c7265055-52f7-445e-8413-e96d95686325",
      "content": "Các nước lân cận giành nhau chiếm đất đai, lãnh thổ của Ít-ra-en.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "11",
