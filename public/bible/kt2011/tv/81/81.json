{
  "chapter": {
    "id": "0d2468c2-eb87-4b66-aa22-c5087473e977",
    "number": 81,
    "createdAt": "2025-09-03T01:07:51.661Z",
    "updatedAt": "2025-09-03T01:07:51.661Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "809c617c-3092-46b8-9cc7-5bb457f246cb",
      "text": "*Phần ca trưởng. Có hoạ đàn thành Gát. Của ông A-xáp.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:32:59.947Z",
      "updatedAt": "2025-09-03T02:32:59.947Z",
      "chapterId": "0d2468c2-eb87-4b66-aa22-c5087473e977"
    },
    {
      "id": "cf00ffdf-f8e7-4612-8f5f-dee30ee06562",
      "text": "Reo lên mừng Thiên Chúa, Đấng trợ lực chúng ta !",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:00.005Z",
      "updatedAt": "2025-09-03T02:33:00.005Z",
      "chapterId": "0d2468c2-eb87-4b66-aa22-c5087473e977"
    },
    {
      "id": "285b3348-24cb-4338-a111-92150d3dd0e9",
      "text": "Hò vang dậy đi nào kính Chúa nhà Gia-cóp !",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:00.015Z",
      "updatedAt": "2025-09-03T02:33:00.015Z",
      "chapterId": "0d2468c2-eb87-4b66-aa22-c5087473e977"
    },
    {
      "id": "c0fc75b5-77c0-4003-a651-3f708fe3f738",
      "text": "Đàn hát lên nào, hoà nhịp trống cơm,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:00.036Z",
      "updatedAt": "2025-09-03T02:33:00.036Z",
      "chapterId": "0d2468c2-eb87-4b66-aa22-c5087473e977"
    },
    {
      "id": "0d3a9882-ec95-49f9-be08-e1f7965dbce9",
      "text": "bổng trầm gieo tiếng cầm tiếng sắt.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:00.060Z",
      "updatedAt": "2025-09-03T02:33:00.060Z",
      "chapterId": "0d2468c2-eb87-4b66-aa22-c5087473e977"
    },
    {
      "id": "a0b6570c-33d8-464f-8e4d-b7513e3d5a72",
      "text": "Rúc lên đi, hãy rúc tù và,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:00.070Z",
      "updatedAt": "2025-09-03T02:33:00.070Z",
      "chapterId": "0d2468c2-eb87-4b66-aa22-c5087473e977"
    },
    {
      "id": "73b85721-ac1a-4a1b-930b-850198a8c0dc",
      "text": "mồng một ngày rằm cho ta mừng lễ.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:00.083Z",
      "updatedAt": "2025-09-03T02:33:00.083Z",
      "chapterId": "0d2468c2-eb87-4b66-aa22-c5087473e977"
    },
    {
      "id": "6ad1250a-e8a8-4eae-a152-76f79cb564d5",
      "text": "Đó là luật Ít-ra-en phải cứ,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:00.113Z",
      "updatedAt": "2025-09-03T02:33:00.113Z",
      "chapterId": "0d2468c2-eb87-4b66-aa22-c5087473e977"
    },
    {
      "id": "260c7978-3745-4bcc-9497-f0e64ab3990c",
      "text": "Thiên Chúa nhà Gia-cóp đã phán truyền.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:00.140Z",
      "updatedAt": "2025-09-03T02:33:00.140Z",
      "chapterId": "0d2468c2-eb87-4b66-aa22-c5087473e977"
    },
    {
      "id": "34ec86ad-da2e-4d52-8d6b-3cfb884c0467",
      "text": "Chỉ thị này, nhà Giu-se đã nhận khi bỏ miền Ai-cập ra đi.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:00.164Z",
      "updatedAt": "2025-09-03T02:33:00.164Z",
      "chapterId": "0d2468c2-eb87-4b66-aa22-c5087473e977"
    },
    {
      "id": "6dae3acf-04a5-4f15-b3e2-3bdae8bbd9a2",
      "text": "Một giọng nói tôi nghe khác lạ,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:00.195Z",
      "updatedAt": "2025-09-03T02:33:00.195Z",
      "chapterId": "0d2468c2-eb87-4b66-aa22-c5087473e977"
    },
    {
      "id": "cd886ec6-2bc3-4c0e-a51f-2e3b65093e57",
      "text": "rằng : “Gánh nặng vai dân, Ta đã cất cho,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:00.205Z",
      "updatedAt": "2025-09-03T02:33:00.205Z",
      "chapterId": "0d2468c2-eb87-4b66-aa22-c5087473e977"
    },
    {
      "id": "32e30ead-1f9d-42ff-8393-8145cc169e3c",
      "text": "tay họ thôi cầm chiếc ki người nô lệ.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:00.216Z",
      "updatedAt": "2025-09-03T02:33:00.216Z",
      "chapterId": "0d2468c2-eb87-4b66-aa22-c5087473e977"
    },
    {
      "id": "d37f406a-85ea-4847-aed0-229b49d1590b",
      "text": "Lúc ngặt nghèo, ngươi đã kêu lên,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:00.238Z",
      "updatedAt": "2025-09-03T02:33:00.238Z",
      "chapterId": "0d2468c2-eb87-4b66-aa22-c5087473e977"
    },
    {
      "id": "983d6ae0-4e53-4af2-88d5-4fd2051a944b",
      "text": "Ta liền giải thoát.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:00.250Z",
      "updatedAt": "2025-09-03T02:33:00.250Z",
      "chapterId": "0d2468c2-eb87-4b66-aa22-c5087473e977"
    },
    {
      "id": "28ea6117-e9fd-4f82-a025-62375fe18bd8",
      "text": "Giữa mây mù sấm chớp, Ta đã đáp lời,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:00.266Z",
      "updatedAt": "2025-09-03T02:33:00.266Z",
      "chapterId": "0d2468c2-eb87-4b66-aa22-c5087473e977"
    },
    {
      "id": "75f017d6-da0e-4eb2-95d6-fc8a0a2ec34d",
      "text": "bên mạch nước Mơ-ri-va, Ta thử lòng ngươi.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 3,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:00.280Z",
      "updatedAt": "2025-09-03T02:33:00.280Z",
      "chapterId": "0d2468c2-eb87-4b66-aa22-c5087473e977"
    },
    {
      "id": "9bda1405-089f-4f97-a083-65639fa69912",
      "text": "“Dân Ta hỡi, nghe Ta cảnh cáo,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:00.336Z",
      "updatedAt": "2025-09-03T02:33:00.336Z",
      "chapterId": "0d2468c2-eb87-4b66-aa22-c5087473e977"
    },
    {
      "id": "403a08ac-b4d1-4568-aeb5-8309521260c4",
      "text": "Ít-ra-en này, phải chi ngươi chịu nghe Ta,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:00.350Z",
      "updatedAt": "2025-09-03T02:33:00.350Z",
      "chapterId": "0d2468c2-eb87-4b66-aa22-c5087473e977"
    },
    {
      "id": "1eab1f74-bb3d-45c9-9758-53331c788559",
      "text": "thì đừng đem thần lạ về nhà,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:00.378Z",
      "updatedAt": "2025-09-03T02:33:00.378Z",
      "chapterId": "0d2468c2-eb87-4b66-aa22-c5087473e977"
    },
    {
      "id": "57c0be32-775e-455e-ac5d-3616698947c8",
      "text": "thần ngoại bang, chớ hề cúng bái.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:00.393Z",
      "updatedAt": "2025-09-03T02:33:00.393Z",
      "chapterId": "0d2468c2-eb87-4b66-aa22-c5087473e977"
    },
    {
      "id": "21130198-3950-4cf2-a908-963480ada85f",
      "text": "Chính Ta là THƯỢNG ĐẾ Chúa ngươi,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:00.407Z",
      "updatedAt": "2025-09-03T02:33:00.407Z",
      "chapterId": "0d2468c2-eb87-4b66-aa22-c5087473e977"
    },
    {
      "id": "624fdd06-c02e-48bd-9e78-1bd55f60142a",
      "text": "đã đưa ngươi lên tự miền Ai-cập,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:00.422Z",
      "updatedAt": "2025-09-03T02:33:00.422Z",
      "chapterId": "0d2468c2-eb87-4b66-aa22-c5087473e977"
    },
    {
      "id": "a611cda7-4c5f-4b20-a677-e23397d7ff59",
      "text": "há miệng ngươi ra, Ta sẽ cho đầy ứ.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:00.464Z",
      "updatedAt": "2025-09-03T02:33:00.464Z",
      "chapterId": "0d2468c2-eb87-4b66-aa22-c5087473e977"
    },
    {
      "id": "99f79588-2c29-49b3-9070-7bde45c46dca",
      "text": "“Nhưng dân Ta đã chẳng nghe lời,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:00.479Z",
      "updatedAt": "2025-09-03T02:33:00.479Z",
      "chapterId": "0d2468c2-eb87-4b66-aa22-c5087473e977"
    },
    {
      "id": "0f76541b-c117-437b-b503-24b23c0d6e71",
      "text": "Ít-ra-en nào đâu có chịu.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:00.493Z",
      "updatedAt": "2025-09-03T02:33:00.493Z",
      "chapterId": "0d2468c2-eb87-4b66-aa22-c5087473e977"
    },
    {
      "id": "ca72b85b-eb76-49da-98bf-91d1638a2a8c",
      "text": "Ta đành mặc họ lòng chai dạ đá,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:00.521Z",
      "updatedAt": "2025-09-03T02:33:00.521Z",
      "chapterId": "0d2468c2-eb87-4b66-aa22-c5087473e977"
    },
    {
      "id": "97f27b3f-7892-4cff-8079-119fa3345d25",
      "text": "muốn đi đâu thì cứ việc đi !",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:00.537Z",
      "updatedAt": "2025-09-03T02:33:00.537Z",
      "chapterId": "0d2468c2-eb87-4b66-aa22-c5087473e977"
    },
    {
      "id": "53ef4626-84f7-4ca0-b789-62ba2baaca6c",
      "text": "“Ôi dân Ta mà đã nghe lời,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:00.550Z",
      "updatedAt": "2025-09-03T02:33:00.550Z",
      "chapterId": "0d2468c2-eb87-4b66-aa22-c5087473e977"
    },
    {
      "id": "fe249e1a-febc-4b69-be05-fe25322feeb8",
      "text": "Ít-ra-en chịu theo đường Ta chỉ,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:00.565Z",
      "updatedAt": "2025-09-03T02:33:00.565Z",
      "chapterId": "0d2468c2-eb87-4b66-aa22-c5087473e977"
    },
    {
      "id": "2e423a72-6780-4be9-b963-7f9c4176bed9",
      "text": "thì hết những địch thù của chúng,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:00.591Z",
      "updatedAt": "2025-09-03T02:33:00.591Z",
      "chapterId": "0d2468c2-eb87-4b66-aa22-c5087473e977"
    },
    {
      "id": "2f9415ed-e545-4c86-ab80-03c2586d8015",
      "text": "những kẻ hà hiếp chúng xưa nay,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:00.604Z",
      "updatedAt": "2025-09-03T02:33:00.604Z",
      "chapterId": "0d2468c2-eb87-4b66-aa22-c5087473e977"
    },
    {
      "id": "d74dd2e5-903d-4188-8ed3-272b0022ce52",
      "text": "Ta tức khắc trở tay quật ngã ;",
      "label": "15",
      "number": 15,
      "subVerseIndex": 2,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:00.616Z",
      "updatedAt": "2025-09-03T02:33:00.616Z",
      "chapterId": "0d2468c2-eb87-4b66-aa22-c5087473e977"
    },
    {
      "id": "20a22af9-4b5e-4154-9e73-6048ca1c6e0c",
      "text": "“Kẻ thù CHÚA sẽ cầu thân nịnh bợ,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:00.629Z",
      "updatedAt": "2025-09-03T02:33:00.629Z",
      "chapterId": "0d2468c2-eb87-4b66-aa22-c5087473e977"
    },
    {
      "id": "faa058a3-860a-466d-9bb5-c4d131694e33",
      "text": "ấy là số phận chúng muôn đời ;",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:00.642Z",
      "updatedAt": "2025-09-03T02:33:00.642Z",
      "chapterId": "0d2468c2-eb87-4b66-aa22-c5087473e977"
    },
    {
      "id": "0b95d176-75c4-4af1-9f40-b24f59d8e33a",
      "text": "còn dân Ta, Ta sẽ nuôi bằng lúa mì tinh hảo,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:00.654Z",
      "updatedAt": "2025-09-03T02:33:00.654Z",
      "chapterId": "0d2468c2-eb87-4b66-aa22-c5087473e977"
    },
    {
      "id": "42b397f2-e9ca-4ce2-8251-532634294610",
      "text": "mật ong rừng, Ta cho hưởng thoả thuê.”",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:00.667Z",
      "updatedAt": "2025-09-03T02:33:00.667Z",
      "chapterId": "0d2468c2-eb87-4b66-aa22-c5087473e977"
    }
  ],
  "marks": [
    {
      "id": "78c9709e-53fb-4c43-a2e9-f5ec28044998",
      "content": "Đây là *một Tv ngôn sứ*. Tv này gồm hai phần chính : **1**) Thánh thi (cc. 2-6a) ; **2**) Sấm ngôn (cc. 6b-17).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 43,
      "endOffset": 43,
      "createdAt": "2025-09-03T02:32:59.974Z",
      "updatedAt": "2025-09-03T02:32:59.974Z",
      "targetId": "981b6159-5fd9-43c2-a76a-d56d3787c71b",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "0d2468c2-eb87-4b66-aa22-c5087473e977"
