    },
    {
      "id": "5991c139-4b3e-49b8-8596-99150f019a58",
      "content": "Nền trật tự luân lý và xã hội bị đe doạ.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
