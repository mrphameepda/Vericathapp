{
  "chapter": {
    "id": "5bbce675-deb7-431d-8a53-190e9dd1a87c",
    "number": 82,
    "createdAt": "2025-09-03T01:07:51.661Z",
    "updatedAt": "2025-09-03T01:07:51.661Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "d3f53347-9648-4398-bf9b-51df25a4920a",
      "text": "*Thánh vịnh. Của ông A-xáp.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:33:06.323Z",
      "updatedAt": "2025-09-03T02:33:06.323Z",
      "chapterId": "5bbce675-deb7-431d-8a53-190e9dd1a87c"
    },
    {
      "id": "6a0ff06c-cd87-4005-b201-76ae4ed39b64",
      "text": "Thượng Đế chủ toạ triều đình thiên quốc,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:06.376Z",
      "updatedAt": "2025-09-03T02:33:06.376Z",
      "chapterId": "5bbce675-deb7-431d-8a53-190e9dd1a87c"
    },
    {
      "id": "d9672758-5afb-4334-8b85-442c954c3a4c",
      "text": "Người xử án giữa chư thánh chư thần :",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:06.391Z",
      "updatedAt": "2025-09-03T02:33:06.391Z",
      "chapterId": "5bbce675-deb7-431d-8a53-190e9dd1a87c"
    },
    {
      "id": "c5739441-9d07-4832-9794-e760b8005a6c",
      "text": "“Tới bao giờ các ngươi còn xử án bất công,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:06.419Z",
      "updatedAt": "2025-09-03T02:33:06.419Z",
      "chapterId": "5bbce675-deb7-431d-8a53-190e9dd1a87c"
    },
    {
      "id": "c21f5c58-a3c8-40b4-975d-c44f3db38e20",
      "text": "hay còn thiên vị phường gian ác ?",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:06.447Z",
      "updatedAt": "2025-09-03T02:33:06.447Z",
      "chapterId": "5bbce675-deb7-431d-8a53-190e9dd1a87c"
    },
    {
      "id": "bd30432f-1ab2-4e91-9724-dbee8cdcdd0f",
      "text": "Hãy bênh quyền lợi kẻ mồ côi, người hèn mọn ;",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:06.462Z",
      "updatedAt": "2025-09-03T02:33:06.462Z",
      "chapterId": "5bbce675-deb7-431d-8a53-190e9dd1a87c"
    },
    {
      "id": "f81ce382-b57c-49cb-a01d-5e3a1ac07a4a",
      "text": "minh oan cho người khốn khổ, kẻ bần cùng,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:06.476Z",
      "updatedAt": "2025-09-03T02:33:06.476Z",
      "chapterId": "5bbce675-deb7-431d-8a53-190e9dd1a87c"
    },
    {
      "id": "1babfed0-22c3-4bb7-8338-4ec04d34d2a1",
      "text": "giải phóng ai hèn mọn, ai nghèo túng,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:06.505Z",
      "updatedAt": "2025-09-03T02:33:06.505Z",
      "chapterId": "5bbce675-deb7-431d-8a53-190e9dd1a87c"
    },
    {
      "id": "755f2614-9f9a-4def-942c-f9e13b6f74a2",
      "text": "cứu khỏi nanh vuốt bọn ác nhân.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:06.518Z",
      "updatedAt": "2025-09-03T02:33:06.518Z",
      "chapterId": "5bbce675-deb7-431d-8a53-190e9dd1a87c"
    },
    {
      "id": "ecd0b18d-8207-461b-9f09-53b3a027d734",
      "text": "“Vậy mà chúng chẳng hay chẳng hiểu,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:06.535Z",
      "updatedAt": "2025-09-03T02:33:06.535Z",
      "chapterId": "5bbce675-deb7-431d-8a53-190e9dd1a87c"
    },
    {
      "id": "d5e0ff0a-2573-41d8-bd1d-43d1ef69f083",
      "text": "cứ bước đi, giữa tăm tối mịt mù,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:06.549Z",
      "updatedAt": "2025-09-03T02:33:06.549Z",
      "chapterId": "5bbce675-deb7-431d-8a53-190e9dd1a87c"
    },
    {
      "id": "07cc0787-e06b-43fb-81d9-4fcdfae4e825",
      "text": "khiến nền tảng địa cầu phải lung lay nghiêng ngả.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:06.562Z",
      "updatedAt": "2025-09-03T02:33:06.562Z",
      "chapterId": "5bbce675-deb7-431d-8a53-190e9dd1a87c"
    },
    {
      "id": "fe24d981-b3a0-4f14-8e89-3c98d70c49b6",
      "text": "Ta đã phán : Hết thảy các ngươi đây",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:06.586Z",
      "updatedAt": "2025-09-03T02:33:06.586Z",
      "chapterId": "5bbce675-deb7-431d-8a53-190e9dd1a87c"
    },
    {
      "id": "8e45300a-0f5b-4ea8-abec-d92f3528c74e",
      "text": "đều là bậc thần thánh, là con Đấng Tối Cao,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:06.609Z",
      "updatedAt": "2025-09-03T02:33:06.609Z",
      "chapterId": "5bbce675-deb7-431d-8a53-190e9dd1a87c"
    },
    {
      "id": "722dd3c3-0e19-42d0-9115-eaf2be4d734c",
      "text": "thế nhưng rồi phải chết không khác kẻ phàm nhân,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:06.650Z",
      "updatedAt": "2025-09-03T02:33:06.650Z",
      "chapterId": "5bbce675-deb7-431d-8a53-190e9dd1a87c"
    },
    {
      "id": "8532aaf9-523d-4742-9d59-aea3aba2cb29",
      "text": "và có ngày sụp đổ như mọi bậc quan quyền.”",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:06.666Z",
      "updatedAt": "2025-09-03T02:33:06.666Z",
      "chapterId": "5bbce675-deb7-431d-8a53-190e9dd1a87c"
    },
    {
      "id": "066d9061-44e4-4b66-b5f1-8d89f31fc46f",
      "text": "Tâu Thượng Đế, xin Ngài đứng dậy mà xét xử địa cầu,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:06.680Z",
      "updatedAt": "2025-09-03T02:33:06.680Z",
      "chapterId": "5bbce675-deb7-431d-8a53-190e9dd1a87c"
    },
    {
      "id": "51336ac2-9f3f-4625-a5a7-2a90561091bf",
      "text": "vì chính Ngài làm chủ muôn dân.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:06.694Z",
      "updatedAt": "2025-09-03T02:33:06.694Z",
      "chapterId": "5bbce675-deb7-431d-8a53-190e9dd1a87c"
    }
  ],
  "marks": [
    {
      "id": "dff2f776-3f1a-4b9c-a3b2-50cb46c29e6b",
      "content": "Theo *Tv giáo huấn* này, Thiên Chúa lên tiếng xử án giữa triều đình thiên quốc : kết tội những thẩm phán thực hiện sai trái chức vụ của họ. Ngoài câu nhập đề (c.1) và lời cầu xin kết thúc Tv (c.8), phần thân Tv chia làm hai đoạn : **1**) Lời kêu gọi các thẩm phán (cc. 2-4) ; **2**) Lời tuyên án (cc. 5-7).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 42,
      "endOffset": 42,
      "createdAt": "2025-09-03T02:33:06.353Z",
      "updatedAt": "2025-09-03T02:33:06.353Z",
