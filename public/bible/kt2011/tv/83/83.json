{
  "chapter": {
    "id": "591d8380-0b1b-4e31-9fbd-fac85ef65732",
    "number": 83,
    "createdAt": "2025-09-03T01:07:51.661Z",
    "updatedAt": "2025-09-03T01:07:51.661Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "744b04db-69d8-464f-a955-3b82d05eb588",
      "text": "*Thánh vịnh. Thánh ca. Của ông A-xáp.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:33:14.274Z",
      "updatedAt": "2025-09-03T02:33:14.274Z",
      "chapterId": "591d8380-0b1b-4e31-9fbd-fac85ef65732"
    },
    {
      "id": "555eec59-7b8e-4ecc-b686-5ab606f03f74",
      "text": "Lạy Thiên Chúa, xin đừng làm thinh,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:14.372Z",
      "updatedAt": "2025-09-03T02:33:14.372Z",
      "chapterId": "591d8380-0b1b-4e31-9fbd-fac85ef65732"
    },
    {
      "id": "c334f857-f2b6-4e98-ba3b-79ffd7b201d9",
      "text": "xin đừng nín lặng ngồi yên, lạy Thiên Chúa.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:14.386Z",
      "updatedAt": "2025-09-03T02:33:14.386Z",
      "chapterId": "591d8380-0b1b-4e31-9fbd-fac85ef65732"
    },
    {
      "id": "d1a560e0-fd0e-4caf-a1f7-dec7d228e847",
      "text": "Kìa kẻ thù Chúa ồn ào náo động,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:14.399Z",
      "updatedAt": "2025-09-03T02:33:14.399Z",
      "chapterId": "591d8380-0b1b-4e31-9fbd-fac85ef65732"
    },
    {
      "id": "00457f48-35f4-4349-b2bc-fb24fbffd2f9",
      "text": "bọn ghét Ngài đang ngóc đầu lên.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:14.415Z",
      "updatedAt": "2025-09-03T02:33:14.415Z",
      "chapterId": "591d8380-0b1b-4e31-9fbd-fac85ef65732"
    },
    {
      "id": "15e7758e-2853-441e-b104-ab7140f218ec",
      "text": "Chúng lập kế chống lại dân Ngài,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:14.429Z",
      "updatedAt": "2025-09-03T02:33:14.429Z",
      "chapterId": "591d8380-0b1b-4e31-9fbd-fac85ef65732"
    },
    {
      "id": "977a4b5c-6947-4128-b6e3-5aad7aa7fcb9",
      "text": "bày mưu chống những kẻ Ngài bảo trợ.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:14.442Z",
      "updatedAt": "2025-09-03T02:33:14.442Z",
      "chapterId": "591d8380-0b1b-4e31-9fbd-fac85ef65732"
    },
    {
      "id": "cc3bd988-249e-4386-a81d-0837d1185e27",
      "text": "Chúng rằng : “Nào ta hãy diệt bọn đó đi,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:14.456Z",
      "updatedAt": "2025-09-03T02:33:14.456Z",
      "chapterId": "591d8380-0b1b-4e31-9fbd-fac85ef65732"
    },
    {
      "id": "ee5b7631-2413-474c-bd9b-aee67a71d31c",
      "text": "để chúng không còn là một dân tộc nữa",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:14.470Z",
      "updatedAt": "2025-09-03T02:33:14.470Z",
      "chapterId": "591d8380-0b1b-4e31-9fbd-fac85ef65732"
    },
    {
      "id": "6f1508ef-f532-4c05-bbf6-79cec9960bb2",
      "text": "và chẳng ai còn nhắc đến tên tuổi Ít-ra-en.”",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:14.484Z",
      "updatedAt": "2025-09-03T02:33:14.484Z",
      "chapterId": "591d8380-0b1b-4e31-9fbd-fac85ef65732"
    },
    {
      "id": "e5738fde-8f04-45be-a309-34aef1816e8e",
      "text": "Chúng đồng lòng bày mưu lập kế,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:14.513Z",
      "updatedAt": "2025-09-03T02:33:14.513Z",
      "chapterId": "591d8380-0b1b-4e31-9fbd-fac85ef65732"
    },
    {
      "id": "2d4a41b2-7c6e-4da7-9c11-a2f9a790f41f",
      "text": "liên minh chống lại Ngài :",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:14.527Z",
      "updatedAt": "2025-09-03T02:33:14.527Z",
      "chapterId": "591d8380-0b1b-4e31-9fbd-fac85ef65732"
    },
    {
      "id": "de1398e7-1555-446d-afdf-0242159b2126",
      "text": "Nào là dân Ê-đôm cùng với Ít-ma-ên, Mô-áp và Ha-ga.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:14.556Z",
      "updatedAt": "2025-09-03T02:33:14.556Z",
      "chapterId": "591d8380-0b1b-4e31-9fbd-fac85ef65732"
    },
    {
      "id": "9c2b2b6e-78ae-47da-b321-64aca924ea4a",
      "text": "Nào là dân Gơ-van, Am-mon, A-ma-lếch",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:14.621Z",
      "updatedAt": "2025-09-03T02:33:14.621Z",
      "chapterId": "591d8380-0b1b-4e31-9fbd-fac85ef65732"
    },
    {
      "id": "2f795256-4b51-4e4c-871a-76bc9b9bf000",
      "text": "và Phi-li-tinh cùng dân thành Tia nữa.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:14.679Z",
      "updatedAt": "2025-09-03T02:33:14.679Z",
      "chapterId": "591d8380-0b1b-4e31-9fbd-fac85ef65732"
    },
    {
      "id": "5d739066-e024-4bd5-837d-4c7105912aea",
      "text": "Cả Át-sua cũng vào hùa với chúng",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:14.723Z",
      "updatedAt": "2025-09-03T02:33:14.723Z",
      "chapterId": "591d8380-0b1b-4e31-9fbd-fac85ef65732"
    },
    {
      "id": "17a6acaa-9f34-4d14-9c2d-5063cc2e34a0",
      "text": "và tiếp tay cho dòng dõi Lót.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:14.757Z",
      "updatedAt": "2025-09-03T02:33:14.757Z",
      "chapterId": "591d8380-0b1b-4e31-9fbd-fac85ef65732"
    },
    {
      "id": "407c89ef-2c05-413c-b636-5561acc9ee69",
      "text": "Xin Ngài xử với chúng như đã xử với dân Ma-đi-an,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:14.801Z",
      "updatedAt": "2025-09-03T02:33:14.801Z",
      "chapterId": "591d8380-0b1b-4e31-9fbd-fac85ef65732"
    },
    {
      "id": "a97bb8e3-1e1f-475b-abc8-f2c067ca47d7",
      "text": "với hai tên Xi-xơ-ra và Gia-vin tại khe suối Ki-sôn ;",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:14.844Z",
      "updatedAt": "2025-09-03T02:33:14.844Z",
      "chapterId": "591d8380-0b1b-4e31-9fbd-fac85ef65732"
    },
    {
      "id": "3c5461a3-a394-47df-80d1-fd9c59463aa3",
      "text": "hai tên này đã bị tiêu diệt tại Ên Đo",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:14.915Z",
      "updatedAt": "2025-09-03T02:33:14.915Z",
      "chapterId": "591d8380-0b1b-4e31-9fbd-fac85ef65732"
    },
    {
      "id": "3fd8e59a-1fb6-4460-9dde-5e62b53f0f54",
      "text": "và thành phân bón ruộng.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:14.938Z",
      "updatedAt": "2025-09-03T02:33:14.938Z",
      "chapterId": "591d8380-0b1b-4e31-9fbd-fac85ef65732"
    },
    {
      "id": "8b9ffe1b-0820-409e-a8ff-1600e8c8f04a",
      "text": "Xin làm cho vua quan của chúng",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:14.951Z",
      "updatedAt": "2025-09-03T02:33:14.951Z",
      "chapterId": "591d8380-0b1b-4e31-9fbd-fac85ef65732"
    },
    {
      "id": "bb549338-f673-4454-be3b-ed49aa7f11a4",
      "text": "phải đồng số phận cùng Ô-rếp và Dơ-ếp,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:14.981Z",
      "updatedAt": "2025-09-03T02:33:14.981Z",
      "chapterId": "591d8380-0b1b-4e31-9fbd-fac85ef65732"
    },
    {
      "id": "274e0ab6-5c2f-4ac5-9826-a2c2cb95d561",
      "text": "cho thủ lãnh của chúng",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:15.023Z",
      "updatedAt": "2025-09-03T02:33:15.023Z",
      "chapterId": "591d8380-0b1b-4e31-9fbd-fac85ef65732"
    },
    {
      "id": "5581fe7f-12c3-48ab-b516-b96641ea1803",
      "text": "cùng chung vận mệnh với De-vác và Xan-mun-na ;",
      "label": "12",
      "number": 12,
      "subVerseIndex": 3,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:15.036Z",
      "updatedAt": "2025-09-03T02:33:15.036Z",
      "chapterId": "591d8380-0b1b-4e31-9fbd-fac85ef65732"
    },
    {
      "id": "12180e89-ec4e-45fa-87e5-633e36005570",
      "text": "những tên này đã nói :",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:15.087Z",
      "updatedAt": "2025-09-03T02:33:15.087Z",
      "chapterId": "591d8380-0b1b-4e31-9fbd-fac85ef65732"
    },
    {
      "id": "6d394889-095f-4bc0-be80-838afa3388fa",
      "text": "“Ta hãy chiếm lãnh địa Thiên Chúa !”",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:15.098Z",
      "updatedAt": "2025-09-03T02:33:15.098Z",
      "chapterId": "591d8380-0b1b-4e31-9fbd-fac85ef65732"
    },
    {
      "id": "b0e52580-5d7a-43c8-b6f7-e4429518d422",
      "text": "Lạy Thiên Chúa con thờ,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:15.109Z",
      "updatedAt": "2025-09-03T02:33:15.109Z",
      "chapterId": "591d8380-0b1b-4e31-9fbd-fac85ef65732"
    },
    {
      "id": "c56dd676-0fc0-48fa-adbd-975451596b8d",
      "text": "xin làm cho chúng như chiếc lá quay cuồng,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:15.120Z",
      "updatedAt": "2025-09-03T02:33:15.120Z",
      "chapterId": "591d8380-0b1b-4e31-9fbd-fac85ef65732"
    },
    {
      "id": "3442d6da-57b4-48e9-a8a5-892ecffe11d6",
      "text": "như cọng rơm trước gió.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 2,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:15.131Z",
      "updatedAt": "2025-09-03T02:33:15.131Z",
      "chapterId": "591d8380-0b1b-4e31-9fbd-fac85ef65732"
    },
    {
      "id": "70b9c805-891b-463f-bdab-e655fe606467",
      "text": "Giống như lửa thiêu rừng, tựa hoả hào đốt núi,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:15.143Z",
      "updatedAt": "2025-09-03T02:33:15.143Z",
      "chapterId": "591d8380-0b1b-4e31-9fbd-fac85ef65732"
    },
    {
      "id": "90bc72df-1023-4b52-b3f2-94c817502149",
      "text": "xin Ngài cho nổi cơn dông tố đuổi chúng đi,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:15.155Z",
      "updatedAt": "2025-09-03T02:33:15.155Z",
      "chapterId": "591d8380-0b1b-4e31-9fbd-fac85ef65732"
    },
    {
      "id": "7781f7c4-dcdf-4aff-a0dc-328072de7281",
      "text": "cho bừng lên trận bão làm chúng hoảng sợ.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:15.168Z",
      "updatedAt": "2025-09-03T02:33:15.168Z",
      "chapterId": "591d8380-0b1b-4e31-9fbd-fac85ef65732"
    },
    {
      "id": "00b18815-d942-4c0d-a902-1295e45b70b4",
      "text": "Xin cho chúng phải bẽ mặt ê chề,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:15.183Z",
      "updatedAt": "2025-09-03T02:33:15.183Z",
      "chapterId": "591d8380-0b1b-4e31-9fbd-fac85ef65732"
    },
    {
      "id": "74956fa9-bc87-4d61-bcef-8232bedb2164",
      "text": "để chúng tìm kiếm danh Ngài, lạy CHÚA.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:15.212Z",
      "updatedAt": "2025-09-03T02:33:15.212Z",
      "chapterId": "591d8380-0b1b-4e31-9fbd-fac85ef65732"
    },
    {
      "id": "4fb6e845-0030-4c41-93ed-c27465fed063",
      "text": "Xin cho chúng phải muôn đời nhuốc nhơ hoảng sợ,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:15.226Z",
      "updatedAt": "2025-09-03T02:33:15.226Z",
      "chapterId": "591d8380-0b1b-4e31-9fbd-fac85ef65732"
    },
    {
      "id": "2109aa75-2ac8-4f2e-99ce-f7b3773decf1",
      "text": "phải xấu hổ diệt vong,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:15.254Z",
      "updatedAt": "2025-09-03T02:33:15.254Z",
      "chapterId": "591d8380-0b1b-4e31-9fbd-fac85ef65732"
    },
    {
      "id": "6a8d08ea-5594-4bb1-a719-800073083bda",
      "text": "để chúng nhận biết rằng chỉ có Ngài mang danh ĐỨC CHÚA,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:15.268Z",
      "updatedAt": "2025-09-03T02:33:15.268Z",
      "chapterId": "591d8380-0b1b-4e31-9fbd-fac85ef65732"
    },
    {
      "id": "3f890070-c0e3-4a18-aba5-0feb83d86864",
      "text": "Đấng Tối Cao trên khắp địa cầu.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:15.297Z",
