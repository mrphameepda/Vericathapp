    },
    {
      "id": "b90ebb86-59b7-476e-bbc7-fc5d1dd6d880",
      "content": "Lòng khao khát được chiêm ngưỡng Thiên Chúa tại Đền Thờ làm cho khách hành hương quên đi những nỗi vất vả nhọc nhằn (*thung lũng khô cằn* : c.7a) và như tiến bước trên con đường thuận lợi trong một vùng đất được mưa thu tưới mát và làm cho phì nhiêu.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "6",
      "sortOrder": 5,
      "startOffset": 45,
