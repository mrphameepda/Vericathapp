{
  "chapter": {
    "id": "b4468648-883c-481a-841f-6dd52fb2216f",
    "number": 84,
    "createdAt": "2025-09-03T01:07:51.661Z",
    "updatedAt": "2025-09-03T01:07:51.661Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "3def001c-0491-43b3-9ace-60612736379c",
      "text": "*Phần ca trưởng. Có hoạ đàn thành Gát. Của con cái ông Cô-rắc. Thánh vịnh.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:33:20.843Z",
      "updatedAt": "2025-09-03T02:33:20.843Z",
      "chapterId": "b4468648-883c-481a-841f-6dd52fb2216f"
    },
    {
      "id": "cc91c492-e2f0-4667-b431-d3787e1966a0",
      "text": "Lạy Chúa Tể càn khôn, cung điện Ngài xiết bao khả ái.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:20.912Z",
      "updatedAt": "2025-09-03T02:33:20.912Z",
      "chapterId": "b4468648-883c-481a-841f-6dd52fb2216f"
    },
    {
      "id": "f83dcde8-cd99-4f54-a494-a5a5386089fe",
      "text": "Mảnh hồn này khát khao mòn mỏi",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:20.926Z",
      "updatedAt": "2025-09-03T02:33:20.926Z",
      "chapterId": "b4468648-883c-481a-841f-6dd52fb2216f"
    },
    {
      "id": "df0845d2-5f4b-4a02-abd0-af84f20ef231",
      "text": "mong tới được khuôn viên đền vàng.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:20.955Z",
      "updatedAt": "2025-09-03T02:33:20.955Z",
      "chapterId": "b4468648-883c-481a-841f-6dd52fb2216f"
    },
    {
      "id": "16de76f9-ccf6-4836-b281-753c74d069dd",
      "text": "Cả tấm thân con cùng là tấc dạ",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:20.969Z",
      "updatedAt": "2025-09-03T02:33:20.969Z",
      "chapterId": "b4468648-883c-481a-841f-6dd52fb2216f"
    },
    {
      "id": "52d87987-6b0a-4b8a-97ef-b4949b11a7f9",
      "text": "những hướng lên Chúa Trời hằng sống mà hớn hở reo mừng.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 3,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:20.983Z",
      "updatedAt": "2025-09-03T02:33:20.983Z",
      "chapterId": "b4468648-883c-481a-841f-6dd52fb2216f"
    },
    {
      "id": "9b77aed1-a8da-4004-8753-b03b32b100ed",
      "text": "Lạy Chúa Tể càn khôn là Đức Vua, là Thiên Chúa con thờ,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:20.997Z",
      "updatedAt": "2025-09-03T02:33:20.997Z",
      "chapterId": "b4468648-883c-481a-841f-6dd52fb2216f"
    },
    {
      "id": "9516eef3-7661-4677-9a7c-b05087e11932",
      "text": "ngay chim sẻ còn tìm được mái ấm,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:21.011Z",
      "updatedAt": "2025-09-03T02:33:21.011Z",
      "chapterId": "b4468648-883c-481a-841f-6dd52fb2216f"
    },
    {
      "id": "7c583e36-a4cc-42f4-887c-fafc87a65593",
      "text": "cánh nhạn kia cũng làm tổ đặt con",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:21.025Z",
      "updatedAt": "2025-09-03T02:33:21.025Z",
      "chapterId": "b4468648-883c-481a-841f-6dd52fb2216f"
    },
    {
      "id": "08ccdac0-1d1b-4071-9fa5-deb4741c98f5",
      "text": "bên bàn thờ của Chúa !",
      "label": "4",
      "number": 4,
      "subVerseIndex": 3,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:21.039Z",
      "updatedAt": "2025-09-03T02:33:21.039Z",
      "chapterId": "b4468648-883c-481a-841f-6dd52fb2216f"
    },
    {
      "id": "f8279760-574b-4fd7-beeb-9e9a5c4a35ef",
      "text": "Phúc thay người ở trong thánh điện",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:21.067Z",
      "updatedAt": "2025-09-03T02:33:21.067Z",
      "chapterId": "b4468648-883c-481a-841f-6dd52fb2216f"
    },
    {
      "id": "2d1008f2-5898-4daf-b9f2-674fe439b3b2",
      "text": "họ luôn luôn được hát mừng Ngài.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:21.081Z",
      "updatedAt": "2025-09-03T02:33:21.081Z",
      "chapterId": "b4468648-883c-481a-841f-6dd52fb2216f"
    },
    {
      "id": "c7f5758d-3641-4a16-a97b-1f30aecc89ba",
      "text": "Phúc thay kẻ lấy Ngài làm sức mạnh,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:21.096Z",
      "updatedAt": "2025-09-03T02:33:21.096Z",
      "chapterId": "b4468648-883c-481a-841f-6dd52fb2216f"
    },
    {
      "id": "9d354cf7-8e65-4dd4-a8e2-457ccd1bea39",
      "text": "ấp ủ trong lòng giấc mộng hành hương.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:21.110Z",
      "updatedAt": "2025-09-03T02:33:21.110Z",
      "chapterId": "b4468648-883c-481a-841f-6dd52fb2216f"
    },
    {
      "id": "2a9e85a5-8a57-49a3-ba8b-6e3b3d83f52c",
      "text": "Lúc trẩy qua thung lũng Khô Cằn,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:21.124Z",
      "updatedAt": "2025-09-03T02:33:21.124Z",
      "chapterId": "b4468648-883c-481a-841f-6dd52fb2216f"
    },
    {
      "id": "74aa29b2-c2ee-47fe-88a7-f32f850f4352",
      "text": "họ biến nó thành nguồn suối nước,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:21.138Z",
      "updatedAt": "2025-09-03T02:33:21.138Z",
      "chapterId": "b4468648-883c-481a-841f-6dd52fb2216f"
    },
    {
      "id": "f17c65cf-04ad-4c5a-b9f7-d764b75919e3",
      "text": "mưa đầu mùa đổ phúc lộc chứa chan.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:21.152Z",
      "updatedAt": "2025-09-03T02:33:21.152Z",
      "chapterId": "b4468648-883c-481a-841f-6dd52fb2216f"
    },
    {
      "id": "cc234719-701d-4b63-8222-5ef248fdc5a7",
      "text": "Càng tiến lên, họ càng mạnh bước",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:21.179Z",
      "updatedAt": "2025-09-03T02:33:21.179Z",
      "chapterId": "b4468648-883c-481a-841f-6dd52fb2216f"
    },
    {
      "id": "dd271abd-e956-4f35-9cc8-b0aea4999306",
      "text": "đến chiêm ngưỡng Chúa Trời ngự trên núi Xi-on.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:21.193Z",
      "updatedAt": "2025-09-03T02:33:21.193Z",
      "chapterId": "b4468648-883c-481a-841f-6dd52fb2216f"
    },
    {
      "id": "4daef95d-caf9-42b7-86e5-c7ac59e4af4a",
      "text": "Lạy CHÚA là Chúa Tể càn khôn,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:21.236Z",
      "updatedAt": "2025-09-03T02:33:21.236Z",
      "chapterId": "b4468648-883c-481a-841f-6dd52fb2216f"
    },
    {
      "id": "47569d53-35ef-4663-9355-52c8d32bb4a4",
      "text": "xin đoái nghe lời con cầu nguyện.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:21.250Z",
      "updatedAt": "2025-09-03T02:33:21.250Z",
      "chapterId": "b4468648-883c-481a-841f-6dd52fb2216f"
    },
    {
      "id": "d08ec841-56a3-487f-b145-fd179e70d355",
      "text": "Xin lắng tai, lạy Chúa nhà Gia-cóp.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:21.270Z",
      "updatedAt": "2025-09-03T02:33:21.270Z",
      "chapterId": "b4468648-883c-481a-841f-6dd52fb2216f"
    },
    {
      "id": "b9fa7592-f0c0-4038-b62c-efc67aa4ec03",
      "text": "Lạy Chúa là khiên mộc chở che,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:21.312Z",
      "updatedAt": "2025-09-03T02:33:21.312Z",
      "chapterId": "b4468648-883c-481a-841f-6dd52fb2216f"
    },
    {
      "id": "14865919-3f01-4306-a4a0-61eb440b1438",
      "text": "xin thương xem nhìn đến",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:21.326Z",
      "updatedAt": "2025-09-03T02:33:21.326Z",
      "chapterId": "b4468648-883c-481a-841f-6dd52fb2216f"
    },
    {
      "id": "9c4a4cc2-8a92-44a1-afcf-da75f78ab04b",
      "text": "gương mặt đấng Ngài đã xức dầu.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:21.340Z",
      "updatedAt": "2025-09-03T02:33:21.340Z",
      "chapterId": "b4468648-883c-481a-841f-6dd52fb2216f"
    },
    {
      "id": "d9c6abde-870c-4929-ba55-6409bfe83d58",
      "text": "Một ngày tại khuôn viên thánh điện",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:21.353Z",
      "updatedAt": "2025-09-03T02:33:21.353Z",
      "chapterId": "b4468648-883c-481a-841f-6dd52fb2216f"
    },
    {
      "id": "c684143f-9cb0-48d9-87df-239b1d4b333f",
      "text": "quý hơn cả ngàn ngày.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:21.368Z",
      "updatedAt": "2025-09-03T02:33:21.368Z",
      "chapterId": "b4468648-883c-481a-841f-6dd52fb2216f"
    },
    {
      "id": "6366eb64-733e-4209-9026-f030cbbafed7",
      "text": "Thà con ở cổng đền Thiên Chúa",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:21.383Z",
      "updatedAt": "2025-09-03T02:33:21.383Z",
      "chapterId": "b4468648-883c-481a-841f-6dd52fb2216f"
    },
    {
      "id": "c5c4ae6b-7a4a-430a-bfa0-b0ac7bf51c7f",
      "text": "vẫn còn hơn sống trong trại ác nhân !",
      "label": "11",
      "number": 11,
      "subVerseIndex": 3,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:21.397Z",
      "updatedAt": "2025-09-03T02:33:21.397Z",
      "chapterId": "b4468648-883c-481a-841f-6dd52fb2216f"
    },
    {
      "id": "befbed33-8c34-4935-a6cc-9fe56722d620",
      "text": "Thiên Chúa là vầng thái dương, là thuẫn đỡ,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:21.411Z",
      "updatedAt": "2025-09-03T02:33:21.411Z",
      "chapterId": "b4468648-883c-481a-841f-6dd52fb2216f"
    },
    {
      "id": "01f7b221-4427-45ef-b68c-cfd4ec410b5d",
      "text": "CHÚA tặng ban ân huệ với vinh quang.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:21.424Z",
      "updatedAt": "2025-09-03T02:33:21.424Z",
      "chapterId": "b4468648-883c-481a-841f-6dd52fb2216f"
    },
    {
      "id": "f66780ce-79d9-49e5-82d5-07e20bb585f6",
      "text": "Ai sống đời trọn hảo, Người chẳng nỡ từ chối ơn lành.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 2,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:21.439Z",
      "updatedAt": "2025-09-03T02:33:21.439Z",
      "chapterId": "b4468648-883c-481a-841f-6dd52fb2216f"
    },
    {
      "id": "cac354b8-7d71-4cf1-b49d-94322eb4c5f5",
      "text": "Lạy Chúa Tể càn khôn, phúc thay người tin tưởng vào Chúa !",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:21.452Z",
      "updatedAt": "2025-09-03T02:33:21.452Z",
      "chapterId": "b4468648-883c-481a-841f-6dd52fb2216f"
    }
  ],
  "marks": [
    {
      "id": "0873cb34-8047-4645-8d49-632602354e9a",
      "content": "Trong *Tv về Xi-on* này, tác giả là một người đạo đức sống xa Đền Thờ Giê-ru-sa-lem, lòng những mòn mỏi đợi trông ngày thấy lại Đền Thờ *khả ái*, nơi *Chúa Trời hằng sống* ngự trị. Tv 84 có một cấu trúc như sau : **1**) Tác giả khao khát mãnh liệt được trở về Xi-on vào cung điện của Thiên Chúa (cc. 2-4) ; **2**) Số phận may mắn và hạnh phúc của khách hành hương trẩy hội Đền Thánh Giê-ru-sa-lem (cc. 5-8) ; **3**) Lời cầu cho nhà vua (cc. 9-10) ; **4**) Ca ngợi Đền Thờ, nơi Thiên Chúa ban phát ân huệ và phúc lành cho các tín hữu của Người (cc. 11-13).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 32,
      "endOffset": 32,
      "createdAt": "2025-09-03T02:33:20.872Z",
      "updatedAt": "2025-09-03T02:33:20.872Z",
      "targetId": "c63b9e55-e4bd-4247-b026-6a28fe1dbaad",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "b4468648-883c-481a-841f-6dd52fb2216f"
    },
    {
      "id": "7ed7709f-a5ac-48a4-9733-4249b34d3e0b",
      "content": "Tv 42,3-9",
