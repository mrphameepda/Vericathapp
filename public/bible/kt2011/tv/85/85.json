{
  "chapter": {
    "id": "92c54924-c21b-4171-a77b-e1726b609b0c",
    "number": 85,
    "createdAt": "2025-09-03T01:07:51.661Z",
    "updatedAt": "2025-09-03T01:07:51.661Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "6351059b-c727-4f0f-8189-f0f8247a4cbf",
      "text": "*Phần ca trưởng. Của con cái ông Cô-rắc. Thánh vịnh.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:33:26.793Z",
      "updatedAt": "2025-09-03T02:33:26.793Z",
      "chapterId": "92c54924-c21b-4171-a77b-e1726b609b0c"
    },
    {
      "id": "59a3ac63-c66b-45ba-a53a-8efbbb201c8e",
      "text": "Lạy CHÚA, Ngài đã tỏ lòng thương thánh địa,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:26.863Z",
      "updatedAt": "2025-09-03T02:33:26.863Z",
      "chapterId": "92c54924-c21b-4171-a77b-e1726b609b0c"
    },
    {
      "id": "529263b0-5efa-46b8-b3ed-3a748f3ba0f6",
      "text": "tù nhân nhà Gia-cóp, Ngài dẫn đưa về.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:26.877Z",
      "updatedAt": "2025-09-03T02:33:26.877Z",
      "chapterId": "92c54924-c21b-4171-a77b-e1726b609b0c"
    },
    {
      "id": "fed516a5-30ac-45df-b4ed-1026a4a0044f",
      "text": "Tội vạ dân Ngài, Ngài tha thứ, mọi lỗi lầm, cũng phủ lấp đi.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:26.912Z",
      "updatedAt": "2025-09-03T02:33:26.912Z",
      "chapterId": "92c54924-c21b-4171-a77b-e1726b609b0c"
    },
    {
      "id": "c587a1bd-921b-4be4-90cc-a4939e03c40d",
      "text": "Ngài dẹp trận lôi đình và nguôi cơn thịnh nộ.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:26.926Z",
      "updatedAt": "2025-09-03T02:33:26.926Z",
      "chapterId": "92c54924-c21b-4171-a77b-e1726b609b0c"
    },
    {
      "id": "374bf571-b61d-4dbe-9bd3-9ff075b9b311",
      "text": "Lạy Chúa Trời, Đấng cứu độ chúng con,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:26.940Z",
      "updatedAt": "2025-09-03T02:33:26.940Z",
      "chapterId": "92c54924-c21b-4171-a77b-e1726b609b0c"
    },
    {
      "id": "1c6b5938-57cd-4ab9-abe6-216c08f8571e",
      "text": "xin dẫn chúng con về, đừng hận chúng con nữa.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:26.955Z",
      "updatedAt": "2025-09-03T02:33:26.955Z",
      "chapterId": "92c54924-c21b-4171-a77b-e1726b609b0c"
    },
    {
      "id": "043c1315-9eb0-4249-8335-b0d8076a1980",
      "text": "Phải chăng Ngài giận mãi không thôi,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:26.968Z",
      "updatedAt": "2025-09-03T02:33:26.968Z",
      "chapterId": "92c54924-c21b-4171-a77b-e1726b609b0c"
    },
    {
      "id": "eb6b3e94-80f7-4d5e-8b5c-f0b8223cbf88",
      "text": "đời lại đời cứ nuôi cơn thịnh nộ ?",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:26.982Z",
      "updatedAt": "2025-09-03T02:33:26.982Z",
      "chapterId": "92c54924-c21b-4171-a77b-e1726b609b0c"
    },
    {
      "id": "c2d34c3a-5718-4ad6-b176-e0b6274a26fb",
      "text": "Nào chẳng phải chính Ngài",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:26.996Z",
      "updatedAt": "2025-09-03T02:33:26.996Z",
      "chapterId": "92c54924-c21b-4171-a77b-e1726b609b0c"
    },
    {
      "id": "d7c789b0-3d1f-4a29-85e0-75a08d318d82",
      "text": "sẽ lại làm cho chúng con được sống",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:27.010Z",
      "updatedAt": "2025-09-03T02:33:27.010Z",
      "chapterId": "92c54924-c21b-4171-a77b-e1726b609b0c"
    },
    {
      "id": "dd189edf-3560-4e7f-a060-c86c85e6bca8",
      "text": "để dân riêng được hoan hỷ trong Ngài ?",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:27.026Z",
      "updatedAt": "2025-09-03T02:33:27.026Z",
      "chapterId": "92c54924-c21b-4171-a77b-e1726b609b0c"
    },
    {
      "id": "a9f05720-1ede-46d4-ad62-a771cd1c0f50",
      "text": "Lạy CHÚA, xin tỏ cho chúng con thấy tình thương của Chúa,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:27.040Z",
      "updatedAt": "2025-09-03T02:33:27.040Z",
      "chapterId": "92c54924-c21b-4171-a77b-e1726b609b0c"
    },
    {
      "id": "613af70a-7cdf-4e29-ad45-8ab0c8b80ba2",
      "text": "và ban ơn cứu độ cho chúng con.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:27.054Z",
      "updatedAt": "2025-09-03T02:33:27.054Z",
      "chapterId": "92c54924-c21b-4171-a77b-e1726b609b0c"
    },
    {
      "id": "bab2607c-81ef-490d-805e-146356644b56",
      "text": "Tôi lắng nghe điều Thiên Chúa phán,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:27.068Z",
      "updatedAt": "2025-09-03T02:33:27.068Z",
      "chapterId": "92c54924-c21b-4171-a77b-e1726b609b0c"
    },
    {
      "id": "36bcb9c0-9d25-4c3d-a547-74c23b67b629",
      "text": "điều CHÚA phán là lời chúc bình an",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:27.082Z",
      "updatedAt": "2025-09-03T02:33:27.082Z",
      "chapterId": "92c54924-c21b-4171-a77b-e1726b609b0c"
    },
    {
      "id": "b7884991-e339-4867-9284-364cbcec8225",
      "text": "cho dân Người, cho kẻ trung hiếu",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:27.095Z",
      "updatedAt": "2025-09-03T02:33:27.095Z",
      "chapterId": "92c54924-c21b-4171-a77b-e1726b609b0c"
    },
    {
      "id": "d5927a22-2692-40a4-b6c0-3997103f863f",
      "text": "và những ai hướng lòng trí về Người.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 3,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:27.110Z",
      "updatedAt": "2025-09-03T02:33:27.110Z",
      "chapterId": "92c54924-c21b-4171-a77b-e1726b609b0c"
    },
    {
      "id": "aa561262-d71d-43dd-8779-72a122cf3e02",
      "text": "Chúa sẵn sàng ban ơn cứu độ cho ai kính sợ Chúa,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:27.124Z",
      "updatedAt": "2025-09-03T02:33:27.124Z",
      "chapterId": "92c54924-c21b-4171-a77b-e1726b609b0c"
    },
    {
      "id": "1b12e7c7-dc25-4f15-ae61-1b233995ded8",
      "text": "để vinh quang của Người hằng chiếu toả trên đất nước chúng ta.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:27.139Z",
      "updatedAt": "2025-09-03T02:33:27.139Z",
      "chapterId": "92c54924-c21b-4171-a77b-e1726b609b0c"
    },
    {
      "id": "bdf29bd8-f420-44b5-b02c-c58d21bfa2bd",
      "text": "Tín nghĩa ân tình nay hội ngộ,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:27.182Z",
      "updatedAt": "2025-09-03T02:33:27.182Z",
      "chapterId": "92c54924-c21b-4171-a77b-e1726b609b0c"
    },
    {
      "id": "96e70431-df1c-44e4-801e-23276ace016a",
      "text": "hoà bình công lý đã giao duyên.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:27.196Z",
      "updatedAt": "2025-09-03T02:33:27.196Z",
      "chapterId": "92c54924-c21b-4171-a77b-e1726b609b0c"
    },
    {
      "id": "92a2ef1c-b902-4302-be60-0ca73fef2b37",
      "text": "Tín nghĩa mọc lên từ đất thấp,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:27.209Z",
      "updatedAt": "2025-09-03T02:33:27.209Z",
      "chapterId": "92c54924-c21b-4171-a77b-e1726b609b0c"
    },
    {
      "id": "d6b7b647-cf03-4a08-bfba-92a7e73f691e",
      "text": "công lý nhìn xuống tự trời cao.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:27.224Z",
      "updatedAt": "2025-09-03T02:33:27.224Z",
      "chapterId": "92c54924-c21b-4171-a77b-e1726b609b0c"
    },
    {
      "id": "18412955-779b-4ee6-ad64-89f2eedc693a",
      "text": "Vâng, chính CHÚA sẽ tặng ban phúc lộc",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:27.253Z",
      "updatedAt": "2025-09-03T02:33:27.253Z",
      "chapterId": "92c54924-c21b-4171-a77b-e1726b609b0c"
    },
    {
      "id": "90a14839-bb56-4bc5-89d0-55237b028b46",
      "text": "và đất chúng ta trổ sinh hoa trái.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:27.267Z",
      "updatedAt": "2025-09-03T02:33:27.267Z",
      "chapterId": "92c54924-c21b-4171-a77b-e1726b609b0c"
    },
    {
      "id": "14c49cc3-21b2-4047-bfd4-a247d83a9f75",
      "text": "Công lý đi tiền phong trước mặt Người,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:27.281Z",
      "updatedAt": "2025-09-03T02:33:27.281Z",
      "chapterId": "92c54924-c21b-4171-a77b-e1726b609b0c"
    },
    {
      "id": "5ddb5d6d-e216-4677-b432-9d9cebe4d812",
      "text": "mở lối cho Người đặt bước chân.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:27.296Z",
      "updatedAt": "2025-09-03T02:33:27.296Z",
      "chapterId": "92c54924-c21b-4171-a77b-e1726b609b0c"
    }
  ],
