{
  "chapter": {
    "id": "d73b086f-d759-43ae-8504-0c68bf0bd8bb",
    "number": 86,
    "createdAt": "2025-09-03T01:07:51.661Z",
    "updatedAt": "2025-09-03T01:07:51.661Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "d1c3193f-9848-4f78-97a7-ed2869a80c99",
      "text": "*Lời cầu khẩn. Của vua Đa-vít.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:33:32.409Z",
      "updatedAt": "2025-09-03T02:33:32.409Z",
      "chapterId": "d73b086f-d759-43ae-8504-0c68bf0bd8bb"
    },
    {
      "id": "c726b99b-7489-483d-bb69-5a6fa089fc7c",
      "text": "Lạy CHÚA, xin lắng tai và đáp lời con,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:32.475Z",
      "updatedAt": "2025-09-03T02:33:32.475Z",
      "chapterId": "d73b086f-d759-43ae-8504-0c68bf0bd8bb"
    },
    {
      "id": "4f3a463b-9d01-4284-b079-ba38cdc3a7e0",
      "text": "vì thân con nghèo hèn túng quẫn.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:32.489Z",
      "updatedAt": "2025-09-03T02:33:32.489Z",
      "chapterId": "d73b086f-d759-43ae-8504-0c68bf0bd8bb"
    },
    {
      "id": "2e133c73-cc1e-4e8e-a444-5f45bd68931c",
      "text": "Xin CHÚA bảo toàn sinh mạng con, bởi vì con trung hiếu.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:32.516Z",
      "updatedAt": "2025-09-03T02:33:32.516Z",
      "chapterId": "d73b086f-d759-43ae-8504-0c68bf0bd8bb"
    },
    {
      "id": "48ce1534-6c97-4bb2-92ce-1a7eeb846e24",
      "text": "Xin cứu độ tôi tớ Ngài đây hằng tin tưởng nơi Ngài.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:32.544Z",
      "updatedAt": "2025-09-03T02:33:32.544Z",
      "chapterId": "d73b086f-d759-43ae-8504-0c68bf0bd8bb"
    },
    {
      "id": "bd9c4ada-425c-4421-8307-c5a67174a2ae",
      "text": "Chính Ngài là Thiên Chúa của con.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:32.572Z",
      "updatedAt": "2025-09-03T02:33:32.572Z",
      "chapterId": "d73b086f-d759-43ae-8504-0c68bf0bd8bb"
    },
    {
      "id": "5c603be8-aa01-48a7-9acb-4e6538cb33db",
      "text": "Xin rủ lòng thương con, lạy Chúa :",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:32.589Z",
      "updatedAt": "2025-09-03T02:33:32.589Z",
      "chapterId": "d73b086f-d759-43ae-8504-0c68bf0bd8bb"
    },
    {
      "id": "962b5b86-8b49-4bce-b952-96c3e479dc1c",
      "text": "con kêu con gọi Chúa suốt ngày.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:32.616Z",
      "updatedAt": "2025-09-03T02:33:32.616Z",
      "chapterId": "d73b086f-d759-43ae-8504-0c68bf0bd8bb"
    },
    {
      "id": "7f53a91b-40de-4e58-a974-0b66bebc0c0c",
      "text": "Lạy Chúa, xin làm cho con được vui thoả,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:32.630Z",
      "updatedAt": "2025-09-03T02:33:32.630Z",
      "chapterId": "d73b086f-d759-43ae-8504-0c68bf0bd8bb"
    },
    {
      "id": "5ebdb160-616f-4c09-b0ba-0d75379dbc16",
      "text": "vì con nâng tâm hồn lên tới Chúa.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:32.643Z",
      "updatedAt": "2025-09-03T02:33:32.643Z",
      "chapterId": "d73b086f-d759-43ae-8504-0c68bf0bd8bb"
    },
    {
      "id": "1cc81c51-c61c-4d1e-960b-4b48c685c701",
      "text": "Lạy Chúa, Ngài nhân hậu khoan hồng,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:32.670Z",
      "updatedAt": "2025-09-03T02:33:32.670Z",
      "chapterId": "d73b086f-d759-43ae-8504-0c68bf0bd8bb"
    },
    {
      "id": "4a93236c-3b93-4b10-8454-62a98564c50d",
      "text": "giàu tình thương với mọi kẻ kêu xin ;",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:32.685Z",
      "updatedAt": "2025-09-03T02:33:32.685Z",
      "chapterId": "d73b086f-d759-43ae-8504-0c68bf0bd8bb"
    },
    {
      "id": "ecd50b73-f95d-4628-aaac-73989b4c5869",
      "text": "lạy CHÚA, xin lắng nghe lời con cầu khẩn,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:32.713Z",
      "updatedAt": "2025-09-03T02:33:32.713Z",
      "chapterId": "d73b086f-d759-43ae-8504-0c68bf0bd8bb"
    },
    {
      "id": "c6301a44-b960-4a2e-a95e-c0235fc40b26",
      "text": "tiếng con van nài, xin để ý lưu tâm.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:32.727Z",
      "updatedAt": "2025-09-03T02:33:32.727Z",
      "chapterId": "d73b086f-d759-43ae-8504-0c68bf0bd8bb"
    },
    {
      "id": "0bfed3d8-804b-4b3a-9f87-3dd30fb0da43",
      "text": "Lâm cảnh ngặt nghèo, con kêu lên Chúa,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:32.741Z",
      "updatedAt": "2025-09-03T02:33:32.741Z",
      "chapterId": "d73b086f-d759-43ae-8504-0c68bf0bd8bb"
    },
    {
      "id": "eb31c26c-c53e-4847-8846-4b5ef464aa67",
      "text": "vì Chúa vẫn đáp lời.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:32.755Z",
      "updatedAt": "2025-09-03T02:33:32.755Z",
      "chapterId": "d73b086f-d759-43ae-8504-0c68bf0bd8bb"
    },
    {
      "id": "d6dd5af9-0e81-4c4a-ab24-0c701b7e4640",
      "text": "Không một thần linh sánh kịp Ngài, lạy Chúa,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:32.769Z",
      "updatedAt": "2025-09-03T02:33:32.769Z",
      "chapterId": "d73b086f-d759-43ae-8504-0c68bf0bd8bb"
    },
    {
      "id": "f4cf4eca-511a-4458-a389-f315b660ab0d",
      "text": "việc Ngài làm, quả thật vô song.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:32.797Z",
      "updatedAt": "2025-09-03T02:33:32.797Z",
      "chapterId": "d73b086f-d759-43ae-8504-0c68bf0bd8bb"
    },
    {
      "id": "eeaa1880-adee-4d70-a355-ac094e82a41b",
      "text": "Lạy Chúa, muôn dân chính tay Ngài tạo dựng",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:32.825Z",
      "updatedAt": "2025-09-03T02:33:32.825Z",
      "chapterId": "d73b086f-d759-43ae-8504-0c68bf0bd8bb"
    },
    {
      "id": "c385dcaf-eb78-4706-b2f8-b42a3fe69443",
      "text": "sẽ về phủ phục trước Thánh Nhan, và tôn vinh danh Ngài.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:32.839Z",
      "updatedAt": "2025-09-03T02:33:32.839Z",
      "chapterId": "d73b086f-d759-43ae-8504-0c68bf0bd8bb"
    },
    {
      "id": "c7f4acca-cc6a-497f-b2e8-ccec6a80ff47",
      "text": "Vì Ngài thật cao cả, và làm nên những việc lạ lùng ;",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:32.866Z",
      "updatedAt": "2025-09-03T02:33:32.866Z",
      "chapterId": "d73b086f-d759-43ae-8504-0c68bf0bd8bb"
    },
    {
      "id": "94d8215d-4d6c-4ef9-a872-67248378f359",
      "text": "chỉ một mình Ngài là Thiên Chúa.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:32.880Z",
      "updatedAt": "2025-09-03T02:33:32.880Z",
      "chapterId": "d73b086f-d759-43ae-8504-0c68bf0bd8bb"
    },
    {
      "id": "c0b6ff5b-3ed4-4690-a1e2-bb150c5c25d9",
      "text": "Xin dạy con đường lối Ngài, lạy CHÚA,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:32.894Z",
      "updatedAt": "2025-09-03T02:33:32.894Z",
      "chapterId": "d73b086f-d759-43ae-8504-0c68bf0bd8bb"
    },
    {
      "id": "b6cbf524-5673-4b05-9032-dac46fbe316e",
      "text": "để con vững bước theo chân lý của Ngài.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:32.922Z",
      "updatedAt": "2025-09-03T02:33:32.922Z",
      "chapterId": "d73b086f-d759-43ae-8504-0c68bf0bd8bb"
    },
    {
      "id": "e3dee6ed-5a7e-4829-aac7-972a889da0d6",
      "text": "Xin Chúa hướng lòng con,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:32.936Z",
      "updatedAt": "2025-09-03T02:33:32.936Z",
      "chapterId": "d73b086f-d759-43ae-8504-0c68bf0bd8bb"
    },
    {
      "id": "26109bd5-b28b-4692-a255-176907625435",
      "text": "để con biết một niềm kính tôn Danh Thánh.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 3,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:32.963Z",
      "updatedAt": "2025-09-03T02:33:32.963Z",
      "chapterId": "d73b086f-d759-43ae-8504-0c68bf0bd8bb"
    },
    {
      "id": "644c82e1-0997-4c31-ac31-c0e339c3bd18",
      "text": "Lạy Chúa là Thiên Chúa con thờ, con hết lòng cảm tạ,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:32.977Z",
      "updatedAt": "2025-09-03T02:33:32.977Z",
      "chapterId": "d73b086f-d759-43ae-8504-0c68bf0bd8bb"
    },
    {
      "id": "c93ddd6b-ddd5-4672-b666-b63eb9c92b39",
      "text": "Thánh danh Ngài, con mãi mãi tôn vinh,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:32.992Z",
      "updatedAt": "2025-09-03T02:33:32.992Z",
      "chapterId": "d73b086f-d759-43ae-8504-0c68bf0bd8bb"
    },
    {
      "id": "d2334bdb-b3b0-433b-a625-c84588ad6af8",
      "text": "vì tình Chúa thương con như trời như biển,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:33.006Z",
      "updatedAt": "2025-09-03T02:33:33.006Z",
      "chapterId": "d73b086f-d759-43ae-8504-0c68bf0bd8bb"
    },
    {
      "id": "4ff195e2-6826-4c89-b703-6643a9c5c6ff",
      "text": "Ngài đã kéo con ra khỏi vực thẳm âm ty.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:33.020Z",
      "updatedAt": "2025-09-03T02:33:33.020Z",
      "chapterId": "d73b086f-d759-43ae-8504-0c68bf0bd8bb"
    },
    {
      "id": "fca14224-0364-486d-a3e6-4a440c204e72",
      "text": "Lạy Thiên Chúa, phường kiêu ngạo nổi lên chống đối,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:33.048Z",
      "updatedAt": "2025-09-03T02:33:33.048Z",
      "chapterId": "d73b086f-d759-43ae-8504-0c68bf0bd8bb"
    },
    {
      "id": "551de18c-54f5-454e-907c-56636ffcf656",
      "text": "bè lũ hung tàn tìm hại mạng sống con :",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:33.062Z",
      "updatedAt": "2025-09-03T02:33:33.062Z",
      "chapterId": "d73b086f-d759-43ae-8504-0c68bf0bd8bb"
    },
    {
      "id": "33c27b5e-45ba-405e-a0a0-0ba8700928f6",
      "text": "chúng đâu có kể chi đến Ngài.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 2,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:33.075Z",
      "updatedAt": "2025-09-03T02:33:33.075Z",
      "chapterId": "d73b086f-d759-43ae-8504-0c68bf0bd8bb"
    },
    {
      "id": "de1dfb19-05b8-42f5-8f49-27eb867981e2",
      "text": "Phần Ngài, muôn lạy Chúa,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:33.090Z",
      "updatedAt": "2025-09-03T02:33:33.090Z",
      "chapterId": "d73b086f-d759-43ae-8504-0c68bf0bd8bb"
    },
    {
      "id": "bcc223a0-06b5-419c-a4bf-b1bb822e5b56",
      "text": "Ngài là Thiên Chúa nhân hậu từ bi,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:33.104Z",
      "updatedAt": "2025-09-03T02:33:33.104Z",
      "chapterId": "d73b086f-d759-43ae-8504-0c68bf0bd8bb"
    },
    {
      "id": "85975141-5827-4c68-a54a-6a338bec297e",
      "text": "Ngài chậm giận, lại giàu tình thương và lòng thành tín.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 2,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:33.132Z",
      "updatedAt": "2025-09-03T02:33:33.132Z",
      "chapterId": "d73b086f-d759-43ae-8504-0c68bf0bd8bb"
    },
    {
      "id": "fb6eea3f-d228-41f1-8b7a-a12e839a8de2",
      "text": "Xin đoái nhìn và xót thương con,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:33.145Z",
      "updatedAt": "2025-09-03T02:33:33.145Z",
      "chapterId": "d73b086f-d759-43ae-8504-0c68bf0bd8bb"
    },
    {
      "id": "53a7e650-f519-4742-951e-03858a68326f",
      "text": "ban sức mạnh của Ngài và xuống ơn cứu độ",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:33.173Z",
      "updatedAt": "2025-09-03T02:33:33.173Z",
      "chapterId": "d73b086f-d759-43ae-8504-0c68bf0bd8bb"
    },
    {
      "id": "4f1a5843-1780-4ada-b15e-c9d9d3a1787f",
      "text": "cho tôi tớ Ngài đây, con của nữ tỳ Ngài.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 2,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:33.187Z",
