{
  "chapter": {
    "id": "123cbc80-5562-41e9-a66d-1b0209a46731",
    "number": 88,
    "createdAt": "2025-09-03T01:07:51.661Z",
    "updatedAt": "2025-09-03T01:07:51.661Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "2f84c9b4-a8e3-4838-8a0a-dccfb1d2573d",
      "text": "*Thánh ca. Thánh vịnh. Của con cái ông Cô-rắc. Phần ca trưởng. Lúc bệnh hoạn. Lúc sầu muộn. Thi khúc. Của ông Hê-man, người Ét-ra.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:33:44.709Z",
      "updatedAt": "2025-09-03T02:33:44.709Z",
      "chapterId": "123cbc80-5562-41e9-a66d-1b0209a46731"
    },
    {
      "id": "89a89151-6f29-41be-aaa8-fb2b5375bdbc",
      "text": "Lạy CHÚA là Thiên Chúa cứu độ con,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:44.794Z",
      "updatedAt": "2025-09-03T02:33:44.794Z",
      "chapterId": "123cbc80-5562-41e9-a66d-1b0209a46731"
    },
    {
      "id": "c4697947-1431-4ef2-a072-85f635a7e010",
      "text": "trước Thánh Nhan, đêm ngày con kêu cứu.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:44.808Z",
      "updatedAt": "2025-09-03T02:33:44.808Z",
      "chapterId": "123cbc80-5562-41e9-a66d-1b0209a46731"
    },
    {
      "id": "ae053f2e-e496-4e4f-868b-c809d98b4f63",
      "text": "Nguyện cho lời kinh vọng tới Ngài,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:44.822Z",
      "updatedAt": "2025-09-03T02:33:44.822Z",
      "chapterId": "123cbc80-5562-41e9-a66d-1b0209a46731"
    },
    {
      "id": "4649ef09-4042-4332-85ad-4b617e8c4258",
      "text": "xin lắng nghe tiếng lòng thổn thức.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:44.836Z",
      "updatedAt": "2025-09-03T02:33:44.836Z",
      "chapterId": "123cbc80-5562-41e9-a66d-1b0209a46731"
    },
    {
      "id": "787bbf8f-ab63-4d5f-88d6-75acd73aeebf",
      "text": "Vì hồn con ngập tràn đau khổ,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:44.849Z",
      "updatedAt": "2025-09-03T02:33:44.849Z",
      "chapterId": "123cbc80-5562-41e9-a66d-1b0209a46731"
    },
    {
      "id": "9138206c-6930-464d-a937-aa0edf2e6ac0",
      "text": "mạng sống con âm phủ gần kề,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:44.863Z",
      "updatedAt": "2025-09-03T02:33:44.863Z",
      "chapterId": "123cbc80-5562-41e9-a66d-1b0209a46731"
    },
    {
      "id": "6da231fc-f27d-4326-97f2-dbdef8423c59",
      "text": "thân kể như đã vào phần mộ,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:44.892Z",
      "updatedAt": "2025-09-03T02:33:44.892Z",
      "chapterId": "123cbc80-5562-41e9-a66d-1b0209a46731"
    },
    {
      "id": "d459aa69-de0f-4a2e-adb9-4f57bc519cbd",
      "text": "ví tựa người kiệt sức còn chi !",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:44.905Z",
      "updatedAt": "2025-09-03T02:33:44.905Z",
      "chapterId": "123cbc80-5562-41e9-a66d-1b0209a46731"
    },
    {
      "id": "d1717aa7-9270-4ca8-99f5-bac8c9948add",
      "text": "Con nằm đây giữa bao người chết,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:44.919Z",
      "updatedAt": "2025-09-03T02:33:44.919Z",
      "chapterId": "123cbc80-5562-41e9-a66d-1b0209a46731"
    },
    {
      "id": "81d60519-dce6-43a6-be67-3a7c26cc8661",
      "text": "như các tử thi vùi trong mồ mả",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:44.933Z",
      "updatedAt": "2025-09-03T02:33:44.933Z",
      "chapterId": "123cbc80-5562-41e9-a66d-1b0209a46731"
    },
    {
      "id": "7397aa19-85b1-4e91-9b73-a59ec3e7eda7",
      "text": "đã bị Chúa quên đi, và không được tay Ngài săn sóc.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:44.946Z",
      "updatedAt": "2025-09-03T02:33:44.946Z",
      "chapterId": "123cbc80-5562-41e9-a66d-1b0209a46731"
    },
    {
      "id": "8973ae39-d2fb-474b-af9e-2581f2b6c006",
      "text": "Chúa hạ con xuống tận đáy huyệt sâu,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:44.960Z",
      "updatedAt": "2025-09-03T02:33:44.960Z",
      "chapterId": "123cbc80-5562-41e9-a66d-1b0209a46731"
    },
    {
      "id": "eff797b7-8f42-4de5-835f-e5546994d969",
      "text": "giữa chốn tối tăm, giữa lòng vực thẳm.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:44.974Z",
      "updatedAt": "2025-09-03T02:33:44.974Z",
      "chapterId": "123cbc80-5562-41e9-a66d-1b0209a46731"
    },
    {
      "id": "fe29c65e-58b7-413c-ba0f-2765c8ea3b56",
      "text": "Cơn giận Chúa đè nặng thân con",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:44.988Z",
      "updatedAt": "2025-09-03T02:33:44.988Z",
      "chapterId": "123cbc80-5562-41e9-a66d-1b0209a46731"
    },
    {
      "id": "f0572a96-2b59-4112-b9ec-dade249f03c2",
      "text": "như sóng cồn xô đẩy dập vùi.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:45.002Z",
      "updatedAt": "2025-09-03T02:33:45.002Z",
      "chapterId": "123cbc80-5562-41e9-a66d-1b0209a46731"
    },
    {
      "id": "1127def0-d23d-45a0-bfda-dec4de6d1384",
      "text": "Chúa làm cho bạn bè xa lánh",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:45.030Z",
      "updatedAt": "2025-09-03T02:33:45.030Z",
      "chapterId": "123cbc80-5562-41e9-a66d-1b0209a46731"
    },
    {
      "id": "285e496a-4be3-43c3-b62c-33609cacd053",
      "text": "và coi con như đồ ghê tởm.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:45.044Z",
      "updatedAt": "2025-09-03T02:33:45.044Z",
      "chapterId": "123cbc80-5562-41e9-a66d-1b0209a46731"
    },
    {
      "id": "b5d51d91-72e2-48e4-9c44-a1d554dadaf5",
      "text": "Con bị giam cầm không thể thoát ra,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:45.058Z",
      "updatedAt": "2025-09-03T02:33:45.058Z",
      "chapterId": "123cbc80-5562-41e9-a66d-1b0209a46731"
    },
    {
      "id": "3b7ec3e7-4192-47b3-8aa0-5a91c4f6cede",
      "text": "mắt mờ đi vì quá nhiều đau khổ.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:45.086Z",
      "updatedAt": "2025-09-03T02:33:45.086Z",
      "chapterId": "123cbc80-5562-41e9-a66d-1b0209a46731"
    },
    {
      "id": "26a5c7e4-ad41-4ab0-8ba2-7737d2d8c503",
      "text": "Lạy CHÚA, suốt cả ngày con kêu lên Chúa",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:45.099Z",
      "updatedAt": "2025-09-03T02:33:45.099Z",
      "chapterId": "123cbc80-5562-41e9-a66d-1b0209a46731"
    },
    {
      "id": "1107d477-9389-4b80-99b2-e7a5df413f49",
      "text": "và giơ tay hướng thẳng về Ngài.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:45.113Z",
      "updatedAt": "2025-09-03T02:33:45.113Z",
      "chapterId": "123cbc80-5562-41e9-a66d-1b0209a46731"
    },
    {
      "id": "2f9c5342-594b-4f65-a3c5-eb22be1f8f2d",
      "text": "Chúa đâu làm phép lạ cho người đã mạng vong,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:45.127Z",
      "updatedAt": "2025-09-03T02:33:45.127Z",
      "chapterId": "123cbc80-5562-41e9-a66d-1b0209a46731"
    },
    {
      "id": "204ff8fb-7678-49a3-b0ef-e0fde18e3db3",
      "text": "âm hồn đâu trỗi dậy ca tụng Chúa bao giờ ?",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:45.141Z",
      "updatedAt": "2025-09-03T02:33:45.141Z",
      "chapterId": "123cbc80-5562-41e9-a66d-1b0209a46731"
    },
    {
      "id": "7b45d354-e8f1-480e-b9d1-a193ff6154c4",
      "text": "Trong mồ mả, ai nói về tình thương của Chúa ?",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:45.155Z",
      "updatedAt": "2025-09-03T02:33:45.155Z",
      "chapterId": "123cbc80-5562-41e9-a66d-1b0209a46731"
    },
    {
      "id": "77242a57-bf70-4821-ad6b-94c581187c04",
      "text": "Cõi âm ty, ai kể lại lòng thành tín của Ngài ?",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:45.183Z",
      "updatedAt": "2025-09-03T02:33:45.183Z",
      "chapterId": "123cbc80-5562-41e9-a66d-1b0209a46731"
    },
    {
      "id": "d8729269-fa87-4b92-8b58-53c85762c2eb",
      "text": "Những kỳ công Chúa, nơi tối tăm ai rõ ?",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:45.211Z",
      "updatedAt": "2025-09-03T02:33:45.211Z",
      "chapterId": "123cbc80-5562-41e9-a66d-1b0209a46731"
    },
    {
      "id": "07ff7ef1-e275-405e-bee9-4a2bcdea9e09",
      "text": "Đức công chính Ngài, chốn quên lãng ai hay ?",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:45.225Z",
      "updatedAt": "2025-09-03T02:33:45.225Z",
      "chapterId": "123cbc80-5562-41e9-a66d-1b0209a46731"
    },
    {
      "id": "c802dabc-5a73-4a78-ab58-5f3d198a39b6",
      "text": "Phần con đây, con kêu lên Ngài, lạy CHÚA,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:45.239Z",
      "updatedAt": "2025-09-03T02:33:45.239Z",
      "chapterId": "123cbc80-5562-41e9-a66d-1b0209a46731"
    },
    {
      "id": "4a918e61-82f1-4f2b-b8b6-6870581a6ac8",
      "text": "mới tinh sương đã chờ chực nguyện xin.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:45.253Z",
      "updatedAt": "2025-09-03T02:33:45.253Z",
      "chapterId": "123cbc80-5562-41e9-a66d-1b0209a46731"
    },
    {
      "id": "875b6137-b774-4d5a-bf12-286c73923f5e",
      "text": "Lạy CHÚA, thân con đây, Chúa nỡ nào ruồng rẫy,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:45.267Z",
      "updatedAt": "2025-09-03T02:33:45.267Z",
      "chapterId": "123cbc80-5562-41e9-a66d-1b0209a46731"
    },
    {
      "id": "59183985-78e1-4b89-9609-900296cf29c4",
      "text": "ẩn mặt đi mà chẳng đoái hoài.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:45.281Z",
      "updatedAt": "2025-09-03T02:33:45.281Z",
      "chapterId": "123cbc80-5562-41e9-a66d-1b0209a46731"
    },
    {
      "id": "de5d6fd4-8ba5-4f13-ba5a-0aec2b51c1f6",
      "text": "Từ thuở bé, con khổ đã nhiều và luôn ngắc ngoải,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:45.295Z",
      "updatedAt": "2025-09-03T02:33:45.295Z",
      "chapterId": "123cbc80-5562-41e9-a66d-1b0209a46731"
    },
    {
      "id": "f0fd846e-4dd2-46fb-ae19-781c9a232f5e",
      "text": "Chúa làm con kinh hãi, con hoá ra thẫn thờ.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:45.309Z",
      "updatedAt": "2025-09-03T02:33:45.309Z",
      "chapterId": "123cbc80-5562-41e9-a66d-1b0209a46731"
    },
    {
      "id": "fa73dbae-98c9-4210-a307-fff10846a5fc",
      "text": "Bao cơn thịnh nộ, Ngài đổ ngập thân con,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:45.323Z",
      "updatedAt": "2025-09-03T02:33:45.323Z",
      "chapterId": "123cbc80-5562-41e9-a66d-1b0209a46731"
    },
    {
      "id": "59d74936-e001-4447-9bbb-f357d879f503",
      "text": "bấy nỗi kinh hoàng khiến con rời rã.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:45.337Z",
      "updatedAt": "2025-09-03T02:33:45.337Z",
      "chapterId": "123cbc80-5562-41e9-a66d-1b0209a46731"
    },
    {
      "id": "aa3c8abc-05ec-4771-aba7-914ea5c684ed",
      "text": "Bủa vây con suốt ngày ngần ấy thứ,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:45.351Z",
      "updatedAt": "2025-09-03T02:33:45.351Z",
      "chapterId": "123cbc80-5562-41e9-a66d-1b0209a46731"
    },
    {
      "id": "e0172dd0-9420-4399-a44a-3bda749e775b",
      "text": "dồn dập tư bề như nước bao la.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:33:45.365Z",
      "updatedAt": "2025-09-03T02:33:45.365Z",
      "chapterId": "123cbc80-5562-41e9-a66d-1b0209a46731"
    },
    {
      "id": "260bd4f4-af76-4360-891e-cde95da403b6",
      "text": "Cận thân Chúa khiến lìa xa,",
