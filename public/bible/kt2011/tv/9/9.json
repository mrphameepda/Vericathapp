{
  "chapter": {
    "id": "0dd9331a-c894-4601-a810-f2fb3c77e0eb",
    "number": 9,
    "createdAt": "2025-09-03T01:07:51.660Z",
    "updatedAt": "2025-09-03T01:07:51.660Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "12ac5e2c-9c69-413e-9cee-dc12fff08a7a",
      "text": "*Phần ca trưởng. Theo điệu :* mût laBBën. *Thánh vịnh. Của vua Đa-vít.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:25:25.547Z",
      "updatedAt": "2025-09-03T02:25:25.547Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "b96e58e4-e4c5-41d1-a7f8-93f6171aed11",
      "text": "A-lép",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:25:25.608Z",
      "updatedAt": "2025-09-03T02:25:25.608Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "9f9154d4-46ab-4ef4-96a5-9c346d30a7c2",
      "text": "Lạy CHÚA, con hết lòng cảm tạ,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:25.619Z",
      "updatedAt": "2025-09-03T02:25:25.619Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "39f192bc-ed13-47f3-9f7d-5237842cc478",
      "text": "kể ra đây muôn việc lạ Chúa làm.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:25.638Z",
      "updatedAt": "2025-09-03T02:25:25.638Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "8b7d7e11-56b4-4d45-a961-2c0a8b22dc84",
      "text": "Mừng Ngài, con hân hoan nhảy múa,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:25.651Z",
      "updatedAt": "2025-09-03T02:25:25.651Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "f6367afc-b8ee-4c9b-a566-84e0e18ffa17",
      "text": "đàn hát kính danh Ngài, lạy Đấng Tối Cao.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:25.663Z",
      "updatedAt": "2025-09-03T02:25:25.663Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "e5245b6f-4e36-4aa9-8da4-ea41b0ba0d11",
      "text": "Bết",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:25:25.689Z",
      "updatedAt": "2025-09-03T02:25:25.689Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "3cb37872-a628-4c77-8feb-d1561b91ea9d",
      "text": "Ngài xuất hiện, địch thù con tháo lui,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:25.706Z",
      "updatedAt": "2025-09-03T02:25:25.706Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "3bd5b79b-0f23-4cee-a853-35adcd0f0a6d",
      "text": "chúng té nhào mà chết.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:25.720Z",
      "updatedAt": "2025-09-03T02:25:25.720Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "dc95d0af-aae5-42a6-957a-4b3239f6d679",
      "text": "Chúa là vị thẩm phán chí công, Ngài ngự toà xét xử,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:25.734Z",
      "updatedAt": "2025-09-03T02:25:25.734Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "e27530b1-266b-47aa-be94-9b1e0294fb7a",
      "text": "bênh vực và bảo vệ quyền lợi con.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:25.748Z",
      "updatedAt": "2025-09-03T02:25:25.748Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "4f68c2eb-616f-4e89-b352-b672744a6480",
      "text": "Ghi-men",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:25:25.762Z",
      "updatedAt": "2025-09-03T02:25:25.762Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "73156a69-029c-4f63-9deb-2e4a98d29d52",
      "text": "Ngài hăm doạ chư dân, tiêu diệt lũ gian tà,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:25.776Z",
      "updatedAt": "2025-09-03T02:25:25.776Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "d5c9f1af-52c0-44b4-a5a4-e241f378c756",
      "text": "tên tuổi chúng, cũng xoá đi vĩnh viễn.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:25.789Z",
      "updatedAt": "2025-09-03T02:25:25.789Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "1c306b79-f029-4e8b-801c-6c12fbc807cf",
      "text": "Kẻ thù bị tiêu diệt, vạn kiếp điêu linh ;",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:25.807Z",
      "updatedAt": "2025-09-03T02:25:25.807Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "10245e47-5875-4bf0-a36e-b7024d601a6e",
      "text": "thành quách chúng, Ngài phá cho bình địa,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:25.819Z",
      "updatedAt": "2025-09-03T02:25:25.819Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "c5a2d7ba-2c91-4145-b61b-336286f971c6",
      "text": "chẳng ai còn nhớ đến.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:25.832Z",
      "updatedAt": "2025-09-03T02:25:25.832Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "f8e210e9-8fb7-44be-b260-34ddd29558e6",
      "text": "Hê",
      "label": "7",
      "number": 7,
      "subVerseIndex": 3,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:25:25.844Z",
      "updatedAt": "2025-09-03T02:25:25.844Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "6690e592-5144-4b19-9742-f9bb2649ac7c",
      "text": "Về phần Chúa, CHÚA ngự trị ngàn đời,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:25.863Z",
      "updatedAt": "2025-09-03T02:25:25.863Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "ba7e0a0d-8a61-414f-9f8f-16fdb226454b",
      "text": "Người lập toà xét xử.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:25.876Z",
      "updatedAt": "2025-09-03T02:25:25.876Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "9cc4be75-d356-4fd8-88cf-3c67e3f795ed",
      "text": "Người xét xử thế giới theo lẽ công minh,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:25.889Z",
      "updatedAt": "2025-09-03T02:25:25.889Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "9c970324-efa8-4eed-823d-046e41a75bae",
      "text": "cai trị muôn dân theo đường chính trực.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:25.901Z",
      "updatedAt": "2025-09-03T02:25:25.901Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "d10b86c1-9363-4fc3-bc13-5ffc3a612e32",
      "text": "Vau",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:25:25.930Z",
      "updatedAt": "2025-09-03T02:25:25.930Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "49254ceb-1d6a-4c56-a83d-77821f584595",
      "text": "CHÚA là thành che chở người bị áp bức,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:25.944Z",
      "updatedAt": "2025-09-03T02:25:25.944Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "877a12d5-6081-4471-b460-eae524bb801f",
      "text": "là thành che chở trong những lúc ngặt nghèo.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:25.961Z",
      "updatedAt": "2025-09-03T02:25:25.961Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "3a1d0d68-157c-48cb-a00e-393f48d2ee22",
      "text": "Người nhận biết Thánh Danh, sẽ một niềm tin cậy,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:25.975Z",
      "updatedAt": "2025-09-03T02:25:25.975Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "847e4976-3f2a-4a33-8f43-c688a6eaee98",
      "text": "vì lạy CHÚA, Chúa chẳng bỏ rơi những ai kiếm tìm Ngài.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:25.990Z",
      "updatedAt": "2025-09-03T02:25:25.990Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "1e480ca6-d7b8-46ea-b286-4be897d9e2e7",
      "text": "Da-in",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:25:26.004Z",
      "updatedAt": "2025-09-03T02:25:26.004Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "d4d793af-32d7-4cb0-a658-590a9199dfa2",
      "text": "Đàn ca lên mừng CHÚA, Đấng ngự giữa Xi-on,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:26.018Z",
      "updatedAt": "2025-09-03T02:25:26.018Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "7076c236-8039-4e38-9c65-db0589f6e380",
      "text": "tường thuật cho muôn nước những kỳ công của Người.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:26.046Z",
      "updatedAt": "2025-09-03T02:25:26.046Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "5d595843-6789-4f52-8f11-ccf062eb597e",
      "text": "Nợ máu Chúa không tha, nhưng hãy còn nhớ mãi,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:26.060Z",
      "updatedAt": "2025-09-03T02:25:26.060Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "8fe24bfe-f477-4343-9268-e60cb0938704",
      "text": "tiếng những người nghèo khổ, Chúa chẳng quên bao giờ.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:26.074Z",
      "updatedAt": "2025-09-03T02:25:26.074Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "4cad89cf-af74-40dd-8502-4bb3690292c3",
      "text": "Khết",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:25:26.088Z",
      "updatedAt": "2025-09-03T02:25:26.088Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "9f0f8920-999a-4c5a-9783-8f98f9f8a9c8",
      "text": "Xin rủ lòng thương con, lạy CHÚA,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:26.104Z",
      "updatedAt": "2025-09-03T02:25:26.104Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "e60b6c68-4deb-4a6d-8ce4-c162d4cec228",
      "text": "đấy Ngài xem : địch thù làm cho con khổ nhục.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:26.132Z",
      "updatedAt": "2025-09-03T02:25:26.132Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "7f93cb2a-5fe7-4cce-83ef-4ddc39a054d2",
      "text": "Xin kéo con lên khỏi ngục tử thần,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 2,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:26.146Z",
      "updatedAt": "2025-09-03T02:25:26.146Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "92afe807-b736-448b-89ec-37deca58f0ca",
      "text": "để con dâng muôn lời ca tụng Chúa",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:26.174Z",
      "updatedAt": "2025-09-03T02:25:26.174Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "153691a5-cbe8-4ab0-bdd8-1aa4386138b2",
      "text": "tại cửa thành Xi-on, và hoan hỷ vì được Ngài cứu thoát.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:26.188Z",
      "updatedAt": "2025-09-03T02:25:26.188Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "e9dae029-109a-4e07-8575-07f412d4a645",
      "text": "Tết",
      "label": "15",
      "number": 15,
      "subVerseIndex": 2,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:25:26.216Z",
      "updatedAt": "2025-09-03T02:25:26.216Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "b0e74012-a685-4faa-9d39-aad3cc05125c",
      "text": "Kìa chư dân sa vào hố chúng đào,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:26.230Z",
      "updatedAt": "2025-09-03T02:25:26.230Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "46dee46d-4e2e-4bb8-b63e-f8d7de25196c",
      "text": "chân mắc lưới chính mình giăng sẵn.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:26.242Z",
      "updatedAt": "2025-09-03T02:25:26.242Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "8b9df627-c173-4be2-b219-2c33e379e228",
      "text": "CHÚA cho thiên hạ được biết Người",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:26.253Z",
      "updatedAt": "2025-09-03T02:25:26.253Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "1512076f-0661-4b35-8d4a-5e7e99f1acdd",
      "text": "khi ban hành phán quyết :",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:26.263Z",
      "updatedAt": "2025-09-03T02:25:26.263Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "738f28d6-274f-429c-8994-c2204be8523a",
      "text": "ác nhân phải mắc vào cạm bẫy do chính chúng bày ra.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 2,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:26.274Z",
      "updatedAt": "2025-09-03T02:25:26.274Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "d64b29cd-77e8-40bf-a219-b67a2dec9e07",
      "text": "Giốt",
      "label": "17",
      "number": 17,
      "subVerseIndex": 3,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:25:26.295Z",
      "updatedAt": "2025-09-03T02:25:26.295Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "ce33b28e-0afd-434e-b4a6-77f86dcd637b",
      "text": "Phường ác nhân phải đi vào âm phủ :",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:26.306Z",
      "updatedAt": "2025-09-03T02:25:26.306Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "d63a33a0-add1-454f-9aea-5e4b62db9fa7",
      "text": "đám dân ngoại này đã từng quên Thiên Chúa.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 46,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:26.317Z",
      "updatedAt": "2025-09-03T02:25:26.317Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "d02c6b87-f780-4714-970b-8333f4722dea",
      "text": "Cáp",
      "label": "18",
      "number": 18,
      "subVerseIndex": 2,
      "paragraphNumber": 47,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:25:26.329Z",
      "updatedAt": "2025-09-03T02:25:26.329Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "f8b3468a-da53-4eb0-a4cb-2ffc07f49553",
      "text": "Nhưng người túng thiếu không mãi bị bỏ quên,",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 48,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:26.340Z",
      "updatedAt": "2025-09-03T02:25:26.340Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "905177ab-3bb4-4582-9a91-b0eeae6fe696",
      "text": "kẻ nghèo khổ chẳng tuyệt vọng bao giờ.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 1,
      "paragraphNumber": 49,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:26.351Z",
      "updatedAt": "2025-09-03T02:25:26.351Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "b663e937-3f3d-46ee-9817-ae55802f0010",
      "text": "Lạy CHÚA, xin đứng lên, đừng để cho phàm nhân thắng thế.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 50,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:26.363Z",
      "updatedAt": "2025-09-03T02:25:26.363Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "0ab47187-ba82-4283-b51a-8819db80faad",
      "text": "Xin Chúa đòi chư dân ra trước mặt Ngài mà xét xử.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 51,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:26.375Z",
      "updatedAt": "2025-09-03T02:25:26.375Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "11556622-fb41-46b0-8072-38aafb99a206",
      "text": "Lạy CHÚA, xin làm cho chúng phải kinh hoàng,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 52,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:26.397Z",
      "updatedAt": "2025-09-03T02:25:26.397Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    },
    {
      "id": "305742f6-8609-4a63-8109-1cf73d5f2ede",
      "text": "chư dân phải nhận biết : mình chỉ là phàm nhân.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 53,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:25:26.411Z",
      "updatedAt": "2025-09-03T02:25:26.411Z",
      "chapterId": "0dd9331a-c894-4601-a810-f2fb3c77e0eb"
    }
  ],
