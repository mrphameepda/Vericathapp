{
  "chapter": {
    "id": "de6975c1-60b7-472f-a1a5-b09417bd3b63",
    "number": 91,
    "createdAt": "2025-09-03T01:07:51.661Z",
    "updatedAt": "2025-09-03T01:07:51.661Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "00f0359b-35fa-450e-8ab6-434ede787416",
      "text": "Hỡi ai nương tựa Đấng Tối Cao",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:04.404Z",
      "updatedAt": "2025-09-03T02:34:04.404Z",
      "chapterId": "de6975c1-60b7-472f-a1a5-b09417bd3b63"
    },
    {
      "id": "8845c0af-3006-4943-8119-c0f75d8455e1",
      "text": "và núp bóng Đấng quyền năng tuyệt đối,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:04.463Z",
      "updatedAt": "2025-09-03T02:34:04.463Z",
      "chapterId": "de6975c1-60b7-472f-a1a5-b09417bd3b63"
    },
    {
      "id": "d83fc632-8df3-437a-ac35-ce92aca0c204",
      "text": "hãy thưa với CHÚA rằng :",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:04.477Z",
      "updatedAt": "2025-09-03T02:34:04.477Z",
      "chapterId": "de6975c1-60b7-472f-a1a5-b09417bd3b63"
    },
    {
      "id": "58e30fa7-a5c4-4601-b30e-db4773e1467d",
      "text": "“Lạy Thiên Chúa, Ngài là nơi con náu ẩn,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:04.491Z",
      "updatedAt": "2025-09-03T02:34:04.491Z",
      "chapterId": "de6975c1-60b7-472f-a1a5-b09417bd3b63"
    },
    {
      "id": "fbe5073b-50e4-49bf-897d-618be2881c39",
      "text": "là đồn luỹ chở che, con tin tưởng vào Ngài.”",
      "label": "2",
      "number": 2,
      "subVerseIndex": 2,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:04.518Z",
      "updatedAt": "2025-09-03T02:34:04.518Z",
      "chapterId": "de6975c1-60b7-472f-a1a5-b09417bd3b63"
    },
    {
      "id": "a2e0fbb8-7596-41ce-83aa-a7bd6f900dff",
      "text": "Chính Chúa gìn giữ bạn",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:04.552Z",
      "updatedAt": "2025-09-03T02:34:04.552Z",
      "chapterId": "de6975c1-60b7-472f-a1a5-b09417bd3b63"
    },
    {
      "id": "fdb2f7a3-13b8-4e59-97a2-e75c695a78ee",
      "text": "khỏi lưới kẻ thù giăng, khỏi tai ương tàn khốc.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:04.568Z",
      "updatedAt": "2025-09-03T02:34:04.568Z",
      "chapterId": "de6975c1-60b7-472f-a1a5-b09417bd3b63"
    },
    {
      "id": "6064619a-edf0-47bd-822b-67cb99936717",
      "text": "Chúa phù trì che chở, dưới cánh Người, bạn có chỗ ẩn thân :",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:04.597Z",
      "updatedAt": "2025-09-03T02:34:04.597Z",
      "chapterId": "de6975c1-60b7-472f-a1a5-b09417bd3b63"
    },
    {
      "id": "70347f00-68a4-4a5a-a6a1-d98bbc76d511",
      "text": "lòng Chúa tín trung là khiên che thuẫn đỡ.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:04.628Z",
      "updatedAt": "2025-09-03T02:34:04.628Z",
      "chapterId": "de6975c1-60b7-472f-a1a5-b09417bd3b63"
    },
    {
      "id": "0b55b326-73ff-4d3a-9e66-4122348972b7",
      "text": "Bạn không sợ cảnh hãi hùng đêm vắng",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:04.642Z",
      "updatedAt": "2025-09-03T02:34:04.642Z",
      "chapterId": "de6975c1-60b7-472f-a1a5-b09417bd3b63"
    },
    {
      "id": "e2b45ea2-db28-4821-a94b-35913f4c44b0",
      "text": "hay mũi tên bay giữa ban ngày,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:04.656Z",
      "updatedAt": "2025-09-03T02:34:04.656Z",
      "chapterId": "de6975c1-60b7-472f-a1a5-b09417bd3b63"
    },
    {
      "id": "5c24ff0c-f428-4dba-ac2a-e5088a5d6529",
      "text": "cả dịch khí hoành hành trong đêm tối,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:04.672Z",
      "updatedAt": "2025-09-03T02:34:04.672Z",
      "chapterId": "de6975c1-60b7-472f-a1a5-b09417bd3b63"
    },
    {
      "id": "2ab18b07-7f75-42ee-a2ef-f12be764bb52",
      "text": "cả ôn thần sát hại lúc ban trưa.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:04.688Z",
      "updatedAt": "2025-09-03T02:34:04.688Z",
      "chapterId": "de6975c1-60b7-472f-a1a5-b09417bd3b63"
    },
    {
      "id": "ac41e52a-ca8f-4ebc-b54e-e171bf9eeb3a",
      "text": "Dù tả hữu có ngàn người quỵ ngã,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:04.700Z",
      "updatedAt": "2025-09-03T02:34:04.700Z",
      "chapterId": "de6975c1-60b7-472f-a1a5-b09417bd3b63"
    },
    {
      "id": "416d3a5c-4b41-4c01-97de-b61b92e559e5",
      "text": "dù hai bên có chết cả vạn người,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:04.715Z",
      "updatedAt": "2025-09-03T02:34:04.715Z",
      "chapterId": "de6975c1-60b7-472f-a1a5-b09417bd3b63"
    },
    {
      "id": "0169984c-56ad-4ee9-9fe6-dbb576f56bc8",
      "text": "riêng phần bạn, tuyệt nhiên không hề hấn.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:04.729Z",
      "updatedAt": "2025-09-03T02:34:04.729Z",
      "chapterId": "de6975c1-60b7-472f-a1a5-b09417bd3b63"
    },
    {
      "id": "9f21c7a0-5a5f-42d7-8661-f5434941f479",
      "text": "Mở mắt coi, bạn liền thấy rõ",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:04.743Z",
      "updatedAt": "2025-09-03T02:34:04.743Z",
      "chapterId": "de6975c1-60b7-472f-a1a5-b09417bd3b63"
    },
    {
      "id": "2f55e5f2-dffb-4564-b461-2b2f28c4e696",
      "text": "thế nào là số phận bọn ác nhân.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:04.757Z",
      "updatedAt": "2025-09-03T02:34:04.757Z",
      "chapterId": "de6975c1-60b7-472f-a1a5-b09417bd3b63"
    },
    {
      "id": "c8694cb1-10e9-4f4a-8f59-13213167d40f",
      "text": "Vì bạn có CHÚA làm nơi trú ẩn,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:04.770Z",
      "updatedAt": "2025-09-03T02:34:04.770Z",
      "chapterId": "de6975c1-60b7-472f-a1a5-b09417bd3b63"
    },
    {
      "id": "a7de0c52-66c3-4cfe-b9fe-c5143ba25567",
      "text": "có Đấng Tối Cao làm chỗ nương thân.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:04.785Z",
      "updatedAt": "2025-09-03T02:34:04.785Z",
      "chapterId": "de6975c1-60b7-472f-a1a5-b09417bd3b63"
    },
    {
      "id": "213edfce-beb4-429f-a228-28b41747aa6b",
      "text": "Bạn sẽ không gặp điều ác hại,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:04.818Z",
      "updatedAt": "2025-09-03T02:34:04.818Z",
      "chapterId": "de6975c1-60b7-472f-a1a5-b09417bd3b63"
    },
    {
      "id": "1b81672d-8a7e-4f8f-a019-92396ac932b3",
      "text": "và tai ương không bén mảng tới nhà,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:04.832Z",
      "updatedAt": "2025-09-03T02:34:04.832Z",
      "chapterId": "de6975c1-60b7-472f-a1a5-b09417bd3b63"
    },
    {
      "id": "c0455c88-e929-4fce-a93c-aa793ed191f1",
      "text": "bởi chưng Người truyền cho thiên sứ",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:04.846Z",
      "updatedAt": "2025-09-03T02:34:04.846Z",
      "chapterId": "de6975c1-60b7-472f-a1a5-b09417bd3b63"
    },
    {
      "id": "29fffad0-baed-4bf8-99f7-fd14b191141e",
      "text": "giữ gìn bạn trên khắp nẻo đường,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:04.874Z",
      "updatedAt": "2025-09-03T02:34:04.874Z",
      "chapterId": "de6975c1-60b7-472f-a1a5-b09417bd3b63"
    },
    {
      "id": "9558edf1-7d65-4631-9190-cef9a0528a54",
      "text": "và thiên sứ sẽ tay đỡ tay nâng",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:04.888Z",
      "updatedAt": "2025-09-03T02:34:04.888Z",
      "chapterId": "de6975c1-60b7-472f-a1a5-b09417bd3b63"
    },
    {
      "id": "b983f240-9270-4fb6-83f2-d18bea27847f",
      "text": "cho bạn khỏi vấp chân vào đá.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:04.902Z",
      "updatedAt": "2025-09-03T02:34:04.902Z",
      "chapterId": "de6975c1-60b7-472f-a1a5-b09417bd3b63"
    },
    {
      "id": "a21aa328-cb14-4a3a-9175-f00a70ae9f4e",
      "text": "Bạn có thể giẫm lên hùm thiêng rắn độc,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:04.916Z",
      "updatedAt": "2025-09-03T02:34:04.916Z",
      "chapterId": "de6975c1-60b7-472f-a1a5-b09417bd3b63"
    },
    {
      "id": "e1edce67-5105-4c51-b4be-88d09756d890",
      "text": "đạp nát đầu sư tử khủng long.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:04.931Z",
      "updatedAt": "2025-09-03T02:34:04.931Z",
      "chapterId": "de6975c1-60b7-472f-a1a5-b09417bd3b63"
    },
    {
      "id": "ef1d2ca9-1bc8-4367-a719-eb5ac5961b33",
      "text": "Chúa phán : “Kẻ gắn bó cùng Ta sẽ được ơn giải thoát,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:04.945Z",
      "updatedAt": "2025-09-03T02:34:04.945Z",
      "chapterId": "de6975c1-60b7-472f-a1a5-b09417bd3b63"
    },
    {
      "id": "2f25c87f-74df-4722-8ab5-bb4b7be36533",
      "text": "người nhận biết danh Ta sẽ được sức phù trì.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:04.959Z",
      "updatedAt": "2025-09-03T02:34:04.959Z",
      "chapterId": "de6975c1-60b7-472f-a1a5-b09417bd3b63"
    },
    {
      "id": "9e958794-beff-420c-a181-ddff631df07e",
      "text": "Khi kêu đến Ta, Ta liền đáp lại",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:04.973Z",
      "updatedAt": "2025-09-03T02:34:04.973Z",
      "chapterId": "de6975c1-60b7-472f-a1a5-b09417bd3b63"
    },
    {
      "id": "081d0b8a-8a80-4d30-b9de-f2957e72f173",
      "text": "lúc ngặt nghèo có Ta ở kề bên.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:04.986Z",
      "updatedAt": "2025-09-03T02:34:04.986Z",
      "chapterId": "de6975c1-60b7-472f-a1a5-b09417bd3b63"
    },
    {
      "id": "41eecc19-1bc0-46f1-9e29-101c6dd120d8",
      "text": "Ta giải cứu và ban nhiều vinh dự,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 2,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:05Z",
      "updatedAt": "2025-09-03T02:34:05Z",
      "chapterId": "de6975c1-60b7-472f-a1a5-b09417bd3b63"
    },
    {
      "id": "77256282-e09d-4e3b-89a3-bbee96f6f726",
      "text": "cho sống lâu, tuổi thọ dư đầy",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:05.015Z",
      "updatedAt": "2025-09-03T02:34:05.015Z",
      "chapterId": "de6975c1-60b7-472f-a1a5-b09417bd3b63"
    },
    {
      "id": "252696a0-80c3-4f21-b51c-d552955c8c7d",
      "text": "và hưởng ơn cứu độ Ta ban.”",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:05.042Z",
      "updatedAt": "2025-09-03T02:34:05.042Z",
      "chapterId": "de6975c1-60b7-472f-a1a5-b09417bd3b63"
    }
  ],
  "marks": [
    {
      "id": "3d757844-f0d8-478a-a8c7-f7e98857d1e0",
      "content": "Đây là *một Tv tín nhiệm* nói về Thiên Chúa là Đấng bảo vệ tín hữu của Người. Tv này gồm ba phần chính : **1**) Lời ngỏ với tín hữu (cc. 1-2) ; **2**) Thiên Chúa chở che tín hữu khỏi các tai hoạ (cc. 3-7) ; số phận của ác nhân khác hẳn với số phận của tín hữu có Chúa làm nơi trú ẩn (cc. 8-9) ; Thiên Chúa dùng thiên sứ để phù trì che chở tín hữu (cc. 10-13) ; **3**) Sấm ngôn của Thiên Chúa (cc. 14-16).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 36,
      "endOffset": 36,
      "createdAt": "2025-09-03T02:34:04.435Z",
      "updatedAt": "2025-09-03T02:34:04.435Z",
      "targetId": "78f57582-5bd8-465d-8a94-5e2520e8b932",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "de6975c1-60b7-472f-a1a5-b09417bd3b63"
    },
    {
      "id": "8df97482-80c5-4b17-8db7-04aeb05a16ea",
      "content": "Tv 18,3",
      "kind": "MARK_KIND_REFERENCE",
      "label": "1@",
      "sortOrder": 0,
      "startOffset": 1,
      "endOffset": 1,
      "createdAt": "2025-09-03T02:34:04.504Z",
      "updatedAt": "2025-09-03T02:34:04.504Z",
      "targetId": "58e30fa7-a5c4-4601-b30e-db4773e1467d",
