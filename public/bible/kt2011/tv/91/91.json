    },
    {
      "id": "9c34b48a-7d79-484e-a05d-c7b807cc2521",
      "content": "Mt 4,6; Lc 4,10-11",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 0,
      "endOffset": 0,
