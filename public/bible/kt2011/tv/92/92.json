    {
      "id": "b8ae4fc0-021a-4857-9c99-72b7f91373cc",
      "content": "Tv 73,15",
      "kind": "MARK_KIND_REFERENCE",
      "label": "1@",
      "sortOrder": 0,
      "startOffset": 3,
      "endOffset": 3,
      "createdAt": "2025-09-03T02:34:10.579Z",
      "updatedAt": "2025-09-03T02:34:10.579Z",
      "targetId": "a2ac0213-e401-4af4-898b-cdecb0a82fa1",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "85b2c420-76c3-4a49-9bf3-ca0a1e1a12ad"
    },
    {
      "id": "6125a961-7c4d-4e3b-a9ca-a4331fae4e92",
      "content": "Tv 92 là *một Tv hỗn hợp*, vì đó là một thánh thi mang những yếu tố tạ ơn cá nhân và giáo huấn. Cấu trúc : **1**) Nhập đề (cc. 2-4) ; **2**) Những lý do thúc đẩy tạ ơn Thiên Chúa (cc. 5-12) ; **3**) Phần thưởng dành cho người công chính (cc. 13-16).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 54,
