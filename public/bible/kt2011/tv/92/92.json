{
  "chapter": {
    "id": "85b2c420-76c3-4a49-9bf3-ca0a1e1a12ad",
    "number": 92,
    "createdAt": "2025-09-03T01:07:51.661Z",
    "updatedAt": "2025-09-03T01:07:51.661Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "0821581d-b9c2-4643-8ea1-3b367e8644cf",
      "text": "*Thánh vịnh. Thánh ca. Cho ngày sa-bát.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:34:10.323Z",
      "updatedAt": "2025-09-03T02:34:10.323Z",
      "chapterId": "85b2c420-76c3-4a49-9bf3-ca0a1e1a12ad"
    },
    {
      "id": "fec4913e-49c3-4a14-8f8b-47b82869dd47",
      "text": "Thú vị thay được tạ ơn CHÚA,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:10.374Z",
      "updatedAt": "2025-09-03T02:34:10.374Z",
      "chapterId": "85b2c420-76c3-4a49-9bf3-ca0a1e1a12ad"
    },
    {
      "id": "fc9a684a-0d24-433c-90cf-f6890add3864",
      "text": "được mừng hát danh Ngài, lạy Đấng Tối Cao,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:10.385Z",
      "updatedAt": "2025-09-03T02:34:10.385Z",
      "chapterId": "85b2c420-76c3-4a49-9bf3-ca0a1e1a12ad"
    },
    {
      "id": "80ba2d94-4c23-47b6-bcc7-897aba9e506f",
      "text": "được tuyên xưng tình thương của Ngài từ buổi sớm,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:10.412Z",
      "updatedAt": "2025-09-03T02:34:10.412Z",
      "chapterId": "85b2c420-76c3-4a49-9bf3-ca0a1e1a12ad"
    },
    {
      "id": "d541a5be-3c3c-411e-b998-dd7a022a0fc9",
      "text": "và lòng thành tín của Ngài suốt canh khuya,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:10.426Z",
      "updatedAt": "2025-09-03T02:34:10.426Z",
      "chapterId": "85b2c420-76c3-4a49-9bf3-ca0a1e1a12ad"
    },
    {
      "id": "e1316101-8cc7-4d1a-969e-70a405be4e17",
      "text": "hoà điệu sắt cầm gieo trầm bổng,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:10.454Z",
      "updatedAt": "2025-09-03T02:34:10.454Z",
      "chapterId": "85b2c420-76c3-4a49-9bf3-ca0a1e1a12ad"
    },
    {
      "id": "1f583a5d-5d81-4441-987e-2f0bf3e9563b",
      "text": "nhè nhẹ vấn vương khúc tỳ bà.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:10.468Z",
      "updatedAt": "2025-09-03T02:34:10.468Z",
      "chapterId": "85b2c420-76c3-4a49-9bf3-ca0a1e1a12ad"
    },
    {
      "id": "09f9ef99-ac1d-4ef9-b6e0-d9b96253fb86",
      "text": "Lạy CHÚA, sự nghiệp Ngài khiến con mừng rỡ,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:10.482Z",
      "updatedAt": "2025-09-03T02:34:10.482Z",
      "chapterId": "85b2c420-76c3-4a49-9bf3-ca0a1e1a12ad"
    },
    {
      "id": "a736fabd-e306-49a6-82f1-229d0bd13b84",
      "text": "thấy việc tay Ngài làm, con phải reo lên :",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:10.496Z",
      "updatedAt": "2025-09-03T02:34:10.496Z",
      "chapterId": "85b2c420-76c3-4a49-9bf3-ca0a1e1a12ad"
    },
    {
      "id": "43a6a02a-ea68-4a49-b9a1-ecf0e01c3c83",
      "text": "Lạy CHÚA, công trình Ngài xiết bao vĩ đại,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:10.510Z",
      "updatedAt": "2025-09-03T02:34:10.510Z",
      "chapterId": "85b2c420-76c3-4a49-9bf3-ca0a1e1a12ad"
    },
    {
      "id": "8089674b-6f6a-4695-abc8-4f218bda1a83",
      "text": "tư tưởng Ngài thâm thuý lắm thay !",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:10.537Z",
      "updatedAt": "2025-09-03T02:34:10.537Z",
      "chapterId": "85b2c420-76c3-4a49-9bf3-ca0a1e1a12ad"
    },
    {
      "id": "e4d9c0f6-481a-49ce-a31f-b5b0ef826ed5",
      "text": "Người khờ dại nào đâu có biết,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:10.551Z",
      "updatedAt": "2025-09-03T02:34:10.551Z",
      "chapterId": "85b2c420-76c3-4a49-9bf3-ca0a1e1a12ad"
    },
    {
      "id": "a2ac0213-e401-4af4-898b-cdecb0a82fa1",
      "text": "kẻ ngu si chẳng hiểu điều này :",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:10.565Z",
      "updatedAt": "2025-09-03T02:34:10.565Z",
      "chapterId": "85b2c420-76c3-4a49-9bf3-ca0a1e1a12ad"
    },
    {
      "id": "eb1e9fa6-930e-4717-a00d-61a2c21975c8",
      "text": "Bọn bất nhân dầu sởn sơ như cỏ,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:10.594Z",
      "updatedAt": "2025-09-03T02:34:10.594Z",
      "chapterId": "85b2c420-76c3-4a49-9bf3-ca0a1e1a12ad"
    },
    {
      "id": "82270772-b52f-45e4-83bf-c34fe5f1d098",
      "text": "phường gian ác có đua nở khoe tươi,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:10.608Z",
      "updatedAt": "2025-09-03T02:34:10.608Z",
      "chapterId": "85b2c420-76c3-4a49-9bf3-ca0a1e1a12ad"
    },
    {
      "id": "147f4720-75cc-4bfe-a40f-5e66481e3b58",
      "text": "cũng là để bị diệt trừ vĩnh viễn.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:10.622Z",
      "updatedAt": "2025-09-03T02:34:10.622Z",
      "chapterId": "85b2c420-76c3-4a49-9bf3-ca0a1e1a12ad"
    },
    {
      "id": "1ee6b1aa-1609-4208-b55b-1b089ec5d9fb",
      "text": "Còn CHÚA, Ngài cao cả đến muôn đời.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:10.636Z",
      "updatedAt": "2025-09-03T02:34:10.636Z",
      "chapterId": "85b2c420-76c3-4a49-9bf3-ca0a1e1a12ad"
    },
    {
      "id": "ea3f4b81-7cf5-4258-a887-a2d57a27a2bb",
      "text": "Kìa những kẻ thù Ngài, lạy CHÚA,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:10.650Z",
      "updatedAt": "2025-09-03T02:34:10.650Z",
      "chapterId": "85b2c420-76c3-4a49-9bf3-ca0a1e1a12ad"
    },
    {
      "id": "3ad87a77-5a9a-4779-8623-ae736781fe6c",
      "text": "kìa những kẻ thù Ngài tiêu vong,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:10.663Z",
      "updatedAt": "2025-09-03T02:34:10.663Z",
      "chapterId": "85b2c420-76c3-4a49-9bf3-ca0a1e1a12ad"
    },
    {
      "id": "6df43dcc-04a9-43e5-bff1-2680d3fdd59b",
      "text": "bọn gian ác đều rã tan hết thảy.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:10.674Z",
      "updatedAt": "2025-09-03T02:34:10.674Z",
      "chapterId": "85b2c420-76c3-4a49-9bf3-ca0a1e1a12ad"
    },
    {
      "id": "6105f662-7dbc-4cd6-9237-f993b8717021",
      "text": "Ngài cho con ngẩng đầu hãnh diện,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:10.685Z",
      "updatedAt": "2025-09-03T02:34:10.685Z",
      "chapterId": "85b2c420-76c3-4a49-9bf3-ca0a1e1a12ad"
    },
    {
      "id": "3c742dbb-db4a-4be0-8a71-b8dea7977282",
      "text": "tựa như trâu ngạo nghễ giương sừng,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:10.696Z",
      "updatedAt": "2025-09-03T02:34:10.696Z",
      "chapterId": "85b2c420-76c3-4a49-9bf3-ca0a1e1a12ad"
    },
    {
      "id": "50e06c3c-00c2-420b-aff7-d738a860393f",
      "text": "thân con, Ngài xức dầu thơm mát.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:10.707Z",
      "updatedAt": "2025-09-03T02:34:10.707Z",
      "chapterId": "85b2c420-76c3-4a49-9bf3-ca0a1e1a12ad"
    },
    {
      "id": "09937a03-703a-44f2-b1e2-895b8c077613",
      "text": "Mắt con nghênh những kẻ địch thù,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:10.718Z",
      "updatedAt": "2025-09-03T02:34:10.718Z",
      "chapterId": "85b2c420-76c3-4a49-9bf3-ca0a1e1a12ad"
    },
    {
      "id": "9a379c50-47f7-4caf-8f77-c9f7ff376014",
      "text": "tai nghe biết lũ hại con mạt vận.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:10.729Z",
      "updatedAt": "2025-09-03T02:34:10.729Z",
      "chapterId": "85b2c420-76c3-4a49-9bf3-ca0a1e1a12ad"
    },
    {
      "id": "4ab46f7f-a32b-4247-a337-80b22e7c20a3",
      "text": "Người công chính vươn lên tựa cây dừa tươi tốt,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:10.741Z",
      "updatedAt": "2025-09-03T02:34:10.741Z",
      "chapterId": "85b2c420-76c3-4a49-9bf3-ca0a1e1a12ad"
    },
    {
      "id": "586c9805-7e88-4072-ba8c-85a4d70a8a3e",
      "text": "lớn mạnh như hương bá Li-băng",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:10.755Z",
      "updatedAt": "2025-09-03T02:34:10.755Z",
      "chapterId": "85b2c420-76c3-4a49-9bf3-ca0a1e1a12ad"
    },
    {
      "id": "f4dc0938-436d-4c16-a9c7-8f5b708d9617",
      "text": "được trồng nơi nhà CHÚA,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:10.797Z",
      "updatedAt": "2025-09-03T02:34:10.797Z",
      "chapterId": "85b2c420-76c3-4a49-9bf3-ca0a1e1a12ad"
    },
    {
      "id": "baa2160d-b479-4440-8453-812ae3611bcf",
      "text": "mơn mởn giữa khuôn viên đền thánh Chúa ta ;",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:10.811Z",
      "updatedAt": "2025-09-03T02:34:10.811Z",
      "chapterId": "85b2c420-76c3-4a49-9bf3-ca0a1e1a12ad"
    },
    {
      "id": "4fc997a6-b036-4485-9fa8-8fcf0700ffa5",
      "text": "già cỗi rồi, vẫn sinh hoa kết quả,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:10.824Z",
      "updatedAt": "2025-09-03T02:34:10.824Z",
      "chapterId": "85b2c420-76c3-4a49-9bf3-ca0a1e1a12ad"
    },
    {
      "id": "a011acae-9915-4da0-88d5-c03568a5393c",
      "text": "tràn đầy nhựa sống, cành lá xanh rờn,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:10.838Z",
      "updatedAt": "2025-09-03T02:34:10.838Z",
      "chapterId": "85b2c420-76c3-4a49-9bf3-ca0a1e1a12ad"
    },
    {
      "id": "ba93fc19-d36a-4525-8bf5-086a6528b659",
      "text": "để loan truyền rằng : CHÚA thực là ngay thẳng,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:10.852Z",
      "updatedAt": "2025-09-03T02:34:10.852Z",
      "chapterId": "85b2c420-76c3-4a49-9bf3-ca0a1e1a12ad"
    },
    {
      "id": "488ab226-0d10-4b87-bacc-bb352fc8aee8",
      "text": "là núi đá cho tôi ẩn náu,",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:10.865Z",
      "updatedAt": "2025-09-03T02:34:10.865Z",
      "chapterId": "85b2c420-76c3-4a49-9bf3-ca0a1e1a12ad"
    },
    {
      "id": "a3b77bda-52d5-4b39-ac32-f58086310e7f",
      "text": "nơi Người chẳng có chút bất công.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 2,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:10.893Z",
      "updatedAt": "2025-09-03T02:34:10.893Z",
      "chapterId": "85b2c420-76c3-4a49-9bf3-ca0a1e1a12ad"
    }
  ],
