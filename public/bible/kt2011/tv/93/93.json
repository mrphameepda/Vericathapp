{
  "chapter": {
    "id": "1db44257-b122-4858-8215-83cee287aafb",
    "number": 93,
    "createdAt": "2025-09-03T01:07:51.661Z",
    "updatedAt": "2025-09-03T01:07:51.661Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "fc6ff17c-b1fe-4797-9413-3987798e4a6a",
      "text": "CHÚA là Vua hiển trị, CHÚA mặc oai phong tựa cẩm bào,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:16.377Z",
      "updatedAt": "2025-09-03T02:34:16.377Z",
      "chapterId": "1db44257-b122-4858-8215-83cee287aafb"
    },
    {
      "id": "5679d8e2-24c2-4df2-ba3e-e1b1b1c62441",
      "text": "Người lấy dũng lực làm cân đai.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:16.442Z",
      "updatedAt": "2025-09-03T02:34:16.442Z",
      "chapterId": "1db44257-b122-4858-8215-83cee287aafb"
    },
    {
      "id": "58cdbc9d-f4a2-4c1d-b94c-aa7be343f872",
      "text": "Chúa thiết lập địa cầu, địa cầu không lay chuyển.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:16.469Z",
      "updatedAt": "2025-09-03T02:34:16.469Z",
      "chapterId": "1db44257-b122-4858-8215-83cee287aafb"
    },
    {
      "id": "4b3cfcd4-ecbe-4302-95f9-87169fc7ad5f",
      "text": "Ngai vàng Chúa kiên cố tự ngàn xưa :",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:16.497Z",
      "updatedAt": "2025-09-03T02:34:16.497Z",
      "chapterId": "1db44257-b122-4858-8215-83cee287aafb"
    },
    {
      "id": "6f1fd103-7c90-4a31-801e-d03082d1bc39",
      "text": "Ngài hiện hữu tự muôn ngàn đời.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:16.510Z",
      "updatedAt": "2025-09-03T02:34:16.510Z",
      "chapterId": "1db44257-b122-4858-8215-83cee287aafb"
    },
    {
      "id": "a345f589-1660-456a-9925-a0e937dceeee",
      "text": "Sóng nước đã gầm lên, lạy CHÚA,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:16.539Z",
      "updatedAt": "2025-09-03T02:34:16.539Z",
      "chapterId": "1db44257-b122-4858-8215-83cee287aafb"
    },
    {
      "id": "ef190ad6-0152-4166-8557-075095600ec8",
      "text": "sóng nước đã gầm lên tiếng thét gào.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:16.568Z",
      "updatedAt": "2025-09-03T02:34:16.568Z",
      "chapterId": "1db44257-b122-4858-8215-83cee287aafb"
    },
    {
      "id": "f34a5a8a-897c-446b-be7b-ba2c6cb5a393",
      "text": "Sóng nước đã gầm lên, long trời lở đất.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:16.582Z",
      "updatedAt": "2025-09-03T02:34:16.582Z",
      "chapterId": "1db44257-b122-4858-8215-83cee287aafb"
    },
    {
      "id": "750d8b70-4ae7-404b-ba05-4109ca3efb90",
      "text": "Nhưng hơn hẳn tiếng nước ngàn trùng,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:16.597Z",
      "updatedAt": "2025-09-03T02:34:16.597Z",
      "chapterId": "1db44257-b122-4858-8215-83cee287aafb"
    },
    {
      "id": "33e7b164-e806-46b2-a167-97b3a5dfcb61",
      "text": "hơn hẳn sóng oai hùng ngoài biển cả,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:16.611Z",
      "updatedAt": "2025-09-03T02:34:16.611Z",
      "chapterId": "1db44257-b122-4858-8215-83cee287aafb"
    },
    {
      "id": "f5f46f2c-5d5c-4e92-8524-70d154f1bd24",
      "text": "CHÚA oai hùng ngự trị chốn cao xanh.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:16.626Z",
      "updatedAt": "2025-09-03T02:34:16.626Z",
      "chapterId": "1db44257-b122-4858-8215-83cee287aafb"
    },
    {
      "id": "4f05d2a1-5276-4fe3-9ba7-9ad1636ce2aa",
      "text": "Lạy CHÚA, thánh chỉ Ngài thật là bền vững,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:16.640Z",
      "updatedAt": "2025-09-03T02:34:16.640Z",
      "chapterId": "1db44257-b122-4858-8215-83cee287aafb"
    },
    {
      "id": "ab8afcdb-7358-4880-ba0d-d5c3599d9fd1",
      "text": "nơi đền vàng rực lên toàn thánh thiện",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:16.654Z",
      "updatedAt": "2025-09-03T02:34:16.654Z",
      "chapterId": "1db44257-b122-4858-8215-83cee287aafb"
    },
    {
      "id": "79dedb78-c941-4445-9932-0c2047e62aeb",
      "text": "triền miên qua mọi thời.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 2,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:16.667Z",
      "updatedAt": "2025-09-03T02:34:16.667Z",
      "chapterId": "1db44257-b122-4858-8215-83cee287aafb"
    }
  ],
  "marks": [
    {
      "id": "5f175b01-8610-4a49-abbc-a85438812a81",
      "content": "English: Yahweh | French: SEIGNEUR | Latin: Dominus | Origin: &#1497;&#1456;&#1492;&#64331;&#1464;&#1492; | Vietnamese: ĐỨC CHÚA -- Danh của Thiên Chúa Ít-ra-en, St 2,4...",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "1",
      "sortOrder": 0,
      "startOffset": 19,
      "endOffset": 19,
      "createdAt": "2025-09-03T02:34:16.409Z",
      "updatedAt": "2025-09-03T02:34:16.409Z",
      "targetId": "59cd6915-e24c-4a08-a83f-8c02c2876c57",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "1db44257-b122-4858-8215-83cee287aafb"
    },
    {
      "id": "c3384995-a167-426c-ae92-de1215e0eaae",
      "content": "Tv 104,1",
      "kind": "MARK_KIND_REFERENCE",
      "label": "1@",
      "sortOrder": 0,
      "startOffset": 31,
      "endOffset": 31,
      "createdAt": "2025-09-03T02:34:16.431Z",
      "updatedAt": "2025-09-03T02:34:16.431Z",
      "targetId": "fc6ff17c-b1fe-4797-9413-3987798e4a6a",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1db44257-b122-4858-8215-83cee287aafb"
    },
    {
      "id": "2696f785-6011-4986-9578-ceb56cbca87a",
      "content": "Tv 93, *một trong những Tv về vương quyền của Thiên Chúa*, ca tụng Đức Chúa uy nghi là Vua vũ trụ. Theo phần đông các nhà chú giải, người Do-thái đọc Tv này vào dịp lễ Lều. Hai câu đầu (cc. 1-2) ca ngợi vương quyền của Đức Chúa trên vũ trụ. Cuộc chiến thắng liên tục của Người đối với mãnh lực của hỗn mang được nói đến trong cc. 3-4. Tv kết thúc ở c.5 với lời ca ngợi thánh chỉ của Đức Chúa và Đền Thờ của Người.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 33,
      "endOffset": 33,
      "createdAt": "2025-09-03T02:34:16.420Z",
      "updatedAt": "2025-09-03T02:34:16.420Z",
      "targetId": "59cd6915-e24c-4a08-a83f-8c02c2876c57",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "1db44257-b122-4858-8215-83cee287aafb"
    },
    {
      "id": "db615b22-d810-4dc5-a0c5-c9a1316074a6",
      "content": "Tv 96,10",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 5,
      "endOffset": 5,
      "createdAt": "2025-09-03T02:34:16.483Z",
      "updatedAt": "2025-09-03T02:34:16.483Z",
      "targetId": "58cdbc9d-f4a2-4c1d-b94c-aa7be343f872",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1db44257-b122-4858-8215-83cee287aafb"
    },
    {
      "id": "95935abc-fed0-4e74-a0eb-228add324caa",
      "content": "Như nhà vua mặc *cẩm bào*, thắt *cân đai*, Đức Chúa hiển trị uy nghi và đầy sức mạnh.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 30,
      "endOffset": 30,
      "createdAt": "2025-09-03T02:34:16.455Z",
      "updatedAt": "2025-09-03T02:34:16.455Z",
      "targetId": "5679d8e2-24c2-4df2-ba3e-e1b1b1c62441",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1db44257-b122-4858-8215-83cee287aafb"
    },
    {
      "id": "800ef773-f571-4e9f-8953-0ab12ab925c3",
      "content": "Tv 90,2",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 5,
      "endOffset": 5,
      "createdAt": "2025-09-03T02:34:16.525Z",
      "updatedAt": "2025-09-03T02:34:16.525Z",
      "targetId": "6f1fd103-7c90-4a31-801e-d03082d1bc39",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1db44257-b122-4858-8215-83cee287aafb"
    },
    {
      "id": "f2a789de-306c-49b4-88ce-0d03717e701f",
      "content": "Hình như tất cả các thành ngữ *sóng nước* (ds : *sông*) *đã gầm lên* (ba lần trong c.3), *tiếng nước ngàn trùng* (c.4a ; ds : *tiếng nước lớn*), *sóng oai hùng* (c.4b), *biển cả* (c.4b), *tiếng thét gào* (c.3b), *long trời lở đất* (c.3c) gợi lên hỗn mang tiên khởi trong thời tạo thành đầu tiên (x. c.1d : *Chúa thiết lập địa cầu không lay chuyển*), và cũng ám chỉ những mãnh lực thù nghịch với Đức Chúa và dân Người (x. Is 8,7 ; 17,12-13 ...). Đức Chúa đã thắng tất cả những mãnh lực đó và hiện nay ung dung ngồi trên ngai vàng kiên cố.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 20,
      "endOffset": 20,
      "createdAt": "2025-09-03T02:34:16.553Z",
      "updatedAt": "2025-09-03T02:34:16.553Z",
      "targetId": "a345f589-1660-456a-9925-a0e937dceeee",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1db44257-b122-4858-8215-83cee287aafb"
    },
    {
      "id": "6ef4aa95-be9c-4506-b2ad-0a5346d1cb0a",
      "content": "Đức Chúa thực thi vương quyền của Người trên toàn thể vũ trụ. Người cũng thể hiện vương quyền trên dân riêng của Người nhờ ý muốn cho dân tuân giữ các *thánh chỉ* và nhờ sự hiện diện thánh thiện và có sức thánh hoá của Người trong Đền Thờ (c.5).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "5",
      "sortOrder": 4,
      "startOffset": 23,
      "endOffset": 23,
      "createdAt": "2025-09-03T02:34:16.679Z",
      "updatedAt": "2025-09-03T02:34:16.679Z",
      "targetId": "79dedb78-c941-4445-9932-0c2047e62aeb",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "1db44257-b122-4858-8215-83cee287aafb"
    }
  ],
