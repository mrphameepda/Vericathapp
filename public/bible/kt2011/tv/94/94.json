{
  "chapter": {
    "id": "58b3fb40-9b55-4635-b652-947d5c6bb861",
    "number": 94,
    "createdAt": "2025-09-03T01:07:51.661Z",
    "updatedAt": "2025-09-03T01:07:51.661Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "018a79b9-6ffb-4662-864f-e96448e55f41",
      "text": "Lạy CHÚA là Chúa Trời trả báo,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:21.921Z",
      "updatedAt": "2025-09-03T02:34:21.921Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "ca356b9c-f983-4b36-97ff-e4b2d50db31a",
      "text": "lạy Chúa Trời trả báo, xin Ngài quang lâm !",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:21.975Z",
      "updatedAt": "2025-09-03T02:34:21.975Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "1e89b16a-a44f-4bb5-bfbf-d364956c8068",
      "text": "Đấng xét xử địa cầu, xin đứng dậy,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:21.987Z",
      "updatedAt": "2025-09-03T02:34:21.987Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "4080249c-21ad-4a1d-b341-19ca8f614f97",
      "text": "trả cho lũ kiêu căng xứng việc chúng làm.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:22.029Z",
      "updatedAt": "2025-09-03T02:34:22.029Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "715ef95e-4ce2-4ba8-9d00-db3dfcafa436",
      "text": "Đến bao giờ, lạy CHÚA,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:22.043Z",
      "updatedAt": "2025-09-03T02:34:22.043Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "b9d7b8c6-3523-4dfa-9f4e-59326a39b7cf",
      "text": "đến bao giờ bọn ác nhân cứ mãi hỷ hoan ?",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:22.056Z",
      "updatedAt": "2025-09-03T02:34:22.056Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "110b6d7d-8b43-4c0f-bb04-bbbd465c9e20",
      "text": "Quân làm điều ác những ba hoa buông lời hỗn xược,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:22.071Z",
      "updatedAt": "2025-09-03T02:34:22.071Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "3d9fda3f-e8cf-425b-bf33-49e39693f846",
      "text": "những vênh váo ngang tàng.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:22.084Z",
      "updatedAt": "2025-09-03T02:34:22.084Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "6136703c-1c47-4862-ba64-c18ebfdf12e7",
      "text": "Chúng chà đạp dân riêng Ngài, lạy CHÚA,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:22.099Z",
      "updatedAt": "2025-09-03T02:34:22.099Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "3f62ac2d-10e6-4ebe-96ad-806e42c7a679",
      "text": "hà hiếp dân Ngài chọn làm gia sản.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:22.113Z",
      "updatedAt": "2025-09-03T02:34:22.113Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "ba290898-82af-4c09-92e0-13b3ee5c88d8",
      "text": "Chúng giết người quả phụ, giết khách ngoại kiều,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:22.133Z",
      "updatedAt": "2025-09-03T02:34:22.133Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "54336ddb-50f0-41a4-bc00-91040336a262",
      "text": "tàn sát cả cô nhi !",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:22.151Z",
      "updatedAt": "2025-09-03T02:34:22.151Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "4ff7abf0-2ef1-438a-8d39-ca99f40064b5",
      "text": "Chúng bảo rằng : “CHÚA đâu có thấy,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:22.178Z",
      "updatedAt": "2025-09-03T02:34:22.178Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "120385e9-1681-43bc-9f60-4c1879481ddd",
      "text": "Thiên Chúa nhà Gia-cóp chẳng lưu tâm !”",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:22.205Z",
      "updatedAt": "2025-09-03T02:34:22.205Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "3c5ac2ec-8a2a-49b1-967b-1f5bec7a46ce",
      "text": "Hãy lưu tâm, này quân đần độn nhất trên đời !",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:22.235Z",
      "updatedAt": "2025-09-03T02:34:22.235Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "0b91623f-6e85-48c0-9d07-899873157347",
      "text": "Bao giờ mới nên khôn, hỡi đồ ngu xuẩn ?",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:22.248Z",
      "updatedAt": "2025-09-03T02:34:22.248Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "a361dda0-1c91-44a9-bb9c-d5e945172d12",
      "text": "Đấng từng gắn đôi tai há lại không nghe được ?",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:22.262Z",
      "updatedAt": "2025-09-03T02:34:22.262Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "feec32c3-dd75-46ec-9eb7-f4488d7be082",
      "text": "Đấng nặn thành cặp mắt chẳng lẽ không thấy gì ?",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:22.276Z",
      "updatedAt": "2025-09-03T02:34:22.276Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "78a39b44-8b3f-4583-9e24-ca3112bac17c",
      "text": "Đấng sửa trị muôn dân lẽ nào không trừng phạt ?",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:22.290Z",
      "updatedAt": "2025-09-03T02:34:22.290Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "0a4cb8df-0cdd-4f07-abe8-6bd4abb96eb4",
      "text": "Đấng dạy dỗ con người mà chẳng biết gì sao ?",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:22.310Z",
      "updatedAt": "2025-09-03T02:34:22.310Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "89efe058-f9de-4394-9e00-b6f440287f7c",
      "text": "Tư tưởng phàm nhân, CHÚA đều biết cả :",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:22.324Z",
      "updatedAt": "2025-09-03T02:34:22.324Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "85b63b9d-1b08-44ea-96a1-066b4199eb3e",
      "text": "thật chỉ như cơn gió thoảng ngoài !",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:22.349Z",
      "updatedAt": "2025-09-03T02:34:22.349Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "598026f2-09e7-4be3-92a5-a3c711eb0d6d",
      "text": "Lạy CHÚA, hạnh phúc thay kẻ được Ngài giáo huấn,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:22.362Z",
      "updatedAt": "2025-09-03T02:34:22.362Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "7266ccfa-e432-4dbc-a3d0-afc71e42df26",
      "text": "được Ngài lấy luật mà dạy dỗ bảo ban.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:22.390Z",
      "updatedAt": "2025-09-03T02:34:22.390Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "65b03f6a-ad06-4505-9d21-15f91b638491",
      "text": "Ngài cho họ được bình an trong ngày hoạn nạn,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:22.404Z",
      "updatedAt": "2025-09-03T02:34:22.404Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "349f1806-5c41-4629-8724-51e9ac6a9357",
      "text": "trong khi huyệt mả sẵn chờ kẻ ác nhân.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:22.433Z",
      "updatedAt": "2025-09-03T02:34:22.433Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "f5fa33cc-b680-4f15-a0b2-d64be34e1faf",
      "text": "Vì CHÚA không ruồng rẫy dân Người,",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:22.447Z",
      "updatedAt": "2025-09-03T02:34:22.447Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "3b400e6d-11f8-42e0-91c3-a925f9c6e6e7",
      "text": "chẳng bỏ rơi dân Người chọn làm gia sản ;",
      "label": "14",
      "number": 14,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:22.460Z",
      "updatedAt": "2025-09-03T02:34:22.460Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "13c0785f-1c79-454a-b674-c1cca94832cc",
      "text": "công lý rồi ra sẽ trở lại pháp đình,",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:22.474Z",
      "updatedAt": "2025-09-03T02:34:22.474Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "ec3d9bd0-2bd7-4ea1-856d-71381f96676a",
      "text": "mọi tâm hồn chính trực sẽ tuân theo.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 1,
      "paragraphNumber": 29,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:22.488Z",
      "updatedAt": "2025-09-03T02:34:22.488Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "ac0ef48d-d617-460c-b6e3-eaa3f9f01f57",
      "text": "Ai đứng dậy giúp tôi chống bọn làm điều ác ?",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 30,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:22.502Z",
      "updatedAt": "2025-09-03T02:34:22.502Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "a66032f1-954c-4ad3-b3a0-665a351b7735",
      "text": "Ai sát cánh cùng tôi cự lại lũ gian tà ?",
      "label": "16",
      "number": 16,
      "subVerseIndex": 1,
      "paragraphNumber": 31,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:22.516Z",
      "updatedAt": "2025-09-03T02:34:22.516Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "c88307d3-fb26-45a5-9e9f-b38678c320dc",
      "text": "CHÚA mà đã chẳng thương phù trợ,",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 32,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:22.530Z",
      "updatedAt": "2025-09-03T02:34:22.530Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "616079ec-6b36-4f05-ba19-1cf729c40411",
      "text": "thì hồn tôi đã vào chốn thinh lặng ngàn thu.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 1,
      "paragraphNumber": 33,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:22.544Z",
      "updatedAt": "2025-09-03T02:34:22.544Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "595fff6a-c63f-4f4b-8fd7-e57ddbbd8506",
      "text": "Lạy CHÚA, khi con nói : “Này chân con lảo đảo”,",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 34,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:22.575Z",
      "updatedAt": "2025-09-03T02:34:22.575Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "14b180e8-02ee-47e9-a1d9-06e602823482",
      "text": "tình thương Ngài đã đỡ nâng con ;",
      "label": "18",
      "number": 18,
      "subVerseIndex": 1,
      "paragraphNumber": 35,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:22.589Z",
      "updatedAt": "2025-09-03T02:34:22.589Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "0472f1d5-52a0-444d-9b8b-540a387c2bd7",
      "text": "lúc ưu tư đầy ắp cõi lòng, ơn Ngài an ủi khiến hồn con vui sướng.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 36,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:22.603Z",
      "updatedAt": "2025-09-03T02:34:22.603Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "8a160611-278f-4f31-92b9-62eb0199379b",
      "text": "Lẽ nào Chúa liên minh với bọn thẩm phán ác ôn,",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 37,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:22.618Z",
      "updatedAt": "2025-09-03T02:34:22.618Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "03b30c0a-9dd4-48ff-8f27-2d119e212926",
      "text": "bọn gieo tai rắc hoạ chẳng kể gì luật pháp ?",
      "label": "20",
      "number": 20,
      "subVerseIndex": 1,
      "paragraphNumber": 38,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:22.632Z",
      "updatedAt": "2025-09-03T02:34:22.632Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "6b4d9c04-9a87-4718-abba-95cf32611a44",
      "text": "Chúng tìm hại mạng sống người lành,",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 39,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:22.646Z",
      "updatedAt": "2025-09-03T02:34:22.646Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "c74c916c-b230-44a5-9ed7-0eeb89b8ad66",
      "text": "lên án tử cho người vô tội.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 1,
      "paragraphNumber": 40,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:22.660Z",
      "updatedAt": "2025-09-03T02:34:22.660Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "955d65b0-864d-49da-af59-78b8ad9448f5",
      "text": "Nhưng CHÚA là thành luỹ chở che,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 41,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:22.672Z",
      "updatedAt": "2025-09-03T02:34:22.672Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "4c0676db-9209-480e-b66f-f94acc437517",
      "text": "Chúa tôi thờ là núi đá cho tôi trú ẩn.",
      "label": "22",
      "number": 22,
      "subVerseIndex": 1,
      "paragraphNumber": 42,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:22.696Z",
      "updatedAt": "2025-09-03T02:34:22.696Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "0691236b-3135-471d-a90f-1d813cf53581",
      "text": "Tội của chúng, Người đổ trên đầu chúng,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 43,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:22.707Z",
      "updatedAt": "2025-09-03T02:34:22.707Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "592ff7ec-453c-4434-bbd7-f2be067409de",
      "text": "Người tiêu diệt chúng vì điều dữ chúng làm,",
      "label": "23",
      "number": 23,
      "subVerseIndex": 1,
      "paragraphNumber": 44,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:22.733Z",
      "updatedAt": "2025-09-03T02:34:22.733Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "f5fad1c7-3c24-46d0-9f6a-87282dea7a7d",
      "text": "ĐỨC CHÚA là Thiên Chúa của ta, sẽ tiêu diệt chúng.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 2,
      "paragraphNumber": 45,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:22.747Z",
      "updatedAt": "2025-09-03T02:34:22.747Z",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    }
  ],
  "marks": [
    {
