    },
    {
      "id": "a2b3cf6c-7837-4ee9-a1bc-01f451bb958d",
      "content": "Đối phương làm hại những người cô thế cô thân, những người mà Lề Luật dạy phải tôn trọng và giúp đỡ (x. Đnl 24,17-21 ; 27,19 ; Dcr 7,10), những người mà Thiên Chúa muốn bênh vực và bảo vệ phù trì.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "4",
      "sortOrder": 3,
      "startOffset": 17,
      "endOffset": 17,
      "createdAt": "2025-09-03T02:34:22.164Z",
      "updatedAt": "2025-09-03T02:34:22.164Z",
      "targetId": "54336ddb-50f0-41a4-bc00-91040336a262",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
