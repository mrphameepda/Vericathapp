      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "58b3fb40-9b55-4635-b652-947d5c6bb861"
    },
    {
      "id": "0d007aa9-249f-4f5b-a11a-afe074cc73f8",
      "content": "1 Cr 3,20",
      "kind": "MARK_KIND_REFERENCE",
