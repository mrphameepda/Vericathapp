{
  "chapter": {
    "id": "80f29ebf-e475-4861-a340-29004287ae1a",
    "number": 95,
    "createdAt": "2025-09-03T01:07:51.661Z",
    "updatedAt": "2025-09-03T01:07:51.661Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "d6cdaccc-a981-438d-9442-51f0fe3f2df3",
      "text": "Hãy đến đây ta reo hò mừng CHÚA,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:28.579Z",
      "updatedAt": "2025-09-03T02:34:28.579Z",
      "chapterId": "80f29ebf-e475-4861-a340-29004287ae1a"
    },
    {
      "id": "257bb015-5606-4733-a5e3-7d6a82b3bbdf",
      "text": "tung hô Người là Núi Đá độ trì ta,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:28.632Z",
      "updatedAt": "2025-09-03T02:34:28.632Z",
      "chapterId": "80f29ebf-e475-4861-a340-29004287ae1a"
    },
    {
      "id": "7aa11e9f-6bd2-4e0e-af30-799d07e7ab6b",
      "text": "vào trước Thánh Nhan dâng lời cảm tạ,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:28.673Z",
      "updatedAt": "2025-09-03T02:34:28.673Z",
      "chapterId": "80f29ebf-e475-4861-a340-29004287ae1a"
    },
    {
      "id": "fa18f3e4-f7fc-48d3-817c-21b71b246d3f",
      "text": "cùng tung hô theo điệu hát cung đàn.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:28.687Z",
      "updatedAt": "2025-09-03T02:34:28.687Z",
      "chapterId": "80f29ebf-e475-4861-a340-29004287ae1a"
    },
    {
      "id": "a9c7fd1f-2af9-4b37-b240-53d92d5879ea",
      "text": "Bởi ĐỨC CHÚA là Chúa Trời cao cả,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:28.701Z",
      "updatedAt": "2025-09-03T02:34:28.701Z",
      "chapterId": "80f29ebf-e475-4861-a340-29004287ae1a"
    },
    {
      "id": "caf3ba17-d9fe-415b-9736-a081160be3bd",
      "text": "là Đại Vương trổi vượt chư thần,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:28.729Z",
      "updatedAt": "2025-09-03T02:34:28.729Z",
      "chapterId": "80f29ebf-e475-4861-a340-29004287ae1a"
    },
    {
      "id": "bd8afd15-3efc-4b09-a6a0-8ac429332399",
      "text": "nắm trong tay bao vực sâu lòng đất,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:28.743Z",
      "updatedAt": "2025-09-03T02:34:28.743Z",
      "chapterId": "80f29ebf-e475-4861-a340-29004287ae1a"
    },
    {
      "id": "1ea8fbbd-3727-4105-a9ec-e594619f4146",
      "text": "giữ chủ quyền muôn ngọn núi vút cao.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:28.757Z",
      "updatedAt": "2025-09-03T02:34:28.757Z",
      "chapterId": "80f29ebf-e475-4861-a340-29004287ae1a"
    },
    {
      "id": "ef620edf-c2d3-4cf8-89ef-8ce18d91bd1c",
      "text": "Đại dương Chúa đã tạo thành là của Chúa,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:28.771Z",
      "updatedAt": "2025-09-03T02:34:28.771Z",
      "chapterId": "80f29ebf-e475-4861-a340-29004287ae1a"
    },
    {
      "id": "46d078c4-d192-49cb-9536-f124e9c27ca2",
      "text": "lục địa do tay Người nhào nắn cũng thuộc về Người.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:28.786Z",
      "updatedAt": "2025-09-03T02:34:28.786Z",
      "chapterId": "80f29ebf-e475-4861-a340-29004287ae1a"
    },
    {
      "id": "a337f187-9782-442b-b4a9-c136ae472e48",
      "text": "Hãy vào đây ta cúi mình phủ phục,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:28.800Z",
      "updatedAt": "2025-09-03T02:34:28.800Z",
      "chapterId": "80f29ebf-e475-4861-a340-29004287ae1a"
    },
    {
      "id": "a0b9623c-d2a8-4512-b064-549b7140f298",
      "text": "quỳ trước tôn nhan CHÚA là Đấng dựng nên ta.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:28.814Z",
      "updatedAt": "2025-09-03T02:34:28.814Z",
      "chapterId": "80f29ebf-e475-4861-a340-29004287ae1a"
    },
    {
      "id": "925c37f9-98b3-4f58-8562-05fa19b3db32",
      "text": "Bởi chính Người là Thiên Chúa ta thờ,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:28.828Z",
      "updatedAt": "2025-09-03T02:34:28.828Z",
      "chapterId": "80f29ebf-e475-4861-a340-29004287ae1a"
    },
    {
      "id": "2a04e188-7212-4c57-899a-fb8648b331b6",
      "text": "còn ta là dân Người lãnh đạo,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:28.842Z",
      "updatedAt": "2025-09-03T02:34:28.842Z",
      "chapterId": "80f29ebf-e475-4861-a340-29004287ae1a"
    },
    {
      "id": "1c15565e-8417-417a-a463-9587958bbcba",
      "text": "là đoàn chiên tay Người dẫn dắt.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:28.857Z",
      "updatedAt": "2025-09-03T02:34:28.857Z",
      "chapterId": "80f29ebf-e475-4861-a340-29004287ae1a"
    },
    {
      "id": "62f9b9f2-71b4-418c-858e-7ba09fdccff7",
      "text": "Ngày hôm nay, ước gì anh em nghe tiếng Chúa !",
      "label": "7",
      "number": 7,
      "subVerseIndex": 3,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:28.885Z",
      "updatedAt": "2025-09-03T02:34:28.885Z",
      "chapterId": "80f29ebf-e475-4861-a340-29004287ae1a"
    },
    {
      "id": "5b1bd9aa-7ba4-48fb-9951-133b6cad080c",
      "text": "\\[Người phán] : “Các ngươi chớ cứng lòng",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:28.913Z",
      "updatedAt": "2025-09-03T02:34:28.913Z",
      "chapterId": "80f29ebf-e475-4861-a340-29004287ae1a"
    },
    {
      "id": "fa5a57ed-c703-44d9-a6f9-6fdb37cba02e",
      "text": "như tại Mơ-ri-va, như ngày ở Ma-xa trong sa mạc,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:28.927Z",
      "updatedAt": "2025-09-03T02:34:28.927Z",
      "chapterId": "80f29ebf-e475-4861-a340-29004287ae1a"
    },
    {
      "id": "07079510-6ca8-4434-9a45-295c708c4049",
      "text": "nơi tổ phụ các ngươi đã từng thách thức",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:28.969Z",
      "updatedAt": "2025-09-03T02:34:28.969Z",
      "chapterId": "80f29ebf-e475-4861-a340-29004287ae1a"
    },
    {
      "id": "4fa2b87e-5172-4eae-b6b2-0ddbc46a63bb",
      "text": "và dám thử thách Ta, dù đã thấy những việc Ta làm.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:28.987Z",
      "updatedAt": "2025-09-03T02:34:28.987Z",
      "chapterId": "80f29ebf-e475-4861-a340-29004287ae1a"
    },
    {
      "id": "415a9697-78d8-4f0e-b343-558a722e45ee",
      "text": "Suốt bốn mươi năm, dòng giống này làm Ta chán ngán,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:29.014Z",
      "updatedAt": "2025-09-03T02:34:29.014Z",
      "chapterId": "80f29ebf-e475-4861-a340-29004287ae1a"
    },
    {
      "id": "a3844ec7-52c0-4e0c-a953-568a14d8176e",
      "text": "Ta đã nói : Đây là dân tâm hồn lầm lạc,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:29.057Z",
      "updatedAt": "2025-09-03T02:34:29.057Z",
      "chapterId": "80f29ebf-e475-4861-a340-29004287ae1a"
    },
    {
      "id": "d121579b-1933-43fb-a9e5-30633cfde13f",
      "text": "chúng nào biết đến đường lối của Ta,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:29.071Z",
      "updatedAt": "2025-09-03T02:34:29.071Z",
      "chapterId": "80f29ebf-e475-4861-a340-29004287ae1a"
    },
    {
      "id": "dbcef9d8-a111-457e-9022-8ad97bdc5072",
      "text": "nên Ta mới thịnh nộ thề rằng :",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:29.085Z",
      "updatedAt": "2025-09-03T02:34:29.085Z",
      "chapterId": "80f29ebf-e475-4861-a340-29004287ae1a"
    },
    {
      "id": "fb963632-cbcd-4986-b20c-0418f266138a",
      "text": "Chúng sẽ không được vào chốn yên nghỉ của Ta.”",
      "label": "11",
      "number": 11,
      "subVerseIndex": 2,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:29.113Z",
      "updatedAt": "2025-09-03T02:34:29.113Z",
      "chapterId": "80f29ebf-e475-4861-a340-29004287ae1a"
    }
  ],
