{
  "chapter": {
    "id": "fe13a5f8-05ae-40ea-ac21-eb46d3c4303c",
    "number": 96,
    "createdAt": "2025-09-03T01:07:51.662Z",
    "updatedAt": "2025-09-03T01:07:51.662Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "8030b615-4c88-4efb-ad94-9e408a7b8582",
      "text": "Hát lên mừng CHÚA một bài ca mới,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:34.244Z",
      "updatedAt": "2025-09-03T02:34:34.244Z",
      "chapterId": "fe13a5f8-05ae-40ea-ac21-eb46d3c4303c"
    },
    {
      "id": "f180f751-c17e-4e42-8ac5-b997bfae939c",
      "text": "hát lên mừng CHÚA, hỡi toàn thể địa cầu !",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:34.317Z",
      "updatedAt": "2025-09-03T02:34:34.317Z",
      "chapterId": "fe13a5f8-05ae-40ea-ac21-eb46d3c4303c"
    },
    {
      "id": "3325156e-a606-417b-a07a-36149c32c3da",
      "text": "Hát lên mừng CHÚA, chúc tụng Thánh Danh !",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:34.333Z",
      "updatedAt": "2025-09-03T02:34:34.333Z",
      "chapterId": "fe13a5f8-05ae-40ea-ac21-eb46d3c4303c"
    },
    {
      "id": "105bb2c7-7697-470f-b159-bfaf94f87863",
      "text": "Ngày qua ngày, hãy loan báo ơn Người cứu độ,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:34.350Z",
      "updatedAt": "2025-09-03T02:34:34.350Z",
      "chapterId": "fe13a5f8-05ae-40ea-ac21-eb46d3c4303c"
    },
    {
      "id": "26877e68-7b0c-456b-9e04-f360b67cdaa3",
      "text": "kể cho muôn dân biết Người thật là vinh hiển,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:34.364Z",
      "updatedAt": "2025-09-03T02:34:34.364Z",
      "chapterId": "fe13a5f8-05ae-40ea-ac21-eb46d3c4303c"
    },
    {
      "id": "c872e709-38c5-4d6d-a4f3-7f1be1fdcfdf",
      "text": "cho mọi nước hay những kỳ công của Người.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:34.378Z",
      "updatedAt": "2025-09-03T02:34:34.378Z",
      "chapterId": "fe13a5f8-05ae-40ea-ac21-eb46d3c4303c"
    },
    {
      "id": "98a62a31-2566-410a-914d-1909742cb988",
      "text": "CHÚA thật cao cả, xứng muôn lời ca tụng,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:34.392Z",
      "updatedAt": "2025-09-03T02:34:34.392Z",
      "chapterId": "fe13a5f8-05ae-40ea-ac21-eb46d3c4303c"
    },
    {
      "id": "6c4afdfe-28a9-4a45-b82b-9ad553c8970d",
      "text": "khả tôn khả uý hơn chư thần,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:34.406Z",
      "updatedAt": "2025-09-03T02:34:34.406Z",
      "chapterId": "fe13a5f8-05ae-40ea-ac21-eb46d3c4303c"
    },
    {
      "id": "121f33b6-9011-409a-905b-09e539e3233b",
      "text": "vì chư thần các nước thảy đều hư ảo,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:34.420Z",
      "updatedAt": "2025-09-03T02:34:34.420Z",
      "chapterId": "fe13a5f8-05ae-40ea-ac21-eb46d3c4303c"
    },
    {
      "id": "a66e3b05-28e8-442e-9db5-b7e25a9c39f6",
      "text": "còn ĐỨC CHÚA, Người sáng tạo trời cao.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:34.448Z",
      "updatedAt": "2025-09-03T02:34:34.448Z",
      "chapterId": "fe13a5f8-05ae-40ea-ac21-eb46d3c4303c"
    },
    {
      "id": "d03d347c-023c-418c-b44c-78a61a3ce262",
      "text": "Trước thiên nhan, toàn uy phong rực rỡ,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:34.475Z",
      "updatedAt": "2025-09-03T02:34:34.475Z",
      "chapterId": "fe13a5f8-05ae-40ea-ac21-eb46d3c4303c"
    },
    {
      "id": "1ab192db-3b7d-479e-9828-02d5f30aeb3b",
      "text": "trong thánh điện, đầy dũng lực huy hoàng.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:34.490Z",
      "updatedAt": "2025-09-03T02:34:34.490Z",
      "chapterId": "fe13a5f8-05ae-40ea-ac21-eb46d3c4303c"
    },
    {
      "id": "fe5da5dd-7e96-4243-8dd6-cbc16cb98497",
      "text": "Hãy dâng CHÚA, hỡi các dân các nước,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:34.518Z",
      "updatedAt": "2025-09-03T02:34:34.518Z",
      "chapterId": "fe13a5f8-05ae-40ea-ac21-eb46d3c4303c"
    },
    {
      "id": "c693f264-15bd-48ae-9836-e1510ebbc451",
      "text": "dâng CHÚA quyền lực và vinh quang,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:34.531Z",
      "updatedAt": "2025-09-03T02:34:34.531Z",
      "chapterId": "fe13a5f8-05ae-40ea-ac21-eb46d3c4303c"
    },
    {
      "id": "d954b143-7878-4cec-997c-4dbb90c4c5f6",
      "text": "hãy dâng CHÚA vinh quang xứng danh Người.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:34.545Z",
      "updatedAt": "2025-09-03T02:34:34.545Z",
      "chapterId": "fe13a5f8-05ae-40ea-ac21-eb46d3c4303c"
    },
    {
      "id": "7c39a6b1-8fef-4460-98bc-e8d6a4c25ef8",
      "text": "Hãy bưng lễ vật, bước vào tiền đình Chúa,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:34.559Z",
      "updatedAt": "2025-09-03T02:34:34.559Z",
      "chapterId": "fe13a5f8-05ae-40ea-ac21-eb46d3c4303c"
    },
    {
      "id": "522eb762-dbea-4d6c-881e-0609059cdad2",
      "text": "và thờ lạy CHÚA uy nghiêm thánh thiện,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:34.573Z",
      "updatedAt": "2025-09-03T02:34:34.573Z",
      "chapterId": "fe13a5f8-05ae-40ea-ac21-eb46d3c4303c"
    },
    {
      "id": "35f8df1b-fde9-4162-a4a0-86d22760bc76",
      "text": "toàn thể địa cầu, hãy run sợ trước Thánh Nhan.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:34.587Z",
      "updatedAt": "2025-09-03T02:34:34.587Z",
      "chapterId": "fe13a5f8-05ae-40ea-ac21-eb46d3c4303c"
    },
    {
      "id": "bf850e08-d1de-4465-973b-59df0faa929b",
      "text": "Hãy nói với chư dân : CHÚA là Vua hiển trị,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:34.601Z",
      "updatedAt": "2025-09-03T02:34:34.601Z",
      "chapterId": "fe13a5f8-05ae-40ea-ac21-eb46d3c4303c"
    },
    {
      "id": "681b162a-ae91-463d-82e5-0152471248bc",
      "text": "Chúa thiết lập địa cầu, địa cầu chẳng chuyển lay,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:34.615Z",
      "updatedAt": "2025-09-03T02:34:34.615Z",
      "chapterId": "fe13a5f8-05ae-40ea-ac21-eb46d3c4303c"
    },
    {
      "id": "d68546e0-8b21-4aef-89a1-a82d74051fe2",
      "text": "Người xét xử muôn nước theo đường ngay thẳng.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:34.629Z",
      "updatedAt": "2025-09-03T02:34:34.629Z",
      "chapterId": "fe13a5f8-05ae-40ea-ac21-eb46d3c4303c"
    },
    {
      "id": "7051c561-7454-47c4-96eb-674446626abb",
      "text": "Trời vui lên, đất hãy nhảy mừng,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:34.643Z",
      "updatedAt": "2025-09-03T02:34:34.643Z",
      "chapterId": "fe13a5f8-05ae-40ea-ac21-eb46d3c4303c"
    },
    {
      "id": "3dfd5745-631e-4113-9453-88b811df17bd",
      "text": "biển gầm vang cùng muôn hải vật,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:34.671Z",
      "updatedAt": "2025-09-03T02:34:34.671Z",
      "chapterId": "fe13a5f8-05ae-40ea-ac21-eb46d3c4303c"
    },
    {
      "id": "8da24c8c-b277-4a37-8ebc-a07453c9f671",
      "text": "ruộng đồng cùng hoa trái, nào hoan hỷ.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:34.687Z",
      "updatedAt": "2025-09-03T02:34:34.687Z",
      "chapterId": "fe13a5f8-05ae-40ea-ac21-eb46d3c4303c"
    },
    {
      "id": "a360696c-c83c-427a-8943-304042c0226f",
      "text": "Hỡi cây cối rừng xanh,",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:34.701Z",
      "updatedAt": "2025-09-03T02:34:34.701Z",
      "chapterId": "fe13a5f8-05ae-40ea-ac21-eb46d3c4303c"
    },
    {
      "id": "442d27f9-14e0-419f-b3ff-caf43521ed86",
      "text": "hãy reo mừng trước tôn nhan CHÚA,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:34.714Z",
      "updatedAt": "2025-09-03T02:34:34.714Z",
      "chapterId": "fe13a5f8-05ae-40ea-ac21-eb46d3c4303c"
    },
    {
      "id": "b5ab7c35-2954-4194-b9f7-aabef831b8ae",
      "text": "vì Người ngự đến, Người ngự đến xét xử trần gian.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 1,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:34.727Z",
      "updatedAt": "2025-09-03T02:34:34.727Z",
      "chapterId": "fe13a5f8-05ae-40ea-ac21-eb46d3c4303c"
    },
    {
      "id": "9c87aae6-5059-438b-9bab-8ccf390f269f",
      "text": "Người xét xử địa cầu theo đường công chính,",
      "label": "13",
      "number": 13,
      "subVerseIndex": 2,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:34.752Z",
      "updatedAt": "2025-09-03T02:34:34.752Z",
      "chapterId": "fe13a5f8-05ae-40ea-ac21-eb46d3c4303c"
    },
    {
      "id": "ee3bc605-558d-4a53-a9ef-ff3019e8d15e",
      "text": "xét xử muôn dân theo chân lý của Người.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 3,
      "paragraphNumber": 28,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:34.764Z",
      "updatedAt": "2025-09-03T02:34:34.764Z",
      "chapterId": "fe13a5f8-05ae-40ea-ac21-eb46d3c4303c"
    }
  ],
