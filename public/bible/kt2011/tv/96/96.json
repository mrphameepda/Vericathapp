    {
      "id": "194d3043-bd45-469e-ad3a-ca4d0e821110",
      "content": "Tv 98,7-8",
      "kind": "MARK_KIND_REFERENCE",
      "label": "3@",
      "sortOrder": 2,
      "startOffset": 0,
