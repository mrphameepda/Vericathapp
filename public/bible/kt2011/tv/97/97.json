      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "4dad29a0-92a1-44f8-bb2c-56c21b63bdcc"
    },
    {
      "id": "be1fa291-03c7-44db-9b2f-93c4e0af96d6",
      "content": "Tác giả dùng những hình ảnh thường thấy trong các bản văn về cuộc thần hiện (x. Xh 19,16-18 ; 20,18 ; Tl 5,4-5 ; 1 V 19,11-12 ; G 38,1 ; Tv 18,8-15 ; 50,3 ; 99,1 ; Is 30,30 ; Kb 3,3-11 ; Tv 68,8-9 ...) để miêu tả sự can thiệp của Thiên Chúa.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "3",
      "sortOrder": 2,
      "startOffset": 28,
      "endOffset": 28,
      "createdAt": "2025-09-03T02:34:40.080Z",
