    },
    {
      "id": "0f9d4358-ca56-4a30-b1d6-45c206323d27",
      "content": "Tv 97 về *vương quyền của Đức Chúa* được trình bày trong khung cảnh một cuộc thần hiện huy hoàng trong cuộc chiến thắng cánh chung. Biến cố nay đem lại ánh sáng và niềm vui cứu độ cho đoàn người công chính, nhưng làm cho những kẻ thờ ngẫu tượng phải xấu hổ thẹn thùng. Độc giả có thể nhận thấy Tv 97 này được phân chia như sau : **1**) Nhập đề (c.1) ; **2**) Cuộc thần hiện (cc. 2-6) ; **3**) Niềm vui của Xi-on và cảnh nhục nhã của những ai thờ ngẫu tượng (cc. 7-9) ; **4**) Niềm vui của những người công chính (cc. 10-12).",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "2",
      "sortOrder": 1,
      "startOffset": 54,
      "endOffset": 54,
      "createdAt": "2025-09-03T02:34:40.043Z",
      "updatedAt": "2025-09-03T02:34:40.043Z",
      "targetId": "5c9bfe29-e96b-4271-8926-dd9ec06c1b6d",
      "targetType": "MARK_TARGET_TYPE_HEADING",
      "chapterId": "4dad29a0-92a1-44f8-bb2c-56c21b63bdcc"
    },
    {
      "id": "0c75df15-f119-4e27-a3d7-6132579e3249",
      "content": "Tv 95,3",
      "kind": "MARK_KIND_REFERENCE",
      "label": "2@",
      "sortOrder": 1,
      "startOffset": 5,
      "endOffset": 5,
      "createdAt": "2025-09-03T02:34:40.404Z",
      "updatedAt": "2025-09-03T02:34:40.404Z",
