{
  "chapter": {
    "id": "4dad29a0-92a1-44f8-bb2c-56c21b63bdcc",
    "number": 97,
    "createdAt": "2025-09-03T01:07:51.662Z",
    "updatedAt": "2025-09-03T01:07:51.662Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "d73f705f-38bc-41b9-b950-75cd82f0091a",
      "text": "CHÚA là Vua hiển trị, hỡi địa cầu, hãy nhảy mừng lên,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:40.011Z",
      "updatedAt": "2025-09-03T02:34:40.011Z",
      "chapterId": "4dad29a0-92a1-44f8-bb2c-56c21b63bdcc"
    },
    {
      "id": "fc69ad67-0501-4b36-b01c-2d0233c5a86f",
      "text": "vui đi nào, ngàn muôn hải đảo !",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:40.055Z",
      "updatedAt": "2025-09-03T02:34:40.055Z",
      "chapterId": "4dad29a0-92a1-44f8-bb2c-56c21b63bdcc"
    },
    {
      "id": "0d9e1227-467f-4324-886c-3933dab8a0b6",
      "text": "Mây u ám bao phủ quanh Người,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:40.067Z",
      "updatedAt": "2025-09-03T02:34:40.067Z",
      "chapterId": "4dad29a0-92a1-44f8-bb2c-56c21b63bdcc"
    },
    {
      "id": "e9964fa0-bde2-4c13-b460-fe415b809a71",
      "text": "bệ ngai rồng là công minh chính trực.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:40.094Z",
      "updatedAt": "2025-09-03T02:34:40.094Z",
      "chapterId": "4dad29a0-92a1-44f8-bb2c-56c21b63bdcc"
    },
    {
      "id": "4bd315c7-c3af-4658-9600-78b27470b483",
      "text": "Ngọn lửa hồng mở lối tiên phong,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:40.123Z",
      "updatedAt": "2025-09-03T02:34:40.123Z",
      "chapterId": "4dad29a0-92a1-44f8-bb2c-56c21b63bdcc"
    },
    {
      "id": "4294e0a5-d100-46a1-8979-85e3cfda9ee0",
      "text": "đốt tiêu tan địch thù tứ phía.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:40.137Z",
      "updatedAt": "2025-09-03T02:34:40.137Z",
      "chapterId": "4dad29a0-92a1-44f8-bb2c-56c21b63bdcc"
    },
    {
      "id": "01d185fa-f741-4d22-8bad-35b9ac847430",
      "text": "Ánh chớp của Người soi sáng thế gian,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:40.151Z",
      "updatedAt": "2025-09-03T02:34:40.151Z",
      "chapterId": "4dad29a0-92a1-44f8-bb2c-56c21b63bdcc"
    },
    {
      "id": "14d5f66e-c038-476c-89ba-b1039244c52b",
      "text": "địa cầu trông thấy mà run sợ ;",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:40.165Z",
      "updatedAt": "2025-09-03T02:34:40.165Z",
      "chapterId": "4dad29a0-92a1-44f8-bb2c-56c21b63bdcc"
    },
    {
      "id": "fe6ed03d-a538-40f5-9767-354cc81f35c7",
      "text": "núi tan chảy như sáp, khi diện kiến Thánh Nhan",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:40.179Z",
      "updatedAt": "2025-09-03T02:34:40.179Z",
      "chapterId": "4dad29a0-92a1-44f8-bb2c-56c21b63bdcc"
    },
    {
      "id": "f1e38d41-d068-464c-b265-685121e9bbb1",
      "text": "vị Chúa Tể hoàn cầu.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:40.193Z",
      "updatedAt": "2025-09-03T02:34:40.193Z",
      "chapterId": "4dad29a0-92a1-44f8-bb2c-56c21b63bdcc"
    },
    {
      "id": "0173bd39-1822-417d-9fb1-541f149d9df4",
      "text": "Trời xanh tuyên bố Người là Đấng chính trực,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:40.207Z",
      "updatedAt": "2025-09-03T02:34:40.207Z",
      "chapterId": "4dad29a0-92a1-44f8-bb2c-56c21b63bdcc"
    },
    {
      "id": "67104f26-0dbc-4d2c-9553-e094c02f5784",
      "text": "hết mọi dân được thấy vinh quang Người.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:40.221Z",
      "updatedAt": "2025-09-03T02:34:40.221Z",
      "chapterId": "4dad29a0-92a1-44f8-bb2c-56c21b63bdcc"
    },
    {
      "id": "3b129e17-ebb5-4a5c-b4ea-3e1c42d93729",
      "text": "Nhục nhã thay ai thờ ngẫu tượng,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:40.235Z",
      "updatedAt": "2025-09-03T02:34:40.235Z",
      "chapterId": "4dad29a0-92a1-44f8-bb2c-56c21b63bdcc"
    },
    {
      "id": "7e8b3f55-9849-4c71-a634-d38c650ae004",
      "text": "huênh hoang vì những vật hư vô này.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:40.249Z",
      "updatedAt": "2025-09-03T02:34:40.249Z",
      "chapterId": "4dad29a0-92a1-44f8-bb2c-56c21b63bdcc"
    },
    {
      "id": "81a7da7f-3029-4423-8276-28f22eb0df7b",
      "text": "Chư thần chư thánh, phục bái Chúa đi !",
      "label": "7",
      "number": 7,
      "subVerseIndex": 2,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:40.263Z",
      "updatedAt": "2025-09-03T02:34:40.263Z",
      "chapterId": "4dad29a0-92a1-44f8-bb2c-56c21b63bdcc"
    },
    {
      "id": "02298e52-7dcc-4914-85a5-a1e8c029a328",
      "text": "Được biết thế, Xi-on tưng bừng hoan hỷ ;",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:40.277Z",
      "updatedAt": "2025-09-03T02:34:40.277Z",
      "chapterId": "4dad29a0-92a1-44f8-bb2c-56c21b63bdcc"
    },
    {
      "id": "fdf0affa-0460-42c4-9ce0-a3e30613d5e5",
      "text": "thành thị miền Giu-đa hớn hở nhảy mừng",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:40.307Z",
      "updatedAt": "2025-09-03T02:34:40.307Z",
      "chapterId": "4dad29a0-92a1-44f8-bb2c-56c21b63bdcc"
    },
    {
      "id": "246ea663-293a-4845-8513-e244e118bf00",
      "text": "vì những phán quyết của Ngài, lạy CHÚA.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:40.334Z",
      "updatedAt": "2025-09-03T02:34:40.334Z",
      "chapterId": "4dad29a0-92a1-44f8-bb2c-56c21b63bdcc"
    },
    {
      "id": "3f28ebea-b5f6-4da7-b5de-dcb8dcd3e872",
      "text": "Chính bởi vì Ngài, muôn lạy CHÚA,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:40.362Z",
      "updatedAt": "2025-09-03T02:34:40.362Z",
      "chapterId": "4dad29a0-92a1-44f8-bb2c-56c21b63bdcc"
    },
    {
      "id": "a1d903e2-9528-4823-90fe-62bf193d2417",
      "text": "là Đấng Cao Cả trên khắp địa cầu,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:40.376Z",
      "updatedAt": "2025-09-03T02:34:40.376Z",
      "chapterId": "4dad29a0-92a1-44f8-bb2c-56c21b63bdcc"
    },
    {
      "id": "713afd71-0d2a-4a80-9a5a-aa7910861e78",
      "text": "Ngài trổi vượt chư thần hết thảy.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:40.391Z",
      "updatedAt": "2025-09-03T02:34:40.391Z",
      "chapterId": "4dad29a0-92a1-44f8-bb2c-56c21b63bdcc"
    },
    {
      "id": "723d1c26-18ac-4d05-a965-1949bd2e7f96",
      "text": "Kẻ yêu CHÚA, hãy ghét điều gian ác,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:40.416Z",
      "updatedAt": "2025-09-03T02:34:40.416Z",
      "chapterId": "4dad29a0-92a1-44f8-bb2c-56c21b63bdcc"
    },
    {
      "id": "7e2ae1d6-fbb5-42af-b5b9-a51765ac68bc",
      "text": "Người giữ gìn tính mạng kẻ hiếu trung,",
      "label": "10",
      "number": 10,
      "subVerseIndex": 1,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:40.428Z",
      "updatedAt": "2025-09-03T02:34:40.428Z",
      "chapterId": "4dad29a0-92a1-44f8-bb2c-56c21b63bdcc"
    },
    {
      "id": "b2652c25-ffd3-4a3a-9e21-c11002ae2e4f",
      "text": "giải thoát họ khỏi tay phường độc dữ.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 2,
      "paragraphNumber": 23,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:40.440Z",
      "updatedAt": "2025-09-03T02:34:40.440Z",
      "chapterId": "4dad29a0-92a1-44f8-bb2c-56c21b63bdcc"
    },
    {
      "id": "4ebb1962-e329-49f7-90b0-da193184841e",
      "text": "Ánh sáng bừng lên chiếu rọi người công chính,",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 24,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:40.452Z",
      "updatedAt": "2025-09-03T02:34:40.452Z",
      "chapterId": "4dad29a0-92a1-44f8-bb2c-56c21b63bdcc"
    },
    {
      "id": "2801d3db-7c19-45b8-82f8-746c9e09eec8",
      "text": "niềm vui làm rạng rỡ kẻ lòng ngay.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 1,
      "paragraphNumber": 25,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:40.479Z",
      "updatedAt": "2025-09-03T02:34:40.479Z",
      "chapterId": "4dad29a0-92a1-44f8-bb2c-56c21b63bdcc"
    },
    {
      "id": "4c529a2f-9aa0-4014-8bf1-3582aec4cc4b",
      "text": "Trước nhan thánh CHÚA, người công chính hãy vui mừng",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 26,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:40.493Z",
      "updatedAt": "2025-09-03T02:34:40.493Z",
      "chapterId": "4dad29a0-92a1-44f8-bb2c-56c21b63bdcc"
    },
    {
      "id": "fca93b51-58f7-4a17-bd05-86b0836d5882",
      "text": "tưởng nhớ Thánh Danh mà dâng lời cảm tạ.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 1,
      "paragraphNumber": 27,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:40.508Z",
      "updatedAt": "2025-09-03T02:34:40.508Z",
      "chapterId": "4dad29a0-92a1-44f8-bb2c-56c21b63bdcc"
    }
  ],
  "marks": [
    {
