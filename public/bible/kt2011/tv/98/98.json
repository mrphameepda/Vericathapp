{
  "chapter": {
    "id": "8a98dba7-16e7-43a4-829a-45591d2d9100",
    "number": 98,
    "createdAt": "2025-09-03T01:07:51.662Z",
    "updatedAt": "2025-09-03T01:07:51.662Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "2f7e5706-bd99-4492-b1a1-eaa369bd09ef",
      "text": "*Thánh vịnh.*",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T02:34:46.031Z",
      "updatedAt": "2025-09-03T02:34:46.031Z",
      "chapterId": "8a98dba7-16e7-43a4-829a-45591d2d9100"
    },
    {
      "id": "cce5d0e7-32d3-4f6f-b395-89d2c02fac49",
      "text": "Hát lên mừng CHÚA một bài ca mới,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:46.081Z",
      "updatedAt": "2025-09-03T02:34:46.081Z",
      "chapterId": "8a98dba7-16e7-43a4-829a-45591d2d9100"
    },
    {
      "id": "3b89276b-05be-46b2-9f22-75068787feb2",
      "text": "vì Người đã thực hiện bao kỳ công.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 2,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:46.102Z",
      "updatedAt": "2025-09-03T02:34:46.102Z",
      "chapterId": "8a98dba7-16e7-43a4-829a-45591d2d9100"
    },
    {
      "id": "52a9cbe6-300a-4362-b3f0-0afce37bf620",
      "text": "Người chiến thắng nhờ bàn tay hùng mạnh,",
      "label": "1",
      "number": 1,
      "subVerseIndex": 3,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:46.113Z",
      "updatedAt": "2025-09-03T02:34:46.113Z",
      "chapterId": "8a98dba7-16e7-43a4-829a-45591d2d9100"
    },
    {
      "id": "64f391b7-27fb-417f-9e56-eac560c1570e",
      "text": "nhờ cánh tay chí thánh của Người.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 4,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:46.134Z",
      "updatedAt": "2025-09-03T02:34:46.134Z",
      "chapterId": "8a98dba7-16e7-43a4-829a-45591d2d9100"
    },
    {
      "id": "c6d5f5f8-090e-4d67-ad19-9c5fc61b2120",
      "text": "CHÚA đã biểu dương ơn Người cứu độ,",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:46.155Z",
      "updatedAt": "2025-09-03T02:34:46.155Z",
      "chapterId": "8a98dba7-16e7-43a4-829a-45591d2d9100"
    },
    {
      "id": "c44d5dc3-ecbf-4b98-8565-a91abd5a4885",
      "text": "mặc khải đức công chính của Người trước mặt chư dân ;",
      "label": "2",
      "number": 2,
      "subVerseIndex": 1,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:46.167Z",
      "updatedAt": "2025-09-03T02:34:46.167Z",
      "chapterId": "8a98dba7-16e7-43a4-829a-45591d2d9100"
    },
    {
      "id": "1e8780d8-dfc8-47b9-9209-b2cf8dda3be6",
      "text": "Người đã nhớ lại ân tình và tín nghĩa dành cho nhà Ít-ra-en.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:46.179Z",
      "updatedAt": "2025-09-03T02:34:46.179Z",
      "chapterId": "8a98dba7-16e7-43a4-829a-45591d2d9100"
    },
    {
      "id": "68894ec9-10b1-4f10-a0a0-c0ffdfc1396f",
      "text": "Toàn cõi đất này đã xem thấy",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:46.207Z",
      "updatedAt": "2025-09-03T02:34:46.207Z",
      "chapterId": "8a98dba7-16e7-43a4-829a-45591d2d9100"
    },
    {
      "id": "50ed01fc-bd7f-40ea-b2e6-5caa9f2f2e4e",
      "text": "ơn cứu độ của Thiên Chúa chúng ta.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:46.221Z",
      "updatedAt": "2025-09-03T02:34:46.221Z",
      "chapterId": "8a98dba7-16e7-43a4-829a-45591d2d9100"
    },
    {
      "id": "29ec56e8-a405-4fe1-b729-8b887a6194f0",
      "text": "Tung hô CHÚA, hỡi toàn thể địa cầu,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:46.249Z",
      "updatedAt": "2025-09-03T02:34:46.249Z",
      "chapterId": "8a98dba7-16e7-43a4-829a-45591d2d9100"
    },
    {
      "id": "59f205f1-c251-457a-8256-a14794f555f9",
      "text": "mừng vui lên, reo hò đàn hát.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:46.263Z",
      "updatedAt": "2025-09-03T02:34:46.263Z",
      "chapterId": "8a98dba7-16e7-43a4-829a-45591d2d9100"
    },
    {
      "id": "feb13aa9-b06c-49a5-808a-ac21181eb7f2",
      "text": "Đàn lên mừng CHÚA khúc hạc cầm dìu dặt,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:46.277Z",
      "updatedAt": "2025-09-03T02:34:46.277Z",
      "chapterId": "8a98dba7-16e7-43a4-829a-45591d2d9100"
    },
    {
      "id": "e006dc8f-6f93-4672-b5c7-616df065e359",
      "text": "nương khúc hạc cầm réo rắt giọng ca.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:46.291Z",
      "updatedAt": "2025-09-03T02:34:46.291Z",
      "chapterId": "8a98dba7-16e7-43a4-829a-45591d2d9100"
    },
    {
      "id": "d8d1c81d-c53f-4bbb-9299-d7a290599e78",
      "text": "Kèn thổi vang xen tiếng tù và,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:46.305Z",
      "updatedAt": "2025-09-03T02:34:46.305Z",
      "chapterId": "8a98dba7-16e7-43a4-829a-45591d2d9100"
    },
    {
      "id": "667e509b-cf19-44c9-9acb-b7b151ed86b7",
      "text": "tung hô mừng CHÚA, vị Quân Vương !",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:46.320Z",
      "updatedAt": "2025-09-03T02:34:46.320Z",
      "chapterId": "8a98dba7-16e7-43a4-829a-45591d2d9100"
    },
    {
      "id": "99575227-b0a7-41c5-803c-54bf446a3104",
      "text": "Gầm vang lên, hỡi biển cả cùng muôn hải vật,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:46.334Z",
      "updatedAt": "2025-09-03T02:34:46.334Z",
      "chapterId": "8a98dba7-16e7-43a4-829a-45591d2d9100"
    },
    {
      "id": "25721963-d728-4637-afa9-c072a2805c9d",
      "text": "địa cầu với toàn thể dân cư !",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:46.361Z",
      "updatedAt": "2025-09-03T02:34:46.361Z",
      "chapterId": "8a98dba7-16e7-43a4-829a-45591d2d9100"
    },
    {
      "id": "518635bb-e004-45b0-afe0-8030e67919cc",
      "text": "Sông lạch ơi, vỗ tay đi nào,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:46.375Z",
      "updatedAt": "2025-09-03T02:34:46.375Z",
      "chapterId": "8a98dba7-16e7-43a4-829a-45591d2d9100"
    },
    {
      "id": "503b4d5a-5080-4183-b264-a0be738a27b4",
      "text": "đồi núi hỡi, reo mừng trước tôn nhan CHÚA.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:46.390Z",
      "updatedAt": "2025-09-03T02:34:46.390Z",
      "chapterId": "8a98dba7-16e7-43a4-829a-45591d2d9100"
    },
    {
      "id": "9f21b045-435d-4867-97e6-840dd6bca735",
      "text": "Vì Người ngự đến xét xử trần gian,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:46.417Z",
      "updatedAt": "2025-09-03T02:34:46.417Z",
      "chapterId": "8a98dba7-16e7-43a4-829a-45591d2d9100"
    },
    {
      "id": "c91e20e8-f771-4f95-90b2-548b57cf37db",
      "text": "Người xét xử địa cầu theo đường công chính,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:46.445Z",
      "updatedAt": "2025-09-03T02:34:46.445Z",
      "chapterId": "8a98dba7-16e7-43a4-829a-45591d2d9100"
    },
    {
      "id": "8fd6d0aa-57e4-4bf7-9bcf-14dd3cc900c2",
      "text": "xét xử muôn dân theo lẽ công bằng.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 22,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:46.458Z",
      "updatedAt": "2025-09-03T02:34:46.458Z",
      "chapterId": "8a98dba7-16e7-43a4-829a-45591d2d9100"
    }
  ],
