    },
    {
      "id": "c339f002-0dac-4166-9089-22f9d9ab5e3e",
      "content": "Tv 33,3; 96,1ss",
      "kind": "MARK_KIND_REFERENCE",
      "label": "1@",
      "sortOrder": 0,
      "startOffset": 22,
      "endOffset": 22,
      "createdAt": "2025-09-03T02:34:46.092Z",
      "updatedAt": "2025-09-03T02:34:46.092Z",
      "targetId": "cce5d0e7-32d3-4f6f-b395-89d2c02fac49",
      "targetType": "MARK_TARGET_TYPE_VERSE",
