{
  "chapter": {
    "id": "2a3adcbb-5fac-4ece-8fb1-2abec06fbad4",
    "number": 99,
    "createdAt": "2025-09-03T01:07:51.662Z",
    "updatedAt": "2025-09-03T01:07:51.662Z",
    "bookId": "23e65d68-5cfc-4944-af24-5814c5bf2a8b"
  },
  "verses": [
    {
      "id": "9e6381cf-2725-41ec-8232-019ff44650c5",
      "text": "CHÚA là Vua hiển trị : chư dân phải rụng rời ;",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:52.265Z",
      "updatedAt": "2025-09-03T02:34:52.265Z",
      "chapterId": "2a3adcbb-5fac-4ece-8fb1-2abec06fbad4"
    },
    {
      "id": "59f0151e-03e9-45cb-a1ff-b819040da01e",
      "text": "Người ngự trên các Kê-ru-bim : địa cầu phải chuyển rung.",
      "label": "1",
      "number": 1,
      "subVerseIndex": 1,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:52.319Z",
      "updatedAt": "2025-09-03T02:34:52.319Z",
      "chapterId": "2a3adcbb-5fac-4ece-8fb1-2abec06fbad4"
    },
    {
      "id": "cb75241c-c7d2-4b46-bc54-8d95f0fc96b4",
      "text": "Ở Xi-on, CHÚA quả là vĩ đại, Người trổi vượt trên tất cả mọi dân.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:52.331Z",
      "updatedAt": "2025-09-03T02:34:52.331Z",
      "chapterId": "2a3adcbb-5fac-4ece-8fb1-2abec06fbad4"
    },
    {
      "id": "0d49ec94-8636-43a2-a48b-39c3e44ddbd8",
      "text": "Chư dân hãy xưng tụng danh Ngài,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:52.379Z",
      "updatedAt": "2025-09-03T02:34:52.379Z",
      "chapterId": "2a3adcbb-5fac-4ece-8fb1-2abec06fbad4"
    },
    {
      "id": "71fadbb1-d6a2-4623-99bb-21dd88b5e799",
      "text": "danh vĩ đại khả tôn khả uý,",
      "label": "3",
      "number": 3,
      "subVerseIndex": 1,
      "paragraphNumber": 4,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:52.392Z",
      "updatedAt": "2025-09-03T02:34:52.392Z",
      "chapterId": "2a3adcbb-5fac-4ece-8fb1-2abec06fbad4"
    },
    {
      "id": "b79477d4-d963-452a-9c3a-4fe5d0f59059",
      "text": "danh thánh thiện dường bao !",
      "label": "3",
      "number": 3,
      "subVerseIndex": 2,
      "paragraphNumber": 5,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:52.407Z",
      "updatedAt": "2025-09-03T02:34:52.407Z",
      "chapterId": "2a3adcbb-5fac-4ece-8fb1-2abec06fbad4"
    },
    {
      "id": "848fefe9-44c8-44d4-b43f-a75dd3260e11",
      "text": "Ngài là vua uy dũng yêu chuộng công bằng,",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 6,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:52.438Z",
      "updatedAt": "2025-09-03T02:34:52.438Z",
      "chapterId": "2a3adcbb-5fac-4ece-8fb1-2abec06fbad4"
    },
    {
      "id": "3189886f-5e35-47d0-aee5-cbe2e61369eb",
      "text": "chính Ngài ấn định đường ngay lẽ phải ;",
      "label": "4",
      "number": 4,
      "subVerseIndex": 1,
      "paragraphNumber": 7,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:52.454Z",
      "updatedAt": "2025-09-03T02:34:52.454Z",
      "chapterId": "2a3adcbb-5fac-4ece-8fb1-2abec06fbad4"
    },
    {
      "id": "edbf7cd8-ea14-421d-a41d-5c2c31fcbb55",
      "text": "trong nhà Gia-cóp, Ngài thực hiện điều chính trực công minh.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 2,
      "paragraphNumber": 8,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:52.468Z",
      "updatedAt": "2025-09-03T02:34:52.468Z",
      "chapterId": "2a3adcbb-5fac-4ece-8fb1-2abec06fbad4"
    },
    {
      "id": "e47f691f-4802-4761-91c5-82ed8d343fbb",
      "text": "Hãy suy tôn ĐỨC CHÚA là Thiên Chúa chúng ta,",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 9,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:52.496Z",
      "updatedAt": "2025-09-03T02:34:52.496Z",
      "chapterId": "2a3adcbb-5fac-4ece-8fb1-2abec06fbad4"
    },
    {
      "id": "07ad468f-56ab-4498-8979-2f60a73d9a28",
      "text": "phủ phục trước bệ rồng, bởi Người là Đấng Thánh.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 1,
      "paragraphNumber": 10,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:52.524Z",
      "updatedAt": "2025-09-03T02:34:52.524Z",
      "chapterId": "2a3adcbb-5fac-4ece-8fb1-2abec06fbad4"
    },
    {
      "id": "d245cf7d-ef88-4018-ad51-3b5746bbdb3b",
      "text": "Mô-sê cùng A-ha-ron trong hàng tư tế Chúa,",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 11,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:52.551Z",
      "updatedAt": "2025-09-03T02:34:52.551Z",
      "chapterId": "2a3adcbb-5fac-4ece-8fb1-2abec06fbad4"
    },
    {
      "id": "488688bf-b268-4a61-bf31-dc0980b778c9",
      "text": "cũng như Sa-mu-en trong số người cầu khẩn Thánh Danh !",
      "label": "6",
      "number": 6,
      "subVerseIndex": 1,
      "paragraphNumber": 12,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:52.607Z",
      "updatedAt": "2025-09-03T02:34:52.607Z",
      "chapterId": "2a3adcbb-5fac-4ece-8fb1-2abec06fbad4"
    },
    {
      "id": "6ef78852-cda3-4780-b143-e04dfcbf5cfa",
      "text": "Các ngài cầu khẩn CHÚA, Chúa thương đáp lại.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 2,
      "paragraphNumber": 13,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:52.649Z",
      "updatedAt": "2025-09-03T02:34:52.649Z",
      "chapterId": "2a3adcbb-5fac-4ece-8fb1-2abec06fbad4"
    },
    {
      "id": "2f0f478d-170f-45a9-88c7-04f0d0489637",
      "text": "Từ cột mây, Chúa phán dạy các ngài,",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 14,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:52.663Z",
      "updatedAt": "2025-09-03T02:34:52.663Z",
      "chapterId": "2a3adcbb-5fac-4ece-8fb1-2abec06fbad4"
    },
    {
      "id": "f6b56400-70f5-4dd1-8658-86f359b96322",
      "text": "các ngài đã tuân hành thánh ý, và chiếu chỉ Người ban.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 1,
      "paragraphNumber": 15,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:52.677Z",
      "updatedAt": "2025-09-03T02:34:52.677Z",
      "chapterId": "2a3adcbb-5fac-4ece-8fb1-2abec06fbad4"
    },
    {
      "id": "588f2ae7-f88e-4f9b-a695-0492e142d51a",
      "text": "Lạy CHÚA là Thiên Chúa chúng con, Chúa đã thương đáp lại,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 16,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:52.691Z",
      "updatedAt": "2025-09-03T02:34:52.691Z",
      "chapterId": "2a3adcbb-5fac-4ece-8fb1-2abec06fbad4"
    },
    {
      "id": "c5c6b05c-2806-4628-b2bc-c5cbea6d3e56",
      "text": "Chúa là Thiên Chúa khoan dung khi xử với các ngài,",
      "label": "8",
      "number": 8,
      "subVerseIndex": 1,
      "paragraphNumber": 17,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:52.706Z",
      "updatedAt": "2025-09-03T02:34:52.706Z",
      "chapterId": "2a3adcbb-5fac-4ece-8fb1-2abec06fbad4"
    },
    {
      "id": "fb993a78-c50f-443e-a557-b0663449d4db",
      "text": "nhưng trừng phạt khi các ngài lầm lỗi.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 2,
      "paragraphNumber": 18,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:52.720Z",
      "updatedAt": "2025-09-03T02:34:52.720Z",
      "chapterId": "2a3adcbb-5fac-4ece-8fb1-2abec06fbad4"
    },
    {
      "id": "69a2efe0-29d4-4ad7-94b9-f0d826c0b26c",
      "text": "Hãy suy tôn ĐỨC CHÚA là Thiên Chúa chúng ta,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 19,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:52.737Z",
      "updatedAt": "2025-09-03T02:34:52.737Z",
      "chapterId": "2a3adcbb-5fac-4ece-8fb1-2abec06fbad4"
    },
    {
      "id": "d69514f1-e1d7-415a-a4fa-a8e6e6a15fb3",
      "text": "hướng về núi thánh mà phủ phục,",
      "label": "9",
      "number": 9,
      "subVerseIndex": 1,
      "paragraphNumber": 20,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:52.760Z",
      "updatedAt": "2025-09-03T02:34:52.760Z",
      "chapterId": "2a3adcbb-5fac-4ece-8fb1-2abec06fbad4"
    },
    {
      "id": "d57d07a5-231b-424d-a7cb-c4e6d2208da2",
      "text": "vì ĐỨC CHÚA, Thiên Chúa ta thờ, quả thật là Đấng Thánh.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 2,
      "paragraphNumber": 21,
      "paragraphIndex": 0,
      "isPoetry": true,
      "createdAt": "2025-09-03T02:34:52.772Z",
      "updatedAt": "2025-09-03T02:34:52.772Z",
      "chapterId": "2a3adcbb-5fac-4ece-8fb1-2abec06fbad4"
    }
  ],
