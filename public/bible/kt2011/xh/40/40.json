{
  "chapter": {
    "id": "71f865a7-4c66-4f82-a146-196944e1e591",
    "number": 40,
    "createdAt": "2025-09-03T01:07:51.670Z",
    "updatedAt": "2025-09-03T01:07:51.670Z",
    "bookId": "d65acf38-252e-4d78-ab64-5ac41d3c4d1a"
  },
  "verses": [
    {
      "id": "3f204ee7-887d-429e-990a-17a2689e4237",
      "text": "ĐỨC CHÚA phán với ông Mô-sê :",
      "label": "1",
      "number": 1,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:19:07.436Z",
      "updatedAt": "2025-09-03T01:19:07.436Z",
      "chapterId": "71f865a7-4c66-4f82-a146-196944e1e591"
    },
    {
      "id": "1c371fd4-90f0-4c94-925b-0d59aace1281",
      "text": "“Vào ngày mồng một tháng giêng, ngươi sẽ dựng Nhà Tạm, dựng Lều Hội Ngộ.",
      "label": "2",
      "number": 2,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 1,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:19:07.494Z",
      "updatedAt": "2025-09-03T01:19:07.494Z",
      "chapterId": "71f865a7-4c66-4f82-a146-196944e1e591"
    },
    {
      "id": "0e46973a-5d2b-407c-9a6d-09848ab84ca5",
      "text": "Ngươi sẽ đặt vào đó Hòm Bia Chứng Ước và lấy bức trướng mà che Hòm Bia ấy.",
      "label": "3",
      "number": 3,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 2,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:19:07.506Z",
      "updatedAt": "2025-09-03T01:19:07.506Z",
      "chapterId": "71f865a7-4c66-4f82-a146-196944e1e591"
    },
    {
      "id": "f8a7ed2f-b94b-4304-9c72-f27c5d8779a7",
      "text": "Ngươi sẽ đem bàn tới và bày trên đó những gì cần phải bày ra. Ngươi sẽ đem trụ đèn tới và đặt đèn lên đó.",
      "label": "4",
      "number": 4,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 3,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:19:07.516Z",
      "updatedAt": "2025-09-03T01:19:07.516Z",
      "chapterId": "71f865a7-4c66-4f82-a146-196944e1e591"
    },
    {
      "id": "4082681a-7c5f-4b02-a87a-08f34a2b9811",
      "text": "Ngươi sẽ đặt hương án bằng vàng trước Hòm Bia Chứng Ước, và treo màn che cửa Nhà Tạm.",
      "label": "5",
      "number": 5,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 4,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:19:07.528Z",
      "updatedAt": "2025-09-03T01:19:07.528Z",
      "chapterId": "71f865a7-4c66-4f82-a146-196944e1e591"
    },
    {
      "id": "90ecaf76-9a9c-478f-a82d-56d90d5f8898",
      "text": "Ngươi sẽ đặt bàn thờ dâng lễ toàn thiêu trước cửa Nhà Tạm, trước cửa Lều Hội Ngộ.",
      "label": "6",
      "number": 6,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 5,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:19:07.539Z",
      "updatedAt": "2025-09-03T01:19:07.539Z",
      "chapterId": "71f865a7-4c66-4f82-a146-196944e1e591"
    },
    {
      "id": "7cd29150-ecdc-4749-8c3f-cee0e815818f",
      "text": "Ngươi sẽ đặt cái vạc ở giữa Lều Hội Ngộ và bàn thờ, và đổ nước vào đó.",
      "label": "7",
      "number": 7,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 6,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:19:07.549Z",
      "updatedAt": "2025-09-03T01:19:07.549Z",
      "chapterId": "71f865a7-4c66-4f82-a146-196944e1e591"
    },
    {
      "id": "e2a31bbb-3037-4bf3-9789-41fd76a26bad",
      "text": "Ngươi sẽ làm khuôn viên chung quanh và treo màn che cửa khuôn viên.",
      "label": "8",
      "number": 8,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 7,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:19:07.560Z",
      "updatedAt": "2025-09-03T01:19:07.560Z",
      "chapterId": "71f865a7-4c66-4f82-a146-196944e1e591"
    },
    {
      "id": "2a5ffbd1-baa6-4abc-a335-1625d0e9a38a",
      "text": "Ngươi sẽ lấy dầu tấn phong xức Nhà Tạm và tất cả những gì trong đó ; ngươi sẽ thánh hiến Nhà Tạm và mọi đồ vật trong đó ; như thế, Nhà Tạm sẽ là vật thánh.",
      "label": "9",
      "number": 9,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 8,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:19:07.570Z",
      "updatedAt": "2025-09-03T01:19:07.570Z",
      "chapterId": "71f865a7-4c66-4f82-a146-196944e1e591"
    },
    {
      "id": "1182e572-4883-4c8d-9ae0-24cdacb89991",
      "text": "Ngươi sẽ xức dầu bàn thờ dâng lễ toàn thiêu và mọi đồ dùng ; ngươi sẽ thánh hiến bàn thờ, và bàn thờ sẽ là vật rất thánh.",
      "label": "10",
      "number": 10,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 9,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:19:07.590Z",
      "updatedAt": "2025-09-03T01:19:07.590Z",
      "chapterId": "71f865a7-4c66-4f82-a146-196944e1e591"
    },
    {
      "id": "6721ab98-62c5-4eb4-992e-2cfba7c77866",
      "text": "Ngươi sẽ xức dầu cái vạc và đế, ngươi sẽ thánh hiến cái vạc đó.",
      "label": "11",
      "number": 11,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 10,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:19:07.602Z",
      "updatedAt": "2025-09-03T01:19:07.602Z",
      "chapterId": "71f865a7-4c66-4f82-a146-196944e1e591"
    },
    {
      "id": "11aa44db-55b1-4851-b2ea-75752ab5a897",
      "text": "Ngươi sẽ dẫn A-ha-ron và các con ông đến gần cửa Lều Hội Ngộ và lấy nước tẩy rửa họ.",
      "label": "12",
      "number": 12,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 11,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:19:07.613Z",
      "updatedAt": "2025-09-03T01:19:07.613Z",
      "chapterId": "71f865a7-4c66-4f82-a146-196944e1e591"
    },
    {
      "id": "6bbf4ff1-c5ab-4dfb-abb8-08009bc7ef56",
      "text": "Ngươi sẽ lấy phẩm phục mặc cho A-ha-ron, xức dầu thánh hiến để ông ấy thi hành chức tư tế phục vụ Ta.",
      "label": "13",
      "number": 13,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 12,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:19:07.649Z",
      "updatedAt": "2025-09-03T01:19:07.649Z",
      "chapterId": "71f865a7-4c66-4f82-a146-196944e1e591"
    },
    {
      "id": "2688a5db-4d26-47f8-8241-3cebde29ff97",
      "text": "Ngươi sẽ dẫn các con ông lại gần và cho họ mặc áo dài.",
      "label": "14",
      "number": 14,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 13,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:19:07.680Z",
      "updatedAt": "2025-09-03T01:19:07.680Z",
      "chapterId": "71f865a7-4c66-4f82-a146-196944e1e591"
    },
    {
      "id": "71ddbfce-c7a3-493c-8b9e-b91c90d0ee79",
      "text": "Ngươi đã xức dầu họ như đã xức dầu cha họ, để họ thi hành chức tư tế phục vụ Ta. Ngươi sẽ làm như thế, để nhờ việc xức dầu, họ trở nên tư tế vĩnh viễn, đời nọ đến đời kia.",
      "label": "15",
      "number": 15,
      "subVerseIndex": 0,
      "paragraphNumber": 0,
      "paragraphIndex": 14,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:19:07.689Z",
      "updatedAt": "2025-09-03T01:19:07.689Z",
      "chapterId": "71f865a7-4c66-4f82-a146-196944e1e591"
    },
    {
      "id": "8f5c4e53-94c7-4489-9ce9-29465236982a",
      "text": "Ông Mô-sê làm mọi sự đúng y như ĐỨC CHÚA đã truyền cho ông.",
      "label": "16",
      "number": 16,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:19:07.701Z",
      "updatedAt": "2025-09-03T01:19:07.701Z",
      "chapterId": "71f865a7-4c66-4f82-a146-196944e1e591"
    },
    {
      "id": "496f460d-669a-4b1e-816d-58a650f0de9a",
      "text": "Ngày mồng một tháng giêng năm thứ hai, Nhà Tạm được dựng lên.",
      "label": "17",
      "number": 17,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 1,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:19:07.741Z",
      "updatedAt": "2025-09-03T01:19:07.741Z",
      "chapterId": "71f865a7-4c66-4f82-a146-196944e1e591"
    },
    {
      "id": "b49d249d-da0e-49c2-bd4d-efe188f3d89b",
      "text": "Ông Mô-sê cho dựng Nhà Tạm. Ông cho đặt đế, ghép ván, đặt thanh ngang và dựng cột.",
      "label": "18",
      "number": 18,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 2,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:19:07.751Z",
      "updatedAt": "2025-09-03T01:19:07.751Z",
      "chapterId": "71f865a7-4c66-4f82-a146-196944e1e591"
    },
    {
      "id": "a86d41a2-a6c7-47db-afd9-72c8632083f4",
      "text": "Ông cho căng lều trên Nhà Tạm, lấy bạt che phía trên lều, như ĐỨC CHÚA đã truyền cho ông Mô-sê.",
      "label": "19",
      "number": 19,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 3,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:19:07.773Z",
      "updatedAt": "2025-09-03T01:19:07.773Z",
      "chapterId": "71f865a7-4c66-4f82-a146-196944e1e591"
    },
    {
      "id": "208acba7-6e3d-4cb2-882a-56a5df30dc6e",
      "text": "Ông lấy Chứng Ước đặt vào Hòm Bia, xỏ đòn vào Hòm Bia, đặt nắp xá tội lên trên đó.",
      "label": "20",
      "number": 20,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 4,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:19:07.803Z",
      "updatedAt": "2025-09-03T01:19:07.803Z",
      "chapterId": "71f865a7-4c66-4f82-a146-196944e1e591"
    },
    {
      "id": "731ca6aa-9589-4913-ad5f-a9118d6d6c8f",
      "text": "Ông rước Hòm Bia vào trong Nhà Tạm và treo bức trướng để che khuất Hòm Bia Chứng Ước, như ĐỨC CHÚA đã truyền cho ông Mô-sê.",
      "label": "21",
      "number": 21,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 5,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:19:07.815Z",
      "updatedAt": "2025-09-03T01:19:07.815Z",
      "chapterId": "71f865a7-4c66-4f82-a146-196944e1e591"
    },
    {
      "id": "d45c9eba-6ec4-46c6-bbf3-bacda8454458",
      "text": "Ông cho đặt chiếc bàn trong Lều Hội Ngộ, bên cạnh Nhà Tạm, phía bắc, bên ngoài bức trướng,",
      "label": "22",
      "number": 22,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 6,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:19:07.843Z",
      "updatedAt": "2025-09-03T01:19:07.843Z",
      "chapterId": "71f865a7-4c66-4f82-a146-196944e1e591"
    },
    {
      "id": "aa9b3d28-2f24-4690-9ec8-4e938e15c6a3",
      "text": "rồi cho bày một hàng bánh trên đó, trước nhan ĐỨC CHÚA, như ĐỨC CHÚA đã truyền cho ông Mô-sê.",
      "label": "23",
      "number": 23,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 7,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:19:07.855Z",
      "updatedAt": "2025-09-03T01:19:07.855Z",
      "chapterId": "71f865a7-4c66-4f82-a146-196944e1e591"
    },
    {
      "id": "502cea45-566b-4e57-8ca8-6087f521ad00",
      "text": "Ông cho đặt trụ đèn trong Lều Hội Ngộ, đối diện với bàn, bên cạnh Nhà tạm, phía nam,",
      "label": "24",
      "number": 24,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 8,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:19:07.898Z",
      "updatedAt": "2025-09-03T01:19:07.898Z",
      "chapterId": "71f865a7-4c66-4f82-a146-196944e1e591"
    },
    {
      "id": "b06303cf-62fa-42ff-8327-f1a056eef4ef",
      "text": "rồi cho đặt đèn lên đó, trước nhan ĐỨC CHÚA, như ĐỨC CHÚA đã truyền cho ông Mô-sê.",
      "label": "25",
      "number": 25,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 9,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:19:07.908Z",
      "updatedAt": "2025-09-03T01:19:07.908Z",
      "chapterId": "71f865a7-4c66-4f82-a146-196944e1e591"
    },
    {
      "id": "c60b03a8-b1fc-4942-9095-b14dd3e7c7c6",
      "text": "Ông cho đặt bàn thờ bằng vàng trong Lều Hội Ngộ, phía trước bức trướng,",
      "label": "26",
      "number": 26,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 10,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:19:07.952Z",
      "updatedAt": "2025-09-03T01:19:07.952Z",
      "chapterId": "71f865a7-4c66-4f82-a146-196944e1e591"
    },
    {
      "id": "6a8d5cee-70dd-4885-9df3-b55590e16c6a",
      "text": "rồi cho đốt hương thơm trên đó, như ĐỨC CHÚA đã truyền cho ông Mô-sê.",
      "label": "27",
      "number": 27,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 11,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:19:07.962Z",
      "updatedAt": "2025-09-03T01:19:07.962Z",
      "chapterId": "71f865a7-4c66-4f82-a146-196944e1e591"
    },
    {
      "id": "108029ab-146c-471b-b834-a2582b9fdfb1",
      "text": "Ông cho treo màn che cửa Nhà Tạm.",
      "label": "28",
      "number": 28,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 12,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:19:07.995Z",
      "updatedAt": "2025-09-03T01:19:07.995Z",
      "chapterId": "71f865a7-4c66-4f82-a146-196944e1e591"
    },
    {
      "id": "4ff30b65-1814-4b8a-b4f8-d1b06235f6df",
      "text": "Bàn thờ dâng lễ toàn thiêu, ông cho đặt ở cửa Nhà Tạm, ở cửa lều Hội Ngộ, rồi ông dâng lễ toàn thiêu và lễ phẩm trên đó, như ĐỨC CHÚA đã truyền cho ông Mô-sê.",
      "label": "29",
      "number": 29,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 13,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:19:08.005Z",
      "updatedAt": "2025-09-03T01:19:08.005Z",
      "chapterId": "71f865a7-4c66-4f82-a146-196944e1e591"
    },
    {
      "id": "1d4373f0-f044-4cd0-b021-6f729030a2ff",
      "text": "Ông cho đặt cái vạc ở giữa Lều Hội Ngộ và bàn thờ, rồi đổ nước vào đó, để dùng vào việc tẩy rửa.",
      "label": "30",
      "number": 30,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 14,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:19:08.039Z",
      "updatedAt": "2025-09-03T01:19:08.039Z",
      "chapterId": "71f865a7-4c66-4f82-a146-196944e1e591"
    },
    {
      "id": "5c639349-ab12-431b-89dd-e5095f9c5e8e",
      "text": "Ông A-ha-ron và các con ông lấy nước ấy mà rửa tay chân.",
      "label": "31",
      "number": 31,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 15,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:19:08.051Z",
      "updatedAt": "2025-09-03T01:19:08.051Z",
      "chapterId": "71f865a7-4c66-4f82-a146-196944e1e591"
    },
    {
      "id": "1d2b2103-2b8f-45c2-8d03-8f704e7ed9f3",
      "text": "Mỗi khi họ vào Lều Hội Ngộ và tới gần bàn thờ, thì họ tẩy rửa, như ĐỨC CHÚA đã truyền cho ông Mô-sê.",
      "label": "32",
      "number": 32,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 16,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:19:08.080Z",
      "updatedAt": "2025-09-03T01:19:08.080Z",
      "chapterId": "71f865a7-4c66-4f82-a146-196944e1e591"
    },
    {
      "id": "4c7c7667-1e26-4f34-80c5-aec726cff88e",
      "text": "Ông cho làm khuôn viên chung quanh Nhà Tạm và bàn thờ, rồi cho treo màn che cửa khuôn viên. Như thế, ông Mô-sê đã hoàn thành công việc.",
      "label": "33",
      "number": 33,
      "subVerseIndex": 0,
      "paragraphNumber": 1,
      "paragraphIndex": 17,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:19:08.126Z",
      "updatedAt": "2025-09-03T01:19:08.126Z",
      "chapterId": "71f865a7-4c66-4f82-a146-196944e1e591"
    },
    {
      "id": "693a64f4-47d4-4b82-b877-b4e5d9b7a0c2",
      "text": "Đám mây che phủ Lều Hội Ngộ, và vinh quang ĐỨC CHÚA đầy tràn Nhà Tạm.",
      "label": "34",
      "number": 34,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:19:08.161Z",
      "updatedAt": "2025-09-03T01:19:08.161Z",
      "chapterId": "71f865a7-4c66-4f82-a146-196944e1e591"
    },
    {
      "id": "875a67f3-8528-4f25-86b6-c78a567a73e2",
      "text": "Ông Mô-sê không thể vào Lều Hội Ngộ vì đám mây đậu trên đó, và vinh quang ĐỨC CHÚA đầy tràn Nhà Tạm.",
      "label": "35",
      "number": 35,
      "subVerseIndex": 0,
      "paragraphNumber": 2,
      "paragraphIndex": 1,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:19:08.262Z",
      "updatedAt": "2025-09-03T01:19:08.262Z",
      "chapterId": "71f865a7-4c66-4f82-a146-196944e1e591"
    },
    {
      "id": "9bf9e8a6-8128-4bf7-8f0d-885ee3eb2c22",
      "text": "Ở mỗi chặng đường của họ, khi nào đám mây bay lên khỏi Nhà Tạm, thì con cái Ít-ra-en nhổ trại.",
      "label": "36",
      "number": 36,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 0,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:19:08.331Z",
      "updatedAt": "2025-09-03T01:19:08.331Z",
      "chapterId": "71f865a7-4c66-4f82-a146-196944e1e591"
    },
    {
      "id": "17736463-37ca-4d7b-a92f-92a10a72f0f9",
      "text": "Nếu mây không bay lên, thì họ không nhổ trại cho đến ngày mây lại bay lên.",
      "label": "37",
      "number": 37,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 1,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:19:08.424Z",
      "updatedAt": "2025-09-03T01:19:08.424Z",
      "chapterId": "71f865a7-4c66-4f82-a146-196944e1e591"
    },
    {
      "id": "7f1565c4-a264-4d9c-a15b-f150809b093d",
      "text": "Quả vậy, đám mây của ĐỨC CHÚA đậu trên Nhà Tạm ban ngày, còn ban đêm thì có lửa trong mây, trước mắt toàn thể con cái Ít-ra-en, ở mỗi chặng đường họ đi.",
      "label": "38",
      "number": 38,
      "subVerseIndex": 0,
      "paragraphNumber": 3,
      "paragraphIndex": 2,
      "isPoetry": false,
      "createdAt": "2025-09-03T01:19:08.434Z",
      "updatedAt": "2025-09-03T01:19:08.434Z",
      "chapterId": "71f865a7-4c66-4f82-a146-196944e1e591"
    }
  ],
