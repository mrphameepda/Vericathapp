  "headings": [
    {
      "id": "3ec59c27-90ee-4655-8c44-eab06ce422dc",
      "text": "Cuộc hội kiến đầu tiên với Pha-ra-ô",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T01:15:00.733Z",
      "updatedAt": "2025-09-03T01:15:00.733Z",
      "verseId": "447dda33-ebb4-49ed-8999-c74c4182008b",
      "chapterId": "9c6751cb-f180-4d9e-ae77-f646e1b611cd"
    },
    {
      "id": "d908e177-dd5e-4e69-b3b9-f08da5f349f4",
      "text": "Chỉ thị cho các ông cai",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T01:15:01.219Z",
      "updatedAt": "2025-09-03T01:15:01.219Z",
      "verseId": "f6b6731a-dfde-4cab-aedc-0aa170a65680",
      "chapterId": "9c6751cb-f180-4d9e-ae77-f646e1b611cd"
    },
    {
      "id": "8cefdb2a-a061-46c3-a1f3-b9e4f584e349",
      "text": "Các ký lục của người Ít-ra-en than phiền",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T01:15:01.418Z",
      "updatedAt": "2025-09-03T01:15:01.418Z",
      "verseId": "68b010c2-bf61-45c8-9782-221059d6cd78",
      "chapterId": "9c6751cb-f180-4d9e-ae77-f646e1b611cd"
    },
    {
      "id": "038c005d-a524-43b6-a24b-9c264e54f849",
      "text": "Dân than trách. Ông Mô-sê kêu cầu.",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T01:15:01.555Z",
      "updatedAt": "2025-09-03T01:15:01.555Z",
