  "headings": [
    {
      "id": "b7a52a56-3f76-4e75-ac22-fd65febb5ae3",
      "text": "III. NHỮNG DIỄN TỪ KẾT THÚC",
      "level": 1,
      "sortOrder": 0,
      "createdAt": "2025-09-03T01:30:38.792Z",
      "updatedAt": "2025-09-03T01:30:38.792Z",
      "verseId": "6b72dda6-9ddd-422c-92c1-984a0f403006",
      "chapterId": "d5c2c46c-9f07-4fe5-8790-f2ec5f70bdb0"
    },
    {
      "id": "7200befd-0624-4c6f-9099-4cd150f34543",
      "text": "Sản phẩm đầu mùa",
      "level": 2,
      "sortOrder": 0,
      "createdAt": "2025-09-03T01:30:38.003Z",
      "updatedAt": "2025-09-03T01:30:38.003Z",
      "verseId": "522de958-15f4-48ae-bdb1-9a5790176bda",
      "chapterId": "d5c2c46c-9f07-4fe5-8790-f2ec5f70bdb0"
    },
    {
      "id": "55235b1e-645a-47b3-8b51-f007c5e943df",
      "text": "Thuế thập phân ba năm một lần",
      "level": 2,
      "sortOrder": 0,
      "createdAt": "2025-09-03T01:30:38.564Z",
      "updatedAt": "2025-09-03T01:30:38.564Z",
      "verseId": "92b360b4-b54a-44cb-9409-d6e596e1187d",
      "chapterId": "d5c2c46c-9f07-4fe5-8790-f2ec5f70bdb0"
    },
    {
      "id": "df6eb694-c11e-4697-be08-5664989b0ded",
      "text": "PHẦN CUỐI DIỄN TỪ THỨ HAI CỦA ÔNG MÔ-SÊ",
      "level": 1,
      "sortOrder": 1,
      "createdAt": "2025-09-03T01:30:38.806Z",
      "updatedAt": "2025-09-03T01:30:38.806Z",
      "verseId": "6b72dda6-9ddd-422c-92c1-984a0f403006",
      "chapterId": "d5c2c46c-9f07-4fe5-8790-f2ec5f70bdb0"
    },
    {
      "id": "bd1a163e-ce61-4667-a94e-f0f30c306321",
      "text": "Ít-ra-en là dân của ĐỨC CHÚA",
      "level": 2,
      "sortOrder": 2,
