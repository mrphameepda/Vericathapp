    {
      "id": "3025d97f-bf2d-4b7b-afa9-a32bb68ffd9b",
      "content": "Tiếp theo là một lời tuyên xưng đức tin xác nhận hành động của Thiên Chúa trong lịch sử cứu độ của dân Ít-ra-en. Đnl đã có những đoạn toát yếu lịch sử cứu độ tương tự : x. 6,21-23+, và 11,3-6+. Cũng x. Gs 24,1-13 và Nk 9,7-25.",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "10",
      "sortOrder": 9,
      "startOffset": 89,
      "endOffset": 89,
      "createdAt": "2025-09-03T01:30:38.258Z",
      "updatedAt": "2025-09-03T01:30:38.258Z",
      "targetId": "477f31d5-d17b-46e6-ab12-c99d7901ef6e",
      "targetType": "MARK_TARGET_TYPE_VERSE",
      "chapterId": "d5c2c46c-9f07-4fe5-8790-f2ec5f70bdb0"
    },
    {
      "id": "e96a73a0-c2bc-4076-8c12-08a67f090222",
      "content": "English: Aram | French: Aram | Latin: Aram | Origin: &#1488;&#1458;&#1512;&#1464;&#1501; | Vietnamese: A-ram 1 -- người A-ram, St 10,22",
      "kind": "MARK_KIND_FOOTNOTE",
      "label": "11",
