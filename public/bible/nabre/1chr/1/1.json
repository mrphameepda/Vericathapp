{
    "headings":  [

                 ],
    "verses":  [
                   {
                       "label":  "1",
                       "number":  1,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "I. Genealogical Tables Chapter 1 - From Adam to Abraham. Adam, Seth, Enosh,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "2",
                       "number":  2,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Kenan, Mahalalel, Jared,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "3",
                       "number":  3,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Enoch, Methuselah, Lamech,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "4",
                       "number":  4,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Noah, Shem, Ham, and Japheth.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "5",
                       "number":  5,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The sons of Japheth were Gomer, Magog, Madai, Javan, Tubal, Meshech, and Tiras.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "6",
                       "number":  6,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The sons of Gomer were Ashkenaz, Riphath, and Togarmah.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "7",
                       "number":  7,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The sons of Javan were Elishah, Tarshish, the Kittim, and the Rodanim.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "8",
                       "number":  8,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The sons of Ham were Cush, Mizraim, Put, and Canaan.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "9",
                       "number":  9,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The sons of Cush were Seba, Havilah, Sabta, Raama, and Sabteca. The sons of Raama were Sheba and Dedan.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "10",
                       "number":  10,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Cush became the father of Nimrod, who was the first to be a warrior on the earth.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "11",
                       "number":  11,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Mizraim became the father of the Ludim, Anamim, Lehabim, Naphtuhim,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "12",
                       "number":  12,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Pathrusim, Casluhim, and Caphtorim, from whom the Philistines sprang.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "13",
                       "number":  13,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Canaan became the father of Sidon, his firstborn, and Heth,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "14",
                       "number":  14,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "and the Jebusites, the Amorites, the Girgashites,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "15",
                       "number":  15,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "the Hivites, the Arkites, the Sinites,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "16",
                       "number":  16,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "the Arvadites, the Zemarites, and the Hamathites.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "17",
                       "number":  17,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The sons of Shem were Elam, Asshur, Arpachshad, Lud, and Aram. The sons of Aram were Uz, Hul, Gether, and Mash.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "18",
                       "number":  18,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Arpachshad became the father of Shelah, and Shelah became the father of Eber.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "19",
                       "number":  19,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Two sons were born to Eber; the first was named Peleg (for in his time the world was divided), and his brother was named Joktan.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "20",
                       "number":  20,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Joktan became the father of Almodad, Sheleph, Hazarmaveth, Jerah,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "21",
                       "number":  21,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Hadoram, Uzal, Diklah,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "22",
                       "number":  22,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Ebal, Abimael, Sheba,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "23",
                       "number":  23,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Ophir, Havilah, and Jobab; all these were the sons of Joktan.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "24",
                       "number":  24,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Shem, Arpachshad, Shelah,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "25",
                       "number":  25,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Eber, Peleg, Reu,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "26",
                       "number":  26,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Serug, Nahor, Terah,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "27",
                       "number":  27,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Abram, that is, Abraham.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "28",
                       "number":  28,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "From Abraham to Jacob. The sons of Abraham were Isaac and Ishmael.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "29",
                       "number":  29,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "These were their generations: Nebaioth, the firstborn of Ishmael, then Kedar, Adbeel, Mibsam,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "30",
                       "number":  30,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Mishma, Dumah, Massa, Hadad, Tema,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "31",
                       "number":  31,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Jetur, Naphish, and Kedemah. These were the sons of Ishmael.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "32",
                       "number":  32,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The sons of Keturah, Abraham’s concubine: she bore Zimran, Jokshan, Medan, Midian, Ishbak, and Shuah. The sons of Jokshan were Sheba and Dedan.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "33",
                       "number":  33,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The sons of Midian were Ephah, Epher, Hanoch, Abida, and Eldaah. All these were the sons of Keturah.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "34",
                       "number":  34,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Abraham begot Isaac. The sons of Isaac were Esau and Israel.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "35",
                       "number":  35,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The descendants of Esau were Eliphaz, Reuel, Jeush, Jalam, and Korah.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "36",
                       "number":  36,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The descendants of Eliphaz were Teman, Omar, Zephi, Gatam, Kenaz, Timna, and Amalek.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "37",
                       "number":  37,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The descendants of Reuel were Nahath, Zerah, Shammah, and Mizzah.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "38",
                       "number":  38,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The sons of Seir were Lotan, Shobal, Zibeon, Anah, Dishon, Ezer, and Dishan.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "39",
                       "number":  39,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The sons of Lotan were Hori and Homam; Timna was the sister of Lotan.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "40",
                       "number":  40,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The sons of Shobal were Alian, Manahath, Ebal, Shephi, and Onam. The sons of Zibeon were Aiah and Anah.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "41",
                       "number":  41,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The sons of Anah: Dishon. The sons of Dishon were Hemdan, Eshban, Ithran, and Cheran.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "42",
                       "number":  42,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The sons of Ezer were Bilhan, Zaavan, and Jaakan. The sons of Dishan were Uz and Aran.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "43",
                       "number":  43,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The kings who reigned in the land of Edom before the Israelites had kings were the following: Bela, son of Beor, the name of whose city was Dinhabah.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "44",
                       "number":  44,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "When Bela died, Jobab, son of Zerah, from Bozrah, succeeded him as king.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "45",
                       "number":  45,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "When Jobab died, Husham, from the land of the Temanites, succeeded him as king.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "46",
                       "number":  46,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Husham died and Hadad, son of Bedad, succeeded him as king. He overthrew the Midianites on the Moabite plateau, and the name of his city was Avith.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "47",
                       "number":  47,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Hadad died and Samlah of Masrekah succeeded him as king.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "48",
                       "number":  48,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Samlah died and Shaul from Rehoboth on the Euphrates succeeded him as king.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "49",
                       "number":  49,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "When Shaul died, Baalhanan, son of Achbor, succeeded him as king.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "50",
                       "number":  50,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Baalhanan died and Hadad succeeded him as king. The name of his city was Pai, and his wife’s name was Mehetabel. She was the daughter of Matred, who was the daughter of Mezahab.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "51",
                       "number":  51,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "After Hadad died, there were chiefs in Edom: the chiefs of Timna, Aliah, Jetheth,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "52",
                       "number":  52,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Oholibamah, Elah, Pinon,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "53",
                       "number":  53,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Kenaz, Teman, Mibzar,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "54",
                       "number":  54,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Magdiel, and Iram were the chiefs of Edom.",
                       "isPoetry":  false
                   }
               ],
    "marks":  [

              ]
}