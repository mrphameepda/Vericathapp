{
    "headings":  [

                 ],
    "verses":  [
                   {
                       "label":  "1",
                       "number":  1,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Chapter 6 - The sons of Levi were Gershon, Kohath, and Merari.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "2",
                       "number":  2,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The sons of Gershon were named Libni and Shimei.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "3",
                       "number":  3,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The sons of Kohath were Amram, Izhar, Hebron, and Uzziel.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "4",
                       "number":  4,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The sons of Merari were Mahli and Mushi. These were the clans of Levi, according to their ancestors.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "5",
                       "number":  5,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Of Gershon: his son Libni, whose son was Jahath, whose son was Zimmah,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "6",
                       "number":  6,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "whose son was Joah, whose son was Iddo, whose son was Zerah, whose son was Jetherai.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "7",
                       "number":  7,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The sons of Kohath: his son Amminadab, whose son was Korah, whose son was Assir,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "8",
                       "number":  8,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "whose son was Elkanah, whose son was Ebiasaph, whose son was Assir,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "9",
                       "number":  9,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "whose son was Tahath, whose son was Uriel, whose son was Uzziah, whose son was Shaul.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "10",
                       "number":  10,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The sons of Elkanah were Amasai and Ahimoth,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "11",
                       "number":  11,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "whose son was Elkanah, whose son was Zophai, whose son was Nahath,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "12",
                       "number":  12,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "whose son was Eliab, whose son was Jeroham, whose son was Elkanah, whose son was Samuel.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "13",
                       "number":  13,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The sons of Samuel were Joel, the firstborn, and Abijah, the second.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "14",
                       "number":  14,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The sons of Merari: Mahli, whose son was Libni, whose son was Shimei, whose son was Uzzah,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "15",
                       "number":  15,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "whose son was Shimea, whose son was Haggiah, whose son was Asaiah.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "16",
                       "number":  16,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The following were established by David for the service of song in the LORD’s house at the time when the ark had a resting place.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "17",
                       "number":  17,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "They served as singers before the tabernacle of the tent of meeting until Solomon built the house of the LORD in Jerusalem, and they performed their services according to the order prescribed for them.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "18",
                       "number":  18,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Those who so performed are the following, together with their sons. Among the Kohathites: Heman, the chanter, son of Joel, son of Samuel,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "19",
                       "number":  19,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "son of Elkanah, son of Jeroham, son of Eliel, son of Toah,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "20",
                       "number":  20,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "son of Zuph, son of Elkanah, son of Mahath, son of Amasi,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "21",
                       "number":  21,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "son of Elkanah, son of Joel, son of Azariah, son of Zephaniah,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "22",
                       "number":  22,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "son of Tahath, son of Assir, son of Ebiasaph, son of Korah,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "23",
                       "number":  23,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "son of Izhar, son of Kohath, son of Levi, son of Israel.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "24",
                       "number":  24,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "His brother Asaph stood at his right hand. Asaph was the son of Berechiah, son of Shimea,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "25",
                       "number":  25,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "son of Michael, son of Baaseiah, son of Malchijah,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "26",
                       "number":  26,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "son of Ethni, son of Zerah, son of Adaiah,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "27",
                       "number":  27,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "son of Ethan, son of Zimmah, son of Shimei,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "28",
                       "number":  28,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "son of Jahath, son of Gershon, son of Levi.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "29",
                       "number":  29,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Their brothers, the Merarites, stood at the left: Ethan, son of Kishi, son of Abdi, son of Malluch,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "30",
                       "number":  30,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "son of Hashabiah, son of Amaziah, son of Hilkiah,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "31",
                       "number":  31,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "son of Amzi, son of Bani, son of Shemer,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "32",
                       "number":  32,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "son of Mahli, son of Mushi, son of Merari, son of Levi.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "33",
                       "number":  33,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Their brother Levites were appointed to all the other services of the tabernacle of the house of God.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "34",
                       "number":  34,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "However, it was Aaron and his sons who made the sacrifice on the altar for burnt offerings and on the altar of incense; they alone had charge of the holy of holies and of making atonement for Israel, as Moses, the servant of God, had commanded.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "35",
                       "number":  35,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "These were the sons of Aaron: his son Eleazar, whose son was Phinehas, whose son was Abishua,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "36",
                       "number":  36,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "whose son was Bukki, whose son was Uzzi, whose son was Zerahiah,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "37",
                       "number":  37,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "whose son was Meraioth, whose son was Amariah, whose son was Ahitub,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "38",
                       "number":  38,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "whose son was Zadok, whose son was Ahimaaz.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "39",
                       "number":  39,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The following were their dwelling places, by encampments in their territories. To the sons of Aaron who belonged to the clan of the Kohathites, since the lot fell to them,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "40",
                       "number":  40,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "was assigned Hebron in the land of Judah, with its adjacent pasture lands.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "41",
                       "number":  41,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "However, the open country and the villages belonging to the city had been given to Caleb, the son of Jephunneh.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "42",
                       "number":  42,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "There were assigned to the sons of Aaron: Hebron a city of refuge, Libnah with its pasture lands, Jattir with its pasture lands, Eshtemoa with its pasture lands,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "43",
                       "number":  43,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Holon with its pasture lands, Debir with its pasture lands,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "44",
                       "number":  44,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Ashan with its pasture lands, Jetta with its pasture lands, and Beth-shemesh with its pasture lands.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "45",
                       "number":  45,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Also from the tribe of Benjamin: Gibeon with its pasture lands, Geba with its pasture lands, Almon with its pasture lands, Anathoth with its pasture lands. In all, they had thirteen cities with their pasture lands.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "46",
                       "number":  46,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The other Kohathites obtained ten cities by lot for their clans from the tribe of Ephraim, from the tribe of Dan, and from the half-tribe of Manasseh.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "47",
                       "number":  47,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The clans of the Gershonites obtained thirteen cities from the tribes of Issachar, Asher, and Naphtali, and from the half-tribe of Manasseh in Bashan.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "48",
                       "number":  48,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The clans of the Merarites obtained twelve cities by lot from the tribes of Reuben, Gad, and Zebulun.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "49",
                       "number":  49,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The Israelites assigned these cities with their pasture lands to the Levites,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "50",
                       "number":  50,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "designating them by name and assigning them by lot from the tribes of the Judahites, Simeonites, and Benjaminites.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "51",
                       "number":  51,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The clans of the Kohathites obtained cities by lot from the tribe of Ephraim.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "52",
                       "number":  52,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "They were assigned cities of refuge: Shechem in the mountain region of Ephraim, with its pasture lands, Gezer with its pasture lands,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "53",
                       "number":  53,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Kibzaim with its pasture lands, and Beth-horon with its pasture lands.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "54",
                       "number":  54,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "From the tribe of Dan: Elteke with its pasture lands, Gibbethon with its pasture lands, Aijalon with its pasture lands, and Gath-rimmon with its pasture lands.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "55",
                       "number":  55,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "From the half-tribe of Manasseh: Taanach with its pasture lands and Ibleam with its pasture lands. These belonged to the rest of the Kohathite clan.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "56",
                       "number":  56,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The clans of the Gershonites received from the half-tribe of Manasseh: Golan in Bashan with its pasture lands and Ashtaroth with its pasture lands.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "57",
                       "number":  57,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "From the tribe of Issachar: Kedesh with its pasture lands, Daberath with its pasture lands,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "58",
                       "number":  58,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Ramoth with its pasture lands, and Engannim with its pasture lands.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "59",
                       "number":  59,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "From the tribe of Asher: Mashal with its pasture lands, Abdon with its pasture lands,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "60",
                       "number":  60,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Hilkath with its pasture lands, and Rehob with its pasture lands.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "61",
                       "number":  61,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "From the tribe of Naphtali: Kedesh in Galilee with its pasture lands, Hammon with its pasture lands, and Kiriathaim with its pasture lands.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "62",
                       "number":  62,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The rest of the Merarites received from the tribe of Zebulun: Jokneam with its pasture lands, Kartah with its pasture lands, Rimmon with its pasture lands, and Tabor with its pasture lands.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "63",
                       "number":  63,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Across the Jordan at Jericho (that is, east of the Jordan) they received from the tribe of Reuben: Bezer in the desert with its pasture lands, Jahzah with its pasture lands,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "64",
                       "number":  64,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Kedemoth with its pasture lands, and Mephaath with its pasture lands.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "65",
                       "number":  65,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "From the tribe of Gad: Ramoth in Gilead with its pasture lands, Mahanaim with its pasture lands,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "66",
                       "number":  66,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Heshbon with its pasture lands, and Jazer with its pasture lands.",
                       "isPoetry":  false
                   }
               ],
    "marks":  [

              ]
}