                   {
                       "label":  "85",
                       "number":  85,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Those who fell by the sword, together with those who were burned alive, came to about eight thousand.",
