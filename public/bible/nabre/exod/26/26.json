{
    "headings":  [

                 ],
    "verses":  [
                   {
                       "label":  "1",
                       "number":  1,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Chapter 26 - The Tent Cloth. The tabernacle itself you shall make out of ten sheets woven of fine linen twined and of violet, purple, and scarlet yarn, with cherubim embroidered on them.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "2",
                       "number":  2,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The length of each shall be twenty-eight cubits, and the width four cubits; all the sheets shall be of the same size.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "3",
                       "number":  3,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Five of the sheets are to be joined one to another; and the same for the other five.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "4",
                       "number":  4,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Make loops of violet yarn along the edge of the end sheet in one set, and the same along the edge of the end sheet in the other set.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "5",
                       "number":  5,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Make fifty loops along the edge of the end sheet in the first set, and fifty loops along the edge of the corresponding sheet in the second set, and so placed that the loops are directly opposite each other.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "6",
                       "number":  6,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Then make fifty clasps of gold and join the two sets of sheets, so that the tabernacle forms one whole.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "7",
                       "number":  7,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Also make sheets woven of goat hair for a tent over the tabernacle. Make eleven such sheets;",
                       "isPoetry":  false
                   },
                   {
                       "label":  "8",
                       "number":  8,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "the length of each shall be thirty cubits, and the width four cubits: all eleven sheets shall be of the same size.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "9",
                       "number":  9,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Join five of the sheets into one set, and the other six sheets into another set. Use the sixth sheet double at the front of the tent.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "10",
                       "number":  10,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Make fifty loops along the edge of the end sheet in one set, and fifty loops along the edge of the end sheet in the second set.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "11",
                       "number":  11,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Also make fifty bronze clasps and put them into the loops, to join the tent into one whole.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "12",
                       "number":  12,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "There will be an extra half sheet of tent covering, which shall be allowed to hang down over the rear of the tabernacle.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "13",
                       "number":  13,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Likewise, the sheets of the tent will have an extra cubit’s length to be left hanging down on either side of the tabernacle to cover it.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "14",
                       "number":  14,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Over the tent itself make a covering of rams’ skins dyed red, and above that, a covering of tahash skins.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "15",
                       "number":  15,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The Framework. You shall make frames for the tabernacle, acacia-wood uprights.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "16",
                       "number":  16,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The length of each frame is to be ten cubits, and its width one and a half cubits.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "17",
                       "number":  17,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Each frame shall have two arms joined one to another; so you are to make all the frames of the tabernacle.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "18",
                       "number":  18,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Make the frames of the tabernacle as follows: twenty frames on the south side,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "19",
                       "number":  19,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "with forty silver pedestals under the twenty frames, two pedestals under each frame for its two arms;",
                       "isPoetry":  false
                   },
                   {
                       "label":  "20",
                       "number":  20,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "twenty frames on the other side of the tabernacle, the north side,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "21",
                       "number":  21,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "with their forty silver pedestals, two pedestals under each frame.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "22",
                       "number":  22,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "At the rear of the tabernacle, to the west, six frames,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "23",
                       "number":  23,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "and two frames for the corners of the tabernacle, at its rear.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "24",
                       "number":  24,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "These two shall be double at the bottom, and likewise double at the top, to the first ring. That is how both corner frames are to be made.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "25",
                       "number":  25,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Thus, there shall be eight frames, with their sixteen silver pedestals, two pedestals under each frame.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "26",
                       "number":  26,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Also make bars of acacia wood: five for the frames on one side of the tabernacle,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "27",
                       "number":  27,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "five for those on the other side, and five for those at the rear, to the west.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "28",
                       "number":  28,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The center bar, at the middle of the frames, shall reach across from end to end.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "29",
                       "number":  29,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Plate the frames with gold, and make gold rings on them as holders for the bars, which are also to be plated with gold.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "30",
                       "number":  30,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "You shall set up the tabernacle according to its plan, which you were shown on the mountain.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "31",
                       "number":  31,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The Veils. You shall make a veil woven of violet, purple, and scarlet yarn, and of fine linen twined, with cherubim embroidered on it.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "32",
                       "number":  32,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "It is to be hung on four gold-plated columns of acacia wood, which shall have gold hooks and shall rest on four silver pedestals.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "33",
                       "number":  33,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Hang the veil from clasps. The ark of the covenant you shall bring inside, behind this veil which divides the holy place from the holy of holies.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "34",
                       "number":  34,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Set the cover on the ark of the covenant in the holy of holies.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "35",
                       "number":  35,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Outside the veil you shall place the table and the menorah, the latter on the south side of the tabernacle, opposite the table, which is to be put on the north side.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "36",
                       "number":  36,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "For the entrance of the tent make a variegated curtain of violet, purple, and scarlet yarn and of fine linen twined.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "37",
                       "number":  37,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Make five columns of acacia wood for this curtain; plate them with gold, with their hooks of gold; and cast five bronze pedestals for them.",
                       "isPoetry":  false
                   }
               ],
    "marks":  [

              ]
}