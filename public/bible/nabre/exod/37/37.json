{
    "headings":  [

                 ],
    "verses":  [
                   {
                       "label":  "1",
                       "number":  1,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Chapter 37 - The Ark. Bezalel made the ark of acacia wood, two and a half cubits long, one and a half cubits wide, and one and a half cubits high.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "2",
                       "number":  2,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The inside and outside were plated with gold, and a molding of gold was put around it.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "3",
                       "number":  3,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Four gold rings were cast for its four supports, two rings on one side and two on the opposite side.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "4",
                       "number":  4,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Poles of acacia wood were made and plated with gold;",
                       "isPoetry":  false
                   },
                   {
                       "label":  "5",
                       "number":  5,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "these poles were put through the rings on the sides of the ark, for carrying it.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "6",
                       "number":  6,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The cover was made of pure gold, two and a half cubits long and one and a half cubits wide.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "7",
                       "number":  7,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Two cherubim of beaten gold were made for the two ends of the cover;",
                       "isPoetry":  false
                   },
                   {
                       "label":  "8",
                       "number":  8,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "one cherub was at one end, the other at the other end, made of one piece with the cover, at each end.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "9",
                       "number":  9,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The cherubim had their wings spread out above, sheltering the cover. They faced each other, with their faces looking toward the cover.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "10",
                       "number":  10,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The Table. The table was made of acacia wood, two cubits long, a cubit wide, and a cubit and a half high.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "11",
                       "number":  11,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "It was plated with pure gold, and a molding of gold was put around it.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "12",
                       "number":  12,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "A frame a handbreadth high was also put around it, with a molding of gold around the frame.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "13",
                       "number":  13,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Four rings of gold were cast for it and fastened at the four corners, one at each leg.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "14",
                       "number":  14,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The rings were alongside the frame as holders for the poles to carry the table.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "15",
                       "number":  15,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "These poles for carrying the table were made of acacia wood and plated with gold.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "16",
                       "number":  16,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The vessels that were set on the table, its plates and cups, as well as its pitchers and bowls for pouring libations, were made of pure gold.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "17",
                       "number":  17,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The Menorah. The menorah was made of pure beaten gold—its shaft and branches—with its cups and knobs and petals springing directly from it.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "18",
                       "number":  18,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Six branches extended from its sides, three branches on one side and three on the other.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "19",
                       "number":  19,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "On one branch there were three cups, shaped like almond blossoms, each with its knob and petals; on the opposite branch there were three cups, shaped like almond blossoms, each with its knob and petals; and so for the six branches that extended from the menorah.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "20",
                       "number":  20,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "On the menorah there were four cups, shaped like almond blossoms, with their knobs and petals.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "21",
                       "number":  21,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The six branches that went out from the menorah had a knob under each pair.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "22",
                       "number":  22,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The knobs and branches so sprang from it that the whole formed but a single piece of pure beaten gold.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "23",
                       "number":  23,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Its seven lamps, as well as its trimming shears and trays, were made of pure gold.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "24",
                       "number":  24,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "A talent of pure gold was used for the menorah and its various utensils.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "25",
                       "number":  25,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The Altar of Incense. The altar of incense was made of acacia wood, on a square, a cubit long, a cubit wide, and two cubits high, having horns that sprang directly from it.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "26",
                       "number":  26,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Its grate on top, its walls on all four sides, and its horns were plated with pure gold; and a gold molding was put around it.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "27",
                       "number":  27,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Underneath the molding gold rings were placed, two on one side and two on the opposite side, as holders for the poles used in carrying it.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "28",
                       "number":  28,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The poles, too, were made of acacia wood and plated with gold.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "29",
                       "number":  29,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The sacred anointing oil and the fragrant incense were prepared in their pure form by a perfumer.",
                       "isPoetry":  false
                   }
               ],
    "marks":  [

              ]
}