{
    "headings":  [

                 ],
    "verses":  [
                   {
                       "label":  "1",
                       "number":  1,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Chapter 35 - Against Edom. The word of the LORD came to me:",
                       "isPoetry":  false
                   },
                   {
                       "label":  "2",
                       "number":  2,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Son of man, set your face against Mount Seir and prophesy against it.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "3",
                       "number":  3,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Say to it: Thus says the Lord GOD: Watch out! I am against you, Mount Seir. I will stretch out my hand against you and turn you into a desolate waste.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "4",
                       "number":  4,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Your cities I will turn into ruins, and you shall be a desolation; then you shall know that I am the LORD.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "5",
                       "number":  5,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Because you nursed a long-standing hatred and handed the Israelites over to the sword at the time of their collapse, at the time of their final punishment,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "6",
                       "number":  6,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "therefore, as I live—oracle of the Lord GOD—you are guilty of blood, and blood, I swear, shall pursue you.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "7",
                       "number":  7,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "I will make Mount Seir a desolate waste and cut off from it anyone who travels across it and back.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "8",
                       "number":  8,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "I will fill its mountains with the slain; those slain by the sword shall fall on your hills, into your valleys and all your ravines.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "9",
                       "number":  9,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "I will make you a desolation forever, your cities will not be inhabited, and you shall know that I am the LORD.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "10",
                       "number":  10,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Because you said: The two nations and the two lands belong to me; let us take possession of them—although the LORD was there—",
                       "isPoetry":  false
                   },
                   {
                       "label":  "11",
                       "number":  11,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "therefore, as I live—oracle of the Lord GOD—I will deal with you according to the anger and envy you dealt out to them in your hatred, and I will make myself known to them when I execute judgment on you,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "12",
                       "number":  12,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "then you shall know that I am the LORD. I have heard all the insults you spoke against the mountains of Israel, saying: They are desolate; they have been given to us to devour.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "13",
                       "number":  13,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "You boasted against me with your mouths and used insolent words against me. I heard everything!",
                       "isPoetry":  false
                   },
                   {
                       "label":  "14",
                       "number":  14,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Thus says the Lord GOD: Because you rejoiced that the whole land was desolate, so I will do to you.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "15",
                       "number":  15,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "As you rejoiced over the devastation of the heritage of the house of Israel, the same I will do to you: you will become a ruin, Mount Seir, and the whole of Edom, all of it! Then they shall know that I am the LORD.",
                       "isPoetry":  false
                   }
               ],
    "marks":  [

              ]
}