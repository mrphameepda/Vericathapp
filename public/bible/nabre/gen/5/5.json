    "verses":  [
                   {
                       "label":  "1",
                       "number":  1,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Chapter 5 - Generations: Adam to Noah. This is the record of the descendants of Adam. When God created human beings, he made them in the likeness of God;",
                       "isPoetry":  false
                   },
                   {
                       "label":  "2",
                       "number":  2,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "he created them male and female. When they were created, he blessed them and named them humankind.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "3",
                       "number":  3,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Adam was one hundred and thirty years old when he begot a son in his likeness, after his image; and he named him Seth.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "4",
                       "number":  4,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Adam lived eight hundred years after he begot Seth, and he had other sons and daughters.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "5",
                       "number":  5,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The whole lifetime of Adam was nine hundred and thirty years; then he died.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "6",
                       "number":  6,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "When Seth was one hundred and five years old, he begot Enosh.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "7",
                       "number":  7,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Seth lived eight hundred and seven years after he begot Enosh, and he had other sons and daughters.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "8",
                       "number":  8,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The whole lifetime of Seth was nine hundred and twelve years; then he died.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "9",
                       "number":  9,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "When Enosh was ninety years old, he begot Kenan.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "10",
                       "number":  10,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Enosh lived eight hundred and fifteen years after he begot Kenan, and he had other sons and daughters.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "11",
                       "number":  11,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The whole lifetime of Enosh was nine hundred and five years; then he died.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "12",
                       "number":  12,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "When Kenan was seventy years old, he begot Mahalalel.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "13",
                       "number":  13,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Kenan lived eight hundred and forty years after he begot Mahalalel, and he had other sons and daughters.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "14",
                       "number":  14,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The whole lifetime of Kenan was nine hundred and ten years; then he died.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "15",
                       "number":  15,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "When Mahalalel was sixty-five years old, he begot Jared.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "16",
                       "number":  16,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Mahalalel lived eight hundred and thirty years after he begot Jared, and he had other sons and daughters.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "17",
                       "number":  17,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The whole lifetime of Mahalalel was eight hundred and ninety-five years; then he died.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "18",
                       "number":  18,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "When Jared was one hundred and sixty-two years old, he begot Enoch.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "19",
                       "number":  19,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Jared lived eight hundred years after he begot Enoch, and he had other sons and daughters.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "20",
                       "number":  20,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The whole lifetime of Jared was nine hundred and sixty-two years; then he died.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "21",
                       "number":  21,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "When Enoch was sixty-five years old, he begot Methuselah.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "22",
                       "number":  22,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Enoch walked with God after he begot Methuselah for three hundred years, and he had other sons and daughters.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "23",
                       "number":  23,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The whole lifetime of Enoch was three hundred and sixty-five years.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "24",
                       "number":  24,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Enoch walked with God, and he was no longer here, for God took him.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "25",
                       "number":  25,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "When Methuselah was one hundred and eighty-seven years old, he begot Lamech.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "26",
                       "number":  26,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Methuselah lived seven hundred and eighty-two years after he begot Lamech, and he had other sons and daughters.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "27",
                       "number":  27,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The whole lifetime of Methuselah was nine hundred and sixty-nine years; then he died.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "28",
                       "number":  28,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "When Lamech was one hundred and eighty-two years old, he begot a son",
                       "isPoetry":  false
                   },
                   {
                       "label":  "29",
                       "number":  29,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "and named him Noah, saying, “This one shall bring us relief from our work and the toil of our hands, out of the very ground that the LORD has put under a curse.”",
                       "isPoetry":  false
                   },
                   {
                       "label":  "30",
                       "number":  30,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Lamech lived five hundred and ninety-five years after he begot Noah, and he had other sons and daughters.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "31",
                       "number":  31,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The whole lifetime of Lamech was seven hundred and seventy-seven years; then he died.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "32",
                       "number":  32,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "When Noah was five hundred years old, he begot Shem, Ham, and Japheth.",
                       "isPoetry":  false
                   }
               ],
