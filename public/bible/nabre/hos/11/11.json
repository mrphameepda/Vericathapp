    "verses":  [
                   {
                       "label":  "1",
                       "number":  1,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Chapter 11 The Disappointment of a Parent - When Israel was a child I loved him, out of Egypt I called my son.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "2",
                       "number":  2,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The more I called them, the farther they went from me, Sacrificing to the Baals and burning incense to idols.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "3",
                       "number":  3,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Yet it was I who taught Ephraim to walk, who took them in my arms; but they did not know that I cared for them.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "4",
                       "number":  4,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "I drew them with human cords, with bands of love; I fostered them like those who raise an infant to their cheeks; I bent down to feed them.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "5",
                       "number":  5,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "He shall return to the land of Egypt, Assyria shall be his king, because they have refused to repent.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "6",
                       "number":  6,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The sword shall rage in his cities: it shall destroy his diviners, and devour them because of their schemings.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "7",
                       "number":  7,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "My people have their mind set on apostasy; though they call on God in unison, he shall not raise them up.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "8",
                       "number":  8,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "But Love Is Stronger and Restores - How could I give you up, Ephraim, or deliver you up, Israel? How could I treat you as Admah, or make you like Zeboiim? My heart is overwhelmed, my pity is stirred.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "9",
                       "number":  9,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "I will not give vent to my blazing anger, I will not destroy Ephraim again; For I am God and not a man, the Holy One present among you; I will not come in wrath.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "10",
                       "number":  10,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "They shall follow the LORD, who roars like a lion; When he roars, his children shall come frightened from the west,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "11",
                       "number":  11,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Out of Egypt they shall come trembling, like birds, like doves, from the land of Assyria; And I will resettle them in their homes, oracle of the LORD.",
                       "isPoetry":  false
                   }
               ],
    "marks":  [

              ]
}