    "verses":  [
                   {
                       "label":  "1",
                       "number":  1,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Chapter 15 Moab - Oracle on Moab: Laid waste in a night, Ar of Moab is destroyed; Laid waste in a night, Kir of Moab is destroyed.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "2",
                       "number":  2,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Daughter Dibon has gone up to the high places to weep; Over Nebo and over Medeba Moab is wailing. Every head is shaved, every beard sheared off.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "3",
                       "number":  3,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "In the streets they wear sackcloth, and on the rooftops; In the squares everyone wails, streaming with tears.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "4",
                       "number":  4,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Heshbon and Elealeh cry out, they are heard as far as Jahaz. At this the loins of Moab tremble, his soul quivers within him;",
                       "isPoetry":  false
                   },
                   {
                       "label":  "5",
                       "number":  5,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "My heart cries out for Moab, his fugitives reach Zoar, Eglath-shelishiyah: The ascent of Luhith they ascend weeping; On the way to Horonaim they utter rending cries;",
                       "isPoetry":  false
                   },
                   {
                       "label":  "6",
                       "number":  6,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The waters of Nimrim have become a waste, The grass is withered, new growth is gone, nothing is green.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "7",
                       "number":  7,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "So now whatever they have acquired or stored away they carry across the Wadi of the Poplars.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "8",
                       "number":  8,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The cry has gone round the territory of Moab; As far as Eglaim his wailing, even at Beer-elim his wailing.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "9",
                       "number":  9,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The waters of Dimon are filled with blood, but I will bring still more upon Dimon: Lions for those who are fleeing from Moab and for those who remain in the land!",
                       "isPoetry":  false
                   }
               ],
    "marks":  [

              ]
}