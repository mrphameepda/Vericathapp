    "headings":  [

                 ],
    "verses":  [
                   {
                       "label":  "1",
                       "number":  1,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Chapter 64 - As when brushwood is set ablaze, or fire makes the water boil! Then your name would be made known to your enemies and the nations would tremble before you,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "2",
                       "number":  2,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "While you worked awesome deeds we could not hope for,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "3",
                       "number":  3,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "such as had not been heard of from of old. No ear has ever heard, no eye ever seen, any God but you working such deeds for those who wait for him.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "4",
                       "number":  4,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Would that you might meet us doing right, that we might be mindful of you in our ways! Indeed, you are angry; we have sinned, we have acted wickedly.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "5",
                       "number":  5,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "We have all become like something unclean, all our just deeds are like polluted rags; We have all withered like leaves, and our crimes carry us away like the wind.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "6",
                       "number":  6,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "There are none who call upon your name, none who rouse themselves to take hold of you; For you have hidden your face from us and have delivered us up to our crimes.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "7",
                       "number":  7,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "A Final Plea - Yet, LORD, you are our father; we are the clay and you our potter: we are all the work of your hand.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "8",
                       "number":  8,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Do not be so very angry, LORD, do not remember our crimes forever; look upon us, who are all your people!",
                       "isPoetry":  false
                   },
                   {
                       "label":  "9",
                       "number":  9,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Your holy cities have become a wilderness; Zion has become wilderness, Jerusalem desolation!",
                       "isPoetry":  false
                   },
                   {
                       "label":  "10",
                       "number":  10,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Our holy and glorious house in which our ancestors praised you Has been burned with fire; all that was dear to us is laid waste.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "11",
                       "number":  11,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Can you hold back, LORD, after all this? Can you remain silent, and afflict us so severely?",
                       "isPoetry":  false
                   }
               ],
    "marks":  [

              ]
}