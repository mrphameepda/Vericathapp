{
    "headings":  [

                 ],
    "verses":  [
                   {
                       "label":  "1",
                       "number":  1,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Chapter 3 The Voice of a Suffering Individual - I am one who has known affliction under the rod of God’s anger,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "2",
                       "number":  2,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "One whom he has driven and forced to walk in darkness, not in light;",
                       "isPoetry":  false
                   },
                   {
                       "label":  "3",
                       "number":  3,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Against me alone he turns his hand— again and again all day long.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "4",
                       "number":  4,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "He has worn away my flesh and my skin, he has broken my bones;",
                       "isPoetry":  false
                   },
                   {
                       "label":  "5",
                       "number":  5,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "He has besieged me all around with poverty and hardship;",
                       "isPoetry":  false
                   },
                   {
                       "label":  "6",
                       "number":  6,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "He has left me to dwell in dark places like those long dead.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "7",
                       "number":  7,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "He has hemmed me in with no escape, weighed me down with chains;",
                       "isPoetry":  false
                   },
                   {
                       "label":  "8",
                       "number":  8,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Even when I cry for help, he stops my prayer;",
                       "isPoetry":  false
                   },
                   {
                       "label":  "9",
                       "number":  9,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "He has hemmed in my ways with fitted stones, and made my paths crooked.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "10",
                       "number":  10,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "He has been a bear lying in wait for me, a lion in hiding!",
                       "isPoetry":  false
                   },
                   {
                       "label":  "11",
                       "number":  11,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "He turned me aside and tore me apart, leaving me ravaged.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "12",
                       "number":  12,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "He bent his bow, and set me up as a target for his arrow.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "13",
                       "number":  13,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "He pierced my kidneys with shafts from his quiver.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "14",
                       "number":  14,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "I have become a laughingstock to all my people, their taunt all day long;",
                       "isPoetry":  false
                   },
                   {
                       "label":  "15",
                       "number":  15,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "He has sated me with bitterness, filled me with wormwood.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "16",
                       "number":  16,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "He has made me eat gravel, trampled me into the dust;",
                       "isPoetry":  false
                   },
                   {
                       "label":  "17",
                       "number":  17,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "My life is deprived of peace, I have forgotten what happiness is;",
                       "isPoetry":  false
                   },
                   {
                       "label":  "18",
                       "number":  18,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "My enduring hope, I said, has perished before the LORD.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "19",
                       "number":  19,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The thought of my wretched homelessness is wormwood and poison;",
                       "isPoetry":  false
                   },
                   {
                       "label":  "20",
                       "number":  20,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Remembering it over and over, my soul is downcast.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "21",
                       "number":  21,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "But this I will call to mind; therefore I will hope:",
                       "isPoetry":  false
                   },
                   {
                       "label":  "22",
                       "number":  22,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The LORD’s acts of mercy are not exhausted, his compassion is not spent;",
                       "isPoetry":  false
                   },
                   {
                       "label":  "23",
                       "number":  23,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "They are renewed each morning— great is your faithfulness!",
                       "isPoetry":  false
                   },
                   {
                       "label":  "24",
                       "number":  24,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The LORD is my portion, I tell myself, therefore I will hope in him.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "25",
                       "number":  25,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The LORD is good to those who trust in him, to the one that seeks him;",
                       "isPoetry":  false
                   },
                   {
                       "label":  "26",
                       "number":  26,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "It is good to hope in silence for the LORD’s deliverance.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "27",
                       "number":  27,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "It is good for a person, when young, to bear the yoke,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "28",
                       "number":  28,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "To sit alone and in silence, when its weight lies heavy,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "29",
                       "number":  29,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "To put one’s mouth in the dust— there may yet be hope—",
                       "isPoetry":  false
                   },
                   {
                       "label":  "30",
                       "number":  30,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "To offer one’s cheek to be struck, to be filled with disgrace.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "31",
                       "number":  31,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "For the Lord does not reject forever;",
                       "isPoetry":  false
                   },
                   {
                       "label":  "32",
                       "number":  32,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Though he brings grief, he takes pity, according to the abundance of his mercy;",
                       "isPoetry":  false
                   },
                   {
                       "label":  "33",
                       "number":  33,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "He does not willingly afflict or bring grief to human beings.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "34",
                       "number":  34,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "That someone tramples underfoot all the prisoners in the land,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "35",
                       "number":  35,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Or denies justice to anyone in the very sight of the Most High,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "36",
                       "number":  36,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Or subverts a person’s lawsuit— does the Lord not see?",
                       "isPoetry":  false
                   },
                   {
                       "label":  "37",
                       "number":  37,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Who speaks so that it comes to pass, unless the Lord commands it?",
                       "isPoetry":  false
                   },
                   {
                       "label":  "38",
                       "number":  38,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Is it not at the word of the Most High that both good and bad take place?",
                       "isPoetry":  false
                   },
                   {
                       "label":  "39",
                       "number":  39,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "What should the living complain about? about their sins!",
                       "isPoetry":  false
                   },
                   {
                       "label":  "40",
                       "number":  40,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Let us search and examine our ways, and return to the LORD!",
                       "isPoetry":  false
                   },
                   {
                       "label":  "41",
                       "number":  41,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Let us lift up our hearts as well as our hands toward God in heaven!",
                       "isPoetry":  false
                   },
                   {
                       "label":  "42",
                       "number":  42,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "We have rebelled and been obstinate; you have not forgiven us.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "43",
                       "number":  43,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "You wrapped yourself in wrath and pursued us, killing without pity;",
                       "isPoetry":  false
                   },
                   {
                       "label":  "44",
                       "number":  44,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "You wrapped yourself in a cloud, which no prayer could pierce.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "45",
                       "number":  45,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "You have made us filth and rubbish among the peoples.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "46",
                       "number":  46,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "They have opened their mouths against us, all our enemies;",
                       "isPoetry":  false
                   },
                   {
                       "label":  "47",
                       "number":  47,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Panic and the pit have been our lot, desolation and destruction;",
                       "isPoetry":  false
                   },
                   {
                       "label":  "48",
                       "number":  48,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "My eyes stream with tears over the destruction of the daughter of my people.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "49",
                       "number":  49,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "My eyes will flow without ceasing, without rest,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "50",
                       "number":  50,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Until the LORD from heaven looks down and sees.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "51",
                       "number":  51,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "I am tormented by the sight of all the daughters of my city.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "52",
                       "number":  52,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Without cause, my enemies snared me as though I were a bird;",
                       "isPoetry":  false
                   },
                   {
                       "label":  "53",
                       "number":  53,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "They tried to end my life in the pit, pelting me with stones.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "54",
                       "number":  54,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The waters flowed over my head: and I said, “I am lost!”",
                       "isPoetry":  false
                   },
                   {
                       "label":  "55",
                       "number":  55,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "I have called upon your name, O LORD, from the bottom of the pit;",
                       "isPoetry":  false
                   },
                   {
                       "label":  "56",
                       "number":  56,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "You heard me call, “Do not let your ear be deaf to my cry for help.”",
                       "isPoetry":  false
                   },
                   {
                       "label":  "57",
                       "number":  57,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "You drew near on the day I called you; you said, “Do not fear!”",
                       "isPoetry":  false
                   },
                   {
                       "label":  "58",
                       "number":  58,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "You pleaded my case, Lord, you redeemed my life.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "59",
                       "number":  59,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "You see, LORD, how I am wronged; do me justice!",
                       "isPoetry":  false
                   },
                   {
                       "label":  "60",
                       "number":  60,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "You see all their vindictiveness, all their plots against me.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "61",
                       "number":  61,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "You hear their reproach, LORD, all their plots against me,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "62",
                       "number":  62,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The whispered murmurings of my adversaries, against me all day long;",
                       "isPoetry":  false
                   },
                   {
                       "label":  "63",
                       "number":  63,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Look! Whether they sit or stand, I am the butt of their taunt.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "64",
                       "number":  64,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Give them what they deserve, LORD, according to their deeds;",
                       "isPoetry":  false
                   },
                   {
                       "label":  "65",
                       "number":  65,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Give them hardness of heart; your curse be upon them;",
                       "isPoetry":  false
                   },
                   {
                       "label":  "66",
                       "number":  66,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Pursue them in wrath and destroy them from under the LORD’s heaven!",
                       "isPoetry":  false
                   }
               ],
    "marks":  [

              ]
}