{
    "headings":  [

                 ],
    "verses":  [
                   {
                       "label":  "1",
                       "number":  1,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Chapter 19 - Various Rules of Conduct. The LORD said to Moses:",
                       "isPoetry":  false
                   },
                   {
                       "label":  "2",
                       "number":  2,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Speak to the whole Israelite community and tell them: Be holy, for I, the LORD your God, am holy.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "3",
                       "number":  3,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Each of you revere your mother and father, and keep my sabbaths. I, the LORD, am your God.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "4",
                       "number":  4,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Do not turn aside to idols, nor make molten gods for yourselves. I, the LORD, am your God.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "5",
                       "number":  5,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "When you sacrifice your communion sacrifice to the LORD, you shall sacrifice it so that it is acceptable on your behalf.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "6",
                       "number":  6,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "It must be eaten on the day of your sacrifice or on the following day. Whatever is left over until the third day shall be burned in fire.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "7",
                       "number":  7,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "If any of it is eaten on the third day, it will be a desecrated offering and not be accepted;",
                       "isPoetry":  false
                   },
                   {
                       "label":  "8",
                       "number":  8,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "whoever eats of it then shall bear the penalty for having profaned what is sacred to the LORD. Such a one shall be cut off from the people.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "9",
                       "number":  9,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "When you reap the harvest of your land, you shall not be so thorough that you reap the field to its very edge, nor shall you gather the gleanings of your harvest.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "10",
                       "number":  10,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Likewise, you shall not pick your vineyard bare, nor gather up the grapes that have fallen. These things you shall leave for the poor and the alien. I, the LORD, am your God.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "11",
                       "number":  11,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "You shall not steal. You shall not deceive or speak falsely to one another.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "12",
                       "number":  12,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "You shall not swear falsely by my name, thus profaning the name of your God. I am the LORD.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "13",
                       "number":  13,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "You shall not exploit your neighbor. You shall not commit robbery. You shall not withhold overnight the wages of your laborer.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "14",
                       "number":  14,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "You shall not insult the deaf, or put a stumbling block in front of the blind, but you shall fear your God. I am the LORD.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "15",
                       "number":  15,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "You shall not act dishonestly in rendering judgment. Show neither partiality to the weak nor deference to the mighty, but judge your neighbor justly.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "16",
                       "number":  16,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "You shall not go about spreading slander among your people; nor shall you stand by idly when your neighbor’s life is at stake. I am the LORD.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "17",
                       "number":  17,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "You shall not hate any of your kindred in your heart. Reprove your neighbor openly so that you do not incur sin because of that person.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "18",
                       "number":  18,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Take no revenge and cherish no grudge against your own people. You shall love your neighbor as yourself. I am the LORD.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "19",
                       "number":  19,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Keep my statutes: do not breed any of your domestic animals with others of a different species; do not sow a field of yours with two different kinds of seed; and do not put on a garment woven with two different kinds of thread.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "20",
                       "number":  20,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "If a man has sexual relations with a female slave who has been acquired by another man but has not yet been redeemed or given her freedom, an investigation shall be made. They shall not be put to death, because she has not been freed.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "21",
                       "number":  21,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The man shall bring to the entrance of the tent of meeting as his reparation to the LORD a ram as a reparation offering.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "22",
                       "number":  22,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "With the ram of the reparation offering the priest shall make atonement before the LORD for the wrong the man has committed, so that he will be forgiven for the wrong he has committed.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "23",
                       "number":  23,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "When you come into the land and plant any fruit tree there, first look upon its fruit as if it were uncircumcised. For three years, it shall be uncircumcised for you; it may not be eaten.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "24",
                       "number":  24,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "In the fourth year, however, all of its fruit shall be dedicated to the LORD in joyous celebration.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "25",
                       "number":  25,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Not until the fifth year may you eat its fruit, to increase the yield for you. I, the LORD, am your God.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "26",
                       "number":  26,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Do not eat anything with the blood still in it. Do not recite charms or practice soothsaying.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "27",
                       "number":  27,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Do not clip your hair at the temples, nor spoil the edges of your beard.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "28",
                       "number":  28,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Do not lacerate your bodies for the dead, and do not tattoo yourselves. I am the LORD.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "29",
                       "number":  29,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "You shall not degrade your daughter by making a prostitute of her; otherwise the land will prostitute itself and become full of lewdness.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "30",
                       "number":  30,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Keep my sabbaths, and reverence my sanctuary. I am the LORD.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "31",
                       "number":  31,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Do not turn to ghosts or consult spirits, by which you will be defiled. I, the LORD, am your God.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "32",
                       "number":  32,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Stand up in the presence of the aged, show respect for the old, and fear your God. I am the LORD.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "33",
                       "number":  33,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "When an alien resides with you in your land, do not mistreat such a one.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "34",
                       "number":  34,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "You shall treat the alien who resides with you no differently than the natives born among you; you shall love the alien as yourself; for you too were once aliens in the land of Egypt. I, the LORD, am your God.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "35",
                       "number":  35,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Do not act dishonestly in using measures of length or weight or capacity.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "36",
                       "number":  36,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "You shall have a true scale and true weights, an honest ephah and an honest hin. I, the LORD, am your God, who brought you out of the land of Egypt.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "37",
                       "number":  37,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Be careful, then, to observe all my statutes and decrees. I am the LORD.",
                       "isPoetry":  false
                   }
               ],
    "marks":  [

              ]
}