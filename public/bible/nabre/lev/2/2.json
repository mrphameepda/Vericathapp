{
    "headings":  [

                 ],
    "verses":  [
                   {
                       "label":  "1",
                       "number":  1,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Chapter 2 - Grain Offerings. When anyone brings a grain offering to the LORD, the offering must consist of bran flour. The offerer shall pour oil on it and put frankincense over it,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "2",
                       "number":  2,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "and bring it to Aaron’s sons, the priests. A priest shall take a handful of the bran flour and oil, together with all the frankincense, and shall burn it on the altar as a token of the offering, a sweet-smelling oblation to the LORD.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "3",
                       "number":  3,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The rest of the grain offering belongs to Aaron and his sons, a most holy portion from the oblations to the LORD.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "4",
                       "number":  4,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "When you offer a grain offering baked in an oven, it must be in the form of unleavened cakes made of bran flour mixed with oil, or of unleavened wafers spread with oil.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "5",
                       "number":  5,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "If your offering is a grain offering that is fried on a griddle, it must be of bran flour mixed with oil and unleavened.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "6",
                       "number":  6,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Break it into pieces, and pour oil over it. It is a grain offering.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "7",
                       "number":  7,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "If your offering is a grain offering that is prepared in a pan, it must be made of bran flour, fried in oil.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "8",
                       "number":  8,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "A grain offering that is made in any of these ways you shall bring to the LORD. It shall be presented to the priest, who shall take it to the altar.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "9",
                       "number":  9,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The priest shall then remove from the grain offering a token and burn it on the altar as a sweet-smelling oblation to the LORD.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "10",
                       "number":  10,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The rest of the grain offering belongs to Aaron and his sons, a most holy portion from the oblations to the LORD.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "11",
                       "number":  11,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Every grain offering that you present to the LORD shall be unleavened, for you shall not burn any leaven or honey as an oblation to the LORD.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "12",
                       "number":  12,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Such you may present to the LORD in the offering of the first produce that is processed, but they are not to be placed on the altar for a pleasing odor.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "13",
                       "number":  13,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "You shall season all your grain offerings with salt. Do not let the salt of the covenant with your God be lacking from your grain offering. On every offering you shall offer salt.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "14",
                       "number":  14,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "If you offer a grain offering of first ripe fruits to the LORD, you shall offer it in the form of fresh early grain, roasted by fire and crushed as a grain offering of your first ripe fruits.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "15",
                       "number":  15,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "You shall put oil on it and set frankincense on it. It is a grain offering.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "16",
                       "number":  16,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The priest shall then burn some of the groats and oil, together with all the frankincense, as a token of the offering, an oblation to the LORD.",
                       "isPoetry":  false
                   }
               ],
    "marks":  [

              ]
}