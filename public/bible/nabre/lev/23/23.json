{
    "headings":  [

                 ],
    "verses":  [
                   {
                       "label":  "1",
                       "number":  1,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Chapter 23 - Holy Days. The LORD said to Moses:",
                       "isPoetry":  false
                   },
                   {
                       "label":  "2",
                       "number":  2,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Speak to the Israelites and tell them: The following are the festivals of the LORD, which you shall declare holy days. These are my festivals:",
                       "isPoetry":  false
                   },
                   {
                       "label":  "3",
                       "number":  3,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "For six days work may be done; but the seventh day is a sabbath of complete rest, a declared holy day; you shall do no work. It is the LORD’s sabbath wherever you dwell.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "4",
                       "number":  4,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Passover. These are the festivals of the LORD, holy days which you shall declare at their proper time.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "5",
                       "number":  5,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The Passover of the LORD falls on the fourteenth day of the first month, at the evening twilight.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "6",
                       "number":  6,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The fifteenth day of this month is the LORD’s feast of Unleavened Bread. For seven days you shall eat unleavened bread.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "7",
                       "number":  7,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "On the first of these days you will have a declared holy day; you shall do no heavy work.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "8",
                       "number":  8,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "On each of the seven days you shall offer an oblation to the LORD. Then on the seventh day you will have a declared holy day; you shall do no heavy work.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "9",
                       "number":  9,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The LORD said to Moses:",
                       "isPoetry":  false
                   },
                   {
                       "label":  "10",
                       "number":  10,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Speak to the Israelites and tell them: When you come into the land which I am giving you, and reap its harvest, you shall bring the first sheaf of your harvest to the priest,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "11",
                       "number":  11,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "who shall elevate the sheaf before the LORD that it may be acceptable on your behalf. On the day after the sabbath the priest shall do this.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "12",
                       "number":  12,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "On this day, when your sheaf is elevated, you shall offer to the LORD for a burnt offering an unblemished yearling lamb.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "13",
                       "number":  13,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Its grain offering shall be two tenths of an ephah of bran flour mixed with oil, as a sweet-smelling oblation to the LORD; and its libation shall be a fourth of a hin of wine.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "14",
                       "number":  14,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "You shall not eat any bread or roasted grain or fresh kernels until this day, when you bring the offering for your God. This shall be a perpetual statute throughout your generations wherever you dwell.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "15",
                       "number":  15,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Pentecost. Beginning with the day after the sabbath, the day on which you bring the sheaf for elevation, you shall count seven full weeks;",
                       "isPoetry":  false
                   },
                   {
                       "label":  "16",
                       "number":  16,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "you shall count to the day after the seventh week, fifty days. Then you shall present a new grain offering to the LORD.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "17",
                       "number":  17,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "For the elevated offering of your first-ripened fruits to the LORD, you shall bring with you from wherever you live two loaves of bread made of two tenths of an ephah of bran flour and baked with leaven.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "18",
                       "number":  18,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Besides the bread, you shall offer to the LORD a burnt offering of seven unblemished yearling lambs, one bull of the herd, and two rams, along with their grain offering and libations, as a sweet-smelling oblation to the LORD.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "19",
                       "number":  19,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "One male goat shall be sacrificed as a purification offering, and two yearling lambs as a communion sacrifice.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "20",
                       "number":  20,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The priest shall elevate them—that is, the two lambs—with the bread of the first-ripened fruits as an elevated offering before the LORD; these shall be sacred to the LORD and belong to the priest.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "21",
                       "number":  21,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "On this same day you shall make a proclamation: there shall be a declared holy day for you; no heavy work may be done. This shall be a perpetual statute through all your generations wherever you dwell.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "22",
                       "number":  22,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "When you reap the harvest of your land, you shall not be so thorough that you reap the field to its very edge, nor shall you gather the gleanings of your harvest. These things you shall leave for the poor and the alien. I, the LORD, am your God.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "23",
                       "number":  23,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "New Year’s Day. The LORD said to Moses:",
                       "isPoetry":  false
                   },
                   {
                       "label":  "24",
                       "number":  24,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Tell the Israelites: On the first day of the seventh month you will have a sabbath rest, with trumpet blasts as a reminder, a declared holy day;",
                       "isPoetry":  false
                   },
                   {
                       "label":  "25",
                       "number":  25,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "you shall do no heavy work, and you shall offer an oblation to the LORD.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "26",
                       "number":  26,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The Day of Atonement. The LORD said to Moses:",
                       "isPoetry":  false
                   },
                   {
                       "label":  "27",
                       "number":  27,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Now the tenth day of this seventh month is the Day of Atonement. You will have a declared holy day. You shall humble yourselves and offer an oblation to the LORD.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "28",
                       "number":  28,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "On this day you shall not do any work, because it is the Day of Atonement, when atonement is made for you before the LORD, your God.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "29",
                       "number":  29,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Those who do not humble themselves on this day shall be cut off from the people.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "30",
                       "number":  30,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "If anyone does any work on this day, I will remove that person from the midst of the people.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "31",
                       "number":  31,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "You shall do no work; this is a perpetual statute throughout your generations wherever you dwell;",
                       "isPoetry":  false
                   },
                   {
                       "label":  "32",
                       "number":  32,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "it is a sabbath of complete rest for you. You shall humble yourselves. Beginning on the evening of the ninth of the month, you shall keep your sabbath from evening to evening.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "33",
                       "number":  33,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The Feast of Booths. The LORD said to Moses:",
                       "isPoetry":  false
                   },
                   {
                       "label":  "34",
                       "number":  34,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Tell the Israelites: The fifteenth day of this seventh month is the LORD’s feast of Booths, which shall continue for seven days.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "35",
                       "number":  35,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "On the first day, a declared holy day, you shall do no heavy work.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "36",
                       "number":  36,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "For seven days you shall offer an oblation to the LORD, and on the eighth day you will have a declared holy day. You shall offer an oblation to the LORD. It is the festival closing. You shall do no heavy work.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "37",
                       "number":  37,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "These, therefore, are the festivals of the LORD which you shall declare holy days, in order to offer as an oblation to the LORD burnt offerings and grain offerings, sacrifices and libations, as prescribed for each day,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "38",
                       "number":  38,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "in addition to the LORD’s sabbaths, your donations, your various votive offerings, and the voluntary offerings that you present to the LORD.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "39",
                       "number":  39,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "On the fifteenth day, then, of the seventh month, when you have gathered in the produce of the land, you shall celebrate the feast of the LORD for a whole week. The first and the eighth day shall be days of rest.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "40",
                       "number":  40,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "On the first day you shall gather fruit of majestic trees, branches of palms, and boughs of leafy trees and valley willows. Then for a week you shall make merry before the LORD, your God.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "41",
                       "number":  41,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "You shall keep this feast of the LORD for one whole week in the year. By perpetual statute throughout your generations in the seventh month of the year, you shall keep it.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "42",
                       "number":  42,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "You shall dwell in booths for seven days; every native-born Israelite shall dwell in booths,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "43",
                       "number":  43,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "that your descendants may realize that, when I led the Israelites out of the land of Egypt, I made them dwell in booths. I, the LORD, am your God.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "44",
                       "number":  44,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Thus did Moses announce to the Israelites the festivals of the LORD.",
                       "isPoetry":  false
                   }
               ],
    "marks":  [

              ]
}