    "verses":  [
                   {
                       "label":  "1",
                       "number":  1,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Chapter 10 - Signatories to the Pact. In view of all this, we are entering into a firm pact, which we are putting into writing. On the sealed document appear the names of our princes, our Levites, and our priests.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "2",
                       "number":  2,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "On the sealed document: the governor Nehemiah, son of Hacaliah, and Zedekiah.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "3",
                       "number":  3,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Seraiah, Azariah, Jeremiah,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "4",
                       "number":  4,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Pashhur, Amariah, Malchijah,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "5",
                       "number":  5,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Hattush, Shebaniah, Malluch,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "6",
                       "number":  6,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Harim, Meremoth, Obadiah,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "7",
                       "number":  7,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Daniel, Ginnethon, Baruch,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "8",
                       "number":  8,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Meshullam, Abijah, Mijamin,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "9",
                       "number":  9,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Maaziah, Bilgai, Shemaiah: these are the priests.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "10",
                       "number":  10,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The Levites: Jeshua, son of Azaniah; Binnui, of the descendants of Henadad; Kadmiel;",
                       "isPoetry":  false
                   },
                   {
                       "label":  "11",
                       "number":  11,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "and their kinsmen Shebaniah, Hodiah, Kelita, Pelaiah, Hanan,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "12",
                       "number":  12,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Mica, Rehob, Hashabiah,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "13",
                       "number":  13,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Zaccur, Sherebiah, Shebaniah,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "14",
                       "number":  14,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Hodiah, Bani, Beninu.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "15",
                       "number":  15,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The leaders of the people: Parosh, Pahath-moab, Elam, Zattu, Bani,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "16",
                       "number":  16,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Bunni, Azgad, Bebai,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "17",
                       "number":  17,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Adonijah, Bigvai, Adin,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "18",
                       "number":  18,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Ater, Hezekiah, Azzur,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "19",
                       "number":  19,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Hodiah, Hashum, Bezai,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "20",
                       "number":  20,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Hariph, Anathoth, Nebai,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "21",
                       "number":  21,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Magpiash, Meshullam, Hezir,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "22",
                       "number":  22,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Meshezabel, Zadok, Jaddua,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "23",
                       "number":  23,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Pelatiah, Hanan, Anaiah,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "24",
                       "number":  24,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Hoshea, Hananiah, Hasshub,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "25",
                       "number":  25,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Hallhohesh, Pilha, Shobek,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "26",
                       "number":  26,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Rehum, Hashabnah, Maaseiah,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "27",
                       "number":  27,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Ahiah, Hanan, Anan,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "28",
                       "number":  28,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Malluch, Harim, Baanah.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "29",
                       "number":  29,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Provisions of the Pact. The rest of the people, priests, Levites, gatekeepers, singers, temple servants, and all others who have separated themselves from the local inhabitants in favor of the law of God, with their wives, their sons, their daughters, all who are of the age of discretion,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "30",
                       "number":  30,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "join their influential kindred, and with the sanction of a curse take this oath to follow the law of God given through Moses, the servant of God, and to observe carefully all the commandments of the LORD, our Lord, his ordinances and his statutes.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "31",
                       "number":  31,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "We will not marry our daughters to the local inhabitants, and we will not accept their daughters for our sons.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "32",
                       "number":  32,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "When the local inhabitants bring in merchandise or any kind of grain for sale on the sabbath day, we will not buy from them on the sabbath or on any other holy day. In the seventh year we will forgo the produce, and forgive every kind of debt.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "33",
                       "number":  33,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "We impose these commandments on ourselves: to give a third of a shekel each year for the service of the house of our God,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "34",
                       "number":  34,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "for the showbread, the daily grain offering, the daily burnt offering, for the sabbaths, new moons, and festivals, for the holy offerings and sin offerings to make atonement for Israel, for every service of the house of our God.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "35",
                       "number":  35,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "We, priests, Levites, and people, have determined by lot concerning the procurement of wood: it is to be brought to the house of our God by each of our ancestral houses at stated times each year, to be burnt on the altar of the LORD, our God, as the law prescribes.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "36",
                       "number":  36,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "We have agreed to bring each year to the house of the LORD the first fruits of our fields and of our fruit trees, of every kind;",
                       "isPoetry":  false
                   },
                   {
                       "label":  "37",
                       "number":  37,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "also, as is prescribed in the law, to bring to the house of our God, to the priests who serve in the house of our God, the firstborn of our children and our animals, including the firstborn of our flocks and herds.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "38",
                       "number":  38,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The first batch of our dough, and our offerings of the fruit of every tree, of wine and oil, we will bring to the priests, to the chambers of the house of our God. The tithe of our fields we will bring to the Levites; they, the Levites, shall take the tithe in all the cities of our service.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "39",
                       "number":  39,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "An Aaronite priest shall be with the Levites when they take the tithe, and the Levites shall bring the tithe of the tithes to the house of our God, to the chambers of the treasury.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "40",
                       "number":  40,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "For to these chambers the Israelites and Levites bring the offerings of grain, wine, and oil; there also are housed the vessels of the sanctuary, and the ministering priests, the gatekeepers, and the singers. We will not neglect the house of our God.",
                       "isPoetry":  false
                   }
               ],
    "marks":  [

              ]
}