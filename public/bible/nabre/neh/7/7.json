                   },
                   {
                       "label":  "60",
                       "number":  60,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The total of the temple servants and the descendants of Solomon’s servants was three hundred and ninety-two.",
