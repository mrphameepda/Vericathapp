{
    "headings":  [

                 ],
    "verses":  [
                   {
                       "label":  "1",
                       "number":  1,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Chapter 28 - General Sacrifices. The LORD said to Moses:",
                       "isPoetry":  false
                   },
                   {
                       "label":  "2",
                       "number":  2,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Give the Israelites this commandment: At their prescribed times, you will be careful to present to me the food offerings that are due me, oblations of pleasing aroma to me.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "3",
                       "number":  3,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Each Morning and Evening. You will tell them therefore: This is the oblation which you will offer to the LORD: two unblemished yearling lambs each day as the regular burnt offering,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "4",
                       "number":  4,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "offering one lamb in the morning and the other during the evening twilight,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "5",
                       "number":  5,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "each with a grain offering of one tenth of an ephah of bran flour mixed with a fourth of a hin of oil of crushed olives.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "6",
                       "number":  6,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "This is the regular burnt offering that was made at Mount Sinai for a pleasing aroma, an oblation to the LORD.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "7",
                       "number":  7,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "And as the libation for the first lamb, you will make a libation to the LORD in the sanctuary of a fourth of a hin of strong drink.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "8",
                       "number":  8,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The other lamb you will offer during the evening twilight, making the same grain offering and the same libation as in the morning, as an oblation of pleasing aroma to the LORD.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "9",
                       "number":  9,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "On the Sabbath. On the sabbath day: two unblemished yearling lambs, with a grain offering of two tenths of an ephah of bran flour mixed with oil, and its libation.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "10",
                       "number":  10,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "This is the sabbath burnt offering each sabbath, in addition to the regular burnt offering and its libation.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "11",
                       "number":  11,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "At the New Moon Feast. On your new moons you will offer as a burnt offering to the LORD two bulls of the herd, one ram, and seven unblemished yearling lambs,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "12",
                       "number":  12,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "with three tenths of an ephah of bran flour mixed with oil as the grain offering for each bull, two tenths of an ephah of bran flour mixed with oil as the grain offering for the ram,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "13",
                       "number":  13,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "and one tenth of an ephah of bran flour mixed with oil as the grain offering for each lamb, a burnt offering with a pleasing aroma, an oblation to the LORD.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "14",
                       "number":  14,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Their libations will consist of a half a hin of wine for each bull, a third of a hin for the ram, and a fourth of a hin for each lamb. This is the burnt offering for the new moon, for every new moon through the months of the year.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "15",
                       "number":  15,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Moreover, there will be one goat for a purification offering to the LORD; it will be offered in addition to the regular burnt offering and its libation.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "16",
                       "number":  16,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "At the Passover. The fourteenth day of the first month is the Passover of the LORD,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "17",
                       "number":  17,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "and the fifteenth day of this month is the pilgrimage feast. For seven days unleavened bread is to be eaten.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "18",
                       "number":  18,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "On the first day you will declare a holy day, and you shall do no heavy work.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "19",
                       "number":  19,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "You will offer an oblation, a burnt offering to the LORD: two bulls of the herd, one ram, and seven yearling lambs that you are sure are unblemished.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "20",
                       "number":  20,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Their grain offerings will be of bran flour mixed with oil; you will offer three tenths of an ephah for each bull and two tenths for the ram.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "21",
                       "number":  21,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "You will offer one tenth for each of the seven lambs;",
                       "isPoetry":  false
                   },
                   {
                       "label":  "22",
                       "number":  22,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "and one goat as a purification offering to make atonement for yourselves.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "23",
                       "number":  23,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "These offerings you will make in addition to the morning burnt offering which is part of the regular burnt offering.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "24",
                       "number":  24,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "You will make exactly the same offerings each day for seven days as food offerings, oblations of pleasing aroma to the LORD; they will be offered in addition to the regular burnt offering with its libation.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "25",
                       "number":  25,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "On the seventh day you will declare a holy day: you shall do no heavy work.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "26",
                       "number":  26,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "At Pentecost. On the day of first fruits, on your feast of Weeks, when you present to the LORD an offering of new grain, you will declare a holy day: you shall do no heavy work.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "27",
                       "number":  27,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "You will offer burnt offering for a pleasing aroma to the LORD: two bulls of the herd, one ram, and seven yearling lambs that you are sure are unblemished.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "28",
                       "number":  28,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Their grain offerings will be of bran flour mixed with oil: three tenths of an ephah for each bull, two tenths for the ram,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "29",
                       "number":  29,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "and one tenth for each of the seven lambs.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "30",
                       "number":  30,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "One goat will be for a purification offering to make atonement for yourselves.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "31",
                       "number":  31,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "You will make these offerings, together with their libations, in addition to the regular burnt offering with its grain offering.",
                       "isPoetry":  false
                   }
               ],
    "marks":  [

              ]
}