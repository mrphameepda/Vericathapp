{
    "headings":  [

                 ],
    "verses":  [
                   {
                       "label":  "1",
                       "number":  1,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Chapter 6 - Laws Concerning Nazirites. The LORD said to Moses:",
                       "isPoetry":  false
                   },
                   {
                       "label":  "2",
                       "number":  2,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Speak to the Israelites and tell them: When men or women solemnly take the nazirite vow to dedicate themselves to the LORD,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "3",
                       "number":  3,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "they shall abstain from wine and strong drink; they may neither drink wine vinegar, other vinegar, or any kind of grape juice, nor eat either fresh or dried grapes.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "4",
                       "number":  4,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "As long as they are nazirites they shall not eat anything of the produce of the grapevine; not even the seeds or the skins.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "5",
                       "number":  5,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "While they are under the nazirite vow, no razor shall touch their hair. Until the period of their dedication to the LORD is over, they shall be holy, letting the hair of their heads grow freely.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "6",
                       "number":  6,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "As long as they are dedicated to the LORD, they shall not come near a dead person.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "7",
                       "number":  7,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Not even for their father or mother, sister or brother, should they defile themselves, when these die, since their heads bear their dedication to God.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "8",
                       "number":  8,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "As long as they are nazirites they are holy to the LORD.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "9",
                       "number":  9,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "If someone dies very suddenly in their presence, defiling their dedicated heads, they shall shave their heads on the day of their purification, that is, on the seventh day.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "10",
                       "number":  10,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "On the eighth day they shall bring two turtledoves or two pigeons to the priest at the entrance of the tent of meeting.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "11",
                       "number":  11,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The priest shall offer up the one as a purification offering and the other as a burnt offering, thus making atonement for them for the sin they committed with respect to the corpse. On the same day they shall reconsecrate their heads",
                       "isPoetry":  false
                   },
                   {
                       "label":  "12",
                       "number":  12,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "and rededicate themselves to the LORD for the period of their dedication, bringing a yearling lamb as a reparation offering. The previous period is not valid, because they defiled their dedicated heads.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "13",
                       "number":  13,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "This is the ritual for the nazirites: When the period of their dedication is complete they shall go to the entrance of the tent of meeting,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "14",
                       "number":  14,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "bringing their offerings to the LORD, one unblemished yearling lamb for a burnt offering, one unblemished yearling ewe lamb for a purification offering, one unblemished ram as a communion offering,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "15",
                       "number":  15,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "and a basket of unleavened cakes of bran flour mixed with oil and of unleavened wafers spread with oil, along with their grain offerings and libations.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "16",
                       "number":  16,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The priest shall present them before the LORD, and shall offer up the purification offering and the burnt offering for them.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "17",
                       "number":  17,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "He shall then offer up the ram as a communion sacrifice to the LORD, along with the basket of unleavened cakes, and the priest will offer the grain offering and libation.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "18",
                       "number":  18,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Then at the entrance of the tent of meeting the nazirite shall shave his or her dedicated head, take the hair of the dedicated head, and put it in the fire under the communion sacrifice.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "19",
                       "number":  19,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "After the nazirite has shaved off the dedicated hair, the priest shall take a boiled shoulder of the ram, as well as one unleavened cake from the basket and one unleavened wafer, and shall put them in the hands of the nazirite.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "20",
                       "number":  20,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The priest shall then elevate them as an elevated offering before the LORD. They are an offering belonging to the priest, along with the brisket of the elevated offering and the leg of the contribution. Only after this may the nazirite drink wine.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "21",
                       "number":  21,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "This, then, is the law for the nazirites, that is, what they vow as their offering to the LORD in accord with their dedication, apart from anything else which their means may allow. In keeping with the vow they take so shall they do, according to the law of their dedication.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "22",
                       "number":  22,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The Priestly Blessing. The LORD said to Moses:",
                       "isPoetry":  false
                   },
                   {
                       "label":  "23",
                       "number":  23,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Speak to Aaron and his sons and tell them: This is how you shall bless the Israelites. Say to them:",
                       "isPoetry":  false
                   },
                   {
                       "label":  "24",
                       "number":  24,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The LORD bless you and keep you!",
                       "isPoetry":  false
                   },
                   {
                       "label":  "25",
                       "number":  25,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The LORD let his face shine upon you, and be gracious to you!",
                       "isPoetry":  false
                   },
                   {
                       "label":  "26",
                       "number":  26,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The LORD look upon you kindly and give you peace!",
                       "isPoetry":  false
                   },
                   {
                       "label":  "27",
                       "number":  27,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "So shall they invoke my name upon the Israelites, and I will bless them.",
                       "isPoetry":  false
                   }
               ],
    "marks":  [

              ]
}