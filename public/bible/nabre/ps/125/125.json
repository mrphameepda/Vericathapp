                   {
                       "label":  "1",
                       "number":  1,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Psalm 125 Israel’s Protector - A song of ascents. Those trusting in the LORD are like Mount Zion, unshakable, forever enduring.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "2",
                       "number":  2,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "As mountains surround Jerusalem, the LORD surrounds his people both now and forever.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "3",
                       "number":  3,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The scepter of the wicked will not prevail in the land allotted to the just, Lest the just themselves turn their hands to evil.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "4",
                       "number":  4,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Do good, LORD, to the good, to those who are upright of heart.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "5",
                       "number":  5,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "But those who turn aside to crooked ways may the LORD send down with the evildoers. Peace upon Israel!",
                       "isPoetry":  false
                   }
               ],
    "marks":  [

              ]
}