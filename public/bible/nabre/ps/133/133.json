                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Like fine oil on the head, running down upon the beard, Upon the beard of Aaron, upon the collar of his robe.",
                       "isPoetry":  false
