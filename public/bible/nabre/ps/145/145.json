{
    "headings":  [

                 ],
    "verses":  [
                   {
                       "label":  "1",
                       "number":  1,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Psalm 145 The Greatness and Goodness of God - Praise. Of David. I will extol you, my God and king; I will bless your name forever and ever.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "2",
                       "number":  2,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Every day I will bless you; I will praise your name forever and ever.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "3",
                       "number":  3,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Great is the LORD and worthy of much praise, whose grandeur is beyond understanding.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "4",
                       "number":  4,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "One generation praises your deeds to the next and proclaims your mighty works.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "5",
                       "number":  5,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "They speak of the splendor of your majestic glory, tell of your wonderful deeds.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "6",
                       "number":  6,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "They speak of the power of your awesome acts and recount your great deeds.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "7",
                       "number":  7,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "They celebrate your abounding goodness and joyfully sing of your justice.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "8",
                       "number":  8,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The LORD is gracious and merciful, slow to anger and abounding in mercy.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "9",
                       "number":  9,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The LORD is good to all, compassionate toward all your works.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "10",
                       "number":  10,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "All your works give you thanks, LORD and your faithful bless you.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "11",
                       "number":  11,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "They speak of the glory of your reign and tell of your mighty works,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "12",
                       "number":  12,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Making known to the sons of men your mighty acts, the majestic glory of your rule.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "13",
                       "number":  13,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Your reign is a reign for all ages, your dominion for all generations. The LORD is trustworthy in all his words, and loving in all his works.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "14",
                       "number":  14,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The LORD supports all who are falling and raises up all who are bowed down.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "15",
                       "number":  15,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The eyes of all look hopefully to you; you give them their food in due season.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "16",
                       "number":  16,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "You open wide your hand and satisfy the desire of every living thing.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "17",
                       "number":  17,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The LORD is just in all his ways, merciful in all his works.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "18",
                       "number":  18,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The LORD is near to all who call upon him, to all who call upon him in truth.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "19",
                       "number":  19,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "He fulfills the desire of those who fear him; he hears their cry and saves them.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "20",
                       "number":  20,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The LORD watches over all who love him, but all the wicked he destroys.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "21",
                       "number":  21,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "My mouth will speak the praises of the LORD; all flesh will bless his holy name forever and ever.",
                       "isPoetry":  false
                   }
               ],
    "marks":  [

              ]
}