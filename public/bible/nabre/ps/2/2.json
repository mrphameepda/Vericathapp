    "verses":  [
                   {
                       "label":  "1",
                       "number":  1,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Psalm 2 A Psalm for a Royal Coronation - Why do the nations protest and the peoples conspire in vain?",
                       "isPoetry":  false
                   },
                   {
                       "label":  "2",
                       "number":  2,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Kings on earth rise up and princes plot together against the LORD and against his anointed one:",
                       "isPoetry":  false
                   },
                   {
                       "label":  "3",
                       "number":  3,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "“Let us break their shackles and cast off their chains from us!”",
                       "isPoetry":  false
                   },
                   {
                       "label":  "4",
                       "number":  4,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The one enthroned in heaven laughs; the Lord derides them,",
                       "isPoetry":  false
                   },
                   {
                       "label":  "5",
                       "number":  5,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Then he speaks to them in his anger, in his wrath he terrifies them:",
                       "isPoetry":  false
                   },
                   {
                       "label":  "6",
                       "number":  6,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "“I myself have installed my king on Zion, my holy mountain.”",
                       "isPoetry":  false
                   },
                   {
                       "label":  "7",
                       "number":  7,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "I will proclaim the decree of the LORD, he said to me, “You are my son; today I have begotten you.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "8",
                       "number":  8,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Ask it of me, and I will give you the nations as your inheritance, and, as your possession, the ends of the earth.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "9",
                       "number":  9,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "With an iron rod you will shepherd them, like a potter’s vessel you will shatter them.”",
                       "isPoetry":  false
                   },
                   {
                       "label":  "10",
                       "number":  10,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "And now, kings, give heed; take warning, judges on earth.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "11",
                       "number":  11,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Serve the LORD with fear; exult with trembling, Accept correction lest he become angry and you perish along the way when his anger suddenly blazes up. Blessed are all who take refuge in him!",
                       "isPoetry":  false
                   }
               ],
    "marks":  [

              ]
}