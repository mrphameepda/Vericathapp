    "verses":  [
                   {
                       "label":  "1",
                       "number":  1,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Psalm 30 Thanksgiving for Deliverance - A psalm. A song for the dedication of the Temple. Of David.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "2",
                       "number":  2,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "I - I praise you, LORD, for you raised me up and did not let my enemies rejoice over me.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "3",
                       "number":  3,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "O LORD, my God, I cried out to you for help and you healed me.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "4",
                       "number":  4,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "LORD, you brought my soul up from Sheol; you let me live, from going down to the pit.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "5",
                       "number":  5,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "II - Sing praise to the LORD, you faithful; give thanks to his holy memory.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "6",
                       "number":  6,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "For his anger lasts but a moment; his favor a lifetime. At dusk weeping comes for the night; but at dawn there is rejoicing.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "7",
                       "number":  7,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "III - Complacent, I once said, “I shall never be shaken.”",
                       "isPoetry":  false
                   },
                   {
                       "label":  "8",
                       "number":  8,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "LORD, you showed me favor, established for me mountains of virtue. But when you hid your face I was struck with terror.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "9",
                       "number":  9,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "To you, LORD, I cried out; with the Lord I pleaded for mercy:",
                       "isPoetry":  false
                   },
                   {
                       "label":  "10",
                       "number":  10,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "“What gain is there from my lifeblood, from my going down to the grave? Does dust give you thanks or declare your faithfulness?",
                       "isPoetry":  false
                   },
                   {
                       "label":  "11",
                       "number":  11,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Hear, O LORD, have mercy on me; LORD, be my helper.”",
                       "isPoetry":  false
                   },
                   {
                       "label":  "12",
                       "number":  12,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "IV - You changed my mourning into dancing; you took off my sackcloth and clothed me with gladness.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "13",
                       "number":  13,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "So that my glory may praise you and not be silent. O LORD, my God, forever will I give you thanks.",
                       "isPoetry":  false
                   }
               ],
    "marks":  [

              ]
}