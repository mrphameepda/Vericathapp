{
    "headings":  [

                 ],
    "verses":  [
                   {
                       "label":  "1",
                       "number":  1,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Psalm 35 Prayer for Help Against Unjust Enemies - Of David. I - Oppose, O LORD, those who oppose me; war upon those who make war upon me.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "2",
                       "number":  2,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Take up the shield and buckler; rise up in my defense.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "3",
                       "number":  3,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Brandish lance and battle-ax against my pursuers. Say to my soul, “I am your salvation.”",
                       "isPoetry":  false
                   },
                   {
                       "label":  "4",
                       "number":  4,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Let those who seek my life be put to shame and disgrace. Let those who plot evil against me be turned back and confounded.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "5",
                       "number":  5,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Make them like chaff before the wind, with the angel of the LORD driving them on.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "6",
                       "number":  6,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Make their way slippery and dark, with the angel of the LORD pursuing them.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "7",
                       "number":  7,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "II - Without cause they set their snare for me; without cause they dug a pit for me.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "8",
                       "number":  8,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Let ruin overtake them unawares; let the snare they have set catch them; let them fall into the pit they have dug.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "9",
                       "number":  9,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Then I will rejoice in the LORD, exult in God’s salvation.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "10",
                       "number":  10,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "My very bones shall say, “O LORD, who is like you, Who rescue the afflicted from the powerful, the afflicted and needy from the despoiler?”",
                       "isPoetry":  false
                   },
                   {
                       "label":  "11",
                       "number":  11,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "III - Malicious witnesses rise up, accuse me of things I do not know.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "12",
                       "number":  12,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "They repay me evil for good; my soul is desolate.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "13",
                       "number":  13,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Yet I, when they were ill, put on sackcloth, afflicted myself with fasting, sobbed my prayers upon my bosom.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "14",
                       "number":  14,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "I went about in grief as for my brother, bent in mourning as for my mother.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "15",
                       "number":  15,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Yet when I stumbled they gathered with glee, gathered against me and I did not know it. They slandered me without ceasing;",
                       "isPoetry":  false
                   },
                   {
                       "label":  "16",
                       "number":  16,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "without respect they mocked me, gnashed their teeth against me.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "17",
                       "number":  17,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "IV - O Lord, how long will you look on? Restore my soul from their destruction, my very life from lions!",
                       "isPoetry":  false
                   },
                   {
                       "label":  "18",
                       "number":  18,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Then I will thank you in the great assembly; I will praise you before the mighty throng.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "19",
                       "number":  19,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Do not let lying foes rejoice over me, my undeserved enemies wink knowingly.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "20",
                       "number":  20,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "They speak no words of peace, but against the quiet in the land they fashion deceitful speech.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "21",
                       "number":  21,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "They open wide their mouths against me. They say, “Aha! Good! Our eyes have seen it!”",
                       "isPoetry":  false
                   },
                   {
                       "label":  "22",
                       "number":  22,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "You see this, LORD; do not be silent; Lord, do not withdraw from me.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "23",
                       "number":  23,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Awake, be vigilant in my defense, in my cause, my God and my Lord.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "24",
                       "number":  24,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Defend me because you are just, LORD; my God, do not let them rejoice over me.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "25",
                       "number":  25,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Do not let them say in their hearts, “Aha! Our soul!” Do not let them say, “We have devoured that one!”",
                       "isPoetry":  false
                   },
                   {
                       "label":  "26",
                       "number":  26,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Put to shame and confound all who relish my misfortune. Clothe with shame and disgrace those who lord it over me.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "27",
                       "number":  27,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "But let those who favor my just cause shout for joy and be glad. May they ever say, “Exalted be the LORD who delights in the peace of his loyal servant.”",
                       "isPoetry":  false
                   },
                   {
                       "label":  "28",
                       "number":  28,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Then my tongue shall recount your justice, declare your praise, all the day long.",
                       "isPoetry":  false
                   }
               ],
    "marks":  [

              ]
}