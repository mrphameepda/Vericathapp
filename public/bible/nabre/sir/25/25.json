    "verses":  [
                   {
                       "label":  "1",
                       "number":  1,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Chapter 25 Those Who Are Worthy of Praise - With three things I am delighted, for they are pleasing to the Lord and to human beings: Harmony among relatives, friendship among neighbors, and a wife and a husband living happily together.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "2",
                       "number":  2,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Three kinds of people I hate, and I loathe their manner of life: A proud pauper, a rich liar, and a lecherous old fool.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "3",
                       "number":  3,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "In your youth you did not gather. How will you find anything in your old age?",
                       "isPoetry":  false
                   },
                   {
                       "label":  "4",
                       "number":  4,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "How appropriate is sound judgment in the gray-haired, and good counsel in the elderly!",
                       "isPoetry":  false
                   },
                   {
                       "label":  "5",
                       "number":  5,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "How appropriate is wisdom in the aged, understanding and counsel in the venerable!",
                       "isPoetry":  false
                   },
                   {
                       "label":  "6",
                       "number":  6,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "The crown of the elderly, wide experience; their glory, the fear of the Lord.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "7",
                       "number":  7,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "There are nine who come to mind as blessed, a tenth whom my tongue proclaims: The man who finds joy in his children, and the one who lives to see the downfall of his enemies.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "8",
                       "number":  8,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Happy the man who lives with a sensible woman, and the one who does not plow with an ox and a donkey combined. Happy the one who does not sin with the tongue, who does not serve an inferior.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "9",
                       "number":  9,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Happy the one who finds a friend, who speaks to attentive ears.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "10",
                       "number":  10,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "How great is the one who finds wisdom, but none is greater than the one who fears the Lord.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "11",
                       "number":  11,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Fear of the Lord surpasses all else. To whom can we compare the one who has it?",
                       "isPoetry":  false
                   }
               ],
    "marks":  [

              ]
}