{
    "headings":  [

                 ],
    "verses":  [
                   {
                       "label":  "1",
                       "number":  1,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Chapter 6 - Do not be a foe instead of a friend. A bad name, disgrace, and dishonor you will inherit. Thus the wicked, the double-tongued!",
                       "isPoetry":  false
                   },
                   {
                       "label":  "2",
                       "number":  2,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Unruly Passions - Do not fall into the grip of your passion, lest like fire it consume your strength.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "3",
                       "number":  3,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "It will eat your leaves and destroy your fruits, and you will be left like a dry tree.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "4",
                       "number":  4,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "For fierce passion destroys its owner and makes him the sport of his enemies.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "5",
                       "number":  5,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "True Friendship - Pleasant speech multiplies friends, and gracious lips, friendly greetings.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "6",
                       "number":  6,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Let those who are friendly to you be many, but one in a thousand your confidant.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "7",
                       "number":  7,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "When you gain friends, gain them through testing, and do not be quick to trust them.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "8",
                       "number":  8,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "For there are friends when it suits them, but they will not be around in time of trouble.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "9",
                       "number":  9,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Another is a friend who turns into an enemy, and tells of the quarrel to your disgrace.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "10",
                       "number":  10,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Others are friends, table companions, but they cannot be found in time of affliction.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "11",
                       "number":  11,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "When things go well, they are your other self, and lord it over your servants.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "12",
                       "number":  12,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "If disaster comes upon you, they turn against you and hide themselves.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "13",
                       "number":  13,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Stay away from your enemies, and be on guard with your friends.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "14",
                       "number":  14,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Faithful friends are a sturdy shelter; whoever finds one finds a treasure.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "15",
                       "number":  15,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Faithful friends are beyond price, no amount can balance their worth.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "16",
                       "number":  16,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Faithful friends are life-saving medicine; those who fear God will find them.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "17",
                       "number":  17,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Those who fear the Lord enjoy stable friendship, for as they are, so will their neighbors be.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "18",
                       "number":  18,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Blessings of Wisdom - My child, from your youth choose discipline; and when you have gray hair you will find wisdom.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "19",
                       "number":  19,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "As though plowing and sowing, draw close to her; then wait for her bountiful crops. For in cultivating her you will work but little, and soon you will eat her fruit.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "20",
                       "number":  20,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "She is rough ground to the fool! The stupid cannot abide her.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "21",
                       "number":  21,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "She will be like a burdensome stone to them, and they will not delay in casting her aside.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "22",
                       "number":  22,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "For discipline is like her name, she is not accessible to many.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "23",
                       "number":  23,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Listen, my child, and take my advice; do not refuse my counsel.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "24",
                       "number":  24,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Put your feet into her fetters, and your neck under her yoke.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "25",
                       "number":  25,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Bend your shoulders and carry her and do not be irked at her bonds.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "26",
                       "number":  26,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "With all your soul draw close to her; and with all your strength keep her ways.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "27",
                       "number":  27,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Inquire and search, seek and find; when you get hold of her, do not let her go.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "28",
                       "number":  28,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Thus at last you will find rest in her, and she will become your joy.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "29",
                       "number":  29,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Her fetters will be a place of strength; her snare, a robe of spun gold.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "30",
                       "number":  30,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Her yoke will be a gold ornament; her bonds, a purple cord.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "31",
                       "number":  31,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "You will wear her as a robe of glory, and bear her as a splendid crown.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "32",
                       "number":  32,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "If you wish, my son, you can be wise; if you apply yourself, you can be shrewd.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "33",
                       "number":  33,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "If you are willing to listen, you can learn; if you pay attention, you can be instructed.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "34",
                       "number":  34,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Stand in the company of the elders; stay close to whoever is wise.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "35",
                       "number":  35,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Be eager to hear every discourse; let no insightful saying escape you.",
                       "isPoetry":  false
                   },
                   {
                       "label":  "36",
                       "number":  36,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "If you see the intelligent, seek them out; let your feet wear away their doorsteps!",
                       "isPoetry":  false
                   },
                   {
                       "label":  "37",
                       "number":  37,
                       "subVerseIndex":  0,
                       "paragraphNumber":  0,
                       "paragraphIndex":  0,
                       "text":  "Reflect on the law of the Most High, and let his commandments be your constant study. Then he will enlighten your mind, and make you wise as you desire.",
                       "isPoetry":  false
                   }
               ],
    "marks":  [

              ]
}