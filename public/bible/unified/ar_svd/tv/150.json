{
  "book": "tv",
  "chapter": 150,
  "verses": [
    {
      "verseNumber": 1,
      "textEn": "هللويا. سبحوا الله في قدسه. سبحوه في فلك قوته‎."
    },
    {
      "verseNumber": 2,
      "textEn": "‎سبحوه على قواته سبحوه حسب كثرة عظمته‎."
    },
    {
      "verseNumber": 3,
      "textEn": "‎سبحوه بصوت الصور سبحوه برباب وعود‎."
    },
    {
      "verseNumber": 4,
      "textEn": "‎سبحوه بدف ورقص. سبحوه باوتار ومزمار‎."
    },
    {
      "verseNumber": 5,
      "textEn": "‎سبحوه بصنوج التصويت سبحوه بصنوج الهتاف‎."
    },
    {
      "verseNumber": 6,
      "textEn": "‎كل نسمة فلتسبح الرب. هللويا"
    }
  ]
}