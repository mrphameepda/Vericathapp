{
  "book": "cn",
  "chapter": 15,
  "verses": [
    {
      "verseNumber": 1,
      "textEn": "追求公義為　神所愛柔和的回答使烈怒消退，暴戾的話激動怒氣。"
    },
    {
      "verseNumber": 2,
      "textEn": "智慧人的舌頭闡揚知識；愚昧人的口發出愚妄。"
    },
    {
      "verseNumber": 3,
      "textEn": "耶和華的眼目無所不在；壞人好人他都鑒察。"
    },
    {
      "verseNumber": 4,
      "textEn": "說安慰話的舌頭是生命樹；奸惡的舌頭使人心碎。"
    },
    {
      "verseNumber": 5,
      "textEn": "愚妄人藐視父親的管教；看重責備的是精明的人。"
    },
    {
      "verseNumber": 6,
      "textEn": "義人家中財寶豐富；惡人的收入卻帶來擾害。"
    },
    {
      "verseNumber": 7,
      "textEn": "智慧人的嘴唇散播知識；愚昧人的心並不是這樣。"
    },
    {
      "verseNumber": 8,
      "textEn": "惡人的祭物是耶和華厭惡的；正直人的禱告卻是他所喜悅的。"
    },
    {
      "verseNumber": 9,
      "textEn": "惡人的道路是耶和華厭惡的；追求公義的人卻是他所愛的。"
    },
    {
      "verseNumber": 10,
      "textEn": "離棄正路的必受嚴厲的管教；恨惡責備的必致死亡。"
    },
    {
      "verseNumber": 11,
      "textEn": "陰間和滅亡展露在耶和華面前，何況世人的心呢？"
    },
    {
      "verseNumber": 12,
      "textEn": "好譏笑人的不喜愛責備他的人，也不到智慧人那裡去。"
    },
    {
      "verseNumber": 13,
      "textEn": "喜樂的心使人臉上容光煥發；心中愁苦使人精神頹喪。"
    },
    {
      "verseNumber": 14,
      "textEn": "聰明人的心尋求知識，愚昧人的口只吃愚妄。"
    },
    {
      "verseNumber": 15,
      "textEn": "困苦人的日子盡是艱難；心中暢快的好像常享豐筵。"
    },
    {
      "verseNumber": 16,
      "textEn": "財物雖少而敬畏耶和華，勝過財物豐富卻煩惱不安。"
    },
    {
      "verseNumber": 17,
      "textEn": "吃素菜而彼此相愛，勝過吃肥牛卻彼此憎恨。"
    },
    {
      "verseNumber": 18,
      "textEn": "脾氣暴烈的人常引起紛爭；不輕易動怒的可平息爭執。"
    },
    {
      "verseNumber": 19,
      "textEn": "懶惰人的道路好像荊棘籬笆；正直人的路徑是平坦的大道。"
    },
    {
      "verseNumber": 20,
      "textEn": "智慧的兒子使父親快樂；愚昧人卻藐視自己的母親。"
    },
    {
      "verseNumber": 21,
      "textEn": "無知的人以愚妄為樂；聰明人卻行事正直。"
    },
    {
      "verseNumber": 22,
      "textEn": "不經商議，計劃必定失敗；謀士眾多，計劃就可成功。"
    },
    {
      "verseNumber": 23,
      "textEn": "應對得當，自己也覺喜樂；合時的話，多麼美好！"
    },
    {
      "verseNumber": 24,
      "textEn": "生命之路領明慧人向上，因此他可以離開在下面的陰間。"
    },
    {
      "verseNumber": 25,
      "textEn": "耶和華必拆毀驕傲人的家，卻要立定寡婦的地界。"
    },
    {
      "verseNumber": 26,
      "textEn": "邪惡的思想是耶和華厭惡的；恩慈的話卻是純淨的。"
    },
    {
      "verseNumber": 27,
      "textEn": "貪愛不義之財的禍害自己的家；恨惡賄賂的必可以存活。"
    },
    {
      "verseNumber": 28,
      "textEn": "義人的心思想怎樣回答；惡人的口發出惡言。"
    },
    {
      "verseNumber": 29,
      "textEn": "耶和華遠離惡人，卻垂聽義人的禱告。"
    },
    {
      "verseNumber": 30,
      "textEn": "眼中的光采使人心快樂；好消息使骨頭滋潤。"
    },
    {
      "verseNumber": 31,
      "textEn": "聽從有關生命之責備的，必住在智慧人中間。"
    },
    {
      "verseNumber": 32,
      "textEn": "輕忽管教的是藐視自己；聽從責備的卻得著智慧（“智慧”原文作“心”）。"
    },
    {
      "verseNumber": 33,
      "textEn": "敬畏耶和華是智慧的教訓；尊榮以先，必有謙卑。"
    }
  ]
}